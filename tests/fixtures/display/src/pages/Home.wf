// The second group of display and layout built-ins, each on the one page
// `tests/browser/display.mjs` drives.
page Home(path: "/", title: "Display", description: "Pairs, events, rings and panels.") {
    state progress = 40
    state level = 0.95
    state sizes: [Number] = [30, 70]
    state team = ["Ada", "Grace", "Alan", "Edsger", "Barbara"]

    Heading("Display").h1

    DescriptionList(id: "pairs").grid {
        DescriptionList.Item("Region", value: "eu-west")
        DescriptionList.Item("Status") { Badge("Live").success }
    }

    Timeline(id: "events") {
        Timeline.Item("Released", at: "2026-11-14") { Text("Version 6.1") }
        Timeline.Item("Planned") { Text("Version 7") }
    }

    AvatarGroup(max: 3, label: "Team", id: "team") {
        for name in team by name { Avatar(initials: name.slice(0, 1)) }
    }
    Button("Add one", id: "add") { on click { team = team.concat(["Linus"]) } }

    Item(title: "Notifications", description: "Sent to your phone", id: "row") {
        Item.Media { Icon("bell") }
        Item.Actions { Button("Edit") }
    }

    Gallery(columns: 2, ratio: 4 / 3, id: "gallery") {
        Image(src: "/harbour.png", alt: "The harbour")
        Image(src: "/hills.png", alt: "The hills")
    }

    Masonry(columns: 2, id: "masonry") {
        Card { Text("One") }
        Card { Text("Two") }
        Card { Text("Three") }
    }

    Progress(value: progress, label: "Upload", id: "ring").circular { Text("{progress}%").sm }
    Progress(label: "Working", id: "spinning").circular
    Button("More", id: "more") { on click { progress = progress + 30 } }

    Meter(value: level, high: 0.9, label: "Disk", id: "disk")
    Text("Sign-ups ")
    Sparkline([3, 5, 2, 8, 6], label: "Sign-ups this week", id: "spark")
    Sparkline([3, 5, 2], id: "bars").bar

    RelativeTime("2020-01-01T00:00:00Z", id: "when")

    AspectRatio(ratio: 16 / 9, id: "box") { Image(src: "/hills.png", alt: "The hills, wide") }

    ScrollArea(height: "120px", label: "Log", id: "log") {
        for n in 1..=30 { Text("Line {n}") }
    }

    Center(id: "middle") { style { height: 100px }  Text("Centred") }

    Sticky(offset: "8px", id: "bar") { Text("Stuck") }

    PanelGroup(bind: sizes, label: "Resize the panels", id: "panels") {
        style { height: 120px }
        PanelGroup.Panel(min: 20) { Text("Files") }
        PanelGroup.Panel { Text("Editor") }
    }
    Text("sizes {sizes.map(s => Math.round(s)).join(\",\")}", id: "sizes")

    for n in 1..=40 { Text("Filler {n}") }
}
