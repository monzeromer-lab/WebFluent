{
  "name": "offline",
  "build": {
    "output": "build",
    "output_type": "spa",
    "ssg": true
  },
  "meta": {
    "title": "Offline",
    "description": "A site that keeps working without the network."
  },
  "offline": {
    "precache": ["/", "/about"],
    "fallback": "/offline",
    "cache": { "/api/*": "network-first" },
    "sync": true
  }
}
