page Other(path: "/other", title: "Other", description: "Another page reading the same store.") {
    Heading("Other").h1
    Text("{Feed.count}", id: "count")
    Text(match Feed.rows { .loading { "loading" } .failed(e) { "error" } .loaded(v) { "ready" } }, id: "state")
    Link("Home", to: "/", id: "home")
}
