type User { id: String, name: String }
type Found { query: String }

api Backend(base: "/api") {
    timeout: 300.ms
    retry: .backoff(times: 2, on: [.network, .timeout, .status5xx])

    get    users at "users" -> [User]!
    get    slowRead at "slow-read" -> Json!
    post   slowWrite(body: Json) at "slow-write" -> Json!
    post   order(body: Json) at "orders" -> Json!
    put    note(id: String, body: Json) at "notes/{id}" -> Json!
}

app { Router }

page Home(path: "/", title: "Fetch", description: "A page that asks a service for things.") {
    state q = ""
    state said = ""
    resource hits: Found = http.post("/api/search", body: { query: q })
    resource first = Backend.users()
    resource second = Backend.users()

    Heading("Fetch").h1
    Input(bind: q, label: "Search")
    match hits {
        .loading { Text("searching") }
        .failed(e) { Text("search failed") }
        .loaded(h) { Text("found:{h.query}", id: "found") }
    }
    match first {
        .loading { Text("…") }
        .failed(e) { Text("first failed") }
        .loaded(list) { Text("first:{list.length}", id: "first") }
    }
    match second {
        .loading { Text("…") }
        .failed(e) { Text("second failed") }
        .loaded(list) { Text("second:{list.length}", id: "second") }
    }
    Text("said:{said}", id: "said")
    Text("queued:{network.queued}", id: "queued")

    Button("Refresh", id: "refresh") { on click { Backend.users.invalidate() } }
    Button("Slow write", id: "slow-write") {
        on click {
            match await Backend.slowWrite(body: { n: 1 }) {
                .ok(_) { said = "written" }
                .err(.timeout(_)) { said = "write:timeout" }
                .err(e) { said = "write:{e.message}" }
            }
        }
    }
    Button("Slow read", id: "slow-read") {
        on click {
            match await Backend.slowRead() {
                .ok(_) { said = "read" }
                .err(.timeout(_)) { said = "read:timeout" }
                .err(e) { said = "read:{e.message}" }
            }
        }
    }
    Button("Order", id: "order") {
        on click {
            match await Backend.order(body: { item: "tea" }) {
                .ok(_) { said = "ordered" }
                .err(.offline) { said = "order:offline" }
                .err(e) { said = "order:{e.message}" }
            }
        }
    }
    Button("Note", id: "note") {
        on click {
            match await Backend.note(id: "n1", body: { text: "kept" }) {
                .ok(_) { said = "noted" }
                .err(e) { said = "note:{e.message}" }
            }
        }
    }
}
