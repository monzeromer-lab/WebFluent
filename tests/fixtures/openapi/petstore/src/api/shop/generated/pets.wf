    get listPets(limit: Number?) at "pets" -> [Pet]!
    /// Put a pet up for sale
    post createPets(body: Pet) at "pets" -> !
    /// One pet, by its id
    get showPetById(petId: String) at "pets/{petId}" -> Pet ! ShowPetByIdError
}
