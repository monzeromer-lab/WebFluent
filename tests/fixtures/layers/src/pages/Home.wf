// Every kind of layer, inside a box that clips: a popover at a button, a
// menu with a shortcut, a checked item, a disabled item and a submenu, a
// context menu at the pointer, a tooltip with its shortcut chip, and a
// field whose Escape is its own while the pointer rests on a tooltip.
page Home(path: "/", title: "Layers", description: "Popovers, menus and tooltips above everything.") {
    state open = false
    state wrap = false
    state ctx = false
    state point = { x: 0, y: 0 }
    state said = ""
    state first = true
    state modalOpen = false
    state escapes = 0
    state fieldEscapes = 0
    // What the page hears of Escape: only what no layer and no modal took.
    on key("Escape") { escapes = escapes + 1 }
    Heading("Layers").h1
    Container(id: "clip") {
        style { overflow: hidden; height: 60px }
        Row {
            Button("Branches", ref: branches, id: "branches") { on click { open = !open } }
            Menu(trigger: "View", id: "view", class: "mine") {
                Menu.Item(shortcut: "mod+b", id: "sidebar") {
                    on click { said = "sidebar" }
                    Text("Toggle sidebar")
                }
                Menu.Item(checked: wrap, id: "wrap") {
                    on click { wrap = !wrap }
                    Text("Word wrap")
                }
                Menu.Item(disabled: true, id: "zen") {
                    on click { said = "zen" }
                    Text("Zen mode")
                }
                Menu.Divider()
                Menu.Sub(label: "Appearance", id: "appearance") {
                    Menu.Item(id: "light") {
                        on click { said = "light" }
                        Text("Light")
                    }
                    Menu.Item(id: "dark") {
                        on click { said = "dark" }
                        Text("Dark")
                    }
                }
            }
            Tooltip("Save", shortcut: "mod+s", delay: 200) {
                Button("Save", id: "save")
            }
        }
    }
    Popover(visible: open, anchor: branches, placement: .bottomStart, label: "Branches", id: "pop").arrow {
        on close(reason) { said = "popover {reason}" }
        Text("main")
    }
    Card(id: "area") {
        on contextmenu(e) {
            e.preventDefault()
            point = { x: e.clientX, y: e.clientY }
            ctx = true
        }
        Text("Right-click here")
    }
    Menu(visible: ctx, at: point, id: "context") {
        on close(reason) { said = "context {reason}" }
        Menu.Item(shortcut: "F12", id: "definition") {
            on click { said = "definition" }
            Text("Go to definition")
        }
        Menu.Item(id: "rename") {
            on click { said = "rename" }
            Text("Rename")
        }
    }
    // A menu open from the first paint, which state opens: no button.
    Button("Welcome", ref: welcome, id: "welcome")
    Menu(visible: first, anchor: welcome, label: "Open from the start", id: "first") {
        Menu.Item(id: "first-item") {
            on click { said = "first" }
            Text("Got it")
        }
    }
    // Menus a loop draws, each its own.
    Row(id: "many") {
        for n in ["one", "two", "three"] by n {
            Menu(trigger: n) { Menu.Item { Text("In {n}") } }
        }
    }
    // Tooltips a loop draws, each its own.
    Row(id: "tips") {
        for n in ["Cut", "Copy", "Paste"] by n {
            Tooltip("{n} the selection") { Button(n) }
        }
    }
    Button("Open the modal", id: "modal-open") { on click { modalOpen = true } }
    Modal(visible: modalOpen, title: "A modal") {
        Button("Inside", id: "inside")
    }
    Input(label: "Find", id: "field") {
        on keydown(e) { if e.key == "Escape" { fieldEscapes = fieldEscapes + 1 } }
    }
    Text("{fieldEscapes}", id: "field-escapes")
    Text("{escapes}", id: "escapes")
    Text("{said}", id: "said")
}
