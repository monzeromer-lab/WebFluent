app {
    Navbar {
        style {
            background: rgba(255, 255, 255, 0.9)
            border-bottom: 1px solid #E2E8F0
        }

        Text("Ledger").bold

        Link("Features", to: "/")
        Link("Pricing", to: "/pricing")

        Button("Start free").primary.pill
    }

    Router

    Footer {
        style {
            padding: 3rem 1.5rem
            background: #0F172A
            color: #94A3B8
        }
        Text("© 2026 Ledger. Every invoice, eventually paid.").sm.center
    }
}
