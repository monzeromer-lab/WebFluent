// A sidebar shell with the router nested two levels down — the layout the docs
// call out as the one that used to lose its router.
app {
    Row {
        style {
            min-height: 100vh
        }

        Sidebar {
            style {
                width: 240px
                background: #0B1120
            }

            Sidebar.Header { Text("Ops Console").bold }
            Sidebar.Item(to: "/", icon: "home") { Text("Overview") }
            Sidebar.Item(to: "/incidents", icon: "warning") { Text("Incidents") }
            Sidebar.Divider
            Sidebar.Item(to: "/settings", icon: "settings") { Text("Settings") }
        }

        Container {
            style {
                flex: 1
                padding: 2rem
            }

            Router
        }
    }
}
