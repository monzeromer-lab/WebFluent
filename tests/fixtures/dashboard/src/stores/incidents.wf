store IncidentStore {
    state incidents = [
        { id: 1, title: "Payment webhook timing out", severity: "high", resolved: false },
        { id: 2, title: "Stale cache on the pricing page", severity: "low", resolved: false },
        { id: 3, title: "Duplicate signup emails", severity: "medium", resolved: true }
    ]

    derived open = incidents.filter(i => !i.resolved).length
    derived closed = incidents.filter(i => i.resolved).length

    action resolve(id: Number) {
        // Assignment is what a signal notices: changing a field of an
        // item in place leaves the list the same list, and nothing
        // repaints.
        incidents = incidents.map(i => if i.id == id { { ...i, resolved: true } } else { i })
    }

    action report(title: String) {
        incidents = incidents.concat([{ id: incidents.length + 1, title: title, severity: "medium", resolved: false }])
    }
}
