page Home(path: "/", description: "How we work, written down so nobody has to ask twice.", title: "Handbook") {
    Container {
        Heading(t("home.title")).h1
        Text(t("home.lede")).muted

        Row(gap: .md).stacks {
            Column(span: 6).stacks {
                Card { Heading("Start here").h2 Text("Your first week, hour by hour.") }
            }
            Column(span: 6).stacks {
                Card { Heading("How we decide").h2 Text("Who decides what, and when.") }
            }
        }
    }
}
