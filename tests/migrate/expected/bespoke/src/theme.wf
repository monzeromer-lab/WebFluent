// Structural mode ships no baseline design, so this is not an override of the
// engine's opinions — it is the entire palette the site has.
theme Atelier {
    color-primary: #1C1917
    color-background: #FAF9F6
    color-text: #1C1917
    color-border: #1C1917
    font-family: 'Editorial New', Georgia, serif
    radius-md: 0
}
