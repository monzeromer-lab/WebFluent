page Animation(path: "/animation", description: "Transitions, animation modifiers and reduced-motion behaviour.", title: "Animation System") {
    state showCard = false

    Container.fadeIn {
        Spacer
        Heading("Animation System").h1
        Text("Declarative animations built into the language. No CSS keyframes to write.").muted

        Spacer

        Heading("Mount Animations").h2
        Text("Add an animation modifier to any component. It plays when the element appears. Hover each card to replay.")
        Spacer.sm

        Grid(columns: 3, gap: .md).stacks {
            Card.outlined.fadeIn {
                on mouseenter(event) { replayAnimation(event.currentTarget, "fadeIn") }
                Card.Body { Text("fadeIn").center.bold Text("Fades from transparent").center.muted.sm }
            }
            Card.outlined.slideUp {
                on mouseenter(event) { replayAnimation(event.currentTarget, "slideUp") }
                Card.Body { Text("slideUp").center.bold Text("Slides from below").center.muted.sm }
            }
            Card.outlined.scaleIn {
                on mouseenter(event) { replayAnimation(event.currentTarget, "scaleIn") }
                Card.Body { Text("scaleIn").center.bold Text("Scales from 90%").center.muted.sm }
            }
            Card.outlined.slideDown {
                on mouseenter(event) { replayAnimation(event.currentTarget, "slideDown") }
                Card.Body { Text("slideDown").center.bold Text("Slides from above").center.muted.sm }
            }
            Card.outlined.slideLeft {
                on mouseenter(event) { replayAnimation(event.currentTarget, "slideLeft") }
                Card.Body { Text("slideLeft").center.bold Text("Slides from right").center.muted.sm }
            }
            Card.outlined.bounce {
                on mouseenter(event) { replayAnimation(event.currentTarget, "bounce") }
                Card.Body { Text("bounce").center.bold Text("Bouncy entrance").center.muted.sm }
            }
            Card.outlined.shake {
                on mouseenter(event) { replayAnimation(event.currentTarget, "shake") }
                Card.Body { Text("shake").center.bold Text("Horizontal shake").center.muted.sm }
            }
            Card.outlined.pulse {
                on mouseenter(event) { replayAnimation(event.currentTarget, "pulse") }
                Card.Body { Text("pulse").center.bold Text("Gentle scale pulse").center.muted.sm }
            }
            Card.outlined.slideRight {
                on mouseenter(event) { replayAnimation(event.currentTarget, "slideRight") }
                Card.Body { Text("slideRight").center.bold Text("Slides from left").center.muted.sm }
            }
        }

        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("Card(elevated, fadeIn) \{ ... \}\nHeading(\"Title\", h1, slideUp)\nButton(\"Click\", primary, bounce)").block
            }
        }

        Spacer
        Divider
        Spacer

        Heading("Live: Conditional Animation").h2
        Text("Toggle the switch to see enter/exit animations on the card below.")
        Spacer.sm

        Switch(bind: showCard, label: "Show animated card")
        Spacer.sm

        if showCard {
            Card(exit: .fadeOut).scaleIn.elevated {
                Card.Body {
                    Badge("Animated!").success
                    Spacer.sm
                    Text("This card scales in and fades out.")
                    Text("Controlled by: if showCard, animate(scaleIn, fadeOut)").muted.sm
                }
            }
        }

        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("if showCard, animate(scaleIn, fadeOut) \{\n    Card(elevated) \{\n        Text(\"Animated content\")\n    \}\n\}").block
            }
        }

        Spacer
        Divider
        Spacer

        Heading("Speed Variants").h2
        Spacer.sm
        Grid(columns: 3, gap: .md).stacks {
            Card.outlined.fadeIn {
                on mouseenter(event) { replayAnimation(event.currentTarget, "fadeIn", "150ms") }
                Card.Body {
                    Text("fast").center.bold
                    Text("150ms").center.muted
                    Code("Card(elevated, fadeIn, fast)").block
                }
            }
            Card.outlined.fadeIn {
                on mouseenter(event) { replayAnimation(event.currentTarget, "fadeIn") }
                Card.Body {
                    Text("default").center.bold
                    Text("300ms").center.muted
                    Code("Card(elevated, fadeIn)").block
                }
            }
            Card.outlined.fadeIn {
                on mouseenter(event) { replayAnimation(event.currentTarget, "fadeIn", "500ms") }
                Card.Body {
                    Text("slow").center.bold
                    Text("500ms").center.muted
                    Code("Card(elevated, fadeIn, slow)").block
                }
            }
        }

        Spacer
        Divider
        Spacer

        Heading("All 12 Animations").h2
        Spacer.sm
        Table {
            Table.Head { Table.Cell("Name") Table.Cell("Effect") Table.Cell("Usage") }
            Table.Row { Table.Cell("fadeIn / fadeOut") Table.Cell("Opacity fade") Table.Cell("Card(elevated, fadeIn)") }
            Table.Row { Table.Cell("slideUp / slideDown") Table.Cell("Vertical slide + fade") Table.Cell("Heading(\"Hi\", h1, slideUp)") }
            Table.Row { Table.Cell("slideLeft / slideRight") Table.Cell("Horizontal slide + fade") Table.Cell("Text(\"Hello\", slideLeft)") }
            Table.Row { Table.Cell("scaleIn / scaleOut") Table.Cell("Scale from/to 90%") Table.Cell("Badge(\"New\", scaleIn)") }
            Table.Row { Table.Cell("bounce") Table.Cell("Bouncy entrance") Table.Cell("Button(\"Go\", bounce)") }
            Table.Row { Table.Cell("shake") Table.Cell("Horizontal shake") Table.Cell("Alert(\"Error!\", shake)") }
            Table.Row { Table.Cell("pulse") Table.Cell("Scale pulse (infinite)") Table.Cell("Badge(\"Live\", pulse)") }
            Table.Row { Table.Cell("spin") Table.Cell("360-degree rotation") Table.Cell("Spinner(spin)") }
        }

        Spacer
        Divider
        Spacer

        Heading("Conditional Animations").h2
        Text("Attach enter and exit animations to if blocks.")
        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("if visible, animate(slideUp, fadeOut) \{\n    Card \{ Text(\"Appears with slideUp, exits with fadeOut\") \}\n\}\n\nif expanded, animate(scaleIn, scaleOut) \{\n    Text(\"Scales in and out\")\n\}").block
            }
        }

        Spacer
        Divider
        Spacer

        Heading("List Stagger").h2
        Text("Animate list items with staggered delays.")
        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("for item in items, animate(slideUp, fadeOut, stagger: \"50ms\") \{\n    Card \{ Text(item.name) \}\n\}").block
            }
        }

        Spacer
        Divider
        Spacer

        Heading("Transition Blocks").h2
        Text("Smooth CSS transitions on property changes.")
        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("Button(\"Hover me\") \{\n    transition \{\n        background 200ms ease\n        transform 150ms spring\n    \}\n\}").block
            }
        }

        Spacer.xl

        Spacer
        Divider
        Spacer

        Heading("Reduced motion").h2
        Text("Some people have asked their system for less movement, usually because motion makes them ill. Every animation and transition the engine ships is already wrapped in that preference — the end state is kept, the movement is dropped. You do not have to do anything.")
        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("@media (prefers-reduced-motion: reduce) \{
  *, *::before, *::after \{
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  \}
\}").block
            }
        }
        Spacer.sm
        Text("If you write your own keyframes in a style block, they are not covered by this — add the same guard yourself.").muted.sm
    }
}
