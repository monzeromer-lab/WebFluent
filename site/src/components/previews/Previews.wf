/// The previews, listed.
component PreviewIndex(ar: Bool = false) {
    SiteHeader(other: if ar { "/blueprint" } else { "/ar/blueprint" }, lang: if ar { "ar" } else { "en" })
    // wf-allow(A16)
    Stack(gap: .md, role: "main", id: "bp-main", class: "bp-main bp-wrap") {
        style { gap: 20px; padding-top: 40px; padding-bottom: 72px }
        Heading("Blueprint").h1 { style { margin: 0; font-size: 40px; font-weight: 650 } }
        BookProgress(chapters: SAMPLE_BOOK)
        RecipeFilter { on change(text, output) { log("{text} {output}") } }
        Grid(columns: { base: 1, md: 3 }, gap: .md) {
            RecipeCard("Fetch and show a list", summary: "A placeholder while it comes, then each item.", to: "/blueprint/recipe", outputs: ["website", "app"])
            RecipeCard("Ship a PDF invoice", summary: "One page, a table and a total, printed by the compiler.", to: "/recipes/pdf-invoice", outputs: ["pdf"])
            RecipeCard("Add dark mode", summary: "A second theme, and a switch that remembers.", to: "/recipes/dark-mode", outputs: ["website", "app"])
        }
        Grid(columns: { base: 1, md: 3 }, gap: .md) {
            Link(to: if ar { "/ar/blueprint/home" } else { "/blueprint/home" }, class: "bp-card") { Text("T1 Home") }
            Link(to: if ar { "/ar/blueprint/chapter" } else { "/blueprint/chapter" }, class: "bp-card") { Text("T2 Chapter") }
            Link(to: if ar { "/ar/blueprint/essay" } else { "/blueprint/essay" }, class: "bp-card") { Text("T2 Essay") }
            Link(to: if ar { "/ar/blueprint/recipe" } else { "/blueprint/recipe" }, class: "bp-card") { Text("T3 Recipe") }
            Link(to: if ar { "/ar/blueprint/reference" } else { "/blueprint/reference" }, class: "bp-card") { Text("T4 Reference") }
            Link(to: if ar { "/ar/blueprint/error" } else { "/blueprint/error" }, class: "bp-card") { Text("T5 Error") }
            Link(to: if ar { "/ar/blueprint/coming-from" } else { "/blueprint/coming-from" }, class: "bp-card") { Text("T6 Coming from") }
            Link(to: if ar { "/ar/blueprint/playground" } else { "/blueprint/playground" }, class: "bp-card") { Text("T7 Playground") }
            Link(to: if ar { "/ar/blueprint/showcase" } else { "/blueprint/showcase" }, class: "bp-card") { Text("T8 Showcase") }
            Link(to: if ar { "/ar/blueprint/not-found" } else { "/blueprint/not-found" }, class: "bp-card") { Text("T9 404") }
        }
    }
}

