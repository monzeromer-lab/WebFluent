    ShowcaseShell(if ar { "ما صُنع بـ WebFluent" } else { "Made with WebFluent" }, lede: if ar { "مواقع ومستندات وعروض حقيقية." } else { "Real outputs: sites, PDFs and decks, each with its source and the recipe that makes it." }, other: if ar { "/blueprint/showcase" } else { "/ar/blueprint/showcase" }, lang: if ar { "ar" } else { "en" }) {
        ShowcaseTile("The WebFluent site", output: "website", size: "41 kB", pages: 64, source: REPO)
        ShowcaseTile("An invoice", output: "pdf", size: "28 kB", pages: 2, source: REPO)
