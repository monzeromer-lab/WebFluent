/// The running page an Example's preview frames.
page BlueprintSample(path: "/blueprint/sample", title: "Sample", description: "The page Blueprint's example previews frame.", noindex: true) {
    state count = 0
    Stack(gap: .sm) {
        style { padding: 24px; gap: 12px; align-items: flex-start }
        Heading("Hello, WebFluent").h1 { style { margin: 0; font-size: 28px } }
        Text("Clicked {count} times")
        Button("+1").primary { on click { count = count + 1 } }
    }
}
