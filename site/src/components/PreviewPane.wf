/// What the Playground built, running — at a desktop's width, or in a
/// phone's frame — served by the preview worker under
/// `/wasm/<release>/preview/<stage>/`. A document shows its PDF.
component PreviewPane(stage: String = "", run: Number = 0, pdf: String = "") {
    state phone = false

    Stack(class: "bp-pane") {
        Row(class: "bp-pane__bar") {
            Text(t("playground.preview"), class: "bp-section-label")
            Row(role: "group", aria-label: t("playground.device"), gap: .xs) {
                style { flex-wrap: nowrap; gap: 4px }
                Button(t("playground.desktop"), aria-pressed: !phone, class: "bp-button", data-tone: "quiet") { on click { phone = false } }
                Button(t("playground.phone"), aria-pressed: phone, class: "bp-button", data-tone: "quiet") { on click { phone = true } }
            }
        }
        Stack(class: "bp-grid") {
            style { flex: 1 1 auto; min-height: 420px; padding: 16px }
            if run == 0 {
                Text(t("playground.empty"), class: "bp-small") { style { margin: auto } }
            } else if pdf != "" {
                // The browser's own viewer, at a desktop's width.
                Frame(src: "/wasm/{WF_RELEASE}/preview/{stage}/{pdf}?run={run}", title: t("playground.pdf")) {
                    style { flex: 1 1 auto; width: 100%; min-height: 400px; border: 1px solid $line; border-radius: 4px; background: $sheet }
                }
            } else {
                Frame(src: "/wasm/{WF_RELEASE}/preview/{stage}/?run={run}", title: t("playground.preview"), class: if phone { "bp-phone" } else { "" }) {
                    style { flex: 1 1 auto; width: 100%; min-height: 400px; border: 1px solid $line; border-radius: 4px; background: $sheet }
                }
            }
        }
    }
}
