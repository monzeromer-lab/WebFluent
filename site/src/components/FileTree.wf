/// The Playground's files: one to open, a new one to add, and one to remove.
/// The config stays; a path is checked before it is added (under `src/`,
/// no `..`, a file the compiler reads, not one that is there already).
component FileTree(files: [String] = [], current: String = "") {
    event pick(name: String)
    event add(name: String)
    event remove(name: String)
    state draft = ""
    state problem = ""
    // The last page file stays: a project with none builds nothing.
    derived pages = files.filter(x => x.endsWith(".wf") || x.endsWith(".wfx")).length

    action tryAdd() {
        let path = draft.trim()
        if !path.startsWith("src/") || path.includes("..") || !/\.(wf|wfx|json|css|js)$/.test(path) {
            problem = t("playground.file.bad")
        } else if files.includes(path) {
            problem = t("playground.file.taken")
        } else {
            problem = ""
            draft = ""
            emit add(path)
        }
    }

    Stack(class: "bp-pane", role: "group", aria-label: t("playground.files")) {
        Row(class: "bp-pane__bar") {
            Text(t("playground.files"), class: "bp-section-label")
        }
        Stack {
            style { gap: 2px; padding: 6px }
            for f in files by f {
                Row(align: .center) {
                    style { flex-wrap: nowrap; gap: 2px }
                    Button(f, aria-current: if f == current { "true" } else { "false" }, class: "bp-file") {
                        style { flex: 1 1 auto; min-width: 0; overflow-wrap: anywhere }
                        on click { emit pick(f) }
                    }
                    if f != "webfluent.app.json" && (pages > 1 || !(f.endsWith(".wf") || f.endsWith(".wfx"))) {
                        IconButton(icon: "close", label: t("playground.file.remove", { file: f })).sm {
                            on click { emit remove(f) }
                        }
                    }
                }
            }
        }
        Form {
            style { display: flex; flex-direction: column; gap: 6px; padding: 8px 6px 10px; border-top: 1px solid $line }
            on submit(e) {
                e.preventDefault()
                tryAdd()
            }
            Input(bind: draft, placeholder: "src/components/Card.wf", aria-label: t("playground.file.new"), error: problem) {
                style { font-family: $font-family-mono; font-size: 12px }
            }
            Button(t("playground.file.add"), type: .submit, class: "bp-button", disabled: draft.trim() == "")
        }
    }
}
