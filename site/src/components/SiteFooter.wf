/// The site footer as the design draws it: the mark and one line about the
/// guide, three columns of links under overline labels, and the legal line.
component SiteFooter {
    Footer {
        style {
            padding: 24px 16px
            border-top: 1px solid $border
            background: $color-background
            @md { padding: 32px 40px }
        }
        Stack(gap: .lg) {
            style { gap: 24px; max-width: 1200px; margin: 0 auto }
            Row(justify: .between, align: .start, gap: .xl) {
                style { gap: 32px; flex-wrap: wrap; @md { gap: 48px } }

                Stack(gap: .sm) {
                    style { gap: 8px; width: 300px; max-width: 100% }
                    Row(align: .center, gap: .sm) {
                        style { gap: 10px; flex-wrap: nowrap }
                        Text("wf") {
                            style {
                                display: inline-flex
                                align-items: center
                                justify-content: center
                                width: 24px
                                height: 24px
                                margin: 0
                                border-radius: 4px
                                background: $color-primary
                                color: #FFFFFF
                                font-family: $font-family-mono
                                font-size: 12px
                            }
                        }
                        Text("WebFluent") { style { margin: 0; font-size: 15px; font-weight: 600 } }
                    }
                    Text(t("footer.built")) { style { margin: 0; font-size: 12px; line-height: 18px; color: $ink-subtle } }
                }

                Row(gap: .xl, align: .start, class: "footer-columns") {
                    style {
                        gap: 24px 32px
                        flex-wrap: wrap
                        & a { display: inline-flex; align-items: center; font-size: 13px; line-height: 20px; color: $color-text-muted; text-decoration: none }
                        & a:hover { color: $color-text }
                        @md { gap: 64px }
                    }

                    Stack(gap: .xs) {
                        style { gap: 2px; min-width: 140px; @md { gap: 6px } }
                        Text(t("footer.guide"), class: "overline")
                        Link(t("ch.02"), to: "/docs/guide/getting-started")
                        Link(t("ch.03"), to: "/docs/guide/tutorial")
                        Link(t("ch.29"), to: "/docs/guide/deploying")
                        Link(t("ch.44"), to: "/docs/guide/troubleshooting")
                    }

                    Stack(gap: .xs) {
                        style { gap: 2px; min-width: 140px; @md { gap: 6px } }
                        Text(t("footer.reference"), class: "overline")
                        Link(t("footer.builtins"), to: "/docs/reference")
                        Link(t("ch.37"), to: "/docs/guide/cli")
                        Link(t("ch.38"), to: "/docs/guide/config")
                        Link(t("footer.diagnostics"), to: "/docs/guide/diagnostics")
                        Link(t("ch.35"), to: "/docs/cookbook")
                    }

                    Stack(gap: .xs) {
                        style { gap: 2px; min-width: 140px; @md { gap: 6px } }
                        Text(t("footer.project"), class: "overline")
                        Link(t("footer.source"), href: REPO)
                        Link(t("footer.releases"), href: "{REPO}/releases")
                        Link(t("footer.issues"), href: "{REPO}/issues")
                    }
                }
            }

            Row(justify: .between, align: .center, gap: .md) {
                style { flex-wrap: wrap; padding-top: 16px; border-top: 1px solid $border; & p { margin: 0; font-size: 12px; line-height: 18px; color: $ink-subtle } }
                Text(t("footer.licence"))
                Text(t("footer.copyright"))
            }
        }
    }
}
