/// The site's foot, in Blueprint: four columns — learn, do, look up, and
/// what is there for agents — then the release this site was built by,
/// the licence, and the analytics question again.
component SiteFooter {
    Footer {
        style { border-top: 1px solid $line; background: $sheet }
        Stack(gap: .lg, class: "bp-wrap") {
            style { gap: 32px; padding-top: 40px; padding-bottom: 32px }

            Grid(columns: { base: 2, md: 4 }, gap: .lg) {
                for group in FOOTER by group.key {
                    Stack(gap: .xs) {
                        style { gap: 4px; & a { display: inline-flex; align-items: center; min-height: 32px; color: $muted; font-size: 14px; text-decoration: none } & a:hover { color: $ink } }
                        Text(t(group.key), class: "bp-section-label") { style { margin-bottom: 4px } }
                        for place in group.places by place.to {
                            Link(t(place.key), to: place.to)
                        }
                    }
                }
            }

            Row(justify: .between, align: .center, gap: .md) {
                style { flex-wrap: wrap; gap: 12px 24px; padding-top: 20px; border-top: 1px solid $line }
                Text(t("footer.built", { version: VERSION }), class: "bp-small")
                Row(align: .center, gap: .md) {
                    style { flex-wrap: wrap; gap: 8px 20px }
                    Link(t("footer.source"), href: REPO) { style { color: $muted; font-size: 13px } }
                    Button(t("consent.settings"), class: "link-button") { on click { Consent.reopen() } }
                    Text(t("footer.copyright"), class: "bp-small")
                }
            }
        }
    }
}
