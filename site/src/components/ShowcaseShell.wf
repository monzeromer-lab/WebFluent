/// T8, the showcase: real outputs — PDFs and decks — each a tile with its
/// first page on the grid, its size and pages, the file and its source. The
/// page's body is the tiles; `filters` is the row that narrows them.
component ShowcaseShell(_ title: String, lede: String = "", other: String = "", lang: String = "en") {
    slot filters
    slot

    SiteHeader(other: other, lang: lang)

    Stack(gap: .lg, role: "main", id: "bp-main", tabindex: "-1", class: "bp-main bp-wrap") { // wf-allow(A16)
        style { gap: 24px; padding-top: 40px; padding-bottom: 72px; @md { padding-top: 56px } }

        Stack(gap: .sm) {
            style { gap: 14px }
            Heading(title).h1 { style { margin: 0; font-size: clamp(30px, 5vw, 44px); line-height: 1.08; font-weight: 650; letter-spacing: -0.025em } }
            if lede != "" {
                Markdown(lede, class: "bp-lede")
            }
        }

        Row(align: .center, gap: .sm, role: "group", aria-label: t("showcase.filter")) {
            style { flex-wrap: wrap; gap: 8px; padding-bottom: 8px; border-bottom: 1px solid $line }
            filters
        }

        Grid(columns: { base: 1, sm: 2, lg: 3, xl: 4 }, gap: .md) {
            children
        }
    }
}

/// One output on the showcase: its first page on the measuring grid, what
/// it is, its size and pages, and the file and the source that made it.
component ShowcaseTile(_ title: String, output: String = "pdf", body: String = "", size: String = "", pages: Number = 0, picture: String = "", alt: String = "", file: String = "", source: String = "", lang: String = "en") {
    Stack(class: "bp-sheet bp-show-tile") {
        Stack(class: "bp-grid bp-show-tile__picture") {
            if picture != "" {
                Image(src: picture, alt: alt)
            }
        }
        Stack(gap: .sm, class: "bp-show-tile__body") {
            Text(title, lang: lang, class: "bp-show-tile__title")
            if body != "" {
                Text(body, lang: lang, class: "bp-small")
            }
            Row(class: "bp-labels") {
                Text(t("building.{output}"), class: "bp-label")
                if pages > 0 {
                    Text(t("showcase.pagecount", { count: pages }), class: "bp-label bp-num")
                }
                if size != "" {
                    Text(size, class: "bp-label bp-num")
                }
            }
            Row(gap: .sm) {
                style { flex-wrap: wrap; gap: 8px; margin-top: auto; padding-top: 4px }
                if file != "" {
                    Link(t("showcase.open"), href: file, class: "bp-button", data-tone: "action")
                }
                if source != "" {
                    Link(t("showcase.source"), href: source, class: "bp-button", data-tone: "quiet")
                }
            }
        }
    }
}
