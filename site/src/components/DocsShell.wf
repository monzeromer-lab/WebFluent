/// T2, a chapter or an essay: the header; the book on one side, with how far
/// the reader has got; the page — its kind and where it sits, the title,
/// one sentence on what it is, what it assumes — then the body at a reading
/// measure, what the reader learned, and the pages either side; the
/// headings on the other side.
///
/// The props the guide's generated pages pass (`heading`, `chapter`,
/// `blurb`, `source`, `sections`, the four prev/next ones) keep their
/// meaning; the rest are optional and say what the generator will know
/// once the pages move to `/learn`.
component DocsShell(_ heading: String, chapter: String = "", blurb: String = "", source: String = "md-docs", sections: [Anchor] = [], prevTo: String = "", prevLabel: String = "", nextTo: String = "", nextLabel: String = "", kind: PageKind = .tutorial, book: [Chapter] = GUIDE, prereqs: [RelatedLink] = [], outputs: [String] = [], learned: [String] = [], codes: [RelatedLink] = [], other: String = "", lang: String = "en") {
    slot
    use Book

    // A chapter opened counts as read, for the book's progress.
    effect { Book.visit(location.pathname) }

    // The page the reader arrived on suggests what they are building.
    use Building
    effect { if let first = outputs[0] { Building.arrive(first) } }

    // The place in the header a page of this kind belongs to.
    derived section = match kind {
        .howto { "/recipes" }
        .reference { "/reference" }
        .error { "/errors" }
        else { "/learn" }
    }

    // The book as the contents panel lists it on a phone.
    derived bookEntries = book.filter(c => kind == .tutorial).map(c => IndexEntry(label: "{c.n}. " + (if c.key != "" { t(c.key) } else { c.title }), to: c.to, group: if c.part != "" { t(c.part) } else { "" }))

    SiteHeader(docs: true, other: other, lang: lang, section: section)

    Row(align: .start, class: "bp-wrap") {
        style { flex-wrap: nowrap; gap: 0; @md { gap: 32px } @xl { gap: 48px } }

        // The book beside its chapters; an essay is read once, and a
        // reference page is looked up, so neither has it.
        if kind == .tutorial {
            BookSidebar(chapters: book)
        }

        // One per page: the skip link's target.
        Stack(gap: .lg, role: "main", id: "bp-main", tabindex: "-1", class: "bp-main docs-main") { // wf-allow(A16)
            style { gap: 24px; padding: 32px 0 72px; @md { padding-top: 40px } }

            Row(class: "bp-labels") {
                KindLabel(kind)
                if chapter != "" {
                    Text(chapter, class: "bp-label")
                }
                OutputBadges(outputs: outputs)
            }

            Stack(gap: .sm) {
                style { gap: 14px }
                Heading(heading).h1 { style { margin: 0; font-size: clamp(30px, 5vw, 40px); line-height: 1.08; font-weight: 650; letter-spacing: -0.025em; overflow-wrap: anywhere } }
                if blurb != "" {
                    Text(blurb, class: "bp-lede")
                }
                Prereqs(links: prereqs)
                PageContents(entries: bookEntries, sections: sections, label: t("book.title"))
            }

            // The guide is written in English; it keeps its direction when
            // the interface switches to Arabic. An Arabic page reads right
            // to left.
            Stack(gap: .lg, dir: if lang == "ar" { "rtl" } else { "ltr" }, class: "bp-prose docs-article") {
                style { gap: 20px; text-align: start }
                children
            }

            if learned.length > 0 {
                Stack(gap: .sm, class: "bp-raised") {
                    style { gap: 10px; max-width: $prose-max; padding: 20px }
                    Heading(t("docs.learned")).h2 { style { margin: 0; font-size: 19px; line-height: 1.3; font-weight: 600 } }
                    List {
                        style { margin: 0; padding-inline-start: 20px; & li { margin: 4px 0; color: $ink; font-size: 15px } }
                        for item in learned by item {
                            List.Item { Markdown(item) }
                        }
                    }
                }
            }

            PrevNext(prevTo: prevTo, prevLabel: prevLabel, nextTo: nextTo, nextLabel: nextLabel)
        }

        OnThisPage(sections: sections, source: source, codes: codes)
    }
}
