/// The right-hand rail of a page: its headings, then — when the page names
/// them — the codes a reader may meet here; the page as Markdown, to copy
/// or open (its twin, `/learn/07-state.md`, which an agent reads too); and
/// the page's source.
component OnThisPage(sections: [Anchor] = [], source: String = "md-docs", codes: [RelatedLink] = []) {
    state copied = false

    /// Where this page's twin is: the address with `.md` on the end.
    action twin() {
        let path = location.pathname.replace(/\/(index\.html)?$/, "").replace(/\.html$/, "")
        return if path == "" { "/index.md" } else { "{path}.md" }
    }

    action copyPage() {
        try {
            let text = await fetch(twin(), as: .text)
            await navigator.clipboard.writeText(text)
            copied = true
            setTimeout(() => uncopy(), 1600)
        } catch e {
            window.open(twin(), "_blank", "noopener")
        }
    }
    action uncopy() { copied = false }

    Stack(gap: .lg, role: "navigation", aria-label: t("docs.onthispage"), class: "bp-rail") {
        style {
            display: none
            gap: 24px
            width: $rail-w
            flex-shrink: 0
            align-self: flex-start
            position: sticky
            top: $header-h
            max-height: calc(100vh - 60px)
            overflow-y: auto
            box-sizing: border-box
            padding: 32px 0 32px 8px
            @media (min-width: 1200px) { display: flex }
        }

        if sections.length > 0 {
            Stack(gap: .xs) {
                style { gap: 2px }
                Text(t("docs.onthispage"), class: "bp-section-label") { style { margin-bottom: 6px } }
                for section in sections by section.id {
                    Link(section.label, href: "#{section.id}") {
                        style {
                            padding: 4px 0 4px 12px
                            border-inline-start: 1px solid $line
                            color: $muted
                            font-size: 13.5px
                            line-height: 20px
                            text-decoration: none
                            &:hover { border-color: $construction; color: $ink; text-decoration: none }
                        }
                    }
                }
            }
        }

        if codes.length > 0 {
            Stack(gap: .xs) {
                style { gap: 6px; padding-top: 20px; border-top: 1px solid $line }
                Text(t("docs.codes"), class: "bp-section-label") { style { margin-bottom: 4px } }
                for code in codes by code.to {
                    Link(to: code.to) {
                        style { display: flex; align-items: center; gap: 8px; color: $muted; font-size: 13px; text-decoration: none; &:hover { color: $ink; text-decoration: none } & p { margin: 0 } }
                        Text(code.kind, class: "bp-label", data-tone: "error")
                        Text(code.title)
                    }
                }
            }
        }

        Stack(gap: .xs) {
            style { gap: 8px; padding-top: 20px; border-top: 1px solid $line }
            Button(class: "bp-rail-action") {
                style { display: flex; align-items: center; justify-content: flex-start; gap: 8px; padding: 0; border: 0; background: none; color: $muted; font-family: inherit; font-size: 13px; cursor: pointer; &:hover { color: $ink } & .wf-icon { display: inline-flex; font-size: 15px } & p { margin: 0 } }
                on click { copyPage() }
                Icon(if copied { "check" } else { "copy" })
                Text(if copied { t("docs.copied") } else { t("docs.copy") })
            }
            Button(class: "bp-rail-action") {
                style { display: flex; align-items: center; justify-content: flex-start; gap: 8px; padding: 0; border: 0; background: none; color: $muted; font-family: inherit; font-size: 13px; cursor: pointer; &:hover { color: $ink } & .wf-icon { display: inline-flex; font-size: 15px } & p { margin: 0 } }
                on click { window.open(twin(), "_blank", "noopener") }
                Icon("file")
                Text(t("docs.markdown"))
            }
        }

        Link(href: "{REPO}/blob/master/{source}") {
            style { display: flex; align-items: center; gap: 8px; padding-top: 20px; border-top: 1px solid $line; color: $muted; font-size: 13px; text-decoration: none; &:hover { color: $ink } & .wf-icon { display: inline-flex; font-size: 15px } & p { margin: 0 } }
            Icon("edit")
            Text(t("docs.edit"))
        }
    }
}
