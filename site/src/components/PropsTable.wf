/// The props of one entry, as the reference lists them: the name in mono
/// link ink, the type or the cases in mono, what it is when a call leaves it
/// out (`defaults`), and what it does. `nameLabel` and `typeLabel` head the
/// first two columns when its rows are not props. Its look is
/// `.props-table` in blueprint.css, so its two shapes share it.
component PropsTable(rows: [PropsRow], caption: String = "Props", nameLabel: String = "", typeLabel: String = "", defaults: Bool = false) {
    if defaults {
        DataTable(rows: rows, key: r => r.name, label: caption, class: "props-table props-table--defaults") {
            DataTable.Column(if nameLabel != "" { nameLabel } else { t("ref.prop") }) {
                cell(row) {
                    for spelling, i in row.name.split(", ") by i {
                        Text(spelling, class: "props-table__name")
                    }
                }
            }
            DataTable.Column(if typeLabel != "" { typeLabel } else { t("ref.type") }, value: r => r.type)
            DataTable.Column(t("ref.default")) { cell(row) { Markdown(if row.default == "" { "—" } else { row.default }) } }
            DataTable.Column(t("ref.meaning")) { cell(row) { Markdown(row.meaning) } }
        }
    } else {
        DataTable(rows: rows, key: r => r.name, label: caption, class: "props-table") {
            // `--dir, -d DIR`: each spelling on a line of its own, never
            // broken at its hyphen.
            DataTable.Column(if nameLabel != "" { nameLabel } else { t("ref.prop") }) {
                cell(row) {
                    for spelling, i in row.name.split(", ") by i {
                        Text(spelling, class: "props-table__name")
                    }
                }
            }
            DataTable.Column(if typeLabel != "" { typeLabel } else { t("ref.type") }, value: r => r.type)
            DataTable.Column(t("ref.meaning")) { cell(row) { Markdown(row.meaning) } }
        }
    }
}
