/// The site's top bar, in Blueprint: the mark and the release, the six
/// places as tabs (the current one a sheet pulled forward, ruled in cyan),
/// then search, the Building switch, Night/Day, the language and GitHub.
/// On a phone the places, and the Building switch, fold behind a menu
/// button; from `lg` up everything sits in the bar.
///
/// `other` is the address of this page in the other language, when it has
/// one; `lang` is the language the page is written in; `section` is the
/// place a page belongs to when its address does not say so (the guide's
/// chapters live under `/docs/`, but belong to Learn, Recipes or Reference).
///
/// On a phone the bar holds the mark, search, Night/Day and the menu, each
/// a 40px square; the places, the Building switch and the language are in
/// the menu.
component SiteHeader(docs: Bool = false, other: String = "", lang: String = "en", section: String = "") {
    use Search
    state menu = false

    on key("Escape") { menu = false }

    SkipLink

    Row(align: .center, role: "banner", class: "bp-header") {
        style {
            position: sticky
            top: 0
            z-index: 100
            flex-wrap: nowrap
            height: $header-h
            border-bottom: 1px solid $line
            background: $ground
        }

        Row(align: .center, gap: .md, class: "bp-wrap") {
            style { flex-wrap: nowrap; height: 100%; gap: 12px; @lg { gap: 20px } }

            Link(to: "/", aria-label: t("header.home")) {
                style { display: flex; flex-shrink: 0; align-items: center; gap: 10px; min-height: 40px; color: $ink; text-decoration: none; &:hover { text-decoration: none } & p { margin: 0 } }
                Image(src: "/favicon.svg", alt: "") { style { width: 28px; height: 28px; display: block } }
                Text("WebFluent") { style { font-size: 16px; font-weight: 650; letter-spacing: -0.01em } }
                Text(VERSION, class: "bp-label bp-num")
            }

            Row(role: "navigation", aria-label: t("header.places"), class: "bp-tabs") {
                style { display: none; align-self: flex-end; @lg { display: flex } }
                for place in SECTIONS by place.to {
                    Link(t(place.key), to: place.to, active: .prefix, class: if place.to == section { "bp-tab active" } else { "bp-tab" }, aria-current: if place.to == section { "page" } else { null })
                }
            }

            Row(align: .center, gap: .sm) {
                style { flex: 1 1 auto; justify-content: flex-end; flex-wrap: nowrap; gap: 8px; min-width: 0 }

                Button(aria-label: t("search.open"), aria-keyshortcuts: "Meta+K Control+K", aria-haspopup: "dialog", class: "bp-field bp-search") {
                    style { flex: 0 0 40px; width: 40px; padding: 0; justify-content: center; @md { flex: 0 1 260px; width: auto; padding: 0 12px; justify-content: flex-start } }
                    on click { Search.reveal() }
                    Icon("search")
                    Text(t("search.trigger"), class: "bp-hide-sm") { style { flex: 1 1 auto; white-space: nowrap; overflow: hidden; text-overflow: ellipsis } }
                    Text(keyLabel("mod+k"), class: "bp-kbd bp-hide-sm")
                }

                BuildingSwitch(class: "bp-hide-sm")
                ThemeToggle
                LangSwitch(other: other, lang: lang, class: "bp-hide-sm")

                Link(href: REPO, class: "bp-button bp-hide-sm", data-tone: "quiet", aria-label: "GitHub") {
                    Icon("git-branch")
                    Text("GitHub")
                }

                IconButton(icon: if menu { "close" } else { "menu" }, label: t("nav.menu"), class: "bp-icon-button", aria-expanded: menu) {
                    style { @lg { display: none } }
                    on click { menu = !menu }
                }
            }
        }
    }

    if menu {
        Stack(gap: .xs, role: "navigation", aria-label: t("header.places"), animate: .slideDown, exit: .fadeOut) {
            style {
                position: sticky
                top: $header-h
                z-index: 99
                gap: 4px
                max-height: calc(100vh - 60px)
                overflow-y: auto
                padding: 8px 16px 16px
                border-bottom: 1px solid $line
                background: $ground
                @lg { display: none }
            }
            for place in SECTIONS by place.to {
                Link(t(place.key), to: place.to, active: .prefix, class: "bp-navlink") {
                    style { min-height: 44px }
                    on click { menu = false }
                }
            }
            Divider { style { margin: 8px 0; border-color: $line } }
            Row(align: .center, gap: .sm, class: "bp-only-sm") {
                style { flex-wrap: wrap; gap: 8px }
                BuildingSwitch
                LangSwitch(other: other, lang: lang)
            }
            Link(t("nav.source"), href: REPO, class: "bp-navlink") { style { min-height: 44px } }
        }
    }

    SearchPalette
}
