/// The events an entry fires: the name a handler is written with, what it
/// sends, and when.
component EventsTable(rows: [PropRow] = [], caption: String = "") {
    if rows.length > 0 {
        Stack(class: "bp-table-wrap") {
            DataTable(rows: rows, key: r => r.name, label: if caption != "" { caption } else { t("ref.events.caption") }, class: "bp-table") {
                DataTable.Column(t("ref.event")) { cell(row) { Code("on {row.name}") } }
                DataTable.Column(t("ref.sends")) { cell(row) { Code(if row.kind != "" { row.kind } else { "—" }) } }
                DataTable.Column(t("ref.meaning"), value: r => r.detail)
            }
        }
    }
}
