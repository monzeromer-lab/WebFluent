/// What kind of aside a callout is. Each has one job, so a reader learns to
/// trust the label: a note adds context, a tip saves time, important is
/// something to know before going on, a warning is a way to lose work or
/// ship a bug, and caution is a way to lose data or expose a secret.
enum CalloutKind { note, tip, important, warning, caution }

/// An aside the guide sets apart from its prose: a GitHub alert in
/// `md-docs/` (`> [!TIP]`), written here by the site's generator. Drawn as
/// Blueprint draws every aside — a dot and a leader line — with the kind as
/// its label; a warning's and a caution's dot is the error colour.
component Callout(_ body: String, kind: CalloutKind = .note) {
    derived label = match kind {
        .note { t("aside.note") }
        .tip { t("aside.tip") }
        .important { t("aside.important") }
        .warning { t("aside.warning") }
        .caution { t("aside.caution") }
    }
    derived urgent = kind == .warning || kind == .caution

    Stack(role: "note", aria-label: label, class: "bp-aside", data-urgent: urgent) {
        style {
            &[data-urgent="true"]::before { background: $error }
            &[data-urgent="true"]::after { background: $error }
            &[data-urgent="true"] .bp-aside__label { color: $error-ink }
        }
        Text(label, class: "bp-aside__label")
        Markdown(body)
    }
}
