/// T5, one diagnostic: the code and its title (both in the heading, as a
/// reader who searched for the code expects), its severity and family; what
/// the compiler prints, as it prints it; the broken code and the fixed one,
/// side by side, with what the fix is under them (`note`) — straight after
/// the message, for a reader who came from a terminal's `docs:` link; why
/// the rule exists (the page's body); whether `lints` may lower it, and the
/// setting that does; then related codes and the chapter that covers it. Every
/// family is in the sidebar. A code with nothing more to say than its
/// summary has no "Why" (`why: false`), and one no short program can draw
/// shows only the fix (`broken: false`).
component ErrorShell(_ code: String, title: String = "", severity: String = "error", family: String = "", summary: String = "", printed: String = "", quickfix: String = "", lowerable: Bool = false, why: Bool = true, example: Bool = true, families: [IndexEntry] = [], related: [RelatedLink] = [], sections: [Anchor] = [], source: String = "md-docs", other: String = "", lang: String = "en") {
    slot broken
    slot fixed
    slot note
    slot

    derived lowered = if severity == "error" { "warn" } else { "off" }

    SiteHeader(docs: true, other: other, lang: lang)

    Row(align: .start, class: "bp-wrap") {
        style { flex-wrap: nowrap; gap: 0; @md { gap: 32px } @xl { gap: 48px } }

        IndexSidebar(entries: families, label: t("nav.errors"))

        // One per page: the skip link's target.
        Stack(gap: .lg, role: "main", id: "bp-main", tabindex: "-1", class: "bp-main") { // wf-allow(A16)
            style { gap: 24px; padding: 32px 0 72px; @md { padding-top: 40px } }

            Breadcrumbs(trail: [Place(key: "nav.errors", to: "/errors")], current: family)

            // The code, whether it stops the build, and its family. No kind
            // label: it said "Error" on a warning's page too, beside the
            // severity that says it again; the breadcrumb places the page.
            Row(class: "bp-labels") {
                Text(code, class: "bp-label", data-tone: if severity == "error" { "error" } else { "construction" })
                Text(if severity == "error" { t("error.severity.error") } else { t("error.severity.warning") }, class: "bp-label")
                if family != "" {
                    Text(family, class: "bp-label")
                }
            }

            Stack(gap: .sm) {
                style { gap: 14px }
                Heading(if title == "" { code } else { "{code} — {title}" }).h1 { style { margin: 0; font-size: clamp(28px, 5vw, 40px); line-height: 1.1; font-weight: 650; letter-spacing: -0.025em } }
                if summary != "" {
                    Text(summary, class: "bp-lede")
                }
                PageContents(entries: families, sections: sections, label: t("nav.errors"))
            }

            if printed != "" {
                Stack(gap: .sm) {
                    style { gap: 12px }
                    Heading(t("error.printed"), id: "printed").h2 { style { margin: 0; font-size: 19px; font-weight: 600 } } // wf-allow(A16): one shell per page
                    Diagnostic(printed)
                    // The fix the compiler offers for this program: what an
                    // editor's quick fix and `wf fix` apply.
                    if quickfix != "" {
                        Markdown(t("error.quickfix", { title: quickfix, code: code }), class: "bp-small")
                    }
                }
            }

            Stack(gap: .sm) {
                style { gap: 12px }
                Heading(t("error.fix"), id: "fix").h2 { style { margin: 0; font-size: 19px; font-weight: 600 } } // wf-allow(A16): one shell per page
                if example {
                    Grid(columns: { base: 1, lg: 2 }, gap: .md) {
                        Stack(gap: .xs) {
                            style { gap: 8px; min-width: 0 }
                            Text(t("error.broken"), class: "bp-label", data-tone: "error") { style { align-self: flex-start; font-family: inherit } }
                            broken
                        }
                        Stack(gap: .xs) {
                            style { gap: 8px; min-width: 0 }
                            Text(t("error.fixed"), class: "bp-label", data-tone: "ok") { style { align-self: flex-start } }
                            fixed
                        }
                    }
                    Stack(class: "bp-prose") { note }
                } else {
                    Stack(class: "bp-prose") { fixed }
                }
            }

            if why {
                Stack(gap: .md, class: "bp-prose") {
                    style { gap: 14px }
                    Heading(t("error.why"), id: "why").h2 // wf-allow(A16): one shell per page
                    children
                }
            }

            Row(align: .center, gap: .sm, class: "bp-raised") {
                style { gap: 12px; flex-wrap: wrap; padding: 14px 16px; max-width: $prose-max }
                Text(if lowerable { t("error.lowerable.yes") } else { t("error.lowerable.no") }) { style { margin: 0; font-size: 14px } }
                // A warning is already "warn": what lowers it is "off", or an
                // allow on its one line. An error that may be lowered goes
                // to "warn"; one that may not shows no setting at all.
                if lowerable {
                    Code("\"lints\": \{ \"{code}\": \"{lowered}\" \}", class: "bp-ltr", dir: "ltr") { style { font-size: 12.5px; color: $muted } }
                    Code("// wf-allow({code})", class: "bp-ltr", dir: "ltr") { style { font-size: 12.5px; color: $muted } }
                }
            }

            Related(links: related)
        }

        OnThisPage(sections: sections, source: source)
    }
}
