/// The guide's chapter nav, written from the chapters' own metadata by
/// scripts/site-from-guide.py; edit the guide, not this file. 280px, a group
/// per part of the guide under an overline label, each chapter with its
/// number in mono; the one whose `to` matches the route carries the rail,
/// the wash and the bold. Sections, not numbers: the reader finds a page by
/// what it is for.
component DocSidebar {
    Sidebar(aria-label: t("nav.chapters")) {
        style {
            width: 280px
            flex-shrink: 0
            padding: 24px 16px
            gap: 6px
            border-inline-end: 1px solid $border
            background: $color-background
            overflow-y: auto
            & .wf-sidebar__item { height: 32px; padding: 0 10px; gap: 10px; border-radius: 4px; font-size: 13px; line-height: 20px; color: $color-text-muted }
            & .wf-sidebar__item:hover { background: $surface-hover; color: $color-text }
            & .wf-sidebar__item.active { padding-inline-start: 7px; border-inline-start: 3px solid $color-primary; border-radius: 0 4px 4px 0; background: $brand-subtle; color: $color-text; font-weight: 600 }
            & .wf-sidebar__item p { margin: 0 }
            & .wf-sidebar__divider { display: none }
            & .group-label { margin: 20px 0 16px; padding: 0 10px; font-size: 12px; line-height: 18px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: $ink-subtle }
            & .group-label:first-child { margin-top: 0 }
        }

        Sidebar.Item(to: "/docs", icon: "home") { Text(t("nav.overview")) }

        Text(t("nav.group.start"), class: "group-label")
        Sidebar.Item(to: "/docs/guide/introduction") { Text(t("ch.01")) }
        Sidebar.Item(to: "/docs/guide/getting-started") { Text(t("ch.02")) }
        Sidebar.Item(to: "/docs/guide/tutorial") { Text(t("ch.03")) }
        Sidebar.Item(to: "/docs/guide/coming-from") { Text(t("ch.04")) }

        Text(t("nav.group.tutorials"), class: "group-label")
        Sidebar.Item(to: "/docs/tutorials/todos") { Text(t("ch.05")) }
        Sidebar.Item(to: "/docs/tutorials/field-notes") { Text(t("ch.06")) }
        Sidebar.Item(to: "/docs/tutorials/pocket") { Text(t("ch.07")) }
        Sidebar.Item(to: "/docs/guide/recipes") { Text(t("ch.08")) }

        Text(t("nav.group.concepts"), class: "group-label")
        Sidebar.Item(to: "/docs/guide/language-basics") { Text(t("ch.09")) }
        Sidebar.Item(to: "/docs/guide/pages-and-routing") { Text(t("ch.10")) }
        Sidebar.Item(to: "/docs/guide/elements") { Text(t("ch.11")) }
        Sidebar.Item(to: "/docs/guide/state") { Text(t("ch.12")) }
        Sidebar.Item(to: "/docs/guide/events") { Text(t("ch.13")) }
        Sidebar.Item(to: "/docs/guide/control-flow") { Text(t("ch.14")) }
        Sidebar.Item(to: "/docs/guide/components") { Text(t("ch.15")) }
        Sidebar.Item(to: "/docs/guide/stores") { Text(t("ch.16")) }
        Sidebar.Item(to: "/docs/guide/types") { Text(t("ch.17")) }
        Sidebar.Item(to: "/docs/guide/expressions") { Text(t("ch.18")) }

        Text(t("nav.group.ui"), class: "group-label")
        Sidebar.Item(to: "/docs/guide/styling") { Text(t("ch.19")) }
        Sidebar.Item(to: "/docs/guide/motion") { Text(t("ch.20")) }
        Sidebar.Item(to: "/docs/guide/media") { Text(t("ch.21")) }
        Sidebar.Item(to: "/docs/guide/accessibility") { Text(t("ch.22")) }

        Text(t("nav.group.data"), class: "group-label")
        Sidebar.Item(to: "/docs/guide/forms") { Text(t("ch.23")) }
        Sidebar.Item(to: "/docs/guide/data") { Text(t("ch.24")) }
        Sidebar.Item(to: "/docs/guide/realtime") { Text(t("ch.25")) }
        Sidebar.Item(to: "/docs/guide/offline") { Text(t("ch.26")) }

        Text(t("nav.group.content"), class: "group-label")
        Sidebar.Item(to: "/docs/guide/content") { Text(t("ch.27")) }
        Sidebar.Item(to: "/docs/guide/i18n") { Text(t("ch.28")) }

        Text(t("nav.group.quality"), class: "group-label")
        Sidebar.Item(to: "/docs/guide/testing") { Text(t("ch.29")) }
        Sidebar.Item(to: "/docs/guide/security") { Text(t("ch.30")) }
        Sidebar.Item(to: "/docs/guide/performance") { Text(t("ch.31")) }

        Text(t("nav.group.ship"), class: "group-label")
        Sidebar.Item(to: "/docs/guide/project-structure") { Text(t("ch.32")) }
        Sidebar.Item(to: "/docs/guide/static-and-spa") { Text(t("ch.33")) }
        Sidebar.Item(to: "/docs/guide/deploying") { Text(t("ch.34")) }
        Sidebar.Item(to: "/docs/guide/environments") { Text(t("ch.35")) }
        Sidebar.Item(to: "/docs/guide/desktop") { Text(t("ch.36")) }

        Text(t("nav.group.outputs"), class: "group-label")
        Sidebar.Item(to: "/docs/guide/pdf-and-slides") { Text(t("ch.37")) }
        Sidebar.Item(to: "/docs/guide/server-rendering") { Text(t("ch.38")) }
        Sidebar.Item(to: "/docs/guide/interop") { Text(t("ch.39")) }

        Text(t("nav.group.reference"), class: "group-label")
        Sidebar.Item(to: "/docs/reference", active: .prefix) { Text(t("ch.40")) }
        Sidebar.Item(to: "/docs/guide/cli") { Text(t("ch.41")) }
        Sidebar.Item(to: "/docs/guide/config") { Text(t("ch.42")) }
        Sidebar.Item(to: "/docs/guide/diagnostics") { Text(t("ch.43")) }
        Sidebar.Item(to: "/docs/guide/built-ins") { Text(t("ch.44")) }
        Sidebar.Item(to: "/docs/guide/tokens") { Text(t("ch.45")) }
        Sidebar.Item(to: "/docs/guide/runtime") { Text(t("ch.46")) }
        Sidebar.Item(to: "/docs/guide/grammar") { Text(t("ch.47")) }
        Sidebar.Item(to: "/docs/guide/browser-support") { Text(t("ch.48")) }
        Sidebar.Item(to: "/docs/guide/glossary") { Text(t("ch.49")) }

        Text(t("nav.group.help"), class: "group-label")
        Sidebar.Item(to: "/docs/guide/troubleshooting") { Text(t("ch.50")) }
        Sidebar.Item(to: "/docs/guide/upgrading") { Text(t("ch.51")) }
        Sidebar.Item(to: "/docs/guide/contributing") { Text(t("ch.52")) }
    }
}
