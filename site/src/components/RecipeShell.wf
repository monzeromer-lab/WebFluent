/// T3, a recipe: the title is the task; then the outputs it works in and
/// the release it needs; the complete code first; how it works, step by
/// step; variations; then related recipes and reference. The other recipes
/// are in the sidebar. `summary` is Markdown; `how` draws the "How it
/// works" heading over the body (off when the body brings its own
/// headings); `hasVariations` draws the variations. `project` is the
/// recipe's code as files (path → text), given when they make a project that
/// checks clean: it is offered as a download and in the Playground.
component RecipeShell(_ title: String, summary: String = "", outputs: [String] = [], since: String = "", recipes: [IndexEntry] = [], sections: [Anchor] = [], related: [RelatedLink] = [], source: String = "md-docs", how: Bool = true, hasVariations: Bool = true, project: Map = {}, other: String = "", lang: String = "en") {
    slot code
    slot variations
    slot

    SiteHeader(other: other, lang: lang)

    Row(align: .start, class: "bp-wrap") {
        style { flex-wrap: nowrap; gap: 0; @md { gap: 32px } @xl { gap: 48px } }

        IndexSidebar(entries: recipes, label: t("nav.recipes"))

        // One per page: the skip link's target.
        Stack(gap: .lg, role: "main", id: "bp-main", tabindex: "-1", class: "bp-main") { // wf-allow(A16)
            style { gap: 24px; padding: 32px 0 72px; @md { padding-top: 40px } }

            Breadcrumbs(trail: [Place(key: "nav.recipes", to: "/recipes")])

            Row(class: "bp-labels") {
                KindLabel(.howto)
                OutputBadges(outputs: outputs)
                if since != "" {
                    SinceBadge(since)
                }
            }

            Stack(gap: .sm) {
                style { gap: 14px }
                Heading(title).h1 { style { margin: 0; font-size: clamp(30px, 5vw, 40px); line-height: 1.08; font-weight: 650; letter-spacing: -0.025em } }
                if summary != "" {
                    Markdown(summary, class: "bp-lede")
                }
                PageContents(entries: recipes, sections: sections, label: t("nav.recipes"))
            }

            Stack(gap: .sm) {
                style { gap: 12px; min-width: 0 }
                code
                if Object.keys(project).length > 0 {
                    Row(align: .center, gap: .sm) {
                        style { flex-wrap: wrap; gap: 8px }
                        Button(t("recipe.download"), class: "bp-button", data-track: "download_recipe", data-track-item-id: title) {
                            on click { wfDownload(location.pathname.split("/").pop(), project) }
                        }
                        Button(t("code.play"), class: "bp-button", data-track: "open_playground", data-track-item-id: title) {
                            on click { wfOpenInPlayground(project) }
                        }
                        Text(t("recipe.files", { files: Object.keys(project).join(", ") }), class: "bp-small") { style { margin: 0 } }
                    }
                }
            }

            Stack(gap: .lg, dir: if lang == "ar" { "rtl" } else { "ltr" }, class: "bp-prose") {
                style { gap: 20px }
                if how {
                    Heading(t("recipe.how"), id: "how-it-works").h2 // wf-allow(A16): one shell per page
                }
                children
            }

            if hasVariations {
                Stack(gap: .md, class: "bp-prose") {
                    style { gap: 16px }
                    Heading(t("recipe.variations"), id: "variations").h2 // wf-allow(A16): one shell per page
                    variations
                }
            }

            Related(links: related)
        }

        OnThisPage(sections: sections, source: source)
    }
}
