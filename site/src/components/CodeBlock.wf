/// A code block on the console surface, dark in both themes: a bar with the
/// file or language and Copy, then the code coloured by the compiler's
/// highlighter. `title` names the file or the language; one the
/// highlighter knows colours the block.
component CodeBlock(_ code: String, title: String = "wf", note: String = "") {
    state copied = false
    derived language = if title == "wf" || title == "wfx" || title.endsWith(".wf") { "wf" } else if title == "json" || title == "css" { title } else if title == "shell" || title == "bash" { "bash" } else { "" }

    action copy() {
        copied = true
        try { navigator.clipboard.writeText(code) } catch e { log(e) }
        setTimeout(() => reset(), 1600)
    }
    action reset() { copied = false }

    // A whole program, with a page in it, opens in the Playground as it is.
    derived runnable = language == "wf" && /^page /m.test(code)
    action play() {
        let files = {}
        files["src/pages/Home.wf"] = code
        files["webfluent.app.json"] = "\{ \"name\": \"Example\" \}\n"
        wfOpenInPlayground(files)
    }

    Stack(class: "bp-console code-block bp-ltr", dir: "ltr") {
        style { gap: 0; min-width: 0 }
        Row(class: "bp-console__bar") {
            style { flex-wrap: nowrap; align-items: center }
            Row(align: .center, gap: .sm) {
                style { flex-wrap: nowrap; min-width: 0; padding: 0 6px; & p { margin: 0 } }
                Text(title, class: "bp-mono") { style { font-size: 12px; color: $term-dim } }
                if note != "" {
                    Text(note) { style { font-size: 12px; color: $term-dim; white-space: nowrap; overflow: hidden; text-overflow: ellipsis } }
                }
            }
            Row(align: .center, gap: .xs) {
                style { flex-wrap: nowrap; gap: 6px }
                if runnable {
                    Button(t("code.play"), class: "bp-button bp-hide-sm", data-track: "open_playground", data-track-item-id: title) {
                        style { margin-bottom: 0 }
                        on click { play() }
                    }
                }
                Button(if copied { t("code.copied") } else { t("code.copy") }, aria-label: t("code.copy"), class: "bp-button", data-track: "copy_code", data-track-item-id: title) {
                    style { margin-bottom: 0 }
                    on click { copy() }
                }
            }
        }
        // It scrolls sideways when a line is long, so the keyboard can reach it.
        Code(code, language: language, class: "bp-console__code", tabindex: "0").block
    }
}
