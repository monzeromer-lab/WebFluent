/// One control of a Stage, drawn from a prop's kind: a segmented choice for
/// an enum, a switch for a `Bool`, a field for a `String`. They are drawn
/// disabled: what they change is a preview the compiler draws, and that
/// waits for the compiler to run in the reader's browser.
component StageControl(_ control: Map) {
    state checked = false
    state text = ""

    if control.kind == "enum" {
        Row(align: .center, gap: .xs, role: "group", aria-label: control.name) {
            style { flex-wrap: wrap; gap: 4px; & p { margin: 0 } & button { min-height: 28px; padding: 0 8px; font-family: $font-family-mono; font-size: 12px } }
            Text(control.name, class: "bp-mono") { style { margin-inline-end: 4px; font-size: 12px; color: $muted } }
            for o in control.options by o {
                Button(".{o}", disabled: true, aria-pressed: o == control.value, class: "bp-button", data-tone: "quiet")
            }
        }
    }
    if control.kind == "bool" {
        Switch(bind: checked, label: control.name, disabled: true)
    }
    if control.kind == "string" {
        Input(bind: text, label: control.name, disabled: true) { style { max-width: 180px } }
    }
}
