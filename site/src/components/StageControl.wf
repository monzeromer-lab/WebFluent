/// One control of a Stage, drawn from a prop's kind: a segmented choice for
/// an enum, a toggle for a `Bool`. What they would change is a preview the
/// compiler draws, which waits for the compiler to run in the reader's
/// browser.
component StageControl(_ control: Map) {
    // An enum prop: its name, then its cases as one segmented group, the
    // default marked. A Bool prop: a small toggle. A String prop is the
    // example's own text, not a control. Until the compiler runs in the
    // page they show the defaults and change nothing (the note under the
    // stage says so), so they are not drawn as buttons waiting to be pressed.
    if control.kind == "enum" {
        Row(align: .center, gap: .xs, role: "group", aria-label: control.name, class: "bp-stage-control") {
            Text(control.name, class: "bp-stage-control__name")
            Row(class: "bp-segmented") {
                for o in control.options by o {
                    Text(o, class: "bp-segmented__item", data-on: o == control.value)
                }
            }
        }
    }
    if control.kind == "bool" {
        Row(align: .center, gap: .xs, class: "bp-stage-control bp-toggle") {
            Icon("square", aria-hidden: "true")
            Text(control.name)
        }
    }
}
