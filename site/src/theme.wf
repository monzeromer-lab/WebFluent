/// Blueprint, at night: the site's default. Two inks drawn from one mark —
/// graphite is structure, blue is intent — and cyan only where something is
/// measured or has focus. Depth is a hairline, never a shadow; only an
/// overlay floats.
///
/// The roles (`ground`, `sheet`, `raised`, `ink`, `muted`, `line`, `action`,
/// `link`, `construction`, `error`, `console`, `grid`) are what the site's
/// components name. The baseline's own tokens (`color-*`, `surface-*`,
/// `brand-*`) are set from them, so the built-ins and the guide's pages wear
/// the same colours.
theme Night {
    // The roles.
    ground: #0E1012
    sheet: #17191C
    raised: #1F2225
    ink: #EEF0F2
    muted: #A9AEB4
    line: #2C3035
    action: #3D6FA3
    action-hover: #4A7DB2
    action-subtle: #16283C
    link: #8FBDE7
    construction: #6FD3E6
    construction-subtle: #10313A
    error: #D94F45
    error-ink: #FF8A80
    error-subtle: #3A1714
    ok: #5FD3A4
    ok-subtle: #0F2E22
    console: #101315
    console-bar: #14171A
    console-line: #2C3035
    grid: rgba(143,189,231,0.07)

    // The baseline's tokens, from the roles.
    color-primary: #3D6FA3
    color-secondary: #2F9FB6
    color-success: #2F9D76
    color-danger: #D94F45
    color-warning: #C98A1F
    color-info: #3D6FA3
    color-background: #0E1012
    color-surface: #17191C
    color-text: #EEF0F2
    color-text-muted: #A9AEB4
    color-border: #2C3035

    surface-canvas: #0E1012
    surface-raised: #1F2225
    surface-sunken: #0E1012
    surface-overlay: #1F2225
    surface-hover: #1F2225
    ink-subtle: #A9AEB4
    ink-inverse: #17191C
    brand-ink: #8FBDE7
    brand-subtle: #16283C
    brand-ring: #6FD3E6
    accent: #2F9FB6
    accent-ink: #6FD3E6
    accent-subtle: #10313A
    border-strong: #4A5057

    // A console is dark in both themes.
    term-bg: #101315
    term-ink: #E6E9EC
    term-dim: #959BA1
    syntax-keyword: #8FBDE7
    syntax-string: #7FD6A8
    syntax-number: #E0B070
    syntax-function: #6FD3E6
    syntax-punct: #B3BAC0
    syntax-comment: #959BA1

    // Type: Instrument Sans for words, JetBrains Mono for code and for
    // every number that measures.
    font-family: 'Instrument Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif
    font-family-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace
    type-display: 56px
    type-display-leading: 1.02
    type-display-tracking: -0.035em
    type-h1: 40px
    type-h1-leading: 1.08
    type-h2: 26px
    type-h2-leading: 1.2
    type-h3: 19px
    type-h3-leading: 1.3
    type-body: 16px
    type-body-leading: 1.65
    type-small: 13px
    type-code: 13px
    type-code-leading: 1.65

    // Shape: 4px, and 3px for a label.
    radius-none: 0
    radius-label: 3px
    radius-sm: 4px
    radius-md: 4px
    radius-lg: 4px
    radius-xl: 6px
    radius-full: 999px

    // Space, on a 4px step.
    space-1: 4px
    space-2: 8px
    space-3: 12px
    space-4: 16px
    space-5: 20px
    space-6: 24px
    space-8: 32px
    space-10: 40px
    space-12: 48px
    space-16: 64px

    // The measuring grid, drawn only behind previews and stages.
    grid-step: 24px

    // Depth: a hairline. Only an overlay casts a shadow.
    shadow-sm: none
    shadow-md: 0 8px 24px rgba(0,0,0,0.45)
    shadow-lg: 0 16px 48px rgba(0,0,0,0.55)

    transition-fast: 100ms ease
    transition-normal: 140ms ease

    // Measures.
    prose-max: 680px
    content-max: 1360px
    sidebar-w: 264px
    rail-w: 232px
    header-h: 60px
}

/// Blueprint by day: what a reader gets when they choose it. The build
/// cannot yet name a theme for "the reader chose light" (`theme.dark` is the
/// only alternate), so `blueprint.css` repeats these values under
/// `:root[data-theme="light"]`; this declaration is the source of them, and
/// is what `wf theme` and `A13` read when the config names it.
theme Day {
    ground: #F9FAFB
    sheet: #FFFFFF
    raised: #F4F6F7
    ink: #17191C
    muted: #5A5F64
    line: #E2E5E8
    action: #2B5178
    action-hover: #234566
    action-subtle: #E7EEF6
    link: #2B5178
    construction: #0D6274
    construction-subtle: #E0F2F6
    error: #B3261E
    error-ink: #B3261E
    error-subtle: #FBE9E7
    ok: #1C7A5A
    ok-subtle: #E3F3EC
    console: #1B1F22
    console-bar: #22272B
    console-line: #2C3035
    grid: rgba(43,81,120,0.07)

    color-primary: #2B5178
    color-secondary: #0F7285
    color-success: #1C7A5A
    color-danger: #B3261E
    color-warning: #8A5800
    color-info: #2B5178
    color-background: #F9FAFB
    color-surface: #FFFFFF
    color-text: #17191C
    color-text-muted: #5A5F64
    color-border: #E2E5E8

    surface-canvas: #F9FAFB
    surface-raised: #F4F6F7
    surface-sunken: #F4F6F7
    surface-overlay: #FFFFFF
    surface-hover: #F4F6F7
    ink-subtle: #5A5F64
    ink-inverse: #F9FAFB
    brand-ink: #2B5178
    brand-subtle: #E7EEF6
    brand-ring: #0D6274
    accent: #0F7285
    accent-ink: #0D6274
    accent-subtle: #E0F2F6
    border-strong: #9AA0A6

    term-bg: #1B1F22
    term-ink: #E6E9EC
    term-dim: #959BA1
    syntax-keyword: #8FBDE7
    syntax-string: #7FD6A8
    syntax-number: #E0B070
    syntax-function: #6FD3E6
    syntax-punct: #B3BAC0
    syntax-comment: #959BA1

    font-family: 'Instrument Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif
    font-family-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace

    shadow-sm: none
    shadow-md: 0 8px 24px rgba(23,25,28,0.12)
    shadow-lg: 0 16px 48px rgba(23,25,28,0.18)
}
