// edit the recipe, not this file.
page RecipeCountDown(path: "/recipes/count-down", title: "Count down — Recipes", description: "Count down once a second with an every timer that changes a state, and show the time left as a progress bar and text.") {
    RecipeShell("Count down", summary: "A countdown is a number that drops once a second until it reaches zero. To build one, change a state in an `every` timer:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Keep the active tab in the address", to: "/recipes/active-tab-in-the-address"), RelatedLink(kind: "Recipe", title: "Keep filters in the address", to: "/recipes/filters-in-the-address"), RelatedLink(kind: "Recipe", title: "Build a confirm dialog", to: "/recipes/confirm-dialog")], source: "md-docs/recipes/count-down.md", how: true, hasVariations: false) {
        code {
            Markdown("**Needs:** nothing besides the page. It claims `/`: paste it into a new project, or replace the starter's `src/pages/Home.wf` with it.")
            CodeBlock(#"page Countdown(path: "/", title: "Countdown", description: "Ten seconds, counted down.") {
    state left = 10
    every(1000) { if left > 0 { left = left - 1 } }
    Heading("Countdown").h1
    Progress(value: 10 - left, max: 10)
    Text(if left == 0 { "Done" } else { "{left}s" })
}"#, title: "wf")
        }
        Markdown("- `left` is a [`state`](/learn/07-state-and-reactivity#state) holding the seconds that remain.\n- [`every(1000)`](/learn/07-state-and-reactivity#timers) runs its block every 1000 milliseconds. The `if` stops the count at zero.\n- The `Progress` bar and the `Text` both read `left`, so they repaint on every tick. The text says **Done** at zero.\n\nThe timer stops when the page leaves, so a reader who navigates away leaves no interval running.")

    }
}
