// A recipe, written from md-docs/recipes/search-and-link-previews.md by scripts/docsite/recipes.py;
// edit the recipe, not this file.
page RecipeSearchAndLinkPreviews(path: "/recipes/search-and-link-previews", title: "Describe pages to search engines and link previews — Recipes", description: "Give every page the title, description, canonical link, Open Graph tags and JSON-LD that search engines and link previews read.") {
    RecipeShell("Describe pages to search engines and link previews", summary: "The build writes each page's head — its title, description, canonical link, Open Graph and Twitter tags, JSON-LD and icons — from the page's attributes and the `meta` settings in `webfluent.app.json`, so what a search result or a shared link shows is set where the page is declared. This blog has a home page with its own sharing image, a page per post that adds tags of its own, and a thanks page kept out of search:", outputs: ["website"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works"), Anchor(id: "a-checklist-for-being-found", label: "A checklist for being found")], related: [RelatedLink(kind: "Recipe", title: "Pre-render a page for each item", to: "/recipes/pre-render-each-item"), RelatedLink(kind: "Recipe", title: "Publish a page in each language", to: "/recipes/site-in-two-languages"), RelatedLink(kind: "Recipe", title: "Show your own page for an unknown address", to: "/recipes/not-found-page")], source: "md-docs/recipes/search-and-link-previews.md", how: true, hasVariations: false, project: { "src/pages/SearchAndLinkPreviews.wf": #"type Post { slug: String, title: String, summary: String, cover: String, date: String, body: String }

const SITE = "https://acme.example"

data posts: [Post] = "posts.json"

page Home(path: "/", title: "Acme", description: "Tools for small teams.", image: "/og-default.png", image_alt: "The Acme logo on a blue field") {
    Heading("Acme").h1
    for p in posts by p.slug {
        Link(p.title, to: "/posts/{p.slug}")
    }
}

page PostPage(path: "/posts/:slug", slug: String, type: "article", paths: posts.map(p => p.slug),
              title: "{posts.find(p => p.slug == slug)?.title ?? slug} — Acme",
              description: "{posts.find(p => p.slug == slug)?.summary ?? "A post from the blog."}") {
    derived post = posts.find(p => p.slug == slug)
    head {
        meta(property: "og:image", content: "{SITE}{post?.cover ?? "/og-default.png"}")
        meta(property: "article:published_time", content: post?.date ?? "")
    }
    if let p = post {
        Image(src: p.cover, alt: p.title)
        Heading(p.title).h1
        Text(format(p.date, .date, "long")).muted
        Markdown(p.body)
    }
}

page Thanks(path: "/thanks", title: "Thanks", description: "Your message reached us.", noindex: true) {
    Heading("Thanks").h1
}
"#, "webfluent.app.json": #"{
  "name": "search-and-link-previews"
}
"# }) {
        code {
            Markdown("**Needs:** `src/posts.json` and the pictures it names in `public/`, and `meta.site_url` in `webfluent.app.json`, each shown below. It claims `/` and the name `Home`: paste it into a new project, or replace the starter's `src/pages/Home.wf` with it.")
            CodeBlock(#"type Post { slug: String, title: String, summary: String, cover: String, date: String, body: String }

const SITE = "https://acme.example"

data posts: [Post] = "posts.json"

page Home(path: "/", title: "Acme", description: "Tools for small teams.", image: "/og-default.png", image_alt: "The Acme logo on a blue field") {
    Heading("Acme").h1
    for p in posts by p.slug {
        Link(p.title, to: "/posts/{p.slug}")
    }
}

page PostPage(path: "/posts/:slug", slug: String, type: "article", paths: posts.map(p => p.slug),
              title: "{posts.find(p => p.slug == slug)?.title ?? slug} — Acme",
              description: "{posts.find(p => p.slug == slug)?.summary ?? "A post from the blog."}") {
    derived post = posts.find(p => p.slug == slug)
    head {
        meta(property: "og:image", content: "{SITE}{post?.cover ?? "/og-default.png"}")
        meta(property: "article:published_time", content: post?.date ?? "")
    }
    if let p = post {
        Image(src: p.cover, alt: p.title)
        Heading(p.title).h1
        Text(format(p.date, .date, "long")).muted
        Markdown(p.body)
    }
}

page Thanks(path: "/thanks", title: "Thanks", description: "Your message reached us.", noindex: true) {
    Heading("Thanks").h1
}"#, title: "wf")
            Markdown("The posts are a JSON file the build reads, `src/posts.json`; a list of one is enough to try it:")
            CodeBlock(#"[
  {
    "slug": "hello",
    "title": "Hello, world",
    "summary": "Why we started Acme, and what we make.",
    "cover": "/covers/hello.png",
    "date": "2026-03-05",
    "body": "We make *tools* for small teams."
  }
]"#, title: "json")
        }
        Markdown("Put the pictures it names in `public/` (`public/og-default.png`, `public/covers/hello.png`), and set `meta.site_url` as the config below does. Built, `posts/hello/index.html` is titled \"Hello, world — Acme\", its description is the post's summary, and its `og:image` is `https://acme.example/covers/hello.png`.\n\nEach page's `title:` and `description:` are its `<title>` and the snippet a search result shows; `image:` and `image_alt:` are its sharing card's picture; `type: \"article\"` marks a post; `noindex: true` keeps a page out of search. The rest comes from `meta` in `webfluent.app.json`. A config that fills in every site-wide setting:")

        CodeBlock(#"{
  "meta": {
    "title": "Acme",
    "description": "Tools for small teams.",
    "lang": "en",
    "site_url": "https://acme.example",
    "site_name": "Acme Inc.",
    "owner": "organization",
    "same_as": ["https://github.com/acme"],
    "image": "/og-default.png",
    "image_alt": "The Acme logo on a blue field",
    "favicon": "/favicon.svg",
    "touch_icon": "/apple-touch-icon.png",
    "sitemap": true,
    "fonts": ["https://fonts.googleapis.com/css2?family=Inter&display=swap"],
    "stylesheets": ["/print.css"]
  }
}"#, title: "json")

        Markdown("What the build writes into each page's head:\n\n- **`<title>` and `<meta name=\"description\">`**, from the page's `title:` and `description:`. The description is the snippet a search result shows and a link preview quotes; keep it under about 150 characters.\n- **A canonical link and `og:url`**, when `site_url` is set. A relative canonical is worse than none, so without `site_url` the build writes none.\n- **Open Graph and Twitter card tags**: `og:title`, `og:description`, `og:image` (the page's `image:` or the site's), `og:type` from `type:` (`website` or `article`), `og:site_name`, and `og:locale` in the form Open Graph reads — `meta.lang` `en` is `en_US`, `en-GB` is `en_GB`, `ar` is `ar_AR` — with an `og:locale:alternate` for each other locale.\n- **The image's size and description**: `og:image:width` and `og:image:height`, read from the file when the image is in `public/` (one on another origin is not fetched, so its card states no size), and `og:image:alt` and `twitter:image:alt` from the page's `image_alt:`, or `meta.image_alt` for the site's image. A sharing image is best at 1200×630.\n- **JSON-LD**: the site's owner, a `WebSite` it publishes, a `WebPage` or `Article`, and a `BreadcrumbList` derived from the route's segments. Each breadcrumb is a page a reader can open; a level no route answers is left out.\n- **`hreflang` alternates** for the page and each of its translations (`translates:`), each at its own address and in its own `lang:`, with `x-default` for the one in the site's language ([A page in its own language](/recipes/site-in-two-languages)).\n- **The icons**: `<link rel=\"icon\">` for `favicon` (typed, so an SVG is read as one) and `<link rel=\"apple-touch-icon\">` for `touch_icon`. Each is linked from the site's root under the `base_path` (`/my-site/favicon.svg`), so it stays right when the router moves the page to another address.\n- **`<meta name=\"robots\" content=\"noindex\">`**, and no sitemap entry, for a `noindex: true` page.")

        Heading("Add tags for one page", id: "add-tags-for-one-page").h3

        Markdown("To add tags of a page's own — an article's cover, its publication date — write them in `head \{ \}` ([Pages and routing](/learn/05-pages-and-routing#per-page-head-tags)). `PostPage` above sets its own Open Graph image from the post. A link preview fetches the image from another site, so its address must be absolute: `\{SITE\}` puts the site's origin in front of the post's site-relative cover. A tag written in `head \{ \}` takes the place of the one the build would write, so the page carries one `og:image`.\n\nThe `title:` and `description:` of a `:param` page may name its parameters — `title: \"\{slug\} — Blog\"` — and each pre-rendered file, and the live page's tab, has that route's value. The title may also splice an expression over the parameters and the program's constants and data, as `PostPage`'s does, and so may the description. The build works it out for each file, and the router again on each visit. `image:` is written as it stands, so a picture that depends on the parameter goes in `head \{ \}`. Anything else the head should say about the entry goes in `head \{ \}`, as above; the runtime keeps those tags current as the parameter changes.")

        Heading("Say who the site belongs to", id: "say-who-the-site-belongs-to").h3

        Markdown("The JSON-LD names the site's owner: `meta.site_name`, published as an `Organization` unless `meta.owner` says it is a person. To publish a personal site, name the person, what they do and where else they are:")

        CodeBlock(#"{
  "meta": {
    "site_url": "https://ada.example",
    "site_name": "Ada Lovelace",
    "owner": "person",
    "job_title": "Analyst",
    "same_as": ["https://github.com/ada", "https://www.linkedin.com/in/ada/"]
  }
}"#, title: "json")

        Markdown("The JSON-LD then holds a `Person` (`@id` `…/#person`) with `jobTitle` and `sameAs`. The `WebSite`'s `publisher` and every `WebPage`'s `about` point at it. An organisation's `WebSite` names it as `publisher` too, and takes `same_as` for its profiles.\n\nTo say anything else schema.org allows about a person or an organisation, add it to `meta.owner_details`. It is merged into the node as written:")

        CodeBlock(#"{
  "meta": {
    "owner_details": {
      "alternateName": "Augusta Ada King",
      "worksFor": [{ "@type": "Organization", "name": "Analytical Engines" }],
      "alumniOf": { "@type": "CollegeOrUniversity", "name": "University of London" },
      "knowsAbout": ["Mathematics", "Computing"],
      "knowsLanguage": ["en", "fr"]
    }
  }
}"#, title: "json")

        Markdown("What the node is — `@type`, `@id`, `name`, `url` — and what `job_title` and `same_as` write come from those settings; setting one in `owner_details` is `E111`.")

        Callout("Structured data has to agree with what the pages show, and the build cannot check that. State in `owner_details` only what the site says too.", kind: .warning)

        Heading("Preload fonts served from the site", id: "preload-fonts-served-from-the-site").h3

        Markdown("A font named by a `@font-face` in a project `.css` file is found only once `styles.css` has arrived and been read. To fetch it with the page instead, list it in `meta.preload`:")

        CodeBlock(#"{ "meta": { "preload": ["/fonts/inter-latin.woff2"] } }"#, title: "json")

        CodeBlock(#"/* src/fonts.css */
@font-face {
  font-family: "Inter";
  font-weight: 400 800;
  font-display: swap;
  src: url("/fonts/inter-latin.woff2") format("woff2");
}"#, title: "css")

        Markdown("Each path becomes a `<link rel=\"preload\">` in every page's head, ahead of the stylesheets, with `as` taken from its extension: `font`, `style`, `script` or `image`. A font preload also carries `crossorigin`, without which the browser fetches the font twice.\n\nServing the fonts from `public/` instead of a font service also takes a third-party stylesheet and two connections out of the way of the first paint. A path on another origin is `E111`: the policy the build ships would refuse it.")

        Heading("Keep addresses from redirecting", id: "keep-addresses-from-redirecting").h3

        Markdown("A static build writes `/contact` as `contact/index.html`. Most static hosts — GitHub Pages among them — answer `/contact` with a `301` redirect to `/contact/`. A canonical link, a sitemap entry and every link that names `/contact` then name an address that redirects, which a search engine reads as \"not this page\". To fix it, set `build.clean_urls` to one of two values:")

        CodeBlock(#"{ "build": { "ssg": true, "clean_urls": "file" } }"#, title: "json")

        Markdown("- **`\"file\"`** keeps `/contact` and writes `contact.html` beside `contact/index.html`, which the host serves for `/contact` directly. The page then addresses its scripts and sheets from the site's root (`/app.js`, under the `base_path`), so the one file reads the same from either address.\n- **`\"directory\"`** names every route with its slash: the canonical link, `og:url`, the sitemap, the breadcrumbs, the `hreflang` alternates, and every `Link(to:)`, `Sidebar.Item(to:)` and `navigate()` whose target is one of the site's pages (`/contact` becomes `/contact/`). A file such as `/cv.pdf`, another origin, or an address worked out whole at run time is left as written.\n\nUnset, the addresses are `/contact` and the files `contact/index.html`. That is right for a host that serves the directory without a redirect: Netlify, Cloudflare Pages, and Vercel with `cleanUrls`.")

        Heading("A checklist for being found", id: "a-checklist-for-being-found").h2

        Markdown("- Set `meta.site_url`. Without it there are no canonical links, no sitemap and no absolute sharing URLs.\n- Give every page a `title:` and a `description:` of about 150 characters. `S01`–`S03` warn when one is missing or too long.\n- Pre-render with `build.ssg: true`, so the text is in the HTML.\n- Use one `h1` per page, with headings in order (`A11`, `A12`).\n- Give every shared page an `image:`, or set `meta.image` for the site — at 1200 × 630 pixels, which suits most previews — in `public/`, so its size is in the card, with an `image_alt:` (or `meta.image_alt`) that says what it shows.\n- On GitHub Pages and hosts like it, set `build.clean_urls`, so the canonical address never redirects.\n- For a personal site, set `meta.owner: \"person\"`, with `job_title`, `same_as` and, for the rest of who they are, `owner_details`.\n- Serve web fonts from `public/`, named in `meta.preload`, instead of a font service's stylesheet.\n- Set `noindex: true` on pages that should not be found: sign-in, thanks, drafts.\n- Check the result: view a built page's source, and paste a URL into a link-preview debugger.")

    }
}
