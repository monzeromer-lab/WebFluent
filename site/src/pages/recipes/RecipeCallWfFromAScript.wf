page RecipeCallWfFromAScript(path: "/recipes/call-wf-from-a-script", title: "Call WF from a script — Recipes", description: "The runtime is `window.WF`.") {
    RecipeShell("Call WF from a script", summary: "The runtime is `window.WF`. A script under `src/`, the console, or a library's callback can call it: `WF.navigate(\"/about\")`, `WF.toast(\"Saved\", \"success\")`, `WF.storeSnapshot(\"Cart\")`. The [runtime reference](/reference/runtime) lists every function.  > [!WARNING] > A build keeps only the runtime modules its own code reaches. A script that > calls a module nothing else uses needs `\"build\": \{ \"runtime\": \"full\" \}`, > or the call fails in the browser.  A script from another origin must be listed in `meta.scripts`, which widens the policy for it. The build's CSP check refuses an inline `<script>` ([Security](/docs/guide/security#ship-a-content-security-policy)).", outputs: [], since: "", recipes: RECIPE_INDEX, sections: [], related: [RelatedLink(kind: "Recipe", title: "Call your own JavaScript", to: "/recipes/call-your-own-script"), RelatedLink(kind: "Recipe", title: "Draw a chart from a library", to: "/recipes/chart-from-a-library"), RelatedLink(kind: "Recipe", title: "Draw into a node a script made", to: "/recipes/portal")], source: "md-docs/recipes/call-wf-from-a-script.md", how: false, hasVariations: false) {
    }
}
