  "meta": {
    "scripts": [
      {
        "src": "https://js.stripe.com/v3/pricing-table.js",
        "async": true
      }
    ]
  }
}
"# }) {
        code {
            Markdown("**Needs:** the `meta.scripts` setting below, which loads the element's library.")
            CodeBlock(#"// Your publishable key, from the Stripe dashboard.
const STRIPE_KEY = "pk_test_123"

page Pricing(path: "/pricing", title: "Pricing", description: "Plans.") {
    state loaded = false

    Heading("Pricing").h1
    if !loaded { Spinner }
    Element("stripe-pricing-table", publishableKey: STRIPE_KEY, pricing-table-id: "prctbl_1") {
        on ready { loaded = true }
    }
}"#, title: "wf")
            Markdown("The script that defines the element loads from `meta.scripts` in `webfluent.app.json`:")
            CodeBlock(#"{ "meta": {
    "scripts": [{ "src": "https://js.stripe.com/v3/pricing-table.js", "async": true }]
} }"#, title: "json")
        }
        Markdown("- The tag comes first. It is lower case, with a hyphen, as every custom element's tag is; any other tag is an `E116` error.\n- A named argument is an attribute: `publishableKey` is written `publishable-key`. An attribute follows state like any other value.\n- An `on` handler hears the events the element fires, whatever their names.\n- The block is the element's children.\n- `class:`, `style \{ \}` and `mount:` work as on any other element.\n\nThe script that defines the element (your own, or one in `meta.scripts`) upgrades it when it runs. Nothing on the page waits for this one, so it loads `async` ([Load a library from a CDN](/recipes/library-from-a-cdn#variations)).")

        Heading("Troubleshooting", id: "troubleshooting").h2

        Table(caption: "Troubleshooting") {
            Table.Head {
                Table.Row {
                    Table.Cell("What you see").header
                    Table.Cell("What to do").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`E116` on an `Element`") }
                    Table.Cell("Write the tag as a custom element's: lower case, with a hyphen")
                }
                Table.Row {
                    Table.Cell("The element stays empty")
                    Table.Cell { Markdown("The script that defines it has not run: check its entry in `meta.scripts`") }
                }
                Table.Row {
                    Table.Cell("The element is blocked in the console")
                    Table.Cell { Markdown("It loads more than its script, such as a frame from its own origin; add that origin to `meta.frame` or `meta.connect`") }
                }
            }
        }

    }
