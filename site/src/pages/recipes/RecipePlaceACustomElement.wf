page RecipePlaceACustomElement(path: "/recipes/place-a-custom-element", title: "Place a custom element from a library — Recipes", description: "Place a custom element a library defines, such as Stripe's pricing table, with Element: its tag, attributes that follow state, and its events.") {
    RecipeShell("Place a custom element from a library", summary: "To place a custom element that a library defines, use `Element` with the element's tag. This page places Stripe's pricing table, and shows a spinner until the table says it is ready:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works"), Anchor(id: "troubleshooting", label: "Troubleshooting")], related: [RelatedLink(kind: "Recipe", title: "Publish components as custom elements", to: "/recipes/publish-custom-elements"), RelatedLink(kind: "Recipe", title: "Load a library from a CDN", to: "/recipes/library-from-a-cdn"), RelatedLink(kind: "Recipe", title: "Upgrade a WebFluent 4 project that uses external", to: "/recipes/migrate-from-external")], source: "md-docs/recipes/place-a-custom-element.md", how: true, hasVariations: false, project: { "src/pages/PlaceACustomElement.wf": #"// Your publishable key, from the Stripe dashboard.
const STRIPE_KEY = "pk_test_123"

page Pricing(path: "/pricing", title: "Pricing", description: "Plans.") {
    state loaded = false

    Heading("Pricing").h1
    if !loaded { Spinner }
    Element("stripe-pricing-table", publishableKey: STRIPE_KEY, pricing-table-id: "prctbl_1") {
        on ready { loaded = true }
    }
}
"#, "webfluent.app.json": #"{
