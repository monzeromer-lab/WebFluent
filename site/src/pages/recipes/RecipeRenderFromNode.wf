// A recipe. This page is its source: edit it here.
page RecipeRenderFromNode(path: "/recipes/render-from-node", title: "Render templates from Node — Recipes", description: "Render WebFluent templates from Node.js with the webfluent package: an Express server that answers with an invoice as HTML or as a PDF.") {
    RecipeShell("Render templates from Node", summary: "The Node binding is a small wrapper around `wf render`: it renders a template with your data as HTML, a fragment, a PDF or slides. This Express server answers with an invoice in either form. You need Node.js, npm and the `wf` command, and a template like the one in [Render a template with data](/recipes/render-a-template). This one is `templates/invoice.wf`:", outputs: ["website", "pdf", "slides"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works"), Anchor(id: "troubleshooting", label: "Troubleshooting")], related: [RelatedLink(kind: "Recipe", title: "Render templates from Rust", to: "/recipes/render-from-rust"), RelatedLink(kind: "Recipe", title: "Render a template with data", to: "/recipes/render-a-template")], source: "site/src/pages/recipes/RecipeRenderFromNode.wf", how: true, hasVariations: false, project: { "server.js": #"// server.js
const path = require("node:path");
const express = require("express");
const { Template } = require("webfluent");

// Every .wf and .wfx under templates/, as one template; its Invoice page.
const invoice = Template.fromDir(path.join(__dirname, "templates")).page("Invoice");

// Your own data source; one invoice, kept in memory here.
const invoices = {
  "INV-001": {
    number: "INV-001",
    customer: { name: "Acme Corp" },
    items: [{ name: "Widget", qty: 5, price: 9.99 }],
    total: 49.95,
    paid: false,
  },
};

const app = express();

// The PDF route comes first, so `/invoices/INV-001.pdf` is not read as an id.
app.get("/invoices/:id.pdf", async (req, res) => {
  const data = invoices[req.params.id];
  if (!data) return res.sendStatus(404);
  res.type("application/pdf").send(await invoice.renderPdfAsync(data));
});

app.get("/invoices/:id", async (req, res) => {
  const data = invoices[req.params.id];
  if (!data) return res.sendStatus(404);
  res.send(await invoice.renderHtmlAsync(data));
});

app.listen(3000, () => console.log("http://localhost:3000/invoices/INV-001"));
"#, "src/pages/RenderFromNode.wf": #"type Customer { name: String }
type Item { name: String, qty: Number, price: Number }

page Invoice(path: "/", title: "Invoice {number}", description: "An invoice.",
             number: String, customer: Customer, items: [Item], total: Number, paid: Bool) {
    Heading("Invoice #{number}").h1
    Text("Bill to: {customer.name}")
    Table {
        Table.Head { Table.Row { Table.Cell("Item")  Table.Cell("Qty")  Table.Cell("Amount") } }
        Table.Body {
            for item in items {
                Table.Row {
                    Table.Cell(item.name)
                    Table.Cell("{item.qty}")
                    Table.Cell(format(item.price * item.qty, .currency))
                }
            }
        }
    }
    if paid { Badge("Paid").success } else { Badge("Due").warning }
    Text("Total: {format(total, .currency)}").bold.lg
}
"#, "webfluent.app.json": #"{
  "name": "render-from-node"
}
"# }) {
        code {
            DocsCodeBlock(#"type Customer { name: String }
type Item { name: String, qty: Number, price: Number }

page Invoice(path: "/", title: "Invoice {number}", description: "An invoice.",
             number: String, customer: Customer, items: [Item], total: Number, paid: Bool) {
    Heading("Invoice #{number}").h1
    Text("Bill to: {customer.name}")
    Table {
        Table.Head { Table.Row { Table.Cell("Item")  Table.Cell("Qty")  Table.Cell("Amount") } }
        Table.Body {
            for item in items {
                Table.Row {
                    Table.Cell(item.name)
                    Table.Cell("{item.qty}")
                    Table.Cell(format(item.price * item.qty, .currency))
                }
            }
        }
    }
    if paid { Badge("Paid").success } else { Badge("Due").warning }
    Text("Total: {format(total, .currency)}").bold.lg
}"#, title: "wf")
            Markdown("Install the binding and Express. `wf` must be installed too, since the binding runs it:")
            Terminal(lines: [
                        Line(command: "npm install webfluent express")
                    ])
            Markdown("This is the server, `server.js`:")
            DocsCodeBlock(#"// server.js
const path = require("node:path");
const express = require("express");
const { Template } = require("webfluent");

// Every .wf and .wfx under templates/, as one template; its Invoice page.
const invoice = Template.fromDir(path.join(__dirname, "templates")).page("Invoice");

// Your own data source; one invoice, kept in memory here.
const invoices = {
  "INV-001": {
    number: "INV-001",
    customer: { name: "Acme Corp" },
    items: [{ name: "Widget", qty: 5, price: 9.99 }],
    total: 49.95,
    paid: false,
  },
};

const app = express();

// The PDF route comes first, so `/invoices/INV-001.pdf` is not read as an id.
app.get("/invoices/:id.pdf", async (req, res) => {
  const data = invoices[req.params.id];
  if (!data) return res.sendStatus(404);
  res.type("application/pdf").send(await invoice.renderPdfAsync(data));
});

app.get("/invoices/:id", async (req, res) => {
  const data = invoices[req.params.id];
  if (!data) return res.sendStatus(404);
  res.send(await invoice.renderHtmlAsync(data));
});

app.listen(3000, () => console.log("http://localhost:3000/invoices/INV-001"));"#, title: "js")
        }
        Markdown("Run `node server.js` and open `/invoices/INV-001` for the page, or `/invoices/INV-001.pdf` for the PDF.\n\n- `Template.fromDir` reads every template under the directory, with components shared, and `page(\"Invoice\")` picks the page to render. `Template.fromFile` and `Template.fromString` load one template instead. The server loads it once, at start-up.\n- Every render has a synchronous form (`renderHtml`, `renderHtmlFragment`, `renderPdf`, `renderSlides`) and an `…Async` form that does not block the event loop. Use the `…Async` forms in a server, as this one does.\n- `withTheme`, `withTokens` and `withLang` set what the Rust API sets ([Render templates from Rust](/recipes/render-from-rust#configure-a-render)), and each returns the template, so they chain before a render.\n- The data is held to the page's parameters before anything is drawn: a field missing or of the wrong type throws, its message naming the place (`T33 … $.items[1].price is missing`).\n- A render runs `wf` once and takes a few milliseconds. The data goes over standard input, so it is never written to disk; a template given as a string is written to a temporary file once, the first time it renders.\n\nThe binding needs `wf` itself installed. It looks for it at `WF_BIN`, then on `PATH`, then in `~/.webfluent/bin` and `~/.cargo/bin` (and, outside Windows, `/usr/local/bin` and `/usr/bin`). Its version is the compiler's.")

        Heading("Troubleshooting", id: "troubleshooting").h2

        Table(caption: "Troubleshooting") {
            Table.Head {
                Table.Row {
                    Table.Cell("What you see").header
                    Table.Cell("What to do").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`WebFluent CLI (wf) not found`") }
                    Table.Cell { Markdown("Install `wf`, or set `WF_BIN` to the binary's path") }
                }
                Table.Row {
                    Table.Cell("The render fails with \"no page called …\"")
                    Table.Cell { Markdown("Pass `page()` one of the names the message lists") }
                }
                Table.Row {
                    Table.Cell { Markdown("A render throws `T33`") }
                    Table.Cell("The data is not what the page's parameters say; the message names the place")
                }
                Table.Row {
                    Table.Cell { Markdown("A `\{name\}` renders empty") }
                    Table.Cell { Markdown("The page declares no parameters, and the data has no top-level key `name`. Declare them, and the render says so instead") }
                }
            }
        }

    }
}
