page RecipeDriveAnAnimation(path: "/recipes/drive-an-animation", title: "Drive an animation yourself — Recipes", description: "Play an animation from a handler with animate(element, name, duration) and a ref: handle, or play an element's own again with replayAnimation.") {
    RecipeShell("Drive an animation yourself", summary: "Play an animation when something happens, not only when an element arrives: a card that pulses as the pointer reaches it. Call `animate(element, name, duration)` from a handler, with a `ref:` handle on the element:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works"), Anchor(id: "variations", label: "Variations")], related: [RelatedLink(kind: "Recipe", title: "Set motion defaults, and respect reduced motion", to: "/recipes/motion-defaults"), RelatedLink(kind: "Recipe", title: "Animate an element in and out", to: "/recipes/animate-in-and-out"), RelatedLink(kind: "Recipe", title: "Animate a list", to: "/recipes/animate-a-list")], source: "md-docs/recipes/drive-an-animation.md", how: true, hasVariations: true, project: { "src/pages/DriveAnAnimation.wf": #"page Hover(path: "/", title: "Hover", description: "A card that pulses on hover.") {
    Heading("Hover").h1
    Card(ref: panel) {
        on mouseenter { animate(panel, "pulse", "400ms") }
        Text("Point at me.")
    }
}
"#, "webfluent.app.json": #"{
  "name": "drive-an-animation"
}
"# }) {
        code {
            Markdown("**Needs:** nothing besides the page. It claims `/`: paste it into a new project, or replace the starter's `src/pages/Home.wf` with it.")
            CodeBlock(#"page Hover(path: "/", title: "Hover", description: "A card that pulses on hover.") {
    Heading("Hover").h1
    Card(ref: panel) {
        on mouseenter { animate(panel, "pulse", "400ms") }
        Text("Point at me.")
    }
}"#, title: "wf")
        }
        variations {
            Heading("Replay an element's own animation", id: "replay-an-element-s-own-animation").h3

            Markdown("A flag plays once, when the element arrives. To play an animation the element already carries again, from the start, call `replayAnimation(element, name)`:")

            CodeBlock(#"page Replay(path: "/", title: "Replay", description: "A card that fades in again on hover.") {
    Heading("Replay").h1
    Card.outlined.fadeIn {
        on mouseenter(e) { replayAnimation(e.currentTarget, "fadeIn") }
        Text("Point at me.")
    }
}"#, title: "wf")

        }
        Markdown("- `ref: panel` gives the page a handle on the card's element.\n- `animate(panel, \"pulse\", \"400ms\")` plays the built-in `pulse` animation on it for 400ms, each time the pointer enters the card.\n- `animate` returns a handle that plays as soon as it is made, and its `play()`, `cancel()` and `finished` are yours.")

    }
