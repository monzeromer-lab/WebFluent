page RecipeDriveAnAnimation(path: "/recipes/drive-an-animation", title: "Drive an animation yourself — Recipes", description: "To play an animation from a handler, call `animate(element, name, duration)` with a `ref:` handle.") {
    RecipeShell("Drive an animation yourself", summary: "To play an animation from a handler, call `animate(element, name, duration)` with a `ref:` handle. It returns a handle that plays as soon as it is made, and its `play()`, `cancel()` and `finished` are yours:", outputs: [], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Add a dark-mode switch", to: "/recipes/dark-mode-switch"), RelatedLink(kind: "Recipe", title: "Add a picture, sized for every screen", to: "/recipes/add-a-picture"), RelatedLink(kind: "Recipe", title: "Add video and audio", to: "/recipes/video-and-audio")], source: "md-docs/recipes/drive-an-animation.md", how: true, hasVariations: false) {
        code {
            CodeBlock(#"page Hover(path: "/", title: "Hover", description: "A card that pulses on hover.") {
    Heading("Hover").h1
    Card(ref: panel) {
        on mouseenter { animate(panel, "pulse", "400ms") }
        Text("Point at me.")
    }
}"#, title: "wf")
        }
        Markdown("A flag plays once, when the element arrives. To play an animation the element already carries again, from the start, call `replayAnimation(element, name)`:")

        CodeBlock(#"page Replay(path: "/", title: "Replay", description: "A card that fades in again on hover.") {
    Heading("Replay").h1
    Card.outlined.fadeIn {
        on mouseenter(e) { replayAnimation(e.currentTarget, "fadeIn") }
        Text("Point at me.")
    }
}"#, title: "wf")

    }
}
