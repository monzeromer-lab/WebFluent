// A recipe, written from md-docs/recipes/render-from-rust.md by scripts/docsite/recipes.py;
// edit the recipe, not this file.
page RecipeRenderFromRust(path: "/recipes/render-from-rust", title: "Render templates from Rust — Recipes", description: "Render WebFluent templates from a Rust program or server with the webfluent crate: load them once, then render HTML, fragments, PDFs and slides.") {
    RecipeShell("Render templates from Rust", summary: "The template engine is the `webfluent` crate. Load the templates once, at start-up, and render them with your own data as HTML, a fragment of a page, a PDF or slides. You need a Rust project, and a template like the one in [Render a template with data](/recipes/render-a-template). This one is `templates/invoice.wf`:", outputs: ["website", "pdf", "slides"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works"), Anchor(id: "use-it-in-a-server", label: "Use it in a server"), Anchor(id: "limits-of-one-render", label: "Limits of one render"), Anchor(id: "troubleshooting", label: "Troubleshooting")], related: [RelatedLink(kind: "Recipe", title: "Render a template with data", to: "/recipes/render-a-template"), RelatedLink(kind: "Recipe", title: "Render templates from Node", to: "/recipes/render-from-node")], source: "md-docs/recipes/render-from-rust.md", how: true, hasVariations: false) {
        code {
            CodeBlock(#"page Invoice(path: "/", title: "Invoice {number}", description: "An invoice.") {
    Heading("Invoice #{number}").h1
    Text("Bill to: {customer.name}")
    Table {
        Table.Head { Table.Row { Table.Cell("Item")  Table.Cell("Qty")  Table.Cell("Amount") } }
        Table.Body {
            for item in items {
                Table.Row {
                    Table.Cell(item.name)
                    Table.Cell("{item.qty}")
                    Table.Cell(format(item.price * item.qty, .currency))
                }
            }
        }
    }
    if paid { Badge("Paid").success } else { Badge("Due").warning }
    Text("Total: {format(total, .currency)}").bold.lg
}"#, title: "wf")
            Markdown("To use the engine without the `wf` command's own dependencies (its argument parser and dev server), turn off the default features in `Cargo.toml`:")
            CodeBlock(#"[dependencies]
webfluent = { version = "6", default-features = false }
serde = { version = "1", features = ["derive"] }"#, title: "toml")
            Markdown("This program, `src/main.rs`, renders the `Invoice` page three ways and writes the results beside the project:")
            CodeBlock(#"use serde::Serialize;
use webfluent::{PdfConfig, Template};

#[derive(Serialize)]
struct Customer { name: String }

#[derive(Serialize)]
struct Item { name: String, qty: u32, price: f64 }

#[derive(Serialize)]
struct Invoice { number: String, customer: Customer, items: Vec<Item>, total: f64, paid: bool }

fn main() -> webfluent::Result<()> {
    // Every .wf and .wfx under the directory, as one template: components,
    // themes, types and constants shared; each `page` a document.
    let templates = Template::from_dir("templates")?;
    let page = templates.page("Invoice")?;

    let invoice = Invoice {
        number: "INV-001".into(),
        customer: Customer { name: "Acme Corp".into() },
        items: vec![Item { name: "Widget".into(), qty: 5, price: 9.99 }],
        total: 49.95,
        paid: false,
    };

    let html = page.render_html(&invoice)?;          // a whole document
    let body = page.render_html_fragment(&invoice)?; // the markup alone
    let pdf: Vec<u8> = page
        .clone()
        .with_pdf(PdfConfig { page_size: "Letter".into(), ..PdfConfig::default() })
        .render_pdf(&invoice)?;

    std::fs::write("invoice.html", html)?;
    std::fs::write("invoice.pdf", pdf)?;
    println!("{body}");
    Ok(())
}"#, title: "rust")
        }
        Markdown("`cargo run` prints the fragment and writes `invoice.html` and `invoice.pdf`. To try a fuller example, run `cargo run --example invoice` in the WebFluent repository: it renders a directory of templates to HTML, a fragment and a PDF.")

        Heading("Load templates", id: "load-templates").h3

        Markdown("Each loader parses and checks the template once. An error names the file and the line.")

        Table(caption: "Load templates") {
            Table.Head {
                Table.Row {
                    Table.Cell("Loader").header
                    Table.Cell("Reads").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`Template::from_str(source)`") }
                    Table.Cell("One template from a string")
                }
                Table.Row {
                    Table.Cell { Markdown("`Template::from_file(path)`") }
                    Table.Cell { Markdown("One file; a `.wfx` file is read in its indented layout") }
                }
                Table.Row {
                    Table.Cell { Markdown("`Template::from_files(&[..])`") }
                    Table.Cell("Several files, as one template")
                }
                Table.Row {
                    Table.Cell { Markdown("`Template::from_dir(dir)`") }
                    Table.Cell { Markdown("Every `.wf` and `.wfx` under a directory, as one template") }
                }
                Table.Row {
                    Table.Cell { Markdown("`Template::from_sources(&[(name, source), ..])`") }
                    Table.Cell { Markdown("Templates embedded in the binary with `include_str!`") }
                }
            }
        }

        Markdown("`pages()` lists the template's pages, and `page(name)` picks one. Without `page(name)`, every page of the template renders. A name the template does not have is an error that lists the pages it does have:")

        CodeBlock(#"no page called `Receipt`; the template has `Invoice`"#, title: "text")

        Heading("Pass data", id: "pass-data").h3

        Markdown("The data is anything `serde` serializes: your own `#[derive(Serialize)]` structs, or a `serde_json::Value`. Its top-level fields are the names the template reads, so `Invoice`'s `number`, `customer` and `items` are what the template splices. A `const` and a `data` file are in scope too.")

        Heading("Choose the output", id: "choose-the-output").h3

        Table(caption: "Choose the output") {
            Table.Head {
                Table.Row {
                    Table.Cell("Method").header
                    Table.Cell("Returns").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`render_html`") }
                    Table.Cell { Markdown("A whole document: `<html lang>`, a `<title>` from the page's (its `\{…\}` filled from the data), and the CSS in a `<style>` block") }
                }
                Table.Row {
                    Table.Cell { Markdown("`render_html_parts`") }
                    Table.Cell("The CSS and the markup separately, for a server that links its stylesheet and keeps a strict Content-Security-Policy")
                }
                Table.Row {
                    Table.Cell { Markdown("`render_html_fragment`") }
                    Table.Cell("The markup alone")
                }
                Table.Row {
                    Table.Cell { Markdown("`render_pdf`, `render_slides`") }
                    Table.Cell { Markdown("PDF bytes, laid out by the paged engine of [PDF and slides](/learn/17-pdf-and-slides)") }
                }
                Table.Row {
                    Table.Cell { Markdown("`render_pdf_report`, `render_slides_report`") }
                    Table.Cell { Markdown("A `PdfReport`: the bytes, the page count, each page's text in reading order, and the notes (a font taken from the machine, a character no font had)") }
                }
            }
        }

        Markdown("A `PdfReport`'s page text lets a test hold a document to what it says. A template loaded from files reads its fonts from `fonts/` beside it, and its pictures from there too.")

        Heading("Configure a render", id: "configure-a-render").h3

        Markdown("Each setting returns the `Template`, so you can chain them before a render, as the program does with `with_pdf`:\n\n- `with_theme(name)` picks a theme;\n- `with_tokens(&[(name, value)])` sets design tokens over the theme's;\n- `with_lang(\"ar\")` sets the language (a right-to-left language also sets `dir=\"rtl\"`); without it, the page's own `lang:` is used, else `en`;\n- `with_pdf(PdfConfig \{ .. \})` sets page size, margins and fonts;\n- `with_slides(SlidesConfig \{ .. \})` sets a deck's options.\n\nA setting takes the `Template` by value, so the program clones `page` before it sets the paper size, and keeps `page` for other renders.")

        Heading("Use it in a server", id: "use-it-in-a-server").h2

        Markdown("A `Template` is `Send + Sync` and cheap to clone, because the parsed program is shared. Keep it in your framework's state — an `Arc`, or a clone per handler — and render from any thread. A render takes tens of microseconds.")

        Callout("Every value the data supplies is escaped as text. A URL from the data that a browser would run — `javascript:`, `data:` — is dropped from `href` and `src`, as the browser build drops it. An `Image`'s `src` keeps a picture carried in its address (`data:image/png;base64,…`), as the browser build keeps it.\n\nA value the data puts in a `style \{ \}` block is one value, as the live page sets one property at a time: a piece with a `;`, a brace or a backslash, or one that fetches something (`url(…)`, `image-set(…)`), leaves its declaration out. What the template writes around a splice — `background: url(\{img\})` — is the template's own. A `class:` from the data is escaped inside its attribute.", kind: .note)

        Heading("Limits of one render", id: "limits-of-one-render").h2

        Markdown("A render is bounded, so one request cannot take a server with it:")

        Table(caption: "Limits of one render") {
            Table.Head {
                Table.Row {
                    Table.Cell("Limit").header
                    Table.Cell("What is past it").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell("100 levels of nesting — elements, and the components they place, counted together")
                    Table.Cell { Markdown("`E120`") }
                }
                Table.Row {
                    Table.Cell("10,000,000 steps — elements drawn, loop items, units of working a value out")
                    Table.Cell { Markdown("`E121`") }
                }
                Table.Row {
                    Table.Cell("256 MB of markup")
                    Table.Cell { Markdown("`E121`") }
                }
                Table.Row {
                    Table.Cell("About 500,000 list items or 32 MB of text made by one expression")
                    Table.Cell { Markdown("`E121`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`>` quotes in `Markdown` nested 32 deep") }
                    Table.Cell { Markdown("The deeper `>` is shown as text") }
                }
                Table.Row {
                    Table.Cell { Markdown("A precision past 100 digits (`toFixed`, `format(…, .decimal, n)`)") }
                    Table.Cell { Markdown("`toFixed` shows nothing, as the browser throws; `format` writes 100") }
                }
            }
        }

        Markdown("Each error is a `WebFluentError::Diagnostics` naming the code and the element where the render stopped.")

        Heading("Troubleshooting", id: "troubleshooting").h2

        Table(caption: "Troubleshooting") {
            Table.Head {
                Table.Row {
                    Table.Cell("What you see").header
                    Table.Cell("What to do").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`no page called …`") }
                    Table.Cell { Markdown("Pass `page(name)` one of the names the message lists") }
                }
                Table.Row {
                    Table.Cell { Markdown("`WebFluentError::Diagnostics` when the template loads") }
                    Table.Cell { Markdown("The template does not check: the error names the file, the line and the code, as `wf check` would") }
                }
                Table.Row {
                    Table.Cell { Markdown("A `\{name\}` renders empty") }
                    Table.Cell { Markdown("The data has no top-level field `name`; check the struct's field names, or `#[serde(rename)]`") }
                }
            }
        }

    }
}
