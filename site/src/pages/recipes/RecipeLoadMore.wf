page RecipeLoadMore(path: "/recipes/load-more", title: "Load more as the reader asks — Recipes", description: "Add the next page of results below the ones shown when the reader asks: an api endpoint that says how it pages, and a Load more button.") {
    RecipeShell("Load more as the reader asks", summary: "A **Load more** button keeps what the reader has already seen and adds the next page below it. To build one, say on the endpoint how it pages:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Update at once, and roll back on failure", to: "/recipes/optimistic-updates"), RelatedLink(kind: "Recipe", title: "Show the server's field errors on a form", to: "/recipes/form-with-server-errors"), RelatedLink(kind: "Recipe", title: "Refresh a list after a write", to: "/recipes/refresh-after-a-write")], source: "md-docs/recipes/load-more.md", how: true, hasVariations: false, project: { "src/pages/LoadMore.wf": #"type Item { id: String, name: String }

api Catalog(base: "/api") {
    get items(page: Number = 1) at "items" -> [Item]!
        pages .number(param: page)
}

page Items(path: "/items", title: "Items", description: "Everything, a page at a time.") {
    resource list = Catalog.items()
    Heading("Items").h1
    for item in list.items by item.id { Text(item.name) }
    if list.hasMore {
        Button("Load more", loading: list.pending) { on click { list.loadMore() } }
    }
}
"#, "webfluent.app.json": #"{
  "name": "load-more"
}
"# }) {
        code {
            Markdown("**Needs:** a server that answers `/api/items?page=…` with a list of items.")
            CodeBlock(#"type Item { id: String, name: String }

api Catalog(base: "/api") {
    get items(page: Number = 1) at "items" -> [Item]!
        pages .number(param: page)
}

page Items(path: "/items", title: "Items", description: "Everything, a page at a time.") {
    resource list = Catalog.items()
    Heading("Items").h1
    for item in list.items by item.id { Text(item.name) }
    if list.hasMore {
        Button("Load more", loading: list.pending) { on click { list.loadMore() } }
    }
}"#, title: "wf")
        }
        Markdown("The page shows the first page of items and a **Load more** button. Each press adds the next page beneath what is there, without losing the reader's place, and the button goes away once there is nothing more.\n\n- `Catalog` [describes the service](/learn/15-data#describe-a-service-with-api): its `items` endpoint takes a `page` and returns a list of `Item`, and `pages .number(param: page)` says it pages by that number ([Load results a page at a time](/learn/15-data#load-results-a-page-at-a-time)).\n- `list.items` is every item loaded so far, so the `for` lists them all and `item.name` is checked against `Item`.\n- `list.loadMore()` asks for the next page, as a refresh: the items already shown stay while it runs. The read keeps the page number; nothing on the page holds it.\n- `list.pending` is true while a request runs, so the button shows it is busy and cannot ask twice. `list.hasMore` turns false when a page comes back empty, and the button goes.\n- A server that pages by cursor, or by a `Link` header, says so instead: `pages .cursor(param: after, next: p => p.nextCursor)`, `pages .link`.")

    }
}
