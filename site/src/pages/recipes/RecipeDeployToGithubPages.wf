// A recipe, written from md-docs/recipes/deploy-to-github-pages.md by scripts/docsite/recipes.py;
// edit the recipe, not this file.
page RecipeDeployToGithubPages(path: "/recipes/deploy-to-github-pages", title: "Deploy to GitHub Pages — Recipes", description: "Deploy a WebFluent site to GitHub Pages with a GitHub Actions workflow, under the repository's sub-path and with no trailing-slash redirects.") {
    RecipeShell("Deploy to GitHub Pages", summary: "This recipe publishes a WebFluent site to GitHub Pages from a GitHub Actions workflow, which builds the site on every push to `main`. GitHub serves a project site under `https://<you>.github.io/<repo>/`, so the build must know that sub-path.  You need the project in a GitHub repository; the workflow installs `wf` as [Install wf on a build machine](/recipes/install-wf-in-ci) shows.  Set the sub-path, the site's address and `clean_urls` in `webfluent.app.json`:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works"), Anchor(id: "check-it", label: "Check it")], related: [RelatedLink(kind: "Recipe", title: "Build a Docker image", to: "/recipes/docker-image"), RelatedLink(kind: "Recipe", title: "Check a deploy", to: "/recipes/check-a-deploy"), RelatedLink(kind: "Recipe", title: "Deploy to Cloudflare Pages", to: "/recipes/deploy-to-cloudflare-pages")], source: "md-docs/recipes/deploy-to-github-pages.md", how: true, hasVariations: false) {
        code {
            CodeBlock(#"{
    "build": { "base_path": "/<repo>", "clean_urls": "file" },
    "meta": { "site_url": "https://<you>.github.io/<repo>" }
}"#, title: "json")
            Markdown("Then add `.github/workflows/pages.yml`:")
            CodeBlock(#"name: Deploy
on:
  push:
    branches: [main]
permissions:
  contents: read
  pages: write
  id-token: write
jobs:
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/checkout@v4
      - run: curl -sSL https://raw.githubusercontent.com/monzeromer-lab/WebFluent/master/install.sh | WF_VERSION=v6.0.0 bash
      - run: ~/.webfluent/bin/wf build
      - uses: actions/upload-pages-artifact@v3
        with:
          path: build
      - id: deployment
        uses: actions/deploy-pages@v4"#, title: "yaml")
        }
        Markdown("Finally, in the repository's **Settings → Pages**, set the source to **GitHub Actions**, and push to `main`.\n\n1. `build.base_path` prefixes every link, every asset and the router's paths with `/<repo>`, and `meta.site_url` is the address the canonical links and the sitemap name.\n2. GitHub Pages answers `/contact` with a `301` redirect to `/contact/`. `\"clean_urls\": \"file\"` (or `\"directory\"`) makes the canonical address of every page one it serves without a redirect ([Keep addresses from redirecting](/recipes/search-and-link-previews#keep-addresses-from-redirecting)).\n3. The workflow checks out the repository, installs a pinned `wf`, builds the site, uploads `build/` as the Pages artifact and deploys it. The `pages: write` and `id-token: write` permissions are what `actions/deploy-pages` needs.\n\nGitHub Pages serves `404.html` for a path it has no file for. It ignores `_headers`, but the Content-Security-Policy still ships as a `<meta>` tag in every page.")

        Heading("Check it", id: "check-it").h2

        Markdown("Open the URL the workflow's deploy step prints, then open a page other than the home page directly and reload it. With `clean_urls` set, the address stays as you typed it, with no redirect. Then go through [Check a deploy](/recipes/check-a-deploy).")

    }
}
