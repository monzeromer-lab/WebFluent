page RecipeListenForWfRender(path: "/recipes/listen-for-wf-render", title: "Run a script after each page draws — Recipes", description: "The page is drawn after your scripts run, drawn again over a pre-rendered page, and drawn anew on every route.") {
    RecipeShell("Run a script after each page draws", summary: "The page is drawn after your scripts run, drawn again over a pre-rendered page, and drawn anew on every route. A script that runs its own `querySelectorAll` therefore listens for the drawing to land, with the `wf:render` event on `document`:  ```js // src/tilt-all.js document.addEventListener(\"wf:render\", (e) => \{ // e.detail.route is the route just drawn, e.detail.params its parameters. for (const el of document.querySelectorAll(\".tilt-me:not([data-tilted])\")) \{ el.dataset.tilted = \"\"; initTilt(el); \} \}); ```  `wf:render` fires once per drawing: the first mount, the takeover of a pre-rendered page, and every route. It does not fire for an `if` branch or a list item that arrives later. Use `mount:` for those.", outputs: [], since: "", recipes: RECIPE_INDEX, sections: [], related: [RelatedLink(kind: "Recipe", title: "Call WF from a script", to: "/recipes/call-wf-from-a-script"), RelatedLink(kind: "Recipe", title: "Call your own JavaScript", to: "/recipes/call-your-own-script"), RelatedLink(kind: "Recipe", title: "Draw a chart from a library", to: "/recipes/chart-from-a-library")], source: "md-docs/recipes/listen-for-wf-render.md", how: false, hasVariations: false) {
    }
}
