// A recipe, written from md-docs/recipes/listen-for-wf-render.md by scripts/docsite/recipes.py;
// edit the recipe, not this file.
page RecipeListenForWfRender(path: "/recipes/listen-for-wf-render", title: "Run a script after each page draws — Recipes", description: "Run a script that finds elements itself after every drawing of the page: the first mount, the takeover of a pre-rendered page, and each route.") {
    RecipeShell("Run a script after each page draws", summary: "A script that finds elements itself, with `querySelectorAll`, has to run after the page is drawn. The page is drawn after your scripts run, drawn again over a pre-rendered page, and drawn anew on every route, so the script listens for the `wf:render` event on `document`. This page shows Markdown with links to other sites, and a script opens each of them in a new tab:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works"), Anchor(id: "variations", label: "Variations")], related: [RelatedLink(kind: "Recipe", title: "Call your own JavaScript", to: "/recipes/call-your-own-script"), RelatedLink(kind: "Recipe", title: "Call WF from a script", to: "/recipes/call-wf-from-a-script"), RelatedLink(kind: "Recipe", title: "Hand an element to a script", to: "/recipes/hand-an-element-to-a-script")], source: "md-docs/recipes/listen-for-wf-render.md", how: true, hasVariations: true) {
        code {
            Markdown("**Needs:** the script `src/new-tab.js`, shown below.")
            CodeBlock(#"const NOTES = """
    Read the [WebFluent guide](https://webfluent.monzeromer.dev/docs), or
    the [MDN page on links](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/a).
    """

page Notes(path: "/notes", title: "Notes", description: "Links in Markdown that open in a new tab.") {
    Heading("Notes").h1
    Markdown(NOTES, class: "notes")
}"#, title: "wf")
            Markdown("The script is a plain file under `src/` ([Call your own JavaScript](/recipes/call-your-own-script)):")
            CodeBlock(#"// src/new-tab.js
document.addEventListener("wf:render", (e) => {
  // e.detail.route is the route that was drawn, e.detail.params its parameters.
  for (const a of document.querySelectorAll(".notes a")) {
    const href = a.getAttribute("href") || "";
    if (a.hasAttribute("target") || !href.startsWith("http")) continue;
    a.setAttribute("target", "_blank");
    a.setAttribute("rel", "noopener noreferrer");
  }
});"#, title: "js")
        }
        variations {
            Markdown("`wf:render` does not fire for an `if` branch or a list item that arrives later. For an element that comes and goes inside a page, hand it to the script with `mount:` instead ([Hand an element to a script](/recipes/hand-an-element-to-a-script)).")

        }
        Markdown("- The build links the script on every page before the compiled code, so the listener is in place before the first drawing.\n- `wf:render` fires on `document` once per drawing: the first mount, the takeover of a pre-rendered page, and every route. `e.detail` carries the `route` that was drawn and its `params`.\n- The script skips a link that already has a `target`, so a second drawing of the same page changes nothing twice.\n- The links come from `Markdown`, which writes them itself, so the page has no element of its own to put a `target` on. The script adds it, with `rel=\"noopener noreferrer\"` beside it so the new tab cannot reach back into this one.")

    }
}
