    IndexEntry(label: "Show what the network is doing", to: "/recipes/show-the-network", group: "Real time"),
    IndexEntry(label: "Talk to the site's other tabs", to: "/recipes/talk-between-tabs", group: "Real time"),
    IndexEntry(label: "Describe pages to search engines and link previews", to: "/recipes/search-and-link-previews", group: "Content"),
    IndexEntry(label: "Render Markdown", to: "/recipes/render-markdown", group: "Content"),
