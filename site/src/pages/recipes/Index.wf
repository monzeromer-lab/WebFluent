    IndexEntry(label: "Render Markdown", to: "/recipes/render-markdown", group: "Content"),
    IndexEntry(label: "Show code on a page", to: "/recipes/show-code", group: "Content"),
    IndexEntry(label: "Describe pages to search engines and link previews", to: "/recipes/search-and-link-previews", group: "Content"),
    IndexEntry(label: "Show your own page for an unknown address", to: "/recipes/not-found-page", group: "Content"),
    IndexEntry(label: "Make a PDF report", to: "/recipes/pdf-report", group: "Content"),
    IndexEntry(label: "Add a picture, sized for every screen", to: "/recipes/add-a-picture", group: "Media and themes"),
    IndexEntry(label: "Add video and audio", to: "/recipes/video-and-audio", group: "Media and themes"),
    IndexEntry(label: "Show an icon", to: "/recipes/show-an-icon", group: "Media and themes"),
    IndexEntry(label: "Show a carousel", to: "/recipes/show-a-carousel", group: "Media and themes"),
    IndexEntry(label: "Show another page in a frame", to: "/recipes/show-a-page-in-a-frame", group: "Media and themes"),
    IndexEntry(label: "Add a dark-mode switch", to: "/recipes/dark-mode-switch", group: "Media and themes"),
    IndexEntry(label: "Animate an element in and out", to: "/recipes/animate-in-and-out", group: "Motion"),
    IndexEntry(label: "Animate a list", to: "/recipes/animate-a-list", group: "Motion"),
    IndexEntry(label: "Run a sequence of animations", to: "/recipes/animation-sequence", group: "Motion"),
    IndexEntry(label: "Animate route changes", to: "/recipes/route-transitions", group: "Motion"),
    IndexEntry(label: "Carry an element across a route change", to: "/recipes/shared-element", group: "Motion"),
    IndexEntry(label: "Open a box to the height of its content", to: "/recipes/expand-to-content", group: "Motion"),
    IndexEntry(label: "Count a number to its new value", to: "/recipes/count-a-number", group: "Motion"),
    IndexEntry(label: "Tween a property when state changes", to: "/recipes/tween-on-change", group: "Motion"),
    IndexEntry(label: "Declare your own keyframes", to: "/recipes/keyframes", group: "Motion"),
    IndexEntry(label: "Drive an animation yourself", to: "/recipes/drive-an-animation", group: "Motion"),
    IndexEntry(label: "Set motion defaults, and respect reduced motion", to: "/recipes/motion-defaults", group: "Motion"),
    IndexEntry(label: "Translate a site", to: "/recipes/translate-a-site", group: "Reach"),
    IndexEntry(label: "Translate by the words as written", to: "/recipes/translate-by-the-words", group: "Reach"),
    IndexEntry(label: "Publish a page in each language", to: "/recipes/site-in-two-languages", group: "Reach"),
    IndexEntry(label: "Make a site work offline", to: "/recipes/work-offline", group: "Reach"),
