    IndexEntry(label: "Animate route changes", to: "/recipes/route-transitions", group: "Look and motion"),
    IndexEntry(label: "Carry an element across a route change", to: "/recipes/shared-element", group: "Look and motion"),
    IndexEntry(label: "Count a number to its new value", to: "/recipes/count-a-number", group: "Look and motion"),
    IndexEntry(label: "Declare your own keyframes", to: "/recipes/keyframes", group: "Look and motion"),
