page Recipes(path: "/recipes", title: "Recipes — WebFluent", description: "Complete, runnable answers to “how do I…”: each recipe is one task, its whole code, and how it works.") {
    state text = ""
    derived shown = RECIPE_INDEX.filter(e => text == "" || e.label.toLowerCase().includes(text.toLowerCase()))
    SiteHeader(section: "/recipes")
    Stack(gap: .lg, role: "main", id: "bp-main", tabindex: "-1", class: "bp-main bp-wrap") {
        style { gap: 28px; padding-top: 40px; padding-bottom: 72px; @md { padding-top: 56px } }
        Stack(gap: .sm) {
            style { gap: 14px; max-width: 760px }
            Row(class: "bp-labels") { KindLabel(.howto) }
            Heading(t("nav.recipes")).h1 { style { margin: 0; font-size: clamp(30px, 5vw, 44px); line-height: 1.08; font-weight: 650; letter-spacing: -0.025em } }
            Markdown("Each recipe is one task: the complete code first, then how it works. Every `wf` example on these pages parses and type-checks in the test suite; a recipe that needs more than its page — a setting in `webfluent.app.json`, a picture, a data file, a script, another recipe — says so in a **Needs:** line above the code. To try one, paste the page into a new file under `src/pages/` of a project. Most claim the address `/` or a name the `wf init` starter already has (`Home`, `Tasks`, `Settings`, `User`), so start a new project for it (`wf init try-it`), or replace the starter's file of that name (`src/pages/Home.wf` for `/`).", class: "bp-lede")
        }
        Input(bind: text, placeholder: t("recipes.filter"), aria-label: t("recipes.filter")).search { style { max-width: 420px } }
        if shown.some(e => e.group == "Interaction") {
            Stack(gap: .md) {
                style { gap: 14px }
                Heading("Interaction", id: "interaction").h2 { style { margin: 0; font-size: 22px; font-weight: 650 } }
                Text("Lists, dialogs, filters, the address bar and the keyboard: what a page does when the reader acts.", class: "bp-small")
                Grid(columns: { base: 1, sm: 2, lg: 3 }, gap: .md) {
                    for e in shown.filter(e => e.group == "Interaction") by e.to {
                        RecipeCard(e.label, to: e.to)
                    }
                }
            }
        }
        if shown.some(e => e.group == "Forms and data") {
            Stack(gap: .md) {
                style { gap: 14px }
                Heading("Forms and data", id: "data").h2 { style { margin: 0; font-size: 22px; font-weight: 650 } }
                Text("Forms, asking a server, showing what it answers, and writing back.", class: "bp-small")
                Grid(columns: { base: 1, sm: 2, lg: 3 }, gap: .md) {
                    for e in shown.filter(e => e.group == "Forms and data") by e.to {
                        RecipeCard(e.label, to: e.to)
                    }
                }
            }
        }
        if shown.some(e => e.group == "Real time") {
            Stack(gap: .md) {
                style { gap: 14px }
                Heading("Real time", id: "realtime").h2 { style { margin: 0; font-size: 22px; font-weight: 650 } }
                Text("Sockets, streams, other tabs, other readers and workers.", class: "bp-small")
                Grid(columns: { base: 1, sm: 2, lg: 3 }, gap: .md) {
                    for e in shown.filter(e => e.group == "Real time") by e.to {
                        RecipeCard(e.label, to: e.to)
                    }
                }
            }
        }
        if shown.some(e => e.group == "Content") {
            Stack(gap: .md) {
                style { gap: 14px }
                Heading("Content", id: "content").h2 { style { margin: 0; font-size: 22px; font-weight: 650 } }
                Text("Markdown, pages written as Markdown, code on the page, a page for unknown addresses, a PDF, and what search engines and link previews read.", class: "bp-small")
                Grid(columns: { base: 1, sm: 2, lg: 3 }, gap: .md) {
                    for e in shown.filter(e => e.group == "Content") by e.to {
                        RecipeCard(e.label, to: e.to)
                    }
                }
            }
        }
        if shown.some(e => e.group == "Media and themes") {
            Stack(gap: .md) {
                style { gap: 14px }
                Heading("Media and themes", id: "media").h2 { style { margin: 0; font-size: 22px; font-weight: 650 } }
                Text("Pictures, video, icons, a carousel, other pages in a frame, and a dark theme.", class: "bp-small")
                Grid(columns: { base: 1, sm: 2, lg: 3 }, gap: .md) {
                    for e in shown.filter(e => e.group == "Media and themes") by e.to {
                        RecipeCard(e.label, to: e.to)
                    }
                }
            }
        }
        if shown.some(e => e.group == "Motion") {
            Stack(gap: .md) {
                style { gap: 14px }
                Heading("Motion", id: "motion").h2 { style { margin: 0; font-size: 22px; font-weight: 650 } }
                Text("Animation, from one element appearing to a page carried into the next. Read them in order: each builds on the one before.", class: "bp-small")
                Grid(columns: { base: 1, sm: 2, lg: 3 }, gap: .md) {
                    for e in shown.filter(e => e.group == "Motion") by e.to {
                        RecipeCard(e.label, to: e.to)
                    }
                }
            }
        }
        if shown.some(e => e.group == "Reach") {
            Stack(gap: .md) {
                style { gap: 14px }
                Heading("Reach", id: "reach").h2 { style { margin: 0; font-size: 22px; font-weight: 650 } }
                Text("More readers: other languages, and no network.", class: "bp-small")
                Grid(columns: { base: 1, sm: 2, lg: 3 }, gap: .md) {
                    for e in shown.filter(e => e.group == "Reach") by e.to {
                        RecipeCard(e.label, to: e.to)
                    }
                }
            }
        }
        if shown.some(e => e.group == "Testing") {
            Stack(gap: .md) {
                style { gap: 14px }
                Heading("Testing", id: "testing").h2 { style { margin: 0; font-size: 22px; font-weight: 650 } }
                Text("Checking that a page does what it should before a reader finds out it does not.", class: "bp-small")
                Grid(columns: { base: 1, sm: 2, lg: 3 }, gap: .md) {
                    for e in shown.filter(e => e.group == "Testing") by e.to {
                        RecipeCard(e.label, to: e.to)
                    }
                }
            }
        }
        if shown.some(e => e.group == "Ship") {
            Stack(gap: .md) {
                style { gap: 14px }
                Heading("Ship", id: "ship").h2 { style { margin: 0; font-size: 22px; font-weight: 650 } }
                Text("Putting a site on a host, in the order you need them: install `wf` where the site is built, set what changes per environment, deploy to a host or serve from your own server, then check the deploy.", class: "bp-small")
                Grid(columns: { base: 1, sm: 2, lg: 3 }, gap: .md) {
                    for e in shown.filter(e => e.group == "Ship") by e.to {
                        RecipeCard(e.label, to: e.to)
                    }
                }
            }
        }
        if shown.some(e => e.group == "Desktop and phone apps") {
            Stack(gap: .md) {
                style { gap: 14px }
                Heading("Desktop and phone apps", id: "desktop").h2 { style { margin: 0; font-size: 22px; font-weight: 650 } }
                Text("The same project in a window of its own, with Tauri or Electron.", class: "bp-small")
                Grid(columns: { base: 1, sm: 2, lg: 3 }, gap: .md) {
                    for e in shown.filter(e => e.group == "Desktop and phone apps") by e.to {
                        RecipeCard(e.label, to: e.to)
                    }
                }
            }
        }
        if shown.some(e => e.group == "Interop") {
            Stack(gap: .md) {
                style { gap: 14px }
                Heading("Interop", id: "interop").h2 { style { margin: 0; font-size: 22px; font-weight: 650 } }
                Text("Your own JavaScript, libraries, and custom elements, both ways.", class: "bp-small")
                Grid(columns: { base: 1, sm: 2, lg: 3 }, gap: .md) {
                    for e in shown.filter(e => e.group == "Interop") by e.to {
                        RecipeCard(e.label, to: e.to)
                    }
                }
            }
        }
        if shown.some(e => e.group == "Server rendering") {
            Stack(gap: .md) {
                style { gap: 14px }
                Heading("Server rendering", id: "server").h2 { style { margin: 0; font-size: 22px; font-weight: 650 } }
                Text("WebFluent as a template engine: HTML and PDF from data, from the command line, Node or Rust.", class: "bp-small")
                Grid(columns: { base: 1, sm: 2, lg: 3 }, gap: .md) {
                    for e in shown.filter(e => e.group == "Server rendering") by e.to {
                        RecipeCard(e.label, to: e.to)
                    }
                }
            }
        }
        if shown.some(e => e.group == "Projects") {
            Stack(gap: .md) {
                style { gap: 14px }
                Heading("Projects", id: "projects").h2 { style { margin: 0; font-size: 22px; font-weight: 650 } }
                Text("Two complete projects, explained step by step. They are read along in the finished code under `examples/tutorials/`, not typed along; each says how to build it yourself if you want to.", class: "bp-small")
                Grid(columns: { base: 1, sm: 2, lg: 3 }, gap: .md) {
                    for e in shown.filter(e => e.group == "Projects") by e.to {
                        RecipeCard(e.label, to: e.to)
                    }
                }
            }
        }
    }
}
