    IndexEntry(label: "Offer a new version", to: "/recipes/offer-a-new-version", group: "Reach"),
    IndexEntry(label: "Test a page", to: "/recipes/test-a-page", group: "Testing"),
    IndexEntry(label: "Install wf on a build machine", to: "/recipes/install-wf-in-ci", group: "Ship"),
    IndexEntry(label: "Use environment values, and keep secrets out", to: "/recipes/environments-and-secrets", group: "Ship"),
