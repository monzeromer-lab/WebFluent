    IndexEntry(label: "Deploy to Vercel", to: "/recipes/deploy-to-vercel", group: "Ship"),
    IndexEntry(label: "Deploy to Cloudflare Pages", to: "/recipes/deploy-to-cloudflare-pages", group: "Ship"),
    IndexEntry(label: "Build a Docker image", to: "/recipes/docker-image", group: "Ship"),
    IndexEntry(label: "Serve a site with nginx", to: "/recipes/serve-with-nginx", group: "Ship"),
    IndexEntry(label: "Serve a site with Apache", to: "/recipes/serve-with-apache", group: "Ship"),
    IndexEntry(label: "Serve a site with Caddy", to: "/recipes/serve-with-caddy", group: "Ship"),
    IndexEntry(label: "Serve an API on the same origin", to: "/recipes/api-on-the-same-origin", group: "Ship"),
    IndexEntry(label: "Set cache and security headers", to: "/recipes/cache-and-security-headers", group: "Ship"),
    IndexEntry(label: "Check a deploy", to: "/recipes/check-a-deploy", group: "Ship"),
    IndexEntry(label: "Make a desktop or phone app with Tauri", to: "/recipes/tauri-app", group: "Desktop and phone apps"),
    IndexEntry(label: "Make a desktop app with Electron", to: "/recipes/electron-app", group: "Desktop and phone apps"),
    IndexEntry(label: "Call your own JavaScript", to: "/recipes/call-your-own-script", group: "Interop"),
    IndexEntry(label: "Call WF from a script", to: "/recipes/call-wf-from-a-script", group: "Interop"),
    IndexEntry(label: "Hand an element to a script", to: "/recipes/hand-an-element-to-a-script", group: "Interop"),
    IndexEntry(label: "Run a script after each page draws", to: "/recipes/listen-for-wf-render", group: "Interop"),
    IndexEntry(label: "Draw into a node a script made", to: "/recipes/portal", group: "Interop"),
    IndexEntry(label: "Load a library from a CDN", to: "/recipes/library-from-a-cdn", group: "Interop"),
    IndexEntry(label: "Draw a chart from a library", to: "/recipes/chart-from-a-library", group: "Interop"),
    IndexEntry(label: "Place a custom element from a library", to: "/recipes/place-a-custom-element", group: "Interop"),
