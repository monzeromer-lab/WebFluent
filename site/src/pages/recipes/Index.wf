    IndexEntry(label: "Show another page in a frame", to: "/recipes/show-a-page-in-a-frame", group: "Look and motion"),
    IndexEntry(label: "Tween a property when state changes", to: "/recipes/tween-on-change", group: "Look and motion"),
    IndexEntry(label: "Keep writes made offline", to: "/recipes/keep-writes-made-offline", group: "Reach"),
    IndexEntry(label: "Make a site work offline", to: "/recipes/work-offline", group: "Reach"),
