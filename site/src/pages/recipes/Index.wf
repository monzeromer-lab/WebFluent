    IndexEntry(label: "Render templates from Node", to: "/recipes/render-from-node", group: "Server rendering"),
    IndexEntry(label: "Render templates from Rust", to: "/recipes/render-from-rust", group: "Server rendering"),
    IndexEntry(label: "Build a statically generated notebook", to: "/recipes/build-a-notebook-site", group: "Projects"),
