page RecipeMarkdownPages(path: "/recipes/markdown-pages", title: "Write a page as a Markdown file — Recipes", description: "Write a page as a Markdown file under `src/`: front matter names its route, title and layout, and the rest is the body, framed by a component.") {
    RecipeShell("Write a page as a Markdown file", summary: "A `.md` file under `src/` is a page: the lines between the two `---` at its top — its *front matter* — name the page's route, title and layout, and the rest is its body. It suits docs, notes and articles, where most of the page is prose. A docs site is a folder of `.md` files, one layout component, and an `app`:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Render Markdown", to: "/recipes/render-markdown"), RelatedLink(kind: "Recipe", title: "Show code on a page", to: "/recipes/show-code"), RelatedLink(kind: "Recipe", title: "Describe pages to search engines and link previews", to: "/recipes/search-and-link-previews")], source: "md-docs/recipes/markdown-pages.md", how: true, hasVariations: false) {
        code {
            Markdown("**Needs:** the two `.md` pages shown under [How it works](#how-it-works), in `src/guide/`.")
            CodeBlock(#"component DocsShell {
    slot
    Row(gap: .lg) {
        Sidebar {
            Sidebar.Item(to: "/guide/install") { Text("Installing") }
            Sidebar.Item(to: "/guide/pages") { Text("Pages") }
        }
        Container { children }
    }
}

app {
    Router
}"#, title: "wf")
        }
        Markdown("Each page of the site is a `.md` file. This one, `src/guide/install.md`, is the docs page at `/guide/install`:")

        CodeBlock(#"---
path: /guide/install
title: Installing
description: Get wf on your machine in a minute.
layout: DocsShell
type: article
image: /install.png
image_alt: A terminal running wf build
---

# Installing

Download a release, or build from source:

```sh
cargo install webfluent
```

Then `wf init my-site`."#, title: "markdown")

        Markdown("The sidebar's second link is `src/guide/pages.md`, the page at `/guide/pages`:")

        CodeBlock(#"---
path: /guide/pages
title: Pages
description: One file per page, and the route it answers.
layout: DocsShell
---

# Pages

Each `.md` file under `src/` is a page. Its front matter names the route."#, title: "markdown")

        Markdown("With the two files and `DocsShell` in place, `wf serve` shows both pages, each framed by the sidebar.\n\nThe front matter keys are the page's attributes:")

        Table(caption: "Write a page as a Markdown file") {
            Table.Head {
                Table.Row {
                    Table.Cell("Key").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`path`") }
                    Table.Cell { Markdown("The route. Default: `/` for `index.md`, otherwise `/<file-name>`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`title`") }
                    Table.Cell("The page's title")
                }
                Table.Row {
                    Table.Cell { Markdown("`description`") }
                    Table.Cell("The snippet a search result shows")
                }
                Table.Row {
                    Table.Cell { Markdown("`layout`") }
                    Table.Cell("The component that frames the body")
                }
                Table.Row {
                    Table.Cell { Markdown("`image` · `image_alt`") }
                    Table.Cell("The link-preview image, and what it shows")
                }
                Table.Row {
                    Table.Cell { Markdown("`type`") }
                    Table.Cell { Markdown("`website` (the default) or `article`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`noindex`") }
                    Table.Cell { Markdown("`true` keeps the page out of search results and the sitemap") }
                }
                Table.Row {
                    Table.Cell { Markdown("`lang`") }
                    Table.Cell { Markdown("The language the page is written in, when it is not the site's: `en`, `ar`, `pt-BR`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`translates`") }
                    Table.Cell { Markdown("The page this one is a translation of, by name: `About`") }
                }
            }
        }

        Markdown("The page's name is the file's stem, capitalised: `install.md` is the page `Install`. The body is placed as `Markdown(…)` in the page, inside the layout's default slot when the front matter names a layout.")

        Heading("Frame .md pages with a layout", id: "frame-md-pages-with-a-layout").h3

        Markdown("`layout: DocsShell` frames the body in a component with a default slot — the same kind of component a `.wf` page names as its `layout:` ([Pages and routing](/learn/05-pages-and-routing#layouts)). In `DocsShell`, `slot` declares the default slot and `children` is where the page's body lands, beside the sidebar.\n\n(`wf docs` is something else: a gallery of every component the project can use — [CLI](/reference/cli#wf-docs).)")

    }
}
