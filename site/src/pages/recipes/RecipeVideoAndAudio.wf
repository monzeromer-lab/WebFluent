page RecipeVideoAndAudio(path: "/recipes/video-and-audio", title: "Add video and audio — Recipes", description: "To show a video, use `Video(src:)`; to play sound, use `Audio(src:)`.") {
    RecipeShell("Add video and audio", summary: "To show a video, use `Video(src:)`; to play sound, use `Audio(src:)`. Add the `.controls` flag to show the browser's playback controls.  Give every video captions and every recording a transcript:  - `captions:` names a WebVTT file. The build writes it as a `<track>`, so a reader who cannot hear the video can follow it. - `transcript:` names a text file. The build draws it as a link beneath the player.  The first example in this chapter shows both. A `Video` without `captions:`, and an `Audio` without `transcript:`, each draw an `A09` warning.", outputs: [], since: "", recipes: RECIPE_INDEX, sections: [], related: [RelatedLink(kind: "Recipe", title: "Add a dark-mode switch", to: "/recipes/dark-mode-switch"), RelatedLink(kind: "Recipe", title: "Add a picture, sized for every screen", to: "/recipes/add-a-picture"), RelatedLink(kind: "Recipe", title: "Animate a list", to: "/recipes/animate-a-list")], source: "md-docs/recipes/video-and-audio.md", how: false, hasVariations: false) {
    }
}
