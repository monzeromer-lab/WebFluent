// A recipe, written from md-docs/recipes/keyframes.md by scripts/docsite/recipes.py;
// edit the recipe, not this file.
page RecipeKeyframes(path: "/recipes/keyframes", title: "Declare your own keyframes — Recipes", description: "To animate in a way the built-ins do not, declare keyframes with `animation Name \{ \}` and use the name where a built-in animation goes:") {
    RecipeShell("Declare your own keyframes", summary: "To animate in a way the built-ins do not, declare keyframes with `animation Name \{ \}` and use the name where a built-in animation goes:", outputs: [], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Add a dark-mode switch", to: "/recipes/dark-mode-switch"), RelatedLink(kind: "Recipe", title: "Add a picture, sized for every screen", to: "/recipes/add-a-picture"), RelatedLink(kind: "Recipe", title: "Add video and audio", to: "/recipes/video-and-audio")], source: "md-docs/recipes/keyframes.md", how: true, hasVariations: false) {
        code {
            CodeBlock(#"animation Pulse {
    from { opacity: 1 }
    50% { opacity: 0.4; transform: scale(0.98) }
    to { opacity: 1 }
}

animation Drop {
    from { transform: translateY(-12px); opacity: 0 }
    to { transform: none; opacity: 1 }
}

page Custom(path: "/", title: "Custom", description: "Keyframes of your own.") {
    state saving = false
    Heading("Custom").h1
    Card(animate: .Drop) {
        Button("Save") { on click { saving = !saving } }
        if saving { Badge("Saving", animate: .Pulse).info }
    }
}"#, title: "wf")
        }
        Markdown("The rules for keyframes:\n\n- A step is `from`, `to` or a percentage, and holds raw CSS.\n- The declaration is written once to the shared stylesheet as `@keyframes Name`.\n- Your own animation is always written `animate: .Name` (or `exit: .Name`). The flags belong to the built-in animations.\n- It plays wherever a built-in one would — on an element that stands still, from the stylesheet, before any script has loaded.\n\nYou can also name your keyframes in a style, as CSS does: `animation: Pulse 1s infinite`.")

    }
}
