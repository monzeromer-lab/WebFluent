page RecipeOfferANewVersion(path: "/recipes/offer-a-new-version", title: "Offer a new version — Recipes", description: "The worker is versioned by a hash of everything the build wrote, so any deploy that changes a byte is a new version.") {
    RecipeShell("Offer a new version", summary: "The worker is versioned by a hash of everything the build wrote, so any deploy that changes a byte is a new version. The new version installs beside the old one and waits. `update.available` turns true when it is ready, and `update.apply()` takes it. This home page offers a reload and shows the queue:", outputs: [], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Keep writes made offline", to: "/recipes/keep-writes-made-offline"), RelatedLink(kind: "Recipe", title: "Make a site work offline", to: "/recipes/work-offline"), RelatedLink(kind: "Recipe", title: "Publish a page in each language", to: "/recipes/site-in-two-languages")], source: "md-docs/recipes/offer-a-new-version.md", how: true, hasVariations: false) {
        code {
            CodeBlock(#"page Home(path: "/", title: "Home", description: "The front page.") {
    if update.available {
        Button("A new version is ready — reload") { on click { update.apply() } }
    }
    if network.queued > 0 {
        Text("{network.queued} change(s) will be sent when you are back online").muted
    }
    Heading("Home").h1
}"#, title: "wf")
        }
        Markdown("`update.apply()` takes the new version and reloads the page once. It never reloads on the first install, which only takes over a page that already works, and never twice for one update. The old version's store is deleted when the new one takes over.")

    }
}
