page RecipeStoreValueAsAProp(path: "/recipes/store-value-as-a-prop", title: "Pass a store's value to a component — Recipes", description: "Pass one value from a store to a component as a prop, so the component stays reusable outside that store.") {
    RecipeShell("Pass a store's value to a component", summary: "A component that needs only one value from a store can take it as a prop instead of using the store. That keeps the component reusable outside that store: a test or another page can hand it any number:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Reorder a list by dragging", to: "/recipes/reorder-by-dragging"), RelatedLink(kind: "Recipe", title: "Add keyboard shortcuts and a command palette", to: "/recipes/keyboard-shortcuts"), RelatedLink(kind: "Recipe", title: "Make a page work with a keyboard and a screen reader", to: "/recipes/keyboard-and-screen-reader")], source: "md-docs/recipes/store-value-as-a-prop.md", how: true, hasVariations: false, project: { "src/pages/StoreValueAsAProp.wf": #"store Cart { state count = 0 }

component CartBadge(count: Number) {
    if count > 0 { Badge("{count}").primary }
}

page Shop(path: "/", title: "Shop", description: "Everything we sell.") {
    use Cart
    Heading("Shop").h1
    Row(gap: .sm, align: .center) {
        Button("Add to cart") { on click { Cart.count = Cart.count + 1 } }
        CartBadge(count: Cart.count)
    }
}
"#, "webfluent.app.json": #"{
