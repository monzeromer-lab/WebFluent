page RecipeStoreValueAsAProp(path: "/recipes/store-value-as-a-prop", title: "Pass a store's value to a component — Recipes", description: "Pass one value from a store to a component as a prop, so the component stays reusable outside that store.") {
    RecipeShell("Pass a store's value to a component", summary: "A component that needs only one value from a store can take it as a prop instead of using the store. That keeps the component reusable outside that store: a test or another page can hand it any number:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Build a confirm dialog", to: "/recipes/confirm-dialog"), RelatedLink(kind: "Recipe", title: "Copy to the clipboard", to: "/recipes/copy-to-the-clipboard"), RelatedLink(kind: "Recipe", title: "Count down", to: "/recipes/count-down")], source: "md-docs/recipes/store-value-as-a-prop.md", how: true, hasVariations: false) {
        code {
            CodeBlock(#"store Cart { state count = 0 }

component CartBadge(count: Number) {
    if count > 0 { Badge("{count}").primary }
}

page Shop(path: "/", title: "Shop", description: "Everything we sell.") {
    use Cart
    Heading("Shop").h1
    CartBadge(count: Cart.count)
}"#, title: "wf")
        }
        Markdown("- `CartBadge` declares a `count` [prop](/docs/guide/components#props) and knows nothing about `Cart`.\n- The page reads the [store](/docs/guide/stores#a-first-store) after `use Cart` and passes `Cart.count` down.\n- A prop that reads state stays live inside the component, so the badge repaints when `Cart.count` changes.")

    }
}
