page RecipeEnvironmentsAndSecrets(path: "/recipes/environments-and-secrets", title: "Use environment values, and keep secrets out — Recipes", description: "Read settings such as an API address with env.NAME, set them per environment, and keep a private value such as an API key out of the bundle.") {
    RecipeShell("Use environment values, and keep secrets out", summary: "Read a setting that changes between environments (an API's address, a feature switch) with `env.NAME`, give it a value per environment, and keep a private value such as an API key out of what readers download.  This page reads the API's address and a feature switch, and falls back to defaults when nothing sets them:", outputs: ["website", "app", "desktop"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works"), Anchor(id: "set-a-value", label: "Set a value"), Anchor(id: "keep-a-private-value-out-of-the-bundle", label: "Keep a private value out of the bundle"), Anchor(id: "name-your-own-values-something-other-than-env", label: "Name your own values something other than env"), Anchor(id: "build-once-per-environment", label: "Build once per environment"), Anchor(id: "change-other-settings-per-deploy", label: "Change other settings per deploy"), Anchor(id: "audit-what-the-project-reads", label: "Audit what the project reads")], related: [RelatedLink(kind: "Recipe", title: "Deploy to GitHub Pages", to: "/recipes/deploy-to-github-pages"), RelatedLink(kind: "Recipe", title: "Render a template with data", to: "/recipes/render-a-template"), RelatedLink(kind: "Recipe", title: "Review a site's security before you deploy", to: "/recipes/review-security")], source: "md-docs/recipes/environments-and-secrets.md", how: true, hasVariations: false, project: { "src/pages/EnvironmentsAndSecrets.wf": #"const API = env.PUBLIC_API ?? "/api"
const FEATURES = { billing: env.PUBLIC_BILLING == "on" }

page Rows(path: "/", title: "Rows", description: "Rows from the API.") {
