// edit the recipe, not this file.
page RecipeCallYourOwnScript(path: "/recipes/call-your-own-script", title: "Call your own JavaScript — Recipes", description: "Call a function of your own JavaScript from a WebFluent page: a plain script under src/, typed with JSDoc, linked on every page, its names in scope.") {
    RecipeShell("Call your own JavaScript", summary: "Some things are easier to write in JavaScript: a pointer effect, a measurement, glue around a library. Put the function in a `.js` file under `src/`, and your pages call it by name. You need a WebFluent project ([Getting started](/learn/01-getting-started)); the script is a plain browser script, with no `import`, no `export` and no build step.", outputs: ["website", "app", "desktop"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works"), Anchor(id: "type-a-script-with-jsdoc", label: "Type a script with JSDoc"), Anchor(id: "let-a-script-report-and-keep-the-class-in-webfluent", label: "Let a script report, and keep the class in WebFluent"), Anchor(id: "troubleshooting", label: "Troubleshooting")], related: [RelatedLink(kind: "Recipe", title: "Call WF from a script", to: "/recipes/call-wf-from-a-script"), RelatedLink(kind: "Recipe", title: "Hand an element to a script", to: "/recipes/hand-an-element-to-a-script"), RelatedLink(kind: "Recipe", title: "Load a library from a CDN", to: "/recipes/library-from-a-cdn")], source: "md-docs/recipes/call-your-own-script.md", how: true, hasVariations: false, project: { "src/tilt.js": #"// src/tilt.js
/**
 * Tilt an element toward the pointer.
 * @param {HTMLElement} node
 * @param {number} [max] how far, in degrees
 */
function initTilt(node, max = 15) {
  const move = (e) => {
    const r = node.getBoundingClientRect();
    const x = (e.clientX - r.left) / r.width - 0.5;
    node.style.transform = `rotateY(${x * max}deg)`;
  };
  node.addEventListener("pointermove", move);
  return {
    setMax(m) { max = m; },
    destroy() { node.removeEventListener("pointermove", move); },
  };
}
"#, "src/pages/CallYourOwnScript.wf": #"page Gallery(path: "/gallery", title: "Gallery", description: "Cards that lean.") {
    state max = 15

    Heading("Gallery").h1
    Card(class: "tilt",
         mount: (n) => initTilt(n, max),
         update: (tilt) => tilt.setMax(max),
         cleanup: (tilt) => tilt.destroy()) {
        Text("Move the pointer over me.")
    }
    Slider(bind: max, min: 0, max: 45, label: "How far")
}
"#, "webfluent.app.json": #"{
  "name": "call-your-own-script"
}
"# }) {
        code {
            Markdown("**Needs:** the script `src/tilt.js`, shown below.")
            CodeBlock(#"page Gallery(path: "/gallery", title: "Gallery", description: "Cards that lean.") {
    state max = 15

    Heading("Gallery").h1
    Card(class: "tilt",
         mount: (n) => initTilt(n, max),
         update: (tilt) => tilt.setMax(max),
         cleanup: (tilt) => tilt.destroy()) {
        Text("Move the pointer over me.")
    }
    Slider(bind: max, min: 0, max: 45, label: "How far")
}"#, title: "wf")
            Markdown("This script tilts an element toward the pointer, and returns a handle the page can update and destroy. Write it the way you would write any file a `<script src>` loads:")
            CodeBlock(#"// src/tilt.js
/**
 * Tilt an element toward the pointer.
 * @param {HTMLElement} node
 * @param {number} [max] how far, in degrees
 */
function initTilt(node, max = 15) {
  const move = (e) => {
    const r = node.getBoundingClientRect();
    const x = (e.clientX - r.left) / r.width - 0.5;
    node.style.transform = `rotateY(${x * max}deg)`;
  };
  node.addEventListener("pointermove", move);
  return {
    setMax(m) { max = m; },
    destroy() { node.removeEventListener("pointermove", move); },
  };
}"#, title: "js")
        }
        Markdown("The page hands the card to `initTilt` with `mount:`, changes how far it tilts with `update:` as the reader moves the slider, and removes the listener with `cleanup:` when the page leaves ([Hand an element to a script](/recipes/hand-an-element-to-a-script)). The build treats the script this way:\n\n- **The file runs as written.** The build copies it to `build/js/tilt.js` byte for byte and links it with `<script defer>` on every page, before the compiled code. A stack trace points at your own line.\n- **Its names are in scope.** Every top-level `function`, `class`, `const`, `let` and `var`, and anything assigned to `window.x`, is a name your `.wf` code can call directly. What a function or an IIFE keeps inside stays private, as it does in the browser.\n- **A call is checked.** `initTilt(n, 1, 2)` is a `T10` error where it is written, because the function takes one or two arguments. Its JSDoc types the arguments ([Type a script with JSDoc](#type-a-script-with-jsdoc)). A name the file does not declare is still a `T13`.\n- **A class is constructed.** WebFluent has no `new`. A call to a class a script declares compiles to `new`.\n- **One name has one meaning.** Two scripts that declare the same name, or a script name that is also a component, a store, a `const`, or a name the language or the browser owns (`format`, `log`, `fetch`), is an error that names both.\n- **An ES module is refused.** A file with a top-level `import` or `export` cannot run from a `<script src>`, so the build stops and says so. Load a published module from the config instead ([Load a library from a CDN](/recipes/library-from-a-cdn)).\n\nThe tools know your scripts too: `wf serve` rebuilds when a script changes, `wf audit` lists what each one declares, `wf types` prints each function's signature, and the editor completes, documents and jumps to them.")

        Heading("Type a script with JSDoc", id: "type-a-script-with-jsdoc").h2

        Markdown("To have calls checked against a function's types, describe the function in a JSDoc comment. JSDoc is a comment, so the file stays exactly what the browser runs. The checker reads it this way:")

        Table(caption: "Type a script with JSDoc") {
            Table.Head {
                Table.Row {
                    Table.Cell("JSDoc").header
                    Table.Cell("WebFluent").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`string` · `number` · `boolean`") }
                    Table.Cell { Markdown("`String` · `Number` · `Bool`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`object` · `\{ a: T \}`") }
                    Table.Cell { Markdown("`Map`, or a shape of the fields written") }
                }
                Table.Row {
                    Table.Cell { Markdown("`T[]` · `Array<T>`") }
                    Table.Cell { Markdown("`[T]`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`?T` · `T | null` · `[name]`") }
                    Table.Cell { Markdown("`T?`, or a parameter a call may leave out") }
                }
                Table.Row {
                    Table.Cell { Markdown("`Promise<T>`") }
                    Table.Cell { Markdown("`T`, as an action that awaits it reads it") }
                }
                Table.Row {
                    Table.Cell { Markdown("`(v: T) => R`") }
                    Table.Cell("a function: you may pass an action or a lambda")
                }
                Table.Row {
                    Table.Cell { Markdown("`HTMLElement`, anything else") }
                    Table.Cell { Markdown("`Any`") }
                }
            }
        }

        Markdown("With no comment at all, every parameter is `Any`, so adding a script never breaks a build. Each tag only narrows what a call may pass. `@returns` types the result.")

        Heading("Let a script report, and keep the class in WebFluent", id: "let-a-script-report-and-keep-the-class-in-webfluent").h2

        Markdown("When the way an element looks depends on something only a script can see (an intersection, a scroll position, a library's event), hand the script an action. An action is a plain function at run time. The script calls it, and the class stays in a `class:` the compiler can read.\n\nThis page sets `is-visible` on the card while it is on screen:")

        CodeBlock(#"page Story(path: "/story", title: "Story", description: "It fades in.") {
    state visible = false
    action setVisible(v: Bool) { visible = v }

    Heading("Story").h1
    Card(class: { "is-visible": visible },
         mount: (n) => watchVisible(n, setVisible),
         cleanup: (w) => w.destroy()) {
        Text("Here I am.")
    }
}"#, title: "wf")

        Markdown("This script reports whether an element is on screen:")

        CodeBlock(#"// src/visible.js
/**
 * Say whether `node` is on screen, each time that changes.
 * @param {HTMLElement} node
 * @param {(v: boolean) => void} onChange
 */
function watchVisible(node, onChange) {
  const io = new IntersectionObserver(([e]) => onChange(e.isIntersecting));
  io.observe(node);
  return { destroy: () => io.disconnect() };
}"#, title: "js")

        Markdown("Each class has one owner. A class that `class:` names belongs to WebFluent, and a class a script adds with `classList.add` belongs to the script: `class:` only ever takes off what it put on.")

        Heading("Troubleshooting", id: "troubleshooting").h2

        Table(caption: "Troubleshooting") {
            Table.Head {
                Table.Row {
                    Table.Cell("What you see").header
                    Table.Cell("What to do").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`T13`: nothing declares the function") }
                    Table.Cell { Markdown("Check that the file is under `src/` and declares the name at its top level, not inside another function") }
                }
                Table.Row {
                    Table.Cell { Markdown("`T10` on a call that looks right") }
                    Table.Cell { Markdown("Count the parameters the function declares; a JSDoc `[name]` or a default value lets a call leave one out") }
                }
                Table.Row {
                    Table.Cell { Markdown("The build stops on a top-level `import` or `export`") }
                    Table.Cell { Markdown("Remove them and declare the names at the top level; a published module loads from `meta.scripts` instead ([Load a library from a CDN](/recipes/library-from-a-cdn))") }
                }
                Table.Row {
                    Table.Cell { Markdown("An error that names your script and a component, store or `const`") }
                    Table.Cell("Rename one of the two: a name has one meaning in a project")
                }
            }
        }

    }
}
