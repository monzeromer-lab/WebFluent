page RecipeDeployToCloudflarePages(path: "/recipes/deploy-to-cloudflare-pages", title: "Deploy to Cloudflare Pages — Recipes", description: "1.") {
    RecipeShell("Deploy to Cloudflare Pages", summary: "1. In the Cloudflare Pages project, set the build command to the one in the Netlify recipe above: `curl -sSL https://raw.githubusercontent.com/monzeromer-lab/WebFluent/master/install.sh | bash && ~/.webfluent/bin/wf build`. 2. Set the build output directory to `build`. 3. For a single-page build, add `public/_redirects` as for Netlify.  Cloudflare Pages reads `_headers` and `_redirects` the same way Netlify does.  **Verify it:** check the response headers in the network panel, as for Netlify, and open a deep link directly.", outputs: [], since: "", recipes: RECIPE_INDEX, sections: [], related: [RelatedLink(kind: "Recipe", title: "Build a Docker image", to: "/recipes/docker-image"), RelatedLink(kind: "Recipe", title: "Check a deploy", to: "/recipes/check-a-deploy"), RelatedLink(kind: "Recipe", title: "Deploy to GitHub Pages", to: "/recipes/deploy-to-github-pages")], source: "md-docs/recipes/deploy-to-cloudflare-pages.md", how: false, hasVariations: false) {
