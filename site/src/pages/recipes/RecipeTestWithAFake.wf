}

fake TwoPeople for Backend.people {
    list() { .ok([Person(id: "1", name: "Ada"), Person(id: "2", name: "Grace")]) }
    remove(id) { .err(.status(500, null)) }
}

test "lists the team"(fakes: [TwoPeople]) {
    People
    expect "Remove Ada"
    expect "Remove Grace"
}

test "says when removing fails"(fakes: [TwoPeople]) {
    People
    click "Remove Ada"
