// A recipe, written from md-docs/recipes/test-with-a-fake.md by scripts/docsite/recipes.py;
// edit the recipe, not this file.
page RecipeTestWithAFake(path: "/recipes/test-with-a-fake", title: "Test a page with a fake service — Recipes", description: "Test a page that reads a service without the service: a fake answers its endpoints, held to the contract, and nothing reaches the network.") {
    RecipeShell("Test a page with a fake service", summary: "A page that reads a service has nothing to show in a test until something answers. A `fake` answers a group's endpoints in place of the network, and the compiler holds it to the contract: every endpoint it answers, every parameter it reads, every answer's type.", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Test a page", to: "/recipes/test-a-page")], source: "md-docs/recipes/test-with-a-fake.md", how: true, hasVariations: false, project: { "src/pages/TestWithAFake.wf": #"type Person { id: String, name: String }

api Backend(base: "/api") { }

api Backend.people {
    get list() at "people" -> [Person]!
    delete remove(id: String) at "people/{id}" -> !
        invalidates [list]
}

page People(path: "/", title: "People", description: "The team.") {
    state said = ""
    resource people = Backend.people.list()
    Heading("People").h1
    match people {
        .loading { Spinner }
        .failed(e) { Alert(e.message).danger }
        .loaded(list) {
            for p in list by p.id {
                Button("Remove {p.name}") {
                    on click {
                        match await Backend.people.remove(id: p.id) {
                            .ok { said = "{p.name} removed" }
                            .err(_) { said = "{p.name} is still here" }
                        }
                    }
                }
            }
        }
    }
    Text(said)
}

fake TwoPeople for Backend.people {
    list() { .ok([Person(id: "1", name: "Ada"), Person(id: "2", name: "Grace")]) }
    remove(id) { .err(.status(500, null)) }
}

test "lists the team"(fakes: [TwoPeople]) {
    People
    expect "Remove Ada"
    expect "Remove Grace"
}

test "says when removing fails"(fakes: [TwoPeople]) {
    People
    click "Remove Ada"
    expect "Ada is still here"
    expect called Backend.people.remove
}
"#, "webfluent.app.json": #"{
  "name": "test-with-a-fake"
}
"# }) {
        code {
            Markdown("**Needs:** the page in `src/`, the fake and the tests under `tests/`; run them with `wf test`. Here they are one file, for the sake of the example.")
            CodeBlock(#"type Person { id: String, name: String }

api Backend(base: "/api") { }

api Backend.people {
    get list() at "people" -> [Person]!
    delete remove(id: String) at "people/{id}" -> !
        invalidates [list]
}

page People(path: "/", title: "People", description: "The team.") {
    state said = ""
    resource people = Backend.people.list()
    Heading("People").h1
    match people {
        .loading { Spinner }
        .failed(e) { Alert(e.message).danger }
        .loaded(list) {
            for p in list by p.id {
                Button("Remove {p.name}") {
                    on click {
                        match await Backend.people.remove(id: p.id) {
                            .ok { said = "{p.name} removed" }
                            .err(_) { said = "{p.name} is still here" }
