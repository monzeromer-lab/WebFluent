page RecipeShowACarousel(path: "/recipes/show-a-carousel", title: "Show a carousel — Recipes", description: "To show slides one at a time, wrap each in a `Carousel.Slide` inside a `Carousel`.") {
    RecipeShell("Show a carousel", summary: "To show slides one at a time, wrap each in a `Carousel.Slide` inside a `Carousel`. This page shows three photographs that advance every five seconds:", outputs: [], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Add a dark-mode switch", to: "/recipes/dark-mode-switch"), RelatedLink(kind: "Recipe", title: "Add a picture, sized for every screen", to: "/recipes/add-a-picture"), RelatedLink(kind: "Recipe", title: "Add video and audio", to: "/recipes/video-and-audio")], source: "md-docs/recipes/show-a-carousel.md", how: true, hasVariations: false) {
        code {
            CodeBlock(#"page Gallery(path: "/", title: "Gallery", description: "Three pictures.") {
    Heading("Gallery").h1
    Carousel(label: "Recent work", autoplay: true, interval: 5000) {
        Carousel.Slide { Image(src: "/one.jpg", alt: "A bridge at dusk") }
        Carousel.Slide { Image(src: "/two.jpg", alt: "The harbour from above") }
        Carousel.Slide { Image(src: "/three.jpg", alt: "Rain on the market") }
    }
}"#, title: "wf")
        }
        Markdown("A carousel has a named previous button, a named next button, and a dot per slide. Its `label:` names the region for screen readers. It is a `region` described as a carousel, unless you set its `role:` or `aria-roledescription:` yourself.\n\nWith `autoplay`, the carousel also has a button that stops it. It pauses while the pointer or the keyboard focus is on it, and it does not advance at all for a reader who asked for reduced motion.")

    }
}
