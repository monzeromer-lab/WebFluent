page RecipeFiltersInTheAddress(path: "/recipes/filters-in-the-address", title: "Keep filters in the address — Recipes", description: "Keep a list's filter or sort in the query string, so it survives a reload, a shared link and the back button.") {
    RecipeShell("Keep filters in the address", summary: "A filter held in a `state` is lost on reload and missing from a link the reader shares. To make it survive a reload, a shared link and the back button, read it from `query` instead:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Build a confirm dialog", to: "/recipes/confirm-dialog"), RelatedLink(kind: "Recipe", title: "Copy to the clipboard", to: "/recipes/copy-to-the-clipboard"), RelatedLink(kind: "Recipe", title: "Debounce a search", to: "/recipes/debounce-a-search")], source: "md-docs/recipes/filters-in-the-address.md", how: true, hasVariations: false, project: { "src/pages/FiltersInTheAddress.wf": #"const PRODUCTS = [
    { name: "Kettle", price: 39 },
    { name: "Apron", price: 18 },
    { name: "Mug", price: 9 },
]

page Products(path: "/products", title: "Products", description: "Everything we sell.") {
    derived sort = query.sort ?? "name"
    derived shown = if sort == "price" {
        PRODUCTS.sortBy(p => p.price)
    } else {
        PRODUCTS.sortBy(p => p.name)
    }
    Heading("Products").h1
    Row(gap: .sm) {
        Link("By name", to: "/products?sort=name")
        Link("By price", to: "/products?sort=price")
    }
    for p in shown by p.name {
        Text("{p.name}: ${p.price}")
    }
}
"#, "webfluent.app.json": #"{
  "name": "filters-in-the-address"
}
"# }) {
        code {
            CodeBlock(#"const PRODUCTS = [
    { name: "Kettle", price: 39 },
    { name: "Apron", price: 18 },
    { name: "Mug", price: 9 },
]

page Products(path: "/products", title: "Products", description: "Everything we sell.") {
    derived sort = query.sort ?? "name"
    derived shown = if sort == "price" {
        PRODUCTS.sortBy(p => p.price)
    } else {
        PRODUCTS.sortBy(p => p.name)
    }
    Heading("Products").h1
    Row(gap: .sm) {
        Link("By name", to: "/products?sort=name")
        Link("By price", to: "/products?sort=price")
    }
    for p in shown by p.name {
        Text("{p.name}: ${p.price}")
    }
}"#, title: "wf")
        }
        Markdown("Choose **By price** and the list reorders to Mug, Apron, Kettle, and the address becomes `/products?sort=price`. Reload the page or share the link, and it opens sorted by price.\n\n- [`query`](/learn/05-pages-and-routing#query-strings-and-fragments) is the address's query string as a map: `query.sort` is `\"price\"` for `?sort=price`, and null when the address has no `sort`.\n- `sort` is a [`derived`](/learn/07-state-and-reactivity#derived) value, so `??` gives it a default and it follows the address. `shown` is derived from `sort`, so the list reorders whenever the address does.\n- Each choice is a `Link` to the same page with another query. A query string is not part of the route, so `/products?sort=price` is still the `Products` page; only `sort` changes.\n\nTo change the query from an action instead of a link, call `navigate(\"/products?sort=price\")`.")

    }
