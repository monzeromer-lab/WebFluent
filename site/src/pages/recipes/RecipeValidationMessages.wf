// edit the recipe, not this file.
page RecipeValidationMessages(path: "/recipes/validation-messages", title: "Show validation messages on a form — Recipes", description: "To check a form as the reader fills it in, put a `validate` block beside each state:") {
    RecipeShell("Show validation messages on a form", summary: "To check a form as the reader fills it in, put a `validate` block beside each state:", outputs: [], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Load more as the reader asks", to: "/recipes/load-more"), RelatedLink(kind: "Recipe", title: "Page through results", to: "/recipes/page-through-results"), RelatedLink(kind: "Recipe", title: "Sign in with a session cookie", to: "/recipes/sign-in-with-a-session-cookie")], source: "md-docs/recipes/validation-messages.md", how: true, hasVariations: false) {
        code {
            CodeBlock(#"page Signup(path: "/", title: "Sign up", description: "Make an account.") {
    state email = ""
    state password = ""
    state confirm = ""
    state sent = false
    validate email { required  email "Enter a valid email" }
    validate password { required  minLength(8) "At least 8 characters" }
    validate confirm { matches(password) "The passwords differ" }
    Heading("Sign up").h1
    Form(bind: form) {
        on submit { sent = true  form.reset() }
        Input(bind: email, name: "email", label: "Email").email
        Input(bind: password, name: "password", label: "Password").password
        Input(bind: confirm, name: "confirm", label: "Confirm password").password
        Button("Create account", type: .submit, disabled: !form.valid).primary
    }
    if sent { Alert("Welcome aboard.").success }
}"#, title: "wf")
        }
        Markdown("Each control shows its own message when the reader leaves it, and a submit that fails moves focus to the first problem. [Forms](/docs/guide/forms) lists every rule.")

    }
}
