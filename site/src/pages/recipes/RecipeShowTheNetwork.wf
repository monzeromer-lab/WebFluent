// A recipe, written from md-docs/recipes/show-the-network.md by scripts/docsite/recipes.py;
// edit the recipe, not this file.
page RecipeShowTheNetwork(path: "/recipes/show-the-network", title: "Show what the network is doing — Recipes", description: "Change what a page does on a slow connection or none at all by reading `network`: online, connection speed, data saver and queued writes.") {
    RecipeShell("Show what the network is doing", summary: "`network` tells a page whether it is online, how fast the line is and whether the reader asked to save data, so the page can change what it does on a slow line or none at all. This inbox warns when the browser is offline and when data saver is on:", outputs: ["website", "app", "desktop"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Show validation messages on a form", to: "/recipes/validation-messages"), RelatedLink(kind: "Recipe", title: "Sign in with a session cookie", to: "/recipes/sign-in-with-a-session-cookie"), RelatedLink(kind: "Recipe", title: "Page through results", to: "/recipes/page-through-results")], source: "md-docs/recipes/show-the-network.md", how: true, hasVariations: false) {
        code {
            CodeBlock(#"page Inbox(path: "/inbox", title: "Inbox", description: "Your messages.") {
    Heading("Inbox").h1
    if !network.online { Alert("You are offline — changes are queued.").warning }
    if network.saveData { Text("Data saver is on.").muted }
}"#, title: "wf")
        }
        Markdown("Like `viewport`, `network` is a browser value that keeps itself current: each `if` that reads it is drawn again when the connection changes, with nothing to subscribe to.")

        Table(caption: "Show what the network is doing") {
            Table.Head {
                Table.Row {
                    Table.Cell("Member").header
                    Table.Cell("What it is").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`network.online`") }
                    Table.Cell("Whether the browser has a connection")
                }
                Table.Row {
                    Table.Cell { Markdown("`network.effectiveType`") }
                    Table.Cell { Markdown("How fast it is: `4g`, `3g`, …") }
                }
                Table.Row {
                    Table.Cell { Markdown("`network.saveData`") }
                    Table.Cell("Whether the reader asked to save data")
                }
                Table.Row {
                    Table.Cell { Markdown("`network.downlink`") }
                    Table.Cell("The estimated bandwidth, in megabits per second")
                }
                Table.Row {
                    Table.Cell { Markdown("`network.queued`") }
                    Table.Cell { Markdown("How many writes wait for the connection, when the site works offline ([Offline](/recipes/keep-writes-made-offline))") }
                }
            }
        }

    }
}
