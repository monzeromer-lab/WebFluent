page RecipeTalkBetweenTabs(path: "/recipes/talk-between-tabs", title: "Talk to the site's other tabs — Recipes", description: "To keep tabs of the same site in step — a cart, a sign-in, a setting — declare a `channel` with `broadcast(name)`.") {
    RecipeShell("Talk to the site's other tabs", summary: "To keep tabs of the same site in step — a cart, a sign-in, a setting — declare a `channel` with `broadcast(name)`. Every tab that opens a channel of that name hears what the others post with `.post(value)`:", outputs: [], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Connect two readers' pages", to: "/recipes/connect-two-readers"), RelatedLink(kind: "Recipe", title: "Listen to server-sent events", to: "/recipes/server-sent-events"), RelatedLink(kind: "Recipe", title: "Open a socket", to: "/recipes/open-a-socket")], source: "md-docs/recipes/talk-between-tabs.md", how: true, hasVariations: false) {
        code {
            CodeBlock(#"store Cart {
    state count = 0
    action add() { count = count + 1 }
    action merge(m: Map) { count = m.items }
}

page Shop(path: "/", title: "Shop", description: "A cart every tab agrees on.") {
    channel cart = broadcast("cart") { on message(m) { Cart.merge(m) } }

    Heading("Shop").h1
    …
    Text("{Cart.count} in the cart")
    Button("Add to cart") { on click { Cart.add()  cart.post({ items: Cart.count }) } }
}"#, title: "wf")
        }
        Markdown("Open the page in two tabs and add to the cart in one: the other tab's count follows. A tab does not hear its own posts. `cart.last` is the last message another tab posted. A channel's state is `open`, or `closed` in a browser without `BroadcastChannel`.")

    }
}
