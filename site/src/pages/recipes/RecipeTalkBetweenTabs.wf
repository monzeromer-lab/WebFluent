page RecipeTalkBetweenTabs(path: "/recipes/talk-between-tabs", title: "Talk to the site's other tabs — Recipes", description: "Keep a site's open tabs in step — a cart, a sign-in, a setting — with a `channel` opened by `broadcast(name)`, which every other tab hears.") {
    RecipeShell("Talk to the site's other tabs", summary: "A `channel` keeps tabs of the same site in step — a cart, a sign-in, a setting. Every tab that opens a channel of the same name hears what the others post, with no server involved. This shop keeps its cart count the same in every tab:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Connect two readers' pages", to: "/recipes/connect-two-readers"), RelatedLink(kind: "Recipe", title: "Run a script in a worker", to: "/recipes/run-a-worker"), RelatedLink(kind: "Recipe", title: "Open a socket", to: "/recipes/open-a-socket")], source: "md-docs/recipes/talk-between-tabs.md", how: true, hasVariations: false, project: { "src/pages/TalkBetweenTabs.wf": #"store Cart {
    state count = 0
    action add() { count = count + 1 }
    action merge(m: Map) { count = m.items }
}

page Shop(path: "/", title: "Shop", description: "A cart every tab agrees on.") {
    use Cart
    channel cart = broadcast("cart") { on message(m) { Cart.merge(m) } }

    Heading("Shop").h1
    Text("{Cart.count} in the cart")
    Button("Add to cart") { on click { Cart.add()  cart.post({ items: Cart.count }) } }
}
"#, "webfluent.app.json": #"{
  "name": "talk-between-tabs"
}
"# }) {
        code {
            Markdown("**Needs:** nothing besides the page; open it in two tabs. It claims `/`: paste it into a new project, or replace the starter's `src/pages/Home.wf` with it.")
            CodeBlock(#"store Cart {
    state count = 0
    action add() { count = count + 1 }
    action merge(m: Map) { count = m.items }
}

page Shop(path: "/", title: "Shop", description: "A cart every tab agrees on.") {
    use Cart
    channel cart = broadcast("cart") { on message(m) { Cart.merge(m) } }

    Heading("Shop").h1
    Text("{Cart.count} in the cart")
    Button("Add to cart") { on click { Cart.add()  cart.post({ items: Cart.count }) } }
}"#, title: "wf")
        }
        Markdown("- **`channel cart = broadcast(\"cart\")`** joins the channel named `cart`. A channel is a page's for as long as the page shows.\n- **`cart.post(value)`** sends a value to every other tab on the channel. Here the button adds to the cart, then posts the new count.\n- **`on message(m)`**, in the channel's block, hears what another tab posted, and hands it to the store's `merge` action.\n\nOpen the page in two tabs and add to the cart in one: the other tab's count follows. A tab does not hear its own posts, and both tabs must be on the same origin. `cart.last` is the last message another tab posted. A channel's state is `open`, or `closed` in a browser without `BroadcastChannel`.")

    }
}
