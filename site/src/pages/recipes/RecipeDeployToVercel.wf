// A recipe, written from md-docs/recipes/deploy-to-vercel.md by scripts/docsite/recipes.py;
// edit the recipe, not this file.
page RecipeDeployToVercel(path: "/recipes/deploy-to-vercel", title: "Deploy to Vercel — Recipes", description: "Deploy a WebFluent site to Vercel with a vercel.json that installs wf, builds, sets the security headers and rewrites a single-page build.") {
    RecipeShell("Deploy to Vercel", summary: "This recipe has Vercel build a WebFluent site on every push and serve it. Vercel does not read the `_headers` file the build writes, so the headers go in `vercel.json`.  You need a Vercel account and the project in a repository Vercel can read; the build command installs `wf` as [Install wf on a build machine](/recipes/install-wf-in-ci) shows.  Add `vercel.json` at the project's root. This one is for a single-page build:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works"), Anchor(id: "check-it", label: "Check it"), Anchor(id: "variations", label: "Variations")], related: [RelatedLink(kind: "Recipe", title: "Install wf on a build machine", to: "/recipes/install-wf-in-ci"), RelatedLink(kind: "Recipe", title: "Use environment values, and keep secrets out", to: "/recipes/environments-and-secrets"), RelatedLink(kind: "Recipe", title: "Deploy to GitHub Pages", to: "/recipes/deploy-to-github-pages")], source: "md-docs/recipes/deploy-to-vercel.md", how: true, hasVariations: true) {
        code {
            CodeBlock(#"{
  "buildCommand": "curl --proto '=https' --tlsv1.2 -fsSL https://raw.githubusercontent.com/monzeromer-lab/WebFluent/master/install.sh | WF_VERSION=v6.1.0 bash && ~/.webfluent/bin/wf build",
  "outputDirectory": "build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}"#, title: "json")
        }
        variations {
            Markdown("For a static build, leave out `rewrites`: each page has its own file, and an unknown path should be a 404.")

        }
        Markdown("1. `buildCommand` installs `wf` and builds the site; `outputDirectory` tells Vercel to serve `build/`.\n2. `headers` sets the security headers on every path. Vercel does not read `_headers`, so copy every header the build wrote in `build/_headers` into this list, including the `Content-Security-Policy` line ([Set cache and security headers](/recipes/cache-and-security-headers#set-security-headers)).\n3. `rewrites` answers every path with `index.html`, so a reload on a deep link reaches the single-page build's router.")

        Heading("Check it", id: "check-it").h2

        Markdown("Compare the response headers in the browser's network panel with `build/_headers`. Each header in the file should be there. Then go through [Check a deploy](/recipes/check-a-deploy).")

    }
}
