// A recipe, written from md-docs/recipes/animate-a-list.md by scripts/docsite/recipes.py;
// edit the recipe, not this file.
page RecipeAnimateAList(path: "/recipes/animate-a-list", title: "Animate a list — Recipes", description: "To animate the items of a list as they are added, removed and moved, use a keyed `for … by` and give the item's element `animate:`, `exit:` and `stagger:`:") {
    RecipeShell("Animate a list", summary: "To animate the items of a list as they are added, removed and moved, use a keyed `for … by` and give the item's element `animate:`, `exit:` and `stagger:`:", outputs: [], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Add a dark-mode switch", to: "/recipes/dark-mode-switch"), RelatedLink(kind: "Recipe", title: "Add a picture, sized for every screen", to: "/recipes/add-a-picture"), RelatedLink(kind: "Recipe", title: "Add video and audio", to: "/recipes/video-and-audio")], source: "md-docs/recipes/animate-a-list.md", how: true, hasVariations: false) {
        code {
            CodeBlock(#"type Item { id: Number, text: String }

page Tasks(path: "/", title: "Tasks", description: "A list that animates.") {
    state items: [Item] = [Item(id: 1, text: "First"), Item(id: 2, text: "Second")]
    state next = 3
    action add() { items.push(Item(id: next, text: "Item {next}"))  next = next + 1 }
    action shuffle() { items = items.reverse() }
    Heading("Tasks").h1
    Row(gap: .sm) {
        Button("Add") { on click { add() } }
        Button("Reverse") { on click { shuffle() } }
    }
    for item in items by item.id {
        Card(animate: .fadeIn, exit: .fadeOut, stagger: "40ms") {
            Row(justify: .between) {
                Text(item.text)
                Button("Remove").sm { on click { items = items.filter(i => i.id != item.id) } }
            }
        }
    }
}"#, title: "wf")
        }
        Markdown("What each change does:\n\n- **An item arrives.** It plays its `animate:`. `stagger: \"40ms\"` delays each item's enter by its index × 40ms, so a list fills in one item after another.\n- **An item moves** — a sort, a reverse, an insert above it. It slides to its new place. This is a *FLIP* transform: the runtime measures where the node was and where it is, and animates between them. It works because `by` keeps the item's node alive.\n- **An item leaves.** It plays its `exit:` first.")

    }
}
