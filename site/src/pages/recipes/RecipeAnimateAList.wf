// A recipe, written from md-docs/recipes/animate-a-list.md by scripts/docsite/recipes.py;
// edit the recipe, not this file.
page RecipeAnimateAList(path: "/recipes/animate-a-list", title: "Animate a list — Recipes", description: "Animate a list's items as they arrive, move and leave: a keyed for … by, with animate:, exit: and stagger: on each item's element.") {
    RecipeShell("Animate a list", summary: "Make a list fill in one item after another, slide its items to their new places when it is reordered, and fade an item out as it is removed. The list is a keyed `for … by`, and each item's element carries `animate:`, `exit:` and `stagger:`:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Run a sequence of animations", to: "/recipes/animation-sequence"), RelatedLink(kind: "Recipe", title: "Set motion defaults, and respect reduced motion", to: "/recipes/motion-defaults"), RelatedLink(kind: "Recipe", title: "Animate route changes", to: "/recipes/route-transitions")], source: "md-docs/recipes/animate-a-list.md", how: true, hasVariations: false, project: { "src/pages/AnimateAList.wf": #"type Item { id: Number, text: String }

page Tasks(path: "/", title: "Tasks", description: "A list that animates.") {
    state items: [Item] = [Item(id: 1, text: "First"), Item(id: 2, text: "Second")]
    state next = 3
    action add() { items.push(Item(id: next, text: "Item {next}"))  next = next + 1 }
    action shuffle() { items = items.reverse() }
    Heading("Tasks").h1
    Row(gap: .sm) {
        Button("Add") { on click { add() } }
        Button("Reverse") { on click { shuffle() } }
    }
    for item in items by item.id {
        Card(animate: .fadeIn, exit: .fadeOut, stagger: "40ms") {
            Row(justify: .between) {
                Text(item.text)
                Button("Remove").sm { on click { items = items.filter(i => i.id != item.id) } }
            }
        }
    }
}
"#, "webfluent.app.json": #"{
  "name": "animate-a-list"
}
"# }) {
        code {
            Markdown("**Needs:** nothing besides the page. It claims `/` and the name `Tasks`, as two of the starter's pages do: paste it into a new project, or replace `src/pages/Home.wf` and remove `src/pages/Tasks.wf`.")
            CodeBlock(#"type Item { id: Number, text: String }

page Tasks(path: "/", title: "Tasks", description: "A list that animates.") {
    state items: [Item] = [Item(id: 1, text: "First"), Item(id: 2, text: "Second")]
    state next = 3
    action add() { items.push(Item(id: next, text: "Item {next}"))  next = next + 1 }
    action shuffle() { items = items.reverse() }
    Heading("Tasks").h1
    Row(gap: .sm) {
        Button("Add") { on click { add() } }
        Button("Reverse") { on click { shuffle() } }
    }
    for item in items by item.id {
        Card(animate: .fadeIn, exit: .fadeOut, stagger: "40ms") {
            Row(justify: .between) {
                Text(item.text)
                Button("Remove").sm { on click { items = items.filter(i => i.id != item.id) } }
            }
        }
    }
}"#, title: "wf")
        }
        Markdown("Each change to `items` plays a different motion:\n\n- **An item arrives.** It plays its `animate:`. `stagger: \"40ms\"` delays each item's enter by its index × 40ms, so a list fills in one item after another.\n- **An item moves** — a sort, a reverse, an insert above it. It slides to its new place. This is a *FLIP* transform: the runtime measures where the node was and where it is, and animates between them. It works because `by item.id` keeps the item's node alive ([Control flow](/learn/09-control-flow)).\n- **An item leaves.** It plays its `exit:` first, and the runtime removes the node when it ends.\n\nA `for` with no `by`, or a key that changes, makes a new node for the item, so it fades out and in again instead of moving. Key the list by what identifies the item.\n\nA reader who asked for reduced motion sees items appear, move and go at once: no animation, no FLIP and no wait before removal ([Respect reduced motion](/recipes/motion-defaults#respect-reduced-motion)).")

    }
}
