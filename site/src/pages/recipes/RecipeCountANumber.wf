    RecipeShell("Count a number to its new value", summary: "Make a figure arrive rather than jump — a total, a score, a balance — by giving its element `count:` with a length of time. Press **Load** and the revenue counts from `$0.00` to `$1,200.00`:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Tween a property when state changes", to: "/recipes/tween-on-change"), RelatedLink(kind: "Recipe", title: "Set motion defaults, and respect reduced motion", to: "/recipes/motion-defaults"), RelatedLink(kind: "Recipe", title: "Declare your own keyframes", to: "/recipes/keyframes")], source: "md-docs/recipes/count-a-number.md", how: true, hasVariations: false, project: { "src/pages/CountANumber.wf": #"page Revenue(path: "/", title: "Revenue", description: "A figure that counts up.") {
