// A recipe, written from md-docs/recipes/debounce-a-search.md by scripts/docsite/recipes.py;
// edit the recipe, not this file.
page RecipeDebounceASearch(path: "/recipes/debounce-a-search", title: "Debounce a search — Recipes", description: "Search as the reader types, but only once they pause: keep what they typed apart from what you search for, and let a timer move one to the other.") {
    RecipeShell("Debounce a search", summary: "A search box that asks the server on every key sends a request per letter. To wait until the reader stops typing, keep what they typed apart from what you search for, and copy one to the other only after a pause:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Count down", to: "/recipes/count-down"), RelatedLink(kind: "Recipe", title: "Make navigation responsive", to: "/recipes/responsive-navigation"), RelatedLink(kind: "Recipe", title: "Pass a store's value to a component", to: "/recipes/store-value-as-a-prop")], source: "md-docs/recipes/debounce-a-search.md", how: true, hasVariations: false, project: { "src/pages/DebounceASearch.wf": #"page Search(path: "/", title: "Search", description: "Search as you type, without a request per key.") {
    state typed = ""
    state q = ""
    action commit(value: String) { if value == typed { q = value } }
    effect {
        let pending = typed
        setTimeout(() => commit(pending), 300)
    }
    resource hits = fetch("/api/search?q={q}")
    Heading("Search").h1
    Input(bind: typed, placeholder: "Search", aria-label: "Search")
    if q != "" {
        match hits {
            loading { Spinner.sm }
            error(e) { Text(e.message).danger }
            ready(list) { Text("{list.length} results for {q}") }
        }
    }
}
"#, "webfluent.app.json": #"{
  "name": "debounce-a-search"
}
"# }) {
        code {
            Markdown("**Needs:** a server that answers `/api/search?q=…` with a list of results. It claims `/`: paste it into a new project, or replace the starter's `src/pages/Home.wf` with it.")
            CodeBlock(#"page Search(path: "/", title: "Search", description: "Search as you type, without a request per key.") {
    state typed = ""
    state q = ""
    action commit(value: String) { if value == typed { q = value } }
    effect {
        let pending = typed
        setTimeout(() => commit(pending), 300)
    }
    resource hits = fetch("/api/search?q={q}")
    Heading("Search").h1
    Input(bind: typed, placeholder: "Search", aria-label: "Search")
    if q != "" {
        match hits {
            loading { Spinner.sm }
            error(e) { Text(e.message).danger }
            ready(list) { Text("{list.length} results for {q}") }
        }
    }
}"#, title: "wf")
        }
        Markdown("- `typed` follows the input on every key, through `bind:`. `q` is what the page searches for, and only `commit` writes it.\n- The [effect](/learn/07-state-and-reactivity#effect) reads `typed`, so it runs again on every keystroke. Each run keeps the value it saw in `pending` and schedules a check 300 ms later.\n- When a check runs, `commit` writes `q` only if `pending` is still what the reader has typed. A check from an earlier key finds `typed` has moved on and does nothing, so only the last pause gets through.\n- The [resource](/learn/15-data#show-a-request-with-resource) splices `q` into its address, so it asks again each time `q` changes — once per pause, not once per key. It also asks once as the page opens, for `/api/search?q=`, before anything is typed; the `if q != \"\"` shows nothing of that answer, so the server only has to answer it quickly (an empty list will do).\n\nThe timer is the browser's `setTimeout`, because [`after(ms)`](/learn/07-state-and-reactivity#timers) is a declaration with a body, not a statement an effect can hold.")

    }
}
