// A recipe, written from md-docs/recipes/debounce-a-search.md by scripts/docsite/recipes.py;
// edit the recipe, not this file.
page RecipeDebounceASearch(path: "/recipes/debounce-a-search", title: "Debounce a search — Recipes", description: "To wait until the reader stops typing before you search, keep what they typed apart from what you search for:") {
    RecipeShell("Debounce a search", summary: "To wait until the reader stops typing before you search, keep what they typed apart from what you search for:", outputs: [], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Build a confirm dialog", to: "/recipes/confirm-dialog"), RelatedLink(kind: "Recipe", title: "Copy to the clipboard", to: "/recipes/copy-to-the-clipboard"), RelatedLink(kind: "Recipe", title: "Count down", to: "/recipes/count-down")], source: "md-docs/recipes/debounce-a-search.md", how: true, hasVariations: false) {
        code {
            CodeBlock(#"page Search(path: "/", title: "Search", description: "Search as you type, without a request per key.") {
    state typed = ""
    state q = ""
    action commit(value: String) { if value == typed { q = value } }
    effect {
        let pending = typed
        setTimeout(() => commit(pending), 300)
    }
    resource hits = fetch("/api/search?q={q}")
    Heading("Search").h1
    Input(bind: typed, placeholder: "Search", aria-label: "Search")
    match hits {
        loading { Spinner.sm }
        error(e) { Text(e.message).danger }
        ready(list) { Text("{list.length} results for {q}") }
    }
}"#, title: "wf")
        }
        Markdown("The effect runs again on every keystroke, and each run schedules a check. Only the check whose value is still current writes `q`, and the resource follows `q`. The timer is the browser's `setTimeout`, because `after(ms)` is a declaration with a body, not a statement an effect can hold.")

    }
}
