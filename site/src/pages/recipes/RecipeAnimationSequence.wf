// edit the recipe, not this file.
page RecipeAnimationSequence(path: "/recipes/animation-sequence", title: "Run a sequence of animations — Recipes", description: "To start a group of elements one after another on a clock, wrap them in `sequence` and put each in a `step`:") {
    RecipeShell("Run a sequence of animations", summary: "To start a group of elements one after another on a clock, wrap them in `sequence` and put each in a `step`:", outputs: [], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Add a dark-mode switch", to: "/recipes/dark-mode-switch"), RelatedLink(kind: "Recipe", title: "Add a picture, sized for every screen", to: "/recipes/add-a-picture"), RelatedLink(kind: "Recipe", title: "Add video and audio", to: "/recipes/video-and-audio")], source: "md-docs/recipes/animation-sequence.md", how: true, hasVariations: false) {
        code {
            CodeBlock(#"page Landing(path: "/", title: "Welcome", description: "A page that introduces itself.") {
    sequence {
        step { Heading("Welcome").h1.fadeIn }
        step(after: "120ms") { Text("What we do.").slideUp }
        step(after: "120ms") { Button("Start").primary.slideUp }
    }
}"#, title: "wf")
        }
        Markdown("`after:` is measured from the step before it, so the three start at 0ms, 120ms and 240ms. A step with no `after:` starts when the step before it does, which is how several elements move together.\n\nA `sequence` does nothing but timing: it writes the clock onto its elements as `delay:` and leaves nothing of itself behind. What the rest of the build sees is the program you would have written by hand.")

    }
}
