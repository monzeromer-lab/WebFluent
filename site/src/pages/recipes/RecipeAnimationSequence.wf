// A recipe, written from md-docs/recipes/animation-sequence.md by scripts/docsite/recipes.py;
// edit the recipe, not this file.
page RecipeAnimationSequence(path: "/recipes/animation-sequence", title: "Run a sequence of animations — Recipes", description: "Start a group of animations one after another on a clock: wrap the elements in sequence \{ \} and each in a step, with after: from the step before.") {
    RecipeShell("Run a sequence of animations", summary: "Bring a page's opening elements in one after another — a heading, then a line of text, then a button — by wrapping them in `sequence` and putting each in a `step`:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Add a dark-mode switch", to: "/recipes/dark-mode-switch"), RelatedLink(kind: "Recipe", title: "Add a picture, sized for every screen", to: "/recipes/add-a-picture"), RelatedLink(kind: "Recipe", title: "Add video and audio", to: "/recipes/video-and-audio")], source: "md-docs/recipes/animation-sequence.md", how: true, hasVariations: false) {
        code {
            CodeBlock(#"page Landing(path: "/", title: "Welcome", description: "A page that introduces itself.") {
    sequence {
        step { Heading("Welcome").h1.fadeIn }
        step(after: "120ms") { Text("What we do.").slideUp }
        step(after: "120ms") { Button("Start").primary.slideUp }
    }
}"#, title: "wf")
        }
        Markdown("- `after:` is measured from the step before it, so the three start at 0ms, 120ms and 240ms.\n- A step with no `after:` starts when the step before it does, which is how several elements move together.\n- A `sequence` does nothing but timing: it writes the clock onto its elements as `delay:` and leaves nothing of itself behind. What the rest of the build sees is the program you would have written by hand, with `delay: \"120ms\"` and `delay: \"240ms\"` on the second and third elements.")

    }
}
