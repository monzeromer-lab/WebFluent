// A recipe, written from md-docs/recipes/expand-to-content.md by scripts/docsite/recipes.py;
// edit the recipe, not this file.
page RecipeExpandToContent(path: "/recipes/expand-to-content", title: "Open a box to the height of its content — Recipes", description: "Open a box to the height of its content, which CSS cannot animate to: .expand measures height: auto, animates to it, then lets the box grow.") {
    RecipeShell("Open a box to the height of its content", summary: "CSS cannot animate to `height: auto`, so a box of details that should slide open to whatever height its text needs takes `.expand`. Press **Details** and the box opens; press it again and it closes:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Animate an element in and out", to: "/recipes/animate-in-and-out"), RelatedLink(kind: "Recipe", title: "Animate a list", to: "/recipes/animate-a-list"), RelatedLink(kind: "Recipe", title: "Run a sequence of animations", to: "/recipes/animation-sequence")], source: "md-docs/recipes/expand-to-content.md", how: true, hasVariations: false) {
        code {
            Markdown("**Needs:** nothing besides the page. It claims `/`: paste it into a new project, or replace the starter's `src/pages/Home.wf` with it.")
            CodeBlock(#"page Details(path: "/", title: "Details", description: "A box that opens smoothly.") {
    state open = false
    Heading("Details").h1
    Button("Details") { on click { open = !open } }
    show open {
        Stack(animate: .expand) { Text("As much text as there is.") }
    }
}"#, title: "wf")
        }
        Markdown("- `show open` toggles whether the box is visible, and the box animates as it appears and goes.\n- `animate: .expand` measures the height `auto` would give, animates to that number, then hands the height back, so the box keeps growing with its content.\n- `.expand` on the way in is `.collapse` on the way out, so the box needs no `exit:`.\n\nA reader who asked for reduced motion sees the box open at once ([Respect reduced motion](/recipes/motion-defaults#respect-reduced-motion)).")

    }
}
