page RecipeServeWithCaddy(path: "/recipes/serve-with-caddy", title: "Serve a site with Caddy — Recipes", description: "1.") {
    RecipeShell("Serve a site with Caddy", summary: "1. Add a site block to the `Caddyfile`:     ```text example.com \{ root * /var/www/site encode gzip file_server \{ precompressed gzip \} try_files \{path\} \{path\}/ \{path\}.html /index.html header X-Content-Type-Options nosniff \} ```     `precompressed gzip` serves the build's `.gz` files. The last entry of `try_files`, `/index.html`, is the single-page fallback; remove it for a static build, so an unknown path is a 404. 2. Upload `build/` to `/var/www/site` and reload Caddy.  **Verify it:** open a deep link directly and reload it, then check the headers with `curl -I`.", outputs: [], since: "", recipes: RECIPE_INDEX, sections: [], related: [RelatedLink(kind: "Recipe", title: "Build a Docker image", to: "/recipes/docker-image"), RelatedLink(kind: "Recipe", title: "Check a deploy", to: "/recipes/check-a-deploy"), RelatedLink(kind: "Recipe", title: "Deploy to Cloudflare Pages", to: "/recipes/deploy-to-cloudflare-pages")], source: "md-docs/recipes/serve-with-caddy.md", how: false, hasVariations: false) {
