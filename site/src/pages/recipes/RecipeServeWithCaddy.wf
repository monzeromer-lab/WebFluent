// A recipe, written from md-docs/recipes/serve-with-caddy.md by scripts/docsite/recipes.py;
// edit the recipe, not this file.
page RecipeServeWithCaddy(path: "/recipes/serve-with-caddy", title: "Serve a site with Caddy — Recipes", description: "Serve a WebFluent build with Caddy: a Caddyfile site block that sends the build's gzip files and falls back to index.html for a single-page build.") {
    RecipeShell("Serve a site with Caddy", summary: "This recipe serves a WebFluent build with Caddy, which also gets and renews the site's TLS certificate.  You need a server running Caddy, and a `build/` folder from `wf build` ([Install wf on a build machine](/recipes/install-wf-in-ci)).  Add a site block to the `Caddyfile`:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works"), Anchor(id: "check-it", label: "Check it"), Anchor(id: "variations", label: "Variations")], related: [RelatedLink(kind: "Recipe", title: "Install wf on a build machine", to: "/recipes/install-wf-in-ci"), RelatedLink(kind: "Recipe", title: "Use environment values, and keep secrets out", to: "/recipes/environments-and-secrets"), RelatedLink(kind: "Recipe", title: "Deploy to GitHub Pages", to: "/recipes/deploy-to-github-pages")], source: "md-docs/recipes/serve-with-caddy.md", how: true, hasVariations: true) {
        code {
            CodeBlock(#"example.com {
    root * /var/www/site
    encode gzip
    file_server {
        precompressed gzip
    }
    try_files {path} {path}/ {path}.html /index.html
    header X-Content-Type-Options nosniff
}"#, title: "text")
        }
        variations {
            Markdown("For a static build, remove `/index.html` from the end of `try_files`, so an unknown path is a 404.")

        }
        Markdown("Then upload `build/` to `/var/www/site` and reload Caddy.\n\n1. `root` is the folder the build is uploaded to.\n2. `precompressed gzip` serves the `.gz` files the build wrote; `encode gzip` compresses on the way out what has none.\n3. `try_files` decides what a path reaches: the file, the folder's `index.html`, the `.html` file `clean_urls: \"file\"` writes, and last `/index.html`, the single-page fallback.\n4. `header` sends a security header; add the others from `build/_headers` the same way ([Set cache and security headers](/recipes/cache-and-security-headers#set-security-headers)).")

        Heading("Check it", id: "check-it").h2

        Markdown("Open a deep link directly and reload it, then check the headers with `curl -I`. Then go through [Check a deploy](/recipes/check-a-deploy).")

    }
}
