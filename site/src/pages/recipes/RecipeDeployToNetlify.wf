// A recipe, written from md-docs/recipes/deploy-to-netlify.md by scripts/docsite/recipes.py;
// edit the recipe, not this file.
page RecipeDeployToNetlify(path: "/recipes/deploy-to-netlify", title: "Deploy to Netlify — Recipes", description: "Deploy a WebFluent site to Netlify: a netlify.toml that installs wf and builds, a fallback for a single-page build, and the build's security headers.") {
    RecipeShell("Deploy to Netlify", summary: "This recipe has Netlify build a WebFluent site on every push and serve it, with the security headers the build writes.  You need a Netlify account and the project in a repository Netlify can read; the build command installs `wf` as [Install wf on a build machine](/recipes/install-wf-in-ci) shows.  Add `netlify.toml` at the project's root:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works"), Anchor(id: "check-it", label: "Check it")], related: [RelatedLink(kind: "Recipe", title: "Build a Docker image", to: "/recipes/docker-image"), RelatedLink(kind: "Recipe", title: "Check a deploy", to: "/recipes/check-a-deploy"), RelatedLink(kind: "Recipe", title: "Deploy to Cloudflare Pages", to: "/recipes/deploy-to-cloudflare-pages")], source: "md-docs/recipes/deploy-to-netlify.md", how: true, hasVariations: false) {
        code {
            CodeBlock("[build]\n  command = \"curl -sSL https://raw.githubusercontent.com/monzeromer-lab/WebFluent/master/install.sh | bash && ~/.webfluent/bin/wf build\"\n  publish = \"build\"", title: "toml")
            Markdown("For a single-page build, also add `public/_redirects` with this line:")
            CodeBlock(#"/*  /index.html  200"#, title: "text")
        }
        Markdown("Then connect the repository in Netlify, or push to the branch it deploys.\n\n1. `command` installs `wf` and builds the site; `publish` tells Netlify to serve the `build/` folder.\n2. The build copies `public/_redirects` to the root of `build/`. Its line answers every path with `index.html` and a `200`, so a reload on `/users/42` reaches the single-page build's router.\n3. Netlify reads `_headers` from the build, so the security headers apply with no further setting ([Set cache and security headers](/recipes/cache-and-security-headers)).")

        Heading("Check it", id: "check-it").h2

        Markdown("In the browser's network panel, select the page's document request. Its response headers include `Content-Security-Policy` and `X-Content-Type-Options: nosniff`, which came from `_headers`. Then go through [Check a deploy](/recipes/check-a-deploy).")

    }
}
