// A recipe, written from md-docs/recipes/api-on-the-same-origin.md by scripts/docsite/recipes.py;
// edit the recipe, not this file.
page RecipeApiOnTheSameOrigin(path: "/recipes/api-on-the-same-origin", title: "Serve an API on the same origin — Recipes", description: "Serve the site at / and its backend at /api from one origin, so pages call it without CORS and a session cookie works with no extra setting.") {
    RecipeShell("Serve an API on the same origin", summary: "To call a backend without CORS, serve the site and the backend from one origin: the site at `/`, the backend at `/api`. A session cookie then works with no extra setting.  You need a server that serves the site, as in [Serve a site with nginx](/recipes/serve-with-nginx), and a backend it can reach. In nginx, add this `location` to the site's `server` block:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works"), Anchor(id: "variations", label: "Variations")], related: [RelatedLink(kind: "Recipe", title: "Build a Docker image", to: "/recipes/docker-image"), RelatedLink(kind: "Recipe", title: "Check a deploy", to: "/recipes/check-a-deploy"), RelatedLink(kind: "Recipe", title: "Deploy to Cloudflare Pages", to: "/recipes/deploy-to-cloudflare-pages")], source: "md-docs/recipes/api-on-the-same-origin.md", how: true, hasVariations: true) {
        code {
            CodeBlock(#"location /api/ {
    proxy_pass http://127.0.0.1:8080/;
}"#, title: "nginx")
        }
        variations {
            Markdown("Netlify, Vercel and Cloudflare Pages do the same with a rewrite to an external URL.\n\nAfter the deploy, [check it](/recipes/check-a-deploy).")

        }
        Markdown("1. nginx sends every request under `/api/` to the backend on port 8080, with the `/api` prefix taken off (the trailing `/` of `proxy_pass` does that), and serves everything else from the build.\n2. To the browser, the pages and the backend share one origin, so a request needs no CORS headers and carries the site's cookies.\n3. A page then declares the service with `api Backend(base: \"/api\")`, and it needs nothing else.")

    }
}
