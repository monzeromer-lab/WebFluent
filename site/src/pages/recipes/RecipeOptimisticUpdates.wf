page RecipeOptimisticUpdates(path: "/recipes/optimistic-updates", title: "Update at once, and roll back on failure — Recipes", description: "Show a change before the server agrees: update the state at once, send the request, and put the old value back if it fails.") {
    RecipeShell("Update at once, and roll back on failure", summary: "A like that waits for the server feels slow. To show the change at once, update the state before the request, keep the old value, and put it back if the request fails:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works"), Anchor(id: "variations", label: "Variations")], related: [RelatedLink(kind: "Recipe", title: "Load more as the reader asks", to: "/recipes/load-more"), RelatedLink(kind: "Recipe", title: "Page through results", to: "/recipes/page-through-results"), RelatedLink(kind: "Recipe", title: "Show validation messages on a form", to: "/recipes/validation-messages")], source: "md-docs/recipes/optimistic-updates.md", how: true, hasVariations: true) {
        code {
            CodeBlock(#"type Item { id: String, liked: Bool }

page Likes(path: "/", title: "Likes", description: "A like that shows at once.") {
    state items: [Item] = [Item(id: "a", liked: false)]
    state error = ""
    action like(id: String) {
        let before = items
        items = items.map(i => if i.id == id { Item(id: i.id, liked: !i.liked) } else { i })
        try {
            await fetch("/api/like/{id}", { method: "POST" })
        } catch e {
            items = before
            error = "Could not save. Try again."
        }
    }
    Heading("Likes").h1
    for i in items by i.id {
        Button(if i.liked { "♥" } else { "♡" }, aria-label: "Like").sm { on click { like(i.id) } }
    }
    if error != "" { Toast(error).danger }
}"#, title: "wf")
        }
        variations {
            Markdown("`optimistic(holder, change)` does the same with less code inside an action. It applies the change at once, and if anything later in the action throws, the change is taken back ([Fetching data](/learn/15-data#show-a-change-before-the-server-agrees)):")

            CodeBlock(#"action like(id: String) {
    optimistic(items, list => list.map(i => if i.id == id { Item(id: i.id, liked: !i.liked) } else { i }))
    await fetch("/api/like/{id}", { method: "POST" })
}"#, title: "wf")

        }
        Markdown("- `let before = items` keeps the list as it was. A [`let`](/learn/07-state-and-reactivity#actions-and-locals) is local to the action.\n- The next line gives `items` a new list with the one item flipped. The button repaints at once, before any request leaves.\n- The request is [awaited](/learn/15-data#fetch-on-demand-with-await-fetch) inside `try`. If it fails, the `catch` puts `before` back and sets `error`, and the `Toast` tells the reader.")

    }
}
