page RecipeOptimisticUpdates(path: "/recipes/optimistic-updates", title: "Update at once, and roll back on failure — Recipes", description: "To show a change before the server agrees, keep the old value and put it back if the request fails:") {
    RecipeShell("Update at once, and roll back on failure", summary: "To show a change before the server agrees, keep the old value and put it back if the request fails:", outputs: [], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Load more as the reader asks", to: "/recipes/load-more"), RelatedLink(kind: "Recipe", title: "Page through results", to: "/recipes/page-through-results"), RelatedLink(kind: "Recipe", title: "Show validation messages on a form", to: "/recipes/validation-messages")], source: "md-docs/recipes/optimistic-updates.md", how: true, hasVariations: false) {
        code {
            CodeBlock(#"type Item { id: String, liked: Bool }

page Likes(path: "/", title: "Likes", description: "A like that shows at once.") {
    state items: [Item] = [Item(id: "a", liked: false)]
    state error = ""
    action like(id: String) {
        let before = items
        items = items.map(i => if i.id == id { Item(id: i.id, liked: !i.liked) } else { i })
        try {
            await fetch("/api/like/{id}", { method: "POST" })
        } catch e {
            items = before
            error = "Could not save. Try again."
        }
    }
    Heading("Likes").h1
    for i in items by i.id {
        Button(if i.liked { "♥" } else { "♡" }, aria-label: "Like").sm { on click { like(i.id) } }
    }
    if error != "" { Toast(error).danger }
}"#, title: "wf")
        }
        Markdown("`optimistic(holder, change)` does the same with less code inside an action; see [Fetching data](/docs/guide/data#show-a-change-before-the-server-agrees).")

    }
}
