// A recipe. This page is its source: edit it here.
page RecipeCopyToTheClipboard(path: "/recipes/copy-to-the-clipboard", title: "Copy to the clipboard — Recipes", description: "Copy text to the reader's clipboard from a button: an action that awaits the browser's clipboard, then shows a toast.") {
    RecipeShell("Copy to the clipboard", summary: "A **Copy** button saves the reader selecting a link by hand. To copy text, call the browser's clipboard from an action and say when it worked:", outputs: ["website", "app"], since: "", recipes: RECIPE_INDEX, sections: [Anchor(id: "how-it-works", label: "How it works")], related: [RelatedLink(kind: "Recipe", title: "Debounce a search", to: "/recipes/debounce-a-search"), RelatedLink(kind: "Recipe", title: "Count down", to: "/recipes/count-down"), RelatedLink(kind: "Recipe", title: "Make navigation responsive", to: "/recipes/responsive-navigation")], source: "site/src/pages/recipes/RecipeCopyToTheClipboard.wf", how: true, hasVariations: false, project: { "src/pages/CopyToTheClipboard.wf": #"page Share(path: "/share", title: "Share", description: "Copy the link.") {
    action copy(text: String) {
        try {
            await navigator.clipboard.writeText(text)
            toast("Copied", tone: .success)
        } catch e {
            toast("Could not copy. Select the address and copy it by hand.", tone: .danger)
        }
    }
    Heading("Share").h1
    Button("Copy the link") { on click { copy(location.href) } }
}
"#, "webfluent.app.json": #"{
  "name": "copy-to-the-clipboard"
}
"# }) {
        code {
            DocsCodeBlock(#"page Share(path: "/share", title: "Share", description: "Copy the link.") {
    action copy(text: String) {
        try {
            await navigator.clipboard.writeText(text)
            toast("Copied", tone: .success)
        } catch e {
            toast("Could not copy. Select the address and copy it by hand.", tone: .danger)
        }
    }
    Heading("Share").h1
    Button("Copy the link") { on click { copy(location.href) } }
}"#, title: "wf")
        }
        Markdown("- `navigator.clipboard` and `location` are browser globals, used as written with no prefix.\n- `writeText` returns a promise, so the [action](/learn/07-state-and-reactivity#actions-and-locals) awaits it. `await` makes the action async, and the toast that says so shows only once the text is on the clipboard.\n- The browser may refuse: the page is not focused, it is not served over HTTPS, or the reader denied the permission. The promise then rejects, and the `catch` tells the reader to copy by hand instead of showing nothing.\n- The button's click handler calls `copy` with the page's own address.\n- `toast(…)` shows a toast each time it is called, so a second copy shows a second toast; `tone:` colours it, and a `.danger` one is announced at once.")

    }
}
