// A cheat sheet, in Arabic: the translation of the English sheet beside it.
// This page is its source: edit it here.
page ComingFromReactAr(path: "/ar/coming-from/react", title: "WebFluent لمطوّري React", description: "أفكار React في WebFluent: الحالة، والقيم المشتقة، والتأثيرات، والخصائص، والأبناء، والأحداث، والسياق، والمسارات، والقوائم، والجلب، جنبًا إلى جنب.", lang: "ar", translates: ComingFromReact) {
    ComingFromShell("WebFluent لمطوّري React", summary: "معظم ما تعرفه من React ينتقل معك: مكوّنات لها خصائص (props)، وحالة، وموجّه مسارات (router)، ومخازن (stores) مشتركة. الفرق الذي عليك أن تتذكّره أن WebFluent مُصرِّف (compiler) بترميز ذي أنواع، وليس مكتبة: جسم المكوّن يعمل مرة واحدة، ولا يتحدّث إلا النص أو الصفة أو النمط الذي يقرأ قيمة تغيّرت. لا خطافات (hooks)، ولا مصفوفات اعتماديات، ولا دوال ضبط (setters).", from: "React", sheets: [Place(key: "coming.react", to: "/ar/coming-from/react"), Place(key: "coming.vue", to: "/coming-from/vue"), Place(key: "coming.svelte", to: "/coming-from/svelte"), Place(key: "coming.html-css", to: "/coming-from/html-css"), Place(key: "coming.latex", to: "/coming-from/latex")], sections: [Anchor(id: "the-map", label: t("coming.map")), Anchor(id: "things-that-work-differently", label: t("coming.differences")), Anchor(id: "a-component-ported", label: t("coming.port")), Anchor(id: "البيانات-كما-يفعلها-tanstack-query", label: "البيانات كما يفعلها TanStack Query")], source: "site/src/pages/comingfrom/ComingFromReactAr.wf", other: "/coming-from/react", lang: "ar") {
        differences {
            DocsCallout("لم تُترجم كل فصول الدليل بعد: الروابط إلى فصل غير مترجم تفتح نسخته الإنجليزية.", kind: .note)

            Markdown("**إنه مُصرِّف، لا مكتبة.** لا يوجد DOM افتراضي ولا إعادة رسم. كل نص أو صفة أو نمط يقرأ حالة يتبعها وحده، وجسم المكوّن يعمل مرة واحدة، حين يوضع. لهذا لا خطافات، ولا قواعد عن ترتيب استدعائها.\n\n**الترميز ذو أنواع.** يعرف المُصرِّف خصائص كل عنصر مدمج وكل مكوّن تصرّح به، وأعلامه (flags) وأحداثه وفتحاته (slots). `Button(\"Save\").primray` لا يُبنى، ولا يُبنى كذلك معالج لحدث لا يطلقه المكوّن أبدًا (`E103`). والخاصية المجهولة على مكوّنك أنت هي `C02`، لا تمرير صامت.\n\n**الأنواع بلا لغة ثانية.** لا TypeScript بجانب الترميز ولا خطوة `tsc`: ملف `.wf` يفحص أنواعه المُصرِّف نفسه الذي يبنيه. يستنتج الفاحص ما يستطيع، ويطلب منك كتابة الباقي: حالة لا تقول قيمتها الأولى شيئًا (`state items: [Todo] = []`)، وإجراء يُرجع قيمة (`-> Number`)، ومعامل. لا `any`: JSON الذي لم يُحدَّد شكله هو `Json`، يُطابَق أو يُفكّ (`User.decode(raw)`) قبل أن يُقرأ، ولا إعداد يُطفئ الفحوص.\n\n**الصفحات تملك مساراتها.** لا يوجد جدول مسارات. كل `page` تسمّي `path:` الخاص بها، ويبني المُصرِّف الموجّه منها، مرتّبة حسب دقّتها، فلا يستطيع ترتيب تصريحك بالصفحات أن يخفي مسارًا.\n\n**لا استيراد ولا npm.** كل ملف تحت `src/` جزء من برنامج واحد، فالمكوّن المصرَّح به في أي مكان يُستعمل في كل مكان. مكتبة JavaScript هي عنوان URL في `meta.scripts`، وشيفرة JavaScript الخاصة بك ملف `.js` عادي تحت `src/` تستدعي شيفرة `.wf` دوالّه بأسمائها ([استدعِ JavaScript الخاصة بك](/recipes/call-your-own-script)).\n\n**البناء هو الموقع.** الصفحات المُصيَّرة مسبقًا، وتقسيم الشيفرة، وتغيير مقاسات الصور، وخريطة الموقع، ومعاينات الروابط، وسياسة Content-Security-Policy، كلها تأتي من `wf build`، بلا إضافات تختار بينها. لا تصيير على الخادم مع كل طلب: الموقع ملفات ثابتة ووقت تشغيل (runtime) في المتصفح، تتحدّث إلى واجهتك البرمجية (API).\n\n**النص نص.** الطريقة الوحيدة لوضع ترميز في صفحة هي `Unsafe.Html(…)`، التي ينبّه عليها البناء في كل مرة، أما المعالجات المضمّنة وعناوين `javascript:` فلا تُصرَّف ([الأمان](/about/security)).\n\n**استعماله داخل تطبيق React.** انشر المكوّنات عناصرَ مخصّصة (custom elements) وضع وسومها في JSX ([انشر المكوّنات عناصرَ مخصّصة](/recipes/publish-custom-elements)).")

        }
        port {
            Markdown("العدّاد نفسه، في React وفي WebFluent. يبدأ من رقم يمرّره المستدعي، ويزيد عند النقر، ويُظهر شارة حين يكون العدد زوجيًا، ويُخبر المستدعي بكل تغيير.")

            DocsCodeBlock(#"function Counter({ start = 0, onChange }) {
  const [n, setN] = useState(start);
  const even = useMemo(() => n % 2 === 0, [n]);
  return (
    <div className="row">
      <button onClick={() => { setN(n + 1); onChange?.(n + 1); }}>+</button>
      <span>{n}</span>
      {even && <span className="badge">even</span>}
    </div>
  );
}"#, title: "jsx")

            DocsCodeBlock(#"page Scores(path: "/", title: "Scores", description: "A counter that reports each change.") {
    state last = 0
    Heading("Scores").h1
    Counter(start: 2) { on change(value) { last = value } }
    Text("Last change: {last}")
}

component Counter(start: Number = 0) {
    event change(value: Number)
    state n = start
    derived even = n % 2 == 0
    Row(gap: .sm, align: .center) {
        Button("+") { on click { n = n + 1  emit change(n) } }
        Text("{n}")
        if even { Badge("even").info }
    }
}"#, title: "wf")

            Markdown("- **لا خطافات ولا مصفوفات اعتماديات.** `derived` يعرف ما يقرؤه.\n- **لا دالة ضبط.** أنت تُسند القيمة: `n = n + 1`.\n- **لا `className`.** `Badge` يأتي مصمَّمًا، و`.info` علم يفحصه المُصرِّف.\n- **الحدث مصرَّح به.** المستدعي الذي يعالج `on chnage` يحصل على `E103` وقت البناء، بدل معالج لا يعمل أبدًا.")

            Heading("البيانات كما يفعلها TanStack Query", id: "البيانات-كما-يفعلها-tanstack-query").h2

            Markdown("TanStack Query ذاكرةٌ للطلبات التي يطلبها المكوّن. في WebFluent تتوزّع المهام نفسها كلٌّ في مكانه: ما تملكه الخدمة عقدٌ، وكيف تُبلَغ هو الخدمة، وما تقرؤه الصفحة `resource` — قيمةٌ واحدة لها ثلاث حالات.")

            Table(caption: "البيانات كما يفعلها TanStack Query") {
                Table.Head {
                    Table.Row {
                        Table.Cell("TanStack Query").header
                        Table.Cell("WebFluent").header
                    }
                }
                Table.Body {
                    Table.Row {
                        Table.Cell { Markdown("`useQuery(\{ queryKey: [\"users\", page], queryFn \})`") }
                        Table.Cell { Markdown("`resource users = Backend.users.list(page: page)`: الوسائط متتبَّعة، فتغيّر `page` يعيد الطلب") }
                    }
                    Table.Row {
                        Table.Cell { Markdown("`isPending` و`isError` و`data` و`error`") }
                        Table.Cell { Markdown("قيمةٌ واحدة: `match users \{ .loading … .failed(e) … .loaded(list) … \}`؛ و`match` بلا `.failed` لا يُبنى") }
                    }
                    Table.Row {
                        Table.Cell { Markdown("`isFetching` والبيانات على الشاشة") }
                        Table.Cell { Markdown("`.loaded(list, refreshing, stale)`: القائمة باقية و`refreshing` صحيحة") }
                    }
                    Table.Row {
                        Table.Cell { Markdown("`staleTime` و`gcTime`") }
                        Table.Cell { Markdown("ما يقوله `Cache-Control` من الخادم (RFC 9111)، أو `cache: .swr(60.seconds)` على نقطة النهاية") }
                    }
                    Table.Row {
                        Table.Cell { Markdown("`refetchOnWindowFocus` و`refetchInterval`") }
                        Table.Cell { Markdown("`refresh: .onFocus` و`refresh: .every(30.seconds)`") }
                    }
                    Table.Row {
                        Table.Cell { Markdown("`useMutation(\{ mutationFn \})`") }
                        Table.Cell { Markdown("إجراءٌ يستدعي نقطة النهاية ويطابق نتيجتها بـ`match`") }
                    }
                    Table.Row {
                        Table.Cell { Markdown("`queryClient.invalidateQueries([\"users\"])` بعد التعديل") }
                        Table.Cell { Markdown("`invalidates [list]` على الكتابة في العقد: كل قراءةٍ لها تُعاد، بلا استدعاءٍ يُكتب") }
                    }
                    Table.Row {
                        Table.Cell { Markdown("`onMutate` بلقطةٍ و`onError` يتراجع") }
                        Table.Cell { Markdown("`let undo = Backend.users.list.update(list => …)` ثم `undo()` إن فشلت الكتابة") }
                    }
                    Table.Row {
                        Table.Cell { Markdown("`useInfiniteQuery` مع `getNextPageParam`") }
                        Table.Cell { Markdown("`pages .cursor(param: after, next: p => p.next)` على نقطة النهاية؛ و`users.loadMore()` و`users.hasMore`") }
                    }
                    Table.Row {
                        Table.Cell { Markdown("`retry: 3`") }
                        Table.Cell { Markdown("`retry: .backoff(times: 3)` على الخدمة لما يصحّ إرساله مرتين؛ و`POST` فقط إن كانت نقطة النهاية `idempotent`") }
                    }
                    Table.Row {
                        Table.Cell { Markdown("`error` من نوع `unknown` أو `Error`") }
                        Table.Cell { Markdown("`-> User ! CreateUserError`: تعدادُ أخطاءٍ فيه حالةٌ لكل حالةٍ يجيب بها الخادم، تُطابَق واحدةً واحدة") }
                    }
                    Table.Row {
                        Table.Cell { Markdown("`openapi-typescript` و`orval`") }
                        Table.Cell { Markdown("`wf api add openapi.json`: العقد ملفاتٍ، يُفحص في CI بـ`wf api check`") }
                    }
                    Table.Row {
                        Table.Cell("Mock Service Worker في الاختبارات")
                        Table.Cell { Markdown("`fake` للعقد يُلزمه المُصرِّف به، ويُسمّى في `fakes:` الاختبار") }
                    }
                }
            }

            Markdown("القائمة نفسها، مع إضافة تُحدّثها وخطأ حقل يُعرض:")

            DocsCodeBlock(#"function People() {
  const qc = useQueryClient();
  const { data, isPending, error } = useQuery({ queryKey: ["people"], queryFn: listPeople });
  const add = useMutation({
    mutationFn: createPerson,
    onSuccess: () => qc.invalidateQueries({ queryKey: ["people"] }),
  });
  if (isPending) return <Spinner />;
  if (error) return <Alert>{error.message}</Alert>;
  return (
    <>
      {data.map((p) => <p key={p.id}>{p.name}</p>)}
      <button onClick={() => add.mutate({ name: "Grace" })}>Add</button>
      {add.error?.status === 422 && <p>{add.error.body.errors[0].message}</p>}
    </>
  );
}"#, title: "jsx")

            DocsCodeBlock(#"type Person { id: String, name: String }
type NewPerson { name: String }
type FieldError { field: String, message: String }
type ValidationProblem = Problem { errors: [FieldError] }

enum CreatePersonError {
    unprocessableContent(problem: ValidationProblem) on 422
    http(error: HttpError)
}

api Backend(base: "/api") { }

api Backend.people {
    get list() at "people" -> [Person]!
    post create(body: NewPerson) at "people" -> Person ! CreatePersonError
        invalidates [list]
}

page People(path: "/", title: "People", description: "The team.") {
    state said = ""
    resource people = Backend.people.list()
    Heading("People").h1
    match people {
        .loading { Spinner }
        .failed(e) { Alert(e.message).danger }
        .loaded(list) { for p in list by p.id { Text(p.name) } }
    }
    Button("Add") {
        on click {
            match await Backend.people.create(body: NewPerson(name: "Grace")) {
                .ok(_) { said = "" }
                .err(.unprocessableContent(p)) { said = p.errors.first()?.message ?? "Check the name" }
                .err(.http(e)) { said = e.message }
            }
        }
    }
    Text(said)
}"#, title: "wf")

            Markdown("- **لا مفاتيح للاستعلامات.** القراءة تُعرف بنقطة نهايتها ووسائطها، وقارئان للعنوان نفسه يرسلان طلبًا واحدًا.\n- **الإبطال جزءٌ من العقد**، يُقال مرةً بجانب الكتابة ويُفحص: قراءةٌ ليست في المجموعة خطأ `N05`.\n- **الخطأ مكتوب النوع.** كل حالةٍ يعلنها الخادم حالةٌ في التعداد، و`match` يُسقط واحدةً لا يُبنى.")

        }
        CheatRow("قيمة تتغيّر", theirs: "const [n, setN] = useState(0)", ours: "state n = 0", language: "jsx")
        CheatRow("تغييرها", theirs: "setN(n + 1)", ours: "n = n + 1", language: "jsx")
        CheatRow("قيمة تُحسب من قيم أخرى", theirs: "const total = useMemo(() => sum(items), [items])", ours: "derived total = items.sum()", language: "jsx")
        CheatRow("تأثير جانبي", theirs: "useEffect(() => \{ start(); return () => stop() \}, [id])", ours: "effect \{ start(id)  cleanup \{ stop() \} \}", language: "jsx")
        CheatRow("مقبض على عنصر", theirs: "const box = useRef(null) … box.current.focus()", ours: "Input(bind: q, ref: box) … box.focus()", language: "jsx")
        CheatRow("مكوّن", theirs: "function Card(\{ title \}) \{ … \}", ours: "component Card(_ title: String) \{ … \}", language: "jsx")
        CheatRow("ما يضعه المستدعي في الداخل", theirs: "\{props.children\}", ours: "children", language: "jsx")
        CheatRow("خاصية دالة استدعاء راجع (callback)", theirs: "onChange=\{(v) => setLast(v)\}", ours: "event change(value: Number)، تُعالَج بـon change(value) \{ last = value \}", language: "jsx")
        CheatRow("حقل إدخال متحكَّم به", theirs: "value=\{q\} onChange=\{(e) => setQ(e.target.value)\}", ours: "Input(bind: q, label: \"Search\")", language: "jsx")
        CheatRow("حالة مشتركة بين الصفحات", theirs: "createContext, Redux, Zustand", ours: "store Cart \{ … \}، تُقرأ Cart.items بعد use Cart", language: "jsx")
        CheatRow("مسار", theirs: "<Route path=\"/users/:id\" element=\{<User />\} />", ours: "page User(path: \"/users/:id\", id: String) \{ … \}", language: "jsx")
        CheatRow("إظهار شيء بشرط", theirs: "\{open && <Panel />\}", ours: "if open \{ Panel \}", language: "jsx")
        CheatRow("قائمة", theirs: "\{items.map((i) => <li key=\{i.id\}>\{i.name\}</li>)\}", ours: "for i in items by i.id \{ Text(i.name) \}", language: "jsx")
        CheatRow("الجلب", theirs: "useQuery(\{ queryKey: [\"users\"], queryFn \}) من TanStack Query، أو useEffect مع fetch", ours: "resource users: [User] = http.get(\"/api/users\")، تُقرأ بـmatch users \{ … \}", language: "jsx")
        CheatRow("التنسيق", theirs: "className, CSS modules, Tailwind", ours: "أعلام (Button(\"Save\").primary)، وstyle \{ \} على العنصر، ورموز التصميم", language: "jsx")
        CheatRow("اختبار", theirs: "Testing Library: render, fireEvent.click, getByText", ours: "test \"…\" \{ click \"Save\"  expect \"Saved\" \}", language: "jsx")
    }
}
