// A cheat sheet, written from md-docs/coming-from/latex.md by
// scripts/docsite/comingfrom.py; edit the sheet, not this file.
page ComingFromLatex(path: "/coming-from/latex", title: "WebFluent for LaTeX and Typst authors", description: "LaTeX and Typst ideas in WebFluent: page setup, headings, contents, page breaks, headers and footers, tables, figures, macros and slides.") {
    ComingFromShell("WebFluent for LaTeX and Typst authors", summary: "WebFluent prints PDFs and slide decks from the same language it builds websites with, with no TeX installation and no browser. If you know LaTeX or Typst, the shapes are familiar — a document, headings, a table of contents, page headers and footers — but the layout is the web's: rows, stacks and grids, styled with CSS.", from: "LaTeX / Typst", sheets: [Place(key: "coming.react", to: "/coming-from/react"), Place(key: "coming.vue", to: "/coming-from/vue"), Place(key: "coming.svelte", to: "/coming-from/svelte"), Place(key: "coming.html-css", to: "/coming-from/html-css"), Place(key: "coming.latex", to: "/coming-from/latex")], sections: [Anchor(id: "differences", label: t("coming.differences")), Anchor(id: "port", label: t("coming.port"))], source: "md-docs/coming-from/latex.md") {
        differences {
            Markdown("**The layout is CSS.** A document is laid out from the same HTML and CSS a web page would get: `Row`, `Stack` and `Grid` place things side by side, and a `style \{ \}` block or a `.css` file styles them. There are no TeX boxes and glue to tune.\n\n**Breaking across pages is a rule, not a command.** Paragraphs keep two lines on each side of a break, a heading moves with what follows it, and a table repeats its header row on every page it continues on. Ask for the rest with `break-inside: avoid` and `PageBreak`.\n\n**There is no math typesetting.** A formula is a picture or an SVG you place with `Image`. There is no bibliography system either; references are text you write.\n\n**Arabic and right-to-left work out of the box.** A document whose `lang` is `ar`, `he`, `fa` or `ur` is laid out right to left, and shaping comes with it — no extra packages.\n\n**One source, three outputs.** The page that prints as a PDF can also be a web page, and a `Presentation` is a deck from the same components ([PDF and slides](/docs/guide/pdf-and-slides)).")

        }
        port {
            Markdown("A short report with a footer and a table, in LaTeX and in WebFluent.")

            CodeBlock(#"\documentclass[a4paper]{article}
\usepackage{fancyhdr}
\pagestyle{fancy}
\cfoot{Page \thepage}
\title{Quarterly report}
\author{Acme Studio}
\begin{document}
\maketitle
\section{Sales}
Revenue grew in every region.
\begin{tabular}{lr}
Region & Revenue \\
North & \$2.4M \\
South & \$1.9M \\
\end{tabular}
\end{document}"#, title: "latex")

            CodeBlock(#"page Report(path: "/", title: "Quarterly report", description: "Sales for the quarter.") {
    Document(size: "A4", title: "Quarterly report", author: "Acme Studio") {
        Footer { Text("Page {page} of {pages}").muted.sm.center }
        Heading("Quarterly report").h1
        Text("Acme Studio").muted
        Heading("Sales").h2
        Text("Revenue grew in every region.")
        Table(caption: "Revenue by region") {
            Table.Head { Table.Row { Table.Cell("Region")  Table.Cell("Revenue") } }
            Table.Body {
                Table.Row { Table.Cell("North")  Table.Cell("$2.4M") }
                Table.Row { Table.Cell("South")  Table.Cell("$1.9M") }
            }
        }
    }
}"#, title: "wf")

            Markdown("- **The footer is an element**, drawn on every page, with `page` and `pages` in scope.\n- **The table is the web's table**, broken between rows and with its header repeated when it spans pages.")

        }
        CheatRow("The paper", theirs: "\\documentclass[a4paper]\{article\} / #set page(paper: \"a4\")", ours: "Document(size: \"A4\", margin: \"20mm\") \{ … \}", language: "latex")
        CheatRow("Title and author", theirs: "\\title\{…\}\\author\{…\} / #set document(title: …)", ours: "Document(title: \"Q1 report\", author: \"Acme\")", language: "latex")
        CheatRow("A section", theirs: "\\section\{Results\} / = Results", ours: "Heading(\"Results\").h1", language: "latex")
        CheatRow("A subsection", theirs: "\\subsection\{Method\} / == Method", ours: "Heading(\"Method\").h2", language: "latex")
        CheatRow("A paragraph", theirs: "a blank line between paragraphs", ours: "Text(\"…\"), or Markdown(\"…\") for several", language: "latex")
        CheatRow("Bold and italic", theirs: "\\textbf\{x\}, \\emph\{x\} / *x*, _x_", ours: "Text(\"x\").bold, Text(\"x\").italic, or **x** in Markdown", language: "latex")
        CheatRow("A list", theirs: "itemize / - item", ours: "List \{ List.Item \{ Text(\"…\") \} \}", language: "latex")
        CheatRow("The contents", theirs: "\\tableofcontents / #outline()", ours: "TableOfContents(levels: 2)", language: "latex")
        CheatRow("A new page", theirs: "\\newpage / #pagebreak()", ours: "PageBreak", language: "latex")
        CheatRow("Keep together", theirs: "\\begin\{minipage\} / block(breakable: false)", ours: "style \{ break-inside: avoid \}", language: "latex")
        CheatRow("Headers and footers", theirs: "fancyhdr / #set page(header: …)", ours: "Header \{ … \} … Footer \{ Text(\"Page \{page\} of \{pages\}\") \}", language: "latex")
        CheatRow("A table", theirs: "tabular / #table(…)", ours: "Table \{ Table.Head \{ … \} Table.Body \{ … \} \}", language: "latex")
        CheatRow("A figure", theirs: "\\includegraphics\{chart.png\} / #image(\"chart.png\")", ours: "Image(src: \"/chart.png\", alt: \"…\")", language: "latex")
        CheatRow("A chart", theirs: "pgfplots", ours: "Chart(kind: .bar, data: SALES, x: \"month\", y: \"web\")", language: "latex")
        CheatRow("A macro", theirs: "\\newcommand\{\\price\}[1]\{…\} / #let price(x) = …", ours: "component Price(_ amount: Number) \{ … \}", language: "latex")
        CheatRow("Data", theirs: "\\input\{data\}, datatool / #let data = json(\"data.json\")", ours: "data sales = \"sales.json\", or a const", language: "latex")
        CheatRow("Fonts", theirs: "fontspec / #set text(font: …)", ours: "a .ttf or .otf under fonts/, named in font-family", language: "latex")
        CheatRow("Slides", theirs: "Beamer frames / Touying", ours: "Presentation \{ Slide \{ … \} \}, with \"output_type\": \"slides\"", language: "latex")
        CheatRow("Building", theirs: "pdflatex, latexmk / typst compile", ours: "wf build, with \"output_type\": \"pdf\" in the config", language: "latex")
    }
}
