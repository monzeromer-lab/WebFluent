// A cheat sheet, written from md-docs/coming-from/svelte.md by
// scripts/docsite/comingfrom.py; edit the sheet, not this file.
page ComingFromSvelte(path: "/coming-from/svelte", title: "WebFluent for Svelte developers", description: "Svelte ideas in WebFluent: $state, $derived, $effect, props, snippets, events, bind:, stores, routes, #if and #each, side by side.") {
    ComingFromShell("WebFluent for Svelte developers", summary: "If you write Svelte, WebFluent will feel close: it is also a compiler, state is a plain assignment, and only what reads a changed value updates. What WebFluent adds is a typed markup: every element, prop, flag, event and slot is checked at build time, and the components come designed.", from: "Svelte", sheets: [Place(key: "coming.react", to: "/coming-from/react"), Place(key: "coming.vue", to: "/coming-from/vue"), Place(key: "coming.svelte", to: "/coming-from/svelte"), Place(key: "coming.html-css", to: "/coming-from/html-css"), Place(key: "coming.latex", to: "/coming-from/latex")], sections: [Anchor(id: "the-map", label: t("coming.map")), Anchor(id: "things-that-work-differently", label: t("coming.differences")), Anchor(id: "a-component-ported", label: t("coming.port"))], source: "md-docs/coming-from/svelte.md") {
        differences {
            Markdown("**The elements are typed too.** `svelte-check` types your props and the expressions in your markup; WebFluent also knows every built-in's flags, events and slots. `Button(\"Save\").primray` does not build, and neither does a handler for an event the component does not fire (`E103`).\n\n**Elements come designed.** `Button`, `Card`, `Table`, `Modal` and the rest are built in, with their accessibility work done, and a flag picks a variant (`.primary`, `.lg`). Your own look is a theme of design tokens and a `style \{ \}` on the element.\n\n**Pages own their routes.** There is no `src/routes` folder: each `page` names its `path:`, and the compiler builds the router from every page, ordered by specificity.\n\n**No imports.** Every file under `src/` is part of one program, so a component declared anywhere is usable everywhere.\n\n**Fetching is a value.** A `resource` is read with `match`, and repeats when a state its address reads changes; an `api` block describes a service once, so every call is typed, cached and cancellable.\n\n**The build is the site.** Pre-rendering, code splitting, image resizing and a Content-Security-Policy come from `wf build`; there is no server to run.")

        }
        port {
            Markdown("The same counter, in Svelte and in WebFluent. It starts at a number the caller passes, counts up on a click, shows a badge when the count is even, and tells the caller about each change.")

            CodeBlock(#"<script>
  let { start = 0, onchange } = $props();
  let n = $state(start);
  let even = $derived(n % 2 === 0);
  function inc() { n += 1; onchange?.(n); }
</script>

<div class="row">
  <button onclick={inc}>+</button>
  <span>{n}</span>
  {#if even}<span class="badge">even</span>{/if}
</div>"#, title: "svelte")

            CodeBlock(#"page Scores(path: "/", title: "Scores", description: "A counter that reports each change.") {
    state last = 0
    Heading("Scores").h1
    Counter(start: 2) { on change(value) { last = value } }
    Text("Last change: {last}")
}

component Counter(start: Number = 0) {
    event change(value: Number)
    state n = start
    derived even = n % 2 == 0
    Row(gap: .sm, align: .center) {
        Button("+") { on click { n = n + 1  emit change(n) } }
        Text("{n}")
        if even { Badge("even").info }
    }
}"#, title: "wf")

            Markdown("- **The same reactivity**, spelled `state` and `derived`.\n- **The event is declared**, so a caller's misspelled handler is a build error rather than a prop nobody reads.\n- **No `class`.** `Badge` comes designed, and `.info` is checked.")

        }
        CheatRow("A value that changes", theirs: "let n = $state(0)", ours: "state n = 0", language: "svelte")
        CheatRow("Changing it", theirs: "n += 1", ours: "n = n + 1", language: "svelte")
        CheatRow("A value worked out from others", theirs: "let total = $derived(sum(items))", ours: "derived total = items.sum()", language: "svelte")
        CheatRow("A side effect", theirs: "$effect(() => \{ start(); return stop \})", ours: "effect \{ start()  cleanup \{ stop() \} \}", language: "svelte")
        CheatRow("A handle on an element", theirs: "<input bind:this=\{box\}>", ours: "Input(bind: q, ref: box)", language: "svelte")
        CheatRow("A component", theirs: "a .svelte file", ours: "component Card(_ title: String) \{ … \}", language: "svelte")
        CheatRow("Props", theirs: "let \{ title, tone = \"calm\" \} = $props()", ours: "component Card(_ title: String, tone: Tone = .calm)", language: "svelte")
        CheatRow("What the caller puts inside", theirs: "\{@render children()\}", ours: "children", language: "svelte")
        CheatRow("A snippet the component draws", theirs: "\{@render row(item)\}", ours: "slot row(item: Todo), filled as row(todo) \{ … \}", language: "svelte")
        CheatRow("An event", theirs: "a callback prop, onchange?.(n)", ours: "event change(value: Number), emit change(n)", language: "svelte")
        CheatRow("Two-way binding", theirs: "<input bind:value=\{q\}>", ours: "Input(bind: q, label: \"Search\")", language: "svelte")
        CheatRow("Shared state", theirs: "a store or a .svelte.js module", ours: "store Cart \{ … \}, read as Cart.items after use Cart", language: "svelte")
        CheatRow("A route", theirs: "SvelteKit src/routes/users/[id]/+page.svelte", ours: "page User(path: \"/users/:id\", id: String) \{ … \}", language: "svelte")
        CheatRow("\{#if\}", theirs: "\{#if open\}<Panel />\{:else\}<p>…</p>\{/if\}", ours: "if open \{ Panel \} else \{ Text(\"…\") \}", language: "svelte")
        CheatRow("\{#each\}", theirs: "\{#each items as i (i.id)\}<li>\{i.name\}</li>\{/each\}", ours: "for i in items by i.id \{ Text(i.name) \}", language: "svelte")
        CheatRow("\{#await\}", theirs: "\{#await promise\}…\{:then data\}…\{:catch e\}…\{/await\}", ours: "match users \{ loading \{ … \} ready(list) \{ … \} error(e) \{ … \} \}", language: "svelte")
        CheatRow("A class that follows state", theirs: "class:done=\{todo.done\}", ours: "class: \{ \"done\": todo.done \}", language: "svelte")
        CheatRow("Transitions", theirs: "transition:fade", ours: ".fadeIn, exit: .fadeOut", language: "svelte")
        CheatRow("A test", theirs: "Vitest with Testing Library: render, fireEvent.click, getByText", ours: "test \"…\" \{ click \"Save\"  expect \"Saved\" \}", language: "svelte")
    }
}
