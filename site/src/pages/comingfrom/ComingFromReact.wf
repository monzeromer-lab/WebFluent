// A cheat sheet, written from md-docs/coming-from/react.md by
// scripts/docsite/comingfrom.py; edit the sheet, not this file.
page ComingFromReact(path: "/coming-from/react", title: "WebFluent for React developers", description: "React ideas in WebFluent: state, derived values, effects, props, children, events, context, routing, lists and fetching, side by side.") {
    ComingFromShell("WebFluent for React developers", summary: "Most of what you know from React carries over: components with props, state, a router and shared stores. The difference to hold on to is that WebFluent is a compiler with typed markup, not a library: a component's body runs once, and only the text, attribute or style that reads a changed value updates. There are no hooks, no dependency arrays and no setters.", from: "React", sheets: [Place(key: "coming.react", to: "/coming-from/react"), Place(key: "coming.vue", to: "/coming-from/vue"), Place(key: "coming.svelte", to: "/coming-from/svelte"), Place(key: "coming.html-css", to: "/coming-from/html-css"), Place(key: "coming.latex", to: "/coming-from/latex")], sections: [Anchor(id: "the-map", label: t("coming.map")), Anchor(id: "things-that-work-differently", label: t("coming.differences")), Anchor(id: "a-component-ported", label: t("coming.port"))], source: "md-docs/coming-from/react.md", other: "/ar/coming-from/react") {
        differences {
            Markdown("**It is a compiler, not a library.** There is no virtual DOM and no re-render. Each text, attribute or style that reads a state follows it on its own, and a component's body runs once, when it is placed. That is why there are no hooks and no rules about calling them in order.\n\n**The markup is typed.** The compiler knows the props, flags, events and slots of every built-in and of every component you declare. `Button(\"Save\").primray` does not build, and neither does a handler for an event the component never fires (`E103`). An unknown prop on your own component is `C02`, not a silent pass-through.\n\n**Pages own their routes.** There is no route table. Each `page` names its `path:`, and the compiler builds the router from them, ordered by specificity, so the order you declare pages in cannot hide a route.\n\n**No imports, no npm.** Every file under `src/` is part of one program, so a component declared anywhere is usable everywhere. A JavaScript library is a URL in `meta.scripts`, and your own JavaScript is a plain `.js` file under `src/` whose functions `.wf` code calls by name ([Call your own JavaScript](/recipes/call-your-own-script)).\n\n**The build is the site.** Pre-rendering, code splitting, image resizing, a sitemap, link previews and a Content-Security-Policy come from `wf build`, with no plugins to choose. There is no server rendering on each request: a site is static files and a browser runtime, talking to your API.\n\n**Text is text.** The only way to put markup on a page is `Unsafe.Html(…)`, which the build flags every time, and inline handlers and `javascript:` URLs do not compile ([Security](/about/security)).\n\n**Using it inside a React app.** Publish components as custom elements and place their tags in JSX ([Publish components as custom elements](/recipes/publish-custom-elements)).")

        }
        port {
            Markdown("The same counter, in React and in WebFluent. It starts at a number the caller passes, counts up on a click, shows a badge when the count is even, and tells the caller about each change.")

            CodeBlock(#"function Counter({ start = 0, onChange }) {
  const [n, setN] = useState(start);
  const even = useMemo(() => n % 2 === 0, [n]);
  return (
    <div className="row">
      <button onClick={() => { setN(n + 1); onChange?.(n + 1); }}>+</button>
      <span>{n}</span>
      {even && <span className="badge">even</span>}
    </div>
  );
}"#, title: "jsx")

            CodeBlock(#"page Scores(path: "/", title: "Scores", description: "A counter that reports each change.") {
    state last = 0
    Heading("Scores").h1
    Counter(start: 2) { on change(value) { last = value } }
    Text("Last change: {last}")
}

component Counter(start: Number = 0) {
    event change(value: Number)
    state n = start
    derived even = n % 2 == 0
    Row(gap: .sm, align: .center) {
        Button("+") { on click { n = n + 1  emit change(n) } }
        Text("{n}")
        if even { Badge("even").info }
    }
}"#, title: "wf")

            Markdown("- **No hooks and no dependency arrays.** `derived` knows what it reads.\n- **No setter.** You assign: `n = n + 1`.\n- **No `className`.** `Badge` comes designed, and `.info` is a flag the compiler checks.\n- **The event is declared.** A caller that handles `on chnage` gets `E103` at build time, instead of a handler that never runs.")

        }
        CheatRow("A value that changes", theirs: "const [n, setN] = useState(0)", ours: "state n = 0", language: "jsx")
        CheatRow("Changing it", theirs: "setN(n + 1)", ours: "n = n + 1", language: "jsx")
        CheatRow("A value worked out from others", theirs: "const total = useMemo(() => sum(items), [items])", ours: "derived total = items.sum()", language: "jsx")
        CheatRow("A side effect", theirs: "useEffect(() => \{ start(); return () => stop() \}, [id])", ours: "effect \{ start(id)  cleanup \{ stop() \} \}", language: "jsx")
        CheatRow("A handle on an element", theirs: "const box = useRef(null) … box.current.focus()", ours: "Input(bind: q, ref: box) … box.focus()", language: "jsx")
        CheatRow("A component", theirs: "function Card(\{ title \}) \{ … \}", ours: "component Card(_ title: String) \{ … \}", language: "jsx")
        CheatRow("What the caller puts inside", theirs: "\{props.children\}", ours: "children", language: "jsx")
        CheatRow("A callback prop", theirs: "onChange=\{(v) => setLast(v)\}", ours: "event change(value: Number), handled as on change(value) \{ last = value \}", language: "jsx")
        CheatRow("A controlled input", theirs: "value=\{q\} onChange=\{(e) => setQ(e.target.value)\}", ours: "Input(bind: q, label: \"Search\")", language: "jsx")
        CheatRow("State shared across pages", theirs: "createContext, Redux, Zustand", ours: "store Cart \{ … \}, read as Cart.items after use Cart", language: "jsx")
        CheatRow("A route", theirs: "<Route path=\"/users/:id\" element=\{<User />\} />", ours: "page User(path: \"/users/:id\", id: String) \{ … \}", language: "jsx")
        CheatRow("Showing something conditionally", theirs: "\{open && <Panel />\}", ours: "if open \{ Panel \}", language: "jsx")
        CheatRow("A list", theirs: "\{items.map((i) => <li key=\{i.id\}>\{i.name\}</li>)\}", ours: "for i in items by i.id \{ Text(i.name) \}", language: "jsx")
        CheatRow("Fetching", theirs: "TanStack Query's useQuery(\{ queryKey: [\"users\"], queryFn \}), or useEffect + fetch", ours: "resource users = fetch(\"/api/users\"), read with match users \{ … \}", language: "jsx")
        CheatRow("Styling", theirs: "className, CSS modules, Tailwind", ours: "flags (Button(\"Save\").primary), style \{ \} on the element, design tokens", language: "jsx")
        CheatRow("A test", theirs: "Testing Library: render, fireEvent.click, getByText", ours: "test \"…\" \{ click \"Save\"  expect \"Saved\" \}", language: "jsx")
    }
}
