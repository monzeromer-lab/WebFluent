/// The gallery: every example document and deck, as the PDF `wf build`
/// wrote from it, beside the folder of source that made it. The list is
/// `showcase.json`, which scripts/showcase.py writes on each release.
page Showcase(path: "/showcase", title: "Showcase — WebFluent", description: "Invoices, reports, a résumé in Arabic and slide decks, each a PDF WebFluent built from a folder of source. Open one on your phone, then read what made it.") {
    state shown = "all"
    derived items = showcase.filter(e => shown == "all" || e.kind == shown)

    ShowcaseShell(t("showcase.title"), lede: t("showcase.lede")) {
        filters {
            Button(t("showcase.all"), aria-pressed: shown == "all", class: "bp-button") { on click { shown = "all" } }
            Button(t("showcase.documents"), aria-pressed: shown == "document", class: "bp-button") { on click { shown = "document" } }
            Button(t("showcase.decks"), aria-pressed: shown == "deck", class: "bp-button") { on click { shown = "deck" } }
        }
        for e in items by e.slug {
            ShowcaseTile(e.title, output: if e.kind == "deck" { "slides" } else { "pdf" }, body: e.description, size: e.size, pages: e.pages, picture: e.previews[0] ?? "", alt: t("showcase.firstpage", { title: e.title }), file: e.file, source: e.source, lang: e.lang)
        }
    }
    Stack(class: "bp-wrap") {
        style { padding-bottom: 72px }
        Markdown(t("showcase.more"), class: "bp-small")
    }
}
