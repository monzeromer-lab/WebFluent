/// Places the header and footer already name, whose pages are still being
/// written: each sends the reader to the guide's chapter that holds what it
/// will. A page that takes one of these addresses replaces its redirect.
page InterimLearn(path: "/learn", title: "Learn", description: "The book: start at Getting started.", guard: false, redirect: "/docs/guide/getting-started", noindex: true) {
    Heading(t("nav.learn")).h1
    Link(t("ch.02"), to: "/docs/guide/getting-started")
}

page InterimTour(path: "/learn/01-getting-started", title: "Getting started", description: "The first chapter of the book.", guard: false, redirect: "/docs/guide/getting-started", noindex: true) {
    Heading(t("ch.02")).h1
    Link(t("ch.02"), to: "/docs/guide/getting-started")
}

page InterimAbout(path: "/about", title: "About", description: "Why WebFluent works as it does.", guard: false, redirect: "/docs/guide/introduction", noindex: true) {
    Heading(t("ch.01")).h1
    Link(t("ch.01"), to: "/docs/guide/introduction")
}
