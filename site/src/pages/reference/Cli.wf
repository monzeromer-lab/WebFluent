page CliInit(path: "/reference/cli/init", title: "wf init — Reference", description: "wf init: Create a new WebFluent project. What it writes, and every option it takes.") {
    ReferenceItemShell("wf init", summary: "Create a new WebFluent project", signature: "wf init NAME [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        Markdown(t("cli.writes", { what: "a new project's folder" }), class: "bp-prose")
        // ── words: init ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Creates a new project directory with a config, a `.gitignore`, an `AGENTS.md`, the `writing-webfluent` agent skill (in `.agents/skills/` and `.claude/skills/`) and a small working application.")

            Terminal(lines: [
                    Line(command: "wf init my-site -t static"),
                Line(command: "wf init my-app --locales en,ar")
                ])

            Markdown("With `--locales`, every visible string of the starter goes through `t(\"…\")`, the config's `i18n` names the locales (and `meta.lang` the default), the language switch has one entry for each locale, and `src/translations/` holds a file per locale:\n\n- the default locale's file holds the starter's English, the text its pages and tests are written in;\n- another locale's file holds the starter's own translation where it has one (Arabic), and the same English otherwise, for you to translate.\n\nA locale is a language tag — `en`, `ar`, `pt-BR`, `zh-Hant` — written in any case and stored in the usual one. A tag named twice, an empty list, or a code that is not a tag (`pt_BR`) is refused with what to write instead. A `pdf` document or a `slides` deck is made in one language and refuses `--locales`.\n\n`AGENTS.md` is the language reference — the file a coding agent reads before it changes a project. With it, an assistant asked to add a page writes the WebFluent of the `wf` that made the project, flags and all, instead of guessing. Its first line names the version it describes. The skill points an agent at `AGENTS.md` when the work is WebFluent, in the folders agents look in for one. A newer `wf` writes a newer one, and an older project can take the current one from the [repository](https://github.com/monzeromer-lab/WebFluent/blob/master/AGENTS.md).\n\n`wf init` writes a shorter config than the full set of defaults, and turns `build.csp` on.\n\nSee also: [Translate a site](/recipes/translate-a-site), [Configuration](/reference/config).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "NAME", type: "text", meaning: "Project name" }, { name: "--template, -t TEMPLATE", type: "spa | static | pdf | slides", meaning: "Template: \"spa\" (default), \"static\", \"pdf\", or \"slides\"" }, { name: "--locales, -l LOCALES", type: "text", meaning: "Start it translated: the locales, comma-separated, the default first (\"en,ar\"). Every visible string goes through t(), and src/translations/ holds a file for each. spa and static only" }], caption: "Options of wf init", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliBuild(path: "/reference/cli/build", title: "wf build — Reference", description: "wf build: Build the project: a site or app (HTML, CSS, JS), a PDF, a slide deck or custom elements. What it writes, and every option it takes.") {
    ReferenceItemShell("wf build", summary: "Build the project: a site or app (HTML, CSS, JS), a PDF, a slide deck or custom elements", signature: "wf build [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        Markdown(t("cli.writes", { what: "the site, in the output folder" }), class: "bp-prose")
        // ── words: build ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Runs the whole compiler — parse, semantic checks, type checks, linters and code generation — and writes the site to `build.output` (`./build`).")

            Terminal(lines: [
                    Line(command: "wf build"),
                Line(command: "wf build --format github --deny-warnings")
                ])

            Markdown("**A build stays inside its project.** It reads only the project's own files: a `data`, `image`, `api … from` or `i18n.dir` names a path inside the project (an absolute path or a `..` is an error), and a symbolic link that leads out of the project — or to nothing, or back into a directory above it — is left out of every walk, with a warning naming it. A link that stays inside is followed. It writes only inside its project too: `build.output` is refused when it climbs out (`../site`, `/var/www`) or is a link to somewhere else, and a link already inside the output is refused rather than written through. `--allow-output-outside` is how the person running the build lets it write elsewhere; a project's config cannot ask for it. A build removes only the `.gz` files an earlier build wrote (it keeps their names in `.wf-cache/precompressed.json`); any other `.gz` in the output is left alone.\n\nAn error stops the build and prints the file, line, column, message and a hint. A warning prints and the build goes on.\n\n`--format` takes four values:")

            Table(caption: "wf build") {
                Table.Head {
                    Table.Row {
                        Table.Cell("Value").header
                        Table.Cell("Output").header
                    }
                }
                Table.Body {
                    Table.Row {
                        Table.Cell { Markdown("`human`") }
                        Table.Cell("Rendered findings on standard error.")
                    }
                    Table.Row {
                        Table.Cell { Markdown("`json`") }
                        Table.Cell("One document on standard output: every finding with its code, place, hint, related places and fixes, and the counts.")
                    }
                    Table.Row {
                        Table.Cell { Markdown("`sarif`") }
                        Table.Cell("SARIF 2.1.0, for GitHub code scanning and every other SARIF reader.")
                    }
                    Table.Row {
                        Table.Cell { Markdown("`github`") }
                        Table.Cell { Markdown("`::error file=…` annotations on standard output, which a workflow shows on the pull request; the rendered findings stay on standard error.") }
                    }
                }
            }

            Markdown("With `json` or `sarif`, the build's progress goes to standard error, so standard output holds the document alone.\n\n`--cache` keeps what it renders in `.wf-cache/build/`. A page is taken from the cache when its inputs are unchanged: its own text, every component it reaches, and what every page reads — the shell, the stores, constants and data, every page's title and route, the config, the translations and the compiler. The output is byte for byte what a build without `--cache` writes. A build with nothing to reuse fills the cache, and each build keeps only the entries it used.\n\n`--studio` stamps every element's root with `data-wf-node`, its node id, which is the same in the pre-rendered page and the live one. An instance of one of the project's components also carries `data-wf-call`: the calls that made it, innermost first. `nodes.json`, written beside the site, maps each id to where it is written (file, bytes, line), what it calls, its parent, the loops and branches it is inside, and what its arguments read. A build without `--studio` stamps nothing and removes any `nodes.json` it finds.\n\n`--stats` prints every text file with its gzipped size and how much it changed since the last build, the runtime modules the build kept and what reached each one, and the design tokens it left out.\n\nSee also: [Diagnostics](/errors), [Performance](/about/what-a-build-ships).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "--dir, -d DIR", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--stats", type: "flag", meaning: "Print what the build weighs: every file, gzipped, and the runtime modules it kept and left out" }, { name: "--format FORMAT", type: "human | json | sarif | github", meaning: "How findings are written: `human` (default), `json`, `sarif` (code scanning) or `github` (annotations on a pull request)" }, { name: "--deny-warnings", type: "flag", meaning: "Let a warning stop the build as an error does" }, { name: "--cache", type: "flag", meaning: "Reuse what earlier builds rendered, kept in `.wf-cache/build/`: only the pages an edit changed are rendered again" }, { name: "--studio", type: "flag", meaning: "For an editor's preview: stamp every element with its node id (`data-wf-node`) and write `nodes.json`, from each id to its source" }, { name: "--allow-output-outside", type: "flag", meaning: "Let `build.output` name a directory outside the project; without it a build writes only inside the project" }], caption: "Options of wf build", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliCheck(path: "/reference/cli/check", title: "wf check — Reference", description: "wf check: Check the project — every finding a build would report — and write nothing. What it writes, and every option it takes.") {
    ReferenceItemShell("wf check", summary: "Check the project — every finding a build would report — and write nothing", signature: "wf check [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        // ── words: check ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Runs every check a build runs — the parser, the structure, the types, the lints and the config — and writes nothing.")

            Terminal(lines: [
                    Line(command: "wf check"),
                Line(command: "wf check --format sarif > wf.sarif"),
                Line(command: "wf check --deny-warnings")
                ])

            Markdown("`wf check` is fast enough for a pre-commit hook. It exits `1` on a finding that would stop a build and `0` otherwise, and prints `No problems in NAME.` when there are none. A check that needs the written output — the security policy read back over the pages — runs only in `wf build`.\n\nSee also: [Diagnostics](/errors).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "--dir, -d DIR", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--format FORMAT", type: "human | json | sarif | github", meaning: "How findings are written: `human` (default), `json`, `sarif` (code scanning) or `github` (annotations on a pull request)" }, { name: "--deny-warnings", type: "flag", meaning: "Fail on a warning too" }, { name: "--allow-output-outside", type: "flag", meaning: "Accept a `build.output` outside the project, as `wf build --allow-output-outside` does; without it the check reports what the build would refuse" }], caption: "Options of wf check", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliConfig(path: "/reference/cli/config", title: "wf config — Reference", description: "wf config: Read and change webfluent.app.json: every setting, what the project sets, and an edit that keeps the file's shape. What it writes, and every…") {
    ReferenceItemShell("wf config", summary: "Read and change `webfluent.app.json`: every setting, what the project sets, and an edit that keeps the file's shape", signature: "wf config <schema|get|set|unset>", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "schema", label: "wf config schema"), Anchor(id: "get", label: "wf config get"), Anchor(id: "set", label: "wf config set"), Anchor(id: "unset", label: "wf config unset")], source: "site/src/pages/reference/Cli.wf") {
        // ── words: config ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Reads and changes `webfluent.app.json`, and lists every setting it can hold.")

            Terminal(lines: [
                    Line(command: "wf config schema"),
                Line(command: "wf config schema --json"),
                Line(command: "wf config get build.base_path"),
                Line(command: "wf config set build.ssg true"),
                Line(command: "wf config set meta.lang ar"),
                Line(command: "wf config unset build.ssg")
                ])

            Markdown("`set` checks the value against the setting's type before it writes anything. `set` and `unset` keep the rest of the file as it was written. Under a map, the rest of the path is one key: `build.budget.app.js` sets the `app.js` entry of `build.budget`.\n\nSee also: [Configuration](/reference/config).")

        }
        // ── end of the words ──
        Heading("wf config schema", id: "schema").h2
        Text("Every setting: its type, its default and what it does")
        Code("wf config schema [options]").block
        PropsTable(rows: [{ name: "--json", type: "flag", meaning: "As JSON, for a tool" }], caption: "Options of wf config schema", nameLabel: t("cli.option"))
        Heading("wf config get", id: "get").h2
        Text("What the project sets at PATH, or the default")
        Code("wf config get PATH [options]").block
        PropsTable(rows: [{ name: "PATH", type: "text", meaning: "A dotted path: `build.base_path`, `build.budget.app.js`" }, { name: "--dir, -d DIR", type: "path", meaning: "The project's folder (default `.`)" }], caption: "Options of wf config get", nameLabel: t("cli.option"))
        Heading("wf config set", id: "set").h2
        Text("Set PATH to VALUE — JSON, or a word as a string — keeping the file's shape")
        Code("wf config set PATH VALUE [options]").block
        PropsTable(rows: [{ name: "PATH", type: "text", meaning: "A dotted path: `build.base_path`, `meta.site_url`" }, { name: "VALUE", type: "text", meaning: "The value: JSON (`true`, `3`, `[\"en\", \"ar\"]`), or a word, which is taken as a string" }, { name: "--dir, -d DIR", type: "path", meaning: "The project's folder (default `.`)" }], caption: "Options of wf config set", nameLabel: t("cli.option"))
        Heading("wf config unset", id: "unset").h2
        Text("Remove PATH, so its default applies")
        Code("wf config unset PATH [options]").block
        PropsTable(rows: [{ name: "PATH", type: "text", meaning: "A dotted path: `build.base_path`, `meta.site_url`" }, { name: "--dir, -d DIR", type: "path", meaning: "The project's folder (default `.`)" }], caption: "Options of wf config unset", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliApi(path: "/reference/cli/api", title: "wf api — Reference", description: "wf api: A service's contract as files, from its OpenAPI spec: add one, sync it, check it is current, turn api … from into files, list them. What it…") {
    ReferenceItemShell("wf api", summary: "A service's contract as files, from its OpenAPI spec: add one, sync it, check it is current, turn `api … from` into files, list them", signature: "wf api <add|sync|check|eject|list>", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "add", label: "wf api add"), Anchor(id: "sync", label: "wf api sync"), Anchor(id: "check", label: "wf api check"), Anchor(id: "eject", label: "wf api eject"), Anchor(id: "list", label: "wf api list")], source: "site/src/pages/reference/Cli.wf") {
        // ── words: api ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Writes a service's contract as files from its OpenAPI spec (3.0 or 3.1, JSON or YAML), and keeps them current.")

            Terminal(lines: [
                    Line(command: "wf api add openapi.json --name Backend"),
                Line(command: "wf api sync"),
                Line(command: "wf api sync Backend --skip uploadXml"),
                Line(command: "wf api check"),
                Line(command: "wf api eject Backend"),
                Line(command: "wf api list --json")
                ])

            Markdown("Every generated file opens with a `// Code generated by …` comment that names `wf api sync` and its spec and says DO NOT EDIT, and `sync` never overwrites or removes a file in `generated/` without it. The output is the printer's, so it is the same for the same spec, and a change to the spec is the smallest diff. `wf check` warns (`N07`) when a spec has changed since its files were written. The compiler never fetches: download the spec first (`curl -o openapi.json …`). See [Data and APIs](/learn/15-data#read-the-service-from-an-openapi-file).")

        }
        // ── end of the words ──
        Heading("wf api add", id: "add").h2
        Text("Keep a service read from SPEC: record it in `apis`, write its `service.wf` once, and its `generated/` files")
        Code("wf api add SPEC [options]").block
        PropsTable(rows: [{ name: "SPEC", type: "text", meaning: "The OpenAPI spec, JSON or YAML, a file in the project" }, { name: "--name NAME", type: "text", meaning: "The service's name, as the program calls it (default `Backend`)" }, { name: "--out OUT", type: "text", meaning: "The folder its files go in (default: `src/api/<name>`)" }, { name: "--dir, -d DIR", type: "path", meaning: "The project's folder (default `.`)" }], caption: "Options of wf api add", nameLabel: t("cli.option"))
        Heading("wf api sync", id: "sync").h2
        Text("Rewrite each service's `generated/` from its spec")
        Code("wf api sync [NAME] [options]").block
        PropsTable(rows: [{ name: "[NAME]", type: "text", meaning: "One service (default: every one `apis` keeps)" }, { name: "--skip SKIP", type: "text, repeats", meaning: "Leave an operation out, by its name or `METHOD /path`; kept in the config, so the next sync and `check` leave it out too" }, { name: "--dir, -d DIR", type: "path", meaning: "The project's folder (default `.`)" }], caption: "Options of wf api sync", nameLabel: t("cli.option"))
        Heading("wf api check", id: "check").h2
        Text("Fail when `sync` would change anything: for CI")
        Code("wf api check [NAME] [options]").block
        PropsTable(rows: [{ name: "[NAME]", type: "text", meaning: "One service (default: every one `apis` keeps)" }, { name: "--dir, -d DIR", type: "path", meaning: "The project's folder (default `.`)" }], caption: "Options of wf api check", nameLabel: t("cli.option"))
        Heading("wf api eject", id: "eject").h2
        Text("Turn `api NAME from \"openapi.json\"` into a kept service's files")
        Code("wf api eject NAME [options]").block
        PropsTable(rows: [{ name: "NAME", type: "text", meaning: "The service" }, { name: "--out OUT", type: "text", meaning: "The folder its files go in (default: `src/api/<name>`)" }, { name: "--dir, -d DIR", type: "path", meaning: "The project's folder (default `.`)" }], caption: "Options of wf api eject", nameLabel: t("cli.option"))
        Heading("wf api list", id: "list").h2
        Text("Every service read from a spec: its spec, its folder, its groups and their endpoints")
        Code("wf api list [options]").block
        PropsTable(rows: [{ name: "--json", type: "flag", meaning: "Print JSON, for tools" }, { name: "--dir, -d DIR", type: "path", meaning: "The project's folder (default `.`)" }], caption: "Options of wf api list", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliMotion(path: "/reference/cli/motion", title: "wf motion — Reference", description: "wf motion: The animations an element can play, the eases and speeds, the route transitions and the project's default. What it writes, and every option…") {
    ReferenceItemShell("wf motion", summary: "The animations an element can play, the eases and speeds, the route transitions and the project's default", signature: "wf motion [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        // ── words: motion ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Lists what an element's motion props can name.")

            Terminal(lines: [
                    Line(command: "wf motion"),
                Line(command: "wf motion --json")
                ])

            Markdown("It lists:\n\n- every animation `animate:` and `exit:` take: the engine's, each with its keyframes, the rule its stylesheet plays it by, whether an element leaves with it and whether it repeats; then the project's own `animation` declarations;\n- the named eases, with the timing function each stands for;\n- the three speeds and their lengths;\n- the `Router`'s transitions;\n- the project's default length and pacing (`motion` in the config, or the engine's);\n- `data-wf-motion=\"reduce\"`, the attribute an editor sets on the page's root to show the page as a reader who asked for less motion sees it.\n\nThe library has it as `webfluent::motion::catalogue` (with the `internals` feature, outside semver).\n\nSee also: [Motion defaults](/recipes/motion-defaults).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "--dir, -d DIR", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--json", type: "flag", meaning: "Print JSON, for tools" }], caption: "Options of wf motion", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliContext(path: "/reference/cli/context", title: "wf context — Reference", description: "wf context: What an agent is given: the files, the open file, the problems, the components, the theme, the config with only its public env, the…") {
    ReferenceItemShell("wf context", summary: "What an agent is given: the files, the open file, the problems, the components, the theme, the config with only its public env, the language reference, and what was withheld", signature: "wf context [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        // ── words: context ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Prints what a coding agent working on the project is given, so nothing it is told is hidden from you.")

            Terminal(lines: [
                    Line(command: "wf context"),
                Line(command: "wf context --open src/pages/Home.wf:120-180"),
                Line(command: "wf context --guide full --json")
                ])

            Markdown("It includes:\n\n- every file of the project — not the build's output, `.git/`, dependencies or a `.env` file;\n- the open file and its selection;\n- the problems the build reports;\n- every component a call can name, with its props, cases, events and slots;\n- the theme's tokens;\n- `webfluent.app.json`, with every `env` value that `public_env` does not list withheld;\n- the guide: each chapter's title, blurb and sections to cite (`16 Forms and validation › What a value must be: validate`), or with `--guide full` the chapters whole;\n- what was withheld, and why.\n\nThe library has it as `webfluent::agent::context` (with the `internals` feature, outside semver). An agent's edits go through `webfluent::agent::changeset::ChangeSet`: a layer over the editor's buffers that the compiler builds before anyone reads it. It refuses paths outside the project, in `.git/`, in the build's output and `.env` files; reads the config with its private values withheld and keeps them through a write; and is accepted whole, by file or by hunk. `ChangeSet::edit` makes an agent's anchored edits (`webfluent::agent::edit`): each `old_text` must be found once in a file the set has read — exactly, then ignoring what ends a line, then the indent, then typographic quotes and dashes — and a file that moved under the set since it was read is refused until it is read again. Text found twice names its lines; text found nowhere names the nearest.")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "--dir, -d DIR", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--open OPEN", type: "text", meaning: "The file open in the editor, and its selection as byte offsets: `src/pages/Home.wf` or `src/pages/Home.wf:120-180`" }, { name: "--guide GUIDE", type: "text", meaning: "The language reference (the skill's `references/`) as each file's title and sections (`index`), or whole (`full`) (default `index`)" }, { name: "--json", type: "flag", meaning: "Print JSON, for tools; otherwise one Markdown document" }], caption: "Options of wf context", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliTranslations(path: "/reference/cli/translations", title: "wf translations — Reference", description: "wf translations: The translations as a table: each locale's plural forms and what it lacks, each key's messages, and where a t() names it. What it…") {
    ReferenceItemShell("wf translations", summary: "The translations as a table: each locale's plural forms and what it lacks, each key's messages, and where a `t()` names it", signature: "wf translations [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        // ── words: translations ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Shows the project's translations as a table.")

            Terminal(lines: [
                    Line(command: "wf translations"),
                Line(command: "wf translations --missing ar"),
                Line(command: "wf translations --unused"),
                Line(command: "wf translations --json"),
                Line(command: "wf translations --plurals")
                ])

            Markdown("For each locale it prints its file, whether it is the default and whether it is right to left, the plural forms CLDR's rules give it, how many keys have no message in it, how many lack a form it needs, and how many messages have placeholders the default locale's do not.\n\nA key is unused when nothing names it: no `t()`, no key built at run time that may be it, and no `validate` rule that shows it.\n\n`--json` prints the whole table: every key, plural keys with each form, each message in each locale with its placeholders and line, every place a `t()` names the key, and the calls that name a key no locale has (`I01`).\n\n`--plurals` prints each locale's forms; with `--json`, also the form each of a run of counts takes.\n\nThe library has it as `webfluent::i18n::table` (with the `internals` feature, outside semver), whose `set_message` writes one message back and keeps every other byte of the file.\n\nSee also: [Translate a site](/recipes/translate-a-site).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "--dir, -d DIR", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--missing MISSING", type: "text", meaning: "Only the keys this locale has no message for" }, { name: "--unused", type: "flag", meaning: "Only the keys nothing names" }, { name: "--plurals", type: "flag", meaning: "CLDR's plural rules instead: every locale's forms, and the form each of a run of counts takes" }, { name: "--json", type: "flag", meaning: "Print JSON, for tools" }], caption: "Options of wf translations", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliScope(path: "/reference/cli/scope", title: "wf scope — Reference", description: "wf scope: What a path picker lists at a place: the names in scope there, each with its type and where it comes from, and the fields to go on into. What…") {
    ReferenceItemShell("wf scope", summary: "What a path picker lists at a place: the names in scope there, each with its type and where it comes from, and the fields to go on into", signature: "wf scope PLACE [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        // ── words: scope ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Lists the names that can be read at one place in a source file — what an editor's path picker and completion offer there.")

            Terminal(lines: [
                    Line(command: "wf scope src/pages/Deploys.wf:24"),
                Line(command: "wf scope src/pages/Deploys.wf:24:9 --json"),
                Line(command: "wf scope src/templates/invoice.wf:3 --data data/invoice.json")
                ])

            Markdown("The names come in the order a path picker lists them:\n\n1. the page's or component's own `state` and `derived` values, and the form it binds;\n2. its props, and a page's route parameters;\n3. what the statements around the place bind — a loop's item and index, an `if let`, a `match` arm, a slot's fill, an action's parameters and the `let`s before the place — innermost first;\n4. the members of every store it `use`s;\n5. with `--data`, the template's data.\n\nEach row has its type as the checker infers it, its shape (`bool`, `number`, `text`, `moment`, `list`, `record`, `enum` …), whether it may be `null`, where it comes from (`for d in live`, `member of Deploys`), and a record's fields to go on into (`d.region.code`). The library has it as `webfluent::scope` (with the `internals` feature, outside semver).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "PLACE", type: "text", meaning: "The place: `src/pages/Signup.wf:24` or `…:24:9`" }, { name: "--dir, -d DIR", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--data DATA", type: "path", meaning: "A template's data, a JSON file, to list after the scope" }, { name: "--json", type: "flag", meaning: "Print JSON, for tools" }], caption: "Options of wf scope", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliRules(path: "/reference/cli/rules", title: "wf rules — Reference", description: "wf rules: The rules a validate block may hold, the named patterns, when a form shows its messages, and every state the project holds to a rule. What it…") {
    ReferenceItemShell("wf rules", summary: "The rules a `validate` block may hold, the named patterns, when a form shows its messages, and every state the project holds to a rule", signature: "wf rules [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        // ── words: rules ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Lists what a `validate` block can hold, and every state the project holds to a rule.")

            Terminal(lines: [
                    Line(command: "wf rules"),
                Line(command: "wf rules --json")
                ])

            Markdown("It lists:\n\n- every rule: what it takes between its parentheses, when it holds, the message it shows when none is written, the translation key (`form.minLength`) that replaces that message in a translated project, whether an empty value passes it, and whether it is checked last;\n- the bounds a refined type implies (`below`, `after`, `before`);\n- the patterns people often write, by name, each with its expression and a message;\n- `Form(show:)`'s cases, in the reader's terms;\n- `data-wf-validation=\"shown\"`, the attribute a preview sets on the page's root to show every message at once;\n- every state the project holds to a rule, with its rules in order (those its type implies first) and whether the page checks them as the reader types.\n\nThe library has it as `webfluent::validation` (with the `internals` feature, outside semver).\n\nSee also: [Forms](/learn/14-forms).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "--dir, -d DIR", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--json", type: "flag", meaning: "Print JSON, for tools" }], caption: "Options of wf rules", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliTheme(path: "/reference/cli/theme", title: "wf theme — Reference", description: "wf theme: The theme the build uses: every token, declared or inherited, where each is used, and its contrast pairs. What it writes, and every option it…") {
    ReferenceItemShell("wf theme", summary: "The theme the build uses: every token, declared or inherited, where each is used, and its contrast pairs", signature: "wf theme [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        // ── words: theme ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Shows the theme the build uses, as an editor's theme panel shows it.")

            Terminal(lines: [
                    Line(command: "wf theme"),
                Line(command: "wf theme --json")
                ])

            Markdown("It lists every token by group (colour, spacing, font size, line height, radius, shadow, transition, font, motion, and the tokens the theme adds) with its value, the baseline's value, whether the theme declares or inherits it, the dark theme's value when `theme.dark` names one, the properties that draw from it, and every place the project names it. It then lists the colour pairings the stylesheet composes, with their contrast and what WCAG AA asks of each — a pairing that falls short is the `A13` the build reports — and the tokens one theme of the dark pair declares and the other does not.\n\nSee also: [Design tokens](/reference/tokens).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "--dir, -d DIR", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--json", type: "flag", meaning: "Print JSON, for tools" }], caption: "Options of wf theme", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliComponents(path: "/reference/cli/components", title: "wf components — Reference", description: "wf components: Every component a call can name — the built-ins and the project's — with what each takes: its props and their kinds, events, slots…") {
    ReferenceItemShell("wf components", summary: "Every component a call can name — the built-ins and the project's — with what each takes: its props and their kinds, events, slots, parts and children", signature: "wf components [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        // ── words: components ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Lists every component a call can name — the built-ins first, then the project's own — in one vocabulary.")

            Terminal(lines: [
                    Line(command: "wf components"),
                Line(command: "wf components --json")
                ])

            Markdown("For each prop it gives the kind of value it takes (`text`, `number`, `enum` and its cases, `file` and what kind, `state`, `path`, a declared `record`, a `list`, `date`, `color`, `money` …), whether it is the positional one, its default as written, a range where its type declares one (`Number(0..=100)`), and whether `.name` alone sets it. Then it gives the component's events, its slots and what each hands its fill, its parts and their owner, the attribute families its root takes, and whether it takes children.\n\nThis is the table the checker reads a call against. An inspector draws a control per prop from it, and an Insert panel knows what may go where. The library has it as `webfluent::registry::schema::of_project_via` (with the `internals` feature, outside semver).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "--dir, -d DIR", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--json", type: "flag", meaning: "Print JSON, for tools" }], caption: "Options of wf components", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliAssets(path: "/reference/cli/assets", title: "wf assets — Reference", description: "wf assets: What public/ holds — each file's kind, size and dimensions, and where the project names it — or what the media pipeline will make of one…") {
    ReferenceItemShell("wf assets", summary: "What `public/` holds — each file's kind, size and dimensions, and where the project names it — or what the media pipeline will make of one image", signature: "wf assets [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        // ── words: assets ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Lists every file of `public/` and where the project uses it, or what the image pipeline makes of one picture.")

            Terminal(lines: [
                    Line(command: "wf assets"),
                Line(command: "wf assets --unused"),
                Line(command: "wf assets --plan /hero.png"),
                Line(command: "wf assets --json")
                ])

            Markdown("For each file it prints its kind (image, font, video, audio, document, code, data), its size, a picture's dimensions, and every place the project names it: a prop the registry types as a file (`Image`'s `src`, `Video`'s `poster` and `captions`), a page's `image:`, a `const`, an `image` declaration, a `data` file's strings, a value in `webfluent.app.json`, a stylesheet's `url(…)`, a project script, or a manifest. A file a browser or a host asks for by name — `favicon.ico`, `robots.txt`, `.well-known/…` — counts as used. Anything else nothing names counts as unused.\n\n`--plan PATH` applies the project's `build.media` to one picture: each width it writes, in each format, with the file's name and size — for example *3 widths × 1 format · 3 files · about 84 kB*. A size is exact once `wf build` has written the file (it is read from `.wf-cache/media/`), or when the picture is small enough to encode on the spot. Otherwise it is estimated from strips of the picture encoded at that width, and says `about`. The plan names a format the build cannot write, with the reason, and a width it skips because the file would be no smaller than the original. With `--json`, the same sentences are in the `said` field.\n\nThe library has the same as `webfluent::build::assets::\{list, plan\}`. It reads through a `Vfs`, so an editor's unsaved buffers count.\n\nSee also: [Add a picture](/recipes/add-a-picture).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "--dir, -d DIR", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--plan PATH", type: "text", meaning: "What the pipeline will make of this image of `public/`: `/hero.png`" }, { name: "--unused", type: "flag", meaning: "Only the files nothing names" }, { name: "--json", type: "flag", meaning: "Print JSON, for tools" }], caption: "Options of wf assets", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliCommands(path: "/reference/cli/commands", title: "wf commands — Reference", description: "wf commands: Every wf command, its options and what it writes, as data. What it writes, and every option it takes.") {
    ReferenceItemShell("wf commands", summary: "Every `wf` command, its options and what it writes, as data", signature: "wf commands [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        // ── words: commands ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Describes every `wf` command as data.")

            Terminal(lines: [
                    Line(command: "wf commands"),
                Line(command: "wf commands --json")
                ])

            Markdown("For each command it gives what the command does, each option — its flag, what it takes (`nothing` for a flag, a `word` from the values it lists, a `number`, a `path`, `text`) and its default — what the command writes, and the flag that shows it first and writes nothing (`fmt --check`, `migrate --check`, `fix --dry-run`). Build a tool page, a command palette or a script from this output instead of from a copy of this chapter. The library has the same as `webfluent::commands` (with the `internals` feature, outside semver).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "--json", type: "flag", meaning: "Print JSON, for tools" }], caption: "Options of wf commands", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliFix(path: "/reference/cli/fix", title: "wf fix — Reference", description: "wf fix: Fix every finding that has a fix — or every one of a code — as wf check and the editor offer it, and say what is left. What it writes, and…") {
    ReferenceItemShell("wf fix", summary: "Fix every finding that has a fix — or every one of a code — as `wf check` and the editor offer it, and say what is left", signature: "wf fix [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        Markdown(t("cli.writes", { what: "the project's source files" }), class: "bp-prose")
        Markdown(t("cli.preview", { flag: "--dry-run" }), class: "bp-prose")
        // ── words: fix ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Applies every fix the compiler is certain of — the fix the editor offers first — and writes the files.")

            Terminal(lines: [
                    Line(command: "wf fix"),
                Line(command: "wf fix --code V07"),
                Line(command: "wf fix --dry-run")
                ])

            Markdown("A fix that overlaps another, or that the first fixes make way for, is taken on a second pass, and passes repeat until nothing more changes. `wf fix` then lists what is left: findings with no certain fix, which a person decides. `wf check` lists them too.\n\nSee also: [Diagnostics](/errors).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "--dir, -d DIR", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--code CODE", type: "text", meaning: "Only this code's findings: `V01`, `A01`" }, { name: "--dry-run", type: "flag", meaning: "Write nothing; say what would change" }], caption: "Options of wf fix", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliExplain(path: "/reference/cli/explain", title: "wf explain — Reference", description: "wf explain: What a diagnostic code means, a program that draws it, and the fix; with no code, every code. What it writes, and every option it takes.") {
    ReferenceItemShell("wf explain", summary: "What a diagnostic code means, a program that draws it, and the fix; with no code, every code", signature: "wf explain [CODE] [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        // ── words: explain ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Prints a diagnostic code's entry from [Diagnostics](/errors) in the terminal.")

            Terminal(lines: [
                    Line(command: "wf explain T05"),
                Line(command: "wf explain")
                ])

            Markdown("An entry says what the code means, shows a program that draws it, what the compiler prints, the fix, and the link to the guide.")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "[CODE]", type: "text", meaning: "The code: `T05`, `A01`, `E101`" }, { name: "--json", type: "flag", meaning: "Print JSON, for tools: one code, or every code without one" }], caption: "Options of wf explain", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliServe(path: "/reference/cli/serve", title: "wf serve — Reference", description: "wf serve: Start the development server. What it writes, and every option it takes.") {
    ReferenceItemShell("wf serve", summary: "Start the development server", signature: "wf serve [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        Markdown(t("cli.writes", { what: "the site, in the output folder, on every save" }), class: "bp-prose")
        // ── words: serve ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Runs the development server: it builds once, serves the output, and rebuilds and reloads on every save.")

            Terminal(lines: [
                    Line(command: "wf serve"),
                Line(command: "wf serve --host 0.0.0.0     # a phone on this network, at the address it prints")
                ])

            Markdown("The server listens on `dev.port` (3000), on `127.0.0.1`: nothing else on the network can reach it unless `--host` says so. It watches `src/`, `public/` and the config, rebuilds on a change, and reloads every open tab. Each rebuild is a `wf build --cache`, so only the pages the change reached are rendered again.\n\nIt serves the build and nothing beside it: an address that climbs out (`/../`, written plainly or as `%2e%2e`), holds a backslash or a NUL, or reaches a link out of the build is a `404`. It answers only a request whose `Host` is a name it is reached by — `localhost`, an address written as numbers, the `--host` it was given, and with `--host 0.0.0.0` a `.local` name — so a page on another site cannot point a name of its own at this machine and read the build (DNS rebinding); any other gets a `421`. It answers several requests at once, streams files rather than reading them whole, and compresses a file once until it changes.\n\nWhen a build fails, the last good page stays up and the error is drawn over it — file, line, message and hint — until a save fixes it. The overlay is served at `/__wf/dev.js`, and the build's state, as JSON, at `/__wf/status`.\n\nEvery page the server sends also carries a **stores** button. It shows what each store holds, a log of every action with the state on each side of it, and lets you put a store back to before an action ran ([Stores](/learn/11-stores#looking-at-one-while-it-runs)). The service worker of an offline site is removed under `wf serve`, so an edit is never hidden behind its cache.\n\nA request that is not a navigation — an `http` or `api` call, a script, an image — for a file the build did not write gets a `404`, as a host would send, and a line in the terminal naming the file. Only a navigation gets the single-page shell. (Answering a missing API with the shell's HTML makes the page fail to parse it, far from the cause.)\n\nA build under `wf serve` is a *development build*, and it adds these checks to the running page:\n\n- The body of each status an endpoint's error enum names is held to the type its case carries. (A response's declared type — `resource users: [User] = …`, an endpoint's `-> User!` — is held in every build, served or deployed: one that does not match fails as `.decode(at, message)`, naming the place, `$[1].name is missing`.)\n- A route no page answers (and no `path: \"*\"` page catches) shows a `404` box saying so. A deployed page shows nothing.\n- An item of a `for` that throws shows where it is and what it threw, and the rest of the list draws. On a deployed page the item leaves a gap and the console says why.\n- An effect that changes what it reads every time it runs is stopped after a hundred runs, with a warning, instead of overflowing the stack. A deployed page stops it too, silently.\n\nSee also: [`dev` in Configuration](/reference/config#dev).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "--dir, -d DIR", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--host HOST", type: "text", meaning: "The address to listen on: this machine only by default; `0.0.0.0` lets a phone on the same network reach it" }, { name: "--allow-output-outside", type: "flag", meaning: "Let `build.output` name a directory outside the project" }], caption: "Options of wf serve", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliStart(path: "/reference/cli/start", title: "wf start — Reference", description: "wf start: Serve a built project as a host would: $PORT, the build's headers and compressed files, a single-page build's shell for every route, and…") {
    ReferenceItemShell("wf start", summary: "Serve a built project as a host would: `$PORT`, the build's headers and compressed files, a single-page build's shell for every route, and `--proxy` for an API elsewhere", signature: "wf start [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        // ── words: start ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Serves what `wf build` wrote, as a host would. It builds nothing: run `wf build` first.")

            Terminal(lines: [
                    Line(command: "wf build && wf start"),
                Line(command: "PORT=8080 wf start --proxy /api=http://localhost:9000/api")
                ])

            Markdown("What it sends:\n\n- **The files of the build,** each with the `.gz` beside it when the client takes gzip, and the headers the build's `_headers` file names for its path (the content security policy, the frame rule). A page is `no-cache`; a file whose name carries its hash is cached for a year.\n- **A navigation the build wrote no file for** gets a static build's `404.html` with a `404`, or a single-page build's shell, which draws the route itself. A script, a picture or an API call for a file the build did not write gets a `404`, never the shell.\n- **A request under a `--proxy` prefix** goes to the server behind it, its method, headers and body as sent, and its answer comes back as that server gave it. A page calls its own origin (`api Backend(base: \"/api\")`), so the policy needs nothing added and there is no CORS, and the API's address is chosen where the site starts, not when it was built:\n\n  ```json\n  \{ \"scripts\": \{ \"build\": \"wf build\", \"start\": \"wf start --proxy /api=$API_BASE_URL/api\" \} \}\n  ```\n\n  It speaks HTTP/1.1 to the server behind it, over TLS for an `https://` URL, and trusts what this machine trusts: its certificate store, and the certificates `SSL_CERT_FILE` or `NODE_EXTRA_CA_CERTS` names — a company's own authority, or a development one such as Caddy's or mkcert's. A certificate nothing vouches for is refused, with a `502` that says so.\n\nIt is a small server for a container, a preview or an app that serves itself. Behind a CDN or a static host, upload `build/` instead ([Deploy to GitHub Pages](/recipes/deploy-to-github-pages)).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "--dir, -d DIR", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--port PORT", type: "number", meaning: "The port (default: `$PORT`, else 3000)" }, { name: "--host HOST", type: "text", meaning: "The address to listen on (default: every interface)" }, { name: "--proxy PREFIX=URL", type: "text, repeats", meaning: "Forward requests under a path to another server, the path replaced by the URL: `--proxy /api=https://api.example.com` (repeatable; http or https)" }, { name: "--allow-output-outside", type: "flag", meaning: "Let `build.output` name a directory outside the project" }], caption: "Options of wf start", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliInspect(path: "/reference/cli/inspect", title: "wf inspect — Reference", description: "wf inspect: One page as a reader meets it, as text: landmarks, headings, links, buttons, fields, tables, and anything that failed. What it writes, and…") {
    ReferenceItemShell("wf inspect", summary: "One page as a reader meets it, as text: landmarks, headings, links, buttons, fields, tables, and anything that failed", signature: "wf inspect TARGET [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        Markdown(t("cli.writes", { what: "a screenshot, with `--screenshot`" }), class: "bp-prose")
        // ── words: inspect ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Opens one page in a headless Chrome and prints it as a reader meets it, in text.")

            Terminal(lines: [
                    Line(command: "wf inspect /"),
                Line(command: "wf inspect /pokemon/pikachu --mobile --screenshot"),
                Line(command: "wf inspect http://localhost:3000/settings"),
                Line(command: "wf inspect /tasks --do 'type \"Milk\" into \"New task\"' --do 'click \"Add\"'")
                ])

            DocsCodeBlock(#"/ — "Dashboard" (en) at 1280×800
  link "Skip to content" → #wf-main
  navigation "Main"
    link "Dashboard" → / [current=page]
    link "Tasks" → /tasks
    button "Log in"
  main
    h1 Dashboard
    "Welcome to your dashboard."
    checkbox "Learn WebFluent"
no problems: nothing threw, logged an error or failed to arrive"#, title: "text")

            Markdown("A route is the project's build, served for the moment; a URL is a server already running (`wf serve`, `wf start`, anything). Each line is one thing a reader meets, indented under the landmark or list it is in: a heading (`h1 …`), a link and where it goes, a button or other control with its name and states (`[pressed]`, `[expanded]`, `[disabled]`, `[current=page]`), a field with its label and value, a table's caption and first rows, a list's first items, a picture's `alt` (or `(no alt)`, or `[broken]`), and text in quotes. What is hidden — `display: none`, `hidden`, `inert`, a closed dialog — is left out, as a reader never meets it.\n\nWith `--do`, the steps are played first, in order, finding what they name as a test does (a button's text, a field's label), and the outline is the page as it stands after them. A step that cannot be played — nothing called that, an `expect` whose text is not there — is the first problem, and the steps after it are not played.\n\nLast come the problems: what threw, what was logged as an error, and what failed to arrive. It exits `0` either way: it reports, `wf verify` judges.")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "TARGET", type: "text", meaning: "A route of the project's build (`/pokemon/pikachu`), or a URL of a server already running" }, { name: "--dir, -d DIR", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--proxy PREFIX=URL", type: "text, repeats", meaning: "Forward requests under a path to another server, as `wf start` does" }, { name: "--width WIDTH", type: "number", meaning: "The window's width, in CSS pixels (default `1280`)" }, { name: "--height HEIGHT", type: "number", meaning: "The window's height, in CSS pixels (default `800`)" }, { name: "--mobile", type: "flag", meaning: "A phone: 390×844, laid out as a phone lays it out" }, { name: "--screenshot FILE", type: "path", meaning: "Also save a PNG of the page (to FILE, or a file it names)" }, { name: "--full-page", type: "flag", meaning: "The whole page in the screenshot, not only the window" }, { name: "--wait MS", type: "number", meaning: "The most milliseconds the page is given to settle (default `5000`)" }, { name: "--lines LINES", type: "number", meaning: "The most lines of outline it prints (default `400`)" }, { name: "--do STEP", type: "text, repeats", meaning: "A step to play before the page is read, as a test writes it: `click \"Name\"`, `type \"pika\" into \"Search\"`, `press \"Enter\"`, `expect \"Saved\"` (repeatable, in order)" }, { name: "--fakes FILE", type: "path", meaning: "Build the site with these fakes answering its endpoints, as `wf verify --fakes` does, and open that" }, { name: "--json", type: "flag", meaning: "Print JSON, for tools" }, { name: "--allow-output-outside", type: "flag", meaning: "Let `build.output` name a directory outside the project" }], caption: "Options of wf inspect", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliGenerate(path: "/reference/cli/generate", title: "wf generate — Reference", description: "wf generate: Generate a new page, component, or store — or a block, a whole page to own: sign-in, pricing, dashboard, settings. What it writes, and…") {
    ReferenceItemShell("wf generate", summary: "Generate a new page, component, or store — or a block, a whole page to own: sign-in, pricing, dashboard, settings", signature: "wf generate KIND NAME [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        Markdown(t("cli.writes", { what: "a new source file" }), class: "bp-prose")
        // ── words: generate ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Writes a starter page, component or store.")

            Terminal(lines: [
                    Line(command: "wf generate page Pricing"),
                Line(command: "wf generate component PriceCard"),
                Line(command: "wf generate store Cart")
                ])

            Markdown("A page gets a path from its name (`/pricing`), a title, a description and an `h1`. The file is `.wfx` when the project is written in that layout.\n\n`wf generate block NAME` writes a whole page instead — `sign-in` (a form that checks what is typed), `pricing` (three plans, monthly or yearly), `dashboard` (figures, a trend and a table) or `settings` (a profile, notifications and the account, in tabs) — into `src/pages/`. It is ordinary source, the project's own to change; it builds with nothing to report. `wf generate` never overwrites a file: when one exists, it says so and writes nothing.")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "KIND", type: "page | component | store | block", meaning: "What to generate: page, component, store, or block" }, { name: "NAME", type: "text", meaning: "Name of the item to generate; for a block, which: sign-in, pricing, dashboard or settings" }, { name: "--dir, -d DIR", type: "path", meaning: "Project directory (default: current directory)" }], caption: "Options of wf generate", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliRender(path: "/reference/cli/render", title: "wf render — Reference", description: "wf render: Render a .wf template with JSON data. What it writes, and every option it takes.") {
    ReferenceItemShell("wf render", summary: "Render a .wf template with JSON data", signature: "wf render TEMPLATE [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        Markdown(t("cli.writes", { what: "the file `--output` names" }), class: "bp-prose")
        // ── words: render ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Renders one template with JSON data, to HTML, a PDF or a slide deck.")

            Terminal(lines: [
                    Line(command: "wf render invoice.wf --data invoice.json -f pdf -o invoice.pdf"),
                Line(command: "echo '\{\"name\":\"Ada\"\}' | wf render greeting.wf"),
                Line(command: "wf render templates/ --page Receipt --lang ar --data receipt.json")
                ])

            Markdown("A template is held to the same checks as a build: a component nothing declares, or a flag a component does not take, stops the render. The one difference is that the names a template reads come from its data.\n\nSee also: [Render a template](/recipes/render-a-template).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "TEMPLATE", type: "path", meaning: "Template file (.wf or .wfx), or a directory: every template under it as one, components shared" }, { name: "--data DATA", type: "path", meaning: "JSON data file (reads stdin if omitted)" }, { name: "--format, -f FORMAT", type: "html | html-fragment | pdf | slides", meaning: "Output format: \"html\" (default), \"html-fragment\", \"pdf\", or \"slides\"" }, { name: "--output, -o OUTPUT", type: "path", meaning: "Output file (stdout if omitted)" }, { name: "--theme THEME", type: "text", meaning: "Which `Theme` declared in the template to render with. Only needed when the template declares more than one" }, { name: "--token NAME=VALUE", type: "text, repeats", meaning: "A design token over the theme's, `NAME=VALUE`; may be given more than once" }, { name: "--page PAGE", type: "text", meaning: "The page to render, by name, when the template has several" }, { name: "--lang LANG", type: "text", meaning: "The document's language, `<html lang>` (default: the page's `lang:`, else `en`)" }], caption: "Options of wf render", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliMigrate(path: "/reference/cli/migrate", title: "wf migrate — Reference", description: "wf migrate: Carry a project forward: WebFluent 2 → 3, 3 → 4, 4 → 4.2 and 6 → 7, each step that applies. What it writes, and every option it takes.") {
    ReferenceItemShell("wf migrate", summary: "Carry a project forward: WebFluent 2 → 3, 3 → 4, 4 → 4.2 and 6 → 7, each step that applies", signature: "wf migrate [PATH] [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        Markdown(t("cli.writes", { what: "the project's source files" }), class: "bp-prose")
        Markdown(t("cli.preview", { flag: "--check" }), class: "bp-prose")
        // ── words: migrate ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Carries a project written for an older WebFluent forward.")

            Terminal(lines: [
                    Line(command: "wf migrate --check"),
                Line(command: "wf migrate"),
                Line(command: "wf migrate --wfx")
                ])

            Markdown("`wf migrate` makes four passes, in this order:\n\n1. **4.1 → 4.2**, first, because 4.2 refuses `external`. A remote module becomes a `meta.scripts` entry. A local one becomes a plain script under `src/`, with its signatures as JSDoc, and `X.f(…)` becomes `f(…)`. An `external element` call becomes `Element(\"tag\", …)`. The pass lists every `.js` already under `src/`, since each now ships on every page.\n2. **2 → 3** rewrites every `.wf` under `src/` in place, with a note for anything that needed a decision. It changes spelling only: the migrated project builds to what it built before.\n3. **3 → 4** changes what the compiler allows, so it runs over the project rather than the files. It adds every `env` name your pages already read to `public_env`, which preserves what the project did, and prints the list, because *public* means anyone who opens the site may read the value. It then names, with file and line, everything 4 refuses that 3 allowed: an `on*` attribute, a `javascript:` or `data:` URL. Those have no automatic rewrite, because the old value was a string of JavaScript or a link that ran one. Finally it lists the changes that need no edit: a store is built on first read rather than at boot, a `persist` value follows the site's other tabs, and `WF.store`/`WF.host` were renamed.\n4. **6 → 7** applies every fix the findings 7.0 brings carry — the request forms 6.x had (`N08`), what each declaration holds, returns and fails with (`T25`, `T26`, `N03`, `T32`, `T31`), the comparison a condition meant (`T29`), a splice or a unit (`T34`) — until nothing is left to fix, then lists every error a person decides, by place, and the changes that need no edit. With `--check` it says what it would fix and writes nothing.\n\nSee also: [Upgrading](/errors/upgrading).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "[PATH]", type: "path", meaning: "Project directory (default: current directory), or one .wf file" }, { name: "--check", type: "flag", meaning: "Report what would change without writing anything" }, { name: "--stdout", type: "flag", meaning: "Print the migrated text of one file to stdout instead of writing it" }, { name: "--wfx", type: "flag", meaning: "Write the migrated files in the indented layout, as `.wfx`" }], caption: "Options of wf migrate", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliDocs(path: "/reference/cli/docs", title: "wf docs — Reference", description: "wf docs: Document the project's components as a site, each example drawn live. What it writes, and every option it takes.") {
    ReferenceItemShell("wf docs", summary: "Document the project's components as a site, each `example` drawn live", signature: "wf docs [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        Markdown(t("cli.writes", { what: "a gallery, in the folder `--out` names" }), class: "bp-prose")
        // ── words: docs ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Documents the project's components as a site, in the design of this reference.")

            Terminal(lines: [
                    Line(command: "wf docs"),
                Line(command: "wf docs -o component-docs")
                ])

            Markdown("A page a component: its `///` comment and header, every [`example`](/learn/10-components#document-it) of it drawn live beside its source — in a frame of the project's own build, with its theme, stylesheets and scripts — then its props (type, what it is when left out, each prop's `///`), events, slots, parts and what places it. A component with no example is drawn from its props. The types, stores and pages each have a page.\n\nThe project is checked first, and an error stops it, as a build does. Serve the folder to read it. A second run clears what the first wrote; a folder it did not write is left alone.")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "--dir, -d DIR", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--out, -o OUT", type: "path", meaning: "Where to write the site (default: docs/)" }], caption: "Options of wf docs", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliTest(path: "/reference/cli/test", title: "wf test — Reference", description: "wf test: Run the project's test \"…\" \{ … \} declarations under tests/. What it writes, and every option it takes.") {
    ReferenceItemShell("wf test", summary: "Run the project's `test \"…\" \{ … \}` declarations under tests/", signature: "wf test [PATH] [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        Markdown(t("cli.writes", { what: "the snapshots, with `--update`" }), class: "bp-prose")
        // ── words: test ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Runs the project's `test \"…\" \{ \}` declarations.")

            Terminal(lines: [
                    Line(command: "wf test"),
                Line(command: "wf test tests/cart.wf"),
                Line(command: "wf test --update")
                ])

            Markdown("`wf test` runs every test under `tests/` (and in `src/`), or the tests in one file. A test that clicks or types runs in headless Chrome, on a page that links the project's scripts.\n\nSee also: [Testing](/learn/16-testing).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "[PATH]", type: "path", meaning: "Project directory (default: current directory), or one test file" }, { name: "--update", type: "flag", meaning: "Rewrite every snapshot with the current render" }], caption: "Options of wf test", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliAudit(path: "/reference/cli/audit", title: "wf audit — Reference", description: "wf audit: What this project trusts: markup it did not write, other origins, what it keeps on the reader's machine, its env names, its policy and its…") {
    ReferenceItemShell("wf audit", summary: "What this project trusts: markup it did not write, other origins, what it keeps on the reader's machine, its `env` names, its policy and its dependencies", signature: "wf audit [PATH] [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        // ── words: audit ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Prints what a security review asks about the project. It reports and never fails.")

            Terminal(lines: [
                    Line(command: "wf audit"),
                Line(command: "wf audit --json")
                ])

            Markdown("The report lists:\n\n- every `Unsafe.*` and whether its input is sanitised;\n- the project's own scripts and what each declares;\n- every other origin the pages load from;\n- everything kept on the reader's machine;\n- every `env` name and whether it is public;\n- the policy the build ships;\n- what the compiler depends on.\n\nSee also: [Review a site's security](/recipes/review-security) and [Security](/about/security).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "[PATH]", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--json", type: "flag", meaning: "Print JSON, for tools" }], caption: "Options of wf audit", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliVerify(path: "/reference/cli/verify", title: "wf verify — Reference", description: "wf verify: Load every page of a built project in a real browser: errors, failed requests, paint timing, and which built-ins it drew. What it writes…") {
    ReferenceItemShell("wf verify", summary: "Load every page of a built project in a real browser: errors, failed requests, paint timing, and which built-ins it drew", signature: "wf verify [PATH] [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        // ── words: verify ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Loads every page of a built project in a real browser and reports what went wrong there.")

            Terminal(lines: [
                    Line(command: "wf build && wf verify")
                ])

            Markdown("Chrome runs with its sandbox. Where it cannot start with one (a container that gives it none) it is started again without, and `wf verify` says so; `WF_CHROME_NO_SANDBOX=1` skips the first try. Its profile is a private directory with a name nobody can guess, and the browser and the profile go when `wf verify` or `wf test` ends — however it ends, a signal included.\n\n`wf build` reports what the compiler wrote; `wf verify` reports what a browser does with it. It builds nothing: it starts a headless Chrome, serves what `wf build` wrote, and opens every route the project has — a `:param` route at each value its `paths:` names, or at a placeholder (`/user/1`) when it names none.\n\nA route fails on any of these:\n\n- an uncaught exception or a `console.error`;\n- a file that did not arrive (a request the build has no file for is a `404`, not the page shell);\n- an image that failed to load;\n- a router that drew nothing into `<main>`;\n- a page that rendered no text.\n\nThe report prints one line per route:")

            DocsCodeBlock(#"  16 route(s) in http://127.0.0.1:39785
    ok   /                                    236ms     613 nodes    447.0 kB   11 req
    ok   /app/deployments                      68ms     657 nodes    360.6 kB   10 req

  16 page(s), 0 problem(s)"#, title: "text")

            Markdown("The columns are the first contentful paint, the number of elements in the document once it settled, the bytes the page fetched, and the requests it made. `--budget 400` fails a route that takes longer than 400 ms to paint.\n\n`--returning-visitor` visits every route a second time as a reader who was here before. Their storage holds what the previous build's pages kept: each `persist` value's starting value as the build before this one wrote it, which a build saves in `.wf-cache/` when it changes. A persisted shape that changed without a `version:` then shows as the broken page it would be.\n\n`--fakes tests/fakes.wf` is for a site whose API is elsewhere, or not running. It builds the project again, aside from `build/`, with the fakes that file declares answering every endpoint — the same `fake` declarations a test names ([Testing](/learn/16-testing#answer-a-service-with-fakes)) — and loads every page of that build, which sends no request to a service. A fake that does not fit its contract stops the build (`N06`). The aside build is removed when the visits are done.\n\nThe report also names **the built-ins no page drew**. A component can be in the registry, the tests and the documentation and still be broken on a page. The classes the pages carried list what actually ran, so the difference is what nothing has exercised. One project is not expected to draw them all: the list is a fact about coverage, not a failure.\n\n`wf verify` needs Chrome or Chromium on the machine, or `WF_CHROME` pointing at one, and says so when there is none.\n\nSee also: [Testing](/learn/16-testing).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "[PATH]", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--json", type: "flag", meaning: "Print JSON, for a pipeline" }, { name: "--budget MS", type: "number", meaning: "Fail a route whose first paint is slower than this, in milliseconds" }, { name: "--returning-visitor", type: "flag", meaning: "Visit every route again as a reader whose storage holds what the previous build's pages kept" }, { name: "--allow-output-outside", type: "flag", meaning: "Let `build.output` name a directory outside the project" }, { name: "--fakes FILE", type: "path", meaning: "Build the site with these fakes answering its endpoints, then load that: for a site whose API is elsewhere" }], caption: "Options of wf verify", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliRegistry(path: "/reference/cli/registry", title: "wf registry — Reference", description: "wf registry: Describe every built-in component: props, cases, flags, events, slots, parts. What it writes, and every option it takes.") {
    ReferenceItemShell("wf registry", summary: "Describe every built-in component: props, cases, flags, events, slots, parts", signature: "wf registry [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        // ── words: registry ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Describes every built-in component: props, cases, flags, events, slots and parts.")

            Terminal(lines: [
                    Line(command: "wf registry --json | jq '.components[] | select(.name == \"Button\") | .props[].name'")
                ])

            Markdown("The registry is the compiler's own table: what it prints is exactly what the checker accepts.\n\nSee also: [Built-in components](/reference).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "--json", type: "flag", meaning: "Print JSON, for tools" }], caption: "Options of wf registry", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliTypes(path: "/reference/cli/types", title: "wf types — Reference", description: "wf types: Describe what a project declares: enums, types, components, stores, pages. What it writes, and every option it takes.") {
    ReferenceItemShell("wf types", summary: "Describe what a project declares: enums, types, components, stores, pages", signature: "wf types [PATH] [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        // ── words: types ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Describes what a project declares: enums, types, components, stores and pages.")

            Terminal(lines: [
                    Line(command: "wf types"),
                Line(command: "wf types --json"),
                Line(command: "wf types --holes")
                ])

            Markdown("It includes the names the project's scripts under `src/` declare, each with the parameters and return type its JSDoc gives it.\n\nWith `--holes` it lists every place the checker cannot say what a value is, each with its file, line and kind, then the count of each kind. A hole is counted where the unknown value is made, not at every place it goes afterwards. Since 7.0 a program that checks has none: `Any` and `Map` are not types (`T23`, `T24`), every `state`, parameter and return says what it holds, and the browser, events and built-ins are typed. The list is for a project on its way there — one `wf migrate` has not finished — and for a tool that wants to prove it. `--json` gives `total`, the count of each kind, and the list.")

            DocsCodeBlock(#"  0 place(s) where a type is unknown, in 0 file(s)"#, title: "text")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "[PATH]", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--json", type: "flag", meaning: "Print JSON, for tools" }, { name: "--holes", type: "flag", meaning: "List every place a value's type is unknown, and why" }], caption: "Options of wf types", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliFmt(path: "/reference/cli/fmt", title: "wf fmt — Reference", description: "wf fmt: Format a project's source files; with --to, rewrite them in the other layout: .wfx (blocks by indentation) or .wf (blocks in braces). What it…") {
    ReferenceItemShell("wf fmt", summary: "Format a project's source files; with `--to`, rewrite them in the other layout: `.wfx` (blocks by indentation) or `.wf` (blocks in braces)", signature: "wf fmt [PATH] [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "site/src/pages/reference/Cli.wf") {
        Markdown(t("cli.writes", { what: "the project's source files" }), class: "bp-prose")
        Markdown(t("cli.preview", { flag: "--check" }), class: "bp-prose")
        // ── words: fmt ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
        Stack(gap: .lg, class: "bp-prose") {
            Markdown("Formats every `.wf` and `.wfx` file under a path, or one file, in place.")

            Terminal(lines: [
                    Line(command: "wf fmt"),
                Line(command: "wf fmt --check"),
                Line(command: "wf fmt src/pages/Home.wf --stdout"),
                Line(command: "wf fmt --to wfx")
                ])

            Markdown("The formatter applies these rules:\n\n- four spaces for each level, and a line that closes a block one level out;\n- trailing spaces removed, and tabs turned into spaces;\n- runs of blank lines folded to one;\n- a brace one space from what it opens (`Row\{` → `Row \{`, `\}else` → `\} else`).\n\nA line carried on by a trailing comma stays as written, and comments stay where they are. The result is checked against the file's own tokens, so formatting never changes what a file says.\n\n`--to wfx` rewrites the project's `.wf` files in the indented layout, and `--to wf` goes the other way. It changes the layout and nothing else, and refuses a file whose indentation does not already follow its braces.\n\nSee also: [Two layouts: `.wf` and `.wfx`](/learn/04-language-basics#two-layouts-wf-and-wfx).")

        }
        // ── end of the words ──
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "[PATH]", type: "path", meaning: "Project directory (default: current directory), or one file" }, { name: "--to TO", type: "wfx | wf", meaning: "Change the layout instead: `wfx` or `wf`" }, { name: "--check", type: "flag", meaning: "Write nothing; fail when a file is not formatted" }, { name: "--stdout", type: "flag", meaning: "Print the formatted text to stdout instead of writing it" }], caption: "Options of wf fmt", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}
