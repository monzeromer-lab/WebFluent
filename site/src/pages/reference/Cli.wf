// The command line's reference: every command, then a page per command.
// Written by scripts/docsite/reference.py from `wf commands --json`, but
// for its words: each part between `// ── words: NAME ──` and
// `// ── end of the words ──` is written by hand, here, and kept as it is
// when the rest is written again (`cargo xtask site`). `groups` says
// which group the index lists each command under; `index` is what the
// index says above the list; a command's own (`build`) is what its page
// says under its summary.

// ── words: groups ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
/// The commands, by the group the index lists them under. A command no
/// group names is listed under "Other commands".
const CLI_GROUPS: [String: [String]] = {
    "Scaffolding and building": ["init", "build", "serve", "start", "inspect", "generate"],
    "Checking and testing": ["check", "config", "api", "fix", "explain", "test", "audit", "verify"],
    "Describing the project": ["motion", "context", "translations", "scope", "rules", "theme", "components", "assets", "commands", "docs", "registry", "types"],
    "Rendering": ["render"],
    "Upgrading": ["migrate"],
    "Formatting": ["fmt"]
}

/// The index's own sections, after its list of commands.
const CLI_INDEX_SECTIONS: [Anchor] = [Anchor(id: "conventions", label: "Conventions"), Anchor(id: "describing-the-project", label: "Describing the project"), Anchor(id: "environment-variables", label: "Environment variables"), Anchor(id: "editors", label: "Editors"), Anchor(id: "building-a-tool-on-the-compiler", label: "Building a tool on the compiler")]
// ── end of the words ──

/// Every command: the sidebar of each command's page.
const CLI_INDEX: [IndexEntry] = [
    IndexEntry(label: "wf init", to: "/reference/cli/init", group: "Scaffolding and building"),
    IndexEntry(label: "wf build", to: "/reference/cli/build", group: "Scaffolding and building"),
    IndexEntry(label: "wf check", to: "/reference/cli/check", group: "Checking and testing"),
    IndexEntry(label: "wf config", to: "/reference/cli/config", group: "Checking and testing"),
    IndexEntry(label: "wf api", to: "/reference/cli/api", group: "Checking and testing"),
    IndexEntry(label: "wf motion", to: "/reference/cli/motion", group: "Describing the project"),
    IndexEntry(label: "wf context", to: "/reference/cli/context", group: "Describing the project"),
    IndexEntry(label: "wf translations", to: "/reference/cli/translations", group: "Describing the project"),
    IndexEntry(label: "wf scope", to: "/reference/cli/scope", group: "Describing the project"),
    IndexEntry(label: "wf rules", to: "/reference/cli/rules", group: "Describing the project"),
    IndexEntry(label: "wf theme", to: "/reference/cli/theme", group: "Describing the project"),
    IndexEntry(label: "wf components", to: "/reference/cli/components", group: "Describing the project"),
    IndexEntry(label: "wf assets", to: "/reference/cli/assets", group: "Describing the project"),
    IndexEntry(label: "wf commands", to: "/reference/cli/commands", group: "Describing the project"),
    IndexEntry(label: "wf fix", to: "/reference/cli/fix", group: "Checking and testing"),
    IndexEntry(label: "wf explain", to: "/reference/cli/explain", group: "Checking and testing"),
    IndexEntry(label: "wf serve", to: "/reference/cli/serve", group: "Scaffolding and building"),
    IndexEntry(label: "wf start", to: "/reference/cli/start", group: "Scaffolding and building"),
    IndexEntry(label: "wf inspect", to: "/reference/cli/inspect", group: "Scaffolding and building"),
    IndexEntry(label: "wf generate", to: "/reference/cli/generate", group: "Scaffolding and building"),
    IndexEntry(label: "wf render", to: "/reference/cli/render", group: "Rendering"),
    IndexEntry(label: "wf migrate", to: "/reference/cli/migrate", group: "Upgrading"),
    IndexEntry(label: "wf docs", to: "/reference/cli/docs", group: "Describing the project"),
    IndexEntry(label: "wf test", to: "/reference/cli/test", group: "Checking and testing"),
    IndexEntry(label: "wf audit", to: "/reference/cli/audit", group: "Checking and testing"),
    IndexEntry(label: "wf verify", to: "/reference/cli/verify", group: "Checking and testing"),
    IndexEntry(label: "wf registry", to: "/reference/cli/registry", group: "Describing the project"),
    IndexEntry(label: "wf types", to: "/reference/cli/types", group: "Describing the project"),
    IndexEntry(label: "wf fmt", to: "/reference/cli/fmt", group: "Formatting")
]

page CliIndexPage(path: "/reference/cli", title: "Command line — Reference", description: "Every wf command and its options, from init, build and serve to render, migrate and verify, and the language server in each editor.") {
    ReferenceItemShell(t("cli.title"), summary: t("cli.lede", { count: 29 }), signature: "wf <command> [options]", group: t("cli.title"), entries: REFERENCE_PAGES.concat(CLI_INDEX), sections: [Anchor(id: "commands", label: t("cli.commands"))].concat(CLI_INDEX_SECTIONS), source: "site/src/pages/reference/Cli.wf") {
        notes {
            // ── words: index ── written by hand, and kept as it is when scripts/docsite/reference.py writes the rest
            Stack(gap: .lg) {
                Markdown("This chapter is the reference for `wf`, the one binary that creates, builds, serves, checks, formats, tests, renders and describes a WebFluent project, and for `wf-lsp`, the language server that brings the same checks into your editor. Look up a command here when you need its exact flags, defaults and behaviour.\n\n`wf --help` lists the commands, `wf <command> --help` lists one command's flags, and `wf --version` prints the version (`wf X.Y.Z`).")

                Terminal(lines: [
                Line(command: "wf init my-site -t static"),
                Line(command: "cd my-site"),
                Line(command: "wf serve")
            ])

                Heading("Conventions", id: "conventions").h2

                Markdown("These rules hold for every command unless its entry says otherwise:\n\n- **The project directory.** A command that works on a project uses the current directory. `-d DIR` (or `--dir DIR`) names another one; a command that takes a `PATH` argument instead takes the directory, or sometimes one file, as that argument.\n- **Exit status.** A command exits `0` when it succeeds and non-zero when it fails, so each command works as a CI step without a wrapper. A build that stops on its findings exits `1`; a build that cannot run at all — a file it cannot read, a config it cannot load — exits `2`.\n- **`--json`.** A describing command prints a human-readable report by default and, with `--json`, the same information as JSON for a tool.\n- **Previews.** Every command that writes files has a flag that shows what it would do and writes nothing: `wf fmt --check`, `wf migrate --check`, `wf fix --dry-run`. `wf commands` names that flag for each command.")

                Heading("Describing the project", id: "describing-the-project").h2

                Markdown("These commands print what the project and the compiler hold. Each one is also a function in the `webfluent` crate, named in its entry and in [Building a tool on the compiler](#building-a-tool-on-the-compiler).")

                Heading("Environment variables", id: "environment-variables").h2

                Table(caption: "Environment variables") {
                    Table.Head {
                        Table.Row {
                            Table.Cell("Variable").header
                            Table.Cell("Read by").header
                            Table.Cell("What it does").header
                        }
                    }
                    Table.Body {
                        Table.Row {
                            Table.Cell { Markdown("`WF_INSTALL_DIR`") }
                            Table.Cell { Markdown("`install.sh`, `install.ps1`") }
                            Table.Cell { Markdown("Where the binary is installed (default `~/.webfluent/bin`).") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`WF_VERSION`") }
                            Table.Cell { Markdown("`install.sh`, `install.ps1`") }
                            Table.Cell { Markdown("The release to install, such as `vX.Y.Z`, instead of the latest.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`WF_CHROME`") }
                            Table.Cell { Markdown("`wf test`, `wf verify`") }
                            Table.Cell("The Chrome or Chromium to drive, when it is not found on its own.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`WF_CHROME_NO_SANDBOX`") }
                            Table.Cell { Markdown("`wf test`, `wf verify`") }
                            Table.Cell { Markdown("`1` starts Chrome without its sandbox from the outset, instead of trying with one first (a container that gives it none).") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`WF_BIN`") }
                            Table.Cell("the Node binding")
                            Table.Cell { Markdown("The `wf` binary to call.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("any `PUBLIC_…` name") }
                            Table.Cell { Markdown("`wf build`") }
                            Table.Cell { Markdown("A value for `env.NAME` ([Environments and secrets](/recipes/environments-and-secrets)).") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`WF_ALLOW_SHELL_ENV`") }
                            Table.Cell { Markdown("`wf build`, `wf serve`") }
                            Table.Cell { Markdown("Names, comma-separated, that `public_env` lists without the `PUBLIC_` prefix and whose value the shell may supply (`WF_ALLOW_SHELL_ENV=API_URL`). Without it such a name takes its value from the config or `.env` only, so a cloned project cannot bundle a shell secret.") }
                        }
                    }
                }

                Heading("Editors", id: "editors").h2

                Markdown("`wf-lsp` is the language server: it runs the compiler's checks as you type and answers your editor's questions about the code. [Editors](/reference/editors) says how to install it, what it answers, and how to set up VS Code, Zed, Neovim, Helix, Emacs and any other editor with LSP support.")

                Heading("Building a tool on the compiler", id: "building-a-tool-on-the-compiler").h2

                Markdown("Every command above is a function in the `webfluent` crate, so an editor, a site builder or an agent can call it in process instead of running `wf`. Each one reads the project through a `webfluent::vfs::Vfs`: `FsVfs` reads the disk, and `OverlayVfs::over_disk()` lays the editor's unsaved buffers over it, so a tool reports the project as it is being edited.\n\nMost of these are the compiler's own parts: they are reached with the crate's `internals` feature (`webfluent = \{ version = \"7\", features = [\"internals\"] \}`), are not documented, and a release may change them without a major version. The ones marked \"no\" are the documented API.")

                Table(caption: "Building a tool on the compiler") {
                    Table.Head {
                        Table.Row {
                            Table.Cell("Function").header
                            Table.Cell.header { Markdown("Needs `internals`") }
                            Table.Cell("What it is").header
                        }
                    }
                    Table.Body {
                        Table.Row {
                            Table.Cell { Markdown("`webfluent::build::\{build, check\}` with `BuildOptions`") }
                            Table.Cell("no")
                            Table.Cell { Markdown("`wf build` and `wf check`, returning every line and every finding as a `Diagnostic` with its fixes; `BuildOptions::studio` is `--studio`") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`webfluent::diagnostics::fixes::fix_all`") }
                            Table.Cell("no")
                            Table.Cell { Markdown("`wf fix`'s fix-all, for one family in one file") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`webfluent::syntax::\{print, reprint\}`, `webfluent::edit::\{rewrite_element, rewrite_statement, rewrite_body, rewrite_declaration, rewrite_program\}`") }
                            Table.Cell("yes")
                            Table.Cell("An element, a statement or a declaration changed in the tree and written back as the smallest edit, every other byte as it was; refused when it would not read back the same")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`webfluent::syntax::node_id::\{build_node_map_with, layers\}`") }
                            Table.Cell("no")
                            Table.Cell("Every element's id, file, place, parent and what it is inside; the node at a caret; the Layers tree")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`webfluent::registry::schema::of_project_via`") }
                            Table.Cell("yes")
                            Table.Cell { Markdown("`wf components`") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`webfluent::paged::style_value`") }
                            Table.Cell("yes")
                            Table.Cell { Markdown("Each style property's shape, a value read into parts (`read_box`), and the narrowest declaration written back (`edit_box`)") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`webfluent::themes::view::\{view_via, set_token, reset_token\}`") }
                            Table.Cell("yes")
                            Table.Cell { Markdown("`wf theme`, and one token written in its place") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`webfluent::motion::catalogue`") }
                            Table.Cell("yes")
                            Table.Cell { Markdown("`wf motion`") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`webfluent::validation::\{must_be_via, set_rule, remove_rule, move_rule\}`") }
                            Table.Cell("yes")
                            Table.Cell { Markdown("`wf rules`, and a state's `validate` block written back one rule at a time") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`webfluent::scope::paths::at_via`") }
                            Table.Cell("yes")
                            Table.Cell { Markdown("`wf scope`") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`webfluent::i18n::\{plurals, table\}`") }
                            Table.Cell("yes")
                            Table.Cell { Markdown("`wf translations`: CLDR's plural rules, the table, and `set_message`") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`webfluent::build::assets::\{list, plan\}`, `webfluent::media::plan`") }
                            Table.Cell("yes")
                            Table.Cell { Markdown("`wf assets`") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`webfluent::config::\{schema, json_edit\}`") }
                            Table.Cell("yes")
                            Table.Cell { Markdown("`wf config`, and a setting written keeping the file's shape") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`webfluent::commands`") }
                            Table.Cell("yes")
                            Table.Cell { Markdown("`wf commands`") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`webfluent::agent::\{changeset, context, diff, edit\}`") }
                            Table.Cell("yes")
                            Table.Cell { Markdown("`wf context`, and a change set an agent writes to instead of the working tree, built before anyone reads it, with anchored edits") }
                        }
                    }
                }

            }
            // ── end of the words ──
        }
        Heading(t("cli.commands"), id: "commands").h2
        Heading("Scaffolding and building", id: "scaffolding-and-building").h3
        Stack(class: "bp-sheet") {
            style { gap: 0 }
            Link(to: "/reference/cli/init") {
                style { display: flex; align-items: baseline; gap: 16px; min-height: 44px; padding: 8px 14px; border-bottom: 1px solid $line; color: $ink; text-decoration: none; &:last-child { border-bottom: 0 } &:hover { background: $raised; text-decoration: none } & p { margin: 0 } }
                Text("wf init", class: "bp-mono") { style { flex-shrink: 0; width: 140px; font-size: 13px; color: $link } }
                Text("Create a new WebFluent project", class: "bp-small")
            }
            Link(to: "/reference/cli/build") {
                style { display: flex; align-items: baseline; gap: 16px; min-height: 44px; padding: 8px 14px; border-bottom: 1px solid $line; color: $ink; text-decoration: none; &:last-child { border-bottom: 0 } &:hover { background: $raised; text-decoration: none } & p { margin: 0 } }
                Text("wf build", class: "bp-mono") { style { flex-shrink: 0; width: 140px; font-size: 13px; color: $link } }
                Text("Build the project: a site or app (HTML, CSS, JS), a PDF, a slide deck or custom elements", class: "bp-small")
            }
            Link(to: "/reference/cli/serve") {
                style { display: flex; align-items: baseline; gap: 16px; min-height: 44px; padding: 8px 14px; border-bottom: 1px solid $line; color: $ink; text-decoration: none; &:last-child { border-bottom: 0 } &:hover { background: $raised; text-decoration: none } & p { margin: 0 } }
                Text("wf serve", class: "bp-mono") { style { flex-shrink: 0; width: 140px; font-size: 13px; color: $link } }
                Text("Start the development server", class: "bp-small")
            }
            Link(to: "/reference/cli/start") {
                style { display: flex; align-items: baseline; gap: 16px; min-height: 44px; padding: 8px 14px; border-bottom: 1px solid $line; color: $ink; text-decoration: none; &:last-child { border-bottom: 0 } &:hover { background: $raised; text-decoration: none } & p { margin: 0 } }
                Text("wf start", class: "bp-mono") { style { flex-shrink: 0; width: 140px; font-size: 13px; color: $link } }
                Text("Serve a built project as a host would: `$PORT`, the build's headers and compressed files, a single-page build's shell for every route, and `--proxy` for an API elsewhere", class: "bp-small")
            }
            Link(to: "/reference/cli/inspect") {
                style { display: flex; align-items: baseline; gap: 16px; min-height: 44px; padding: 8px 14px; border-bottom: 1px solid $line; color: $ink; text-decoration: none; &:last-child { border-bottom: 0 } &:hover { background: $raised; text-decoration: none } & p { margin: 0 } }
                Text("wf inspect", class: "bp-mono") { style { flex-shrink: 0; width: 140px; font-size: 13px; color: $link } }
                Text("One page as a reader meets it, as text: landmarks, headings, links, buttons, fields, tables, and anything that failed", class: "bp-small")
            }
            Link(to: "/reference/cli/generate") {
                style { display: flex; align-items: baseline; gap: 16px; min-height: 44px; padding: 8px 14px; border-bottom: 1px solid $line; color: $ink; text-decoration: none; &:last-child { border-bottom: 0 } &:hover { background: $raised; text-decoration: none } & p { margin: 0 } }
                Text("wf generate", class: "bp-mono") { style { flex-shrink: 0; width: 140px; font-size: 13px; color: $link } }
                Text("Generate a new page, component, or store — or a block, a whole page to own: sign-in, pricing, dashboard, settings", class: "bp-small")
            }
        }
        Heading("Checking and testing", id: "checking-and-testing").h3
        Stack(class: "bp-sheet") {
            style { gap: 0 }
            Link(to: "/reference/cli/check") {
                style { display: flex; align-items: baseline; gap: 16px; min-height: 44px; padding: 8px 14px; border-bottom: 1px solid $line; color: $ink; text-decoration: none; &:last-child { border-bottom: 0 } &:hover { background: $raised; text-decoration: none } & p { margin: 0 } }
                Text("wf check", class: "bp-mono") { style { flex-shrink: 0; width: 140px; font-size: 13px; color: $link } }
                Text("Check the project — every finding a build would report — and write nothing", class: "bp-small")
            }
            Link(to: "/reference/cli/config") {
                style { display: flex; align-items: baseline; gap: 16px; min-height: 44px; padding: 8px 14px; border-bottom: 1px solid $line; color: $ink; text-decoration: none; &:last-child { border-bottom: 0 } &:hover { background: $raised; text-decoration: none } & p { margin: 0 } }
                Text("wf config", class: "bp-mono") { style { flex-shrink: 0; width: 140px; font-size: 13px; color: $link } }
                Text("Read and change `webfluent.app.json`: every setting, what the project sets, and an edit that keeps the file's shape", class: "bp-small")
            }
            Link(to: "/reference/cli/api") {
                style { display: flex; align-items: baseline; gap: 16px; min-height: 44px; padding: 8px 14px; border-bottom: 1px solid $line; color: $ink; text-decoration: none; &:last-child { border-bottom: 0 } &:hover { background: $raised; text-decoration: none } & p { margin: 0 } }
                Text("wf api", class: "bp-mono") { style { flex-shrink: 0; width: 140px; font-size: 13px; color: $link } }
                Text("A service's contract as files, from its OpenAPI spec: add one, sync it, check it is current, turn `api … from` into files, list them", class: "bp-small")
            }
            Link(to: "/reference/cli/fix") {
                style { display: flex; align-items: baseline; gap: 16px; min-height: 44px; padding: 8px 14px; border-bottom: 1px solid $line; color: $ink; text-decoration: none; &:last-child { border-bottom: 0 } &:hover { background: $raised; text-decoration: none } & p { margin: 0 } }
                Text("wf fix", class: "bp-mono") { style { flex-shrink: 0; width: 140px; font-size: 13px; color: $link } }
                Text("Fix every finding that has a fix — or every one of a code — as `wf check` and the editor offer it, and say what is left", class: "bp-small")
            }
            Link(to: "/reference/cli/explain") {
                style { display: flex; align-items: baseline; gap: 16px; min-height: 44px; padding: 8px 14px; border-bottom: 1px solid $line; color: $ink; text-decoration: none; &:last-child { border-bottom: 0 } &:hover { background: $raised; text-decoration: none } & p { margin: 0 } }
                Text("wf explain", class: "bp-mono") { style { flex-shrink: 0; width: 140px; font-size: 13px; color: $link } }
                Text("What a diagnostic code means, a program that draws it, and the fix; with no code, every code", class: "bp-small")
            }
            Link(to: "/reference/cli/test") {
                style { display: flex; align-items: baseline; gap: 16px; min-height: 44px; padding: 8px 14px; border-bottom: 1px solid $line; color: $ink; text-decoration: none; &:last-child { border-bottom: 0 } &:hover { background: $raised; text-decoration: none } & p { margin: 0 } }
                Text("wf test", class: "bp-mono") { style { flex-shrink: 0; width: 140px; font-size: 13px; color: $link } }
                Text("Run the project's `test \"…\" \{ … \}` declarations under tests/", class: "bp-small")
            }
            Link(to: "/reference/cli/audit") {
