                Text("wf audit", class: "bp-mono") { style { flex-shrink: 0; width: 140px; font-size: 13px; color: $link } }
                Text("What this project trusts: markup it did not write, other origins, what it keeps on the reader's machine, its `env` names, its policy and its dependencies", class: "bp-small")
            }
            Link(to: "/reference/cli/verify") {
                style { display: flex; align-items: baseline; gap: 16px; min-height: 44px; padding: 8px 14px; border-bottom: 1px solid $line; color: $ink; text-decoration: none; &:last-child { border-bottom: 0 } &:hover { background: $raised; text-decoration: none } & p { margin: 0 } }
                Text("wf verify", class: "bp-mono") { style { flex-shrink: 0; width: 140px; font-size: 13px; color: $link } }
                Text("Load every page of a built project in a real browser: errors, failed requests, paint timing, and which built-ins it drew", class: "bp-small")
            }
        }
        Heading("Describing the project", id: "describing-the-project").h3
        Stack(class: "bp-sheet") {
            style { gap: 0 }
            Link(to: "/reference/cli/motion") {
                style { display: flex; align-items: baseline; gap: 16px; min-height: 44px; padding: 8px 14px; border-bottom: 1px solid $line; color: $ink; text-decoration: none; &:last-child { border-bottom: 0 } &:hover { background: $raised; text-decoration: none } & p { margin: 0 } }
                Text("wf motion", class: "bp-mono") { style { flex-shrink: 0; width: 140px; font-size: 13px; color: $link } }
                Text("The animations an element can play, the eases and speeds, the route transitions and the project's default", class: "bp-small")
            }
            Link(to: "/reference/cli/context") {
                style { display: flex; align-items: baseline; gap: 16px; min-height: 44px; padding: 8px 14px; border-bottom: 1px solid $line; color: $ink; text-decoration: none; &:last-child { border-bottom: 0 } &:hover { background: $raised; text-decoration: none } & p { margin: 0 } }
                Text("wf context", class: "bp-mono") { style { flex-shrink: 0; width: 140px; font-size: 13px; color: $link } }
                Text("What an agent is given: the files, the open file, the problems, the components, the theme, the config with only its public env, the language reference, and what was withheld", class: "bp-small")
            }
            Link(to: "/reference/cli/translations") {
                style { display: flex; align-items: baseline; gap: 16px; min-height: 44px; padding: 8px 14px; border-bottom: 1px solid $line; color: $ink; text-decoration: none; &:last-child { border-bottom: 0 } &:hover { background: $raised; text-decoration: none } & p { margin: 0 } }
                Text("wf translations", class: "bp-mono") { style { flex-shrink: 0; width: 140px; font-size: 13px; color: $link } }
                Text("The translations as a table: each locale's plural forms and what it lacks, each key's messages, and where a `t()` names it", class: "bp-small")
            }
            Link(to: "/reference/cli/scope") {
                style { display: flex; align-items: baseline; gap: 16px; min-height: 44px; padding: 8px 14px; border-bottom: 1px solid $line; color: $ink; text-decoration: none; &:last-child { border-bottom: 0 } &:hover { background: $raised; text-decoration: none } & p { margin: 0 } }
                Text("wf scope", class: "bp-mono") { style { flex-shrink: 0; width: 140px; font-size: 13px; color: $link } }
                Text("What a path picker lists at a place: the names in scope there, each with its type and where it comes from, and the fields to go on into", class: "bp-small")
            }
            Link(to: "/reference/cli/rules") {
