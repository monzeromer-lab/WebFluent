}

page CliMotion(path: "/reference/cli/motion", title: "wf motion — Reference", description: "wf motion: The animations an element can play, the eases and speeds, the route transitions and the project's default. What it writes, and every option…") {
    ReferenceItemShell("wf motion", summary: "The animations an element can play, the eases and speeds, the route transitions and the project's default", signature: "wf motion [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "wf commands --json") {
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "--dir, -d DIR", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--json", type: "flag", meaning: "Print JSON, for tools" }], caption: "Options of wf motion", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
