}

page CliInit(path: "/reference/cli/init", title: "wf init — Reference", description: "wf init: Create a new WebFluent project. What it writes, and every option it takes.") {
    ReferenceItemShell("wf init", summary: "Create a new WebFluent project", signature: "wf init NAME [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "wf commands --json") {
        Markdown(t("cli.writes", { what: "a new project's folder" }), class: "bp-prose")
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "NAME", type: "text", meaning: "Project name" }, { name: "--template, -t TEMPLATE", type: "spa | static | pdf | slides", meaning: "Template: \"spa\" (default), \"static\", \"pdf\", or \"slides\"" }, { name: "--locales, -l LOCALES", type: "text", meaning: "Start it translated: the locales, comma-separated, the default first (\"en,ar\"). Every visible string goes through t(), and src/translations/ holds a file for each. spa and static only" }], caption: "Options of wf init", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliBuild(path: "/reference/cli/build", title: "wf build — Reference", description: "wf build: Build the project (compile .wf files to HTML + CSS + JS). What it writes, and every option it takes.") {
    ReferenceItemShell("wf build", summary: "Build the project (compile .wf files to HTML + CSS + JS)", signature: "wf build [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "wf commands --json") {
        Markdown(t("cli.writes", { what: "the site, in the output folder" }), class: "bp-prose")
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "--dir, -d DIR", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--stats", type: "flag", meaning: "Print what the build weighs: every file, gzipped, and the runtime modules it kept and left out" }, { name: "--format FORMAT", type: "human | json | sarif | github", meaning: "How findings are written: `human` (default), `json`, `sarif` (code scanning) or `github` (annotations on a pull request)" }, { name: "--deny-warnings", type: "flag", meaning: "Let a warning stop the build as an error does" }, { name: "--cache", type: "flag", meaning: "Reuse what earlier builds rendered, kept in `.wf-cache/build/`: only the pages an edit changed are rendered again" }, { name: "--studio", type: "flag", meaning: "For an editor's preview: stamp every element with its node id (`data-wf-node`) and write `nodes.json`, from each id to its source" }, { name: "--allow-output-outside", type: "flag", meaning: "Let `build.output` name a directory outside the project; without it a build writes only inside the project" }], caption: "Options of wf build", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliCheck(path: "/reference/cli/check", title: "wf check — Reference", description: "wf check: Check the project — every finding a build would report — and write nothing. What it writes, and every option it takes.") {
    ReferenceItemShell("wf check", summary: "Check the project — every finding a build would report — and write nothing", signature: "wf check [options]", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "wf commands --json") {
        Heading(t("cli.options"), id: "options").h2
        PropsTable(rows: [{ name: "--dir, -d DIR", type: "path", meaning: "Project directory (default: current directory)" }, { name: "--format FORMAT", type: "human | json | sarif | github", meaning: "How findings are written: `human` (default), `json`, `sarif` (code scanning) or `github` (annotations on a pull request)" }, { name: "--deny-warnings", type: "flag", meaning: "Fail on a warning too" }, { name: "--allow-output-outside", type: "flag", meaning: "Accept a `build.output` outside the project, as `wf build --allow-output-outside` does; without it the check reports what the build would refuse" }], caption: "Options of wf check", nameLabel: t("cli.option"))
        Link(t("cli.all"), to: "/reference/cli")
    }
}

page CliConfig(path: "/reference/cli/config", title: "wf config — Reference", description: "wf config: Read and change webfluent.app.json: every setting, what the project sets, and an edit that keeps the file's shape. What it writes, and every…") {
    ReferenceItemShell("wf config", summary: "Read and change `webfluent.app.json`: every setting, what the project sets, and an edit that keeps the file's shape", signature: "wf config", group: t("cli.title"), entries: CLI_INDEX, sections: [Anchor(id: "options", label: t("cli.options"))], source: "wf commands --json") {
        Heading(t("cli.options"), id: "options").h2
        Text(t("cli.noopts"), class: "bp-small")
        Link(t("cli.all"), to: "/reference/cli")
