                controls {
                    StageControl({ name: "page_size", kind: "enum", options: ["A4", "A3", "A5", "Letter", "Legal"], value: "A4", sink: "special" })
                    StageControl({ name: "size", kind: "string", options: [], value: "" })
                    StageControl({ name: "landscape", kind: "bool", options: [], value: "", sink: "special" })
                    StageControl({ name: "title", kind: "string", options: [], value: "" })
                    StageControl({ name: "author", kind: "string", options: [], value: "" })
                    StageControl({ name: "subject", kind: "string", options: [], value: "" })
                }
