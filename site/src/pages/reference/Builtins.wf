page BuiltinTree(path: "/reference/tree", title: "Tree — Reference", description: "Tree: Nested items — files and folders, an outline — as a tree a keyboard can work: Up and Down through what shows, Right to open and go in, Left to…") {
    state file = "src/pages/Home.wf"
    state stageLabel = "Files"
    ReferenceItemShell("Tree", summary: "Nested items — files and folders, an outline — as a tree a keyboard can work: Up and Down through what shows, Right to open and go in, Left to close and go out (the other way round right to left), Home and End, a letter. row(item) \{ … \} draws each; bind: holds the chosen item's key, or a list of keys with .multiple.", signature: "Tree(items: [Item], children: (Item) -> [Item]?, key: (Item) -> String or (Item) -> Number, …)", since: "6.2.0", outputs: [], group: "Data display", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Tree") {
                controls {
                    StageControl({ name: "multiple", kind: "bool", options: [], value: "", sink: "special" })
                    StageControl({ name: "label", kind: "string", options: [], value: "" }, live: true, current: stageLabel) { on pick(v) { stageLabel = v } }
                }
                Tree(items: [
                    { path: "src", name: "src", children: [
                        { path: "src/App.wf", name: "App.wf" },
                        { path: "src/pages", name: "pages", children: [
                            { path: "src/pages/Home.wf", name: "Home.wf" },
                            { path: "src/pages/About.wf", name: "About.wf" },
                        ] },
                    ] },
                    { path: "webfluent.app.json", name: "webfluent.app.json" },
                ], children: f => f.children ?? [], key: f => f.path, bind: file, open: ["src", "src/pages"], label: stageLabel) {
                    row(f) {
                        Icon(if f.children != null { "folder" } else { "file" })
                        Text(f.name)
                    }
                }
                Text("Open: {file}").muted
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"state file = "src/pages/Home.wf"
