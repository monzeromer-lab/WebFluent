        }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "height:", type: "String", meaning: "A CSS length, `300px`: its `max-height`, past which it scrolls. Unset, it grows with what is inside unless its parent holds it", default: "none" }, { name: "label:", type: "String (required)", meaning: "The region's accessible name (`aria-label`); it is a Tab stop so a keyboard can scroll it", default: "—" }, { name: "horizontal:", type: "Bool", meaning: "It scrolls across, not down (`overflow-x: auto`, `overflow-y: hidden`), its fades at the start and end. Written as a flag, `.horizontal`, or `horizontal: true`.", default: "false" }], caption: "Props of ScrollArea", defaults: true)
