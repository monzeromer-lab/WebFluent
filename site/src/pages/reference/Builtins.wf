        PropsTable(rows: [{ name: "animate:", type: ".fadeIn .fadeOut .slideUp .slideDown .slideLeft .slideRight .scaleIn .scaleOut .bounce .shake .pulse .spin .expand .collapse", meaning: "Animation played when the element appears" }, { name: "exit:", type: ".fadeIn .fadeOut .slideUp .slideDown .slideLeft .slideRight .scaleIn .scaleOut .bounce .shake .pulse .spin .expand .collapse", meaning: "Animation played when the element leaves" }, { name: "speed:", type: ".fast .normal .slow", meaning: "How fast its animation runs" }, { name: "duration:", type: "String", meaning: "Animation length, e.g. `300ms`" }, { name: "delay:", type: "String", meaning: "Wait before the animation starts" }, { name: "easing:", type: ".standard .spring .ease .easeIn .easeOut .easeInOut .linear .bouncy .smooth", meaning: "How the animation is paced — a named easing, or any CSS timing function" }, { name: "stagger:", type: "String", meaning: "Delay added per item of a list, e.g. `50ms`" }, { name: "on:", type: ".mount .enterView", meaning: "When its animation plays" }, { name: "count:", type: "String", meaning: "How long the number it shows takes to count to a new value, e.g. `600ms`" }, { name: "shared:", type: "String", meaning: "A name this element keeps across a route change, so the browser carries it from one page to the next" }, { name: "class:", type: "String", meaning: "Classes added beside the engine's, from the project's own stylesheets" }, { name: "ref:", type: "State", meaning: "A handle on the element, usable as the element: `ref: nameInput`, then `nameInput.focus()`" }, { name: "drag:", type: "Any", meaning: "What it carries when it is picked up — by a mouse moved a few pixels, or a finger held still — and dropped on something with `on receive(d)`" }, { name: "dragGroup:", type: "String", meaning: "Which drops it belongs to: a drag goes only to targets of its own group, so tabs and tree rows stay apart" }, { name: "dropValue:", type: "Any", meaning: "What this target is, as a drag sees it: `d.over` in the drag's `on dragmove(d)` and in `on receive(d)`" }, { name: "dropAxis:", type: ".y .x", meaning: "Which way its list runs, for where a drop lands" }, { name: "dropInside:", type: "Bool", meaning: "A drop on its middle lands inside it — a folder, a container — as well as before or after" }, { name: "trapFocus:", type: "Bool", meaning: "While true, focus moves into it and Tab and Shift+Tab stay inside; when it turns false or the element leaves, focus goes back where it was" }, { name: "mount:", type: "Any", meaning: "Run with the element each time it is made — `mount: (n) => initTilt(n)` — and what it returns is the handle `update:` and `cleanup:` get" }, { name: "update:", type: "Any", meaning: "Run with the handle again whenever the state it reads changes: `update: (h) => h.setMax(max)`" }, { name: "cleanup:", type: "Any", meaning: "Run with the handle when the element leaves — a route change, an `if` branch, a list item: `cleanup: (h) => h.destroy()`" }], caption: t("ref.universal.title"))
        EventsTable(rows: [PropRow(name: "click", kind: "", detail: "The element was clicked or activated"), PropRow(name: "input", kind: "", detail: "The value changed, on every keystroke"), PropRow(name: "change", kind: "", detail: "The value was committed"), PropRow(name: "submit", kind: "", detail: "The form was submitted"), PropRow(name: "focus", kind: "", detail: "The element received focus"), PropRow(name: "blur", kind: "", detail: "The element lost focus"), PropRow(name: "keydown", kind: "", detail: "A key went down; `e.key` names it"), PropRow(name: "longpress", kind: "", detail: "Held still for half a second; `p.x`, `p.y` say where. The click it ends with is not a click"), PropRow(name: "swipe", kind: "", detail: "A finger or a pen swept across it; `s.direction` is \"left\", \"right\", \"up\" or \"down\""), PropRow(name: "receive", kind: "", detail: "Something with `drag:` was dropped on it; `d.value` is what, `d.position` \"before\", \"after\" or \"inside\""), PropRow(name: "dragmove", kind: "", detail: "On what is dragged, while it moves: `d.over` is the target's `dropValue` or null, `d.position` where it would land"), PropRow(name: "key", kind: "", detail: "One key, named: `on key(\"ctrl+k\") \{ \}`"), PropRow(name: "keyup", kind: "", detail: "A key came up"), PropRow(name: "keypress", kind: "", detail: "A character key was pressed"), PropRow(name: "mouseenter", kind: "", detail: "The pointer entered the element"), PropRow(name: "mouseleave", kind: "", detail: "The pointer left the element"), PropRow(name: "dblclick", kind: "", detail: "The element was double-clicked"), PropRow(name: "auxclick", kind: "", detail: "A button other than the main one was clicked; `e.button` is which — 1 is the middle, which closes a tab"), PropRow(name: "focusin", kind: "", detail: "Focus moved onto the element or something inside it"), PropRow(name: "focusout", kind: "", detail: "Focus left the element or something inside it"), PropRow(name: "contextmenu", kind: "", detail: "The context menu was asked for; `e.preventDefault()` keeps the browser's"), PropRow(name: "mousedown", kind: "", detail: "A mouse button went down over the element"), PropRow(name: "mouseup", kind: "", detail: "A mouse button came up over the element"), PropRow(name: "mousemove", kind: "", detail: "The mouse moved over the element"), PropRow(name: "mouseover", kind: "", detail: "The pointer moved onto the element or one of its children"), PropRow(name: "mouseout", kind: "", detail: "The pointer moved off the element or one of its children"), PropRow(name: "pointerdown", kind: "", detail: "A pointer — mouse, pen or touch — went down"), PropRow(name: "pointerup", kind: "", detail: "A pointer came up"), PropRow(name: "pointermove", kind: "", detail: "A pointer moved"), PropRow(name: "pointerenter", kind: "", detail: "A pointer entered the element"), PropRow(name: "pointerleave", kind: "", detail: "A pointer left the element"), PropRow(name: "pointercancel", kind: "", detail: "The browser took the pointer back, for a scroll or a gesture"), PropRow(name: "touchstart", kind: "", detail: "A finger touched the element"), PropRow(name: "touchend", kind: "", detail: "A finger left the element"), PropRow(name: "touchmove", kind: "", detail: "A finger moved across the element"), PropRow(name: "wheel", kind: "", detail: "The wheel or trackpad scrolled over the element"), PropRow(name: "scroll", kind: "", detail: "The element's content scrolled"), PropRow(name: "focusin", kind: "", detail: "The element or something inside it received focus"), PropRow(name: "focusout", kind: "", detail: "The element or something inside it lost focus"), PropRow(name: "reset", kind: "", detail: "The form was reset"), PropRow(name: "invalid", kind: "", detail: "A control failed the browser's own validation"), PropRow(name: "select", kind: "", detail: "Text in a field was selected"), PropRow(name: "copy", kind: "", detail: "Something was copied from the element"), PropRow(name: "cut", kind: "", detail: "Something was cut from the element"), PropRow(name: "paste", kind: "", detail: "Something was pasted into the element; `e.clipboardData` holds it"), PropRow(name: "dragstart", kind: "", detail: "The element started being dragged"), PropRow(name: "drag", kind: "", detail: "The element is being dragged"), PropRow(name: "dragend", kind: "", detail: "A drag of the element ended"), PropRow(name: "dragenter", kind: "", detail: "Something dragged entered the element"), PropRow(name: "dragover", kind: "", detail: "Something dragged is over the element; `e.preventDefault()` allows a drop"), PropRow(name: "dragleave", kind: "", detail: "Something dragged left the element"), PropRow(name: "drop", kind: "", detail: "Something was dropped on the element; `e.dataTransfer` holds it"), PropRow(name: "load", kind: "", detail: "An image, video or frame finished loading"), PropRow(name: "error", kind: "", detail: "An image, video or script failed to load"), PropRow(name: "play", kind: "", detail: "A video or audio started playing"), PropRow(name: "pause", kind: "", detail: "A video or audio paused"), PropRow(name: "ended", kind: "", detail: "A video or audio reached its end"), PropRow(name: "timeupdate", kind: "", detail: "A playing video or audio moved on"), PropRow(name: "animationend", kind: "", detail: "A CSS animation on the element ended"), PropRow(name: "transitionend", kind: "", detail: "A CSS transition on the element ended"), PropRow(name: "toggle", kind: "", detail: "A details element opened or closed")], caption: t("ref.events"))
