page BuiltinFrame(path: "/reference/frame", title: "Frame — Reference", description: "Frame: Another page, shown inside this one: an iframe — the page at src:, or the HTML srcdoc: gives it, sandboxed as sandbox: says. on message(m) hears…") {
    ReferenceItemShell("Frame", summary: "Another page, shown inside this one: an iframe — the page at src:, or the HTML srcdoc: gives it, sandboxed as sandbox: says. on message(m) hears what that page posts to this one (m.data), and nothing any other page posts. Without title: it draws an A17 warning: a frame is announced by its title.", signature: "Frame(src: String, srcdoc: String, title: String, …)", since: "5.9.0", outputs: [], group: "Media", entries: BUILTIN_INDEX, sections: [Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slotsparts")), Anchor(id: "example", label: t("ref.example"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "E109", title: "An element this output cannot draw", to: "/errors/E109"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05"), RelatedLink(kind: "A17", title: "A frame with no title", to: "/errors/A17"), RelatedLink(kind: "V03", title: "Markup put in as markup", to: "/errors/V03")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Frame") {
                controls {
                    StageControl({ name: "src", kind: "string", options: [], value: "" })
                    StageControl({ name: "srcdoc", kind: "string", options: [], value: "" })
                    StageControl({ name: "title", kind: "string", options: [], value: "" })
                    StageControl({ name: "sandbox", kind: "string", options: [], value: "" })
                    StageControl({ name: "allow", kind: "string", options: [], value: "" })
                    StageControl({ name: "loading", kind: "enum", options: ["lazy", "eager"], value: "lazy", sink: "attribute" })
                }
                Text(t("stage.later"), class: "bp-small") { style { max-width: 420px; text-align: center } }
            }
        }
        notes { Text(t("stage.static"), class: "bp-small") }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "src:", type: "String", meaning: "The address of the page it shows" }, { name: "srcdoc:", type: "String", meaning: "The HTML it draws in place of an address, sandboxed as `sandbox:` says; a value that reads state draws the new HTML as it changes" }, { name: "title:", type: "String", meaning: "What it shows, in a few words: its accessible name" }, { name: "sandbox:", type: "String", meaning: "What the framed page may do: `\"allow-scripts allow-forms\"`; empty, it may do nothing" }, { name: "allow:", type: "String", meaning: "The features it may use: `\"fullscreen; clipboard-write\"`" }, { name: "loading:", type: ".lazy .eager", meaning: "Unset, at once" }], caption: "Props of Frame")
        Markdown(t("ref.attrs", { families: "global, aria, data", n: 22, props: "`animate:`, `exit:`, `speed:`, `duration:`, `delay:`, `easing:`, `stagger:`, `on:`, `count:`, `shared:`, `class:`, `ref:`, `drag:`, `dragGroup:`, `dropValue:`, `dropAxis:`, `dropInside:`, `roving:`, `trapFocus:`, `mount:`, `update:`, `cleanup:`" }), class: "bp-prose")
        Heading(t("ref.tab.flags"), id: "flags").h2
        Markdown(t("ref.flags.body"), class: "bp-prose")
        Row(gap: .sm) {
            style { gap: 8px; flex-wrap: wrap }
            Text(".lazy", class: "bp-label bp-mono")
            Text(".eager", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.events"), id: "events").h2
        EventsTable(rows: [PropRow(name: "message", kind: "", detail: ""), PropRow(name: "load", kind: "", detail: "")], caption: "Events of Frame")
        Markdown(t("ref.universal.link"), class: "bp-prose")
        Heading(t("ref.slotsparts"), id: "slots").h2
        SlotsAndParts(slots: [], parts: [])
        Heading(t("ref.example"), id: "example").h2
        CodeBlock(#"Frame(src: "https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ", title: "The launch talk", allow: "fullscreen")
state heard = ""
Frame(src: "/preview/", title: "Preview", sandbox: "allow-scripts") {
    on message(m) { heard = m.data }
}
state version = 1
Frame(srcdoc: "<p>Version {version}</p>", title: "Example", sandbox: "")"#, title: "wf")
        Markdown(t("ref.renders", { cls: "wf-frame" }), class: "bp-prose")
    }
}

