            }
            Link(to: "/reference/bottomnavigation", class: "bp-card") {
                Text("BottomNavigation", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A phone's tab bar along the bottom of the screen: each entry an icon over its words, at least 44px to press, clear of the home indicator (the safe-area inset); the current route's is marked.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/bottomnavigation-item", class: "bp-card") {
