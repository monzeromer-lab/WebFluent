page BuiltinInputgroup(path: "/reference/inputgroup", title: "InputGroup — Reference", description: "InputGroup: An input drawn as one box with what goes beside it: an icon, InputGroup.Addon(\"https://\"), a button, or InputGroup.Clear, which empties the…") {
    state search = ""
    state domain = "acme"
    ReferenceItemShell("InputGroup", summary: "An input drawn as one box with what goes beside it: an icon, InputGroup.Addon(\"https://\"), a button, or InputGroup.Clear, which empties the input and gives it the focus back.", signature: "InputGroup \{ … \}", since: "6.2.0", outputs: [], group: "Form", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots")), Anchor(id: "parts", label: t("ref.parts")), Anchor(id: "inputgroup-addon", label: "InputGroup.Addon"), Anchor(id: "inputgroup-clear", label: "InputGroup.Clear")], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "InputGroup") {
                controls {
                    Text(t("stage.nocontrols"), class: "bp-small")
                }
                Stack(gap: .md) {
                    InputGroup {
                        Icon("search")
                        Input(bind: search, placeholder: "Search the docs", aria-label: "Search the docs")
                        InputGroup.Clear
                    }
                    InputGroup {
                        InputGroup.Addon("https://")
                        Input(bind: domain, aria-label: "Subdomain")
                        InputGroup.Addon(".example.com")
                    }
                    Text("Searching for “{search}” on https://{domain}.example.com").muted
                }
            }
