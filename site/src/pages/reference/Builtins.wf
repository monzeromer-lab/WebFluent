page BuiltinSplitter(path: "/reference/splitter", title: "Splitter — Reference", description: "Splitter: A handle that sets the size of a region beside it: dragged, between min: and max:; double-clicked or Enter, back to reset:; the arrow keys…") {
    state side = 220
    state stageMin = 140
    state stageMax = 400
    state stageReset = 220
    state stageLabel = "Sidebar width"
    state stageHorizontal = false
    state stageReverse = false
    ReferenceItemShell("Splitter", summary: "A handle that sets the size of a region beside it: dragged, between min: and max:; double-clicked or Enter, back to reset:; the arrow keys move it.", signature: "Splitter(bind: State, min: Number, max: Number, …)", since: "5.9.0", outputs: [], group: "Layout", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Splitter") {
                controls {
                    StageControl({ name: "min", kind: "number", options: [], value: "" }, live: true, current: "{stageMin}") { on pick(v) { stageMin = parseFloat(v) } }
                    StageControl({ name: "max", kind: "number", options: [], value: "" }, live: true, current: "{stageMax}") { on pick(v) { stageMax = parseFloat(v) } }
                    StageControl({ name: "reset", kind: "number", options: [], value: "" }, live: true, current: "{stageReset}") { on pick(v) { stageReset = parseFloat(v) } }
                    StageControl({ name: "label", kind: "string", options: [], value: "" }, live: true, current: stageLabel) { on pick(v) { stageLabel = v } }
                    StageControl({ name: "horizontal", kind: "bool", options: [], value: "", sink: "class" }, live: true, pressed: stageHorizontal) { on pick(v) { stageHorizontal = !stageHorizontal } }
                    StageControl({ name: "reverse", kind: "bool", options: [], value: "", sink: "class" }, live: true, pressed: stageReverse) { on pick(v) { stageReverse = !stageReverse } }
                }
                Text("Sidebar: {side}px").muted.sm
                Row {
                    style { height: 180px; border: 1px solid $color-border; border-radius: $radius-md; overflow: hidden }
                    Stack(gap: .xs) {
