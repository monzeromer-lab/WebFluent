page BuiltinDatatable(path: "/reference/datatable", title: "DataTable — Reference", description: "DataTable: Rows of records with their columns declared once: a column sorts when it is .sortable (its header a button, aria-sort saying which way)…") {
    state deploys = [{ id: "d1", service: "checkout", region: "fra1", minutes: 4, status: "Live" }, { id: "d2", service: "search", region: "iad1", minutes: 11, status: "Failed" }, { id: "d3", service: "accounts", region: "sin1", minutes: 7, status: "Live" }]
