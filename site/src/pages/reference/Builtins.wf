    ReferenceItemShell("Link", summary: "Client-side navigation link; its label or its block is the link text.", signature: "Link(_ label: String, to: Path, active: Enum) \{ … \}", older: true, outputs: [], group: "Navigation", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "E107", title: "A URL a browser would run", to: "/errors/E107"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "R01", title: "A route to nothing", to: "/errors/R01"), RelatedLink(kind: "A06", title: "A link with no text", to: "/errors/A06")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Link") {
                controls {
                    StageControl({ name: "label", kind: "string", options: [], value: "" }, live: true, current: stageLabel) { on pick(v) { stageLabel = v } }
                    StageControl({ name: "active", kind: "enum", options: ["prefix"], value: "", sink: "special" })
                }
                Stack(gap: .sm) {
                    Link(stageLabel, to: "/learn")
                    Link("Every component", to: "/reference", active: .prefix)
                    Link(to: "/recipes") {
                        Icon("book")
                        Text("Recipes for common screens")
                    }
                    Link("The source on GitHub", to: "https://github.com/webfluent/webfluent", target: "_blank")
                }
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"Stack(gap: .sm) {
    Link("Start the guide", to: "/learn")
    Link("Every component", to: "/reference", active: .prefix)
    Link(to: "/recipes") {
        Icon("book")
        Text("Recipes for common screens")
    }
    Link("The source on GitHub", to: "https://github.com/webfluent/webfluent", target: "_blank")
}"#, title: "wf")
        Text("Active on every route beneath it") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"Link("Reference", to: "/reference").prefix"#, title: "wf")
        Text("To a filtered view: active only with its query") { style { margin: 8px 0 0; font-weight: 600 } }
