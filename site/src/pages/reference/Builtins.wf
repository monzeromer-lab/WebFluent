page BuiltinInputotp(path: "/reference/inputotp", title: "InputOTP — Reference", description: "InputOTP: A one-time code typed a digit to a box: the focus moves on as each is typed and back with Backspace, and a code pasted into any box fills…") {
    state code = ""
    derived left = 6 - code.length
    state stageLength = 6
    state stageLabel = "Code from your authenticator app"
