    IndexEntry(label: "Design tokens", to: "/reference/tokens", group: "Tools"),
    IndexEntry(label: "Project structure", to: "/reference/project", group: "Tools"),
    IndexEntry(label: "Browser support", to: "/reference/browser-support", group: "Tools"),
    IndexEntry(label: "Glossary", to: "/reference/glossary", group: "Tools"),
    IndexEntry(label: "Library", to: "/reference/library", group: "Tools"),
    IndexEntry(label: "Editors", to: "/reference/editors", group: "Tools")
]

