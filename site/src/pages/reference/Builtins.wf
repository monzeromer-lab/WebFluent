                Text("A step in the list. Drawn for it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/commandpalette", class: "bp-card") {
                Text("CommandPalette", class: "bp-mono") { style { font-size: 14px; color: $link } }
