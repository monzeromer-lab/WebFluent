            Link(to: "/reference/stepper", class: "bp-card") {
                Text("Stepper", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Steps taken in order — an account, then billing, then a summary — with each step's state (done, current, an error) and the current step's block shown. bind: holds the current step, from 0; .linear keeps a step out of reach until the ones before it are passed.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/stepper-step", class: "bp-card") {
                Text("Stepper.Step", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One step: its title in the list, its block shown while it is the current one.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
