page BuiltinInput(path: "/reference/input", title: "Input — Reference", description: "Input: Text field. With label, hint or error it is a labelled field.") {
    state name = "Ada Lovelace"
    state email = ""
    state stageLabel = "Full name"
    state stagePlaceholder = "Ada Lovelace"
    ReferenceItemShell("Input", summary: "Text field. With label, hint or error it is a labelled field.", signature: "Input(reveal: Bool, bind: State, label: String, …)", older: true, outputs: [], group: "Form", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "E109", title: "An element this output cannot draw", to: "/errors/E109"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05"), RelatedLink(kind: "F01", title: "A bind: to something that cannot be written", to: "/errors/F01"), RelatedLink(kind: "F02", title: "A bind: to a state the control cannot hold", to: "/errors/F02"), RelatedLink(kind: "F03", title: "A validate block no control can satisfy", to: "/errors/F03"), RelatedLink(kind: "A03", title: "An input with no label", to: "/errors/A03")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Input") {
                controls {
                    StageControl({ name: "reveal", kind: "bool", options: [], value: "", sink: "special" })
                    StageControl({ name: "label", kind: "string", options: [], value: "" }, live: true, current: stageLabel) { on pick(v) { stageLabel = v } }
                    StageControl({ name: "hint", kind: "string", options: [], value: "" })
                    StageControl({ name: "error", kind: "string", options: [], value: "" })
                    StageControl({ name: "type", kind: "enum", options: ["text", "email", "password", "number", "search"], value: "text", sink: "attribute" })
                    StageControl({ name: "placeholder", kind: "string", options: [], value: "" }, live: true, current: stagePlaceholder) { on pick(v) { stagePlaceholder = v } }
                }
                Stack(gap: .md) {
                    Input(bind: name, label: stageLabel, placeholder: stagePlaceholder).text
                    Input(bind: email, label: "Work email", hint: "We send the invoice here.", placeholder: "ada@example.com").email.required
                    Text(if email == "" { "Hello, {name}" } else { "Hello, {name}: we write to {email}" }).muted
                }
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"state name = "Ada Lovelace"
state email = ""
Stack(gap: .md) {
    Input(bind: name, label: "Full name", placeholder: "Ada Lovelace").text
    Input(bind: email, label: "Work email", hint: "We send the invoice here.", placeholder: "ada@example.com").email.required
    Text(if email == "" { "Hello, {name}" } else { "Hello, {name}: we write to {email}" }).muted
}"#, title: "wf")
        Text("A password with a button that shows it") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"state password = ""
Input(bind: password, label: "Password", hint: "At least 12 characters").password.reveal"#, title: "wf")
        Text("With an error message") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"state handle = "ada lovelace"
derived handleError = if handle.includes(" ") { "A handle has no spaces." } else { "" }
Input(bind: handle, label: "Handle", error: handleError).text"#, title: "wf")
        Text("A number between two ends") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"state seats = 5
Input(bind: seats, label: "Seats", min: 1, max: 50, step: 1).number
Text("{seats} seats")"#, title: "wf")
        Text("Disabled") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"state workspace = "acme-prod"
Input(bind: workspace, label: "Workspace", hint: "Ask an owner to rename it.").disabled"#, title: "wf")
        Row(gap: .sm, align: .center) {
