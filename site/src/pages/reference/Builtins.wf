            Text(t("ref.related"), class: "bp-small")
            Link("Navbar", to: "/reference/navbar", class: "bp-label bp-mono")
            Link("Sidebar", to: "/reference/sidebar", class: "bp-label bp-mono")
            Link("AppShell", to: "/reference/appshell", class: "bp-label bp-mono")
            Link("BottomNavigation", to: "/reference/bottomnavigation", class: "bp-label bp-mono")
            Link("Breadcrumb", to: "/reference/breadcrumb", class: "bp-label bp-mono")
            Link("Tabs", to: "/reference/tabs", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "label", type: "String (positional)", meaning: "The link's words; a block written after it may be its content instead", default: "none" }, { name: "to:", type: "Path", meaning: "The route or address it goes to, navigated in place; while it matches the current route the link carries `.active` and `aria-current=\"page\"`", default: "none" }, { name: "active:", type: "one of its cases", meaning: "How it decides it is the current page: unset, the route must equal `to`; `.prefix` also matches routes beneath it. Written as a flag, `.prefix`, or by name, `active: .prefix`.\n\n- `.prefix`: Also current on every route beneath `to`: `/docs` for `/docs/forms`", default: "exact match" }], caption: "Props of Link", defaults: true)
