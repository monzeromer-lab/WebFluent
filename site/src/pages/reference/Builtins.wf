            Link(to: "/reference/commandpalette-list", class: "bp-card") {
                Text("CommandPalette.List", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("What matches. Drawn for it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Routing", id: "routing").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
