page BuiltinButton(path: "/reference/button", title: "Button — Reference", description: "Button: A button: its label or block is what it shows, on click what it does.") {
    state saved = 0
    state stageLabel = "Cancel"
    state stageTone = ""
    state stageSize = "md"
    state stageShape = ""
    state stageWidth = ""
    state stageOutlined = true
    ReferenceItemShell("Button", summary: "A button: its label or block is what it shows, on click what it does.", signature: "Button(_ label: String, tone: Enum, size: Enum, shape: Enum, …) \{ … \}", older: true, outputs: [], group: "Actions", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "E109", title: "An element this output cannot draw", to: "/errors/E109"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "A05", title: "A button with no text", to: "/errors/A05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Button") {
                controls {
                    StageControl({ name: "label", kind: "string", options: [], value: "" }, live: true, current: stageLabel) { on pick(v) { stageLabel = v } }
                    StageControl({ name: "tone", kind: "enum", options: ["primary", "secondary", "success", "danger", "warning"], value: "", sink: "class" }, live: true, current: stageTone) { on pick(v) { stageTone = v } }
                    StageControl({ name: "size", kind: "enum", options: ["sm", "md", "lg"], value: "md", sink: "class" }, live: true, current: stageSize) { on pick(v) { stageSize = v } }
                    StageControl({ name: "shape", kind: "enum", options: ["rounded", "pill"], value: "", sink: "class" }, live: true, current: stageShape) { on pick(v) { stageShape = v } }
                    StageControl({ name: "width", kind: "enum", options: ["full"], value: "", sink: "class" }, live: true, current: stageWidth) { on pick(v) { stageWidth = v } }
                    StageControl({ name: "outlined", kind: "bool", options: [], value: "", sink: "class" }, live: true, pressed: stageOutlined) { on pick(v) { stageOutlined = !stageOutlined } }
                }
                Row(gap: .sm, justify: .end) {
                    Button(stageLabel, tone: stageTone, size: stageSize, shape: stageShape, width: stageWidth, outlined: stageOutlined)
                    Button("Save draft") { on click { saved = saved + 1 } }
                    Button("Publish").primary { on click { toast("Published", tone: .success) } }
                }
                Text("Saved {saved} times").muted
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"state saved = 0
Row(gap: .sm, justify: .end) {
    Button("Cancel").outlined
    Button("Save draft") { on click { saved = saved + 1 } }
    Button("Publish").primary { on click { toast("Published", tone: .success) } }
}
Text("Saved {saved} times").muted"#, title: "wf")
        Text("Tones") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"Row(gap: .sm) {
    Button("Primary").primary
    Button("Secondary").secondary
    Button("Success").success
    Button("Danger").danger
    Button("Warning").warning
    Button("Info").info
}"#, title: "wf")
        Text("Sizes, shapes and widths") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"Stack(gap: .sm) {
    Row(gap: .sm, align: .center) {
        Button("Small").sm
        Button("Default")
        Button("Large").lg
    }
    Row(gap: .sm) { Button("Rounded").rounded  Button("Pill").pill.primary  Button("Outlined").outlined.danger }
    Button("Continue to checkout").primary.full
}"#, title: "wf")
        Text("Busy and disabled") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"state agreed = false
Checkbox(bind: agreed, label: "I agree to the terms")
Row(gap: .sm) {
    Button("Create account", disabled: !agreed).primary
    Button("Saving", loading: true)
}"#, title: "wf")
        Text("A link and a submit") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"state email = ""
Form {
    on submit { toast("Subscribed") }
    Input(bind: email, label: "Email").email
    Row(gap: .sm) {
        Button("Subscribe", type: .submit).primary
        Button("Read the guide", to: "/learn").outlined
    }
}"#, title: "wf")
        Row(gap: .sm, align: .center) {
            style { gap: 8px; flex-wrap: wrap; margin-top: 8px }
