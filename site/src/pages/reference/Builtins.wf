page ReferenceIndexPage(path: "/reference", title: "Reference", description: "Every built-in element, command, setting and design token, read from the compiler itself, with the language's reference pages.") {
    ReferenceItemShell(t("nav.reference"), summary: t("ref.lede", { count: 111 }), entries: REFERENCE_PAGES, sections: [Anchor(id: "pages", label: t("ref.pages")), Anchor(id: "layout", label: "Layout"), Anchor(id: "navigation", label: "Navigation"), Anchor(id: "routing", label: "Routing"), Anchor(id: "data-display", label: "Data display"), Anchor(id: "form", label: "Form"), Anchor(id: "feedback", label: "Feedback"), Anchor(id: "actions", label: "Actions"), Anchor(id: "media", label: "Media"), Anchor(id: "typography", label: "Typography"), Anchor(id: "pdf", label: "PDF"), Anchor(id: "slides", label: "Slides"), Anchor(id: "original-spellings", label: "Original spellings"), Anchor(id: "on-every-element", label: t("ref.universal.title"))], source: "scripts/docsite/reference.py") {
        Heading(t("ref.pages"), id: "pages").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/expressions", class: "bp-card") { Text("Expressions") { style { font-weight: 600 } }  Text("Language", class: "bp-small") }
            Link(to: "/reference/built-ins", class: "bp-card") { Text("Built-in functions and values") { style { font-weight: 600 } }  Text("Language", class: "bp-small") }
            Link(to: "/reference/grammar", class: "bp-card") { Text("Grammar") { style { font-weight: 600 } }  Text("Language", class: "bp-small") }
            Link(to: "/reference/runtime", class: "bp-card") { Text("Runtime API") { style { font-weight: 600 } }  Text("Language", class: "bp-small") }
            Link(to: "/reference/cli", class: "bp-card") { Text("Command line") { style { font-weight: 600 } }  Text("Tools", class: "bp-small") }
            Link(to: "/reference/config", class: "bp-card") { Text("Configuration") { style { font-weight: 600 } }  Text("Tools", class: "bp-small") }
            Link(to: "/reference/tokens", class: "bp-card") { Text("Design tokens") { style { font-weight: 600 } }  Text("Tools", class: "bp-small") }
            Link(to: "/reference/project", class: "bp-card") { Text("Project structure") { style { font-weight: 600 } }  Text("Tools", class: "bp-small") }
            Link(to: "/reference/browser-support", class: "bp-card") { Text("Browser support") { style { font-weight: 600 } }  Text("Tools", class: "bp-small") }
            Link(to: "/reference/glossary", class: "bp-card") { Text("Glossary") { style { font-weight: 600 } }  Text("Tools", class: "bp-small") }
            Link(to: "/reference/library", class: "bp-card") { Text("Library") { style { font-weight: 600 } }  Text("Tools", class: "bp-small") }
            Link(to: "/reference/editors", class: "bp-card") { Text("Editors") { style { font-weight: 600 } }  Text("Tools", class: "bp-small") }
        }
        Heading("Layout", id: "layout").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/container", class: "bp-card") {
                Text("Container", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Centred wrapper with a maximum width and horizontal padding.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/row", class: "bp-card") {
                Text("Row", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Horizontal flex layout. It stays a row at every width unless .stacks or a responsive direction says otherwise.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/column", class: "bp-card") {
                Text("Column", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A child of the 12-column grid, spanning span columns.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/grid", class: "bp-card") {
                Text("Grid", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("CSS grid with a fixed number of columns.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/stack", class: "bp-card") {
                Text("Stack", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Vertical flex layout.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/spacer", class: "bp-card") {
                Text("Spacer", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Vertical space; md when no size is given.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/virtuallist", class: "bp-card") {
                Text("VirtualList", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A scrolling box that draws only the rows in view of the one keyed for inside it — for a tree, search results or a diff of thousands of rows.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/splitter", class: "bp-card") {
                Text("Splitter", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A handle that sets the size of a region beside it: dragged, between min: and max:; double-clicked or Enter, back to reset:; the arrow keys move it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/divider", class: "bp-card") {
                Text("Divider", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Horizontal rule.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/host", class: "bp-card") {
                Text("Host", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A bare node handed to somebody else's code, with a lifetime. mount: runs with the node each time it is made, update: again whenever the state it reads changes, and cleanup: when the page, branch or list item it belongs to leaves. Every other element takes the same three.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/portal", class: "bp-card") {
                Text("Portal", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Its block, drawn into a node somebody else's code owns: an element a script hands over, or a ref: handle. When into: names another node the block moves there with its nodes and state; null keeps it aside until a node comes back; it goes when the page, branch or list item it is written in leaves. What is inside belongs to where it is written: its handlers, emit and lifetimes.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/element", class: "bp-card") {
                Text("Element", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A custom element a script defines, placed by its tag: Element(\"stripe-pricing-table\", publishable-key: key) \{ on ready \{ … \} \}. Every named argument is an attribute, every on handler an event it fires, and the block its children.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Navigation", id: "navigation").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/navbar", class: "bp-card") {
                Text("Navbar", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Top navigation bar with brand, links and action areas.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/navbar-brand", class: "bp-card") {
                Text("Navbar.Brand", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The brand area, usually a link home.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/navbar-links", class: "bp-card") {
                Text("Navbar.Links", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The navigation links; collapses behind a toggle on small screens.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/navbar-actions", class: "bp-card") {
                Text("Navbar.Actions", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Buttons at the end of the bar.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/sidebar", class: "bp-card") {
                Text("Sidebar", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Side navigation. A Sidebar.Item whose to matches the current route is marked .active and aria-current=\"page\".", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/sidebar-header", class: "bp-card") {
                Text("Sidebar.Header", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The sidebar's heading area.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/sidebar-item", class: "bp-card") {
                Text("Sidebar.Item", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One navigation entry.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/sidebar-divider", class: "bp-card") {
                Text("Sidebar.Divider", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A rule between groups of items.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/link", class: "bp-card") {
                Text("Link", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Client-side navigation link; its label or its block is the link text.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/tabs", class: "bp-card") {
                Text("Tabs", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Tab strip switching between its pages.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/tabs-page", class: "bp-card") {
                Text("Tabs.Page", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One tab and its panel.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/breadcrumb", class: "bp-card") {
                Text("Breadcrumb", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Breadcrumb trail. An item without to is the current page.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/breadcrumb-item", class: "bp-card") {
                Text("Breadcrumb.Item", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One step of the trail.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/menu", class: "bp-card") {
                Text("Menu", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A menu above everything: opened by its trigger: button, or by visible: at an anchor: or a point at: — a context menu. Escape, a press outside or a choice close it, write false back to visible: and fire on close.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/menu-item", class: "bp-card") {
                Text("Menu.Item", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One entry of the menu; on click is what choosing it does.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/menu-sub", class: "bp-card") {
                Text("Menu.Sub", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("An entry that opens a menu of its own beside it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/menu-divider", class: "bp-card") {
                Text("Menu.Divider", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A rule between groups of entries.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Routing", id: "routing").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/router", class: "bp-card") {
                Text("Router", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Where the current page renders. May sit at any depth inside app; pages declare their own paths.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Data display", id: "data-display").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/card", class: "bp-card") {
                Text("Card", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Card surface with optional header, body and footer sections.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/card-header", class: "bp-card") {
                Text("Card.Header", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The card's heading area.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/card-body", class: "bp-card") {
                Text("Card.Body", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The card's content area.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/card-footer", class: "bp-card") {
                Text("Card.Footer", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The card's action area.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/table", class: "bp-card") {
                Text("Table", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Data table. Cells inside Table.Head render as <th scope=\"col\">; caption is the table's accessible name, visually hidden.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/table-head", class: "bp-card") {
                Text("Table.Head", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Header section; its cells become <th scope=\"col\">.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/table-body", class: "bp-card") {
                Text("Table.Body", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Body section.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/table-row", class: "bp-card") {
                Text("Table.Row", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A row.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/table-cell", class: "bp-card") {
                Text("Table.Cell", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A cell. header makes it a <th> anywhere, as Table.Head does for its cells.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/list", class: "bp-card") {
                Text("List", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("List of its children; ordered for a numbered list.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/list-item", class: "bp-card") {
                Text("List.Item", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One entry (<li>).", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/badge", class: "bp-card") {
                Text("Badge", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Small status label.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/tag", class: "bp-card") {
                Text("Tag", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Compact chip.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/avatar", class: "bp-card") {
                Text("Avatar", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A picture of a person, or their initials.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/tooltip", class: "bp-card") {
                Text("Tooltip", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Shows text above everything when its child is hovered (after delay:) or focused from the keyboard.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/chart", class: "bp-card") {
                Text("Chart", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A chart drawn as vector graphics when the page is built: bars, lines, areas, a pie or a donut over a list of records.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/qrcode", class: "bp-card") {
                Text("QrCode", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A QR code for a URL or any text, drawn as vector graphics when the page is built.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Form", id: "form").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/input", class: "bp-card") {
                Text("Input", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Text field. With label, hint or error it is a labelled field.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/select", class: "bp-card") {
                Text("Select", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Drop-down of Select.Option children.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/select-option", class: "bp-card") {
                Text("Select.Option", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One choice: the visible label, and the value sent with the form.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/checkbox", class: "bp-card") {
                Text("Checkbox", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Checkbox bound to a boolean state.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/radio", class: "bp-card") {
                Text("Radio", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One choice of a group; every radio bound to the same state is one group.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/switch", class: "bp-card") {
                Text("Switch", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("On/off toggle bound to a boolean state.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/slider", class: "bp-card") {
                Text("Slider", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Range input. aria-* and its other attributes reach the input; with aria-valuetext the raw number is not shown beside the track.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/datepicker", class: "bp-card") {
                Text("DatePicker", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Date input.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/fileupload", class: "bp-card") {
                Text("FileUpload", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("File input; handle the chosen files in on change.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/form", class: "bp-card") {
                Text("Form", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Groups controls; on submit runs when it is submitted, and the page never navigates away.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/textarea", class: "bp-card") {
                Text("Textarea", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Several lines of text. With label, hint or error it is a labelled field; with maxLength it counts what is left.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Feedback", id: "feedback").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/alert", class: "bp-card") {
                Text("Alert", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Inline notice; a danger or warning one is announced as an alert.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/toast", class: "bp-card") {
                Text("Toast", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Temporary notification.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/modal", class: "bp-card") {
                Text("Modal", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Modal <dialog>, opened by a state flag; the browser supplies focus trapping and Escape. on close runs when it closes, however it was closed.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/modal-title", class: "bp-card") {
                Text("Modal.Title", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("What the modal's heading draws, in place of its title:'s words, which stay its name: Modal.Title \{ Text \{ \"Rename \"  Code(name) \} \}.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/modal-footer", class: "bp-card") {
                Text("Modal.Footer", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The modal's action row.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/popover", class: "bp-card") {
                Text("Popover", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A layer at a control: drawn above everything, placed against its anchor:, closed by Escape or a press outside, which write false back to visible: and fire on close.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/dialog", class: "bp-card") {
                Text("Dialog", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Confirmation <dialog>, opened by a state flag. on close runs when it closes, however it was closed.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/dialog-title", class: "bp-card") {
                Text("Dialog.Title", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("What the dialog's heading draws, in place of its title:'s words, which stay its name.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/spinner", class: "bp-card") {
                Text("Spinner", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Loading indicator, announced as a status.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/progress", class: "bp-card") {
                Text("Progress", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Progress bar; a value that reads state moves with it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/skeleton", class: "bp-card") {
                Text("Skeleton", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Placeholder shape shown while content loads.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Actions", id: "actions").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/button", class: "bp-card") {
                Text("Button", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Button. Its block holds what it shows; on click what it does.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/iconbutton", class: "bp-card") {
                Text("IconButton", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Icon-only button. label is its accessible name, never visible text.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/buttongroup", class: "bp-card") {
                Text("ButtonGroup", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Buttons joined into one row.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/dropdown", class: "bp-card") {
                Text("Dropdown", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Button that opens a menu of Dropdown.Items.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/dropdown-item", class: "bp-card") {
                Text("Dropdown.Item", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One entry of the menu.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/dropdown-divider", class: "bp-card") {
                Text("Dropdown.Divider", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A rule between groups of entries.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Media", id: "media").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/image", class: "bp-card") {
                Text("Image", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Image; alt is required for accessibility (rule A01). Given an image the program declares, it becomes a <picture> with every width the build wrote.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/video", class: "bp-card") {
                Text("Video", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Video player. Without captions it draws an A09 warning: a video nobody can hear is a video nobody can follow.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/audio", class: "bp-card") {
                Text("Audio", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Audio player. transcript links what was said, which is what a reader who cannot hear it needs.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/frame", class: "bp-card") {
                Text("Frame", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Another page, shown inside this one: an iframe — the page at src:, or the HTML srcdoc: gives it, sandboxed as sandbox: says. on message(m) hears what that page posts to this one (m.data), and nothing any other page posts. Without title: it draws an A17 warning: a frame is announced by its title.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/icon", class: "bp-card") {
                Text("Icon", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One of the built-in SVG icons, rendered inline.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/carousel", class: "bp-card") {
                Text("Carousel", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Slide track with named controls and dots; optional autoplay.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/carousel-slide", class: "bp-card") {
                Text("Carousel.Slide", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One slide.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Typography", id: "typography").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/text", class: "bp-card") {
                Text("Text", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A paragraph of text. \{…\} in the string reads state and stays live.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/heading", class: "bp-card") {
                Text("Heading", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Heading; level picks the tag (h2 when none is given).", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/code", class: "bp-card") {
                Text("Code", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Inline code, or a code block with block; language: colours it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/markdown", class: "bp-card") {
                Text("Markdown", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Markdown text rendered as HTML: headings, paragraphs, lists, quotes, code, links, emphasis. The text is escaped first, so HTML in it is shown, not run, and a link or picture whose URL a browser would run is drawn as its words. .inert is for text somebody else wrote.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/unsafe", class: "bp-card") {
                Text("Unsafe", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The one door for markup a page did not write. It has a single part, Unsafe.Html.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/unsafe-html", class: "bp-card") {
                Text("Unsafe.Html", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Markup, put in as markup. It is **not** sanitised — the name says so — and sanitize(…) is one call away for anything the project did not write itself.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/blockquote", class: "bp-card") {
                Text("Blockquote", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Quotation: the text, or its block as the quoted content.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("PDF", id: "pdf").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/tableofcontents", class: "bp-card") {
                Text("TableOfContents", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The document's headings with the page each lands on, each a link to it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/document", class: "bp-card") {
                Text("Document", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Root of a PDF document: the paper, the margins and what the file says about itself.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/section", class: "bp-card") {
                Text("Section", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Groups content with spacing; on the web, a <section>.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/paragraph", class: "bp-card") {
                Text("Paragraph", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Block of text with paragraph spacing.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/header", class: "bp-card") {
                Text("Header", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Repeated at the top of every PDF page (or those on: names), where page and pages are the page's number and the count; a <header> on the web.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/footer", class: "bp-card") {
                Text("Footer", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Repeated at the bottom of every PDF page (or those on: names), where page and pages are the page's number and the count; a <footer> on the web.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/background", class: "bp-card") {
                Text("Background", class: "bp-mono") { style { font-size: 14px; color: $link } }
