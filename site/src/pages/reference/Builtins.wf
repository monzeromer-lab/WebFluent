page BuiltinImage(path: "/reference/image", title: "Image — Reference", description: "Image: Image; alt is required for accessibility (rule A01). Given an image the program declares, it becomes a <picture> with every width the build wrote.") {
    state stageSrc = "/og.png"
    state stageSizes = "(max-width: 768px) 100vw, 640px"
    state stageAlt = "WebFluent's sharing card: the name over a dark field"
    ReferenceItemShell("Image", summary: "Image; alt is required for accessibility (rule A01). Given an image the program declares, it becomes a <picture> with every width the build wrote.", signature: "Image(_ source: Picture or String, src: String, sizes: String, placeholder: Enum, …)", older: true, outputs: [], group: "Media", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "R04", title: "A relative URL on a nested route", to: "/errors/R04"), RelatedLink(kind: "D01", title: "A file the project does not have", to: "/errors/D01"), RelatedLink(kind: "A01", title: "An image with no alt text", to: "/errors/A01")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Image") {
                controls {
                    StageControl({ name: "src", kind: "string", options: [], value: "" }, live: true, current: stageSrc) { on pick(v) { stageSrc = v } }
                    StageControl({ name: "sizes", kind: "string", options: [], value: "" }, live: true, current: stageSizes) { on pick(v) { stageSizes = v } }
                    StageControl({ name: "placeholder", kind: "enum", options: ["blur", "color", "none"], value: "none", sink: "special" })
                    StageControl({ name: "alt", kind: "string", options: [], value: "" }, live: true, current: stageAlt) { on pick(v) { stageAlt = v } }
                    StageControl({ name: "width", kind: "number", options: [], value: "" })
                    StageControl({ name: "height", kind: "number", options: [], value: "" })
                }
                Stack(gap: .md) {
                    Image(placeholder: .blur, src: stageSrc, sizes: stageSizes, alt: stageAlt).rounded
                    Row(gap: .md, align: .center) {
                        Image(src: "/icon-512.png", alt: "The app icon", width: 64, height: 64).circle
                        Text("Pictures from public/ are resized to WebP at every width a page asks for.").muted.sm
                    }
                }
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"Stack(gap: .md) {
    Image(src: "/og.png", alt: "WebFluent's sharing card: the name over a dark field",
          sizes: "(max-width: 768px) 100vw, 640px", placeholder: .blur).rounded
    Row(gap: .md, align: .center) {
        Image(src: "/icon-512.png", alt: "The app icon", width: 64, height: 64).circle
        Text("Pictures from public/ are resized to WebP at every width a page asks for.").muted.sm
    }
}"#, title: "wf")
        Text("Decorative: an empty alt, so a screen reader skips it") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"Image(src: "/icon-512.png", alt: "", width: 32, height: 32)"#, title: "wf")
        Text("The average colour while it loads, and loaded at once") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"Image(src: "/og.png", alt: "The sharing card", placeholder: .color, loading: .eager)"#, title: "wf")
        Text("From an address elsewhere: used as written") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"Image(src: "https://example.com/team.jpg", alt: "The team at the launch", width: 1200, height: 630).lazy"#, title: "wf")
        Row(gap: .sm, align: .center) {
            style { gap: 8px; flex-wrap: wrap; margin-top: 8px }
            Text(t("ref.related"), class: "bp-small")
            Link("Gallery", to: "/reference/gallery", class: "bp-label bp-mono")
            Link("Lightbox", to: "/reference/lightbox", class: "bp-label bp-mono")
            Link("Carousel", to: "/reference/carousel", class: "bp-label bp-mono")
            Link("Video", to: "/reference/video", class: "bp-label bp-mono")
            Link("Audio", to: "/reference/audio", class: "bp-label bp-mono")
            Link("Frame", to: "/reference/frame", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "source", type: "Picture or String (positional)", meaning: "An `image` the program declares (a `<picture>` at every width the build wrote), or a URL", default: "none" }, { name: "src:", type: "String", meaning: "The picture's address. A literal path of `public/` to a PNG, JPEG, GIF or WebP is processed by the build like an `image`; an SVG, a URL or a `data:image/…` is used as written", default: "none" }, { name: "sizes:", type: "String", meaning: "How wide it will be shown, so the browser picks one of the widths the build wrote: `(max-width: 768px) 100vw, 1200px`; for a processed picture", default: "none: the browser assumes the full window width" }, { name: "placeholder:", type: "one of its cases", meaning: "What fills the box of a processed picture while it loads, cleared when it lands. Written as a flag, `.blur`, or by name, `placeholder: .blur`.\n\n- `.blur`: A 16-pixel-wide blurred copy, inlined in the page\n- `.color`: The picture's average colour\n- `.none` (the default): Nothing (the default)", default: "`none`" }, { name: "alt:", type: "String", meaning: "Text alternative; `\"\"` for a purely decorative image (`A01` when left out)", default: "none (`\"\"` on a processed picture)" }, { name: "width:", type: "Number", meaning: "The `<img>`'s `width` in px, so its box is reserved before it loads; ignored on a processed picture, which carries the file's real size", default: "none" }, { name: "height:", type: "Number", meaning: "The `<img>`'s `height` in px, so its box is reserved before it loads; ignored on a processed picture, which carries the file's real size", default: "none" }, { name: "loading:", type: "one of its cases", meaning: "When the browser fetches it. Written as a flag, `.lazy`, or by name, `loading: .lazy`.\n\n- `.lazy`: When it nears the viewport\n- `.eager`: At once", default: "the page's first image `eager` at high priority, the rest `lazy`" }, { name: "shape:", type: "one of its cases", meaning: "Its corners. Written as a flag, `.rounded`, or by name, `shape: .rounded`.\n\n- `.rounded`: Rounded corners (`radius-md`)\n- `.circle`: Clipped to a circle (an ellipse, unless it is square)", default: "none: square corners" }], caption: "Props of Image", defaults: true)
        Markdown(t("ref.attrs", { families: "global, aria, data", n: 22, props: "`animate:`, `exit:`, `speed:`, `duration:`, `delay:`, `easing:`, `stagger:`, `on:`, `count:`, `shared:`, `class:`, `ref:`, `drag:`, `dragGroup:`, `dropValue:`, `dropAxis:`, `dropInside:`, `roving:`, `trapFocus:`, `mount:`, `update:`, `cleanup:`" }), class: "bp-prose")
        Heading(t("ref.tab.flags"), id: "flags").h2
        Markdown(t("ref.flags.body"), class: "bp-prose")
        Row(gap: .sm) {
            style { gap: 8px; flex-wrap: wrap }
            Text(".blur", class: "bp-label bp-mono")
            Text(".color", class: "bp-label bp-mono")
            Text(".none", class: "bp-label bp-mono")
            Text(".lazy", class: "bp-label bp-mono")
            Text(".eager", class: "bp-label bp-mono")
            Text(".rounded", class: "bp-label bp-mono")
            Text(".circle", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.events"), id: "events").h2
        Markdown(t("ref.domevents"), class: "bp-prose")
        EventsTable(rows: [PropRow(name: "load", kind: "DOM", detail: "An image, video or frame finished loading"), PropRow(name: "error", kind: "DOM", detail: "An image, video or script failed to load")], caption: "DOM events Image answers")
        Markdown(t("ref.universal.link"), class: "bp-prose")
        Heading(t("ref.slots"), id: "slots").h2
        SlotsTable(slots: [])
        Markdown(t("ref.renders", { cls: "wf-image" }), class: "bp-prose")
    }
}

