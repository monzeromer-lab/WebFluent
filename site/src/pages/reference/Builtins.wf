            Link(to: "/reference/listbox", class: "bp-card") {
                Text("Listbox", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A list of options always shown, one chosen (selection follows the arrow keys) or, .multiple, several: Space chooses, Shift with an arrow takes the next one in too, Ctrl or ⌘ with A takes them all; a letter goes to the next option that starts with it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/listbox-option", class: "bp-card") {
                Text("Listbox.Option", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One option: its words, and the value bind: holds when it is chosen.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/combobox", class: "bp-card") {
                Text("Combobox", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A text field that offers what matches as the reader types: from options:, or search: asked of a server. The arrow keys go through the offers, Enter takes one, Escape closes them; .multiple keeps several, each a chip Backspace takes back. option(o) \{ … \} draws an offer; empty \{ … \} shows when nothing matches.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/checkboxgroup", class: "bp-card") {
                Text("CheckboxGroup", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Check boxes under a legend whose bind: is the list of the values ticked, with all: a box above them for every one at once — ticked when all are, mixed when some are.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/checkboxgroup-option", class: "bp-card") {
                Text("CheckboxGroup.Option", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One box: its words and its value.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/checkboxgroup-legend", class: "bp-card") {
                Text("CheckboxGroup.Legend", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Its legend. Drawn for it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/inputotp", class: "bp-card") {
                Text("InputOTP", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A one-time code typed a digit to a box: the focus moves on as each is typed and back with Backspace, and a code pasted into any box fills them all; the browser offers the code it was sent (autocomplete=\"one-time-code\").", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/taginput", class: "bp-card") {
                Text("TagInput", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Words typed into a field, each a chip once Enter or a comma ends it; Backspace in the empty field takes the last back, and each chip has a button to take it out.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/rating", class: "bp-card") {
                Text("Rating", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Stars, as radio buttons a screen reader hears as a choice of one to max:: the arrow keys move between them; .half takes halves; .readonly only shows.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/daterangepicker", class: "bp-card") {
                Text("DateRangePicker", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A first and a last day, chosen in two months side by side that a button opens, or by a preset: presets: [.last7, .thisMonth]. bind: holds \{ start, end \}.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Feedback", id: "feedback").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/hovercard", class: "bp-card") {
                Text("HoverCard", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A preview card at a link or a button: shown after delay: ms of hover, at once on focus; it stays while the pointer is on it, and goes when the pointer leaves both, on Escape or on a press outside.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/hovercard-content", class: "bp-card") {
                Text("HoverCard.Content", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("What the card shows. The rest of the block is what it is at.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/loadingoverlay", class: "bp-card") {
                Text("LoadingOverlay", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A region covered while it is busy: aria-busy on it, its content out of reach, and a spinner with label: over it — the region, not the page.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/loadingoverlay-content", class: "bp-card") {
                Text("LoadingOverlay.Content", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The region. Drawn for it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/loadingoverlay-cover", class: "bp-card") {
                Text("LoadingOverlay.Cover", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("What covers it while it is busy. Drawn for it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/tour", class: "bp-card") {
                Text("Tour", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A tour of the page while open: holds: each step in a card at its target: (a ref:), lit through a cut-out in the dimmed page, with Back, Next and Done; Escape ends it and writes false back. on finish hears Done, on close any end.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/tour-step", class: "bp-card") {
                Text("Tour.Step", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One step: what it points at, its title, and its block.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/consentbanner", class: "bp-card") {
                Text("ConsentBanner", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The reader's say over the scripts that track them: shown until they choose, Decline as easy as Accept, and the choice kept. Accepting loads the meta.scripts entries marked \"load\": \"consent\", then and on every later visit; nothing loads before.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/alert", class: "bp-card") {
                Text("Alert", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Inline notice; a danger or warning one is announced as an alert.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/toast", class: "bp-card") {
                Text("Toast", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Temporary notification.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/modal", class: "bp-card") {
                Text("Modal", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Modal <dialog>, opened by a state flag; the browser supplies focus trapping and Escape. on close runs when it closes, however it was closed, and the focus goes back to what had it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/modal-title", class: "bp-card") {
                Text("Modal.Title", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("What the modal's heading draws, in place of its title:'s words, which stay its name: Modal.Title \{ Text \{ \"Rename \"  Code(name) \} \}.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/modal-footer", class: "bp-card") {
                Text("Modal.Footer", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The modal's action row.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/popover", class: "bp-card") {
                Text("Popover", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A layer at a control: drawn above everything, placed against its anchor:, closed by Escape or a press outside, which write false back to visible: and fire on close.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/dialog", class: "bp-card") {
                Text("Dialog", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Confirmation <dialog>, opened by a state flag. on close runs when it closes, however it was closed, and the focus goes back to what had it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/dialog-title", class: "bp-card") {
                Text("Dialog.Title", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("What the dialog's heading draws, in place of its title:'s words, which stay its name.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/alertdialog", class: "bp-card") {
                Text("AlertDialog", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A <dialog> that asks before something that cannot be undone: role=\"alertdialog\", its body read out with its title, and closed by Escape or its own buttons, not a press outside. For a question asked from a handler, await ask(…) draws one.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/alertdialog-title", class: "bp-card") {
                Text("AlertDialog.Title", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("What the alert dialog's heading draws, in place of its title:'s words, which stay its name.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/alertdialog-footer", class: "bp-card") {
                Text("AlertDialog.Footer", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Its answers: the button that loses nothing first.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/sheet", class: "bp-card") {
                Text("Sheet", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A modal <dialog> that comes in from an edge: the bottom (a phone's filters, a share list) or the start or end of the line. Dragged by its handle or heading toward its edge it closes; a bottom sheet with snap: points settles at the nearest.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/sheet-title", class: "bp-card") {
                Text("Sheet.Title", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("What the sheet's heading draws, in place of its title:'s words, which stay its name.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/sheet-footer", class: "bp-card") {
                Text("Sheet.Footer", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The sheet's action row, kept in view below what scrolls.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/spinner", class: "bp-card") {
                Text("Spinner", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Loading indicator, announced as a status.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/progress", class: "bp-card") {
                Text("Progress", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Progress bar; a value that reads state moves with it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/skeleton", class: "bp-card") {
                Text("Skeleton", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Placeholder shape shown while content loads.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Actions", id: "actions").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/copybutton", class: "bp-card") {
                Text("CopyButton", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A button that copies value: to the clipboard, says Copied for a moment, and tells a screen reader so.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/themetoggle", class: "bp-card") {
                Text("ThemeToggle", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A button that switches the page between light and dark, over setTheme: a moon in a light page, a sun in a dark one, named for the theme it switches to. The reader's choice is kept.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/localeswitch", class: "bp-card") {
                Text("LocaleSwitch", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One button for each of i18n.locales, each written in its own language (English, العربية), the current one pressed; a press is setLocale.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/toggle", class: "bp-card") {
                Text("Toggle", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A button that stays pressed while its state holds — bold in an editor, a filter that is on: aria-pressed, a press flipping bind:.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/togglegroup", class: "bp-card") {
                Text("ToggleGroup", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Buttons of which one is chosen — a view switcher, a segmented control — or, .multiple, several: one stop for Tab, the arrow keys inside it, each aria-pressed. bind: holds the chosen value: (a list with .multiple).", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/togglegroup-item", class: "bp-card") {
                Text("ToggleGroup.Item", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One choice: its words, and the value bind: holds when it is chosen.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/button", class: "bp-card") {
                Text("Button", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A button: its label or block is what it shows, on click what it does.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/iconbutton", class: "bp-card") {
                Text("IconButton", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Icon-only button. label is its accessible name, never visible text.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/buttongroup", class: "bp-card") {
                Text("ButtonGroup", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Buttons joined into one row.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/dropdown", class: "bp-card") {
                Text("Dropdown", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Button that opens a menu of Dropdown.Items.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/dropdown-item", class: "bp-card") {
                Text("Dropdown.Item", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One entry of the menu.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/dropdown-divider", class: "bp-card") {
                Text("Dropdown.Divider", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A rule between groups of entries.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Media", id: "media").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/lightbox", class: "bp-card") {
                Text("Lightbox", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Every picture in its block opens, on a press or Enter, full screen: the arrow keys and a swipe go between them, a double press or + zooms, Escape closes and the focus goes back. A picture's data-full: is the file it opens, else its largest size.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/image", class: "bp-card") {
                Text("Image", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Image; alt is required for accessibility (rule A01). Given an image the program declares, it becomes a <picture> with every width the build wrote.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/video", class: "bp-card") {
                Text("Video", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Video player. Without captions it draws an A09 warning: a video nobody can hear is a video nobody can follow.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/audio", class: "bp-card") {
                Text("Audio", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Audio player. transcript links what was said, which is what a reader who cannot hear it needs.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/frame", class: "bp-card") {
                Text("Frame", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Another page, shown inside this one: an iframe — the page at src:, or the HTML srcdoc: gives it, sandboxed as sandbox: says. on message(m) hears what that page posts to this one (m.data), and nothing any other page posts. Without title: it draws an A17 warning: a frame is announced by its title.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/icon", class: "bp-card") {
                Text("Icon", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One of the built-in SVG icons, rendered inline.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/carousel", class: "bp-card") {
                Text("Carousel", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Slide track with named controls and dots; optional autoplay.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/carousel-slide", class: "bp-card") {
                Text("Carousel.Slide", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One slide of a carousel.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Typography", id: "typography").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/text", class: "bp-card") {
                Text("Text", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A paragraph of text. \{…\} in the string reads state and stays live.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/heading", class: "bp-card") {
                Text("Heading", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Heading; level picks the tag (h2 when none is given).", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/code", class: "bp-card") {
                Text("Code", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Inline code, or a code block with block; language: colours it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/markdown", class: "bp-card") {
                Text("Markdown", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Markdown text rendered as HTML: headings, paragraphs, lists, quotes, code, links, emphasis. The text is escaped first, so HTML in it is shown, not run, and a link or picture whose URL a browser would run is drawn as its words. .inert is for text somebody else wrote.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/unsafe", class: "bp-card") {
                Text("Unsafe", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The one door for markup a page did not write. It has a single part, Unsafe.Html.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/unsafe-html", class: "bp-card") {
                Text("Unsafe.Html", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Markup, put in as markup. It is **not** sanitised — the name says so — and sanitize(…) is one call away for anything the project did not write itself.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/blockquote", class: "bp-card") {
                Text("Blockquote", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Quotation: the text, or its block as the quoted content.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("PDF", id: "pdf").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/tableofcontents", class: "bp-card") {
                Text("TableOfContents", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The document's headings with the page each lands on, each a link to it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/document", class: "bp-card") {
                Text("Document", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Root of a PDF document: the paper, the margins and what the file says about itself.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/section", class: "bp-card") {
                Text("Section", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Groups content with spacing; on the web, a <section>.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/paragraph", class: "bp-card") {
                Text("Paragraph", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Block of text with paragraph spacing.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/header", class: "bp-card") {
                Text("Header", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Repeated at the top of every PDF page (or those on: names), where page and pages are the page's number and the count; a <header> on the web.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/footer", class: "bp-card") {
                Text("Footer", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Repeated at the bottom of every PDF page (or those on: names), where page and pages are the page's number and the count; a <footer> on the web.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/background", class: "bp-card") {
                Text("Background", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Drawn behind each PDF page's content, the size of the page: a cover, a band, a full-bleed picture.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/watermark", class: "bp-card") {
                Text("Watermark", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Large, faint, rotated text behind each PDF page's content.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/pagebreak", class: "bp-card") {
                Text("PageBreak", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Forces a new PDF page.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Slides", id: "slides").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/presentation", class: "bp-card") {
                Text("Presentation", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Root of a slide deck; its children must be slides.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/slide", class: "bp-card") {
                Text("Slide", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One slide, one PDF page; content is top-aligned and clipped at the bottom margin.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/titleslide", class: "bp-card") {
                Text("TitleSlide", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Cover slide: title and subtitle, vertically centred.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/sectionslide", class: "bp-card") {
                Text("SectionSlide", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Full-bleed coloured band with a centred label.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/twocolumn", class: "bp-card") {
                Text("TwoColumn", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Two equal columns; takes exactly two Container children.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/imageslide", class: "bp-card") {
                Text("ImageSlide", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Image slide with an optional caption.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Original spellings", id: "original-spellings").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/tabpage", class: "bp-card") {
                Text("TabPage", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One tab inside Tabs (the original spelling of Tabs.Page).", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/thead", class: "bp-card") {
                Text("Thead", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Table header section (the original spelling of Table.Head).", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/tbody", class: "bp-card") {
                Text("Tbody", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Table body section (the original spelling of Table.Body).", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/trow", class: "bp-card") {
                Text("Trow", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Table row (the original spelling of Table.Row).", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/tcell", class: "bp-card") {
                Text("Tcell", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Table cell (the original spelling of Table.Cell).", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/option", class: "bp-card") {
                Text("Option", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One choice in a Select (the original spelling of Select.Option).", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/route", class: "bp-card") {
                Text("Route", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Maps a path to a page (the original grammar; pages now declare their paths).", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading(t("ref.universal.title"), id: "on-every-element").h2
        Markdown(t("ref.universal.body"), class: "bp-prose")
        PropsTable(rows: [{ name: "animate:", type: ".fadeIn .fadeOut .slideUp .slideDown .slideLeft .slideRight .scaleIn .scaleOut .bounce .shake .pulse .spin .expand .collapse", meaning: "Animation played when the element appears" }, { name: "exit:", type: ".fadeIn .fadeOut .slideUp .slideDown .slideLeft .slideRight .scaleIn .scaleOut .bounce .shake .pulse .spin .expand .collapse", meaning: "Animation played when the element leaves" }, { name: "speed:", type: ".fast .normal .slow", meaning: "How fast its animation runs" }, { name: "duration:", type: "String", meaning: "Animation length, e.g. `300ms`" }, { name: "delay:", type: "String", meaning: "Wait before the animation starts" }, { name: "easing:", type: ".standard .spring .ease .easeIn .easeOut .easeInOut .linear .bouncy .smooth", meaning: "How the animation is paced — a named easing, or any CSS timing function" }, { name: "stagger:", type: "String", meaning: "Delay added per item of a list, e.g. `50ms`" }, { name: "on:", type: ".mount .enterView", meaning: "When its animation plays" }, { name: "count:", type: "String", meaning: "How long the number it shows takes to count to a new value, e.g. `600ms`" }, { name: "shared:", type: "String", meaning: "A name this element keeps across a route change, so the browser carries it from one page to the next" }, { name: "class:", type: "String", meaning: "Classes added beside the engine's, from the project's own stylesheets" }, { name: "ref:", type: "State", meaning: "A handle on the element, usable as the element: `ref: nameInput`, then `nameInput.focus()`" }, { name: "drag:", type: "Any", meaning: "What it carries when it is picked up — by a mouse moved a few pixels, or a finger held still — and dropped on something with `on receive(d)`" }, { name: "dragGroup:", type: "String", meaning: "Which drops it belongs to: a drag goes only to targets of its own group, so tabs and tree rows stay apart" }, { name: "dropValue:", type: "Any", meaning: "What this target is, as a drag sees it: `d.over` in the drag's `on dragmove(d)` and in `on receive(d)`" }, { name: "dropAxis:", type: ".y .x", meaning: "Which way its list runs, for where a drop lands" }, { name: "dropInside:", type: "Bool", meaning: "A drop on its middle lands inside it — a folder, a container — as well as before or after" }, { name: "roving:", type: ".x .y .both", meaning: "One Tab stop for the group, and the arrow keys, Home, End and the first letters of a name to move inside it: a toolbar, a row of choices, a list" }, { name: "trapFocus:", type: "Bool", meaning: "While true, focus moves into it and Tab and Shift+Tab stay inside; when it turns false or the element leaves, focus goes back where it was" }, { name: "mount:", type: "Any", meaning: "Run with the element each time it is made — `mount: (n) => initTilt(n)` — and what it returns is the handle `update:` and `cleanup:` get" }, { name: "update:", type: "Any", meaning: "Run with the handle again whenever the state it reads changes: `update: (h) => h.setMax(max)`" }, { name: "cleanup:", type: "Any", meaning: "Run with the handle when the element leaves — a route change, an `if` branch, a list item: `cleanup: (h) => h.destroy()`" }], caption: t("ref.universal.title"))
        EventsTable(rows: [PropRow(name: "click", kind: "", detail: "The element was clicked or activated"), PropRow(name: "input", kind: "", detail: "The value changed, on every keystroke"), PropRow(name: "change", kind: "", detail: "The value was committed"), PropRow(name: "submit", kind: "", detail: "The form was submitted"), PropRow(name: "focus", kind: "", detail: "The element received focus"), PropRow(name: "blur", kind: "", detail: "The element lost focus"), PropRow(name: "keydown", kind: "", detail: "A key went down; `e.key` names it"), PropRow(name: "longpress", kind: "", detail: "Held still for half a second; `p.x`, `p.y` say where. The click it ends with is not a click"), PropRow(name: "swipe", kind: "", detail: "A finger or a pen swept across it; `s.direction` is \"left\", \"right\", \"up\" or \"down\""), PropRow(name: "receive", kind: "", detail: "Something with `drag:` was dropped on it; `d.value` is what, `d.position` \"before\", \"after\" or \"inside\""), PropRow(name: "dragmove", kind: "", detail: "On what is dragged, while it moves: `d.over` is the target's `dropValue` or null, `d.position` where it would land"), PropRow(name: "visible", kind: "", detail: "It came into view: scrolled to, or drawn where the reader is looking. `v.ratio` is how much of it shows. A \"load more\" row's cue"), PropRow(name: "key", kind: "", detail: "One key, named: `on key(\"ctrl+k\") \{ \}`"), PropRow(name: "keyup", kind: "", detail: "A key came up"), PropRow(name: "keypress", kind: "", detail: "A character key was pressed"), PropRow(name: "mouseenter", kind: "", detail: "The pointer entered the element"), PropRow(name: "mouseleave", kind: "", detail: "The pointer left the element"), PropRow(name: "dblclick", kind: "", detail: "The element was double-clicked"), PropRow(name: "auxclick", kind: "", detail: "A button other than the main one was clicked; `e.button` is which — 1 is the middle, which closes a tab"), PropRow(name: "focusin", kind: "", detail: "Focus moved onto the element or something inside it"), PropRow(name: "focusout", kind: "", detail: "Focus left the element or something inside it"), PropRow(name: "contextmenu", kind: "", detail: "The context menu was asked for; `e.preventDefault()` keeps the browser's"), PropRow(name: "mousedown", kind: "", detail: "A mouse button went down over the element"), PropRow(name: "mouseup", kind: "", detail: "A mouse button came up over the element"), PropRow(name: "mousemove", kind: "", detail: "The mouse moved over the element"), PropRow(name: "mouseover", kind: "", detail: "The pointer moved onto the element or one of its children"), PropRow(name: "mouseout", kind: "", detail: "The pointer moved off the element or one of its children"), PropRow(name: "pointerdown", kind: "", detail: "A pointer — mouse, pen or touch — went down"), PropRow(name: "pointerup", kind: "", detail: "A pointer came up"), PropRow(name: "pointermove", kind: "", detail: "A pointer moved"), PropRow(name: "pointerenter", kind: "", detail: "A pointer entered the element"), PropRow(name: "pointerleave", kind: "", detail: "A pointer left the element"), PropRow(name: "pointercancel", kind: "", detail: "The browser took the pointer back, for a scroll or a gesture"), PropRow(name: "touchstart", kind: "", detail: "A finger touched the element"), PropRow(name: "touchend", kind: "", detail: "A finger left the element"), PropRow(name: "touchmove", kind: "", detail: "A finger moved across the element"), PropRow(name: "wheel", kind: "", detail: "The wheel or trackpad scrolled over the element"), PropRow(name: "scroll", kind: "", detail: "The element's content scrolled"), PropRow(name: "focusin", kind: "", detail: "The element or something inside it received focus"), PropRow(name: "focusout", kind: "", detail: "The element or something inside it lost focus"), PropRow(name: "reset", kind: "", detail: "The form was reset"), PropRow(name: "invalid", kind: "", detail: "A control failed the browser's own validation"), PropRow(name: "select", kind: "", detail: "Text in a field was selected"), PropRow(name: "copy", kind: "", detail: "Something was copied from the element"), PropRow(name: "cut", kind: "", detail: "Something was cut from the element"), PropRow(name: "paste", kind: "", detail: "Something was pasted into the element; `e.clipboardData` holds it"), PropRow(name: "dragstart", kind: "", detail: "The element started being dragged"), PropRow(name: "drag", kind: "", detail: "The element is being dragged"), PropRow(name: "dragend", kind: "", detail: "A drag of the element ended"), PropRow(name: "dragenter", kind: "", detail: "Something dragged entered the element"), PropRow(name: "dragover", kind: "", detail: "Something dragged is over the element; `e.preventDefault()` allows a drop"), PropRow(name: "dragleave", kind: "", detail: "Something dragged left the element"), PropRow(name: "drop", kind: "", detail: "Something was dropped on the element; `e.dataTransfer` holds it"), PropRow(name: "load", kind: "", detail: "An image, video or frame finished loading"), PropRow(name: "error", kind: "", detail: "An image, video or script failed to load"), PropRow(name: "play", kind: "", detail: "A video or audio started playing"), PropRow(name: "pause", kind: "", detail: "A video or audio paused"), PropRow(name: "ended", kind: "", detail: "A video or audio reached its end"), PropRow(name: "timeupdate", kind: "", detail: "A playing video or audio moved on"), PropRow(name: "animationend", kind: "", detail: "A CSS animation on the element ended"), PropRow(name: "transitionend", kind: "", detail: "A CSS transition on the element ended"), PropRow(name: "toggle", kind: "", detail: "A details element opened or closed")], caption: t("ref.events"))
        Heading(t("ref.icons")).h3 { style { margin: 8px 0 0; font-size: 18px; font-weight: 600 } }
        Text(t("ref.icons.body"), class: "bp-small")
