            Link("RadioGroup", to: "/reference/radiogroup", class: "bp-label bp-mono")
            Link("Radio", to: "/reference/radio", class: "bp-label bp-mono")
            Link("CheckboxGroup", to: "/reference/checkboxgroup", class: "bp-label bp-mono")
            Link("Checkbox", to: "/reference/checkbox", class: "bp-label bp-mono")
            Link("Switch", to: "/reference/switch", class: "bp-label bp-mono")
            Link("ToggleGroup", to: "/reference/togglegroup", class: "bp-label bp-mono")
            Link("TransferList", to: "/reference/transferlist", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "bind:", type: "State (required)", meaning: "The state it reads and writes: the chosen option's `value:`, or with `.multiple` a list of them in the order they were chosen", default: "—" }, { name: "label:", type: "String (required)", meaning: "What is being chosen: the list's accessible name (`aria-label`)", default: "—" }, { name: "multiple:", type: "Bool", meaning: "Several at once: `bind:` is a list; Space toggles, Shift with an arrow takes the next one in, Ctrl/⌘+A all. Written as a flag, `.multiple`, or `multiple: true`.", default: "false" }], caption: "Props of Listbox", defaults: true)
        Markdown(t("ref.attrs", { families: "global, aria, data", n: 22, props: "`animate:`, `exit:`, `speed:`, `duration:`, `delay:`, `easing:`, `stagger:`, `on:`, `count:`, `shared:`, `class:`, `ref:`, `drag:`, `dragGroup:`, `dropValue:`, `dropAxis:`, `dropInside:`, `roving:`, `trapFocus:`, `mount:`, `update:`, `cleanup:`" }), class: "bp-prose")
