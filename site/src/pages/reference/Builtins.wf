        PropsTable(rows: [{ name: "rows:", type: "[Item] (required)", meaning: "The records, a row each", default: "—" }, { name: "key:", type: "(Item) -> String or (Item) -> Number (required)", meaning: "What tells two rows apart: `r => r.id`; what `bind:` holds, and what keeps a row's nodes as it moves", default: "—" }, { name: "bind:", type: "State", meaning: "The state holding the chosen row's key (a radio a row), or with `.multiple` a list of keys (a box a row and one for all); without it, no column to choose", default: "none: rows are not chosen" }, { name: "multiple:", type: "Bool", meaning: "Several rows at once, with a box in the header that takes them all. Written as a flag, `.multiple`, or `multiple: true`.", default: "false" }, { name: "label:", type: "String (required)", meaning: "What the table is: its caption, visually hidden, read by a screen reader", default: "—" }, { name: "filter:", type: "String", meaning: "Only the rows where a column's `value:` holds this text, its case ignored; a column with only `cell` is not searched. A change goes back to page 1", default: "none: every row" }, { name: "pageSize:", type: "Number", meaning: "Rows a page, behind Previous and Next with `1–20 of 54`; 0 shows every row. Whether there are pages is decided when it is drawn", default: "`0`: every row" }], caption: "Props of DataTable", defaults: true)
        Markdown(t("ref.attrs", { families: "global, aria, data", n: 22, props: "`animate:`, `exit:`, `speed:`, `duration:`, `delay:`, `easing:`, `stagger:`, `on:`, `count:`, `shared:`, `class:`, `ref:`, `drag:`, `dragGroup:`, `dropValue:`, `dropAxis:`, `dropInside:`, `roving:`, `trapFocus:`, `mount:`, `update:`, `cleanup:`" }), class: "bp-prose")
