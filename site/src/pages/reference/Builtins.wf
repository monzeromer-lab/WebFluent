page BuiltinCalendar(path: "/reference/calendar", title: "Calendar — Reference", description: "Calendar: A month as a grid of days, chosen with a press or the keyboard — the arrows by day and week, PageUp and PageDown by month, Home and End to…") {
    state delivery: Date? = @2026-11-17
    state stageLabel = "Delivery day"
    ReferenceItemShell("Calendar", summary: "A month as a grid of days, chosen with a press or the keyboard — the arrows by day and week, PageUp and PageDown by month, Home and End to the week's ends — one day, a range, or several. bind: holds a Date, a \{ start, end \} with .range, a list with .multiple.", signature: "Calendar(bind: State, mode: Enum, min: Date, …)", since: "6.2.0", outputs: [], group: "Form", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Calendar") {
                controls {
                    StageControl({ name: "mode", kind: "enum", options: ["single", "range", "multiple"], value: "single", sink: "special" })
                    StageControl({ name: "label", kind: "string", options: [], value: "" }, live: true, current: stageLabel) { on pick(v) { stageLabel = v } }
                    StageControl({ name: "previous", kind: "string", options: [], value: "" })
                    StageControl({ name: "next", kind: "string", options: [], value: "" })
                }
                Calendar(bind: delivery, min: @2026-11-17, disabled: d => d.weekday() >= 6, label: stageLabel).single
                if let d = delivery {
                    Text("Delivered on {d:.date(long)}").muted
                }
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"state delivery: Date? = @2026-11-17
Calendar(bind: delivery, min: @2026-11-17, disabled: d => d.weekday() >= 6, label: "Delivery day").single
if let d = delivery {
    Text("Delivered on {d:.date(long)}").muted
}"#, title: "wf")
        Text("A range") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"state stay = { start: @2026-12-20, end: @2026-12-27 }
Calendar(bind: stay, mode: .range, label: "Your stay")
