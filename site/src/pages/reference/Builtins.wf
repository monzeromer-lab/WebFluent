page BuiltinStepper(path: "/reference/stepper", title: "Stepper — Reference", description: "Stepper: Steps taken in order — an account, then billing, then a summary — with each step's state (done, current, an error) and the current step's…") {
    state step = 0
    state billed = false
    ReferenceItemShell("Stepper", summary: "Steps taken in order — an account, then billing, then a summary — with each step's state (done, current, an error) and the current step's block shown. bind: holds the current step, from 0; .linear keeps a step out of reach until the ones before it are passed.", signature: "Stepper(bind: State, linear: Bool) \{ … \}", since: "6.2.0", outputs: [], group: "Navigation", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots")), Anchor(id: "parts", label: t("ref.parts")), Anchor(id: "stepper-step", label: "Stepper.Step"), Anchor(id: "drawn-parts", label: t("ref.drawnparts"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Stepper") {
                controls {
                    StageControl({ name: "linear", kind: "bool", options: [], value: "", sink: "special" })
                }
                Stepper(bind: step) {
                    Stepper.Step("Account", done: step > 0) {
                        Text("Your name and email.")
                        Button("Next").primary { on click { step = 1 } }
                    }
                    Stepper.Step("Billing", done: billed) {
                        Text("A card, or an invoice each month.")
                        Button("Add a card").primary { on click { billed = true  step = 2 } }
                    }
                    Stepper.Step("Confirm") {
                        Text("Check it over, then start.")
                        Button("Start the trial").success
                    }
                }
                Text("Step {step + 1} of 3").muted.sm
            }
        }
        notes { Text(t("stage.static"), class: "bp-small") }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"state step = 0
state billed = false
Stepper(bind: step) {
