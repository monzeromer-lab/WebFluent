page BuiltinAlertdialog(path: "/reference/alertdialog", title: "AlertDialog — Reference", description: "AlertDialog: A <dialog> that asks before something that cannot be undone: role=\"alertdialog\", its body read out with its title, and closed by Escape or…") {
    state sure = false
    state said = "Draft: 3 unsaved edits"
    state stageTitle = "Discard your changes?"
    ReferenceItemShell("AlertDialog", summary: "A <dialog> that asks before something that cannot be undone: role=\"alertdialog\", its body read out with its title, and closed by Escape or its own buttons, not a press outside. For a question asked from a handler, await ask(…) draws one.", signature: "AlertDialog(visible: State, title: String, dismiss: Enum, …) \{ … \}", since: "6.2.0", outputs: [], group: "Feedback", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots")), Anchor(id: "parts", label: t("ref.parts")), Anchor(id: "alertdialog-title", label: "AlertDialog.Title"), Anchor(id: "alertdialog-footer", label: "AlertDialog.Footer")], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "AlertDialog") {
                controls {
                    StageControl({ name: "title", kind: "string", options: [], value: "" }, live: true, current: stageTitle) { on pick(v) { stageTitle = v } }
                    StageControl({ name: "dismiss", kind: "enum", options: ["any", "escape", "none"], value: "escape", sink: "special" })
                }
                Button("Discard changes").danger.outlined { on click { sure = true } }
                AlertDialog(visible: sure, title: stageTitle) {
                    Text("Your 3 edits to the pricing page will be lost.")
                    AlertDialog.Footer {
                        Button("Keep editing") { on click { sure = false } }
                        Button("Discard").danger { on click { sure = false  said = "Draft discarded" } }
                    }
                }
                Text(said).muted
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"state sure = false
state said = "Draft: 3 unsaved edits"
Button("Discard changes").danger.outlined { on click { sure = true } }
AlertDialog(visible: sure, title: "Discard your changes?") {
    Text("Your 3 edits to the pricing page will be lost.")
    AlertDialog.Footer {
        Button("Keep editing") { on click { sure = false } }
