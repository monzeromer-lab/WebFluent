page BuiltinPopconfirm(path: "/reference/popconfirm", title: "Popconfirm — Reference", description: "Popconfirm: A question beside the button in its block before what it does: the button opens it, on confirm hears yes, on cancel no or Escape; the focus…") {
    state files = ["notes.md", "draft.md", "todo.md"]
    state stageYes = "Delete"
    state stageNo = "Keep"
    state stageDanger = true
    ReferenceItemShell("Popconfirm", summary: "A question beside the button in its block before what it does: the button opens it, on confirm hears yes, on cancel no or Escape; the focus starts on the answer that loses nothing.", signature: "Popconfirm(title: String, yes: String, no: String, …) \{ … \}", since: "6.2.0", outputs: [], group: "Feedback", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Popconfirm") {
                controls {
                    StageControl({ name: "title", kind: "string", options: [], value: "" })
                    StageControl({ name: "yes", kind: "string", options: [], value: "" }, live: true, current: stageYes) { on pick(v) { stageYes = v } }
                    StageControl({ name: "no", kind: "string", options: [], value: "" }, live: true, current: stageNo) { on pick(v) { stageNo = v } }
                    StageControl({ name: "danger", kind: "bool", options: [], value: "", sink: "class" }, live: true, pressed: stageDanger) { on pick(v) { stageDanger = !stageDanger } }
                }
                Stack(gap: .sm) {
                    for f in files by f {
                        Row(gap: .sm, align: .center, justify: .between) {
                            Text(f)
                            Popconfirm(title: "Delete {f}?", yes: stageYes, no: stageNo, danger: stageDanger) {
                                on confirm { files = files.filter(x => x != f) }
                                Button("Delete").sm.outlined
                            }
                        }
                    }
                }
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"state files = ["notes.md", "draft.md", "todo.md"]
Stack(gap: .sm) {
    for f in files by f {
        Row(gap: .sm, align: .center, justify: .between) {
            Text(f)
            Popconfirm(title: "Delete {f}?", yes: "Delete", no: "Keep").danger {
                on confirm { files = files.filter(x => x != f) }
                Button("Delete").sm.outlined
            }
        }
    }
}"#, title: "wf")
        Text("Hearing no") { style { margin: 8px 0 0; font-weight: 600 } }
