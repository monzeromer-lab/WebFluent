            Link("BackToTop", to: "/reference/backtotop", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "label", type: "String (positional)", meaning: "Its words; a block may hold more (an icon, `Text`) after them", default: "none" }, { name: "tone:", type: "one of its cases", meaning: "The colour it is filled with, from the theme's tones. Written as a flag, `.primary`, or by name, `tone: .primary`.\n\n- `.primary`: The brand colour: the page's main action\n- `.secondary`: The secondary colour\n- `.success`: Green: done, healthy\n- `.danger`: Red: destructive, cannot be undone\n- `.warning`: Amber: attention\n- `.info`: Blue: neutral notice", default: "none: the surface colour with a border" }, { name: "size:", type: "one of its cases", meaning: "Its padding and text size. Written as a flag, `.sm`, or by name, `size: .sm`.\n\n- `.sm`: Less padding, smaller text\n- `.md` (the default): The default size\n- `.lg`: More padding, larger text", default: "md" }, { name: "shape:", type: "one of its cases", meaning: "Its corners; unset, the theme's `radius-md`. Written as a flag, `.rounded`, or by name, `shape: .rounded`.\n\n- `.rounded`: Rounder corners (`radius-lg`)\n- `.pill`: Fully rounded ends (`radius-full`)", default: "none: `radius-md` corners" }, { name: "width:", type: "one of its cases", meaning: "How wide it is. Written as a flag, `.full`, or by name, `width: .full`.\n\n- `.full`: The full width of its container", default: "none: as wide as its words" }, { name: "outlined:", type: "Bool", meaning: "A border and no fill; with `.primary` or `.danger` its words and border take that colour. Written as a flag, `.outlined`, or `outlined: true`.", default: "false" }, { name: "type:", type: "one of its cases", meaning: "What it does inside a form; any button not `.submit` or `.reset` never submits one. Written as a flag, `.button`, or by name, `type: .button`.\n\n- `.button` (the default): A plain button\n- `.submit`: Submits the enclosing form\n- `.reset`: Resets the enclosing form", default: "button" }, { name: "to:", type: "Path", meaning: "A route to go to when it is pressed, through the router as a `Link`'s `to:`; it stays a `<button>`", default: "none" }, { name: "disabled:", type: "Bool", meaning: "Whether it is inert: it cannot be pressed or focused. Written as a flag, `.disabled`, or `disabled: true`.", default: "false" }, { name: "loading:", type: "Bool", meaning: "Busy while it holds — `loading: Checkout.pay.pending`: a spinner in place of its label, at the same width, and a press does nothing. Written as a flag, `.loading`, or `loading: true`.", default: "false" }], caption: "Props of Button", defaults: true)
        Markdown(t("ref.attrs", { families: "global, aria, data", n: 22, props: "`animate:`, `exit:`, `speed:`, `duration:`, `delay:`, `easing:`, `stagger:`, `on:`, `count:`, `shared:`, `class:`, `ref:`, `drag:`, `dragGroup:`, `dropValue:`, `dropAxis:`, `dropInside:`, `roving:`, `trapFocus:`, `mount:`, `update:`, `cleanup:`" }), class: "bp-prose")
        Heading(t("ref.tab.flags"), id: "flags").h2
        Markdown(t("ref.flags.body"), class: "bp-prose")
        Row(gap: .sm) {
