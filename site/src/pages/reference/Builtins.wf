page BuiltinGallery(path: "/reference/gallery", title: "Gallery — Reference", description: "Gallery: Pictures in a grid of columns: (unset, as many as fit), each cropped to one shape — ratio:, unset square. In a Lightbox, each opens full screen.") {
    state stageRatio = 1
    ReferenceItemShell("Gallery", summary: "Pictures in a grid of columns: (unset, as many as fit), each cropped to one shape — ratio:, unset square. In a Lightbox, each opens full screen.", signature: "Gallery(columns: Number, ratio: Number) \{ … \}", since: "6.2.0", outputs: [], group: "Media", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Gallery") {
                controls {
                    StageControl({ name: "columns", kind: "number", options: [], value: "" })
                    StageControl({ name: "ratio", kind: "number", options: [], value: "" }, live: true, current: "{stageRatio}") { on pick(v) { stageRatio = parseFloat(v) } }
                }
                Gallery(columns: { base: 2, md: 4 }, ratio: stageRatio) {
                    Image(src: "/og.png", alt: "The sharing card")
