page BuiltinTable(path: "/reference/table", title: "Table — Reference", description: "Table: Data table. Cells inside Table.Head render as <th scope=\"col\">; caption is the table's accessible name, visually hidden.") {
    state regions = [{ name: "fra1", latency: 42, status: "Healthy" }, { name: "iad1", latency: 88, status: "Healthy" }, { name: "sin1", latency: 190, status: "Degraded" }]
    state stageCaption = "Regions"
    ReferenceItemShell("Table", summary: "Data table. Cells inside Table.Head render as <th scope=\"col\">; caption is the table's accessible name, visually hidden.", signature: "Table(caption: String) \{ … \}", older: true, outputs: [], group: "Data display", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots")), Anchor(id: "parts", label: t("ref.parts")), Anchor(id: "table-head", label: "Table.Head"), Anchor(id: "table-body", label: "Table.Body"), Anchor(id: "table-row", label: "Table.Row"), Anchor(id: "table-cell", label: "Table.Cell")], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05"), RelatedLink(kind: "A10", title: "A table with no header row", to: "/errors/A10")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Table") {
                controls {
                    StageControl({ name: "caption", kind: "string", options: [], value: "" }, live: true, current: stageCaption) { on pick(v) { stageCaption = v } }
                }
                Table(caption: stageCaption) {
                    Table.Head {
                        Table.Row { Table.Cell("Region")  Table.Cell("Latency")  Table.Cell("Status") }
                    }
                    Table.Body {
                        for r in regions by r.name {
                            Table.Row {
                                Table.Cell(r.name).header
                                Table.Cell("{r.latency} ms")
                                Table.Cell { Badge(r.status, tone: if r.status == "Healthy" { .success } else { .warning }) }
                            }
                        }
                    }
                }
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"state regions = [{ name: "fra1", latency: 42, status: "Healthy" }, { name: "iad1", latency: 88, status: "Healthy" }, { name: "sin1", latency: 190, status: "Degraded" }]
Table(caption: "Regions") {
    Table.Head {
        Table.Row { Table.Cell("Region")  Table.Cell("Latency")  Table.Cell("Status") }
    }
    Table.Body {
        for r in regions by r.name {
            Table.Row {
                Table.Cell(r.name).header
                Table.Cell("{r.latency} ms")
                Table.Cell { Badge(r.status, tone: if r.status == "Healthy" { .success } else { .warning }) }
            }
        }
    }
}"#, title: "wf")
