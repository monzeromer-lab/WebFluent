page BuiltinButton(path: "/reference/button", title: "Button — Reference", description: "Button: A button: its label or block is what it shows, on click what it does.") {
    state stageTone = "primary"
    state stageSize = "md"
    state stageShape = ""
    state stageWidth = ""
    state stageOutlined = false
    ReferenceItemShell("Button", summary: "A button: its label or block is what it shows, on click what it does.", signature: "Button(_ label: String, tone: Enum, size: Enum, shape: Enum, …) \{ … \}", older: true, outputs: [], group: "Actions", entries: BUILTIN_INDEX, sections: [Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slotsparts")), Anchor(id: "example", label: t("ref.example"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "E109", title: "An element this output cannot draw", to: "/errors/E109"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "A05", title: "A button with no text", to: "/errors/A05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Button") {
                controls {
                    StageControl({ name: "label", kind: "string", options: [], value: "" })
                    StageControl({ name: "tone", kind: "enum", options: ["primary", "secondary", "success", "danger", "warning"], value: "", sink: "class" }, live: true, current: stageTone) { on pick(v) { stageTone = v } }
                    StageControl({ name: "size", kind: "enum", options: ["sm", "md", "lg"], value: "md", sink: "class" }, live: true, current: stageSize) { on pick(v) { stageSize = v } }
                    StageControl({ name: "shape", kind: "enum", options: ["rounded", "pill"], value: "", sink: "class" }, live: true, current: stageShape) { on pick(v) { stageShape = v } }
                    StageControl({ name: "width", kind: "enum", options: ["full"], value: "", sink: "class" }, live: true, current: stageWidth) { on pick(v) { stageWidth = v } }
                    StageControl({ name: "outlined", kind: "bool", options: [], value: "", sink: "class" }, live: true, pressed: stageOutlined) { on pick(v) { stageOutlined = !stageOutlined } }
                }
                Button("Save changes", tone: stageTone, size: stageSize, shape: stageShape, width: stageWidth, outlined: stageOutlined)
            }
        }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "label", type: "String  (positional)", meaning: "The label" }, { name: "tone:", type: ".primary .secondary .success .danger .warning .info", meaning: "Colour" }, { name: "size:", type: ".sm .md .lg", meaning: "Its size" }, { name: "shape:", type: ".rounded .pill", meaning: "Corner shape" }, { name: "width:", type: ".full", meaning: "Width" }, { name: "outlined:", type: "Bool", meaning: "A border and no fill" }, { name: "type:", type: ".button .submit .reset", meaning: "Its role inside a form" }, { name: "to:", type: "Path", meaning: "The route to go to when it is pressed" }, { name: "disabled:", type: "Bool", meaning: "Whether the control is inert" }, { name: "loading:", type: "Bool", meaning: "Busy while it holds — `loading: Checkout.pay.pending`: a spinner in place of its label, at the same width, and a press does nothing" }], caption: "Props of Button")
