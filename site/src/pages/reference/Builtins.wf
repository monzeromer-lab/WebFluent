page BuiltinChart(path: "/reference/chart", title: "Chart — Reference", description: "Chart: A chart drawn as vector graphics when the page is built: bars, lines, areas, a pie or a donut over a list of records.") {
    ReferenceItemShell("Chart", summary: "A chart drawn as vector graphics when the page is built: bars, lines, areas, a pie or a donut over a list of records.", signature: "Chart(kind: Enum, data: [Json], x: String, …)", since: "5.2.0", outputs: [], group: "Data display", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Chart") {
                controls {
                    StageControl({ name: "kind", kind: "enum", options: ["bar", "line", "area", "pie", "donut"], value: "bar", sink: "special" })
                    StageControl({ name: "x", kind: "string", options: [], value: "" })
                    StageControl({ name: "width", kind: "number", options: [], value: "" })
                    StageControl({ name: "height", kind: "number", options: [], value: "" })
                    StageControl({ name: "ink", kind: "string", options: [], value: "" })
                    StageControl({ name: "grid", kind: "string", options: [], value: "" })
                }
                Chart(kind: .bar, data: [
                    { month: "Jan", web: 41, store: 22 },
                    { month: "Feb", web: 48, store: 25 },
                    { month: "Mar", web: 56, store: 24 },
                    { month: "Apr", web: 61, store: 30 },
                ], x: "month", y: ["web", "store"], unit: "k").legend
            }
        }
        notes { Text(t("stage.static"), class: "bp-small") }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"Chart(kind: .bar, data: [
    { month: "Jan", web: 41, store: 22 },
    { month: "Feb", web: 48, store: 25 },
    { month: "Mar", web: 56, store: 24 },
    { month: "Apr", web: 61, store: 30 },
], x: "month", y: ["web", "store"], unit: "k").legend"#, title: "wf")
        Text("A line over time") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"Chart(kind: .line, data: [
    { week: "W1", users: 120 }, { week: "W2", users: 180 }, { week: "W3", users: 260 }, { week: "W4", users: 310 },
], x: "week", y: "users", height: 220)"#, title: "wf")
        Text("A donut with its labels") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"Chart(kind: .donut, data: [
    { channel: "Search", share: 52 }, { channel: "Direct", share: 31 }, { channel: "Social", share: 17 },
], x: "channel", y: "share", unit: "%").labels"#, title: "wf")
        Text("Stacked, in your colours") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(##"Chart(kind: .bar, data: [
    { q: "Q1", new: 30, renewals: 52 }, { q: "Q2", new: 41, renewals: 55 },
], x: "q", y: ["new", "renewals"], colors: ["#0F766E", "#B45309"]).stacked.legend"##, title: "wf")
        Row(gap: .sm, align: .center) {
            style { gap: 8px; flex-wrap: wrap; margin-top: 8px }
            Text(t("ref.related"), class: "bp-small")
            Link("Sparkline", to: "/reference/sparkline", class: "bp-label bp-mono")
            Link("QrCode", to: "/reference/qrcode", class: "bp-label bp-mono")
            Link("Stat", to: "/reference/stat", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "kind:", type: "one of its cases", meaning: "What it draws (also written `type:`). Written as a flag, `.bar`, or by name, `kind: .bar`.\n\n- `.bar` (the default): Bars, one per row; grouped for several series, or `stacked` (the default)\n- `.line`: A line through the rows per series, a dot at each of up to 24 rows\n- `.area`: A line with the area under it filled at 18% opacity\n- `.pie`: Slices of a whole, one per row, from the first `y` key\n- `.donut`: A pie with a hole", default: "`bar`" }, { name: "data:", type: "[Json]", meaning: "The rows: a list of records (`\{ month: \"Jan\", web: 41 \}`) or of numbers, known when the page is built (`E109` on a page otherwise)", default: "`[]`: an empty grid" }, { name: "x:", type: "String", meaning: "The key of each row's label along the bottom (a pie's legend)", default: "the row's first text field, or its number from 1" }, { name: "y:", type: "String or [String]", meaning: "The key of each row's value, or a list of keys for several series; a pie or donut uses the first", default: "the row's first number field" }, { name: "colors:", type: "[String]", meaning: "The series' colours in order (a pie's: one a slice), repeated when there are more; one that is not a CSS colour is replaced by the default", default: "`#3B82F6`, `#10B981`, `#F59E0B`, `#EF4444`, `#8B5CF6`, `#06B6D4`, `#EC4899`, `#84CC16`" }, { name: "width:", type: "Number", meaning: "The drawing's width in its own units (its 11-unit text scales with it); on a page the SVG fills its box's width, so with `height:` it sets the shape", default: "`600`" }, { name: "height:", type: "Number", meaning: "The drawing's height in its own units; with `width:` it sets the shape", default: "`260`" }, { name: "ink:", type: "String", meaning: "The colour of its axis labels, value labels and legend text, a CSS colour", default: "`#64748B`" }, { name: "grid:", type: "String", meaning: "The colour of its horizontal grid lines, a CSS colour", default: "`#E2E8F0`" }, { name: "legend:", type: "Bool", meaning: "Name the series above a bar, line or area chart (only with two or more), or list each slice with its value beside a pie; `legend: false` leaves it out. Written as a flag, `.legend`, or `legend: true`.", default: "true" }, { name: "stacked:", type: "Bool", meaning: "Stack a bar chart's series in one bar a row; other kinds ignore it. Written as a flag, `.stacked`, or `stacked: true`.", default: "false" }, { name: "labels:", type: "Bool", meaning: "Write each bar's value above it (bars over 12 units tall) or each slice's percentage on it (slices over about 17°); lines and areas ignore it. Written as a flag, `.labels`, or `labels: true`.", default: "false" }, { name: "unit:", type: "String", meaning: "Written after each value on the axis and in a pie's legend: `ms`, `%`", default: "none" }], caption: "Props of Chart", defaults: true)
        Markdown(t("ref.attrs", { families: "global, aria, data", n: 22, props: "`animate:`, `exit:`, `speed:`, `duration:`, `delay:`, `easing:`, `stagger:`, `on:`, `count:`, `shared:`, `class:`, `ref:`, `drag:`, `dragGroup:`, `dropValue:`, `dropAxis:`, `dropInside:`, `roving:`, `trapFocus:`, `mount:`, `update:`, `cleanup:`" }), class: "bp-prose")
        Heading(t("ref.tab.flags"), id: "flags").h2
        Markdown(t("ref.flags.body"), class: "bp-prose")
        Row(gap: .sm) {
            style { gap: 8px; flex-wrap: wrap }
            Text(".bar", class: "bp-label bp-mono")
            Text(".line", class: "bp-label bp-mono")
            Text(".area", class: "bp-label bp-mono")
            Text(".pie", class: "bp-label bp-mono")
            Text(".donut", class: "bp-label bp-mono")
            Text(".legend", class: "bp-label bp-mono")
            Text(".stacked", class: "bp-label bp-mono")
            Text(".labels", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.events"), id: "events").h2
        Markdown(t("ref.universal.link"), class: "bp-prose")
        Heading(t("ref.slots"), id: "slots").h2
        SlotsTable(slots: [])
        Markdown(t("ref.renders", { cls: "wf-chart" }), class: "bp-prose")
    }
}

