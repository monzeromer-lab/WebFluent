        stage {
            Stage(label: "VirtualList") {
                controls {
                    StageControl({ name: "label", kind: "string", options: [], value: "" })
                }
                Text(t("stage.later"), class: "bp-small") { style { max-width: 420px; text-align: center } }
            }
        }
        notes { Text(t("stage.static"), class: "bp-small") }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "rowHeight:", type: "Number", meaning: "Every row's height, in px: the fast path. Unset, each row is measured" }, { name: "estimate:", type: "Number", meaning: "The height a row not yet drawn stands for, in px. Unset, 32" }, { name: "reveal:", type: "Any", meaning: "A row's key: when it changes, that row is scrolled into view — the selection, the current match" }, { name: "label:", type: "String", meaning: "What the list is, for a screen reader" }], caption: "Props of VirtualList")
        Markdown(t("ref.attrs", { families: "global, aria, data", n: 22, props: "`animate:`, `exit:`, `speed:`, `duration:`, `delay:`, `easing:`, `stagger:`, `on:`, `count:`, `shared:`, `class:`, `ref:`, `drag:`, `dragGroup:`, `dropValue:`, `dropAxis:`, `dropInside:`, `roving:`, `trapFocus:`, `mount:`, `update:`, `cleanup:`" }), class: "bp-prose")
        Heading(t("ref.tab.flags"), id: "flags").h2
        Markdown(t("ref.flags.body"), class: "bp-prose")
        Text(t("ref.noflags"), class: "bp-small")
        Heading(t("ref.tab.events"), id: "events").h2
        Markdown(t("ref.universal.link"), class: "bp-prose")
        Heading(t("ref.slotsparts"), id: "slots").h2
        SlotsAndParts(slots: [PropRow(name: "children", kind: "", detail: "")], parts: [])
        Heading(t("ref.example"), id: "example").h2
        CodeBlock(#"state rows = (0..10000).map((i) => "row {i}")
state picked = "row 0"
VirtualList(rowHeight: 32, reveal: picked, label: "Rows") {
    style { height: 320px }
    for r in rows by r { Text(r) { style { height: 32px; margin: 0 } } }
}"#, title: "wf")
        Markdown(t("ref.renders", { cls: "wf-virtual-list" }), class: "bp-prose")
    }
}

