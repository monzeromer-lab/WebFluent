                    StageControl({ name: "circle", kind: "bool", options: [], value: "", sink: "class" }, live: true, pressed: stageCircle) { on pick(v) { stageCircle = !stageCircle } }
                }
                Row(gap: .md, align: .center) {
                    Skeleton(size: stageSize, circle: stageCircle)
                    Stack(gap: .sm) {
                        Skeleton(height: "16px", width: "180px")
                        Skeleton(height: "12px", width: "260px")
                        Skeleton(height: "12px", width: "220px")
                    }
                }
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"Row(gap: .md, align: .center) {
    Skeleton(size: "48px").circle
    Stack(gap: .sm) {
        Skeleton(height: "16px", width: "180px")
        Skeleton(height: "12px", width: "260px")
        Skeleton(height: "12px", width: "220px")
    }
}"#, title: "wf")
        Text("While a list loads") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"state loading = true
if loading {
    Stack(gap: .sm) {
        Skeleton(height: "20px")
        Skeleton(height: "20px")
    }
} else {
    Text("Loaded")
}"#, title: "wf")
        Row(gap: .sm, align: .center) {
            style { gap: 8px; flex-wrap: wrap; margin-top: 8px }
            Text(t("ref.related"), class: "bp-small")
            Link("Progress", to: "/reference/progress", class: "bp-label bp-mono")
            Link("CircularProgress", to: "/reference/circularprogress", class: "bp-label bp-mono")
            Link("Meter", to: "/reference/meter", class: "bp-label bp-mono")
            Link("Spinner", to: "/reference/spinner", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "height:", type: "String", meaning: "Its height, a CSS length (`\"20px\"`, `\"1.5rem\"`); a value that reads state follows it", default: "none: no height of its own" }, { name: "width:", type: "String", meaning: "Its width, a CSS length (`\"200px\"`, `\"60%\"`)", default: "none: the width of its container" }, { name: "size:", type: "String", meaning: "The diameter of a `.circle`, a CSS length, used for any of `width:` and `height:` not given; ignored without `.circle`", default: "none" }, { name: "circle:", type: "Bool", meaning: "Round instead of a rounded rectangle, for an avatar's place. Written as a flag, `.circle`, or `circle: true`.", default: "false" }], caption: "Props of Skeleton", defaults: true)
        Markdown(t("ref.attrs", { families: "global, aria, data", n: 22, props: "`animate:`, `exit:`, `speed:`, `duration:`, `delay:`, `easing:`, `stagger:`, `on:`, `count:`, `shared:`, `class:`, `ref:`, `drag:`, `dragGroup:`, `dropValue:`, `dropAxis:`, `dropInside:`, `roving:`, `trapFocus:`, `mount:`, `update:`, `cleanup:`" }), class: "bp-prose")
