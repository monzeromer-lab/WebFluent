                        Text("Files").bold
                        Text("App.wf")
                        Text("Home.wf")
                    }
                    Splitter(bind: side, min: stageMin, max: stageMax, reset: stageReset, label: stageLabel, horizontal: stageHorizontal, reverse: stageReverse)
                    Stack {
                        style { flex: 1; padding: 0.75rem }
                        Text("Drag the handle, or focus it and use the arrow keys. Double-click puts it back.")
                    }
                }
            }
        }
