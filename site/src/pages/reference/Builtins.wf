            Link("Divider", to: "/reference/divider", class: "bp-label bp-mono")
            Link("Sticky", to: "/reference/sticky", class: "bp-label bp-mono")
            Link("PanelGroup", to: "/reference/panelgroup", class: "bp-label bp-mono")
