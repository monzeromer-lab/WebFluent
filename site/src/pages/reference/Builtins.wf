page BuiltinCallout(path: "/reference/callout", title: "Callout — Reference", description: "Callout: A note set apart from the text around it — .note, .tip, .important, .warning, .caution — with an icon and a title, as GitHub's alerts are. Its…") {
    state stageText = "Run `wf check` before you push: every finding has a **code**, and [a page](/errors) that says how to fix it."
    state stageKind = "tip"
    state stageTitle = "Before you push"
    ReferenceItemShell("Callout", summary: "A note set apart from the text around it — .note, .tip, .important, .warning, .caution — with an icon and a title, as GitHub's alerts are. Its text is the positional, in Markdown (code, **bold**, a link), or its block.", signature: "Callout(_ text: String, kind: Enum, title: String) \{ … \}", since: "6.2.0", outputs: [], group: "Content", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots")), Anchor(id: "parts", label: t("ref.parts")), Anchor(id: "callout-title", label: "Callout.Title")], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Callout") {
                controls {
                    StageControl({ name: "text", kind: "string", options: [], value: "" }, live: true, current: stageText) { on pick(v) { stageText = v } }
                    StageControl({ name: "kind", kind: "enum", options: ["note", "tip", "important", "warning", "caution"], value: "note", sink: "class" }, live: true, current: stageKind) { on pick(v) { stageKind = v } }
                    StageControl({ name: "title", kind: "string", options: [], value: "" }, live: true, current: stageTitle) { on pick(v) { stageTitle = v } }
                }
                Callout(stageText, kind: stageKind, title: stageTitle)
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"Callout("Run `wf check` before you push: every finding has a **code**, and [a page](/errors) that says how to fix it.", title: "Before you push").tip"#, title: "wf")
        Text("A block below its text") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"Callout("Every finding has a code.").note {
    Link("Read about the checks", to: "/errors")
}"#, title: "wf")
        Text("Every kind") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"Stack(gap: .sm) {
    Callout("Drafts are kept for 30 days.").note
    Callout("Press mod+k to search.").tip
    Callout("A route change drops a route store.").important
    Callout("The key is shown only once.").warning
    Callout("Deleting a project deletes its builds.").caution
}"#, title: "wf")
        Text("A title of your own") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"Callout.warning {
    Callout.Title { Text("Rotating keys")  Badge("Beta").info }
    Text("The old key keeps working for an hour.")
}"#, title: "wf")
        Row(gap: .sm, align: .center) {
            style { gap: 8px; flex-wrap: wrap; margin-top: 8px }
            Text(t("ref.related"), class: "bp-small")
            Link("Card", to: "/reference/card", class: "bp-label bp-mono")
            Link("Item", to: "/reference/item", class: "bp-label bp-mono")
            Link("EmptyState", to: "/reference/emptystate", class: "bp-label bp-mono")
            Link("Stat", to: "/reference/stat", class: "bp-label bp-mono")
            Link("Accordion", to: "/reference/accordion", class: "bp-label bp-mono")
            Link("Alert", to: "/reference/alert", class: "bp-label bp-mono")
            Link("Toast", to: "/reference/toast", class: "bp-label bp-mono")
            Link("LoadingOverlay", to: "/reference/loadingoverlay", class: "bp-label bp-mono")
            Link("Tour", to: "/reference/tour", class: "bp-label bp-mono")
            Link("ConsentBanner", to: "/reference/consentbanner", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "text", type: "String (positional)", meaning: "What it says, as Markdown: a `code` span, **bold** and a link show as such; markup in it is shown, not run. Its block follows", default: "none" }, { name: "kind:", type: "one of its cases", meaning: "What kind of note it is: its colour, its icon and its title's word. Written as a flag, `.note`, or by name, `kind: .note`.\n\n- `.note` (the default): Context worth having: blue, an info icon, `Note` (the default)\n- `.tip`: A way to do it better or sooner: green, `Tip`\n- `.important`: Something to know before going on: the primary colour, `Important`\n- `.warning`: A way to lose work or ship a bug: amber, `Warning`\n- `.caution`: A way to lose data or expose a secret: red, `Caution`", default: "`note`" }, { name: "title:", type: "String", meaning: "The words of its title row, after the kind's icon; a `Callout.Title` block written by hand draws the row instead", default: "the kind's word: `Note`, `Tip` …" }], caption: "Props of Callout", defaults: true)
        Markdown(t("ref.attrs", { families: "global, aria, data", n: 22, props: "`animate:`, `exit:`, `speed:`, `duration:`, `delay:`, `easing:`, `stagger:`, `on:`, `count:`, `shared:`, `class:`, `ref:`, `drag:`, `dragGroup:`, `dropValue:`, `dropAxis:`, `dropInside:`, `roving:`, `trapFocus:`, `mount:`, `update:`, `cleanup:`" }), class: "bp-prose")
        Heading(t("ref.tab.flags"), id: "flags").h2
        Markdown(t("ref.flags.body"), class: "bp-prose")
        Row(gap: .sm) {
            style { gap: 8px; flex-wrap: wrap }
            Text(".note", class: "bp-label bp-mono")
            Text(".tip", class: "bp-label bp-mono")
            Text(".important", class: "bp-label bp-mono")
            Text(".warning", class: "bp-label bp-mono")
            Text(".caution", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.events"), id: "events").h2
        Markdown(t("ref.universal.link"), class: "bp-prose")
        Heading(t("ref.slots"), id: "slots").h2
        SlotsTable(slots: [PropRow(name: "children", kind: "", detail: "")])
        Heading(t("ref.parts"), id: "parts").h2
        Markdown(t("ref.parts.body", { name: "Callout" }), class: "bp-prose")
        Heading("Callout.Title", id: "callout-title").h3
        Text("Its title row: the icon and the words. Drawn for it; written by hand to draw something else there.")
        Code("Callout.Title \{ … \}").block
        Markdown(t("ref.renders", { cls: "wf-callout" }), class: "bp-prose")
    }
}

