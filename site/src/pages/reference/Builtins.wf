        Text("Several days") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"state days: [Date] = [@2026-11-18, @2026-11-20]
Calendar(bind: days, mode: .multiple, label: "Days you can attend")
Text("{days.length} day(s) chosen")"#, title: "wf")
        Row(gap: .sm, align: .center) {
            style { gap: 8px; flex-wrap: wrap; margin-top: 8px }
            Text(t("ref.related"), class: "bp-small")
            Link("DatePicker", to: "/reference/datepicker", class: "bp-label bp-mono")
            Link("DateRangePicker", to: "/reference/daterangepicker", class: "bp-label bp-mono")
            Link("RelativeTime", to: "/reference/relativetime", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "bind:", type: "State (required)", meaning: "The state it reads and writes, by `mode:`: a `Date?`, a `\{ start, end \}` of `Date`s (`end` null until the second day), or a `[Date]` kept in order", default: "—" }, { name: "mode:", type: "one of its cases", meaning: "How many days it holds. Written as a flag, `.single`, or by name, `mode: .single`.\n\n- `.single` (the default): One day: `bind:` is a `Date`\n- `.range`: A first and a last day: `\{ start, end \}`; a third press starts again\n- `.multiple`: Any number of days: a list, a press adding or removing one", default: "single" }, { name: "min:", type: "Date", meaning: "The first day that can be chosen; days before it are shown but cannot be chosen", default: "none" }, { name: "max:", type: "Date", meaning: "The last day that can be chosen; days after it are shown but cannot be chosen", default: "none" }, { name: "disabled:", type: "[Date] or (Date) -> Bool", meaning: "Days that cannot be chosen: a list of them, or a test of a day, `d => d.weekday() >= 6`", default: "none" }, { name: "label:", type: "String", meaning: "Its name for a screen reader, read once when it is drawn", default: "`Calendar`" }, { name: "previous:", type: "String", meaning: "The previous month button's accessible name, in the page's words", default: "`Previous month`" }, { name: "next:", type: "String", meaning: "The next month button's accessible name, in the page's words: `t(\"calendar.next\")`", default: "`Next month`" }], caption: "Props of Calendar", defaults: true)
        Markdown(t("ref.attrs", { families: "global, aria, data", n: 22, props: "`animate:`, `exit:`, `speed:`, `duration:`, `delay:`, `easing:`, `stagger:`, `on:`, `count:`, `shared:`, `class:`, `ref:`, `drag:`, `dragGroup:`, `dropValue:`, `dropAxis:`, `dropInside:`, `roving:`, `trapFocus:`, `mount:`, `update:`, `cleanup:`" }), class: "bp-prose")
