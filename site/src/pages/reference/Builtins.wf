                Text("One entry: its words, where it goes, and its icon.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/prevnext", class: "bp-card") {
                Text("PrevNext", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The pages before and after this one in an ordered set — a guide's chapters: each a link that says which way it goes and the page's title.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/prevnext-prev", class: "bp-card") {
                Text("PrevNext.Prev", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The page before: its title, and where it is.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/prevnext-next", class: "bp-card") {
                Text("PrevNext.Next", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The page after: its title, and where it is.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/onthispage", class: "bp-card") {
                Text("OnThisPage", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The page's headings as links, the one being read marked as the reader scrolls: a table of contents beside a long page.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/onthispage-title", class: "bp-card") {
                Text("OnThisPage.Title", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Its title. Drawn for it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/pagination", class: "bp-card") {
                Text("Pagination", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Pages of a list: Previous, the first and last pages, those around the current one with a gap for the rest, and Next. The current page is aria-current=\"page\"; bind: holds it, from 1.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/pagination-prev", class: "bp-card") {
