page BuiltinCommandpalette(path: "/reference/commandpalette", title: "CommandPalette — Reference", description: "CommandPalette: A dialog of everything a reader can do or go to, filtered as they type: the arrow keys go through what matches, Enter runs it (on…") {
    state palette = false
    state said = "Nothing run yet"
    state stageLabel = "Commands"
    state stagePlaceholder = "Type a command or a page"
    ReferenceItemShell("CommandPalette", summary: "A dialog of everything a reader can do or go to, filtered as they type: the arrow keys go through what matches, Enter runs it (on select) and closes. open: is the state that shows it.", signature: "CommandPalette(open: State, label: String, placeholder: String) \{ … \}", since: "6.2.0", outputs: [], group: "Navigation", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots")), Anchor(id: "parts", label: t("ref.parts")), Anchor(id: "commandpalette-group", label: "CommandPalette.Group"), Anchor(id: "commandpalette-item", label: "CommandPalette.Item"), Anchor(id: "drawn-parts", label: t("ref.drawnparts"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "CommandPalette") {
                controls {
                    StageControl({ name: "label", kind: "string", options: [], value: "" }, live: true, current: stageLabel) { on pick(v) { stageLabel = v } }
                    StageControl({ name: "placeholder", kind: "string", options: [], value: "" }, live: true, current: stagePlaceholder) { on pick(v) { stagePlaceholder = v } }
                }
                Button("Search commands…") { on click { palette = true } }
                Text(said).muted.sm
                CommandPalette(open: palette, label: stageLabel, placeholder: stagePlaceholder) {
                    CommandPalette.Group("Pages") {
                        CommandPalette.Item("Reference", icon: "list") { on select { navigate("/reference") } }
                        CommandPalette.Item("Recipes", icon: "book") { on select { navigate("/recipes") } }
                    }
                    CommandPalette.Group("Actions") {
                        CommandPalette.Item("New file", icon: "file-plus", shortcut: "mod+n") { on select { said = "New file" } }
                        CommandPalette.Item("Copy link", icon: "copy", shortcut: "mod+shift+c") { on select { said = "Link copied" } }
                        CommandPalette.Item("Switch theme", icon: "moon") { on select { said = "Theme switched" } }
                    }
                }
            }
        }
