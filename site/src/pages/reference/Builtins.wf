page BuiltinContainer(path: "/reference/container", title: "Container — Reference", description: "Container: Centred wrapper with a maximum width and horizontal padding.") {
    state stageFluid = false
    ReferenceItemShell("Container", summary: "Centred wrapper with a maximum width and horizontal padding.", signature: "Container(fluid: Bool) \{ … \}", older: true, outputs: [], group: "Layout", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Container") {
                controls {
                    StageControl({ name: "fluid", kind: "bool", options: [], value: "", sink: "class" }, live: true, pressed: stageFluid) { on pick(v) { stageFluid = !stageFluid } }
                }
                Container(fluid: stageFluid) {
                    style { background: $color-surface; border: 1px dashed $color-border; padding: 1rem }
                    Heading("Release notes").h3
                    Text("Version 7.0 makes the compiler strict: what 6.x accepted and 7.0 refuses is an error with its fix.").muted
                    Row(gap: .sm) {
                        Badge("Compiler").primary
                        Badge("Breaking").warning
                    }
                }
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"Container {
    style { background: $color-surface; border: 1px dashed $color-border; padding: 1rem }
    Heading("Release notes").h3
    Text("Version 7.0 makes the compiler strict: what 6.x accepted and 7.0 refuses is an error with its fix.").muted
    Row(gap: .sm) {
        Badge("Compiler").primary
        Badge("Breaking").warning
    }
}"#, title: "wf")
        Text("Full width, with no maximum") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"Container.fluid {
    style { background: $color-surface; padding: 1rem }
    Text("This band runs edge to edge of whatever holds it.")
}"#, title: "wf")
        Text("A page's main column") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"Container {
    Heading("Settings").h3
    Text("Changes are saved as you make them.").muted
}"#, title: "wf")
