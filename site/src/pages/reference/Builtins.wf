page BuiltinAvatargroup(path: "/reference/avatargroup", title: "AvatarGroup — Reference", description: "AvatarGroup: Avatars overlapping in a row: past max: the rest are one +3.") {
    state stageMax = 4
    state stageLabel = "Reviewers"
    ReferenceItemShell("AvatarGroup", summary: "Avatars overlapping in a row: past max: the rest are one +3.", signature: "AvatarGroup(max: Number, label: String) \{ … \}", since: "6.2.0", outputs: [], group: "Data display", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "AvatarGroup") {
                controls {
                    StageControl({ name: "max", kind: "number", options: [], value: "" }, live: true, current: "{stageMax}") { on pick(v) { stageMax = parseFloat(v) } }
                    StageControl({ name: "label", kind: "string", options: [], value: "" }, live: true, current: stageLabel) { on pick(v) { stageLabel = v } }
                }
                AvatarGroup(max: stageMax, label: stageLabel) {
                    Avatar(src: "/icon-512.png", alt: "Ada Lovelace")
                    Avatar(initials: "GH").primary
                    Avatar(initials: "AT")
                    Avatar(initials: "ED")
                    Avatar(initials: "KJ")
                    Avatar(initials: "MH")
                }
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"AvatarGroup(max: 4, label: "Reviewers") {
    Avatar(src: "/icon-512.png", alt: "Ada Lovelace")
    Avatar(initials: "GH").primary
    Avatar(initials: "AT")
    Avatar(initials: "ED")
    Avatar(initials: "KJ")
    Avatar(initials: "MH")
}"#, title: "wf")
