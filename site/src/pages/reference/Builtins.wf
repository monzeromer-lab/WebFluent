                    StageControl({ name: "closable", kind: "bool", options: [], value: "", sink: "class" }, live: true, pressed: stageClosable) { on pick(v) { stageClosable = !stageClosable } }
                    StageControl({ name: "side", kind: "enum", options: ["bottom", "start", "end"], value: "bottom", sink: "special" })
                    StageControl({ name: "label", kind: "string", options: [], value: "" })
                    StageControl({ name: "dismiss", kind: "enum", options: ["any", "escape", "none"], value: "any", sink: "special" })
                }
                Button("Filters") { on click { filters = true } }
                Sheet(visible: filters, snap: [0.5, 1], title: stageTitle, closable: stageClosable) {
                    Radio(bind: sort, value: "new", label: "Newest first")
                    Radio(bind: sort, value: "price", label: "Lowest price")
                    Switch(bind: inStock, label: "In stock only")
