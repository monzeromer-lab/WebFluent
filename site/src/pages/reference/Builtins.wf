page BuiltinTooltip(path: "/reference/tooltip", title: "Tooltip — Reference", description: "Tooltip: Shows text above everything when its child is hovered (after delay:) or focused from the keyboard.") {
    state stageText = "Copy the link"
    ReferenceItemShell("Tooltip", summary: "Shows text above everything when its child is hovered (after delay:) or focused from the keyboard.", signature: "Tooltip(_ text: String, shortcut: String, placement: Enum, delay: Number) \{ … \}", older: true, outputs: [], group: "Data display", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "E109", title: "An element this output cannot draw", to: "/errors/E109"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Tooltip") {
                controls {
                    StageControl({ name: "text", kind: "string", options: [], value: "" }, live: true, current: stageText) { on pick(v) { stageText = v } }
                    StageControl({ name: "shortcut", kind: "string", options: [], value: "" })
                    StageControl({ name: "placement", kind: "enum", options: ["bottom", "bottomStart", "bottomEnd", "top", "topStart"], value: "top", sink: "special" })
                    StageControl({ name: "delay", kind: "number", options: [], value: "" })
