page BuiltinKbd(path: "/reference/kbd", title: "Kbd — Reference", description: "Kbd: A key or a combination, written as this system writes it: Kbd(\"mod+k\") is ⌘K on a Mac and Ctrl+K elsewhere.") {
    state stageKeys = "mod+k"
    ReferenceItemShell("Kbd", summary: "A key or a combination, written as this system writes it: Kbd(\"mod+k\") is ⌘K on a Mac and Ctrl+K elsewhere.", signature: "Kbd(_ keys: String)", since: "6.2.0", outputs: [], group: "Content", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Kbd") {
                controls {
                    StageControl({ name: "keys", kind: "string", options: [], value: "" }, live: true, current: stageKeys) { on pick(v) { stageKeys = v } }
                }
                Stack(gap: .xs) {
                    Row(gap: .xs, align: .center) { Text("Press")  Kbd(stageKeys)  Text("to search the docs.") }
                    Row(gap: .xs, align: .center) { Text("Send with")  Kbd("shift+Enter")  Text("and close with")  Kbd("Escape") }
                }
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"Stack(gap: .xs) {
    Row(gap: .xs, align: .center) { Text("Press")  Kbd("mod+k")  Text("to search the docs.") }
    Row(gap: .xs, align: .center) { Text("Send with")  Kbd("shift+Enter")  Text("and close with")  Kbd("Escape") }
}"#, title: "wf")
        Text("A chord") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"Row(gap: .xs, align: .center) { Text("Save all:")  Kbd("mod+k mod+s") }"#, title: "wf")
        Row(gap: .sm, align: .center) {
