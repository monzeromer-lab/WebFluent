page BuiltinListbox(path: "/reference/listbox", title: "Listbox — Reference", description: "Listbox: A list of options always shown, one chosen (selection follows the arrow keys) or, .multiple, several: Space chooses, Shift with an arrow takes…") {
    state fruit = "apple"
    state stageLabel = "Fruit"
    ReferenceItemShell("Listbox", summary: "A list of options always shown, one chosen (selection follows the arrow keys) or, .multiple, several: Space chooses, Shift with an arrow takes the next one in too, Ctrl or ⌘ with A takes them all; a letter goes to the next option that starts with it.", signature: "Listbox(bind: State, label: String, multiple: Bool) \{ … \}", since: "6.2.0", outputs: [], group: "Form", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots")), Anchor(id: "parts", label: t("ref.parts")), Anchor(id: "listbox-option", label: "Listbox.Option")], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Listbox") {
                controls {
                    StageControl({ name: "label", kind: "string", options: [], value: "" }, live: true, current: stageLabel) { on pick(v) { stageLabel = v } }
                    StageControl({ name: "multiple", kind: "bool", options: [], value: "", sink: "special" })
                }
                Listbox(bind: fruit, label: stageLabel) {
                    Listbox.Option("Apple", value: "apple")
                    Listbox.Option("Banana", value: "banana")
                    Listbox.Option("Cherry", value: "cherry")
                    Listbox.Option("Mango", value: "mango")
                }
                Text("Chosen: {fruit}").muted
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"state fruit = "apple"
Listbox(bind: fruit, label: "Fruit") {
    Listbox.Option("Apple", value: "apple")
    Listbox.Option("Banana", value: "banana")
    Listbox.Option("Cherry", value: "cherry")
    Listbox.Option("Mango", value: "mango")
}
Text("Chosen: {fruit}").muted"#, title: "wf")
        Text("Several at once") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"state toppings: [String] = ["cheese"]
Listbox(bind: toppings, label: "Toppings").multiple {
    Listbox.Option("Cheese", value: "cheese")
    Listbox.Option("Mushrooms", value: "mushrooms")
    Listbox.Option("Olives", value: "olives")
}
Text("Chosen: {toppings.join(", ")}")"#, title: "wf")
