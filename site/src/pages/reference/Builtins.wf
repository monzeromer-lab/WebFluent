page BuiltinScrollarea(path: "/reference/scrollarea", title: "ScrollArea — Reference", description: "ScrollArea: A box that scrolls within height:, with a thin scrollbar, its edges fading where there is more, and a Tab stop so a keyboard can scroll it.") {
    state stageHeight = "200px"
    state stageLabel = "Build log"
    state stageHorizontal = false
    ReferenceItemShell("ScrollArea", summary: "A box that scrolls within height:, with a thin scrollbar, its edges fading where there is more, and a Tab stop so a keyboard can scroll it.", signature: "ScrollArea(height: String, label: String, horizontal: Bool) \{ … \}", since: "6.2.0", outputs: [], group: "Layout", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "ScrollArea") {
                controls {
                    StageControl({ name: "height", kind: "string", options: [], value: "" }, live: true, current: stageHeight) { on pick(v) { stageHeight = v } }
                    StageControl({ name: "label", kind: "string", options: [], value: "" }, live: true, current: stageLabel) { on pick(v) { stageLabel = v } }
                    StageControl({ name: "horizontal", kind: "bool", options: [], value: "", sink: "class" }, live: true, pressed: stageHorizontal) { on pick(v) { stageHorizontal = !stageHorizontal } }
                }
                ScrollArea(height: stageHeight, label: stageLabel, horizontal: stageHorizontal) {
                    style { border: 1px solid $color-border; border-radius: $radius-md; padding: 0.5rem 0.75rem }
                    for line in (1..=40).map(i => "[{i}] compiled src/pages/Page{i}.wf") by line {
                        Text(line).sm
                    }
                }
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"ScrollArea(height: "200px", label: "Build log") {
    style { border: 1px solid $color-border; border-radius: $radius-md; padding: 0.5rem 0.75rem }
    for line in (1..=40).map(i => "[{i}] compiled src/pages/Page{i}.wf") by line {
        Text(line).sm
    }
}"#, title: "wf")
        Text("Sideways") { style { margin: 8px 0 0; font-weight: 600 } }
