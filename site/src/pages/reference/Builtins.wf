page BuiltinCombobox(path: "/reference/combobox", title: "Combobox — Reference", description: "Combobox: A text field that offers what matches as the reader types: from options:, or search: asked of a server. The arrow keys go through the offers…") {
    state city = "lis"
    state stageLabel = "City"
    state stagePlaceholder = "Type a city"
    ReferenceItemShell("Combobox", summary: "A text field that offers what matches as the reader types: from options:, or search: asked of a server. The arrow keys go through the offers, Enter takes one, Escape closes them; .multiple keeps several, each a chip Backspace takes back. option(o) \{ … \} draws an offer; empty \{ … \} shows when nothing matches.", signature: "Combobox(bind: State, options: [Item], search: (String) -> [Item] or (String) -> [Item]!, …)", since: "6.2.0", outputs: [], group: "Form", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Combobox") {
                controls {
                    StageControl({ name: "multiple", kind: "bool", options: [], value: "", sink: "special" })
                    StageControl({ name: "label", kind: "string", options: [], value: "" }, live: true, current: stageLabel) { on pick(v) { stageLabel = v } }
                    StageControl({ name: "placeholder", kind: "string", options: [], value: "" }, live: true, current: stagePlaceholder) { on pick(v) { stagePlaceholder = v } }
                }
                Combobox(bind: city, options: [
                    { id: "ams", name: "Amsterdam" },
                    { id: "ber", name: "Berlin" },
                    { id: "lis", name: "Lisbon" },
                    { id: "mad", name: "Madrid" },
                    { id: "par", name: "Paris" },
                ], text: c => c.name, key: c => c.id, label: stageLabel, placeholder: stagePlaceholder)
                Text("Chosen: {city}").muted
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"state city = "lis"
Combobox(bind: city, options: [
    { id: "ams", name: "Amsterdam" },
    { id: "ber", name: "Berlin" },
    { id: "lis", name: "Lisbon" },
    { id: "mad", name: "Madrid" },
    { id: "par", name: "Paris" },
], text: c => c.name, key: c => c.id, label: "City", placeholder: "Type a city")
Text("Chosen: {city}").muted"#, title: "wf")
        Text("Several, each a chip") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"state reviewers: [String] = ["ada"]
Combobox(bind: reviewers, options: [
    { id: "ada", name: "Ada Lovelace" },
    { id: "grace", name: "Grace Hopper" },
    { id: "alan", name: "Alan Turing" },
], text: p => p.name, key: p => p.id, label: "Reviewers").multiple"#, title: "wf")
        Row(gap: .sm, align: .center) {
            style { gap: 8px; flex-wrap: wrap; margin-top: 8px }
            Text(t("ref.related"), class: "bp-small")
            Link("Input", to: "/reference/input", class: "bp-label bp-mono")
            Link("Textarea", to: "/reference/textarea", class: "bp-label bp-mono")
            Link("NumberInput", to: "/reference/numberinput", class: "bp-label bp-mono")
            Link("InputOTP", to: "/reference/inputotp", class: "bp-label bp-mono")
            Link("TagInput", to: "/reference/taginput", class: "bp-label bp-mono")
            Link("InputGroup", to: "/reference/inputgroup", class: "bp-label bp-mono")
            Link("Editable", to: "/reference/editable", class: "bp-label bp-mono")
            Link("Select", to: "/reference/select", class: "bp-label bp-mono")
            Link("Listbox", to: "/reference/listbox", class: "bp-label bp-mono")
            Link("RadioGroup", to: "/reference/radiogroup", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "bind:", type: "State (required)", meaning: "The state it reads and writes: the chosen option's key (the option itself without `key:`), or with `.multiple` a list of keys in the order chosen", default: "—" }, { name: "options:", type: "[Item]", meaning: "Every option, filtered as the reader types to those whose words contain what is typed, case ignored; use this or `search:`", default: "none" }, { name: "search:", type: "(String) -> [Item] or (String) -> [Item]!", meaning: "Options asked for as the reader types, each time the typing rests for `debounce:`: a function of the text giving a list, or an endpoint's call (`q => Geo.cities(q: q)`), whose `.ok` list is shown and whose failure shows none", default: "none" }, { name: "text:", type: "(Item) -> String (required)", meaning: "An option's words, shown in the list and in the field once chosen: `p => p.name`", default: "—" }, { name: "key:", type: "(Item) -> String or (Item) -> Number", meaning: "What tells two options apart, and what `bind:` holds: `p => p.id`", default: "the option itself" }, { name: "debounce:", type: "Number or Duration", meaning: "How long the typing must rest before `search:` is asked: a `Duration` (`250.ms`) or milliseconds", default: "200ms" }, { name: "multiple:", type: "Bool", meaning: "Several at once, each a chip with a button to take it out; Backspace in the empty field takes the last back. Written as a flag, `.multiple`, or `multiple: true`.", default: "false" }, { name: "label:", type: "String (required)", meaning: "Its name for a screen reader: the field's and the list's (`aria-label`)", default: "—" }, { name: "placeholder:", type: "String", meaning: "Shown in the field while it is empty", default: "none" }], caption: "Props of Combobox", defaults: true)
        Markdown(t("ref.attrs", { families: "global, aria, data", n: 22, props: "`animate:`, `exit:`, `speed:`, `duration:`, `delay:`, `easing:`, `stagger:`, `on:`, `count:`, `shared:`, `class:`, `ref:`, `drag:`, `dragGroup:`, `dropValue:`, `dropAxis:`, `dropInside:`, `roving:`, `trapFocus:`, `mount:`, `update:`, `cleanup:`" }), class: "bp-prose")
        Heading(t("ref.tab.flags"), id: "flags").h2
        Markdown(t("ref.flags.body"), class: "bp-prose")
        Row(gap: .sm) {
            style { gap: 8px; flex-wrap: wrap }
            Text(".multiple", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.events"), id: "events").h2
        EventsTable(rows: [PropRow(name: "select", kind: "", detail: "")], caption: "Events of Combobox")
        Markdown(t("ref.universal.link"), class: "bp-prose")
        Heading(t("ref.slots"), id: "slots").h2
        SlotsTable(slots: [])
        Markdown(t("ref.renders", { cls: "wf-combobox" }), class: "bp-prose")
    }
}

page BuiltinCheckboxgroup(path: "/reference/checkboxgroup", title: "CheckboxGroup — Reference", description: "CheckboxGroup: Check boxes under a legend whose bind: is the list of the values ticked, with all: a box above them for every one at once — ticked when…") {
    state channels: [String] = ["email"]
    state stageLabel = "Notify me by"
    state stageAll = "Every channel"
    ReferenceItemShell("CheckboxGroup", summary: "Check boxes under a legend whose bind: is the list of the values ticked, with all: a box above them for every one at once — ticked when all are, mixed when some are.", signature: "CheckboxGroup(bind: State, label: String, all: String) \{ … \}", since: "6.2.0", outputs: [], group: "Form", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots")), Anchor(id: "parts", label: t("ref.parts")), Anchor(id: "checkboxgroup-option", label: "CheckboxGroup.Option"), Anchor(id: "drawn-parts", label: t("ref.drawnparts"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "CheckboxGroup") {
                controls {
                    StageControl({ name: "label", kind: "string", options: [], value: "" }, live: true, current: stageLabel) { on pick(v) { stageLabel = v } }
                    StageControl({ name: "all", kind: "string", options: [], value: "" }, live: true, current: stageAll) { on pick(v) { stageAll = v } }
                }
                CheckboxGroup(bind: channels, label: stageLabel, all: stageAll) {
                    CheckboxGroup.Option("Email", value: "email")
                    CheckboxGroup.Option("Text message", value: "sms")
                    CheckboxGroup.Option("Push notification", value: "push")
