page BuiltinEmptystate(path: "/reference/emptystate", title: "EmptyState — Reference", description: "EmptyState: What a list or a page shows when it has nothing yet: an icon, a title, a sentence and, in its block, what to do about it.") {
    state count = 0
    state stageIcon = "folder"
    state stageTitle = "No projects yet"
    state stageText = "A project holds your pages, components and stores."
    ReferenceItemShell("EmptyState", summary: "What a list or a page shows when it has nothing yet: an icon, a title, a sentence and, in its block, what to do about it.", signature: "EmptyState(icon: String, title: String, text: String) \{ … \}", since: "6.2.0", outputs: [], group: "Content", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots")), Anchor(id: "parts", label: t("ref.parts")), Anchor(id: "emptystate-title", label: "EmptyState.Title"), Anchor(id: "emptystate-text", label: "EmptyState.Text"), Anchor(id: "emptystate-actions", label: "EmptyState.Actions")], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "EmptyState") {
                controls {
                    StageControl({ name: "icon", kind: "string", options: [], value: "" }, live: true, current: stageIcon) { on pick(v) { stageIcon = v } }
                    StageControl({ name: "title", kind: "string", options: [], value: "" }, live: true, current: stageTitle) { on pick(v) { stageTitle = v } }
                    StageControl({ name: "text", kind: "string", options: [], value: "" }, live: true, current: stageText) { on pick(v) { stageText = v } }
                }
                EmptyState(icon: stageIcon, title: stageTitle, text: stageText) {
                    Button("New project").primary { on click { count = count + 1 } }
                    Link("Read the guide", to: "/learn")
                }
                if count > 0 { Text("{count} project(s) asked for").muted }
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"state count = 0
EmptyState(icon: "folder", title: "No projects yet", text: "A project holds your pages, components and stores.") {
