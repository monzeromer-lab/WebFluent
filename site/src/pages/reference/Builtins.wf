page ReferenceIndexPage(path: "/reference", title: "Reference", description: "Every built-in element, command, setting and design token, read from the compiler itself, with the language's reference pages.") {
    ReferenceItemShell(t("nav.reference"), summary: t("ref.lede", { count: 146 }), entries: REFERENCE_PAGES, sections: [Anchor(id: "pages", label: t("ref.pages")), Anchor(id: "layout", label: "Layout"), Anchor(id: "navigation", label: "Navigation"), Anchor(id: "routing", label: "Routing"), Anchor(id: "data-display", label: "Data display"), Anchor(id: "content", label: "Content"), Anchor(id: "form", label: "Form"), Anchor(id: "feedback", label: "Feedback"), Anchor(id: "actions", label: "Actions"), Anchor(id: "media", label: "Media"), Anchor(id: "typography", label: "Typography"), Anchor(id: "pdf", label: "PDF"), Anchor(id: "slides", label: "Slides"), Anchor(id: "on-every-element", label: t("ref.universal.title")), Anchor(id: "older-spellings", label: t("ref.older.title"))], source: "scripts/docsite/reference.py") {
        Heading(t("ref.pages"), id: "pages").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/expressions", class: "bp-card") { Text("Expressions") { style { font-weight: 600 } }  Text("Language", class: "bp-small") }
            Link(to: "/reference/built-ins", class: "bp-card") { Text("Built-in functions and values") { style { font-weight: 600 } }  Text("Language", class: "bp-small") }
            Link(to: "/reference/grammar", class: "bp-card") { Text("Grammar") { style { font-weight: 600 } }  Text("Language", class: "bp-small") }
            Link(to: "/reference/requests", class: "bp-card") { Text("Services and requests") { style { font-weight: 600 } }  Text("Language", class: "bp-small") }
            Link(to: "/reference/runtime", class: "bp-card") { Text("Runtime API") { style { font-weight: 600 } }  Text("Language", class: "bp-small") }
            Link(to: "/reference/cli", class: "bp-card") { Text("Command line") { style { font-weight: 600 } }  Text("Tools", class: "bp-small") }
            Link(to: "/reference/config", class: "bp-card") { Text("Configuration") { style { font-weight: 600 } }  Text("Tools", class: "bp-small") }
            Link(to: "/reference/tokens", class: "bp-card") { Text("Design tokens") { style { font-weight: 600 } }  Text("Tools", class: "bp-small") }
            Link(to: "/reference/project", class: "bp-card") { Text("Project structure") { style { font-weight: 600 } }  Text("Tools", class: "bp-small") }
            Link(to: "/reference/browser-support", class: "bp-card") { Text("Browser support") { style { font-weight: 600 } }  Text("Tools", class: "bp-small") }
            Link(to: "/reference/glossary", class: "bp-card") { Text("Glossary") { style { font-weight: 600 } }  Text("Tools", class: "bp-small") }
            Link(to: "/reference/library", class: "bp-card") { Text("Library") { style { font-weight: 600 } }  Text("Tools", class: "bp-small") }
            Link(to: "/reference/editors", class: "bp-card") { Text("Editors") { style { font-weight: 600 } }  Text("Tools", class: "bp-small") }
        }
        Heading("Layout", id: "layout").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/container", class: "bp-card") {
                Text("Container", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Centred wrapper with a maximum width and horizontal padding.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/row", class: "bp-card") {
                Text("Row", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Horizontal flex layout. It stays a row at every width unless .stacks or a responsive direction says otherwise.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/column", class: "bp-card") {
                Text("Column", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A child of the 12-column grid, spanning span columns.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/grid", class: "bp-card") {
                Text("Grid", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("CSS grid with a fixed number of columns.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/stack", class: "bp-card") {
                Text("Stack", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Vertical flex layout.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/spacer", class: "bp-card") {
                Text("Spacer", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Vertical space; md when no size is given.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/virtuallist", class: "bp-card") {
                Text("VirtualList", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A scrolling box that draws only the rows in view of the one keyed for inside it — for a tree, search results or a diff of thousands of rows.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/splitter", class: "bp-card") {
                Text("Splitter", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A handle that sets the size of a region beside it: dragged, between min: and max:; double-clicked or Enter, back to reset:; the arrow keys move it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/divider", class: "bp-card") {
                Text("Divider", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Horizontal rule.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/masonry", class: "bp-card") {
                Text("Masonry", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Its children in columns: columns, each placed under the last in its column, keeping its own height.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/aspectratio", class: "bp-card") {
                Text("AspectRatio", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A box that keeps its shape as its width changes — ratio: 16 / 9 — its child filling it: a picture, a video, a frame.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/scrollarea", class: "bp-card") {
                Text("ScrollArea", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A box that scrolls within height:, with a thin scrollbar, its edges fading where there is more, and a Tab stop so a keyboard can scroll it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/center", class: "bp-card") {
                Text("Center", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Its children in the middle of it, across and down.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/sticky", class: "bp-card") {
                Text("Sticky", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A box that sticks to the top of its scrolling parent (offset: below it) as the page scrolls past, marked data-stuck while it is stuck.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/panelgroup", class: "bp-card") {
                Text("PanelGroup", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Panels side by side (or .vertical, one above another) with a handle between each two that resizes them: dragged, or the arrow keys on it. bind: holds their sizes in percent — a persist keeps them across visits — and on resize(e) hears them as e.detail.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/clientonly", class: "bp-card") {
                Text("ClientOnly", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Its block drawn in the browser alone, never in the static paint, a template or a PDF: a clock, the reader's own data. A placeholder \{ … \} block is what those show in its place.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/appshell", class: "bp-card") {
                Text("AppShell", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("An app's frame: AppShell.Header across the top, a Sidebar down the start (a drawer on a narrow screen), the Router's page beside it, and an AppShell.Footer.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/host", class: "bp-card") {
                Text("Host", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A bare node handed to somebody else's code, with a lifetime. mount: runs with the node each time it is made, update: again whenever the state it reads changes, and cleanup: when the page, branch or list item it belongs to leaves. Every other element takes the same three.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/portal", class: "bp-card") {
                Text("Portal", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Its block, drawn into a node somebody else's code owns: an element a script hands over, or a ref: handle. When into: names another node the block moves there with its nodes and state; null keeps it aside until a node comes back; it goes when the page, branch or list item it is written in leaves. What is inside belongs to where it is written: its handlers, emit and lifetimes.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/element", class: "bp-card") {
                Text("Element", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A custom element a script defines, placed by its tag: Element(\"stripe-pricing-table\", publishableKey: key) \{ on ready \{ … \} \}. Every named argument is an attribute, every on handler an event it fires, and the block its children.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Navigation", id: "navigation").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/navbar", class: "bp-card") {
                Text("Navbar", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Top navigation bar with brand, links and action areas.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/sidebar", class: "bp-card") {
                Text("Sidebar", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Side navigation. A Sidebar.Item whose to matches the current route is marked .active and aria-current=\"page\".", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/link", class: "bp-card") {
                Text("Link", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Client-side navigation link; its label or its block is the link text.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/tabs", class: "bp-card") {
                Text("Tabs", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Tab strip switching between its pages: the arrow keys move between the tabs (the other way round in a right-to-left page), Home and End go to the ends.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/breadcrumb", class: "bp-card") {
                Text("Breadcrumb", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Breadcrumb trail. An item without to is the current page.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/menu", class: "bp-card") {
                Text("Menu", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A menu above everything: opened by its trigger: button, or by visible: at an anchor: or a point at: — a context menu. Escape, a press outside or a choice close it, write false back to visible: and fire on close.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/navigationmenu", class: "bp-card") {
                Text("NavigationMenu", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A site's main navigation whose entries open panels (a mega menu) as disclosures: one open at a time, the arrow keys along the row, Down into a panel, Escape, a press outside or the focus leaving closes it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/menubar", class: "bp-card") {
                Text("Menubar", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("File, Edit and View, as in a desktop app: one Tab stop, the arrow keys along it; Down or Enter opens a menu, and with one open Left and Right open the one beside it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/contextmenu", class: "bp-card") {
                Text("ContextMenu", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("What it wraps, and a menu a right-click, a long press, the menu key or Shift+F10 inside it opens where it happened.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/bottomnavigation", class: "bp-card") {
                Text("BottomNavigation", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A phone's tab bar along the bottom of the screen: each entry an icon over its words, at least 44px to press, clear of the home indicator (the safe-area inset); the current route's is marked.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/prevnext", class: "bp-card") {
                Text("PrevNext", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The pages before and after this one in an ordered set — a guide's chapters: each a link that says which way it goes and the page's title.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/onthispage", class: "bp-card") {
                Text("OnThisPage", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The page's headings as links, the one being read marked as the reader scrolls: a table of contents beside a long page.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/pagination", class: "bp-card") {
                Text("Pagination", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Pages of a list: Previous, the first and last pages, those around the current one with a gap for the rest, and Next. The current page is aria-current=\"page\"; bind: holds it, from 1.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/stepper", class: "bp-card") {
                Text("Stepper", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Steps taken in order — an account, then billing, then a summary — with each step's state (done, current, an error) and the current step's block shown. bind: holds the current step, from 0; .linear keeps a step out of reach until the ones before it are passed.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/commandpalette", class: "bp-card") {
                Text("CommandPalette", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A dialog of everything a reader can do or go to, filtered as they type: the arrow keys go through what matches, Enter runs it (on select) and closes. open: is the state that shows it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Routing", id: "routing").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/router", class: "bp-card") {
                Text("Router", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Where the current page renders. May sit at any depth inside app; pages declare their own paths.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Data display", id: "data-display").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/descriptionlist", class: "bp-card") {
                Text("DescriptionList", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Terms and what they are (<dl>): a column of pairs, or .grid, each term beside its value.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/timeline", class: "bp-card") {
                Text("Timeline", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Events in order (<ol>), each a dot on a line, its title, its time and its block.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/avatargroup", class: "bp-card") {
                Text("AvatarGroup", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Avatars overlapping in a row: past max: the rest are one +3.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/item", class: "bp-card") {
                Text("Item", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A row of a list, a settings page or a search's results: Item.Media at its start, its title: and description:, then its block, and Item.Actions at its end.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/sparkline", class: "bp-card") {
                Text("Sparkline", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A tiny chart in a line of text — a line, or .bar — of a list of numbers, drawn as an SVG when the page is built.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/relativetime", class: "bp-card") {
                Text("RelativeTime", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A moment as 3 minutes ago, kept current, with the exact time on hover (<time>).", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/card", class: "bp-card") {
                Text("Card", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Card surface with optional header, body and footer sections.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/table", class: "bp-card") {
                Text("Table", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Data table. Cells inside Table.Head render as <th scope=\"col\">; caption is the table's accessible name, visually hidden.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/list", class: "bp-card") {
                Text("List", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("List of its children; ordered for a numbered list.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/badge", class: "bp-card") {
                Text("Badge", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Small status label.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/tag", class: "bp-card") {
                Text("Tag", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Compact chip.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/avatar", class: "bp-card") {
                Text("Avatar", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A picture of a person, or their initials.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/tooltip", class: "bp-card") {
                Text("Tooltip", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Shows text above everything when its child is hovered (after delay:) or focused from the keyboard.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/tree", class: "bp-card") {
                Text("Tree", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Nested items — files and folders, an outline — as a tree a keyboard can work: Up and Down through what shows, Right to open and go in, Left to close and go out (the other way round right to left), Home and End, a letter. row(item) \{ … \} draws each; bind: holds the chosen item's key, or a list of keys with .multiple.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/datatable", class: "bp-card") {
                Text("DataTable", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Rows of records with their columns declared once: a column sorts when it is .sortable (its header a button, aria-sort saying which way), cell(r) \{ … \} draws a cell, empty \{ … \} shows when there are no rows, and bind: chooses rows (a list with .multiple, a box for each and one for all).", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/chart", class: "bp-card") {
                Text("Chart", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A chart drawn as vector graphics when the page is built: bars, lines, areas, a pie or a donut over a list of records.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/qrcode", class: "bp-card") {
                Text("QrCode", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A QR code for a URL or any text, drawn as vector graphics when the page is built.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Content", id: "content").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/callout", class: "bp-card") {
                Text("Callout", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A note set apart from the text around it — .note, .tip, .important, .warning, .caution — with an icon and a title, as GitHub's alerts are. Its text is the positional, in Markdown (code, **bold**, a link), or its block.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/kbd", class: "bp-card") {
                Text("Kbd", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A key or a combination, written as this system writes it: Kbd(\"mod+k\") is ⌘K on a Mac and Ctrl+K elsewhere.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/emptystate", class: "bp-card") {
                Text("EmptyState", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("What a list or a page shows when it has nothing yet: an icon, a title, a sentence and, in its block, what to do about it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/stat", class: "bp-card") {
                Text("Stat", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A figure with its label — revenue, sign-ups — and how it moved: Stat(\"Revenue\", value: total, format: .currency, change: 0.124). count: counts to a new value.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/codeblock", class: "bp-card") {
                Text("CodeBlock", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A block of code with a bar above it: a file name, a copy button (.copy), and line numbers (.lines). language: colours it, as on Code; highlight: marks lines; files: makes it a tab for each file.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/chip", class: "bp-card") {
                Text("Chip", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A compact label — a filter, a tag, a person — that can carry an icon, be pressed (selected:, with on click), and be removed (.removable, with on remove). Tag is the one that does none of it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/visuallyhidden", class: "bp-card") {
                Text("VisuallyHidden", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Words for a screen reader only: Link(…) \{ Text(\"Docs\")  VisuallyHidden(\"(opens in a new tab)\") \}.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/accordion", class: "bp-card") {
                Text("Accordion", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Sections a reader opens one by one, each a native <details>: Accordion.Item(\"Shipping\") \{ … \}. .single keeps one open at a time.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Form", id: "form").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/colorpicker", class: "bp-card") {
                Text("ColorPicker", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A colour, chosen from swatches: (each a button, the chosen one pressed), with the browser's own picker, or typed as hex; bind: holds it as #rrggbb.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/transferlist", class: "bp-card") {
                Text("TransferList", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Two lists side by side — what can be chosen and what is — with buttons that move the selected across, or all of them; bind: holds the keys of the chosen.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/editable", class: "bp-card") {
                Text("Editable", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Text that turns into a field when pressed: Enter or leaving keeps what was typed, Escape puts it back; bind: holds the text.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/input", class: "bp-card") {
                Text("Input", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Text field. With label, hint or error it is a labelled field.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/select", class: "bp-card") {
                Text("Select", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Drop-down of Select.Option children.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/checkbox", class: "bp-card") {
                Text("Checkbox", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Checkbox bound to a boolean state.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/radio", class: "bp-card") {
                Text("Radio", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One choice of a group; every radio bound to the same state is one group.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/switch", class: "bp-card") {
                Text("Switch", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("On/off toggle bound to a boolean state.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/slider", class: "bp-card") {
                Text("Slider", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Range input. aria-* and its other attributes reach the input; with aria-valuetext the raw number is not shown beside the track.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/datepicker", class: "bp-card") {
                Text("DatePicker", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A date field: the reader picks a day, and the bound state holds a Date.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/fileupload", class: "bp-card") {
                Text("FileUpload", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("File input; bind: holds what was chosen, and on change hears it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/form", class: "bp-card") {
                Text("Form", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Groups controls; on submit runs when it is submitted, and the page never navigates away.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/textarea", class: "bp-card") {
                Text("Textarea", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Several lines of text. With label, hint or error it is a labelled field; with maxLength it counts what is left.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/field", class: "bp-card") {
                Text("Field", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A label, a hint and an error around a control of your own: the first control in its block is named by the label and described by the hint and the error, and marked invalid while there is one.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/fieldset", class: "bp-card") {
                Text("Fieldset", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Controls that belong together — an address, a choice of plan — under a legend that names them.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/inputgroup", class: "bp-card") {
                Text("InputGroup", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("An input drawn as one box with what goes beside it: an icon, InputGroup.Addon(\"https://\"), a button, or InputGroup.Clear, which empties the input and gives it the focus back.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/radiogroup", class: "bp-card") {
                Text("RadioGroup", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One choice of several, as native radio buttons under a legend: the arrow keys move between them, and .cards draws each as a card with its hint.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/numberinput", class: "bp-card") {
                Text("NumberInput", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A number with − and + beside it: the arrow keys step it, PageUp and PageDown by ten steps, and it stays between min: and max:.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/calendar", class: "bp-card") {
                Text("Calendar", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A month as a grid of days, chosen with a press or the keyboard — the arrows by day and week, PageUp and PageDown by month, Home and End to the week's ends — one day, a range, or several. bind: holds a Date, a \{ start, end \} with .range, a list with .multiple.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/listbox", class: "bp-card") {
                Text("Listbox", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A list of options always shown, one chosen (selection follows the arrow keys) or, .multiple, several: Space chooses, Shift with an arrow takes the next one in too, Ctrl or ⌘ with A takes them all; a letter goes to the next option that starts with it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/combobox", class: "bp-card") {
                Text("Combobox", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A text field that offers what matches as the reader types: from options:, or search: asked of a server. The arrow keys go through the offers, Enter takes one, Escape closes them; .multiple keeps several, each a chip Backspace takes back. option(o) \{ … \} draws an offer; empty \{ … \} shows when nothing matches.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/checkboxgroup", class: "bp-card") {
                Text("CheckboxGroup", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Check boxes under a legend whose bind: is the list of the values ticked, with all: a box above them for every one at once — ticked when all are, mixed when some are.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/inputotp", class: "bp-card") {
                Text("InputOTP", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A one-time code typed a digit to a box: the focus moves on as each is typed and back with Backspace, and a code pasted into any box fills them all; the browser offers the code it was sent (autocomplete=\"one-time-code\").", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/taginput", class: "bp-card") {
                Text("TagInput", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Words typed into a field, each a chip once Enter or a comma ends it; Backspace in the empty field takes the last back, and each chip has a button to take it out.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/rating", class: "bp-card") {
                Text("Rating", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Stars, as radio buttons a screen reader hears as a choice of one to max:: the arrow keys move between them; .half takes halves; .readonly only shows.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/daterangepicker", class: "bp-card") {
                Text("DateRangePicker", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A first and a last day, chosen in two months side by side that a button opens, or by a preset: presets: [.last7, .thisMonth]. bind: holds \{ start, end \}.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Feedback", id: "feedback").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/hovercard", class: "bp-card") {
                Text("HoverCard", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A preview card at a link or a button: shown after delay: ms of hover, at once on focus; it stays while the pointer is on it, and goes when the pointer leaves both, on Escape or on a press outside.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/loadingoverlay", class: "bp-card") {
                Text("LoadingOverlay", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A region covered while it is busy: aria-busy on it, its content out of reach, and a spinner with label: over it — the region, not the page.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/tour", class: "bp-card") {
                Text("Tour", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A tour of the page while open: holds: each step in a card at its target: (a ref:), lit through a cut-out in the dimmed page, with Back, Next and Done; Escape ends it and writes false back. on finish hears Done, on close any end.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/consentbanner", class: "bp-card") {
                Text("ConsentBanner", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The reader's say over the scripts that track them: shown until they choose, Decline as easy as Accept, and the choice kept. Accepting loads the meta.scripts entries marked \"load\": \"consent\", then and on every later visit; nothing loads before.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/consentsettings", class: "bp-card") {
                Text("ConsentSettings", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A button that asks the reader again — a footer's \"Cookie settings\": it forgets their answer and shows the ConsentBanner. A script already loaded stays until the page is loaded again.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/circularprogress", class: "bp-card") {
                Text("CircularProgress", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A ring that fills to value: of max:, announced as a progress bar; with no value:, it turns, for work of no known length. Its block is drawn in the middle.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/meter", class: "bp-card") {
                Text("Meter", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A level against its range (<meter>): a disk's use, a password's strength. Past high: or under low: it says so in its colour; optimum: says which end is good.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/popconfirm", class: "bp-card") {
                Text("Popconfirm", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A question beside the button in its block before what it does: the button opens it, on confirm hears yes, on cancel no or Escape; the focus starts on the answer that loses nothing.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/alert", class: "bp-card") {
                Text("Alert", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Inline notice; a danger or warning one is announced as an alert.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/toast", class: "bp-card") {
                Text("Toast", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Temporary notification.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/modal", class: "bp-card") {
                Text("Modal", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Modal <dialog>, opened by a state flag; the browser supplies focus trapping and Escape. on close runs when it closes, however it was closed, and the focus goes back to what had it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/popover", class: "bp-card") {
                Text("Popover", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A layer at a control: drawn above everything, placed against its anchor:, closed by Escape or a press outside, which write false back to visible: and fire on close.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/dialog", class: "bp-card") {
                Text("Dialog", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Confirmation <dialog>, opened by a state flag. on close runs when it closes, however it was closed, and the focus goes back to what had it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/alertdialog", class: "bp-card") {
                Text("AlertDialog", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A <dialog> that asks before something that cannot be undone: role=\"alertdialog\", its body read out with its title, and closed by Escape or its own buttons, not a press outside. For a question asked from a handler, await ask(…) draws one.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/sheet", class: "bp-card") {
                Text("Sheet", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A modal <dialog> that comes in from an edge: the bottom (a phone's filters, a share list) or the start or end of the line. Dragged by its handle or heading toward its edge it closes; a bottom sheet with snap: points settles at the nearest.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/spinner", class: "bp-card") {
                Text("Spinner", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Loading indicator, announced as a status.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/progress", class: "bp-card") {
                Text("Progress", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Progress bar; a value that reads state moves with it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/skeleton", class: "bp-card") {
                Text("Skeleton", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Placeholder shape shown while content loads.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Actions", id: "actions").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/fab", class: "bp-card") {
                Text("Fab", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A round button floating at the bottom of the screen for the page's main action; with Fab.Actions in its block it opens them instead (a speed dial).", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/backtotop", class: "bp-card") {
                Text("BackToTop", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A button that appears once the page has scrolled past after: px, and takes the reader — and the focus — back to the top.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/copybutton", class: "bp-card") {
                Text("CopyButton", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A button that copies value: to the clipboard, says Copied for a moment, and tells a screen reader so.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/themetoggle", class: "bp-card") {
                Text("ThemeToggle", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A button that switches the page between light and dark, over setTheme: a moon in a light page, a sun in a dark one, named for the theme it switches to. The reader's choice is kept.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/localeswitch", class: "bp-card") {
                Text("LocaleSwitch", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One button for each of i18n.locales, each written in its own language (English, العربية), the current one pressed; a press is setLocale.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/toggle", class: "bp-card") {
                Text("Toggle", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A button that stays pressed while its state holds — bold in an editor, a filter that is on: aria-pressed, a press flipping bind:.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/togglegroup", class: "bp-card") {
                Text("ToggleGroup", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Buttons of which one is chosen — a view switcher, a segmented control — or, .multiple, several: one stop for Tab, the arrow keys inside it, each aria-pressed. bind: holds the chosen value: (a list with .multiple).", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/button", class: "bp-card") {
                Text("Button", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A button: its label or block is what it shows, on click what it does.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/iconbutton", class: "bp-card") {
                Text("IconButton", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Icon-only button. label is its accessible name, never visible text.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/buttongroup", class: "bp-card") {
                Text("ButtonGroup", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Buttons joined into one row.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/dropdown", class: "bp-card") {
                Text("Dropdown", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Button that opens a menu of Dropdown.Items.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Media", id: "media").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/lightbox", class: "bp-card") {
                Text("Lightbox", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Every picture in its block opens, on a press or Enter, full screen: the arrow keys and a swipe go between them, a double press or + zooms, Escape closes and the focus goes back. A picture's data-full: is the file it opens, else its largest size.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/gallery", class: "bp-card") {
                Text("Gallery", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Pictures in a grid of columns: (unset, as many as fit), each cropped to one shape — ratio:, unset square. In a Lightbox, each opens full screen.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/image", class: "bp-card") {
                Text("Image", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Image; alt is required for accessibility (rule A01). Given an image the program declares, it becomes a <picture> with every width the build wrote.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/video", class: "bp-card") {
                Text("Video", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Video player. Without captions it draws an A09 warning: a video nobody can hear is a video nobody can follow.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/audio", class: "bp-card") {
                Text("Audio", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Audio player. transcript links what was said, which is what a reader who cannot hear it needs.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/frame", class: "bp-card") {
                Text("Frame", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Another page, shown inside this one: an iframe — the page at src:, or the HTML srcdoc: gives it, sandboxed as sandbox: says. on message(m) hears what that page posts to this one (m.data), and nothing any other page posts. Without title: it draws an A17 warning: a frame is announced by its title.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/icon", class: "bp-card") {
                Text("Icon", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One of the built-in SVG icons, rendered inline.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/carousel", class: "bp-card") {
                Text("Carousel", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Slide track with named controls and dots; optional autoplay.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Typography", id: "typography").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/highlight", class: "bp-card") {
                Text("Highlight", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Text with every match of query: marked (<mark>), as a search's results show what was found; the case is ignored.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/text", class: "bp-card") {
                Text("Text", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("A paragraph of text. \{…\} in the string reads state and stays live.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/heading", class: "bp-card") {
                Text("Heading", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Heading; level picks the tag (h2 when none is given).", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/code", class: "bp-card") {
                Text("Code", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Inline code, or a code block with block; language: colours it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/markdown", class: "bp-card") {
                Text("Markdown", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Markdown text rendered as HTML: headings, paragraphs, lists, quotes, code, links, emphasis. The text is escaped first, so HTML in it is shown, not run, and a link or picture whose URL a browser would run is drawn as its words. .inert is for text somebody else wrote.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/unsafe", class: "bp-card") {
                Text("Unsafe", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The one door for markup a page did not write. It has a single part, Unsafe.Html.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/blockquote", class: "bp-card") {
                Text("Blockquote", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Quotation: the text, or its block as the quoted content.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("PDF", id: "pdf").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/tableofcontents", class: "bp-card") {
                Text("TableOfContents", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("The document's headings with the page each lands on, each a link to it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/document", class: "bp-card") {
                Text("Document", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Root of a PDF document: the paper, the margins and what the file says about itself.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/section", class: "bp-card") {
                Text("Section", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Groups content with spacing; on the web, a <section>.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/paragraph", class: "bp-card") {
                Text("Paragraph", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Block of text with paragraph spacing.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/header", class: "bp-card") {
                Text("Header", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Repeated at the top of every PDF page (or those on: names), where page and pages are the page's number and the count; a <header> on the web.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/footer", class: "bp-card") {
                Text("Footer", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Repeated at the bottom of every PDF page (or those on: names), where page and pages are the page's number and the count; a <footer> on the web.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/background", class: "bp-card") {
                Text("Background", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Drawn behind each PDF page's content, the size of the page: a cover, a band, a full-bleed picture.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/watermark", class: "bp-card") {
                Text("Watermark", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Large, faint, rotated text behind each PDF page's content.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/pagebreak", class: "bp-card") {
                Text("PageBreak", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Forces a new PDF page.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading("Slides", id: "slides").h2
        Grid(columns: { base: 1, sm: 2, xl: 3 }, gap: .sm) {
            Link(to: "/reference/presentation", class: "bp-card") {
                Text("Presentation", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Root of a slide deck; its children must be slides.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/slide", class: "bp-card") {
                Text("Slide", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One slide, one PDF page; content is top-aligned and clipped at the bottom margin.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/titleslide", class: "bp-card") {
                Text("TitleSlide", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Cover slide: title and subtitle, vertically centred.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/sectionslide", class: "bp-card") {
                Text("SectionSlide", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Full-bleed coloured band with a centred label.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/twocolumn", class: "bp-card") {
                Text("TwoColumn", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Two equal columns; takes exactly two Container children.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/imageslide", class: "bp-card") {
                Text("ImageSlide", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("Image slide with an optional caption.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
        }
        Heading(t("ref.universal.title"), id: "on-every-element").h2
        Markdown(t("ref.universal.body"), class: "bp-prose")
        PropsTable(rows: [{ name: "animate:", type: "one of its cases", meaning: "Animation played when the element appears. Written as a flag, `.fadeIn`, or by name, `animate: .fadeIn`.\n\n- `.fadeIn`: Fade in\n- `.fadeOut`: Fade out\n- `.slideUp`: Slide up into place\n- `.slideDown`: Slide down into place\n- `.slideLeft`: Slide in from the right\n- `.slideRight`: Slide in from the left\n- `.scaleIn`: Grow into place\n- `.scaleOut`: Shrink away\n- `.bounce`: Bounce\n- `.shake`: Shake\n- `.pulse`: Pulse\n- `.spin`: Spin\n- `.expand`: Open to the height of what is inside, which CSS alone cannot do\n- `.collapse`: Close to nothing" }, { name: "exit:", type: "one of its cases", meaning: "Animation played when the element leaves. Written by name: `exit: .fadeIn`.\n\n- `.fadeIn`: Fade in\n- `.fadeOut`: Fade out\n- `.slideUp`: Slide up into place\n- `.slideDown`: Slide down into place\n- `.slideLeft`: Slide in from the right\n- `.slideRight`: Slide in from the left\n- `.scaleIn`: Grow into place\n- `.scaleOut`: Shrink away\n- `.bounce`: Bounce\n- `.shake`: Shake\n- `.pulse`: Pulse\n- `.spin`: Spin\n- `.expand`: Open to the height of what is inside, which CSS alone cannot do\n- `.collapse`: Close to nothing" }, { name: "speed:", type: "one of its cases", meaning: "How fast its animation runs. Written as a flag, `.fast`, or by name, `speed: .fast`.\n\n- `.fast`: 150ms\n- `.normal` (the default): The default\n- `.slow`: 500ms", default: ".normal" }, { name: "duration:", type: "String", meaning: "Animation length, e.g. `300ms`" }, { name: "delay:", type: "String", meaning: "Wait before the animation starts" }, { name: "easing:", type: "one of its cases", meaning: "How the animation is paced — a named easing, or any CSS timing function. Written by name: `easing: .standard`.\n\n- `.standard` (the default): The design's own pacing\n- `.spring` (the default): Overshoots a little and settles, like a real spring\n- `.ease` (the default): Slow at both ends\n- `.easeIn` (the default): Slow to start\n- `.easeOut` (the default): Slow to stop\n- `.easeInOut` (the default): Slow at both ends, more so than `ease`\n- `.linear` (the default): The same speed throughout\n- `.bouncy` (the default): Overshoots hard\n- `.smooth` (the default): Even, with no overshoot", default: ".standard" }, { name: "stagger:", type: "String", meaning: "Delay added per item of a list, e.g. `50ms`" }, { name: "on:", type: "one of its cases", meaning: "When its animation plays. Written by name: `on: .mount`.\n\n- `.mount`: When it appears (the default)\n- `.enterView`: When it first scrolls into view" }, { name: "count:", type: "String", meaning: "How long the number it shows takes to count to a new value, e.g. `600ms`" }, { name: "shared:", type: "String", meaning: "A name this element keeps across a route change, so the browser carries it from one page to the next" }, { name: "class:", type: "String", meaning: "Classes added beside the engine's, from the project's own stylesheets" }, { name: "ref:", type: "State", meaning: "A handle on the element, usable as the element: `ref: nameInput`, then `nameInput.focus()`" }, { name: "drag:", type: "Json", meaning: "What it carries when it is picked up — by a mouse moved a few pixels, or a finger held still — and dropped on something with `on receive(d)`" }, { name: "dragGroup:", type: "String", meaning: "Which drops it belongs to: a drag goes only to targets of its own group, so tabs and tree rows stay apart" }, { name: "dropValue:", type: "Json", meaning: "What this target is, as a drag sees it: `d.over` in the drag's `on dragmove(d)` and in `on receive(d)`" }, { name: "dropAxis:", type: "one of its cases", meaning: "Which way its list runs, for where a drop lands. Written by name: `dropAxis: .y`.\n\n- `.y` (the default): A list down the page: before is above, after below (the default)\n- `.x` (the default): A list across it, a tab strip: before is to the start, after to the end", default: ".y" }, { name: "dropInside:", type: "Bool", meaning: "A drop on its middle lands inside it — a folder, a container — as well as before or after. Written as a flag, `.dropInside`, or `dropInside: true`." }, { name: "roving:", type: "one of its cases", meaning: "One Tab stop for the group, and the arrow keys, Home, End and the first letters of a name to move inside it: a toolbar, a row of choices, a list. Written by name: `roving: .x`.\n\n- `.x` (the default): A row: ArrowLeft and ArrowRight move, the other way round in a right-to-left box\n- `.y` (the default): A column: ArrowUp and ArrowDown move\n- `.both` (the default): Both: a wrapping row of choices", default: ".x" }, { name: "trapFocus:", type: "Bool", meaning: "While true, focus moves into it and Tab and Shift+Tab stay inside; when it turns false or the element leaves, focus goes back where it was. Written as a flag, `.trapFocus`, or `trapFocus: true`." }, { name: "mount:", type: "(Element) -> Handle", meaning: "Run with the element each time it is made — `mount: (n) => initTilt(n)` — and what it returns is the handle `update:` and `cleanup:` get" }, { name: "update:", type: "(Handle) -> ()", meaning: "Run with the handle again whenever the state it reads changes: `update: (h) => h.setMax(max)`" }, { name: "cleanup:", type: "(Handle) -> ()", meaning: "Run with the handle when the element leaves — a route change, an `if` branch, a list item: `cleanup: (h) => h.destroy()`" }], caption: t("ref.universal.title"))
        EventsTable(rows: [PropRow(name: "click", kind: "", detail: "The element was clicked or activated"), PropRow(name: "input", kind: "", detail: "The value changed, on every keystroke"), PropRow(name: "change", kind: "", detail: "The value was committed"), PropRow(name: "submit", kind: "", detail: "The form was submitted"), PropRow(name: "focus", kind: "", detail: "The element received focus"), PropRow(name: "blur", kind: "", detail: "The element lost focus"), PropRow(name: "keydown", kind: "", detail: "A key went down; `e.key` names it"), PropRow(name: "longpress", kind: "", detail: "Held still for half a second; `p.x`, `p.y` say where. The click it ends with is not a click"), PropRow(name: "swipe", kind: "", detail: "A finger or a pen swept across it; `s.direction` is \"left\", \"right\", \"up\" or \"down\""), PropRow(name: "receive", kind: "", detail: "Something with `drag:` was dropped on it; `d.value` is what, `d.position` \"before\", \"after\" or \"inside\""), PropRow(name: "dragmove", kind: "", detail: "On what is dragged, while it moves: `d.over` is the target's `dropValue` or null, `d.position` where it would land"), PropRow(name: "visible", kind: "", detail: "It came into view: scrolled to, or drawn where the reader is looking. `v.ratio` is how much of it shows. A \"load more\" row's cue"), PropRow(name: "key", kind: "", detail: "One key, named: `on key(\"ctrl+k\") \{ \}`"), PropRow(name: "keyup", kind: "", detail: "A key came up"), PropRow(name: "keypress", kind: "", detail: "A character key was pressed"), PropRow(name: "mouseenter", kind: "", detail: "The pointer entered the element"), PropRow(name: "mouseleave", kind: "", detail: "The pointer left the element"), PropRow(name: "dblclick", kind: "", detail: "The element was double-clicked"), PropRow(name: "auxclick", kind: "", detail: "A button other than the main one was clicked; `e.button` is which — 1 is the middle, which closes a tab"), PropRow(name: "focusin", kind: "", detail: "Focus moved onto the element or something inside it"), PropRow(name: "focusout", kind: "", detail: "Focus left the element or something inside it"), PropRow(name: "contextmenu", kind: "", detail: "The context menu was asked for; `e.preventDefault()` keeps the browser's"), PropRow(name: "mousedown", kind: "", detail: "A mouse button went down over the element"), PropRow(name: "mouseup", kind: "", detail: "A mouse button came up over the element"), PropRow(name: "mousemove", kind: "", detail: "The mouse moved over the element"), PropRow(name: "mouseover", kind: "", detail: "The pointer moved onto the element or one of its children"), PropRow(name: "mouseout", kind: "", detail: "The pointer moved off the element or one of its children"), PropRow(name: "pointerdown", kind: "", detail: "A pointer — mouse, pen or touch — went down"), PropRow(name: "pointerup", kind: "", detail: "A pointer came up"), PropRow(name: "pointermove", kind: "", detail: "A pointer moved"), PropRow(name: "pointerenter", kind: "", detail: "A pointer entered the element"), PropRow(name: "pointerleave", kind: "", detail: "A pointer left the element"), PropRow(name: "pointercancel", kind: "", detail: "The browser took the pointer back, for a scroll or a gesture"), PropRow(name: "touchstart", kind: "", detail: "A finger touched the element"), PropRow(name: "touchend", kind: "", detail: "A finger left the element"), PropRow(name: "touchmove", kind: "", detail: "A finger moved across the element"), PropRow(name: "wheel", kind: "", detail: "The wheel or trackpad scrolled over the element"), PropRow(name: "scroll", kind: "", detail: "The element's content scrolled"), PropRow(name: "reset", kind: "", detail: "The form was reset"), PropRow(name: "invalid", kind: "", detail: "A control failed the browser's own validation"), PropRow(name: "select", kind: "", detail: "Text in a field was selected"), PropRow(name: "copy", kind: "", detail: "Something was copied from the element"), PropRow(name: "cut", kind: "", detail: "Something was cut from the element"), PropRow(name: "paste", kind: "", detail: "Something was pasted into the element; `e.clipboardData` holds it"), PropRow(name: "dragstart", kind: "", detail: "The element started being dragged"), PropRow(name: "drag", kind: "", detail: "The element is being dragged"), PropRow(name: "dragend", kind: "", detail: "A drag of the element ended"), PropRow(name: "dragenter", kind: "", detail: "Something dragged entered the element"), PropRow(name: "dragover", kind: "", detail: "Something dragged is over the element; `e.preventDefault()` allows a drop"), PropRow(name: "dragleave", kind: "", detail: "Something dragged left the element"), PropRow(name: "drop", kind: "", detail: "Something was dropped on the element; `e.dataTransfer` holds it"), PropRow(name: "load", kind: "", detail: "An image, video or frame finished loading"), PropRow(name: "error", kind: "", detail: "An image, video or script failed to load"), PropRow(name: "play", kind: "", detail: "A video or audio started playing"), PropRow(name: "pause", kind: "", detail: "A video or audio paused"), PropRow(name: "ended", kind: "", detail: "A video or audio reached its end"), PropRow(name: "timeupdate", kind: "", detail: "A playing video or audio moved on"), PropRow(name: "animationend", kind: "", detail: "A CSS animation on the element ended"), PropRow(name: "transitionend", kind: "", detail: "A CSS transition on the element ended"), PropRow(name: "toggle", kind: "", detail: "A details element opened or closed")], caption: t("ref.events"))
