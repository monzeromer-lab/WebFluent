page BuiltinTour(path: "/reference/tour", title: "Tour — Reference", description: "Tour: A tour of the page while open: holds: each step in a card at its target: (a ref:), lit through a cut-out in the dimmed page, with Back, Next and…") {
    state touring = false
    state toured = "Not toured yet"
    ReferenceItemShell("Tour", summary: "A tour of the page while open: holds: each step in a card at its target: (a ref:), lit through a cut-out in the dimmed page, with Back, Next and Done; Escape ends it and writes false back. on finish hears Done, on close any end.", signature: "Tour(open: State, back: String, next: String, …) \{ … \}", since: "6.2.0", outputs: [], group: "Feedback", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots")), Anchor(id: "parts", label: t("ref.parts")), Anchor(id: "tour-step", label: "Tour.Step")], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Tour") {
                controls {
                    StageControl({ name: "back", kind: "string", options: [], value: "" })
                    StageControl({ name: "next", kind: "string", options: [], value: "" })
                    StageControl({ name: "done", kind: "string", options: [], value: "" })
                    StageControl({ name: "close", kind: "string", options: [], value: "" })
                    StageControl({ name: "of", kind: "string", options: [], value: "" })
                }
                Row(gap: .sm) {
                    Button("New project", ref: newBtn).primary
                    Button("Import", ref: importBtn)
                    Button("Take the tour") { on click { touring = true } }
                }
                Tour(open: touring) {
                    on finish { toured = "Tour finished" }
                    Tour.Step(target: newBtn, title: "Start here") { Text("Make a project from a template.") }
                    Tour.Step(target: importBtn, title: "Bring your work") { Text("Import a folder you already have.") }
                }
                Text(toured).muted
            }
        }
        notes { Text(t("stage.static"), class: "bp-small") }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"state touring = false
state toured = "Not toured yet"
Row(gap: .sm) {
    Button("New project", ref: newBtn).primary
