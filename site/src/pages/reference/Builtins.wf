            Link("Combobox", to: "/reference/combobox", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "reveal:", type: "Bool", meaning: "With `.password`: a Show/Hide button after the field that shows the password as text and hides it again, pressed (`aria-pressed`) while it shows. Written as a flag, `.reveal`, or `reveal: true`.", default: "false" }, { name: "bind:", type: "State", meaning: "The state it reads and writes as you type: a `String`, a `Number` with `.number` (`null` when emptied), a `Date` with `.date`, a `Time` with `.time`, a `DateTime` with `.datetime`" }, { name: "label:", type: "String", meaning: "Visible label; also the control's accessible name", default: "none" }, { name: "hint:", type: "String", meaning: "Help text under the control, linked to it by `aria-describedby`", default: "none" }, { name: "error:", type: "String", meaning: "Error text (a string; empty when there is none): announced as it appears and sets `aria-invalid`", default: "none" }, { name: "type:", type: "one of its cases", meaning: "What the field holds, and so the keyboard and picker a browser offers; it also sets what `bind:` holds. Written as a flag, `.text`, or by name, `type: .text`.\n\n- `.text` (the default): Plain text\n- `.email`: An email address\n- `.password`: A password, its characters hidden\n- `.number`: A number: `bind:` holds a `Number`\n- `.search`: A search query\n- `.tel`: A phone number\n- `.url`: A URL\n- `.date`: A day, from the browser's date picker: `bind:` holds a `Date`\n- `.time`: A time of day: `bind:` holds a `Time`\n- `.datetime`: A day and a time (`datetime-local`): `bind:` holds a `DateTime`\n- `.color`: A colour, from the browser's picker, as `#rrggbb`", default: "text" }, { name: "placeholder:", type: "String", meaning: "Hint shown while the field is empty", default: "none" }, { name: "value:", type: "String or Number", meaning: "The text it starts with, when no state is bound; `bind:` takes its place", default: "empty" }, { name: "min:", type: "Number or String", meaning: "The lowest value a `.number`, `.date` or `.time` field takes: a number, or a date or time as text (`\"2026-01-01\"`)", default: "none" }, { name: "max:", type: "Number or String", meaning: "The highest value a `.number`, `.date` or `.time` field takes: a number, or a date or time as text", default: "none" }, { name: "step:", type: "Number", meaning: "How far the arrow keys and the spinner move a `.number` value (seconds for `.time`)", default: "the browser's: 1, or 60 for a time" }, { name: "required:", type: "Bool", meaning: "Whether the browser refuses to submit the form while it is empty. Written as a flag, `.required`, or `required: true`.", default: "false" }, { name: "disabled:", type: "Bool", meaning: "Whether the control is inert: it cannot be focused or changed, and a form does not send it. Written as a flag, `.disabled`, or `disabled: true`.", default: "false" }, { name: "size:", type: "one of its cases", meaning: "Its padding and text size. Written as a flag, `.sm`, or by name, `size: .sm`.\n\n- `.sm`: Less padding, smaller text\n- `.md` (the default): The default size\n- `.lg`: More padding, larger text", default: "md" }, { name: "width:", type: "one of its cases", meaning: "Its width. Written as a flag, `.full`, or by name, `width: .full`.\n\n- `.full`: The whole width of its container (an input already is, outside a row)", default: "none: the width of its container" }, { name: "rounded:", type: "Bool", meaning: "Fully rounded ends, a pill shape. Written as a flag, `.rounded`, or `rounded: true`.", default: "false" }], caption: "Props of Input", defaults: true)
        Markdown(t("ref.attrs", { families: "global, aria, data, input", n: 22, props: "`animate:`, `exit:`, `speed:`, `duration:`, `delay:`, `easing:`, `stagger:`, `on:`, `count:`, `shared:`, `class:`, `ref:`, `drag:`, `dragGroup:`, `dropValue:`, `dropAxis:`, `dropInside:`, `roving:`, `trapFocus:`, `mount:`, `update:`, `cleanup:`" }), class: "bp-prose")
