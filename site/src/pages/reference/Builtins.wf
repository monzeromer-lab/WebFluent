page BuiltinMenubar(path: "/reference/menubar", title: "Menubar — Reference", description: "Menubar: File, Edit and View, as in a desktop app: one Tab stop, the arrow keys along it; Down or Enter opens a menu, and with one open Left and Right…") {
    state said = "Pick a command"
    state stageLabel = "Editor"
    ReferenceItemShell("Menubar", summary: "File, Edit and View, as in a desktop app: one Tab stop, the arrow keys along it; Down or Enter opens a menu, and with one open Left and Right open the one beside it.", signature: "Menubar(label: String) \{ … \}", since: "6.2.0", outputs: [], group: "Navigation", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots")), Anchor(id: "parts", label: t("ref.parts")), Anchor(id: "menubar-menu", label: "Menubar.Menu")], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Menubar") {
                controls {
                    StageControl({ name: "label", kind: "string", options: [], value: "" }, live: true, current: stageLabel) { on pick(v) { stageLabel = v } }
                }
                Menubar(label: stageLabel) {
                    Menubar.Menu("File") {
                        Menu.Item(shortcut: "mod+n") { on click { said = "New file" }  Text("New file") }
                        Menu.Item(shortcut: "mod+o") { on click { said = "Open…" }  Text("Open…") }
                        Menu.Divider
                        Menu.Item(shortcut: "mod+s") { on click { said = "Saved" }  Text("Save") }
                    }
                    Menubar.Menu("Edit") {
                        Menu.Item(shortcut: "mod+z") { on click { said = "Undo" }  Text("Undo") }
                        Menu.Item(shortcut: "mod+shift+z") { on click { said = "Redo" }  Text("Redo") }
                    }
                    Menubar.Menu("View") {
                        Menu.Sub(label: "Zoom") {
                            Menu.Item(shortcut: "mod+=") { on click { said = "Zoom in" }  Text("Zoom in") }
                            Menu.Item(shortcut: "mod+-") { on click { said = "Zoom out" }  Text("Zoom out") }
                        }
                    }
                }
                Text(said).muted.sm
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"state said = "Pick a command"
Menubar(label: "Editor") {
    Menubar.Menu("File") {
        Menu.Item(shortcut: "mod+n") { on click { said = "New file" }  Text("New file") }
        Menu.Item(shortcut: "mod+o") { on click { said = "Open…" }  Text("Open…") }
        Menu.Divider
