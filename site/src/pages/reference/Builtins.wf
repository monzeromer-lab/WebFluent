page BuiltinChip(path: "/reference/chip", title: "Chip — Reference", description: "Chip: A compact label — a filter, a tag, a person — that can carry an icon, be pressed (selected:, with on click), and be removed (.removable, with on…") {
    state langs = ["Rust", "TypeScript", "Go", "Python"]
    state openOnly = false
    state stageIcon = "code"
    ReferenceItemShell("Chip", summary: "A compact label — a filter, a tag, a person — that can carry an icon, be pressed (selected:, with on click), and be removed (.removable, with on remove). Tag is the one that does none of it.", signature: "Chip(_ label: String, icon: String, selected: Bool, removable: Bool)", since: "6.2.0", outputs: [], group: "Content", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots")), Anchor(id: "parts", label: t("ref.parts")), Anchor(id: "chip-action", label: "Chip.Action"), Anchor(id: "chip-label", label: "Chip.Label"), Anchor(id: "chip-remove", label: "Chip.Remove")], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Chip") {
                controls {
                    StageControl({ name: "label", kind: "string", options: [], value: "" })
                    StageControl({ name: "icon", kind: "string", options: [], value: "" }, live: true, current: stageIcon) { on pick(v) { stageIcon = v } }
                    StageControl({ name: "selected", kind: "bool", options: [], value: "", sink: "special" })
                    StageControl({ name: "removable", kind: "bool", options: [], value: "", sink: "special" })
                }
                Stack(gap: .sm, align: .start) {
                    Row(gap: .xs) {
                        for l in langs by l {
                            Chip(l, icon: stageIcon).removable { on remove { langs = langs.filter(x => x != l) } }
                        }
                    }
                    Chip("Open issues only", selected: openOnly) { on click { openOnly = !openOnly } }
                    Text("{langs.length} languages, open only: {openOnly}").muted
                }
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"state langs = ["Rust", "TypeScript", "Go", "Python"]
state openOnly = false
Stack(gap: .sm, align: .start) {
    Row(gap: .xs) {
        for l in langs by l {
            Chip(l, icon: "code").removable { on remove { langs = langs.filter(x => x != l) } }
        }
    }
    Chip("Open issues only", selected: openOnly) { on click { openOnly = !openOnly } }
    Text("{langs.length} languages, open only: {openOnly}").muted
}"#, title: "wf")
        Text("A filter row of toggles") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"state picked: [String] = ["web"]
Row(gap: .xs) {
    for f in ["web", "api", "worker"] by f {
        Chip(f, selected: picked.includes(f)) {
            on click { picked = if picked.includes(f) { picked.filter(x => x != f) } else { picked.concat([f]) } }
        }
    }
}"#, title: "wf")
        Row(gap: .sm, align: .center) {
            style { gap: 8px; flex-wrap: wrap; margin-top: 8px }
            Text(t("ref.related"), class: "bp-small")
            Link("Badge", to: "/reference/badge", class: "bp-label bp-mono")
            Link("Tag", to: "/reference/tag", class: "bp-label bp-mono")
            Link("Avatar", to: "/reference/avatar", class: "bp-label bp-mono")
            Link("AvatarGroup", to: "/reference/avatargroup", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "label", type: "String (positional)", meaning: "Its words", default: "—" }, { name: "icon:", type: "String", meaning: "An icon's name, drawn before the words", default: "none" }, { name: "selected:", type: "Bool", meaning: "Pressed (`aria-pressed`): a filter that is on, filled in the primary colour. Given at all, true or false, it makes the chip a toggle button. Written as a flag, `.selected`, or `selected: true`.", default: "none: not a button unless it has `on click`" }, { name: "removable:", type: "Bool", meaning: "A button after the words, named `Remove \{label\}`, that fires `on remove`. Written as a flag, `.removable`, or `removable: true`.", default: "false" }], caption: "Props of Chip", defaults: true)
        Markdown(t("ref.attrs", { families: "global, aria, data", n: 22, props: "`animate:`, `exit:`, `speed:`, `duration:`, `delay:`, `easing:`, `stagger:`, `on:`, `count:`, `shared:`, `class:`, `ref:`, `drag:`, `dragGroup:`, `dropValue:`, `dropAxis:`, `dropInside:`, `roving:`, `trapFocus:`, `mount:`, `update:`, `cleanup:`" }), class: "bp-prose")
        Heading(t("ref.tab.flags"), id: "flags").h2
