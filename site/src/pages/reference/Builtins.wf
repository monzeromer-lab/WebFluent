                Text("File, Edit and View, as in a desktop app: one Tab stop, the arrow keys along it; Down or Enter opens a menu, and with one open Left and Right open the one beside it.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/menubar-menu", class: "bp-card") {
                Text("Menubar.Menu", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One menu of the bar: its button's words, and its Menu.Items, Menu.Subs and Menu.Dividers.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
            }
            Link(to: "/reference/contextmenu", class: "bp-card") {
                Text("ContextMenu", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("What it wraps, and a menu a right-click, a long press, the menu key or Shift+F10 inside it opens where it happened.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
