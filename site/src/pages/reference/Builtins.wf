        Code("Chip.Action(_ text: String) \{ … \}").block
        PropsTable(rows: [{ name: "text", type: "String (positional)", meaning: "Its words", default: "none" }], caption: "Props of Chip.Action", defaults: true)
        Heading("Chip.Label", id: "chip-label").h3
