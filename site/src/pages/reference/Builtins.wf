page BuiltinCombobox(path: "/reference/combobox", title: "Combobox — Reference", description: "Combobox: A text field that offers what matches as the reader types: from options:, or search: asked of a server. The arrow keys go through the offers…") {
    ReferenceItemShell("Combobox", summary: "A text field that offers what matches as the reader types: from options:, or search: asked of a server. The arrow keys go through the offers, Enter takes one, Escape closes them; .multiple keeps several, each a chip Backspace takes back. option(o) \{ … \} draws an offer; empty \{ … \} shows when nothing matches.", signature: "Combobox(bind: State, options: Any, search: Any, …)", since: "6.2.0", outputs: [], group: "Form", entries: BUILTIN_INDEX, sections: [Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slotsparts")), Anchor(id: "example", label: t("ref.example"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Combobox") {
                controls {
                    StageControl({ name: "multiple", kind: "bool", options: [], value: "", sink: "special" })
                    StageControl({ name: "label", kind: "string", options: [], value: "" })
                    StageControl({ name: "placeholder", kind: "string", options: [], value: "" })
                }
                Text(t("stage.later"), class: "bp-small") { style { max-width: 420px; text-align: center } }
            }
        }
        notes { Text(t("stage.static"), class: "bp-small") }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "bind:", type: "State  (required)", meaning: "The chosen option's key (or the option itself without `key:`), or a list with `.multiple`" }, { name: "options:", type: "Any", meaning: "Every option, filtered as the reader types" }, { name: "search:", type: "Any", meaning: "Options asked for as the reader types: `q => Geo.cities(q: q)`" }, { name: "text:", type: "Any  (required)", meaning: "An option's words: `p => p.name`" }, { name: "key:", type: "Any", meaning: "What tells two options apart: `p => p.id`" }, { name: "debounce:", type: "Any", meaning: "How long the typing rests before `search:` is asked (unset, 200ms)" }, { name: "multiple:", type: "Bool", meaning: "Several at once, each a chip" }, { name: "label:", type: "String  (required)", meaning: "Its name for a screen reader" }, { name: "placeholder:", type: "String", meaning: "Shown while it is empty" }], caption: "Props of Combobox")
        Markdown(t("ref.attrs", { families: "global, aria, data", n: 22, props: "`animate:`, `exit:`, `speed:`, `duration:`, `delay:`, `easing:`, `stagger:`, `on:`, `count:`, `shared:`, `class:`, `ref:`, `drag:`, `dragGroup:`, `dropValue:`, `dropAxis:`, `dropInside:`, `roving:`, `trapFocus:`, `mount:`, `update:`, `cleanup:`" }), class: "bp-prose")
        Heading(t("ref.tab.flags"), id: "flags").h2
        Markdown(t("ref.flags.body"), class: "bp-prose")
        Row(gap: .sm) {
            style { gap: 8px; flex-wrap: wrap }
            Text(".multiple", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.events"), id: "events").h2
        Markdown(t("ref.universal.link"), class: "bp-prose")
        Heading(t("ref.slotsparts"), id: "slots").h2
        SlotsAndParts(slots: [], parts: [])
        Heading(t("ref.example"), id: "example").h2
        CodeBlock(#"state city = ""
state cities = [{ id: "par", name: "Paris", country: "France" }, { id: "por", name: "Porto", country: "Portugal" }]
Combobox(bind: city, options: cities, text: c => c.name, key: c => c.id, label: "City") {
    option(c) { Text(c.name)  Text(c.country).muted }
    empty { Text("No city by that name") }
}"#, title: "wf")
        Markdown(t("ref.renders", { cls: "wf-combobox" }), class: "bp-prose")
    }
}

