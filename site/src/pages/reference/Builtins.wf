                controls {
                    StageControl({ name: "value", kind: "number", options: [], value: "" })
                    StageControl({ name: "max", kind: "number", options: [], value: "" }, live: true, current: "{stageMax}") { on pick(v) { stageMax = parseFloat(v) } }
                    StageControl({ name: "label", kind: "string", options: [], value: "" }, live: true, current: stageLabel) { on pick(v) { stageLabel = v } }
                }
                Row(gap: .lg, align: .center) {
                    CircularProgress(value: done, max: stageMax, label: stageLabel) { Text("{done}%").sm }
                    Stack(gap: .xs) {
                        Text("Uploading photos.zip").bold
                        Button("Add 20%").sm { on click { done = if done >= 80 { 100 } else { done + 20 } } }
                    }
                }
            }
