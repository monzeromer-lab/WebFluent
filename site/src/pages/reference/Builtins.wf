            Link("Audio", to: "/reference/audio", class: "bp-label bp-mono")
            Link("Frame", to: "/reference/frame", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "columns:", type: "Number", meaning: "How many pictures across, or one per breakpoint (`\{ base: 2, md: 4 \}`); unset, as many columns at least 10rem wide as fit", default: "as many as fit" }, { name: "ratio:", type: "Number", meaning: "Each picture's shape, width over height (`4 / 3`, `16 / 9`); each is cropped to it (`object-fit: cover`)", default: "`1` (square)" }], caption: "Props of Gallery", defaults: true)
        Markdown(t("ref.attrs", { families: "global, aria, data", n: 22, props: "`animate:`, `exit:`, `speed:`, `duration:`, `delay:`, `easing:`, `stagger:`, `on:`, `count:`, `shared:`, `class:`, `ref:`, `drag:`, `dragGroup:`, `dropValue:`, `dropAxis:`, `dropInside:`, `roving:`, `trapFocus:`, `mount:`, `update:`, `cleanup:`" }), class: "bp-prose")
