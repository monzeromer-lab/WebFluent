        Code("Menu.Item(shortcut: String, checked: Bool, disabled: Bool, …) \{ … \}").block
        PropsTable(rows: [{ name: "shortcut:", type: "String", meaning: "The keys that do the same, `mod+b`, shown at its end as this system writes them (`⌘B`, `Ctrl+B`); in a `Menubar` the keys also run it", default: "none" }, { name: "checked:", type: "Bool", meaning: "A check mark that follows the value (`menuitemcheckbox`, `aria-checked`): the item turns something on and off. Written as a flag, `.checked`, or `checked: true`.", default: "none: a plain item" }, { name: "disabled:", type: "Bool", meaning: "Shown dimmed (`aria-disabled`), skipped by the arrow keys, and cannot be chosen. Written as a flag, `.disabled`, or `disabled: true`.", default: "false" }, { name: "danger:", type: "Bool", meaning: "What it does cannot be taken back — Delete, Discard: drawn in the danger colour. Written as a flag, `.danger`, or `danger: true`.", default: "false" }], caption: "Props of Menu.Item", defaults: true)
        Row(gap: .sm) {
