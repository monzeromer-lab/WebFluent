        Markdown(t("ref.drawnparts.body", { name: "NumberInput" }), class: "bp-prose")
        PropsTable(rows: [{ name: "NumberInput.Decrease", type: "—", meaning: "Its − button." }, { name: "NumberInput.Increase", type: "—", meaning: "Its + button." }], caption: t("ref.drawnparts"), nameLabel: t("ref.part"), typeLabel: t("ref.class"))
