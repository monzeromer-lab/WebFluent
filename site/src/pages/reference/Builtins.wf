                Text("CommandPalette.Item", class: "bp-mono") { style { font-size: 14px; color: $link } }
                Text("One thing to do or go to; on select is what it does.", class: "bp-small") { style { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical } }
