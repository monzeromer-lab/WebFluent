page BuiltinRouter(path: "/reference/router", title: "Router — Reference", description: "Router: Where the current page renders. May sit at any depth inside app; pages declare their own paths.") {
    ReferenceItemShell("Router", summary: "Where the current page renders. May sit at any depth inside app; pages declare their own paths.", signature: "Router(transition: Enum, duration: String) \{ … \}", older: true, outputs: [], group: "Routing", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "E109", title: "An element this output cannot draw", to: "/errors/E109"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05"), RelatedLink(kind: "R03", title: "An app with no Router, or with two", to: "/errors/R03")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Router") {
                controls {
                    StageControl({ name: "transition", kind: "enum", options: ["none", "fade", "slide"], value: "none", sink: "special" })
                    StageControl({ name: "duration", kind: "string", options: [], value: "" })
                }
                Text(t("stage.later"), class: "bp-small") { style { max-width: 420px; text-align: center } }
            }
        }
        notes { Text(t("stage.static"), class: "bp-small") }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"Stack {
    Navbar {
        Navbar.Brand { Link("Ledger", to: "/") }
        Navbar.Links {
            Link("Learn", to: "/learn")
            Link("Reference", to: "/reference")
        }
    }
    Router(transition: .fade, duration: "200ms")
    Text("© 2026 Ledger").muted.sm
}"#, title: "wf")
        Text("Beside a sidebar, pages that slide") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"Row {
    Sidebar {
        Sidebar.Item(to: "/learn", icon: "book") { Text("Learn") }
        Sidebar.Item(to: "/recipes", icon: "list") { Text("Recipes") }
    }
    Container { Router(transition: .slide, duration: "250ms") }
}"#, title: "wf")
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "transition:", type: "one of its cases", meaning: "How a route change moves between pages, through the browser's View Transitions where it has them; none for a reader who asks for less motion. Written as a flag, `.none`, or by name, `transition: .none`.\n\n- `.none` (the default): The next page replaces the last at once\n- `.fade`: The last page fades out, the next fades in\n- `.slide`: The last page slides out to the left, the next in from the right", default: "none" }, { name: "duration:", type: "String", meaning: "How long each half of the transition plays, a CSS time, `200ms`", default: "`$animation-duration-normal`, 300ms" }], caption: "Props of Router", defaults: true)
        Markdown(t("ref.attrs", { families: "global, aria, data", n: 22, props: "`animate:`, `exit:`, `speed:`, `duration:`, `delay:`, `easing:`, `stagger:`, `on:`, `count:`, `shared:`, `class:`, `ref:`, `drag:`, `dragGroup:`, `dropValue:`, `dropAxis:`, `dropInside:`, `roving:`, `trapFocus:`, `mount:`, `update:`, `cleanup:`" }), class: "bp-prose")
        Heading(t("ref.tab.flags"), id: "flags").h2
        Markdown(t("ref.flags.body"), class: "bp-prose")
        Row(gap: .sm) {
            style { gap: 8px; flex-wrap: wrap }
            Text(".none", class: "bp-label bp-mono")
            Text(".fade", class: "bp-label bp-mono")
            Text(".slide", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.events"), id: "events").h2
        Markdown(t("ref.universal.link"), class: "bp-prose")
        Heading(t("ref.slots"), id: "slots").h2
        SlotsTable(slots: [PropRow(name: "children", kind: "", detail: "")])
        Markdown(t("ref.renders", { cls: "wf-router" }), class: "bp-prose")
    }
}

