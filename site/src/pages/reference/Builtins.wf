page BuiltinNumberinput(path: "/reference/numberinput", title: "NumberInput — Reference", description: "NumberInput: A number with − and + beside it: the arrow keys step it, PageUp and PageDown by ten steps, and it stays between min: and max:.") {
    state tickets = 2
    state stageMin = 1
    state stageMax = 10
    state stageStep = 1
    state stageLabel = "Tickets"
    state stageHint = "Ten at most per order."
    ReferenceItemShell("NumberInput", summary: "A number with − and + beside it: the arrow keys step it, PageUp and PageDown by ten steps, and it stays between min: and max:.", signature: "NumberInput(bind: State, min: Number, max: Number, …)", since: "6.2.0", outputs: [], group: "Form", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots")), Anchor(id: "drawn-parts", label: t("ref.drawnparts"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "NumberInput") {
                controls {
                    StageControl({ name: "min", kind: "number", options: [], value: "" }, live: true, current: "{stageMin}") { on pick(v) { stageMin = parseFloat(v) } }
                    StageControl({ name: "max", kind: "number", options: [], value: "" }, live: true, current: "{stageMax}") { on pick(v) { stageMax = parseFloat(v) } }
                    StageControl({ name: "step", kind: "number", options: [], value: "" }, live: true, current: "{stageStep}") { on pick(v) { stageStep = parseFloat(v) } }
                    StageControl({ name: "label", kind: "string", options: [], value: "" }, live: true, current: stageLabel) { on pick(v) { stageLabel = v } }
                    StageControl({ name: "hint", kind: "string", options: [], value: "" }, live: true, current: stageHint) { on pick(v) { stageHint = v } }
                    StageControl({ name: "decrease", kind: "string", options: [], value: "" })
                }
                NumberInput(bind: tickets, min: stageMin, max: stageMax, step: stageStep, label: stageLabel, hint: stageHint)
                Text("Total: ${tickets * 45}").muted
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"state tickets = 2
NumberInput(bind: tickets, min: 1, max: 10, step: 1, label: "Tickets", hint: "Ten at most per order.")
Text("Total: ${tickets * 45}").muted"#, title: "wf")
        Text("Larger steps") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"state storage = 50
NumberInput(bind: storage, min: 10, max: 1000, step: 10, label: "Storage (GB)")"#, title: "wf")
        Row(gap: .sm, align: .center) {
            style { gap: 8px; flex-wrap: wrap; margin-top: 8px }
            Text(t("ref.related"), class: "bp-small")
            Link("Input", to: "/reference/input", class: "bp-label bp-mono")
            Link("Textarea", to: "/reference/textarea", class: "bp-label bp-mono")
            Link("InputOTP", to: "/reference/inputotp", class: "bp-label bp-mono")
            Link("TagInput", to: "/reference/taginput", class: "bp-label bp-mono")
            Link("InputGroup", to: "/reference/inputgroup", class: "bp-label bp-mono")
            Link("Editable", to: "/reference/editable", class: "bp-label bp-mono")
            Link("Combobox", to: "/reference/combobox", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "bind:", type: "State (required)", meaning: "The `Number` state it reads and writes; typing writes `null` when the field is emptied, and a number past `min:` or `max:` is brought back within them when it changes", default: "—" }, { name: "min:", type: "Number", meaning: "The lowest value: − is disabled there, and the buttons and PageDown never go below it (a typed value is not held to it)", default: "none" }, { name: "max:", type: "Number", meaning: "The highest value: + is disabled there, and the buttons and PageUp never go above it (a typed value is not held to it)", default: "none" }, { name: "step:", type: "Number", meaning: "How far −, + and the arrow keys move it; PageUp and PageDown move ten steps", default: "1" }, { name: "label:", type: "String", meaning: "Visible label; also the input's accessible name", default: "none (the input is named `Number`)" }, { name: "hint:", type: "String", meaning: "Help text under the control, linked to it by `aria-describedby`", default: "none" }, { name: "decrease:", type: "String", meaning: "The − button's accessible name, in the page's words: `t(\"qty.less\")`", default: "`Decrease`" }, { name: "increase:", type: "String", meaning: "The + button's accessible name, in the page's words", default: "`Increase`" }], caption: "Props of NumberInput", defaults: true)
        Markdown(t("ref.attrs", { families: "global, aria, data", n: 22, props: "`animate:`, `exit:`, `speed:`, `duration:`, `delay:`, `easing:`, `stagger:`, `on:`, `count:`, `shared:`, `class:`, `ref:`, `drag:`, `dragGroup:`, `dropValue:`, `dropAxis:`, `dropInside:`, `roving:`, `trapFocus:`, `mount:`, `update:`, `cleanup:`" }), class: "bp-prose")
        Heading(t("ref.tab.flags"), id: "flags").h2
