        stage {
            Stage(label: "Stat") {
                controls {
                    StageControl({ name: "label", kind: "string", options: [], value: "" }, live: true, current: stageLabel) { on pick(v) { stageLabel = v } }
                    StageControl({ name: "format", kind: "enum", options: ["number", "integer", "currency", "percent", "compact"], value: "", sink: "special" })
                    StageControl({ name: "change", kind: "number", options: [], value: "" }, live: true, current: "{stageChange}") { on pick(v) { stageChange = parseFloat(v) } }
                }
                Grid(columns: { base: 1, md: 3 }, gap: .md) {
                    Stat(stageLabel, value: 48210, format: .currency, trend: [31, 40, 28, 44, 52, 48], change: stageChange)
                    Stat("Active users", value: 18400, format: .compact, change: 0.031, trend: [15, 16, 16, 17, 18, 18])
                    Stat("Churn", value: 0.021, format: .percent, change: -0.004)
                }
            }
        }
