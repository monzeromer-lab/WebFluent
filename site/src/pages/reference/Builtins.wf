// The reference's index and a page per built-in: written by scripts/docsite/reference.py from `wf registry --json`;
// edit the compiler or the script, not this file.

/// The reference's pages that are not one built-in, in the order the index
/// and the sidebars list them.
const REFERENCE_PAGES: [IndexEntry] = [
    IndexEntry(label: "Expressions", to: "/reference/expressions", group: "Language"),
