                    StageControl({ name: "label", kind: "string", options: [], value: "" }, live: true, current: stageLabel) { on pick(v) { stageLabel = v } }
                }
                LoadingOverlay(visible: saving, label: stageLabel) {
                    Card {
                        Input(bind: name, label: "Name")
                        Button("Save").primary { on click { saving = true } }
                    }
                }
                Button("Finish saving") { on click { saving = false } }
            }
        }
