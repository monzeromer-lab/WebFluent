                    StageControl({ name: "rowHeight", kind: "number", options: [], value: "" }, live: true, current: "{stageRowHeight}") { on pick(v) { stageRowHeight = parseFloat(v) } }
                    StageControl({ name: "estimate", kind: "number", options: [], value: "" })
                    StageControl({ name: "label", kind: "string", options: [], value: "" }, live: true, current: stageLabel) { on pick(v) { stageLabel = v } }
                }
                Text("Picked: {picked}").muted
                VirtualList(reveal: picked, rowHeight: stageRowHeight, label: stageLabel) {
