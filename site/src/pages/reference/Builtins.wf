    state stageLabel = "Deploys"
    ReferenceItemShell("DataTable", summary: "Rows of records with their columns declared once: a column sorts when it is .sortable (its header a button, aria-sort saying which way), cell(r) \{ … \} draws a cell, empty \{ … \} shows when there are no rows, and bind: chooses rows (a list with .multiple, a box for each and one for all).", signature: "DataTable(rows: [Item], key: (Item) -> String or (Item) -> Number, bind: State, …) \{ … \}", since: "6.2.0", outputs: [], group: "Data display", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots")), Anchor(id: "parts", label: t("ref.parts")), Anchor(id: "datatable-column", label: "DataTable.Column")], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "DataTable") {
                controls {
                    StageControl({ name: "multiple", kind: "bool", options: [], value: "", sink: "special" })
                    StageControl({ name: "label", kind: "string", options: [], value: "" }, live: true, current: stageLabel) { on pick(v) { stageLabel = v } }
                    StageControl({ name: "filter", kind: "string", options: [], value: "" })
                    StageControl({ name: "pageSize", kind: "number", options: [], value: "" })
                }
                DataTable(rows: deploys, key: d => d.id, bind: chosen, label: stageLabel).multiple {
                    DataTable.Column("Service", value: d => d.service).sortable
                    DataTable.Column("Region", value: d => d.region)
                    DataTable.Column("Minutes", value: d => d.minutes).sortable
                    DataTable.Column("Status") {
                        cell(d) { Badge(d.status, tone: if d.status == "Live" { .success } else { .danger }) }
                    }
                }
                Text("{chosen.length} chosen").muted
            }
        }
