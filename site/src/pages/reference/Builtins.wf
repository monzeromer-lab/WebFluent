    state plan = "team"
    state stageLabel = "Plan"
    ReferenceItemShell("RadioGroup", summary: "One choice of several, as native radio buttons under a legend: the arrow keys move between them, and .cards draws each as a card with its hint.", signature: "RadioGroup(bind: State, label: String, cards: Bool) \{ … \}", since: "6.2.0", outputs: [], group: "Form", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots")), Anchor(id: "parts", label: t("ref.parts")), Anchor(id: "radiogroup-option", label: "RadioGroup.Option"), Anchor(id: "drawn-parts", label: t("ref.drawnparts"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
