page BuiltinForm(path: "/reference/form", title: "Form — Reference", description: "Form: Groups controls; on submit runs when it is submitted, and the page never navigates away.") {
    state email = ""
    state password = ""
    state sent = ""
    validate email {
        required "Enter your email"
        email "That is not an email address"
    }
    validate password {
        required
        minLength(8) "Use at least 8 characters"
    }
    ReferenceItemShell("Form", summary: "Groups controls; on submit runs when it is submitted, and the page never navigates away.", signature: "Form(bind: State, show: Enum) \{ … \}", older: true, outputs: [], group: "Form", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "E109", title: "An element this output cannot draw", to: "/errors/E109"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Form") {
                controls {
                    StageControl({ name: "show", kind: "enum", options: ["onBlur", "onSubmit", "live"], value: "onBlur", sink: "attribute" })
                }
                Form(bind: form, show: .onBlur) {
                    on submit { sent = "Signed in as {email}" }
                    Input(bind: email, label: "Email").email
                    Input(bind: password, label: "Password").password
                    Button("Sign in", type: .submit, disabled: !form.valid).primary
                }
                Text(if sent == "" { "Not signed in yet." } else { sent }).muted
            }
        }
        notes { Text(t("stage.static"), class: "bp-small") }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"state email = ""
state password = ""
state sent = ""
validate email {
    required "Enter your email"
    email "That is not an email address"
}
validate password {
    required
    minLength(8) "Use at least 8 characters"
}
Form(bind: form, show: .onBlur) {
    on submit { sent = "Signed in as {email}" }
    Input(bind: email, label: "Email").email
    Input(bind: password, label: "Password").password
    Button("Sign in", type: .submit, disabled: !form.valid).primary
}
Text(if sent == "" { "Not signed in yet." } else { sent }).muted"#, title: "wf")
