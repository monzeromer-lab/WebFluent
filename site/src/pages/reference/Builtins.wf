    ReferenceItemShell("Sheet", summary: "A modal <dialog> that comes in from an edge: the bottom (a phone's filters, a share list) or the start or end of the line. Dragged by its handle or heading toward its edge it closes; a bottom sheet with snap: points settles at the nearest.", signature: "Sheet(visible: State, title: String, closable: Bool, …) \{ … \}", since: "6.2.0", outputs: [], group: "Feedback", entries: BUILTIN_INDEX, sections: [Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slotsparts")), Anchor(id: "example", label: t("ref.example"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Sheet") {
                controls {
                    StageControl({ name: "title", kind: "string", options: [], value: "" })
                    StageControl({ name: "closable", kind: "bool", options: [], value: "", sink: "class" })
                    StageControl({ name: "side", kind: "enum", options: ["bottom", "start", "end"], value: "bottom", sink: "special" })
                    StageControl({ name: "label", kind: "string", options: [], value: "" })
                    StageControl({ name: "dismiss", kind: "enum", options: ["any", "escape", "none"], value: "any", sink: "special" })
                }
                Text(t("stage.later"), class: "bp-small") { style { max-width: 420px; text-align: center } }
            }
        }
        notes { Text(t("stage.static"), class: "bp-small") }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "visible:", type: "State", meaning: "State flag that opens and closes it" }, { name: "title:", type: "String", meaning: "Heading shown at the top" }, { name: "closable:", type: "Bool", meaning: "A close button in the heading row, which closes it as Escape does" }, { name: "side:", type: ".bottom .start .end", meaning: "The edge it comes in from" }, { name: "snap:", type: "Any", meaning: "A bottom sheet's heights, as fractions of the window's, `[0.5, 1]`: it opens at the first" }, { name: "label:", type: "String", meaning: "Its accessible name, when it has no `title:`" }, { name: "dismiss:", type: ".any .escape .none", meaning: "What closes it besides the page's own button" }, { name: "initialFocus:", type: "Any", meaning: "What takes the focus when it opens, by its `ref:`; unset, what says `autofocus`, else its first control" }], caption: "Props of Sheet")
        Markdown(t("ref.attrs", { families: "global, aria, data", n: 22, props: "`animate:`, `exit:`, `speed:`, `duration:`, `delay:`, `easing:`, `stagger:`, `on:`, `count:`, `shared:`, `class:`, `ref:`, `drag:`, `dragGroup:`, `dropValue:`, `dropAxis:`, `dropInside:`, `roving:`, `trapFocus:`, `mount:`, `update:`, `cleanup:`" }), class: "bp-prose")
