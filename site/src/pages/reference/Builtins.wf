        Code("DataTable.Column(_ title: String, value: (Item) -> String or (Item) -> Number or (Item) -> Bool or (Item) -> Money, sortable: Bool)").block
        PropsTable(rows: [{ name: "title", type: "String (positional)", meaning: "Its header", default: "—" }, { name: "value:", type: "(Item) -> String or (Item) -> Number or (Item) -> Bool or (Item) -> Money", meaning: "What the column holds for a row: `r => r.service`; shown as text unless `cell(r)` draws it, and what sorting and `filter:` read", default: "none" }, { name: "sortable:", type: "Bool", meaning: "Its header is a button that sorts the rows by its `value:`, ascending then descending (`aria-sort`); needs `value:`. Written as a flag, `.sortable`, or `sortable: true`.", default: "false" }], caption: "Props of DataTable.Column", defaults: true)
