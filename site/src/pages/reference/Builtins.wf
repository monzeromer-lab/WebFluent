                    StageControl({ name: "label", kind: "string", options: [], value: "" }, live: true, current: stageLabel) { on pick(v) { stageLabel = v } }
                    StageControl({ name: "half", kind: "bool", options: [], value: "", sink: "special" })
                    StageControl({ name: "readonly", kind: "bool", options: [], value: "", sink: "special" })
                }
