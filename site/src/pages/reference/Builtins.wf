page BuiltinContainer(path: "/reference/container", title: "Container — Reference", description: "Container: Centred wrapper with a maximum width and horizontal padding.") {
    ReferenceItemShell("Container", summary: "Centred wrapper with a maximum width and horizontal padding.", signature: "Container(fluid: Bool) \{ … \}", older: true, outputs: [], group: "Layout", entries: BUILTIN_INDEX, sections: [Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slotsparts")), Anchor(id: "example", label: t("ref.example"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Container") {
                controls {
                    StageControl({ name: "fluid", kind: "bool", options: [], value: "" })
                }
                Container { Text("Centred, at most the content width") }
            }
        }
        notes { Text(t("stage.static"), class: "bp-small") }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "fluid:", type: "Bool", meaning: "Full width, no maximum" }], caption: "Props of Container")
        Markdown(t("ref.attrs", { families: "global, aria, data", n: 21, props: "`animate:`, `exit:`, `speed:`, `duration:`, `delay:`, `easing:`, `stagger:`, `on:`, `count:`, `shared:`, `class:`, `ref:`, `drag:`, `dragGroup:`, `dropValue:`, `dropAxis:`, `dropInside:`, `trapFocus:`, `mount:`, `update:`, `cleanup:`" }), class: "bp-prose")
        Heading(t("ref.tab.flags"), id: "flags").h2
        Markdown(t("ref.flags.body"), class: "bp-prose")
        Row(gap: .sm) {
            style { gap: 8px; flex-wrap: wrap }
            Text(".fluid", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.events"), id: "events").h2
        Markdown(t("ref.universal.link"), class: "bp-prose")
