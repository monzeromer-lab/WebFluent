        Markdown(t("ref.universal.link"), class: "bp-prose")
        Heading(t("ref.slotsparts"), id: "slots").h2
        SlotsAndParts(slots: [PropRow(name: "children", kind: "", detail: "")], parts: [PropRow(name: "Sheet.Title", kind: "sheet-title", detail: "What the sheet's heading draws, in place of its title:'s words, which stay its name."), PropRow(name: "Sheet.Footer", kind: "sheet-footer", detail: "The sheet's action row, kept in view below what scrolls.")])
        Row(gap: .sm) {
            style { gap: 8px; flex-wrap: wrap }
            Link("Sheet.Title", to: "/reference/sheet-title", class: "bp-button")
            Link("Sheet.Footer", to: "/reference/sheet-footer", class: "bp-button")
        }
        Heading(t("ref.example"), id: "example").h2
        CodeBlock(#"state filters = false
state sort = "new"
Button("Filters") { on click { filters = true } }
Sheet(visible: filters, title: "Filters", snap: [0.5, 1]).closable {
    Radio(bind: sort, value: "new", label: "Newest")
    Radio(bind: sort, value: "price", label: "Price")
    Sheet.Footer { Button("Show results").primary { on click { filters = false } } }
}
state details = false
Sheet(visible: details, side: .end, title: "Details") { Text("Opened 3 days ago") }"#, title: "wf")
        Markdown(t("ref.renders", { cls: "wf-sheet" }), class: "bp-prose")
    }
}

