         subject: "Invoice", keywords: "invoice, november", lang: "en") {
    Header { Text("Northwind Ltd · Invoice INV-2041").muted.sm.right }
    Footer { Text("Northwind Ltd · 12 Harbour Street · Bristol").muted.sm.center }
    Heading("Invoice INV-2041").h1
    Text("Issued 17 November 2026 · Due in 30 days").muted
    Table(caption: "Items") {
        Table.Head { Table.Row { Table.Cell("Item")  Table.Cell("Amount") } }
        Table.Body {
            Table.Row { Table.Cell("Design review")  Table.Cell("€1,200.00") }
            Table.Row { Table.Cell("Hosting, November")  Table.Cell("€90.00") }
        }
    }
    Text("Total: €1,290.00").bold.right
}"#, title: "wf")
        Text("Landscape Letter, by flag") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"Document(title: "Quarterly figures").Letter.landscape {
    Heading("Quarterly figures").h1
}"#, title: "wf")
        Row(gap: .sm, align: .center) {
            style { gap: 8px; flex-wrap: wrap; margin-top: 8px }
            Text(t("ref.related"), class: "bp-small")
            Link("Header", to: "/reference/header", class: "bp-label bp-mono")
            Link("Footer", to: "/reference/footer", class: "bp-label bp-mono")
            Link("Background", to: "/reference/background", class: "bp-label bp-mono")
            Link("Watermark", to: "/reference/watermark", class: "bp-label bp-mono")
            Link("PageBreak", to: "/reference/pagebreak", class: "bp-label bp-mono")
            Link("TableOfContents", to: "/reference/tableofcontents", class: "bp-label bp-mono")
            Link("Section", to: "/reference/section", class: "bp-label bp-mono")
            Link("Paragraph", to: "/reference/paragraph", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "page_size:", type: "one of its cases", meaning: "The paper, as a case (also written `size:`, which takes more); unset, the config's `page_size` under `build.pdf`. Written as a flag, `.A4`, or by name, `page_size: .A4`.\n\n- `.A4` (the default): 210 × 297 mm\n- `.A3`: 297 × 420 mm\n- `.A5`: 148 × 210 mm\n- `.Letter`: 8.5 × 11 in\n- `.Legal`: 8.5 × 14 in", default: "`A4`" }, { name: "size:", type: "String", meaning: "The paper: `A3`–`A6`, `B5`, `Letter`, `Legal`, `Tabloid`, `Executive`, or a width and a height, `210mm 297mm` (a bare number is pt); unset, the config's `page_size` under `build.pdf`", default: "`A4`" }, { name: "landscape:", type: "Bool", meaning: "Turn the paper on its side, its longer edge across; `landscape: false` keeps it upright. Written as a flag, `.landscape`, or `landscape: true`.", default: "false" }, { name: "margin:", type: "Number or String", meaning: "The page margins: one length, or two to four as CSS writes them (`72`, `20mm 25mm`); a bare number is pt; unset, the config's `build.pdf.margins`", default: "72pt each" }, { name: "title:", type: "String", meaning: "The file's title, shown by a reader in place of its name", default: "the page's `title`" }, { name: "author:", type: "String", meaning: "The file's author; several separated by commas", default: "none" }, { name: "subject:", type: "String", meaning: "What the document is about: the file's description", default: "none" }, { name: "keywords:", type: "String", meaning: "Comma-separated keywords", default: "none" }, { name: "lang:", type: "String", meaning: "The document's language (`en`, `ar`): the file's language, and `ar`, `he`, `fa` or `ur` lays it out right to left", default: "`meta.lang`" }], caption: "Props of Document", defaults: true)
        Markdown(t("ref.attrs", { families: "global, aria, data", n: 22, props: "`animate:`, `exit:`, `speed:`, `duration:`, `delay:`, `easing:`, `stagger:`, `on:`, `count:`, `shared:`, `class:`, `ref:`, `drag:`, `dragGroup:`, `dropValue:`, `dropAxis:`, `dropInside:`, `roving:`, `trapFocus:`, `mount:`, `update:`, `cleanup:`" }), class: "bp-prose")
