page BuiltinSticky(path: "/reference/sticky", title: "Sticky — Reference", description: "Sticky: A box that sticks to the top of its scrolling parent (offset: below it) as the page scrolls past, marked data-stuck while it is stuck.") {
    state stageBottom = false
    ReferenceItemShell("Sticky", summary: "A box that sticks to the top of its scrolling parent (offset: below it) as the page scrolls past, marked data-stuck while it is stuck.", signature: "Sticky(offset: String, bottom: Bool) \{ … \}", since: "6.2.0", outputs: [], group: "Layout", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Sticky") {
                controls {
                    StageControl({ name: "offset", kind: "string", options: [], value: "" })
                    StageControl({ name: "bottom", kind: "bool", options: [], value: "", sink: "class" }, live: true, pressed: stageBottom) { on pick(v) { stageBottom = !stageBottom } }
                }
                ScrollArea(height: "240px", label: "Changelog") {
                    style { border: 1px solid $color-border; border-radius: $radius-md }
                    Sticky(bottom: stageBottom) {
                        style { background: $color-background; padding: 0.5rem 0.75rem; border-bottom: 1px solid $color-border }
                        Row(justify: .between, align: .center) {
                            Text("Changelog").bold
                            Badge("7.0").primary
                        }
                    }
                    for v in (0..20).map(i => 19 - i).map(n => "7.0.{n}: fixes and small changes") by v {
                        Text(v) { style { padding: 0.5rem 0.75rem } }
                    }
                }
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"ScrollArea(height: "240px", label: "Changelog") {
