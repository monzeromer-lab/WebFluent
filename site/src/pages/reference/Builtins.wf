page BuiltinMenu(path: "/reference/menu", title: "Menu — Reference", description: "Menu: A menu above everything: opened by its trigger: button, or by visible: at an anchor: or a point at: — a context menu. Escape, a press outside or…") {
    state said = "Nothing chosen yet"
    state pinned = false
    state stageTrigger = "File actions"
    ReferenceItemShell("Menu", summary: "A menu above everything: opened by its trigger: button, or by visible: at an anchor: or a point at: — a context menu. Escape, a press outside or a choice close it, write false back to visible: and fire on close.", signature: "Menu(trigger: String, label: String, visible: State, …) \{ … \}", older: true, outputs: [], group: "Navigation", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots")), Anchor(id: "parts", label: t("ref.parts")), Anchor(id: "menu-item", label: "Menu.Item"), Anchor(id: "menu-sub", label: "Menu.Sub"), Anchor(id: "menu-divider", label: "Menu.Divider")], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "E109", title: "An element this output cannot draw", to: "/errors/E109"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05")], source: "src/registry/builtins.rs") {
        stage {
            Stage(label: "Menu") {
                controls {
                    StageControl({ name: "trigger", kind: "string", options: [], value: "" }, live: true, current: stageTrigger) { on pick(v) { stageTrigger = v } }
                    StageControl({ name: "label", kind: "string", options: [], value: "" })
                    StageControl({ name: "placement", kind: "enum", options: ["bottom", "bottomStart", "bottomEnd", "top", "topStart"], value: "bottomStart", sink: "special" })
                    StageControl({ name: "offset", kind: "number", options: [], value: "" })
                }
                Menu(trigger: stageTrigger).bottomStart {
                    Menu.Item(shortcut: "F2") {
                        on click { said = "Rename" }
                        Text("Rename")
                    }
                    Menu.Item(shortcut: "mod+d") {
                        on click { said = "Duplicate" }
                        Text("Duplicate")
                    }
                    Menu.Item(checked: pinned) {
                        on click { pinned = !pinned }
                        Text("Pinned")
                    }
                    Menu.Sub(label: "Move to") {
                        Menu.Item { on click { said = "Moved to Archive" }  Text("Archive") }
                        Menu.Item { on click { said = "Moved to Drafts" }  Text("Drafts") }
                    }
                    Menu.Divider
                    Menu.Item(shortcut: "mod+backspace").danger {
                        on click { said = "Delete" }
                        Text("Delete")
                    }
                }
                Text(said).muted.sm
            }
        }
        Heading(t("ref.example"), id: "example").h2
        DocsCodeBlock(#"state said = "Nothing chosen yet"
state pinned = false
Menu(trigger: "File actions").bottomStart {
    Menu.Item(shortcut: "F2") {
        on click { said = "Rename" }
        Text("Rename")
    }
    Menu.Item(shortcut: "mod+d") {
        on click { said = "Duplicate" }
        Text("Duplicate")
    }
    Menu.Item(checked: pinned) {
        on click { pinned = !pinned }
        Text("Pinned")
    }
    Menu.Sub(label: "Move to") {
        Menu.Item { on click { said = "Moved to Archive" }  Text("Archive") }
        Menu.Item { on click { said = "Moved to Drafts" }  Text("Drafts") }
    }
    Menu.Divider
    Menu.Item(shortcut: "mod+backspace").danger {
        on click { said = "Delete" }
        Text("Delete")
    }
}
Text(said).muted.sm"#, title: "wf")
        Text("A context menu, opened by state at a point") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"state asked = false
state point = { x: 0, y: 0 }
Card {
    on contextmenu(e) { e.preventDefault()  point = { x: e.clientX, y: e.clientY }  asked = true }
    Text("Right-click here")
}
Menu(visible: asked, at: point) {
    Menu.Item { Text("Copy") }
    Menu.Item { Text("Paste") }
}"#, title: "wf")
        Text("A disabled item") { style { margin: 8px 0 0; font-weight: 600 } }
        DocsCodeBlock(#"Menu(trigger: "Share") {
    Menu.Item { Text("Copy link") }
    Menu.Item(disabled: true) { Text("Publish (owners only)") }
}"#, title: "wf")
        Row(gap: .sm, align: .center) {
            style { gap: 8px; flex-wrap: wrap; margin-top: 8px }
            Text(t("ref.related"), class: "bp-small")
            Link("ContextMenu", to: "/reference/contextmenu", class: "bp-label bp-mono")
            Link("Menubar", to: "/reference/menubar", class: "bp-label bp-mono")
            Link("Dropdown", to: "/reference/dropdown", class: "bp-label bp-mono")
            Link("NavigationMenu", to: "/reference/navigationmenu", class: "bp-label bp-mono")
            Link("CommandPalette", to: "/reference/commandpalette", class: "bp-label bp-mono")
        }
        Heading(t("ref.tab.props"), id: "props").h2
        PropsTable(rows: [{ name: "trigger:", type: "String", meaning: "The words on the button that opens it", default: "`Menu` (no button at all when `visible:` opens it)" }, { name: "label:", type: "String", meaning: "The menu list's accessible name (`aria-label`); it is not the button's words, which `trigger:` gives", default: "none" }, { name: "visible:", type: "State", meaning: "A Bool state that opens and closes it: the button sets it, and Escape, a press outside or a choice write `false`. With no `trigger:`, state alone opens it", default: "false" }, { name: "anchor:", type: "Element or Point", meaning: "What it is placed against: an element's `ref:`, or a point `\{ x: e.clientX, y: e.clientY \}`", default: "its button" }, { name: "at:", type: "Point", meaning: "A point to place it at, `\{ x: e.clientX, y: e.clientY \}`: where the pointer asked for a context menu", default: "none" }, { name: "placement:", type: "one of its cases", meaning: "Where it goes against its anchor; it flips to the other side when there is no room, and slides to stay on screen. Written as a flag, `.bottom`, or by name, `placement: .bottom`.\n\n- `.bottom`: Below, centred\n- `.bottomStart` (the default): Below, lined up with its start edge (the right in a right-to-left page)\n- `.bottomEnd`: Below, lined up with its end edge\n- `.top`: Above, centred\n- `.topStart`: Above, lined up with its start edge\n- `.topEnd`: Above, lined up with its end edge\n- `.left`: To its left, centred\n- `.leftStart`: To its left, from its top\n- `.leftEnd`: To its left, to its bottom\n- `.right`: To its right, centred\n- `.rightStart`: To its right, from its top\n- `.rightEnd`: To its right, to its bottom", default: "bottomStart" }, { name: "offset:", type: "Number", meaning: "The gap between it and its anchor, in px", default: "4" }], caption: "Props of Menu", defaults: true)
