    state stageLabel = "Commits"
    ReferenceItemShell("VirtualList", summary: "A scrolling box that draws only the rows in view of the one keyed for inside it — for a tree, search results or a diff of thousands of rows.", signature: "VirtualList(rowHeight: Number, estimate: Number, reveal: String or Number, …) \{ … \}", since: "5.9.0", outputs: [], group: "Layout", entries: BUILTIN_INDEX, sections: [Anchor(id: "example", label: t("ref.example")), Anchor(id: "props", label: t("ref.tab.props")), Anchor(id: "flags", label: t("ref.tab.flags")), Anchor(id: "events", label: t("ref.tab.events")), Anchor(id: "slots", label: t("ref.slots"))], codes: [RelatedLink(kind: "E103", title: "A flag, case, part, event or slot the component does not have", to: "/errors/E103"), RelatedLink(kind: "C04", title: "An attribute a built-in does not declare", to: "/errors/C04"), RelatedLink(kind: "C05", title: "A positional argument a built-in does not take", to: "/errors/C05"), RelatedLink(kind: "V12", title: "A long list that is not windowed", to: "/errors/V12")], source: "src/registry/builtins.rs") {
