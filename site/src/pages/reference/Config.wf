// Every key of webfluent.app.json, by section: written by scripts/docsite/reference.py from `wf config schema --json`;
// edit the compiler or the script, not this file.

page ConfigPage(path: "/reference/config", title: "Configuration — Reference", description: "Every key of webfluent.app.json, its type and default: project, build, media, PDF, slides, dev, motion, meta, theme, i18n, env, offline and lints.") {
    ReferenceItemShell(t("config.title"), summary: t("config.lede", { count: 86 }), signature: "webfluent.app.json", group: t("config.title"), entries: REFERENCE_PAGES, sections: [Anchor(id: "keys-project", label: "project"), Anchor(id: "keys-theme", label: "theme"), Anchor(id: "keys-build", label: "build"), Anchor(id: "keys-dev", label: "dev"), Anchor(id: "keys-meta", label: "meta"), Anchor(id: "keys-motion", label: "motion"), Anchor(id: "keys-env", label: "env"), Anchor(id: "keys-public_env", label: "public_env"), Anchor(id: "keys-offline", label: "offline"), Anchor(id: "keys-i18n", label: "i18n"), Anchor(id: "keys-lints", label: "lints"), Anchor(id: "reading-and-changing-the-config", label: "Reading and changing the config"), Anchor(id: "the-defaults", label: "The defaults"), Anchor(id: "the-project", label: "The project"), Anchor(id: "build", label: "build"), Anchor(id: "dev", label: "dev"), Anchor(id: "motion", label: "motion"), Anchor(id: "meta", label: "meta"), Anchor(id: "theme", label: "theme"), Anchor(id: "i18n", label: "i18n"), Anchor(id: "env-and-publicenv", label: "env and publicenv"), Anchor(id: "offline", label: "offline"), Anchor(id: "lints", label: "lints")], source: "md-docs/reference/configuration.md") {
        notes {
            Stack(gap: .lg) {
                Markdown("This chapter is the reference for `webfluent.app.json`, the file beside `src/` that holds a project's settings. Look up a key here to find its type, its default and what it changes.\n\nEvery key is optional except `name`, so the smallest config is one line:")

                CodeBlock(#"{ "name": "my-site" }"#, title: "json")

                Markdown("A key the build does not know draws the `E112` warning, with the key it most likely meant — `\"defaultLocale\"` says to write `default_locale` — instead of being ignored (since **4.1**).")

                Heading("Reading and changing the config", id: "reading-and-changing-the-config").h2

                Markdown("`wf config` lists every setting and edits the file without reformatting it ([Command line](/reference/cli#wf-config)):\n\n- `wf config schema` lists every setting with its type, the values it takes, its default and what it does. `--json` prints the same for a tool; an editor's settings window is built from it.\n- `wf config get PATH` prints what the project sets at a dotted path, or the default.\n- `wf config set PATH VALUE` checks the value against the setting's type before it writes anything. It replaces a value in place, and adds a new key at the end of its section, in the section's own style.\n- `wf config unset PATH` removes a setting, so its default applies, and removes a section it leaves empty.")

                Terminal(lines: [
                Line(command: "wf config set build.base_path /Docs"),
                Line(command: "wf config set build.budget.app.js \"40 kB\""),
                Line(command: "wf config get dev.port"),
                Line(command: "wf config unset build.base_path")
            ])

                Markdown("Under a map such as `build.budget`, the rest of the path is one key, so `build.budget.app.js` names the `app.js` entry.")

                Heading("The defaults", id: "the-defaults").h2

                Markdown("This block is what a config holding only a name means. The compiler's test suite checks it against the compiler's own defaults. `i18n` and `offline` are absent unless you add them.")

                CodeBlock(#"{
  "name": "my-site",
  "version": "0.1.0",
  "author": "",
  "theme": {
    "name": null,
    "tokens": {},
    "builtin": "full",
    "dark": null
  },
  "build": {
    "elements": [],
    "output": "./build",
    "minify": true,
    "sourcemap": false,
    "ssg": false,
    "base_path": "",
    "clean_urls": null,
    "csp": false,
    "split": true,
    "compress": true,
    "budget": {},
    "runtime": "auto",
    "media": {
      "formats": ["webp"],
      "widths": [480, 960, 1440, 1920],
      "quality": 78,
      "pipeline": true
    },
    "output_type": "spa",
    "pdf": {
      "page_size": "A4",
      "margins": { "top": 72.0, "bottom": 72.0, "left": 72.0, "right": 72.0 },
      "default_font": "Helvetica",
      "default_font_size": 12.0,
      "output_filename": null,
      "fonts": [],
      "system_fonts": true
    },
    "slides": {
      "size": "16:9",
      "width": null,
      "height": null,
      "default_font": "Helvetica",
      "default_font_size": 24.0,
      "margin": 60.0,
      "show_slide_numbers": false,
      "footer_text": null,
      "background_color": null,
      "chrome_color": null,
      "output_filename": null,
      "fonts": [],
      "system_fonts": true
    }
  },
  "dev": { "port": 3000, "hot_reload": true },
  "meta": {
    "integrity": {},
    "title": "my-site",
    "description": "",
    "favicon": "",
    "touch_icon": "",
    "lang": "en",
    "site_url": "",
    "site_name": "",
    "owner": "organization",
    "same_as": [],
    "job_title": "",
    "image": "",
    "image_alt": "",
    "sitemap": true,
    "fonts": [],
    "preload": [],
    "stylesheets": [],
    "scripts": [],
    "connect": [],
    "img": [],
    "frame": [],
    "wasm": false,
    "style_elements": false
  },
  "motion": { "duration": null, "easing": null },
  "env": {},
  "lints": {},
  "public_env": []
}"#, title: "json")

                Markdown("`wf init` writes a shorter file than this one, and turns `build.csp` on.")

                Heading("The project", id: "the-project").h2

                Markdown("The top-level keys that describe the project itself.")

                Table(caption: "The project") {
                    Table.Head {
                        Table.Row {
                            Table.Cell("Key").header
                            Table.Cell("Type").header
                            Table.Cell("Default").header
                            Table.Cell("Meaning").header
                        }
                    }
                    Table.Body {
                        Table.Row {
                            Table.Cell { Markdown("`name`") }
                            Table.Cell("string")
                            Table.Cell("—")
                            Table.Cell { Markdown("The only required key. The site's name, the PDF's file name when none is given, and the fallback for `meta.title`.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`version`") }
                            Table.Cell("string")
                            Table.Cell { Markdown("`\"0.1.0\"`") }
                            Table.Cell("The project's version, as you number it. Nothing in the build reads it.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`author`") }
                            Table.Cell("string")
                            Table.Cell { Markdown("`\"\"`") }
                            Table.Cell("Who wrote it. Nothing in the build reads it.")
                        }
                    }
                }

                Heading("build", id: "build").h2

                Markdown("How the project is compiled, and what the build writes.")

                Table(caption: "build") {
                    Table.Head {
                        Table.Row {
                            Table.Cell("Key").header
                            Table.Cell("Type").header
                            Table.Cell("Default").header
                            Table.Cell("Meaning").header
                        }
                    }
                    Table.Body {
                        Table.Row {
                            Table.Cell { Markdown("`output`") }
                            Table.Cell("string")
                            Table.Cell { Markdown("`\"./build\"`") }
                            Table.Cell { Markdown("Where the build is written, relative to the project and inside it: a path that climbs out (`../site`, `/var/www`) or a link to somewhere else is refused unless the command line says `--allow-output-outside` ([CLI](/reference/cli#wf-build)).") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`output_type`") }
                            Table.Cell { Markdown("`spa`, `static`, `pdf`, `slides`, `elements`") }
                            Table.Cell { Markdown("`\"spa\"`") }
                            Table.Cell { Markdown("What the project builds: `spa` is a website; `static` is a website whose every page is pre-rendered, as `ssg: true` builds it; `pdf` a document; `slides` a deck; `elements` custom elements ([PDF and slides](/learn/17-pdf-and-slides), [custom elements](/recipes/publish-custom-elements)).") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`ssg`") }
                            Table.Cell("boolean")
                            Table.Cell { Markdown("`false`") }
                            Table.Cell { Markdown("Pre-renders every page to its own HTML file, so it is read before any script runs ([Static sites and SPAs](/about/static-or-single-page)).") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`base_path`") }
                            Table.Cell("string")
                            Table.Cell { Markdown("`\"\"`") }
                            Table.Cell { Markdown("The sub-path the site is served under, such as `\"/docs\"`. Every link and asset is prefixed with it.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`clean_urls`") }
                            Table.Cell { Markdown("`file`, `directory`") }
                            Table.Cell("unset")
                            Table.Cell { Markdown("How a route's address avoids a redirect on a host that adds a trailing slash. `\"file\"` also writes `contact.html` beside `contact/index.html`; `\"directory\"` names every route `/contact/` in canonical links, the sitemap and links to pages ([Deploy to GitHub Pages](/recipes/deploy-to-github-pages)).") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`split`") }
                            Table.Cell("boolean")
                            Table.Cell { Markdown("`true`") }
                            Table.Cell { Markdown("Writes one script and stylesheet chunk per page, loaded when its route shows. Off, every page ships in `app.js`.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`minify`") }
                            Table.Cell("boolean")
                            Table.Cell { Markdown("`true`") }
                            Table.Cell("Strips comments and whitespace from the scripts and stylesheets. Off, the output is readable and larger.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`sourcemap`") }
                            Table.Cell("boolean")
                            Table.Cell { Markdown("`false`") }
                            Table.Cell { Markdown("Writes a source map (version 3) beside the bundle and each page's chunk — `app.js.map`, `pages/Home.js.map` — so a stack trace from the running site reads back to the `.wf` line each statement came from. The scripts are otherwise unchanged.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`compress`") }
                            Table.Cell("boolean")
                            Table.Cell { Markdown("`true`") }
                            Table.Cell { Markdown("Writes a gzipped `.gz` copy beside every text output over a kilobyte, for hosts that serve one.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`runtime`") }
                            Table.Cell { Markdown("`auto`, `full`") }
                            Table.Cell { Markdown("`\"auto\"`") }
                            Table.Cell { Markdown("`auto` ships only the runtime modules the program reaches; `full` ships every one, for a hand-written script that calls `WF` in ways the build cannot see ([Call WF from a script](/recipes/call-wf-from-a-script)).") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`csp`") }
                            Table.Cell("boolean")
                            Table.Cell { Markdown("`false` (`true` in a project `wf init` makes)") }
                            Table.Cell { Markdown("Emits a Content-Security-Policy and a `_headers` file, and checks the output against the policy ([Security](/about/security#the-content-security-policy)).") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`budget`") }
                            Table.Cell("map of file to size")
                            Table.Cell { Markdown("`\{\}`") }
                            Table.Cell { Markdown("A gzipped size each named output should stay under: `\{ \"app.js\": \"40 kB\" \}`. A build over it warns and goes on.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`elements`") }
                            Table.Cell("list of component names")
                            Table.Cell { Markdown("`[]`") }
                            Table.Cell { Markdown("With `output_type: \"elements\"`, the components to publish as custom elements.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`media`") }
                            Table.Cell("object")
                            Table.Cell("below")
                            Table.Cell("The image pipeline.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`pdf`, `slides`") }
                            Table.Cell("object")
                            Table.Cell("below")
                            Table.Cell("The paper outputs.")
                        }
                    }
                }

                Heading("build.media", id: "build-media").h3

                Markdown("The image pipeline: how the build resizes and re-encodes the pictures a program names ([Add a picture](/recipes/add-a-picture)).")

                Table(caption: "build.media") {
                    Table.Head {
                        Table.Row {
                            Table.Cell("Key").header
                            Table.Cell("Type").header
                            Table.Cell("Default").header
                            Table.Cell("Meaning").header
                        }
                    }
                    Table.Body {
                        Table.Row {
                            Table.Cell { Markdown("`formats`") }
                            Table.Cell { Markdown("list of `webp`, `png`, `jpeg`") }
                            Table.Cell { Markdown("`[\"webp\"]`") }
                            Table.Cell { Markdown("The formats every `image` is written in, best first, as well as its original.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`widths`") }
                            Table.Cell("list of integers")
                            Table.Cell { Markdown("`[480, 960, 1440, 1920]`") }
                            Table.Cell("The widths written, where smaller than the original.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`quality`") }
                            Table.Cell("integer, 1–100")
                            Table.Cell { Markdown("`78`") }
                            Table.Cell("The encoding quality. WebP and JPEG are lossy at it. A file no smaller than the original is not written.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`pipeline`") }
                            Table.Cell("boolean")
                            Table.Cell { Markdown("`true`") }
                            Table.Cell { Markdown("`false` copies images as `public/` is copied, without resizing.") }
                        }
                    }
                }

                Heading("build.pdf", id: "build-pdf").h3

                Markdown("The page and type of a PDF build ([PDF and slides](/learn/17-pdf-and-slides)).")

                Table(caption: "build.pdf") {
                    Table.Head {
                        Table.Row {
                            Table.Cell("Key").header
                            Table.Cell("Type").header
                            Table.Cell("Default").header
                            Table.Cell("Meaning").header
                        }
                    }
                    Table.Body {
                        Table.Row {
                            Table.Cell { Markdown("`page_size`") }
                            Table.Cell("string")
                            Table.Cell { Markdown("`\"A4\"`") }
                            Table.Cell { Markdown("`A3`, `A4`, `A5`, `A6`, `B5`, `Letter`, `Legal`, `Tabloid` (or `Ledger`), `Executive`, or two lengths (`\"210mm 297mm\"`, `\"800x600\"`). A `Document(size:)` overrides it.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`margins`") }
                            Table.Cell("object of numbers")
                            Table.Cell { Markdown("`72` each") }
                            Table.Cell { Markdown("`top`, `bottom`, `left`, `right`, in points (72 to the inch). The header and footer are drawn in them.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`default_font`") }
                            Table.Cell("string")
                            Table.Cell { Markdown("`\"Helvetica\"`") }
                            Table.Cell { Markdown("The document's family when its stylesheets name none: a standard name (`Helvetica`, `Times`, `Courier` — Liberation, built in) or a family under `fonts/`.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`default_font_size`") }
                            Table.Cell("number")
                            Table.Cell { Markdown("`12`") }
                            Table.Cell { Markdown("In points; `rem` in a style is this size.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`output_filename`") }
                            Table.Cell("string")
                            Table.Cell("the project's name")
                            Table.Cell("The file written.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`fonts`") }
                            Table.Cell("list of paths")
                            Table.Cell { Markdown("`[]`") }
                            Table.Cell { Markdown("Font files or directories, read as well as the project's `fonts/`, `src/fonts/` and `public/fonts/`, which are always read.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`system_fonts`") }
                            Table.Cell("boolean")
                            Table.Cell { Markdown("`true`") }
                            Table.Cell("Whether this machine's fonts may stand in for a family or a character nothing in the project has. The build names each one it uses.")
                        }
                    }
                }

                Heading("build.slides", id: "build-slides").h3

                Markdown("The page and type of a slide deck ([PDF and slides](/learn/17-pdf-and-slides)).")

                Table(caption: "build.slides") {
                    Table.Head {
                        Table.Row {
                            Table.Cell("Key").header
                            Table.Cell("Type").header
                            Table.Cell("Default").header
                            Table.Cell("Meaning").header
                        }
                    }
                    Table.Body {
                        Table.Row {
                            Table.Cell { Markdown("`size`") }
                            Table.Cell("string")
                            Table.Cell { Markdown("`\"16:9\"`") }
                            Table.Cell { Markdown("`16:9` (960 × 540 pt), `4:3`, `A4-landscape`, or `\"WIDTHxHEIGHT\"` in points.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`width`, `height`") }
                            Table.Cell("number")
                            Table.Cell { Markdown("`null`") }
                            Table.Cell { Markdown("Explicit points, overriding `size`.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`margin`") }
                            Table.Cell("number")
                            Table.Cell { Markdown("`60`") }
                            Table.Cell("The space around each slide's content, in points. What runs past it is clipped.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`default_font`") }
                            Table.Cell("string")
                            Table.Cell { Markdown("`\"Helvetica\"`") }
                            Table.Cell("The family a slide's text is set in when nothing says otherwise.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`default_font_size`") }
                            Table.Cell("number")
                            Table.Cell { Markdown("`24`") }
                            Table.Cell("The size a slide's text is set at, in points.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`show_slide_numbers`") }
                            Table.Cell("boolean")
                            Table.Cell { Markdown("`false`") }
                            Table.Cell { Markdown("Draws `n / total` in the bottom-right corner.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`footer_text`") }
                            Table.Cell("string")
                            Table.Cell { Markdown("`null`") }
                            Table.Cell("Text in the bottom-left corner of every slide.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`background_color`") }
                            Table.Cell("string")
                            Table.Cell { Markdown("`null`") }
                            Table.Cell("A full-bleed colour for every slide; a slide's own style overrides it.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`chrome_color`") }
                            Table.Cell("string")
                            Table.Cell { Markdown("`null`") }
                            Table.Cell("The colour of the numbers and the footer. Unset, it flips between dark and light on each slide's background.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`output_filename`") }
                            Table.Cell("string")
                            Table.Cell("the project's name")
                            Table.Cell("The file written.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`fonts`, `system_fonts`") }
                            Table.Cell("list of paths, boolean")
                            Table.Cell { Markdown("`[]`, `true`") }
                            Table.Cell { Markdown("As for `build.pdf`.") }
                        }
                    }
                }

                Heading("dev", id: "dev").h2

                Markdown("The development server, `wf serve` ([Command line](/reference/cli#wf-serve)).")

                Table(caption: "dev") {
                    Table.Head {
                        Table.Row {
                            Table.Cell("Key").header
                            Table.Cell("Type").header
                            Table.Cell("Default").header
                            Table.Cell("Meaning").header
                        }
                    }
                    Table.Body {
                        Table.Row {
                            Table.Cell { Markdown("`port`") }
                            Table.Cell("integer")
                            Table.Cell { Markdown("`3000`") }
                            Table.Cell { Markdown("The port `wf serve` listens on.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`hot_reload`") }
                            Table.Cell("boolean")
                            Table.Cell { Markdown("`true`") }
                            Table.Cell("Rebuilds on a save, reloads open tabs, and draws a failed build's error over the page.")
                        }
                    }
                }

                Heading("motion", id: "motion").h2

                Markdown("What an animation does when the element says nothing ([Motion defaults](/recipes/motion-defaults)).")

                Table(caption: "motion") {
                    Table.Head {
                        Table.Row {
                            Table.Cell("Key").header
                            Table.Cell("Type").header
                            Table.Cell("Default").header
                            Table.Cell("Meaning").header
                        }
                    }
                    Table.Body {
                        Table.Row {
                            Table.Cell { Markdown("`duration`") }
                            Table.Cell("string")
                            Table.Cell("unset")
                            Table.Cell { Markdown("How long an animation runs: `\"180ms\"`.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`easing`") }
                            Table.Cell("string")
                            Table.Cell("unset")
                            Table.Cell { Markdown("How it is paced: a CSS timing function, or a token such as `\"$ease-standard\"`.") }
                        }
                    }
                }

                Heading("meta", id: "meta").h2

                Markdown("What every page's head carries: its fallbacks, its search and sharing tags, and the other origins the content security policy allows.")

                Table(caption: "meta") {
                    Table.Head {
                        Table.Row {
                            Table.Cell("Key").header
                            Table.Cell("Type").header
                            Table.Cell("Default").header
                            Table.Cell("Meaning").header
                        }
                    }
                    Table.Body {
                        Table.Row {
                            Table.Cell { Markdown("`title`") }
                            Table.Cell("string")
                            Table.Cell("the project's name")
                            Table.Cell("The title a page falls back to when it declares none.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`description`") }
                            Table.Cell("string")
                            Table.Cell { Markdown("`\"\"`") }
                            Table.Cell("The description a page falls back to when it declares none.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`lang`") }
                            Table.Cell("language tag")
                            Table.Cell { Markdown("`\"en\"`") }
                            Table.Cell { Markdown("The document's language: `en`, `ar`, `pt-BR`. A page written in another language says so with its own `lang:`.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`site_url`") }
                            Table.Cell("string")
                            Table.Cell { Markdown("`\"\"`") }
                            Table.Cell { Markdown("The site's absolute address, such as `https://example.com`. Without it, canonical links, the sitemap's URLs and absolute sharing URLs are left out rather than guessed.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`site_name`") }
                            Table.Cell("string")
                            Table.Cell { Markdown("`\"\"`") }
                            Table.Cell("The name a link preview shows, and the site's owner in the structured data.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`owner`") }
                            Table.Cell { Markdown("`organization`, `person`") }
                            Table.Cell { Markdown("`\"organization\"`") }
                            Table.Cell { Markdown("Whether the site belongs to an organisation or a person: the JSON-LD node the site is published by ([Search and link previews](/recipes/search-and-link-previews)).") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`same_as`") }
                            Table.Cell("list of URLs")
                            Table.Cell { Markdown("`[]`") }
                            Table.Cell { Markdown("The owner's profiles elsewhere, as its `sameAs`.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`job_title`") }
                            Table.Cell("string")
                            Table.Cell { Markdown("`\"\"`") }
                            Table.Cell { Markdown("A person's `jobTitle`.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`owner_details`") }
                            Table.Cell("map")
                            Table.Cell { Markdown("`\{\}`") }
                            Table.Cell { Markdown("More about the owner, as schema.org properties merged into its node as written: `alternateName`, `email`, `worksFor`, `alumniOf`, `knowsAbout`, `logo`… The node's `@type`, `@id`, `name`, `url`, `jobTitle` and `sameAs` come from the settings above; naming one here is `E111`.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`image`") }
                            Table.Cell("file")
                            Table.Cell { Markdown("`\"\"`") }
                            Table.Cell { Markdown("The sharing image for pages that set none. For an image in `public/`, its size is read into `og:image:width` and `og:image:height`.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`image_alt`") }
                            Table.Cell("string")
                            Table.Cell { Markdown("`\"\"`") }
                            Table.Cell { Markdown("What that image shows, as `og:image:alt` and `twitter:image:alt`. A page's `image_alt:` wins.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`favicon`") }
                            Table.Cell("file")
                            Table.Cell { Markdown("`\"\"`") }
                            Table.Cell { Markdown("The icon a browser tab shows: a file in `public/` — an SVG scales to every size — or a URL.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`touch_icon`") }
                            Table.Cell("file")
                            Table.Cell { Markdown("`\"\"`") }
                            Table.Cell { Markdown("The icon a phone puts on its home screen: a 180×180 PNG in `public/`. iOS reads this, not an SVG `favicon`.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`sitemap`") }
                            Table.Cell("boolean")
                            Table.Cell { Markdown("`true`") }
                            Table.Cell { Markdown("Writes `sitemap.xml` and `robots.txt`.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`fonts`") }
                            Table.Cell("list of URLs")
                            Table.Cell { Markdown("`[]`") }
                            Table.Cell { Markdown("Web-font stylesheets to link, each with a `preconnect`. Their origins join the policy.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`preload`") }
                            Table.Cell("list of paths")
                            Table.Cell { Markdown("`[]`") }
                            Table.Cell { Markdown("Files on this site to fetch with the page, ahead of the stylesheets: a font a project `.css` file's `@font-face` names, the first screen's picture. `as` comes from the extension (a font is also `crossorigin`). A file on another origin is `E111` ([Search and link previews](/recipes/search-and-link-previews)).") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`stylesheets`") }
                            Table.Cell("list of paths or URLs")
                            Table.Cell { Markdown("`[]`") }
                            Table.Cell { Markdown("Extra stylesheets to link ahead of `styles.css`: a file in `public/` or a URL.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`scripts`") }
                            Table.Cell("list of scripts")
                            Table.Cell { Markdown("`[]`") }
                            Table.Cell { Markdown("Libraries to load before the project's own scripts (below). Their origins join the policy ([JavaScript interop](/recipes/library-from-a-cdn)).") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`integrity`") }
                            Table.Cell("map of URL to hash")
                            Table.Cell { Markdown("`\{\}`") }
                            Table.Cell("Subresource-integrity hashes of external assets, by URL.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`connect`") }
                            Table.Cell("list of origins")
                            Table.Cell { Markdown("`[]`") }
                            Table.Cell { Markdown("Origins a page may send requests to besides its own — an API elsewhere, an analytics endpoint — as the policy's `connect-src`: `\"https://api.example.com\"`, `\"https://*.google-analytics.com\"`, or an app's own scheme alone, `\"ipc:\"`.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`img`") }
                            Table.Cell("list of origins")
                            Table.Cell { Markdown("`[]`") }
                            Table.Cell { Markdown("Origins a page may load images from besides its own and `data:` — a CDN, a tag's tracking pixel — as the policy's `img-src`: `\"https://images.example.com\"`, `\"https://www.googletagmanager.com\"`.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`frame`") }
                            Table.Cell("list of origins")
                            Table.Cell { Markdown("`[]`") }
                            Table.Cell { Markdown("Origins a page may embed in a frame besides its own — a video player, a map — as the policy's `frame-src`: `\"https://www.youtube-nocookie.com\"`, or an app's own scheme alone, `\"wfpreview:\"`.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`wasm`") }
                            Table.Cell("boolean")
                            Table.Cell { Markdown("`false`") }
                            Table.Cell { Markdown("The pages compile WebAssembly: `script-src` gains `'wasm-unsafe-eval'`, which allows that and not `eval`.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`style_elements`") }
                            Table.Cell("boolean")
                            Table.Cell { Markdown("`false`") }
                            Table.Cell { Markdown("A script on the page writes `<style>` elements (an editor, a chart library): `style-src` gains `'unsafe-inline'`, for styles only.") }
                        }
                    }
                }

                Markdown("An entry of `connect`, `img` or `frame` that has a path, or that is a keyword, is `E111`. [Allow other origins](/recipes/allow-other-origins) covers these settings and `wasm` and `style_elements`.\n\nAn entry of `meta.scripts` takes one of these forms:")

                Table(caption: "meta") {
                    Table.Head {
                        Table.Row {
                            Table.Cell("Form").header
                            Table.Cell("Meaning").header
                        }
                    }
                    Table.Body {
                        Table.Row {
                            Table.Cell { Markdown("`\"https://…\"` or a file in `public/`") }
                            Table.Cell { Markdown("A classic script, linked `defer`.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`\{ \"src\": \"…\", \"module\": true, \"as\": \"Name\" \}`") }
                            Table.Cell { Markdown("An ES module, whose exports are put on `window.Name`.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`\{ \"src\": \"…\", \"globals\": [\"Chart\"] \}`") }
                            Table.Cell { Markdown("A script whose names `.wf` may call directly.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`\{ \"src\": \"…\", \"async\": true \}`") }
                            Table.Cell("A script nothing waits for — analytics — loaded without holding up the page's code.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`\{ \"src\": \"…\", \"load\": \"after\" \}`") }
                            Table.Cell("A script the page asks for only once it has loaded and painted.")
                        }
                    }
                }

                Heading("theme", id: "theme").h2

                Markdown("Which theme the site uses, and token values set over it ([Design tokens](/reference/tokens)).")

                Table(caption: "theme") {
                    Table.Head {
                        Table.Row {
                            Table.Cell("Key").header
                            Table.Cell("Type").header
                            Table.Cell("Default").header
                            Table.Cell("Meaning").header
                        }
                    }
                    Table.Body {
                        Table.Row {
                            Table.Cell { Markdown("`name`") }
                            Table.Cell("string")
                            Table.Cell("unset")
                            Table.Cell { Markdown("Which `theme` declaration is the site's. A project with exactly one need not name it; with none, the baseline applies.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`dark`") }
                            Table.Cell("string")
                            Table.Cell("unset")
                            Table.Cell { Markdown("The `theme` declaration that stands in for dark mode: when the reader prefers dark, or `setTheme(\"dark\")` asks ([Styling](/learn/13-styling#dark-mode)).") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`builtin`") }
                            Table.Cell { Markdown("`full`, `structural`") }
                            Table.Cell { Markdown("`\"full\"`") }
                            Table.Cell { Markdown("`full` ships the built-ins' designed look; `structural` ships only their layout and mechanics, for a design of your own.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`tokens`") }
                            Table.Cell("map of token to value")
                            Table.Cell { Markdown("`\{\}`") }
                            Table.Cell("Token values applied over the theme, for a pipeline to supply — a colour a deploy injects.")
                        }
                    }
                }

                Heading("i18n", id: "i18n").h2

                Markdown("The project's translations. Absent, the project has one language.")

                CodeBlock(#"{ "i18n": { "default_locale": "en", "locales": ["en", "ar"], "dir": "src/translations" } }"#, title: "json")

                Table(caption: "i18n") {
                    Table.Head {
                        Table.Row {
                            Table.Cell("Key").header
                            Table.Cell("Type").header
                            Table.Cell("Default").header
                            Table.Cell("Meaning").header
                        }
                    }
                    Table.Body {
                        Table.Row {
                            Table.Cell { Markdown("`default_locale`") }
                            Table.Cell("language tag")
                            Table.Cell { Markdown("`\"en\"`") }
                            Table.Cell("The locale a page opens in, and the one a message falls back to when the current locale has no translation of it.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`locales`") }
                            Table.Cell("list of language tags")
                            Table.Cell { Markdown("`[\"en\"]`") }
                            Table.Cell { Markdown("Every locale; one JSON file each, under `dir`.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`dir`") }
                            Table.Cell("string")
                            Table.Cell { Markdown("`\"src/translations\"`") }
                            Table.Cell("The folder the translation files are in.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`literals`") }
                            Table.Cell("boolean")
                            Table.Cell { Markdown("`false`") }
                            Table.Cell("Translates by the words themselves: each string a reader sees is its own key.")
                        }
                    }
                }

                Markdown("See also: [Translate a site](/recipes/translate-a-site).")

                Heading("env and publicenv", id: "env-and-publicenv").h2

                Markdown("Values the program reads as `env.NAME`, and which of them may reach the browser.")

                Table(caption: "env and publicenv") {
                    Table.Head {
                        Table.Row {
                            Table.Cell("Key").header
                            Table.Cell("Type").header
                            Table.Cell("Default").header
                            Table.Cell("Meaning").header
                        }
                    }
                    Table.Body {
                        Table.Row {
                            Table.Cell { Markdown("`env`") }
                            Table.Cell("map")
                            Table.Cell { Markdown("`\{\}`") }
                            Table.Cell { Markdown("Values read as `env.NAME`, fixed at build time. A `.env` file and the shell's variables add to them.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`public_env`") }
                            Table.Cell("list of names")
                            Table.Cell { Markdown("`[]`") }
                            Table.Cell { Markdown("The `env` names a page may read — and so ships to the browser — beyond those beginning `PUBLIC_`.") }
                        }
                    }
                }

                Markdown("See also: [Environments and secrets](/recipes/environments-and-secrets).")

                Heading("offline", id: "offline").h2

                Markdown("The service worker that stores the site for when the network is gone. Added in **4.1**. Absent, no service worker is written.")

                CodeBlock(#"{ "offline": { "precache": ["/", "/docs/*"], "fallback": "/offline", "cache": { "/api/*": "network-first" }, "sync": true } }"#, title: "json")

                Table(caption: "offline") {
                    Table.Head {
                        Table.Row {
                            Table.Cell("Key").header
                            Table.Cell("Type").header
                            Table.Cell("Default").header
                            Table.Cell("Meaning").header
                        }
                    }
                    Table.Body {
                        Table.Row {
                            Table.Cell { Markdown("`precache`") }
                            Table.Cell("list of globs")
                            Table.Cell { Markdown("`[\"/\"]`") }
                            Table.Cell { Markdown("The routes a first visit stores; `\"*\"` for every route.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`fallback`") }
                            Table.Cell("string")
                            Table.Cell { Markdown("`null`") }
                            Table.Cell("A page's path, shown for a route that was not stored.")
                        }
                        Table.Row {
                            Table.Cell { Markdown("`cache`") }
                            Table.Cell("map of glob to strategy")
                            Table.Cell { Markdown("`\{\}`") }
                            Table.Cell { Markdown("How paths the build did not write are fetched: `network-first`, `cache-first`, `stale-while-revalidate` or `network-only`.") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`sync`") }
                            Table.Cell("boolean")
                            Table.Cell { Markdown("`false`") }
                            Table.Cell("Keeps writes made offline and sends them when the connection returns.")
                        }
                    }
                }

                Markdown("See also: [Work offline](/recipes/work-offline).")

                Heading("lints", id: "lints").h2

                Markdown("What a finding counts as, by its code or its family: `\"off\"`, `\"warn\"` or `\"error\"`. A code's setting wins over its family's.")

                CodeBlock(#"{ "lints": { "A11": "off", "U": "error", "R01": "warn" } }"#, title: "json")

                Markdown("You can turn a warning off or make it an error. You can lower an error only when it cannot ship a broken page:\n\n- `R01` — a link to a route that is missing;\n- `C02` — a prop the component does not declare;\n- `S04` — two pages on one route;\n- `I01`, `I02`, `I04` — a message that shows its key or a placeholder.\n\nAsking to lower any other error is itself refused, and so is a key that is not a code or a family. To accept one finding on one line instead, write a `// wf-allow(CODE)` comment; the same rule applies. Every code is listed in [Diagnostics](/errors).")

            }
        }
        Heading("project", id: "keys-project", class: "bp-mono").h2
        Table(caption: "The project keys", class: "bp-table") {
            Table.Head {
                Table.Row {
                    Table.Cell(t("config.key")).header
                    Table.Cell(t("ref.type")).header
                    Table.Cell(t("config.default")).header
                    Table.Cell(t("ref.meaning")).header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Code("name") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("\"\"") }
                    Table.Cell("The project's name, used where a title or a site name is not given.")
                }
                Table.Row {
                    Table.Cell { Code("version") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("0.1.0") }
                    Table.Cell("The project's version, as its author numbers it.")
                }
                Table.Row {
                    Table.Cell { Code("author") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("\"\"") }
                    Table.Cell("Who wrote it.")
                }
            }
        }
        Heading("theme", id: "keys-theme", class: "bp-mono").h2
        Table(caption: "The theme keys", class: "bp-table") {
            Table.Head {
                Table.Row {
                    Table.Cell(t("config.key")).header
                    Table.Cell(t("ref.type")).header
                    Table.Cell(t("config.default")).header
                    Table.Cell(t("ref.meaning")).header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Code("theme.name") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("null") }
                    Table.Cell("The `theme` declaration the build uses; unset, the one the project declares, or the baseline.")
                }
                Table.Row {
                    Table.Cell { Code("theme.builtin") }
                    Table.Cell { Code("\"full\" | \"structural\"") }
                    Table.Cell { Code("full") }
                    Table.Cell("`full` ships the engine's design with its layout; `structural` only the layout, for a design of your own.")
                }
                Table.Row {
                    Table.Cell { Code("theme.dark") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("null") }
                    Table.Cell("The `theme` declaration that stands in when the reader prefers dark, or `setTheme(\"dark\")` asks.")
                }
                Table.Row {
                    Table.Cell { Code("theme.tokens") }
                    Table.Cell { Code("string map") }
                    Table.Cell { Code("\{\}") }
                    Table.Cell("Token values applied over the theme — a colour a deploy injects, a size the studio sets.")
                }
            }
        }
        Heading("build", id: "keys-build", class: "bp-mono").h2
        Table(caption: "The build keys", class: "bp-table") {
            Table.Head {
                Table.Row {
                    Table.Cell(t("config.key")).header
                    Table.Cell(t("ref.type")).header
                    Table.Cell(t("config.default")).header
                    Table.Cell(t("ref.meaning")).header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Code("build.output") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("./build") }
                    Table.Cell("The directory the site is written to, inside the project (outside it only with `--allow-output-outside`).")
                }
                Table.Row {
                    Table.Cell { Code("build.output_type") }
                    Table.Cell { Code("\"spa\" | \"static\" | \"pdf\" | \"slides\" | \"elements\"") }
                    Table.Cell { Code("spa") }
                    Table.Cell("What the project builds: a single page, a static site, a PDF, a slide deck, or custom elements.")
                }
                Table.Row {
                    Table.Cell { Code("build.minify") }
                    Table.Cell { Code("boolean") }
                    Table.Cell { Code("true") }
                    Table.Cell("Minify the JavaScript and CSS; off, the output is readable and larger.")
                }
                Table.Row {
                    Table.Cell { Code("build.sourcemap") }
                    Table.Cell { Code("boolean") }
                    Table.Cell { Code("false") }
                    Table.Cell("Write source maps beside the JavaScript, so the browser's tools show the `.wf` lines.")
                }
                Table.Row {
                    Table.Cell { Code("build.ssg") }
                    Table.Cell { Code("boolean") }
                    Table.Cell { Code("false") }
                    Table.Cell("Pre-render every page as HTML, so it is read before any script runs.")
                }
                Table.Row {
                    Table.Cell { Code("build.base_path") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("\"\"") }
                    Table.Cell("The path the site is served under — `/Halyard` for a project site — which every link and asset begins with.")
                }
                Table.Row {
                    Table.Cell { Code("build.clean_urls") }
                    Table.Cell { Code("\"file\" | \"directory\"") }
                    Table.Cell { Code("null") }
                    Table.Cell("How a route's address is written so it never redirects: `file` keeps `/contact`, `directory` names it `/contact/`.")
                }
                Table.Row {
                    Table.Cell { Code("build.csp") }
                    Table.Cell { Code("boolean") }
                    Table.Cell { Code("false") }
                    Table.Cell("Ship a strict content security policy: a third-party script is then blocked unless the policy names it.")
                }
                Table.Row {
                    Table.Cell { Code("build.split") }
                    Table.Cell { Code("boolean") }
                    Table.Cell { Code("true") }
                    Table.Cell("Write each page's code as its own file, loaded when the page is shown; off, every page ships in `app.js`.")
                }
                Table.Row {
                    Table.Cell { Code("build.compress") }
                    Table.Cell { Code("boolean") }
                    Table.Cell { Code("true") }
                    Table.Cell("Write a gzipped copy of every text file beside it, for hosts that serve one.")
                }
                Table.Row {
                    Table.Cell { Code("build.budget") }
                    Table.Cell { Code("string map") }
                    Table.Cell { Code("\{\}") }
                    Table.Cell("A size an output must stay under, gzipped — `\{ \"app.js\": \"40 kB\" \}` — warned of when a build is over it.")
                }
                Table.Row {
                    Table.Cell { Code("build.runtime") }
                    Table.Cell { Code("\"auto\" | \"full\"") }
                    Table.Cell { Code("auto") }
                    Table.Cell("`auto` ships only the runtime the program reaches; `full` all of it, for a script that calls it in ways the build cannot see.")
                }
                Table.Row {
                    Table.Cell { Code("build.elements") }
                    Table.Cell { Code("strings") }
                    Table.Cell { Code("[]") }
                    Table.Cell("The components a custom-elements build publishes, each a tag named in kebab case.")
                }
                Table.Row {
                    Table.Cell { Code("build.media.pipeline") }
                    Table.Cell { Code("boolean") }
                    Table.Cell { Code("true") }
                    Table.Cell("Resize and re-encode the images the program names; off, an image is copied as it is.")
                }
                Table.Row {
                    Table.Cell { Code("build.media.formats") }
                    Table.Cell { Code("\"webp\" | \"png\" | \"jpeg\"") }
                    Table.Cell { Code("[\"webp\"]") }
                    Table.Cell("The formats an image is written in, best first.")
                }
                Table.Row {
                    Table.Cell { Code("build.media.widths") }
                    Table.Cell { Code("integers") }
                    Table.Cell { Code("[480, 960, 1440, 1920]") }
                    Table.Cell("The widths an image is written at, for a page that does not say.")
                }
                Table.Row {
                    Table.Cell { Code("build.media.quality") }
                    Table.Cell { Code("integer (1–100)") }
                    Table.Cell { Code("78") }
                    Table.Cell("How much an image keeps when it is re-encoded, 1 to 100.")
                }
                Table.Row {
                    Table.Cell { Code("build.pdf.page_size") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("A4") }
                    Table.Cell("The page: `A4`, `Letter`, or a width and height in points.")
                }
                Table.Row {
                    Table.Cell { Code("build.pdf.margins.top") }
                    Table.Cell { Code("number") }
                    Table.Cell { Code("72.0") }
                    Table.Cell("The top margin, in points.")
                }
                Table.Row {
                    Table.Cell { Code("build.pdf.margins.bottom") }
                    Table.Cell { Code("number") }
                    Table.Cell { Code("72.0") }
                    Table.Cell("The bottom margin, in points.")
                }
                Table.Row {
                    Table.Cell { Code("build.pdf.margins.left") }
                    Table.Cell { Code("number") }
                    Table.Cell { Code("72.0") }
                    Table.Cell("The left margin, in points.")
                }
                Table.Row {
                    Table.Cell { Code("build.pdf.margins.right") }
                    Table.Cell { Code("number") }
                    Table.Cell { Code("72.0") }
                    Table.Cell("The right margin, in points.")
                }
                Table.Row {
                    Table.Cell { Code("build.pdf.default_font") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("Helvetica") }
                    Table.Cell("The font text is set in when nothing says otherwise.")
                }
                Table.Row {
                    Table.Cell { Code("build.pdf.default_font_size") }
                    Table.Cell { Code("number") }
                    Table.Cell { Code("12.0") }
                    Table.Cell("The size text is set at when nothing says otherwise, in points.")
                }
                Table.Row {
                    Table.Cell { Code("build.pdf.output_filename") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("null") }
                    Table.Cell("The name the PDF is written under; unset, the project's name.")
                }
                Table.Row {
                    Table.Cell { Code("build.pdf.fonts") }
                    Table.Cell { Code("strings") }
                    Table.Cell { Code("[]") }
                    Table.Cell("Font files or folders to embed, beside the project's `fonts/`.")
                }
                Table.Row {
                    Table.Cell { Code("build.pdf.system_fonts") }
                    Table.Cell { Code("boolean") }
                    Table.Cell { Code("true") }
                    Table.Cell("Let the machine's fonts stand in for a family or a character the project's fonts lack.")
                }
                Table.Row {
                    Table.Cell { Code("build.slides.size") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("16:9") }
                    Table.Cell("The slide: `16:9`, `4:3`, `A4-landscape`, or a width and height in points.")
                }
                Table.Row {
                    Table.Cell { Code("build.slides.width") }
                    Table.Cell { Code("number") }
                    Table.Cell { Code("null") }
                    Table.Cell("A width in points, over `size`.")
                }
                Table.Row {
                    Table.Cell { Code("build.slides.height") }
                    Table.Cell { Code("number") }
                    Table.Cell { Code("null") }
                    Table.Cell("A height in points, over `size`.")
                }
                Table.Row {
                    Table.Cell { Code("build.slides.default_font") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("Helvetica") }
                    Table.Cell("The font a slide is set in when nothing says otherwise.")
                }
                Table.Row {
                    Table.Cell { Code("build.slides.default_font_size") }
                    Table.Cell { Code("number") }
                    Table.Cell { Code("24.0") }
                    Table.Cell("The size a slide's text is set at when nothing says otherwise, in points.")
                }
                Table.Row {
                    Table.Cell { Code("build.slides.margin") }
                    Table.Cell { Code("number") }
                    Table.Cell { Code("60.0") }
                    Table.Cell("The margin around every slide, in points.")
                }
                Table.Row {
                    Table.Cell { Code("build.slides.show_slide_numbers") }
                    Table.Cell { Code("boolean") }
                    Table.Cell { Code("false") }
                    Table.Cell("Number the slides, bottom right.")
                }
                Table.Row {
                    Table.Cell { Code("build.slides.footer_text") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("null") }
                    Table.Cell("A line shown bottom left on every slide.")
                }
                Table.Row {
                    Table.Cell { Code("build.slides.background_color") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("null") }
                    Table.Cell("The deck's background colour; a slide's own style overrides it.")
                }
                Table.Row {
                    Table.Cell { Code("build.slides.chrome_color") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("null") }
                    Table.Cell("The colour of the numbers and the footer; unset, chosen from each slide's background.")
                }
                Table.Row {
                    Table.Cell { Code("build.slides.output_filename") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("null") }
                    Table.Cell("The name the deck is written under; unset, the project's name.")
                }
                Table.Row {
                    Table.Cell { Code("build.slides.fonts") }
                    Table.Cell { Code("strings") }
                    Table.Cell { Code("[]") }
                    Table.Cell("Font files or folders to embed, beside the project's `fonts/`.")
                }
                Table.Row {
                    Table.Cell { Code("build.slides.system_fonts") }
                    Table.Cell { Code("boolean") }
                    Table.Cell { Code("true") }
                    Table.Cell("Let the machine's fonts stand in for a family or a character the project's fonts lack.")
                }
            }
        }
        Heading("dev", id: "keys-dev", class: "bp-mono").h2
        Table(caption: "The dev keys", class: "bp-table") {
            Table.Head {
                Table.Row {
                    Table.Cell(t("config.key")).header
                    Table.Cell(t("ref.type")).header
                    Table.Cell(t("config.default")).header
                    Table.Cell(t("ref.meaning")).header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Code("dev.port") }
                    Table.Cell { Code("integer (1–65535)") }
                    Table.Cell { Code("3000") }
                    Table.Cell("The port `wf serve` listens on.")
                }
                Table.Row {
                    Table.Cell { Code("dev.hot_reload") }
                    Table.Cell { Code("boolean") }
                    Table.Cell { Code("true") }
                    Table.Cell("Reload the page in the browser when a build finishes.")
                }
            }
        }
        Heading("meta", id: "keys-meta", class: "bp-mono").h2
        Table(caption: "The meta keys", class: "bp-table") {
            Table.Head {
                Table.Row {
                    Table.Cell(t("config.key")).header
                    Table.Cell(t("ref.type")).header
                    Table.Cell(t("config.default")).header
                    Table.Cell(t("ref.meaning")).header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Code("meta.title") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("\"\"") }
                    Table.Cell("The site's title, for a page that does not give its own.")
                }
                Table.Row {
                    Table.Cell { Code("meta.description") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("\"\"") }
                    Table.Cell("The site's description, for a page that does not give its own.")
                }
                Table.Row {
                    Table.Cell { Code("meta.lang") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("en") }
                    Table.Cell("The language the pages are written in, as a tag: `en`, `ar`, `pt-BR`.")
                }
                Table.Row {
                    Table.Cell { Code("meta.favicon") }
                    Table.Cell { Code("file") }
                    Table.Cell { Code("\"\"") }
                    Table.Cell("The icon a tab shows: a file in `public/` or a URL.")
                }
                Table.Row {
                    Table.Cell { Code("meta.touch_icon") }
                    Table.Cell { Code("file") }
                    Table.Cell { Code("\"\"") }
                    Table.Cell("The icon a phone puts on its home screen: a 180×180 PNG in `public/`.")
                }
                Table.Row {
                    Table.Cell { Code("meta.site_url") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("\"\"") }
                    Table.Cell("The site's own origin — `https://example.com` — without which no canonical link or sitemap is written.")
                }
                Table.Row {
                    Table.Cell { Code("meta.site_name") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("\"\"") }
                    Table.Cell("The person or organisation behind the site, for search results and sharing; unset, the project's name.")
                }
                Table.Row {
                    Table.Cell { Code("meta.owner") }
                    Table.Cell { Code("\"organization\" | \"person\"") }
                    Table.Cell { Code("organization") }
                    Table.Cell("Whether the site belongs to an organisation or a person, for the structured data it publishes.")
                }
                Table.Row {
                    Table.Cell { Code("meta.same_as") }
                    Table.Cell { Code("strings") }
                    Table.Cell { Code("[]") }
                    Table.Cell("The owner's other profiles, which a search engine joins to the site.")
                }
                Table.Row {
                    Table.Cell { Code("meta.job_title") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("\"\"") }
                    Table.Cell("What a person who owns the site does.")
                }
                Table.Row {
                    Table.Cell { Code("meta.owner_details") }
                    Table.Cell { Code("map") }
                    Table.Cell { Code("null") }
                    Table.Cell("More of what the owner is, as schema.org properties: an email, a logo, where they work.")
                }
                Table.Row {
                    Table.Cell { Code("meta.image") }
                    Table.Cell { Code("file") }
                    Table.Cell { Code("\"\"") }
                    Table.Cell("The image a link to a page shows when shared, for a page that does not name its own.")
                }
                Table.Row {
                    Table.Cell { Code("meta.image_alt") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("\"\"") }
                    Table.Cell("What the sharing image shows, for a reader who cannot see it.")
                }
                Table.Row {
                    Table.Cell { Code("meta.sitemap") }
                    Table.Cell { Code("boolean") }
                    Table.Cell { Code("true") }
                    Table.Cell("Write `sitemap.xml` and `robots.txt` for a static build.")
                }
                Table.Row {
                    Table.Cell { Code("meta.fonts") }
                    Table.Cell { Code("strings") }
                    Table.Cell { Code("[]") }
                    Table.Cell("Web-font stylesheets to load, by URL, before the site's own styles.")
                }
                Table.Row {
                    Table.Cell { Code("meta.preload") }
                    Table.Cell { Code("strings") }
                    Table.Cell { Code("[]") }
                    Table.Cell("Files to fetch early, before the page asks for them: a font, a hero image.")
                }
                Table.Row {
                    Table.Cell { Code("meta.stylesheets") }
                    Table.Cell { Code("strings") }
                    Table.Cell { Code("[]") }
                    Table.Cell("Stylesheets of the project's own or another site's, linked on every page.")
                }
                Table.Row {
                    Table.Cell { Code("meta.scripts") }
                    Table.Cell { Code("scripts") }
                    Table.Cell { Code("[]") }
                    Table.Cell("Scripts every page loads — a library, an analytics tag — and the globals they define.")
                }
                Table.Row {
                    Table.Cell { Code("meta.integrity") }
                    Table.Cell { Code("string map") }
                    Table.Cell { Code("\{\}") }
                    Table.Cell("The integrity hash of each asset from another site, so the browser checks it has not changed.")
                }
                Table.Row {
                    Table.Cell { Code("meta.connect") }
                    Table.Cell { Code("strings") }
                    Table.Cell { Code("[]") }
                    Table.Cell("The origins a page may fetch from or connect to, beyond its own, under the security policy.")
                }
                Table.Row {
                    Table.Cell { Code("meta.img") }
                    Table.Cell { Code("strings") }
                    Table.Cell { Code("[]") }
                    Table.Cell("The origins a page may show images from, beyond its own, under the security policy.")
                }
                Table.Row {
                    Table.Cell { Code("meta.frame") }
                    Table.Cell { Code("strings") }
                    Table.Cell { Code("[]") }
                    Table.Cell("The origins a page may show in a frame, under the security policy.")
                }
                Table.Row {
                    Table.Cell { Code("meta.wasm") }
                    Table.Cell { Code("boolean") }
                    Table.Cell { Code("false") }
                    Table.Cell("Let a page run WebAssembly, under the security policy.")
                }
                Table.Row {
                    Table.Cell { Code("meta.style_elements") }
                    Table.Cell { Code("boolean") }
                    Table.Cell { Code("false") }
                    Table.Cell("Let a library write `<style>` elements, under the security policy.")
                }
            }
        }
        Heading("motion", id: "keys-motion", class: "bp-mono").h2
        Table(caption: "The motion keys", class: "bp-table") {
            Table.Head {
                Table.Row {
                    Table.Cell(t("config.key")).header
                    Table.Cell(t("ref.type")).header
                    Table.Cell(t("config.default")).header
                    Table.Cell(t("ref.meaning")).header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Code("motion.duration") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("null") }
                    Table.Cell("How long an animation runs when the element does not say: `180ms`.")
                }
                Table.Row {
                    Table.Cell { Code("motion.easing") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("null") }
                    Table.Cell("How an animation is paced when the element does not say: a token or a CSS timing function.")
                }
            }
        }
        Heading("env", id: "keys-env", class: "bp-mono").h2
        Table(caption: "The env keys", class: "bp-table") {
            Table.Head {
                Table.Row {
                    Table.Cell(t("config.key")).header
                    Table.Cell(t("ref.type")).header
                    Table.Cell(t("config.default")).header
                    Table.Cell(t("ref.meaning")).header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Code("env") }
                    Table.Cell { Code("map") }
                    Table.Cell { Code("\{\}") }
                    Table.Cell("Values the program reads as `env.NAME`, set per build.")
                }
            }
        }
        Heading("public_env", id: "keys-public_env", class: "bp-mono").h2
        Table(caption: "The public_env keys", class: "bp-table") {
            Table.Head {
                Table.Row {
                    Table.Cell(t("config.key")).header
                    Table.Cell(t("ref.type")).header
                    Table.Cell(t("config.default")).header
                    Table.Cell(t("ref.meaning")).header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Code("public_env") }
                    Table.Cell { Code("strings") }
                    Table.Cell { Code("[]") }
                    Table.Cell("The `env` names a page may read and so ships to the browser, beyond those beginning `PUBLIC_`.")
                }
            }
        }
        Heading("offline", id: "keys-offline", class: "bp-mono").h2
        Table(caption: "The offline keys", class: "bp-table") {
            Table.Head {
                Table.Row {
                    Table.Cell(t("config.key")).header
                    Table.Cell(t("ref.type")).header
                    Table.Cell(t("config.default")).header
                    Table.Cell(t("ref.meaning")).header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Code("offline.precache") }
                    Table.Cell { Code("strings") }
                    Table.Cell { Code("[\"/\"]") }
                    Table.Cell("The routes a first visit stores for when the network is gone, as globs: `/`, `/docs/*`.")
                }
                Table.Row {
                    Table.Cell { Code("offline.fallback") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("null") }
                    Table.Cell("The page shown offline for a route that is not stored.")
                }
                Table.Row {
                    Table.Cell { Code("offline.cache") }
                    Table.Cell { Code("\"network-first\" | \"cache-first\" | \"stale-while-revalidate\" | \"network-only\"") }
                    Table.Cell { Code("\{\}") }
                    Table.Cell("How a path the build did not write is fetched, by glob: `network-first`, `cache-first`, `stale-while-revalidate` or `network-only`.")
                }
                Table.Row {
                    Table.Cell { Code("offline.sync") }
                    Table.Cell { Code("boolean") }
                    Table.Cell { Code("false") }
                    Table.Cell("Queue a write made while offline, and send it when the connection returns.")
                }
            }
        }
        Heading("i18n", id: "keys-i18n", class: "bp-mono").h2
        Table(caption: "The i18n keys", class: "bp-table") {
            Table.Head {
                Table.Row {
                    Table.Cell(t("config.key")).header
                    Table.Cell(t("ref.type")).header
                    Table.Cell(t("config.default")).header
                    Table.Cell(t("ref.meaning")).header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Code("i18n.default_locale") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("en") }
                    Table.Cell("The language a message is shown in when a locale has no translation of it.")
                }
                Table.Row {
                    Table.Cell { Code("i18n.locales") }
                    Table.Cell { Code("strings") }
                    Table.Cell { Code("[\"en\"]") }
                    Table.Cell("The languages the project is translated into, each a file under `dir`.")
                }
                Table.Row {
                    Table.Cell { Code("i18n.dir") }
                    Table.Cell { Code("string") }
                    Table.Cell { Code("src/translations") }
                    Table.Cell("The folder the translation files are in.")
                }
                Table.Row {
                    Table.Cell { Code("i18n.literals") }
                    Table.Cell { Code("boolean") }
                    Table.Cell { Code("false") }
                    Table.Cell("Translate by the words themselves: each string a reader sees is its own key.")
                }
            }
        }
        Heading("lints", id: "keys-lints", class: "bp-mono").h2
        Table(caption: "The lints keys", class: "bp-table") {
            Table.Head {
                Table.Row {
                    Table.Cell(t("config.key")).header
                    Table.Cell(t("ref.type")).header
                    Table.Cell(t("config.default")).header
                    Table.Cell(t("ref.meaning")).header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Code("lints") }
                    Table.Cell { Code("\"off\" | \"warn\" | \"error\"") }
                    Table.Cell { Code("\{\}") }
                    Table.Cell("What a finding counts as, by its code or family: `off`, `warn` or `error`.")
                }
            }
        }
    }
}
