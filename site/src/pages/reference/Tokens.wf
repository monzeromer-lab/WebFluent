                    Table.Cell("color, background, background-color, border, border-color, outline")
                }
                Table.Row {
                    Table.Cell { Code("$color-primary") }
                    Table.Cell { Row(align: .center, gap: .xs) { style { flex-wrap: nowrap; gap: 8px; & p { margin: 0 } } Text("", aria-hidden: "true") { style { flex-shrink: 0; width: 14px; height: 14px; border: 1px solid $line; border-radius: 3px; background: #3B82F6 } }  Code("#3B82F6") } }
