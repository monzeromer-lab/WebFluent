                            Table.Cell { Markdown("`fast`, `normal`, `slow`") }
                            Table.Cell { Markdown("`$fast` is `transition-fast`") }
                        }
                    }
                }

                Markdown("A short name your theme declares as a token of its own means that token, not the group's: with `md: 20px` in the theme, `$md` is `md` everywhere.\n\nA full name — `$color-text-muted`, `$spacing-lg`, a token of your own — works in any property.")

            }
        }
        Heading("color", id: "tokens-color", class: "bp-mono").h2
        Table(caption: "The color tokens", class: "bp-table") {
            Table.Head {
                Table.Row {
