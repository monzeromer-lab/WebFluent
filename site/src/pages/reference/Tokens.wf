                    Table.Cell { Row(align: .center, gap: .xs) { style { flex-wrap: nowrap; gap: 8px; & p { margin: 0 } } Text("", aria-hidden: "true") { style { flex-shrink: 0; width: 14px; height: 14px; border: 1px solid $line; border-radius: 3px; background: #E2E8F0 } }  Code("#E2E8F0") } }
