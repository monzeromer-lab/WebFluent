// `/reference/tokens`: how a theme's tokens are read and written. The words
// are this page's; the baseline's tables are `TokenBaseline`, which
// scripts/docsite/reference.py writes from `wf theme --json`.

page TokensPage(path: "/reference/tokens", title: "Design tokens — Reference", description: "Every baseline design token: its default value, what it is for, which built-ins draw from it, and how a style block or a stylesheet reads it.") {
    ReferenceItemShell(t("tokens.title"), summary: t("tokens.lede", { count: TOKEN_COUNT }), signature: "theme Brand \{ color-primary: #3B82F6 \}", group: t("tokens.title"), entries: REFERENCE_PAGES, sections: [Anchor(id: "reading-a-token", label: "Reading a token"), Anchor(id: "every-built-in-follows-the-theme", label: "Every built-in follows the theme"), Anchor(id: "short-names", label: "Short names")].concat(TOKEN_SECTIONS), source: "site/src/pages/reference/Tokens.wf") {
        notes {
            Stack(gap: .lg) {
                Markdown("This chapter lists every design token of the baseline theme with its value, and how a style reads one. A *design token* is a named value — a colour, a size, a duration — that every built-in is drawn with. Change a token and every element drawn with it changes.\n\nA `theme` declaration changes the tokens it names and keeps the baseline value of every other one. A theme may also add tokens of its own. Each token becomes a CSS custom property on `:root`:")

                DocsCodeBlock(#"theme Brand {
    color-primary: #0F766E
    radius-md: 14px
    screen-md: 900px
    surface-raised: #F1F5F9
}"#, title: "wf")

                Markdown("The build writes to `:root` only the tokens something in the output names, and the tokens those name in turn.")

                Heading("Reading a token", id: "reading-a-token").h2

                Markdown("A token has two spellings, one for each place a style is written:")

                Table(caption: "Reading a token") {
                    Table.Head {
                        Table.Row {
                            Table.Cell("Where").header
                            Table.Cell("Syntax").header
                            Table.Cell("Example").header
                        }
                    }
                    Table.Body {
                        Table.Row {
                            Table.Cell { Markdown("A `style \{ \}` block") }
                            Table.Cell { Markdown("`$name`") }
                            Table.Cell { Markdown("`background: $color-surface`") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("A `style \{ \}` block, short form") }
                            Table.Cell { Markdown("`$suffix`, resolved by the property's group ([below](#short-names))") }
                            Table.Cell { Markdown("`padding: $lg` is `spacing-lg`") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("A `.css` file under `src/`") }
                            Table.Cell { Markdown("`var(--name)`") }
                            Table.Cell { Markdown("`color: var(--color-text-muted)`") }
                        }
                    }
                }

                Markdown("This page reads the tokens of the theme above — one the theme adds, one it changes, one it keeps, and a breakpoint it moves:")

                DocsCodeBlock(#"theme Brand {
    color-primary: #0F766E
    radius-md: 14px
    screen-md: 900px
    surface-raised: #F1F5F9
}

page Pricing(path: "/pricing", title: "Pricing", description: "Plans and prices for every team.") {
    Heading("Pricing").h1
    Card {
        style {
            background: $surface-raised
            padding: $lg
            border-radius: $md
            border: 1px solid $border
            @md { padding: $xl }
        }
        Text("Team plan").bold
    }
}"#, title: "wf")

                Markdown("The card's background is `#F1F5F9`, its radius `14px` and its border the baseline `color-border`. Its padding grows to `spacing-xl` from `900px` wide, because `@md` reads `screen-md`.\n\nA `$token` the resolved theme does not declare draws the `V06` warning, since the property would fall back to nothing. `wf theme` lists every token the build uses, where each is read, and the contrast of the colour pairs ([Command line](/reference/cli/theme)).")

                Heading("Every built-in follows the theme", id: "every-built-in-follows-the-theme").h2

                Markdown("The built-ins draw their colours, sizes, radii, fonts and motion from these tokens and nothing else, so a theme restyles every one of them, the ones a page adds later included. A tone's label is a token too: `color-on-primary` is what a primary button, badge, pressed toggle, current page or selected day writes on `color-primary`, and so for `secondary`, `success`, `danger`, `warning` and `info`. A theme with a light primary names a dark `color-on-primary`, and `A13` holds each pair to WCAG AA where a page draws it. An alert's tint, a focus ring and a highlighted match are worked out from the tone and the page's colours (`color-mix`), so a dark theme gets dark alerts without naming any; `color-backdrop` dims the page behind a modal, a dialog, a sheet and a drawer. The only colours that stay fixed are the ones over a picture: a carousel's and a lightbox's controls.")

                Heading("Short names", id: "short-names").h2

                Markdown("In a `style \{ \}` block, a short name is resolved through the group of the property it is given to: `$lg` on `padding` is `spacing-lg`, and on `border-radius` it is `radius-lg`.")

                Table(caption: "Short names") {
                    Table.Head {
                        Table.Row {
                            Table.Cell("Property").header
                            Table.Cell("Group").header
                            Table.Cell("Short names").header
                            Table.Cell("Example").header
                        }
                    }
                    Table.Body {
                        Table.Row {
                            Table.Cell { Markdown("`padding`, `margin` and every `padding-*` and `margin-*` property (physical and logical), `gap`, `row-gap`, `column-gap`, `width`, `height`, `min-width`, `max-width`, `min-height`, `max-height`, `top`, `right`, `bottom`, `left`, `inset` and `inset-*`") }
                            Table.Cell("spacing")
                            Table.Cell { Markdown("`xs`, `sm`, `md`, `lg`, `xl`, `2xl`, `3xl`") }
                            Table.Cell { Markdown("`$lg` is `spacing-lg`") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`color`, `background`, `background-color`, `border-color`, `fill`, `stroke`, `outline`, `outline-color`, `text-decoration-color`, `caret-color`, `accent-color`, and the `border` shorthands (`border`, `border-top` … `border-inline-end`)") }
                            Table.Cell("colour")
                            Table.Cell { Markdown("`primary`, `secondary`, `success`, `danger`, `warning`, `info`, `background`, `surface`, `text`, `text-muted`, `border`") }
                            Table.Cell { Markdown("`$primary` is `color-primary`") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`font-size`") }
                            Table.Cell("font size")
                            Table.Cell { Markdown("`xs`, `sm`, `base`, `lg`, `xl`, `2xl`, `3xl`") }
                            Table.Cell { Markdown("`$xl` is `font-size-xl`") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`line-height`") }
                            Table.Cell("line height")
                            Table.Cell { Markdown("`tight`, `normal`, `loose`") }
                            Table.Cell { Markdown("`$tight` is `line-height-tight`") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`border-radius`") }
                            Table.Cell("radius")
                            Table.Cell { Markdown("`none`, `sm`, `md`, `lg`, `xl`, `full`") }
                            Table.Cell { Markdown("`$lg` is `radius-lg`") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`box-shadow`") }
                            Table.Cell("shadow")
                            Table.Cell { Markdown("`none`, `sm`, `md`, `lg`, `xl`") }
                            Table.Cell { Markdown("`$md` is `shadow-md`") }
                        }
                        Table.Row {
                            Table.Cell { Markdown("`transition`") }
                            Table.Cell("transition")
                            Table.Cell { Markdown("`fast`, `normal`, `slow`") }
                            Table.Cell { Markdown("`$fast` is `transition-fast`") }
                        }
                    }
                }

                Markdown("A short name your theme declares as a token of its own means that token, not the group's: with `md: 20px` in the theme, `$md` is `md` everywhere.\n\nA full name — `$color-text-muted`, `$spacing-lg`, a token of your own — works in any property.")

            }
        }
        // ── the baseline ── written by scripts/docsite/reference.py from `wf theme --json`; edit the compiler, not this part
        Heading("The baseline", id: "the-baseline").h2
        Markdown(t("tokens.baseline"), class: "bp-prose")
        Heading("Colour", id: "tokens-color").h3
        Table(caption: "The Colour tokens", class: "bp-table") {
            Table.Head {
                Table.Row {
                    Table.Cell(t("tokens.token")).header
                    Table.Cell(t("tokens.value")).header
                    Table.Cell(t("tokens.for")).header
                    Table.Cell(t("tokens.usedby")).header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Code("color-backdrop") { style { white-space: nowrap } } }
                    Table.Cell { Row(align: .center, gap: .xs) { style { flex-wrap: nowrap; gap: 8px; & p { margin: 0 } } Text("", aria-hidden: "true") { style { flex-shrink: 0; width: 14px; height: 14px; border: 1px solid $line; border-radius: 3px; background: rgb(0 0 0 / 0.5) } }  Code("rgb(0 0 0 / 0.5)") } }
                    Table.Cell { Markdown("What dims the page behind a modal, a dialog, a sheet and a drawer") }
                    Table.Cell("Sidebar, Modal, Dialog, Sheet")
