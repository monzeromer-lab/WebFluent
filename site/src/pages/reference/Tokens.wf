                }
                Table.Row {
                    Table.Cell { Code("z-tooltip") { style { white-space: nowrap } } }
                    Table.Cell { Row(align: .center, gap: .xs) { style { flex-wrap: nowrap; gap: 8px; & p { margin: 0 } } Code("1500") } }
                    Table.Cell { Markdown("Where a tooltip not in the top layer stacks") }
                    Table.Cell("—")
                }
            }
        }
        // ── end of the baseline ──
    }
}
