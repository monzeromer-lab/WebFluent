page Guide(path: "/guide", description: "The language, end to end: pages, components, state and routing.", title: "Language Guide") {
    Container.fadeIn {
        Spacer
        Heading("Language Guide").h1
        Text("Learn the core concepts of WebFluent.").muted

        Spacer

        Heading("Pages").h2
        Text("Pages are top-level route targets. Each page defines a URL path and contains the UI tree for that route.")
        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("page Home(path: \"/\", title: \"Home\") \{\n    Container \{\n        Heading(\"Welcome\").h1\n        Text(\"This is the home page.\")\n    \}\n\}").block
            }
        }
        Spacer.sm
        Text("Page attributes:").bold
        Table {
            Table.Head {
                Table.Cell("Attribute")
                Table.Cell("Type")
                Table.Cell("Description")
            }
            Table.Row { Table.Cell("path") Table.Cell("String") Table.Cell("URL route for this page (required)") }
            Table.Row { Table.Cell("title") Table.Cell("String") Table.Cell("Tab title, and the heading of a search result") }
            Table.Row { Table.Cell("description") Table.Cell("String") Table.Cell("The snippet a search result and a link preview show") }
            Table.Row { Table.Cell("image") Table.Cell("String") Table.Cell("Link-preview image, site-relative or absolute") }
            Table.Row { Table.Cell("type") Table.Cell("String") Table.Cell("\"website\" (default) or \"article\"") }
            Table.Row { Table.Cell("noindex") Table.Cell("Flag") Table.Cell("Bare word; keeps the page out of search and the sitemap") }
            Table.Row { Table.Cell("guard") Table.Cell("Expression") Table.Cell("Navigation guard — redirects if false") }
            Table.Row { Table.Cell("redirect") Table.Cell("String") Table.Cell("Redirect target when guard fails") }
        }

        Spacer
        Divider
        Spacer

        Heading("Components").h2
        Text("Reusable UI blocks that accept props and can have internal state.")
        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("component UserCard(name: String, role: String, active: Bool = true) \{\n    Card.elevated \{\n        Row(align: .center, gap: .md) \{\n            Avatar(initials: \"U\").primary\n            Stack \{\n                Text(name).bold\n                Text(role).muted\n            \}\n            if active \{\n                Badge(\"Active\").success\n            \}\n        \}\n    \}\n\}\n\n// Usage\nUserCard(name: \"Monzer\", role: \"Developer\")").block
            }
        }
        Spacer.sm
        Text("Props support types: String, Number, Bool, List, Map. Optional props use ?, defaults use =.").muted

        Spacer
        Divider
        Spacer

        Heading("State and Reactivity").h2
        Text("State is declared with the state keyword. It is reactive — any UI that reads it updates automatically when it changes.")
        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("page Counter(path: \"/counter\") \{\n    state count = 0\n\n    Container \{\n        Text(\"Count: \{count\}\")\n        Button(\"+1\").primary \{ on click \{ count = count + 1 \} \}\n        Button(\"-1\") \{ on click \{ count = count - 1 \} \}\n    \}\n\}").block
            }
        }

        Spacer.sm
        Text("Derived state:").bold
        Card.outlined {
            Card.Body {
                Code("state items = [\{name: \"A\", price: 3\}, \{name: \"B\", price: 2\}]\nderived total = items.map(i => i.price).sum()\nderived isEmpty = items.length == 0").block
            }
        }

        Spacer
        Divider
        Spacer

        Heading("Events").h2
        Text("Event handlers are declared with on:event or via shorthand blocks on buttons.")
        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("Button(\"Submit\") \{\n    on click \{\n        submitForm()\n    \}\n\}\n\nInput(placeholder: \"Search...\").text \{\n    on input \{\n        searchQuery = value\n    \}\n    on keydown \{\n        if key == \"Enter\" \{\n            performSearch()\n        \}\n    \}\n\}\n\n// Shorthand: block on Button defaults to on:click\nButton(\"Save\") \{ on click \{ save() \} \}").block
            }
        }
        Spacer.sm
        Text("Supported events: click, submit, input, change, focus, blur, keydown, keyup, mouseover, mouseout, mount, unmount — written `on click { … }`; `on click(event) { … }` names the event.").muted

        Spacer
        Divider
        Spacer

        Heading("Control Flow").h2

        Text("Conditionals:").bold
        Card.outlined {
            Card.Body {
                Code("if isLoggedIn \{\n    Text(\"Welcome back!\")\n\} else if isGuest \{\n    Text(\"Hello, guest\")\n\} else \{\n    Button(\"Log In\") \{ on click \{ navigate(\"/login\") \} \}\n\}").block
            }
        }

        Spacer.sm
        Text("Loops:").bold
        Card.outlined {
            Card.Body {
                Code("for user in users \{\n    UserCard(name: user.name, role: user.role)\n\}\n\n// With index\nfor item, index in items \{\n    Text(\"\{index + 1\}. \{item\}\")\n\}").block
            }
        }

        Spacer.sm
        Text("Show/Hide (keeps element in DOM, toggles visibility):").bold
        Card.outlined {
            Card.Body {
                Code("show isExpanded \{\n    Card \{ Text(\"Expanded content\") \}\n\}").block
            }
        }

        Spacer
        Divider
        Spacer

        Heading("Stores").h2
        Text("Stores hold shared state accessible from any page or component.")
        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("store CartStore \{\n    state items = []\n\n    derived total = items.map(i => i.price * i.quantity).sum()\n    derived count = items.length\n\n    action addItem(product: Map) \{\n        items.push(\{ id: product.id, name: product.name, price: product.price, quantity: 1 \})\n    \}\n\n    action removeItem(id: Number) \{\n        items = items.filter(i => i.id != id)\n    \}\n\}\n\n// Usage in a page\npage Cart(path: \"/cart\") \{\n    use CartStore\n\n    Text(\"Total: $\{CartStore.total\}\")\n    Button(\"Clear\") \{ on click \{ CartStore.clear() \} \}\n\}").block
            }
        }

        Spacer
        Divider
        Spacer

        Heading("Routing").h2
        Text("SPA routing is declared in the App file.")
        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("app \{\n    Navbar \{\n        Navbar.Brand \{ Text(\"My App\").heading \}\n        Navbar.Links \{\n            Link(to: \"/\") \{ Text(\"Home\") \}\n            Link(to: \"/about\") \{ Text(\"About\") \}\n        \}\n    \}\n\n    // Every page declares its own path; the router shows the one that matches.\n    Router\n\}\n\n// Programmatic navigation\nButton(\"Go Home\") \{ on click \{ navigate(\"/\") \} \}\n\n// Dynamic routes bind their params\npage UserProfile(path: \"/user/:id\", id: String) \{\n    Text(\"User ID: \{id\}\")\n\}\n\n// A catch-all page\npage NotFound(path: \"*\") \{\n    Text(\"Not found\")\n\}").block
            }
        }

        Spacer
        Divider
        Spacer

        Heading("Data Fetching").h2
        Text("Built-in async data loading with automatic loading, error, and success states.")
        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("resource users = fetch(\"/api/users\")\nmatch users \{\n    loading \{\n        Spinner\n    \}\n    error (err) \{\n        Alert(\"Failed to load users\").danger\n    \}\n    ready(users) \{\n        for user in users \{\n            UserCard(name: user.name, role: user.role)\n        \}\n    \}\n\}\n\n// With options\nresource result = fetch(\"/api/submit\", method: \"POST\", body: \{ name: name, email: email \})\nmatch result \{\n    ready(result) \{\n        Alert(\"Saved!\").success\n    \}\n\}").block
            }
        }

        Spacer
        Divider
        Spacer

        Heading("Return Values").h2
        Text("Store actions can return values using the return keyword.")
        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("store AuthStore \{\n    state accessToken = \"\"\n\n    action getHeaders() \{\n        h = \{\}\n        h[\"Authorization\"] = \"Bearer \" + accessToken\n        return h\n    \}\n\}").block
            }
        }

        Spacer
        Divider
        Spacer

        Heading("Browser Globals").h2
        Text("Standard browser APIs are available directly without any special syntax. They compile to their JavaScript equivalents.")
        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("// Storage\nlocalStorage.setItem(\"token\", tok)\nsessionStorage.getItem(\"key\")\n\n// Window & Document\nwindow.open(\"https://example.com\")\n\n// JSON\ndata = JSON.parse(responseText)\ntext = JSON.stringify(obj)\n\n// Console\nconsole.log(\"debug info\")\n\n// Timers\nsetTimeout(callback, 1000)").block
            }
        }
        Spacer.sm
        Text("Available globals: window, document, console, localStorage, sessionStorage, JSON, Math, Date, setTimeout, setInterval, parseInt, parseFloat, Array, Object, Promise, Error, fetch, alert, confirm, prompt, and more.").muted

        Spacer
        Divider
        Spacer

        Heading("Map Literals").h2
        Text("Map literals support quoted string keys for HTTP headers and special field names. Reserved words also work as map keys.")
        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("// Quoted keys for headers\nheaders: \{ \"Content-Type\": \"application/json\", \"X-Api-Key\": apiKey \}\n\n// Reserved words as keys\nbody: \{ action: \"create\", token: sessionToken, state: \"active\" \}").block
            }
        }

        Spacer
        Divider
        Spacer

        Heading("Operators").h2
        Text("WebFluent supports all common comparison and logical operators.")
        Spacer.sm
        Table {
            Table.Head { Table.Cell("Operator") Table.Cell("Description") }
            Table.Row { Table.Cell("==") Table.Cell("Equal") }
            Table.Row { Table.Cell("!=") Table.Cell("Not equal") }
            Table.Row { Table.Cell("!==") Table.Cell("Strict not equal (alias for !=)") }
            Table.Row { Table.Cell("< > <= >=") Table.Cell("Comparison") }
            Table.Row { Table.Cell("&& ||") Table.Cell("Logical AND / OR") }
            Table.Row { Table.Cell("!") Table.Cell("Logical NOT") }
            Table.Row { Table.Cell("+ - * / %") Table.Cell("Arithmetic") }
        }

        Spacer

        Row(gap: .md) {
            Button("Components Reference").primary { on click { navigate("/components") } }
            Button("Styling Guide") { on click { navigate("/styling") } }
        }

        Spacer.xl
    }
}
