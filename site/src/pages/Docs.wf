/// The documentation's old front door. What it did — send a reader to
/// learn, to do, to look up or to fix — is the home page's "Find your way"
/// now, so the address sends the reader there.
page DocsHome(path: "/docs", title: "Documentation", description: "The WebFluent documentation: learn, recipes, reference and errors.", guard: false, redirect: "/", noindex: true) {
    Heading(t("nav.learn")).h1
    Link(t("nav.learn"), to: "/learn")
}
