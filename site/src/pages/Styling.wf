page Styling(path: "/styling", description: "Themes, design tokens and style blocks.", title: "Design System & Styling") {
    Container.fadeIn {
        Spacer
        Heading("Design System & Styling").h1
        Text("Token-based design system. Every component uses design tokens for colors, spacing, typography. Change the entire look with a config update.").muted

        Spacer

        Heading("Variant Modifiers").h2
        Text("Apply common styles with modifier keywords.")
        Spacer.sm

        Card.outlined {
            Card.Header { Text("Size Modifiers").bold }
            Card.Body {
                Row(gap: .sm, align: .center) {
                    Button("Small").primary.sm
                    Button("Medium").primary
                    Button("Large").primary.lg
                }
            }
        }
        Spacer.sm
        Card.outlined {
            Card.Header { Text("Color Modifiers").bold }
            Card.Body {
                Row(gap: .sm) {
                    Button("Primary").primary
                    Button("Secondary").secondary
                    Button("Success").success
                    Button("Danger").danger
                    Button("Warning").warning
                    Button("Info").info
                }
                Spacer.sm
                Row(gap: .sm) {
                    Badge("Primary").primary
                    Badge("Success").success
                    Badge("Danger").danger
                    Badge("Warning").warning
                }
            }
        }
        Spacer.sm
        Card.outlined {
            Card.Header { Text("Shape and Elevation").bold }
            Card.Body {
                Row(gap: .sm) {
                    Button("Default").primary
                    Button("Rounded").primary.rounded
                    Button("Full Width").primary.full
                }
                Spacer
                Row(gap: .md) {
                    Card { Card.Body { Text("Default") } }
                    Card.elevated { Card.Body { Text("Elevated") } }
                    Card.outlined { Card.Body { Text("Outlined") } }
                }
            }
        }
        Spacer.sm
        Card.outlined {
            Card.Header { Text("Text Modifiers").bold }
            Card.Body {
                Text("Bold text.").bold
                Text("Italic text.").italic
                Text("Uppercase text.").uppercase
                Text("Muted text.").muted
                Text("Primary colored text.").primary
                Text("Small text.").sm
                Text("Large text.").lg
            }
        }

        Spacer
        Divider
        Spacer

        Heading("Design Tokens").h2
        Text("All styling is built on tokens — CSS custom properties. Override any token in your config.")
        Spacer.sm

        Row(gap: .md) {
            Column(span: 6) {
                Card.outlined {
                    Card.Header { Text("Colors").bold }
                    Card.Body {
                        Table {
                            Table.Head { Table.Cell("Token") Table.Cell("Value") }
                            Table.Row { Table.Cell("color-primary") Table.Cell("#3B82F6") }
                            Table.Row { Table.Cell("color-success") Table.Cell("#22C55E") }
                            Table.Row { Table.Cell("color-danger") Table.Cell("#EF4444") }
                            Table.Row { Table.Cell("color-warning") Table.Cell("#F59E0B") }
                            Table.Row { Table.Cell("color-text") Table.Cell("#0F172A") }
                            Table.Row { Table.Cell("color-border") Table.Cell("#E2E8F0") }
                        }
                    }
                }
            }
            Column(span: 6) {
                Card.outlined {
                    Card.Header { Text("Spacing and Radius").bold }
                    Card.Body {
                        Table {
                            Table.Head { Table.Cell("Token") Table.Cell("Value") }
                            Table.Row { Table.Cell("spacing-xs") Table.Cell("0.25rem") }
                            Table.Row { Table.Cell("spacing-sm") Table.Cell("0.5rem") }
                            Table.Row { Table.Cell("spacing-md") Table.Cell("1rem") }
                            Table.Row { Table.Cell("spacing-lg") Table.Cell("1.5rem") }
                            Table.Row { Table.Cell("radius-md") Table.Cell("0.5rem") }
                            Table.Row { Table.Cell("radius-full") Table.Cell("9999px") }
                        }
                    }
                }
            }
        }

        Spacer
        Divider
        Spacer

        Heading("Themes").h2
        Text("A theme is written in WebFluent, in your own source, next to the code it dresses. Declare one and every built-in component follows it.")
        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("theme Ledger \{\n    color-primary: #0F766E\n    color-secondary: #134E4A\n    font-family: 'Söhne', system-ui, sans-serif\n    radius-md: 14px\n\}").block
            }
        }
        Spacer.sm
        Text("Every token you do not name keeps its baseline value, so a theme is only as large as the difference you want. Declare one theme and it is used automatically; declare several and name the one you want with \"theme\": \{ \"name\": \"Ledger\" \} in webfluent.app.json.").muted.sm

        Spacer

        Heading("Example themes").h3
        Text("Four starting points ship in examples/themes/. Copy one into your src/ and edit it — they are ordinary source files, not engine settings.")
        Spacer.sm
        Grid(columns: 2, gap: .md) {
            Card {
                style {
                    background: #ffffff
                    border: 1px solid #E2E8F0
                    border-radius: 0.75rem
                }
                Card.Body {
                    Row(gap: .sm, align: .center) {
                        Badge("baseline").primary
                        Text("Baseline").bold
                    }
                    Spacer.sm
                    Text("What you get with no theme declared: clean, modern, blue primary.").muted.sm
                    Spacer.sm
                    Row(gap: .sm) {
                        Button("Primary").primary.sm
                        Button("Success").success.sm
                        Badge("Tag").info
                    }
                    Spacer.sm
                    Progress(value: 65, max: 100)
                    Spacer.sm
                    Text("No declaration needed.").muted.sm
                }
            }
            Card {
                style {
                    background: #0F172A
                    color: #E2E8F0
                    border: 1px solid #334155
                    border-radius: 0.75rem
                }
                Card.Body {
                    Row(gap: .sm, align: .center) {
                        Badge("dark").secondary
                        Text("Dark").bold
                    }
                    Spacer.sm
                    Text("Dark backgrounds with light text and vibrant accents.").sm
                    Spacer.sm
                    Row(gap: .sm) {
                        Button("Primary").primary.sm
                        Button("Danger").danger.sm
                        Badge("Live").success
                    }
                    Spacer.sm
                    Progress(value: 80, max: 100)
                    Spacer.sm
                    Code("examples/themes/dark.wf").block
                }
            }
            Card {
                style {
                    background: #ffffff
                    border: 2px solid #000000
                    border-radius: 0
                }
                Card.Body {
                    Row(gap: .sm, align: .center) {
                        Badge("minimal")
                        Text("Minimal").bold
                    }
                    Spacer.sm
                    Text("Black and white. No shadows, no border-radius. Pure content.").sm
                    Spacer.sm
                    Row(gap: .sm) {
                        Button("Action").sm
                        Badge("Note")
                    }
                    Spacer.sm
                    Progress(value: 50, max: 100)
                    Spacer.sm
                    Code("examples/themes/minimal.wf").block
                }
            }
            Card {
                style {
                    background: #ffffff
                    border: 3px solid #000000
                    border-radius: 0
                    box-shadow: 4px 4px 0 #000000
                    font-family: monospace
                }
                Card.Body {
                    Row(gap: .sm, align: .center) {
                        Badge("brutalist").danger
                        Text("Brutalist").bold
                    }
                    Spacer.sm
                    Text("Monospace font, bold red primary, hard offset shadows.").sm
                    Spacer.sm
                    Row(gap: .sm) {
                        Button("Action").danger.sm
                        Badge("Alert").danger
                    }
                    Spacer.sm
                    Progress(value: 90, max: 100)
                    Spacer.sm
                    Code("examples/themes/brutalist.wf").block
                }
            }
        }

        Spacer
        Divider
        Spacer

        Heading("Custom Tokens").h2
        Text("A theme covers the design. For values a machine supplies — a deploy pipeline injecting a brand colour — config tokens still apply, on top of whatever the theme set.")
        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("\{\n  \"theme\": \{\n    \"tokens\": \{\n      \"color-primary\": \"#8B5CF6\"\n    \}\n  \}\n\}").block
            }
        }

        Spacer
        Divider
        Spacer

        Heading("Style Blocks").h2
        Text("Override styles on any component with inline style blocks.")
        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("Button(\"Custom\") \{\n    style \{\n        background: #8B5CF6\n        padding: $xl\n        radius: $lg\n    \}\n\}").block
            }
        }

        Spacer.xl
        Heading("A scale that shrinks itself").h2
        Text("The type and spacing steps carry their own range, so a heading is smaller on a phone than on a desktop without any media query of yours. A hand-set font-size opts out of that — if you want a size to respond, use a token.")
        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("// Responds to the viewport by itself.\nHeading(\"Invoicing\").h1\n\n// Fixed at every width, because you said so.\nHeading(\"Invoicing\").h1 \{\n    style \{ font-size: 3.25rem \}\n\}").block
            }
        }

        Spacer
        Divider
        Spacer

        Heading("Bringing your own design").h2
        Text("Structural mode ships the layout and the mechanics — the grid, the off-canvas panel, the dialog, focus indication, reduced motion — and none of the engine's opinions about how any of it should look.")
        Spacer.sm
        Card.outlined {
            Card.Body {
                Code("\{\n  \"theme\": \{\n    \"builtin\": \"structural\"\n  \}\n\}").block
            }
        }
        Spacer.sm
        Text("Your Theme still applies. In this mode it is not an override of a baseline — it is the entire palette the site has.").muted.sm
    }
}
