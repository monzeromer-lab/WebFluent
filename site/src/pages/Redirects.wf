/// The guide's front doors: `/docs` and `/docs/guide` send the reader to
/// chapter one. A guard that never holds is a redirect.
page DocsIndex(path: "/docs", title: "Guide", description: "The WebFluent guide, from the first wf init to a complete application.", guard: false, redirect: "/docs/guide/getting-started", noindex: true) {
    Heading(t("nav.guide")).h1
    Link(t("ch.01"), to: "/docs/guide/getting-started")
}

page GuideIndex(path: "/docs/guide", title: "Guide", description: "The WebFluent guide, from the first wf init to a complete application.", guard: false, redirect: "/docs/guide/getting-started", noindex: true) {
    Heading(t("nav.guide")).h1
    Link(t("ch.01"), to: "/docs/guide/getting-started")
}
