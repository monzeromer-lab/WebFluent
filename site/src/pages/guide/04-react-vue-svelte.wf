                }
                Table.Row {
                    Table.Cell("Testing Library + Playwright")
                    Table.Cell { Markdown("`test \"…\" \{ … click \"Save\"  expect \"Saved\" \}`") }
                    Table.Cell { Markdown("[Testing](/docs/guide/testing)") }
                }
                Table.Row {
                    Table.Cell("ESLint a11y plugin")
