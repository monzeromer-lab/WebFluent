/// Chapter 2 of the guide, written from md-docs/02-language-basics.md by
/// scripts/site-from-guide.py; edit the guide, not this file.
page LanguageBasics(path: "/docs/guide/language-basics", title: "Language basics", description: "Declarations, naming, bodies, the braced and the indented layout, and how strings are written.", layout: DocsShell("Language basics", chapter: "Chapter 2", blurb: "A file is a list of declarations. This chapter covers the ten kinds, the naming rules, comments, strings and the two layouts.", sections: [Anchor(id: "a-file-is-a-list-of-declarations", label: "A file is a list of declarations"), Anchor(id: "naming", label: "Naming"), Anchor(id: "comments", label: "Comments"), Anchor(id: "bodies", label: "Bodies"), Anchor(id: "two-layouts-wf-and-wfx", label: "Two layouts: .wf and .wfx"), Anchor(id: "strings", label: "Strings")], prevTo: "/docs/guide/getting-started", prevLabel: "1. Getting started", nextTo: "/docs/guide/pages-and-routing", nextLabel: "3. Pages and routing")) {
    Stack(gap: .lg) {
        Heading("A file is a list of declarations", id: "a-file-is-a-list-of-declarations").h2

        Markdown("Every `.wf` file holds top-level declarations and nothing else — no loose elements, no statements outside a body. There are eleven kinds:")

        CodeBlock("page Home(path: \"/\", title: \"Home\", description: \"The front page.\") \{ Text(\"hi\") \}\ncomponent Chip(_ label: String, tone: Tone = .calm) \{ Badge(label) \}\nstore Cart \{ state items = []  derived count = items.length \}\ntheme Brand \{ color-primary: #0F766E  radius-md: 14px \}\napp \{ Navbar \{ Text(\"Shop\").heading \}  Router \}\ntype Todo \{ id: String, title: String, done: Bool = false \}\nenum Tone \{ calm, loud \}\nconst API = \"/api/v1\"\ndata posts = \"posts.json\"\nanimation Pulse \{ from \{ opacity: 1 \} to \{ opacity: 0.5 \} \}\ntest \"chip shows its label\" \{ Chip(\"Beta\")  expect \"Beta\" \}", title: "wf")

        Table(caption: "A file is a list of declarations") {
            Table.Head {
                Table.Row {
                    Table.Cell("Declaration").header
                    Table.Cell("What it is").header
                    Table.Cell("Chapter").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`page`") }
                    Table.Cell("A route and what it shows")
                    Table.Cell("3")
                }
                Table.Row {
                    Table.Cell { Markdown("`component`") }
                    Table.Cell("A reusable element with typed props, events, slots and parts")
                    Table.Cell("8")
                }
                Table.Row {
                    Table.Cell { Markdown("`store`") }
                    Table.Cell("State shared across pages")
                    Table.Cell("9")
                }
                Table.Row {
                    Table.Cell { Markdown("`theme`") }
                    Table.Cell("Design tokens: colours, spacing, radii, fonts")
                    Table.Cell("12")
                }
                Table.Row {
                    Table.Cell { Markdown("`app`") }
                    Table.Cell { Markdown("The shell every page renders inside, with the `Router`") }
                    Table.Cell("3")
                }
                Table.Row {
                    Table.Cell { Markdown("`type`, `enum`") }
                    Table.Cell("Records and enumerations the checker enforces")
                    Table.Cell("10")
                }
                Table.Row {
                    Table.Cell { Markdown("`const`, `data`") }
                    Table.Cell("A value read everywhere; a JSON file as one")
                    Table.Cell("10")
                }
                Table.Row {
                    Table.Cell { Markdown("`animation`") }
                    Table.Cell("Keyframes")
                    Table.Cell("13")
                }
                Table.Row {
                    Table.Cell { Markdown("`test`") }
                    Table.Cell("A render held to expectations and a snapshot")
                    Table.Cell("18")
                }
            }
        }

        Markdown("All the files under `src/` merge into one program, so a component declared in `components/Chip.wf` is usable from every page. `App.wf` is read first; the rest in name order.")

        Heading("Naming", id: "naming").h2

        Markdown("- Declaration keywords are lowercase: `page`, `component`, `store`.\n- The names they declare, and every element, are **PascalCase**: `Home`, `UserCard`, `Button`, `Table.Row`.\n- State, props, actions, variables and flags are **camelCase**: `count`, `isOpen`, `save`, `.primary`.\n- Enum cases are written with a leading dot: `.calm`, `.md`.\n- Design tokens are written with a dollar: `$primary`, `$spacing-md`.\n- A `///` comment above a declaration, a prop or an event is its documentation, shown on hover in the editor and in `wf docs`.\n\nNothing resolves silently. A name the compiler does not know — a misspelled element, a flag the element lacks, a case the enum lacks — is an error with a hint, never a no-op.")

        Heading("Comments", id: "comments").h2

        CodeBlock("// A line comment.\n/* A block\n   comment. */\n/// A doc comment: attaches to the declaration that follows it.\ncomponent Avatar(_ initials: String) \{ Text(initials).bold \}", title: "wf")

        Heading("Bodies", id: "bodies").h2

        Markdown("A declaration's body is a **render block**: elements, and the statements that shape them (`state`, `derived`, `if`, `for`, …). A handler or an action's body is an **imperative block**: statements that do something (assignments, calls, `let`, `if`, `for`, `try`). The two are separate grammars, and the compiler tells you when a statement is in the wrong kind of block:")

        CodeBlock("page P(path: \"/\") \{\n    state n = 0\n    Text(\"\{n\}\")                          // an element: fine in a render block\n    Button(\"+\") \{\n        on click \{ n = n + 1 \}           // an assignment: fine in a handler\n    \}\n\}", title: "wf")

        Markdown("Writing `n = n + 1` loose inside the page body is an error: *\"Code that does something goes in `on click \{ … \}`, an `action` or an `effect`\"*.\n\nStatements on one line are separated by two spaces or a `;`:")

        CodeBlock("page P(path: \"/\") \{\n    state a = 1  state b = 2\n    Button(\"x\") \{ on click \{ a = a + 1; b = b + 1 \} \}\n\}", title: "wf")

        Heading("Two layouts: .wf and .wfx", id: "two-layouts-wf-and-wfx").h2

        Markdown("The same grammar can be written with braces or with indentation. A `.wf` file opens a block with `\{` and closes it with `\}`; a `.wfx` file opens a block with a line indented deeper than the one before it and closes it with a dedent.")

        CodeBlock("page Home(path: \"/\") \{\n    state open = true\n    Row(gap: .sm) \{\n        style \{\n            padding: 6px 0\n            &:hover \{ background: $surface-hover \}\n        \}\n        on click \{ open = !open \}\n        Text(\"a\").bold\n    \}\n    if open \{\n        Spinner\n    \} else \{\n        Text(\"b\")\n    \}\n\}", title: "wf")

        Markdown("The same in `.wfx`:")

        CodeBlock("page Home(path: \"/\")\n    state open = true\n    Row(gap: .sm)\n        style\n            padding: 6px 0\n            &:hover\n                background: $surface-hover\n        on click \{ open = !open \}\n        Text(\"a\").bold\n    if open\n        Spinner\n    else\n        Text(\"b\")", title: "wfx")

        Markdown("Rules of the indented layout:\n\n- Four spaces (or one tab) per level, consistently; a line that lines up with no enclosing block is an error.\n- Braces you write yourself are still allowed, and everything inside them is free-form: `on click \{ open = !open \}` on one line, a map literal across several, an argument list across several.\n- An empty block is written `\{ \}`.\n- Blank lines and comment lines count for nothing.\n\nBoth layouts compile to the same output, are read by every tool, and a project may mix them. `wf fmt --to wfx` converts a project one way and `--to wf` the other, losslessly. This guide writes `.wf`; every example has an `.wfx` spelling.")

        Heading("Strings", id: "strings").h2

        Markdown("Strings are double-quoted and interpolate with `\{expr\}`:")

        CodeBlock("page P(path: \"/\") \{\n    state user = \{ name: \"Sam\", age: 41 \}\n    Text(\"Hello, \{user.name\}! You are \{user.age * 12\} months old.\")\n    Text(\"A literal brace: \\\{ and \\\}\")\n    Text(\"A literal dollar: $\{user.age\}\")     // `$` alone is plain text\n\}", title: "wf")

        Markdown("Interpolated text is live: when `user` changes, the text changes.")
    }
}
