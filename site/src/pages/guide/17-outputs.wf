/// Chapter 17 of the guide, written from md-docs/17-outputs.md by
/// scripts/site-from-guide.py; edit the guide, not this file.
page Outputs(path: "/docs/guide/outputs", title: "Outputs", description: "SPA, static site, PDF documents, slide decks, and rendering templates with data from the CLI, Rust and Node.", layout: DocsShell("Outputs", chapter: "Chapter 17", blurb: "One source, several outputs: a single-page app, a static site, a PDF, a slide deck, or a template rendered with data.", sections: [Anchor(id: "spa", label: "SPA"), Anchor(id: "pdf-documents", label: "PDF documents"), Anchor(id: "slide-decks", label: "Slide decks"), Anchor(id: "templates-rendering-with-data-on-a-server", label: "Templates: rendering with data on a server")], prevTo: "/docs/guide/content", prevLabel: "16. Content", nextTo: "/docs/guide/tooling", nextLabel: "18. Tooling")) {
    Stack(gap: .lg) {
        Markdown("One source, several outputs. `build.output_type` in `webfluent.app.json` chooses what `wf build` writes, and the same file can also be rendered on a server with data.")

        Table(caption: "Outputs") {
            Table.Head {
                Table.Row {
                    Table.Cell("Output").header
                    Table.Cell.header { Markdown("`output_type`") }
                    Table.Cell("Writes").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell("Single-page app")
                    Table.Cell { Markdown("`spa` (default)") }
                    Table.Cell { Markdown("`index.html` + `app.js` + `styles.css`: the router paints pages in the browser") }
                }
                Table.Row {
                    Table.Cell("Static site")
                    Table.Cell { Markdown("`spa` with `build.ssg: true`") }
                    Table.Cell { Markdown("One pre-rendered HTML file per route, hydrated by the same script ([chapter 16](/docs/guide/content#static-builds))") }
                }
                Table.Row {
                    Table.Cell("PDF document")
                    Table.Cell { Markdown("`pdf`") }
                    Table.Cell { Markdown("One `.pdf`") }
                }
                Table.Row {
                    Table.Cell("Slide deck")
                    Table.Cell { Markdown("`slides`") }
                    Table.Cell { Markdown("One `.pdf`, a slide per page") }
                }
                Table.Row {
                    Table.Cell("Server template")
                    Table.Cell("—")
                    Table.Cell { Markdown("HTML or PDF from `wf render` or the library, with JSON data") }
                }
            }
        }

        Heading("SPA", id: "spa").h2

        Markdown("The default: one `index.html` that loads `app.js`, which mounts the `app` and routes between pages in the browser. `build.split` (on by default) writes each page as its own `pages/<Name>.js` and `pages/<Name>.css`, fetched when its route first shows. A host serves `index.html` for every path (the \"SPA fallback\"), or you turn on `ssg` and get real files.\n\n`build.base_path` (`\"/my-site\"` for a GitHub Pages project site) prefixes every asset and route; `build.minify`, `build.sourcemap`, `build.compress` (gzip beside each text file) and `build.csp` (a strict Content-Security-Policy and a `_headers` file) tune the output.")

        Heading("PDF documents", id: "pdf-documents").h2

        CodeBlock("\{\n  \"build\": \{\n    \"output_type\": \"pdf\",\n    \"pdf\": \{\n      \"page_size\": \"A4\",\n      \"margins\": \{ \"top\": 72, \"bottom\": 72, \"left\": 72, \"right\": 72 \},\n      \"default_font\": \"Helvetica\",\n      \"default_font_size\": 12,\n      \"output_filename\": \"report.pdf\"\n    \}\n  \}\n\}", title: "json")

        Markdown("A PDF page holds a `Document` with a body of the document components:")

        CodeBlock("type Line \{ item: String, qty: Number, price: Number \}\n\nconst LINES: [Line] = [\n    Line(item: \"Design\", qty: 12, price: 90),\n    Line(item: \"Build\", qty: 40, price: 110),\n]\n\npage Invoice(path: \"/\", title: \"Invoice\", description: \"An invoice.\") \{\n    derived total = LINES.reduce((sum, l) => sum + l.qty * l.price, 0)\n    Document(page_size: \"A4\") \{\n        Header \{ Text(\"Acme Studio\").muted.sm.right \}\n        Footer \{ Text(\"Page footer — thank you for your business\").muted.sm.center \}\n        Section \{\n            Heading(\"Invoice #2026-014\").h1\n            Text(\"Issued \{format(\"2026-09-01\", .date, \"long\")\}\")\n            Spacer\n            Table \{\n                Table.Head \{\n                    Table.Row \{ Table.Cell(\"Item\")  Table.Cell(\"Qty\")  Table.Cell(\"Price\")  Table.Cell(\"Amount\") \}\n                \}\n                Table.Body \{\n                    for l in LINES \{\n                        Table.Row \{\n                            Table.Cell(l.item)\n                            Table.Cell(\"\{l.qty\}\")\n                            Table.Cell(format(l.price, .currency))\n                            Table.Cell(format(l.qty * l.price, .currency))\n                        \}\n                    \}\n                \}\n            \}\n            Divider\n            Text(\"Total: \{format(total, .currency)\}\").bold.lg\n        \}\n        PageBreak\n        Section \{\n            Heading(\"Terms\").h2\n            Paragraph \{ Text(\"Payment within 30 days.\") \}\n        \}\n    \}\n\}", title: "wf")

        Markdown("- `Document(page_size:)` — `A4`, `A3`, `A5`, `Letter`, `Legal` — is the root; `Header` and `Footer` repeat on every page; `Section` groups with spacing; `Paragraph` is a block of text; `PageBreak` starts a new page.\n- Typography, layout containers, `Table`, `List`, `Badge`, `Card`, `Image`, `Divider`, `Spacer` render; `if` and `for` work over static data (`const`, `data`, literals).\n- Interactive components (`Button`, `Input`, `Form`, `Modal`, …), navigation, handlers, `resource`, `state` that changes, and motion do not belong in a PDF; the PDF validator rejects them before codegen.\n- A `style \{ \}` on a container honours a subset: `background` (colour or a two-stop `linear-gradient`), `padding`, `border`, `border-radius`, `box-shadow`, `width`, `height` in `pt` or `%`. Unknown properties warn once per component and property.\n\n`wf init my-report --template pdf` scaffolds one.")

        Heading("Slide decks", id: "slide-decks").h2

        CodeBlock("\{\n  \"build\": \{\n    \"output_type\": \"slides\",\n    \"slides\": \{\n      \"size\": \"16:9\",\n      \"show_slide_numbers\": true,\n      \"footer_text\": \"Acme — Q4 review\",\n      \"background_color\": \"#FFFFFF\"\n    \}\n  \}\n\}", title: "json")

        CodeBlock("page Deck(path: \"/\", title: \"Q4 review\", description: \"The quarter in slides.\") \{\n    Presentation \{\n        TitleSlide(\"Q4 review\", subtitle: \"Acme Studio, October 2026\")\n        SectionSlide(\"Numbers\").primary\n        Slide \{\n            Heading(\"Revenue\").h2\n            List \{\n                List.Item \{ Text(\"Up 18% on Q3\") \}\n                List.Item \{ Text(\"Three new enterprise accounts\") \}\n                List.Item \{ Text(\"Churn at 1.2%\") \}\n            \}\n        \}\n        TwoColumn \{\n            Container \{\n                Heading(\"What worked\").h3\n                Text(\"Self-serve onboarding.\")\n            \}\n            Container \{\n                Heading(\"What did not\").h3\n                Text(\"The March pricing test.\")\n            \}\n        \}\n        ImageSlide(src: \"chart.png\", caption: \"Monthly recurring revenue\")\n        Slide \{\n            style \{ background: linear-gradient(135deg, #1E3A8A, #0F172A) \}\n            Heading(\"Thank you\").h1\n        \}\n    \}\n\}", title: "wf")

        Markdown("- `Presentation` holds only slides; a slide is one PDF page and never flows onto the next (content past the bottom margin is clipped, with a warning).\n- Kinds: `Slide \{ \}` freeform; `TitleSlide(title, subtitle:)`; `SectionSlide(label).primary/.success/.danger/.warning/.info` full-bleed; `TwoColumn \{ Container \{ \} Container \{ \} \}`; `ImageSlide(src:, caption:)`.\n- `slides.size`: `16:9` (default), `4:3`, `A4-landscape`, or `WIDTHxHEIGHT` in points; `show_slide_numbers`, `footer_text` and `chrome_color` add the chrome (the colour auto-flips on a dark background when unset).\n- Backgrounds: `slides.background_color` deck-wide, a `Slide`'s `style \{ background \}`, a `Container`'s; hex or a two-stop `linear-gradient`.\n- Inside a slide: `Text`, `Heading` (scaled up), `List`, layout containers, `Spacer`, `Divider`, `if`/`for` over literals. Interactive, navigation and media components are rejected.\n\n`wf init my-deck --template slides` scaffolds one.")

        Heading("Templates: rendering with data on a server", id: "templates-rendering-with-data-on-a-server").h2

        Markdown("A `.wf` file can be rendered with JSON data — an invoice, an email, a report — from the CLI or from Rust and Node. The data's top-level keys are in scope by name; the static subset of the language applies (no `state`, handlers, stores, `resource`, motion).")

        CodeBlock("page Invoice(path: \"/\", title: \"Invoice\", description: \"An invoice.\") \{\n    Heading(\"Invoice #\{number\}\").h1\n    Text(\"Bill to: \{customer.name\}\")\n    Table \{\n        Table.Head \{ Table.Row \{ Table.Cell(\"Item\")  Table.Cell(\"Qty\")  Table.Cell(\"Amount\") \} \}\n        Table.Body \{\n            for item in items \{\n                Table.Row \{\n                    Table.Cell(item.name)\n                    Table.Cell(\"\{item.qty\}\")\n                    Table.Cell(format(item.price * item.qty, .currency))\n                \}\n            \}\n        \}\n    \}\n    if paid \{ Badge(\"Paid\").success \} else \{ Badge(\"Due\").warning \}\n    Text(\"Total: \{format(total, .currency)\}\").bold.lg\n\}", title: "wf")

        CodeBlock("\{\n  \"number\": \"INV-001\",\n  \"customer\": \{ \"name\": \"Acme Corp\" \},\n  \"items\": [\{ \"name\": \"Widget\", \"qty\": 5, \"price\": 9.99 \}],\n  \"total\": 49.95,\n  \"paid\": false,\n  \"locale\": \"en\"\n\}", title: "json")

        Markdown("CLI:")

        Terminal(lines: [
                Line(command: "wf render invoice.wf --data invoice.json --format html-fragment")
            ])

        Markdown("`--format` is `html` (a whole document with its CSS), `html-fragment` (the body only), `pdf` or `slides`; `-o file` writes instead of printing; `--theme Name` picks one of several `theme` declarations; the data is read from stdin when `--data` is omitted.\n\nRust:")

        CodeBlock("use webfluent::Template;\nuse serde_json::json;\n\nlet tpl = Template::from_file(\"templates/invoice.wf\")?;\nlet html = tpl.render_html(&json!(\{ \"number\": \"INV-001\", \"items\": [], \"total\": 0, \"paid\": true \}))?;\nlet pdf: Vec<u8> = tpl.render_pdf(&json!(\{ \"number\": \"INV-001\", \"items\": [], \"total\": 0, \"paid\": true \}))?;\nlet themed = tpl.with_theme(\"Night\").with_tokens(&[(\"color-primary\", \"#8B5CF6\")]).render_html(&json!(\{\}))?;", title: "rust")

        Markdown("Node (`npm install @aspect/webfluent`):")

        CodeBlock("const \{ Template \} = require(\"@aspect/webfluent\");\nconst tpl = Template.fromFile(\"templates/invoice.wf\");\nres.send(tpl.renderHtml(invoice));\nres.type(\"application/pdf\").send(tpl.renderPdf(invoice));", title: "js")

        Markdown("A template may declare `type`s and a `theme` like any file; `data` files are read relative to the template. `format` and `ago` speak the data's `locale` when it has one, else English.")
    }
}
