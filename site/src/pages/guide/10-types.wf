/// Chapter 10 of the guide, written from md-docs/10-types.md by
/// scripts/site-from-guide.py; edit the guide, not this file.
page Types(path: "/docs/guide/types", title: "Types", description: "The type language, records and enums, shapes, inference and narrowing, and every check the compiler makes.", layout: DocsShell("Types", chapter: "Chapter 10", blurb: "A gradual, structural type checker that changes no output and names every mistake with a hint.", sections: [Anchor(id: "the-type-language", label: "The type language"), Anchor(id: "the-types-the-language-brings-with-it", label: "The types the language brings with it"), Anchor(id: "records-type", label: "Records: type"), Anchor(id: "enums", label: "Enums"), Anchor(id: "map-literals-are-shapes", label: "Map literals are shapes"), Anchor(id: "where-types-come-from", label: "Where types come from"), Anchor(id: "inference-is-bidirectional", label: "Inference is bidirectional"), Anchor(id: "narrowing-optionals", label: "Narrowing optionals"), Anchor(id: "typing-what-comes-from-the-network", label: "Typing what comes from the network"), Anchor(id: "the-checks", label: "The checks"), Anchor(id: "in-the-editor", label: "In the editor")], prevTo: "/docs/guide/stores", prevLabel: "9. Stores", nextTo: "/docs/guide/expressions", nextLabel: "11. Expressions")) {
    Stack(gap: .lg) {
        Markdown("WebFluent has a gradual, structural type checker. It runs in `wf build` and in the editor, before anything is emitted, and its findings are errors with a hint. A program that declares no types checks as it always did — what the checker cannot resolve is `Any`, and `Any` agrees with everything — and every annotation you add narrows what it can say.")

        Heading("The type language", id: "the-type-language").h2

        Table(caption: "The type language") {
            Table.Head {
                Table.Row {
                    Table.Cell("Type").header
                    Table.Cell("Written").header
                    Table.Cell("Values").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell("String")
                    Table.Cell { Markdown("`String`") }
                    Table.Cell { Markdown("`\"text\"`, `\"with \{interpolation\}\"`") }
                }
                Table.Row {
                    Table.Cell("Number")
                    Table.Cell { Markdown("`Number`") }
                    Table.Cell { Markdown("`42`, `3.14`") }
                }
                Table.Row {
                    Table.Cell("Bool")
                    Table.Cell { Markdown("`Bool`") }
                    Table.Cell { Markdown("`true`, `false`") }
                }
                Table.Row {
                    Table.Cell("List")
                    Table.Cell { Markdown("`[String]`, `[Todo]`") }
                    Table.Cell { Markdown("`[a, b]`") }
                }
                Table.Row {
                    Table.Cell("Map")
                    Table.Cell { Markdown("`Map`") }
                    Table.Cell { Markdown("`\{ key: value \}` — an object with unknown keys") }
                }
                Table.Row {
                    Table.Cell("Optional")
                    Table.Cell { Markdown("`String?`, `Todo?`") }
                    Table.Cell { Markdown("a value or `null`") }
                }
                Table.Row {
                    Table.Cell("Record")
                    Table.Cell { Markdown("the `type`'s name") }
                    Table.Cell { Markdown("`Todo(id: \"a\", title: \"b\")`") }
                }
                Table.Row {
                    Table.Cell("Enum")
                    Table.Cell { Markdown("the `enum`'s name") }
                    Table.Cell { Markdown("`.case`") }
                }
                Table.Row {
                    Table.Cell("Any")
                    Table.Cell { Markdown("`Any`") }
                    Table.Cell("anything; what is not known")
                }
            }
        }

        Markdown("A type is written after a colon on a `state`, a prop, an action parameter, a `type` field, a route parameter, a `let`, or a `resource`.")

        CodeBlock(#"page Typed(path: "/") {
    state name: String = ""
    state count: Number = 0
    state tags: [String] = []
    state picked: String? = null
    state profile: Map = {}
    action greet(who: String, times: Number) { log("hi {who} × {times}") }
    derived pick = picked ?? "none"
    Text("{name} {count} {tags.length} {pick}")
    Button("Go") { on click { greet(name, count) } }
}"#, title: "wf")

        Heading("The types the language brings with it", id: "the-types-the-language-brings-with-it").h2

        Markdown("Eleven more come with the language. Each is a **plain JSON value at run time** — no wrapper object — so it crosses a `fetch`, a `persist`, the static paint and the template engine unchanged; `.native()` hands a real platform object to a library that wants one.")

        Table(caption: "The types the language brings with it") {
            Table.Head {
                Table.Row {
                    Table.Cell("Type").header
                    Table.Cell("Carried by").header
                    Table.Cell("Written as a literal").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`Date`") }
                    Table.Cell { Markdown("`\"2026-03-14\"`") }
                    Table.Cell { Markdown("`@2026-03-14`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`Time`") }
                    Table.Cell { Markdown("`\"09:30\"`") }
                    Table.Cell { Markdown("`@09:30`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`DateTime`") }
                    Table.Cell("ISO 8601")
                    Table.Cell { Markdown("`@2026-03-14T09:30Z`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`Duration`") }
                    Table.Cell("milliseconds")
                    Table.Cell { Markdown("`3.days`, `90.minutes`, `250.ms`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`Money`") }
                    Table.Cell { Markdown("`\{ amount: 1299, currency: \"EUR\" \}`") }
                    Table.Cell { Markdown("`€12.99`, `$9.99`, `£4.50`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`Url`") }
                    Table.Cell("a string")
                    Table.Cell { Markdown("`\"https://example.com\"`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`Email`") }
                    Table.Cell("a string")
                    Table.Cell { Markdown("`\"ada@example.com\"`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`Color`") }
                    Table.Cell("a string")
                    Table.Cell { Markdown("`#0F766E`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`Uuid`") }
                    Table.Cell("a string")
                    Table.Cell { Markdown("`uuid()` makes a fresh one") }
                }
                Table.Row {
                    Table.Cell { Markdown("`File`") }
                    Table.Cell { Markdown("the browser's `File`") }
                    Table.Cell { Markdown("what a `FileUpload` yields") }
                }
                Table.Row {
                    Table.Cell { Markdown("`Secret`") }
                    Table.Cell("a string")
                    Table.Cell("—")
                }
            }
        }

        Markdown("Money is in **minor units** — cents, pence — so the arithmetic is a whole number's and nothing drifts. A duration is milliseconds, so it adds to a moment. `uuid()` is where a `Uuid` comes from: the platform's own generator where there is one, a version-4 layout from the best randomness available where there is not.")

        CodeBlock(#"type Booking {
    id: Uuid
    guest: Email
    from: Date
    nights: Number(1..=30)
    total: Money
}

page Stay(path: "/", title: "Stay", description: "One booking.") {
    state from: Date = @2026-03-14
    state nights: Number = 5
    state total: Money = €249.00

    derived checkout = from.plus(days: nights)
    derived weekday = checkout.weekday()
    derived late = now.date().isAfter(checkout)

    Heading("Your stay").h1
    Text("Out on {checkout}, a weekday of {weekday}")
    Text("Due {format(total)}")
    if late { Alert("Checkout has passed").warning }
}"#, title: "wf")

        Markdown("Everything the language **computes** is a call; everything the carrier **already has** is a field. So `total.amount` and `total.currency` are fields, and `from.year()` and `checkout.weekday()` are calls.")

        Table(caption: "The types the language brings with it") {
            Table.Head {
                Table.Row {
                    Table.Cell("").header
                    Table.Cell("").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`Date` `Time` `DateTime`") }
                    Table.Cell { Markdown("`.year() .month() .day() .weekday() .hour() .minute() .second()`, `.plus(days: 3)` and `.minus(…)` (which take `years months weeks days hours minutes seconds ms`), `.isBefore(d) .isAfter(d) .isSame(d)`, `.until(d)` (a `Duration`), `.startOfDay() .startOfWeek() .startOfMonth() .endOfDay()`, `.native()`; `DateTime` also `.date() .time() .inZone(\"Europe/Berlin\")`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`Duration`") }
                    Table.Cell { Markdown("`.days() .hours() .minutes() .seconds() .ms()`, `.plus(d)`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`Money`") }
                    Table.Cell { Markdown("`.plus(m) .minus(m) .times(n) .convert(rate, \"USD\")`; `format(m)` needs no style and no currency code") }
                }
                Table.Row {
                    Table.Cell { Markdown("`Url`") }
                    Table.Cell { Markdown("`.host() .path() .query()`, `.with(query: \{ page: 2 \})`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`Email`") }
                    Table.Cell { Markdown("`.domain()`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`Color`") }
                    Table.Cell { Markdown("`.mix(other, 0.2) .lighten(0.1) .darken(0.1) .alpha(0.5) .contrast(other)`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`File`") }
                    Table.Cell { Markdown("`.preview()` — an object URL, revoked when the scope that made it leaves") }
                }
            }
        }

        Markdown("Adding a month lands on a day that exists: `@2026-01-31.plus(months: 1)` is the 28th of February, not the 3rd of March. All of it runs at build time too, so the static paint shows the answer rather than a blank that fills in when the page hydrates.")

        Heading("A literal is held to its type", id: "a-literal-is-held-to-its-type").h3

        Markdown("A string written where one of these is wanted is read as one, and checked where it is written:")

        CodeBlock(#"state site: Url = "https://example.com"     // fine
state bad: Url = "example"                  // T01: A URL has a scheme"#, title: "wf")

        Heading("now", id: "now").h3

        Markdown("`now` is a `DateTime` that keeps itself current — every minute by default, or as often as a page asks:")

        CodeBlock(#"page Feed(path: "/", title: "Feed", description: "What just happened.") {
    state posted: DateTime = @2026-03-14T09:30:00Z
    derived age = posted.until(now)
    Text("{ago(posted)} — {age.minutes()} minutes")
    Text("ticking: {now(every: 1.seconds)}")
}"#, title: "wf")

        Heading("A condition on a type", id: "a-condition-on-a-type").h3

        Markdown("Any type may say what its values must be, and every value the compiler can read is held to it:")

        CodeBlock(#"state nights: Number(1..=30) = 12
state pass: String(minLength: 8) = "correcthorse"
state start: Date(after: @2026-01-01) = @2026-03-14"#, title: "wf")

        Markdown("`min`, `max`, `minLength`, `maxLength`, `pattern`, `after`, `before`, and a range (`1..=30` inclusive, `0..10` exclusive of the end) for the two ends. A value that arrives at run time is validation's to refuse, from the same condition.")

        Heading("Secret is not a string", id: "secret-is-not-a-string").h3

        Markdown("A `Secret` is a string the compiler will not let escape. Each of these is a `T12`:")

        CodeBlock(#"state token: Secret = ""
Text(token)                     // shown
Text("Bearer {token}")          // in text — which is how it ends up in a URL
persist token: Secret = ""      // kept in the browser
log(token)                      // in the console, and often in a log service"#, title: "wf")

        Markdown("Hold it in `state`, which the visit ends; what must outlive the visit belongs on the server.")

        Heading("Your own name wins", id: "your-own-name-wins").h3

        Markdown("A `type` the program declares takes the name back. A project with its own `type Color \{ name: String \}` means that one everywhere.")

        Heading("Records: type", id: "records-type").h2

        CodeBlock(#"enum Tone { neutral, info, danger }

type Todo {
    id: String
    title: String
    done: Bool = false
    tone: Tone = .neutral
    note: String?
}

type Admin = Todo { owner: String }

page Records(path: "/") {
    state todos: [Todo] = [
        Todo(id: "1", title: "Write the docs"),
        Todo(id: "2", title: "Ship", done: true, tone: .info, note: "Friday"),
    ]
    state special: Admin = Admin(id: "3", title: "Review", owner: "sam")
    for t in todos by t.id {
        Row(gap: .sm) {
            Text(t.title)
            if let n = t.note { Badge(n).info }
        }
    }
    Text("{special.owner} owns {special.title}")
}"#, title: "wf")

        Markdown("- Fields may be separated by newlines or commas.\n- A field with a default may be left out of a construction; a `T?` field defaults to `null`.\n- `type Admin = Todo \{ owner: String \}` extends a record: an `Admin` has every field of `Todo` and then its own.\n- Records are structural: `\{ id: \"a\", title: \"b\" \}` given where a `Todo` is wanted is a `Todo`, and its fields are checked against the record's.\n- A `Map` fits any record and a record fits a `Map`: JSON from `fetch` fits a `type` it was never declared as.")

        Heading("Enums", id: "enums").h2

        CodeBlock(#"enum Size { sm, md, lg }
enum Status { idle, running(job: String), failed(reason: String), done(count: Number) }

page Enums(path: "/") {
    state size: Size = .md
    state s: Status = .idle
    Button("Bigger") { on click { size = .lg } }
    Button("Start") { on click { s = .running("build-42") } }
    Text(match size { .sm { "small" } .md { "medium" } else { "large" } })
    match s {
        .running(job) { Text("Running {job}") }
        .failed(reason) { Alert(reason).danger }
        .done(n) { Text("{n} done") }
        else { Text("Idle") }
    }
}"#, title: "wf")

        Markdown("- A case is written `.name`; on its own it is a case of an enum not yet known, and where a `Size` is wanted it becomes a `Size` — `.huge` is `T02`.\n- A case may carry a payload: `.failed(\"x\")` is checked like a call, and a `match` arm binds it: `.failed(r)` gives `r: String`.\n- `size == .lg` compares cases; an enum is written to a component's root as `data-<prop>` ([chapter 8](/docs/guide/components#enum-props)).")

        Heading("Map literals are shapes", id: "map-literals-are-shapes").h2

        Markdown("A map literal has the fields it was written with: `\{ name: \"\", age: 0 \}` is `\{ name: String, age: Number \}`, and reading `form.nam` is `T05` with the fields it does have. A shape fits a `Map`, a record with the same fields, and any shape it agrees with. `\{\}` and a literal with a spread are plain `Map`s.")

        CodeBlock(#"page Shapes(path: "/") {
    state form = { name: "", age: 0, tags: ["new"] }
    Input(bind: form.name, label: "Name")
    Text("{form.name} is {form.age} with {form.tags.length} tags")
}"#, title: "wf")

        Heading("Where types come from", id: "where-types-come-from").h2

        Markdown("**Declared** — annotations, a `type`'s fields, an `enum`'s cases, a page's route parameters, an event's parameters, a component's props.\n\n**Inferred** — a literal; a list of literals (`[1, 2]` is `[Number]`, `[]` is `[Any]`); a record construction; a `derived` from its expression; a `state` from its initial value (one that starts as `null` is `Any?`); a `for` binding from the list's element type; a `match` arm's binding; an `if let` binding; a lambda's parameters from what the method expects (`items.filter(t => …)` gives `t` the item type).\n\n**From the registry** — the type of every built-in prop; what a `bind:` needs (`Checkbox` and `Switch` a `Bool`, `Slider` a `Number`, `Input` a `String` or a `Number` by its type).\n\n**From the method tables** — on a `String`: `trim`, `toLowerCase`, `toUpperCase`, `replace`, `slice`, `padStart`, `repeat`, `capitalize`, `truncate(n)` → `String`; `length`, `indexOf` → `Number`; `includes`, `startsWith`, `endsWith` → `Bool`; `split` → `[String]`. On a list: `map` → `[U]` from the lambda; `filter`, `slice`, `concat`, `sort`, `sortBy`, `unique`, `take`, `flatMap` → `[T]`; `find`, `first`, `last` → `T?`; `some`, `every`, `includes` → `Bool`; `length`, `sum`, `indexOf`, `findIndex` → `Number`; `join` → `String`; `groupBy` → `Map`; `reduce` → the initial value's type. On a `Number`: `toFixed`, `toString` → `String`. Anything else is `Any`.\n\n**From stores** — `Todos.items` has the type of the store's state, `Todos.add` the signature of its action.\n\nBrowser globals (`window`, `document`, `JSON`, `Math`, `Date`, …) are `Any`.")

        Heading("Inference is bidirectional", id: "inference-is-bidirectional").h2

        Markdown("An expression is checked against the type its context wants when there is one, and its type is read off it otherwise:")

        CodeBlock(#"type Row { id: Number, label: String, score: Number? }

page Infer(path: "/") {
    state rows: [Row] = [Row(id: 1, label: "a"), Row(id: 2, label: "b", score: 9)]
    derived labels = rows.map(r => r.label)                 // [String]
    derived best = rows.find(r => r.score != null)          // Row?
    derived total = rows.reduce((n, r) => n + (r.score ?? 0), 0)   // Number
    derived kind = if total > 5 { "high" } else { "low" }   // String
    derived firstScore = best?.score ?? 0                   // Number
    derived joined = labels.join(", ")                      // String
    Text("{joined} {kind} {firstScore}")
}"#, title: "wf")

        Markdown("- `a ?? b` is `a` without its `null`, joined with `b`.\n- `a?.b` is `b`'s type made optional, and the rest of the chain with it.\n- `if`/`match` as values have the type both arms fit: the same type, `T?` when one arm is `null`, else `Any`.\n- `-`, `*`, `/`, `%` are `Number`; `+` is a `String` when either side is one; comparisons and `&&`, `||`, `!` are `Bool`.\n- `await e` on a `fetch` is `Any` unless annotated: `let r: [Row] = await fetch(…)`.\n- `let \{ a, b \} = m` and `let [x, y] = l` bind the fields and items.")

        Heading("Narrowing optionals", id: "narrowing-optionals").h2

        Markdown("A `T?` must be unwrapped before a field or method is read off it (`T04`). Each of these proves a name non-null within its branch:")

        CodeBlock(#"type Todo { id: String, title: String, note: String? }

page Narrow(path: "/") {
    state sel: Todo? = null
    state t: Todo = Todo(id: "1", title: "x")
    if let n = t.note { Text("{n.length} chars") }
    if sel != null { Text(sel.title) }
    if sel { Text(sel.title) }
    derived label = if sel != null { sel.title } else { "none" }
    Text(t.note ?? "no note")
    Text(sel?.title ?? "nothing selected")
    Button("Pick") { on click { sel = t } }
}"#, title: "wf")

        Markdown("Narrowing is flow-sensitive within a block: it holds in the branch the condition guards, not after it.")

        Heading("Typing what comes from the network", id: "typing-what-comes-from-the-network").h2

        Markdown("`fetch` returns `Any`. Annotate the resource or the local to type its value:")

        CodeBlock(#"type Deploy { id: String, status: String, startedAt: String }

page Deploys(path: "/") {
    resource deploys: [Deploy] = fetch("/api/deploys")
    match deploys {
        loading { Spinner }
        error(e) { Alert("Failed: {e.message}").danger }
        ready(rows) {
            for d in rows by d.id { Text("{d.id} {d.status} {ago(d.startedAt)}") }
        }
    }
}"#, title: "wf")

        Markdown("The checker trusts the annotation; it does not read the server's schema.")

        Heading("The checks", id: "the-checks").h2

        Table(caption: "The checks") {
            Table.Head {
                Table.Row {
                    Table.Cell("Code").header
                    Table.Cell("When").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`T01`") }
                    Table.Cell { Markdown("A value of the wrong type given to a prop, a state, a field, a parameter, an assignment, an argument, or a `bind:`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`T02`") }
                    Table.Cell("A case the enum does not have")
                }
                Table.Row {
                    Table.Cell { Markdown("`T04`") }
                    Table.Cell { Markdown("A field or method read off a value that may be `null`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`T05`") }
                    Table.Cell("A field or method a record or shape does not have")
                }
                Table.Row {
                    Table.Cell { Markdown("`T06`") }
                    Table.Cell("A member or action a store does not have")
                }
                Table.Row {
                    Table.Cell { Markdown("`T07`") }
                    Table.Cell("A list, a record or an action used as a condition, which is always true")
                }
                Table.Row {
                    Table.Cell { Markdown("`T08`") }
                    Table.Cell { Markdown("A `for` over something that is not a list") }
                }
                Table.Row {
                    Table.Cell { Markdown("`T09`") }
                    Table.Cell { Markdown("An `emit` whose arguments do not match the event's") }
                }
                Table.Row {
                    Table.Cell { Markdown("`T10`") }
                    Table.Cell("A call with the wrong number of arguments")
                }
                Table.Row {
                    Table.Cell { Markdown("`T11`") }
                    Table.Cell { Markdown("A `match` on something that is neither a resource nor an enum, or an arm the value cannot take") }
                }
                Table.Row {
                    Table.Cell { Markdown("`T12`") }
                    Table.Cell { Markdown("A `Secret` where it would escape — shown, spliced into text, logged, or kept with `persist`") }
                }
            }
        }

        Markdown("Each comes with a hint: a conversion (`Number(value)`, `\"\{value\}\"`), the cases an enum takes, the fields a record has, the unwrapping forms above.\n\nWhat the checker does not do: it does not check a lambda's body against a return type, does not change a name's type across assignments (`state x = 1` stays a `Number`; assigning a string to it is `T01`), and does not read the schema of a `fetch`.")

        Heading("In the editor", id: "in-the-editor").h2

        Markdown("Hover shows a name's inferred type (`state draft: String`, `derived remaining: Number`, `Todos.add: action(String)`); completion after `.` offers a record's fields, an enum's cases where one is wanted, and the methods of a `String`, a `Number` or a list. A type error is a diagnostic at the argument it belongs to. [Chapter 18](/docs/guide/tooling#editors) sets it up.")
    }
}
