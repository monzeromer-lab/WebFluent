                    Table.Cell { Markdown("[State](/docs/guide/state#derived)") }
                }
                Table.Row {
                    Table.Cell { Markdown("`useEffect`, `watchEffect`, `$effect`") }
                    Table.Cell { Markdown("`effect \{ … cleanup \{ … \} \}`") }
                    Table.Cell { Markdown("[State](/docs/guide/state#effect)") }
                }
                Table.Row {
                    Table.Cell { Markdown("`useRef` on an element") }
                    Table.Cell { Markdown("`Input(ref: box)`, then `box.focus()`") }
                    Table.Cell { Markdown("[State](/docs/guide/state#element-handles)") }
                }
