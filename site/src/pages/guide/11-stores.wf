/// Chapter 11 of the guide, written from md-docs/learn/11-stores.md by
/// scripts/docsite/guide.py; edit the guide, not this file.
page Learn11Stores(path: "/learn/11-stores", title: "Stores", description: "Stores: declaration, scopes, use, actions, persist and migrations, connections, loading data, debugging, testing, and when to use one.", layout: DocsShell("Stores", kind: .tutorial, chapter: t("nav.group.language"), blurb: "A store is state shared by every page and component that uses it, built the first time something reads it.", source: "md-docs/learn/11-stores.md", sections: [Anchor(id: "a-first-store", label: "A first store"), Anchor(id: "store-members", label: "Store members"), Anchor(id: "store-scope", label: "Store scope"), Anchor(id: "actions", label: "Actions"), Anchor(id: "keeping-a-value-across-visits", label: "Keeping a value across visits"), Anchor(id: "a-connection-a-store-holds", label: "A connection a store holds"), Anchor(id: "loading-data-into-a-store", label: "Loading data into a store"), Anchor(id: "stores-in-the-pre-rendered-page", label: "Stores in the pre-rendered page"), Anchor(id: "looking-at-one-while-it-runs", label: "Looking at one while it runs"), Anchor(id: "testing-a-store", label: "Testing a store"), Anchor(id: "when-to-use-a-store", label: "When to use a store"), Anchor(id: "quick-reference", label: "Quick reference"), Anchor(id: "quiz", label: "Quiz"), Anchor(id: "common-mistakes", label: "Common mistakes")], learned: ["Declare a store and read it from any page as `Store.member`", "Choose how long a store lives with `scope:`", "Change a store through its actions, async ones included", "Keep a value across visits with `persist`, and migrate its shape", "Decide between a store and a page's own `state`"], prevTo: "/learn/10-components", prevLabel: t("ch.10"), nextTo: "/learn/12-types", nextLabel: t("ch.12"))) {
    Stack(gap: .lg) {
        Markdown("This chapter covers *stores*. A store holds state that more than one page or component shares: the cart, the signed-in user, the theme, a cache of what was fetched. It holds `state`, `derived` values and actions, and every page that reads it sees the same values.\n\nThe one thing to remember: **a store is built the first time something reads it.** Declaring a store does nothing. The first `Cart.items`, `Cart.count` or `Cart.add(…)` builds it, and every later read uses that same instance. As a result, the order you declare stores in does not matter — a `derived` value may read a store declared below it — and a store nothing reads costs nothing, in time or in bytes.\n\n**In this chapter**\n\n- Declaring a store and reading it from pages\n- How long a store lives: its scope\n- Actions, including async actions\n- Keeping a value across visits with `persist`, and changing its shape later\n- Connections and data a store owns\n- Inspecting and testing a store\n- When to use a store, and when a page's own state")

        Heading("A first store", id: "a-first-store").h2

        Markdown("This program declares a `Cart` store and reads it from two pages:")

        CodeBlock(#"type Item { id: String, name: String, price: Number, qty: Number = 1 }

store Cart {
    state items: [Item] = []
    derived count = items.length
    derived total = items.reduce((sum, i) => sum + i.price * i.qty, 0)
    action add(item: Item) { items.push(item) }
    action remove(id: String) { items = items.filter(i => i.id != id) }
}

page Shop(path: "/", title: "Shop", description: "Things to buy.") {
    use Cart
    Button("Add a pen").primary { on click { Cart.add(Item(id: "pen", name: "Pen", price: 2.5)) } }
    Text("{Cart.count} items, {format(Cart.total, .currency)}")
}

page CartPage(path: "/cart", title: "Cart", description: "What you are buying.") {
    use Cart
    for item in Cart.items by item.id {
        Row(justify: .between) {
            Text("{item.name} × {item.qty}")
            Button("Remove").sm { on click { Cart.remove(item.id) } }
        }
    }
    if Cart.count == 0 { Text("Your cart is empty.").muted }
}"#, title: "wf")

        Markdown("Clicking **Add a pen** changes **0 items, $0.00** to **1 items, $2.50**, and the `/cart` page lists the pen.\n\n- `store Cart \{ … \}` declares the store and its members.\n- `use Cart` in a page says the page reads the store. The page then reads members as `Cart.items` and `Cart.count`, and calls actions as `Cart.add(…)`.\n- Everything that reads `Cart.count`, on any page, updates when it changes.\n\nThe checker knows every member and its type. `Cart.cont` is an error (`T06`, with the nearest member it does have), and `Cart.add(\"pen\")` is an error because `add` takes an `Item` (`T01`).")

        Callout("**Coming from React?** There is no context provider to wrap the tree in, and no selector to write. Declare the store once and read `Cart.count` anywhere; only what reads `count` updates when it changes. See [Coming from React](/coming-from/react).", kind: .note)

        Heading("Store members", id: "store-members").h2

        Markdown("A store holds the same members a page does: `state`, `persist`, `derived` values and actions. This fuller `Cart` adds a coupon kept across visits and an action that raises the quantity of an item already in the cart:")

        CodeBlock(#"type Item { id: String, name: String, price: Number, qty: Number = 1 }

store Cart {
    state items: [Item] = []
    persist coupon = ""

    derived count = items.reduce((n, i) => n + i.qty, 0)
    derived subtotal = items.reduce((sum, i) => sum + i.price * i.qty, 0)
    derived discount = if coupon == "SAVE10" { subtotal * 0.1 } else { 0 }
    derived total = subtotal - discount

    action add(item: Item) {
        if items.some(i => i.id == item.id) {
            items = items.map(i => if i.id == item.id { { ...i, qty: i.qty + 1 } } else { i })
        } else {
            items.push(item)
        }
    }
    action remove(id: String) { items = items.filter(i => i.id != id) }
    action clear() { items = [] }
}"#, title: "wf")

        Markdown("`add` changes `items` itself: it assigns a new list with that one item's quantity raised. Writing `let found = items.find(…)` and then `found.qty = found.qty + 1` would change only the local copy that `let` made ([chapter 7](/learn/07-state-and-reactivity#actions-and-locals)), and the cart would stay as it was.\n\nInside the store you read its members by their bare names: `items`, `count`. Outside it, a page or component reads them through the store's name: `Cart.items`, `Cart.count`.")

        Callout("**Coming from Vue or Svelte?** `use Cart` is not Pinia's `useCartStore()` and makes no copy; there is no `$cart` prefix either. Every reader gets the one instance, by the store's name. See [Coming from Vue](/coming-from/vue) and [Coming from Svelte](/coming-from/svelte).", kind: .note)

        Markdown("You may declare a store in any `.wf` file the build reads. By convention it goes in `src/stores/`, and `wf generate store Cart` writes it there. A page reaches a store by name from anywhere. `use` says which stores a page reads, for the person reading the code and for the editor; it does not limit what the page can reach.")

        Heading("Store scope", id: "store-scope").h2

        Markdown("A store's *scope* says how long it lives. You set it in the declaration; these three stores live for the page, the tab and the route:")

        CodeBlock(#"store Cart(scope: .app) { state items: [String] = [] }        // the default: as long as the page is open
store Session(scope: .session) { state step = 1 }             // this tab's
store Filters(scope: .route) { state search = "" }            // this route's"#, title: "wf")

        Table(caption: "Store scope") {
            Table.Head {
                Table.Row {
                    Table.Cell("Scope").header
                    Table.Cell("Lives").header
                    Table.Cell("Use it for").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`.app` (the default)") }
                    Table.Cell("as long as the page is open")
                    Table.Cell("the cart, the signed-in user")
                }
                Table.Row {
                    Table.Cell { Markdown("`.session`") }
                    Table.Cell("as long as the tab; what it keeps goes in the tab's own storage, gone when the tab is")
                    Table.Cell("state for one tab")
                }
                Table.Row {
                    Table.Cell { Markdown("`.route`") }
                    Table.Cell("until the route changes")
                    Table.Cell("the filters on a list, a wizard's step")
                }
            }
        }

        Markdown("When the route changes, a `.route` store drops what it holds. The next read builds it again from its initial values.\n\n`store X(eager: true)` builds the store at boot instead of on first read. Use it for the rare store whose set-up must run whether or not a page reads it. If a `derived` value of yours has a side effect that used to run when the page loaded, `eager: true` keeps it running then.")

        Heading("Actions", id: "actions").h2

        Markdown("A store's actions are its interface: pages change the store by calling them. An action may be asynchronous — it uses `await` — and an async action exposes `pending`, which is `true` while a call of it runs:")

        CodeBlock(#"store Session {
    state user: Map? = null
    state error = ""
    derived loggedIn = user != null

    action login(email: String, password: String) {
        error = ""
        try {
            let r = await fetch("/api/login", { method: "POST", body: { email: email, password: password } })
            user = r.user
        } catch e {
            error = "Could not sign in: {e.message}"
        }
    }

    action logout() {
        user = null
        navigate("/")
    }
}

page Login(path: "/login", title: "Sign in", description: "Sign in.") {
    use Session
    state email = ""
    state password = ""
    Form {
        on submit { Session.login(email, password) }
        Input(bind: email, label: "Email").email.required
        Input(bind: password, label: "Password").password.required
        Button("Sign in", type: .submit, disabled: Session.login.pending).primary
    }
    if Session.error != "" { Alert(Session.error).danger }
}"#, title: "wf")

        Markdown("The **Sign in** button is disabled while `Session.login` runs.\n\nInside an action, a bare name is the store's own member — `items`, `error` — unless something nearer declares it. A `let`, a parameter, a `for` binding, a lambda's parameter or a caught error belongs to the action until its block ends. So `let items = …` in an action reads and writes that local variable and leaves the store's `items` alone.\n\nAn action may read other stores through their names. Stores are global, so a store needs no `use`. A `derived` value may call one of the store's own actions to compute a value, but not one that assigns state: that is `X04`, because the derived value would change state every time it is read.")

        Heading("Keeping a value across visits", id: "keeping-a-value-across-visits").h2

        Markdown("`persist` declares a member whose value is kept in the browser's storage and read back on the next visit. It is stored under the store's name and the member's name, so a page and a store may each persist a `theme`. `persist` works the same way at the top of a page or a component.")

        CodeBlock(#"store Prefs {
    persist scheme = "system"
    persist density = "comfortable"
    persist recent: [String] = []
    action visited(path: String) {
        recent = [path, ...recent.filter(p => p != path)].take(5)
    }
}"#, title: "wf")

        Markdown("By default the value goes in `localStorage`, and **a write in another tab of the same site arrives in this one**. `localStorage` is shared between tabs, and two tabs that disagree about the theme would be a bug.")

        Heading("Options", id: "options").h3

        Markdown("A block after the declaration changes where and how the value is kept:")

        CodeBlock(#"type Item { id: String, qty: Number = 1 }

store Cart {
    persist items: [Item] = [] {
        in: .local          // .local (default, across visits) · .session (this tab) · .app (the project's own)
        version: 2          // the version of the shape this build writes
        sync: false         // don't take what another tab wrote
        migrate 1 -> 2 { old.map(i => Item(id: i.id, qty: i.count)) }
    }
}"#, title: "wf")

        Table(caption: "Options") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`in:`") }
                    Table.Cell { Markdown("Where the value lives: `.local` (the default, kept across visits), `.session` (this tab), or `.app` (see [Storage the project provides](#storage-the-project-provides))") }
                }
                Table.Row {
                    Table.Cell { Markdown("`version:`") }
                    Table.Cell("The version of the value's shape that this build writes")
                }
                Table.Row {
                    Table.Cell { Markdown("`sync:`") }
                    Table.Cell { Markdown("`false` stops this page taking a value another tab or window wrote") }
                }
                Table.Row {
                    Table.Cell { Markdown("`key:`") }
                    Table.Cell { Markdown("Keeps one stored value per key (see [One stored value per instance](#one-stored-value-per-instance))") }
                }
                Table.Row {
                    Table.Cell { Markdown("`migrate n -> m \{ … \}`") }
                    Table.Cell { Markdown("Brings a value written at version `n` forward to `m`") }
                }
            }
        }

        Heading("Versions and migrations", id: "versions-and-migrations").h3

        Markdown("A version is a promise to returning readers. Once you declare a shape with `version:`, the page brings a value written by an older build forward one step at a time. Each `migrate n -> n+1` step reads the old value as `old` and returns the new one. A reader who last visited two deploys ago keeps their cart instead of finding it empty.\n\nThe build checks the chain:\n\n- A gap in the chain is a `P01` warning: an older value would be discarded.\n- A step above the declared version is a `P02` warning: it never runs.\n- A value written by a *newer* build is left alone, and the page uses the initial value. This build cannot know what a later shape means.\n\nThe build also remembers the shape of every persisted value, in `.wf-cache/persist.json`. When a shape changes and `version:` was not raised, it warns (`D04`): a returning reader's browser still holds the old shape, which the page would read as the new one.")

        Callout("A `persist` inside a `store(scope: .route)` does not reset with the route. The route change drops the store, and the next read builds it again — from storage, so the value comes straight back. The build reports this as `P03`. Use `state` for what the route owns, and a wider scope for what outlives it.", kind: .warning)

        Heading("One stored value per instance", id: "one-stored-value-per-instance").h3

        Markdown("A `persist` in a component uses one stored value for every place the component is drawn. Three `Panel`s that each persist `open` share one value, so opening one opens them all. `key:` names what tells the instances apart, and each key gets its own stored value:")

        CodeBlock(#"component Panel(_ title: String) {
    persist open = false { key: title }
    Button(title) { on click { open = !open } }
    if open { children }
}"#, title: "wf")

        Markdown("The build warns (`D03`) about a component that persists a value with no `key:` and is placed more than once, or in a loop.")

        Heading("A key that follows state", id: "a-key-that-follows-state").h3

        Markdown("`key:` is read as state. When what it reads changes, the member takes the value kept under the new key, and writes go there. A desktop app keeps its layout per project this way. A store's key may read the store itself, or another store:")

        CodeBlock(#"store Layout {
    state project = "halyard"
    persist side = 240 {
        key: project
        in: .app
    }
}"#, title: "wf")

        Heading("Storage the project provides", id: "storage-the-project-provides").h3

        Markdown("`in: .app` keeps the value somewhere other than the browser's two storages: a desktop app's store reached through its native bridge, or an extension's storage. It reads `window.wfStorage.app`, which a script of the project's under `src/` defines. The object has this shape: `\{ get(name), set(name, text), remove?(name), watch?(name, fn) \}`.\n\n- `get` answers at once or with a promise, so an IPC call is fine. Until it answers, the value is its declared initial value. A write made before the answer is not undone by it, and an answer for a key that has since changed is ignored.\n- `set` receives the JSON text to keep.\n- `watch(name, fn)`, when present, hears another writer, such as another window, and returns a function that stops it. `sync: false` turns it off.\n\nIf no `window.wfStorage.app` is defined, the value is kept in `localStorage`, and `wf serve` says so on the console.\n\nThis script connects `.app` to Tauri's IPC:")

        CodeBlock(#"// src/app-store.js — Tauri's IPC, reached when a value is read or written
const call = (command, args) => window.__TAURI__.core.invoke(command, args);
window.wfStorage = {
  app: {
    get: (name) => call("store_get", { name }),
    set: (name, text) => call("store_set", { name, text }),
  },
};"#, title: "js")

        Markdown("See [Desktop apps](/recipes) for the rest of a desktop project.")

        Heading("Secrets are never persisted", id: "secrets-are-never-persisted").h3

        Markdown("`persist token: Secret = \"\"` is an error (`T12`). The point of the `Secret` type is that its value never reaches a place any script can read, and the browser's storage is such a place. Keep a session in an httpOnly cookie instead (see [Security](/about/security)).")

        Heading("A connection a store holds", id: "a-connection-a-store-holds").h2

        Markdown("A store may hold a connection — a `socket`, a `stream`, a `channel`, a `peer` or a `worker` (see [Real-time](/recipes)) — for every page at once. The connection opens when the store is first read and closes with the store; a `.route` store's connection closes when its route leaves. The store's actions and handlers name the connection as it is declared, and a page reads it through the store:")

        CodeBlock(#"store Live {
    state last = ""
    socket feed = ws("wss://example.com/feed") {
        on message(m) { last = m.text }
    }
    action say(text: String) { feed.send({ text: text }) }
}

page Feed(path: "/", title: "Feed", description: "One line for every page.") {
    Heading("Feed").h1
    match Live.feed {
        open { Text(Live.last) }
        else { Text("Reconnecting…") }
    }
    Button("Wave") { on click { Live.say("hello") } }
}"#, title: "wf")

        Heading("Loading data into a store", id: "loading-data-into-a-store").h2

        Markdown("A store can own a `resource` (see [Data and APIs](/learn/15-data)). It is asked for the first time something reads the store, and lives as long as the store does — not as long as the page that happened to read it first — so another page that reads the store finds what has already arrived, and nothing is asked for again. It is abandoned with the store: a `.route` store's when its route leaves, to be asked for afresh when the route comes back.\n\nInside the store it is `rows`, anywhere else `Deploys.rows`, and its `state`, `data`, `error`, `refreshing` and `pending` follow it in both. Its address and options read the store's own state, so an action that moves one asks again:")

        CodeBlock(#"type Deploy { id: String, status: String }

store Deploys {
    state page = 1
    resource rows: [Deploy] = fetch("/api/deploys?page={page}")
    derived failing = (rows.data ?? []).filter(d => d.status == "failed").length
    action next() { page = page + 1 }
    action refresh() { rows.reload() }
}

page DeploysPage(path: "/deploys", title: "Deploys", description: "Every deploy.") {
    Heading("Deploys").h1
    Text("{Deploys.failing} failing")
    match Deploys.rows {
        loading { Spinner() }
        error(e) { Text(e.message) }
        ready(rows) {
            for d in rows by d.id { Text("{d.id}: {d.status}") }
        }
    }
    Button("Refresh", disabled: Deploys.rows.pending) { on click { Deploys.refresh() } }
    Button("Next page") { on click { Deploys.next() } }
}"#, title: "wf")

        Markdown("A resource over a service's endpoint is owned the same way — `resource list = Catalog.items(page: page, paginate: .page)` — and its `loadMore()` moves the store's `page`. The resource is the store's to replace: `Deploys.rows = …` is an `X01`, as it is inside the store.\n\nWhen an action decides what is kept — a reply merged into rows already held, a list built from several calls — fill the store's state from a `fetch` instead, and call the action where the data is first wanted:")

        CodeBlock(#"store Feed {
    state items: [Map] = []
    action more() {
        let r = await fetch("/api/feed?after={items.length}")
        items = [...items, ...r.items]
    }
}"#, title: "wf")

        Heading("Stores in the pre-rendered page", id: "stores-in-the-pre-rendered-page").h2

        Markdown("A static build pre-renders each page to HTML — the *static paint*. The static paint seeds each store's state from its initial values, so `Cart.count` is painted as `0`, and a store seeded with rows paints the rows. A value an action changes at run time is corrected once the page is live.")

        Heading("Looking at one while it runs", id: "looking-at-one-while-it-runs").h2

        Markdown("`wf serve` puts a **stores** button in the corner of the page. It opens on what every store that has been built is holding, and a log of every action that has run: the arguments it was given, and the state before and after it. Clicking an entry puts the store back to what it held before that action, which is usually enough to find a bug.\n\nThe same tools are on `window.WF`, for a console or a script:")

        Table(caption: "Looking at one while it runs") {
            Table.Head {
                Table.Row {
                    Table.Cell("Call").header
                    Table.Cell("What it does").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`WF.storeSnapshot()`") }
                    Table.Cell("Returns what every built store holds")
                }
                Table.Row {
                    Table.Cell { Markdown("`WF.storeSnapshot(\"Cart\")`") }
                    Table.Cell("Returns what one store holds")
                }
                Table.Row {
                    Table.Cell { Markdown("`WF.restoreStore(\"Cart\", values)`") }
                    Table.Cell { Markdown("Puts a store back to `values`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`WF.watchStores(fn)`") }
                    Table.Cell { Markdown("Calls `fn` for every action, and returns the function that stops it") }
                }
            }
        }

        Markdown("Nothing is recorded while nothing is watching, so a deployed site pays nothing for any of it. See [Runtime API](/reference/runtime).")

        Heading("Testing a store", id: "testing-a-store").h2

        Markdown("`wf test` renders a test with the project's stores at hand, and a test's `data` seeds a store by its name. This test seeds a cart with two of one item and reads what `CartSummary` shows:")

        CodeBlock(#"type Item { id: String, qty: Number = 1 }

store Cart {
    state items: [Item] = []
    derived count = items.map(i => i.qty).sum()
}

component CartSummary() {
    use Cart
    Text("{Cart.count} items")
}

test "the cart shows what is in it"(data: { Cart: { items: [{ id: "a", qty: 2 }] } }) {
    CartSummary()
    expect "2 items"
}"#, title: "wf")

        Markdown("In a project the store and the component live under `src/` and the test under `tests/`.\n\nA test that clicks a button runs the store's actions in a real browser. See [Testing](/learn/16-testing).")

        Heading("When to use a store", id: "when-to-use-a-store").h2

        Markdown("Put a value where the code that reads it can reach it, and no wider:")

        Table(caption: "When to use a store") {
            Table.Head {
                Table.Row {
                    Table.Cell("The value is…").header
                    Table.Cell("Keep it in").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell("read by more than one page, or must outlive a navigation")
                    Table.Cell("a store")
                }
                Table.Row {
                    Table.Cell("owned by one screen, and should go when the screen does")
                    Table.Cell { Markdown("`store X(scope: .route)`") }
                }
                Table.Row {
                    Table.Cell("read by one page and its components")
                    Table.Cell { Markdown("the page's `state`, passed down as props") }
                }
                Table.Row {
                    Table.Cell("read by one component")
                    Table.Cell { Markdown("the component's own `state`") }
                }
            }
        }

        Heading("Quick reference", id: "quick-reference").h2

        Table(caption: "Quick reference") {
            Table.Head {
                Table.Row {
                    Table.Cell("Syntax").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`store Name \{ … \}`") }
                    Table.Cell("Declare a store, built on first read")
                }
                Table.Row {
                    Table.Cell { Markdown("`store Name(scope: .route)`") }
                    Table.Cell { Markdown("How long it lives: `.app` (the default), `.session` or `.route`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`store Name(eager: true)`") }
                    Table.Cell("Build it at boot")
                }
                Table.Row {
                    Table.Cell { Markdown("`use Name`") }
                    Table.Cell("Say a page or component reads it")
                }
                Table.Row {
                    Table.Cell { Markdown("`Name.member` · `Name.action(…)`") }
                    Table.Cell("Read a member, call an action")
                }
                Table.Row {
                    Table.Cell { Markdown("`Name.action.pending`") }
                    Table.Cell { Markdown("`true` while an async action runs") }
                }
                Table.Row {
                    Table.Cell { Markdown("`persist x = v`") }
                    Table.Cell("Keep a member across visits")
                }
                Table.Row {
                    Table.Cell { Markdown("`persist x = v \{ in: …, version: n, sync: false, key: k \}`") }
                    Table.Cell("Where and how it is kept")
                }
                Table.Row {
                    Table.Cell { Markdown("`migrate n -> m \{ … old … \}`") }
                    Table.Cell("Bring an older stored value forward")
                }
            }
        }

        Heading("Quiz", id: "quiz").h2

        Quiz("A program declares a `Cart` store, and nothing has read it yet. When is the store built?", id: "Stores#13", choices: [
            QuizChoice(text: "When the app boots", right: false, why: "Only `store Cart(eager: true)` is built at boot."),
            QuizChoice(text: "Each time a page says `use Cart`, as a fresh copy for that page", right: false, why: "Every reader shares one instance; `use` makes no copy."),
            QuizChoice(text: "The first time something reads one of its members or calls an action", right: true, why: "A store nothing reads is never built and costs nothing.")
        ])

        Quiz("A page reads `Cart.count` but has no `use Cart` line. What happens?", id: "Stores#13", choices: [
            QuizChoice(text: "It builds and works: `use` says which stores a page reads, and does not limit what it can reach", right: true, why: "A store is reached by its name from anywhere."),
            QuizChoice(text: "The build stops with `X05`", right: false, why: "`X05` is a `use` that names a store nothing declares, such as `use Carts`."),
            QuizChoice(text: "It builds, but `Cart.count` is always `0` on that page", right: false, why: "Every reader sees the same instance, with or without `use`.")
        ])

        Quiz("`store Filters(scope: .route) \{ persist search = \"\" \}`. The reader types a search, leaves the route and comes back. What is `search`?", id: "Stores#13", choices: [
            QuizChoice(text: "`\"\"`, because a `.route` store is dropped when the route changes", right: false, why: "The store is dropped, but the next read builds it again from storage."),
            QuizChoice(text: "What they typed: the value comes back from storage, which the build warns about (`P03`)", right: true, why: "Use `state` for what the route owns, and a wider scope for what outlives it."),
            QuizChoice(text: "An error: a `.route` store cannot hold `persist`", right: false, why: "It builds; `P03` is a warning.")
        ])

        Heading("Common mistakes", id: "common-mistakes").h2

        Markdown("**A member the store does not have.** A name guessed from what the store ought to hold, rather than read from what it declares:")

        CodeBlock(#"store Cart {
    state items: [String] = []
    derived count = items.length
}

page P(path: "/", title: "T", description: "D") {
    use Cart
    Heading("Cart").h1
    Text("{Cart.total} items")
}"#, title: "wf · draws T06")

        Markdown("Read a member the store declares, `Cart.count`, or declare the one you need. See [T06](/errors/T06).\n\n**`use` with the store's name misspelled.** A store's name is capitalised, and `use` must name it exactly:")

        CodeBlock(#"store Cart { state items: [String] = [] }

page P(path: "/", title: "T", description: "D") {
    use cart
    Heading("{Cart.items.length} in the cart").h1
}"#, title: "wf · draws X05")

        Markdown("Write `use Cart`. See [X05](/errors/X05).\n\n**Assigning a store's `derived` value.** A `derived` value is worked out from the state it reads, so nothing may set it:")

        CodeBlock(#"store Cart {
    state items: [String] = []
    derived count = items.length
}

page P(path: "/", title: "T", description: "D") {
    use Cart
    Heading("{Cart.count} items").h1
    Button("Empty") { on click { Cart.count = 0 } }
}"#, title: "wf · draws X01")

        Markdown("Change the state it reads, through an action: `action clear() \{ items = [] \}`, called as `Cart.clear()`. See [X01](/errors/X01).")
    }
}
