                    Table.Cell { Markdown("`form(options)`, `validate(read, rules, options)`") }
                    Table.Cell { Markdown("`form`") }
                    Table.Cell { Markdown("A `Form` handle and a `validate` block's rules.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`askRules(read, rules, fault, remote, pending)`") }
                    Table.Cell { Markdown("`form`") }
                    Table.Cell { Markdown("Internal: asks a `validate` block's `async` rules, which the compiled form passes as `ask:`.") }
                }
            }
        }

        Heading("Safety", id: "safety").h2

        Table(caption: "Safety") {
            Table.Head {
                Table.Row {
                    Table.Cell("Function").header
                    Table.Cell("Module").header
                    Table.Cell("What it does").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`safeUrl(url)` ●") }
                    Table.Cell { Markdown("`core`") }
                    Table.Cell { Markdown("The URL where a browser may follow it, `\"\"` where it may not.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`safePicture(url)`") }
                    Table.Cell { Markdown("`core`") }
                    Table.Cell { Markdown("As `safeUrl`, and also a picture carried in its address (`data:image/…`), for an image's `src`.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`allowSchemes(schemes)`") }
                    Table.Cell { Markdown("`core`") }
                    Table.Cell { Markdown("Adds an app's own schemes (from `meta.frame`) to those `safeUrl` allows; called once at boot.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`sanitize(html)` ●") }
                    Table.Cell { Markdown("`sanitize`") }
                    Table.Cell("Markup through the allow-list.")
                }
                Table.Row {
                    Table.Cell { Markdown("`jsonAttr(raw)`") }
                    Table.Cell { Markdown("`core`") }
                    Table.Cell("An attribute holding JSON, as the prop it stands for.")
                }
            }
        }

        Markdown("`safeUrl` and `sanitize` each have a build-time twin, and both twins are held to one shared table of cases.")

        Heading("Text and formatting", id: "text-and-formatting").h2

        Table(caption: "Text and formatting") {
            Table.Head {
                Table.Row {
                    Table.Cell("Function").header
                    Table.Cell("Module").header
                    Table.Cell("What it does").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`markdown(text)` ●") }
                    Table.Cell { Markdown("`text`") }
                    Table.Cell("Renders the language's Markdown to HTML.")
                }
                Table.Row {
                    Table.Cell { Markdown("`highlight(code, lang)` ●") }
                    Table.Cell { Markdown("`text`") }
                    Table.Cell { Markdown("Colours `wf`, `json`, `bash` or `css` with `wf-tok-*` spans.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`format(value, style, option)` ●") }
                    Table.Cell { Markdown("`format`") }
                    Table.Cell { Markdown("Formats a value in the page's locale, as `format` in `.wf`.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`ago(date)` ●") }
                    Table.Cell { Markdown("`format`") }
                    Table.Cell { Markdown("A relative time in the page's locale: `3 minutes ago`.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`locales(default, tables)`") }
                    Table.Cell { Markdown("`i18n`") }
                    Table.Cell { Markdown("Sets up `WF.i18n`, with `t`, `locale`, `dir` and `setLocale`.") }
                }
            }
        }

        Heading("Values", id: "values").h2

        Markdown("Each of these is a function of the value it works on.")

        Table(caption: "Values") {
            Table.Head {
                Table.Row {
                    Table.Cell("Functions").header
                    Table.Cell("Module").header
                    Table.Cell("What they are").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`sortBy`, `groupBy`, `unique`, `take`, `first`, `last`, `capitalize`, `truncate`, `dedent`, `lines`, `words`, `range`, `removeAt`") }
                    Table.Cell { Markdown("`helpers`") }
                    Table.Cell { Markdown("The list and string helpers, and `a..b` ranges.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`setIn(target, path, value)`, `mutated(list, method, args)`") }
                    Table.Cell { Markdown("`helpers`") }
                    Table.Cell { Markdown("A state changed in place — `form.name = v`, `items.sort()` — as a copy with that place changed.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`year`, `month`, `day`, `weekday`, `hour`, `minute`, `second`, `plus`, `minus`, `isBefore`, `isAfter`, `isSame`, `until`, `startOfDay`, `startOfWeek`, `startOfMonth`, `endOfDay`, `inZone`, `native`") }
                    Table.Cell { Markdown("`scalars`") }
                    Table.Cell { Markdown("The methods of `Date`, `Time` and `DateTime`.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`days`, `hours`, `minutes`, `seconds`, `ms`") }
                    Table.Cell { Markdown("`scalars`") }
                    Table.Cell { Markdown("The methods of `Duration`.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`money`, `times`, `convert`") }
                    Table.Cell { Markdown("`scalars`") }
                    Table.Cell { Markdown("`Money`.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`host`, `path`, `domain`, `urlWith`, `urlQuery`") }
                    Table.Cell { Markdown("`scalars`") }
                    Table.Cell { Markdown("`Url` and `Email`; `.with()` and `.query()`.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`mix`, `lighten`, `darken`, `alpha`, `contrast`") }
                    Table.Cell { Markdown("`scalars`") }
                    Table.Cell { Markdown("`Color`.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`preview`, `uuid`, `dateOf`, `timeOf`") }
                    Table.Cell { Markdown("`scalars`") }
                    Table.Cell { Markdown("A `File`'s preview, `uuid()`, `.date()` and `.time()`.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`caseOf(v)`, `payload(v)`") }
                    Table.Cell { Markdown("`core`") }
                    Table.Cell("An enum value's case and its payload.")
                }
            }
        }

        Heading("Boot and interop", id: "boot-and-interop").h2

        Table(caption: "Boot and interop") {
            Table.Head {
                Table.Row {
                    Table.Cell("Function").header
                    Table.Cell("Module").header
                    Table.Cell("What it does").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`mount(fn, container)`") }
                    Table.Cell { Markdown("`core`") }
                    Table.Cell { Markdown("Draws the app into `container`.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`mainOf(root)`") }
                    Table.Cell { Markdown("`core`") }
                    Table.Cell { Markdown("The `<main>` the pages draw into: `root` itself, the `<main>` inside it, or a new one.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`live(node)`") }
                    Table.Cell { Markdown("`core`") }
                    Table.Cell { Markdown("Marks `node` as held by something, so a takeover keeps the drawn node rather than the painted one.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`hydrate(fn, container)`, `hydrating(root)`") }
                    Table.Cell { Markdown("`hydrate`") }
                    Table.Cell("Draws beside a pre-rendered page and takes it over in place.")
                }
                Table.Row {
                    Table.Cell { Markdown("`attach(node, mount, update, cleanup)`") }
                    Table.Cell { Markdown("`host`") }
                    Table.Cell { Markdown("What `mount:`, `update:` and `cleanup:` compile to, on `Host` or any element; a component's fragment is attached at its root element.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`portal(box, read)`") }
                    Table.Cell { Markdown("`host`") }
                    Table.Cell { Markdown("What `Portal` compiles to (below).") }
                }
                Table.Row {
                    Table.Cell { Markdown("`head(tags)`") }
                    Table.Cell { Markdown("`head`") }
                    Table.Cell { Markdown("A page's own `head \{ \}` tags.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`picture(asset, options)`") }
                    Table.Cell { Markdown("`picture`") }
                    Table.Cell { Markdown("An `image`'s `<picture>`.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`offline(options)`, `update()`, `clearQueued()`") }
                    Table.Cell { Markdown("`offline`") }
                    Table.Cell("The service worker, the update flow, and forgetting the writes kept offline.")
                }
                Table.Row {
                    Table.Cell { Markdown("`loadAfter(scripts)`") }
                    Table.Cell { Markdown("`later`") }
                    Table.Cell { Markdown("Loads the `meta.scripts` entries marked `\"load\": \"after\"` once the page has painted.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`__debug`, `__reg`") }
                    Table.Cell { Markdown("`debug`") }
                    Table.Cell("For WebFluent Studio.")
                }
            }
        }

        Markdown("`portal(box, read)` keeps `box` in the element, or `ref:` handle, that `read()` names. It reads `read()` again when what it reads changes and once the drawing is over, keeps the box aside while `read()` is `null`, and takes it away with its scope. It returns what runs the lifetimes its block asked for while it was drawn.\n\nThe `icons` module has no functions: it is the table of glyphs, holding only the icons the program names.")
    }
}
