                    Table.Cell { Markdown("`api`") }
                    Table.Cell("A socket, a stream of events, a channel between tabs.")
                }
                Table.Row {
                    Table.Cell { Markdown("`rtc(options)`") }
                    Table.Cell { Markdown("`peer`") }
                    Table.Cell("A peer: a WebRTC data channel.")
                }
                Table.Row {
                    Table.Cell { Markdown("`worker(url, options)`") }
                    Table.Cell { Markdown("`worker`") }
                    Table.Cell { Markdown("A `worker`: a script of the site run beside the page.") }
                }
            }
        }

