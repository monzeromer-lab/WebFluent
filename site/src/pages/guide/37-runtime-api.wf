                    Table.Cell { Markdown("`invalidate(prefix)`") }
                    Table.Cell { Markdown("`http`") }
                    Table.Cell { Markdown("Drops cached answers: every one with no argument, or each key equal to or starting with `prefix`.") }
                }
                Table.Row {
