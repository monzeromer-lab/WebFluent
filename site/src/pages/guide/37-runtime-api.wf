                    Table.Cell { Markdown("`http`") }
                    Table.Cell("A post that survives the page unloading.")
                }
                Table.Row {
                    Table.Cell { Markdown("`api(definition)`") }
                    Table.Cell { Markdown("`api`") }
                    Table.Cell { Markdown("The service an `api` declaration compiles to.") }
                }
