/// Tutorial: Shelf, in ar: written from md-docs/ar/learn/02-tutorial-shelf.md by
/// scripts/docsite/guide.py; edit the translation, not this file.
page Learn02TutorialShelfAr(path: "/ar/learn/02-tutorial-shelf", title: "درس: Shelf", description: "درس خطوة بخطوة: ابنِ موقع قائمة قراءة بـ WebFluent، واختبره، وانشره على GitHub Pages.", lang: "ar", translates: Learn02TutorialShelf, layout: DocsShell("درس: Shelf", kind: .tutorial, chapter: t("nav.group.tour"), blurb: "ابنِ موقعًا صغيرًا كاملًا — بيانات ومكوّنات ومخزن ونموذج وسمة واختبار — وانشره على الويب.", source: "md-docs/ar/learn/02-tutorial-shelf.md", sections: [Anchor(id: "ما-ستبنيه", label: "ما ستبنيه"), Anchor(id: "قبل-أن-تبدأ", label: "قبل أن تبدأ"), Anchor(id: "الخطوة-1-أنشئ-المشروع", label: "الخطوة 1: أنشئ المشروع"), Anchor(id: "الخطوة-2-صف-الكتب", label: "الخطوة 2: صِف الكتب"), Anchor(id: "الخطوة-3-احفظ-رف-القارئ-في-مخزن", label: "الخطوة 3: احفظ رفّ القارئ في مخزن"), Anchor(id: "الخطوة-4-اعرض-كتابا-بمكون", label: "الخطوة 4: اعرض كتابًا بمكوّن"), Anchor(id: "الخطوة-5-أضف-الصفحة-الرئيسية-وصفحة-لكل-كتاب", label: "الخطوة 5: أضف الصفحة الرئيسية وصفحة لكل كتاب"), Anchor(id: "الخطوة-6-أضف-صفحة-الرف-وإطار-الموقع", label: "الخطوة 6: أضف صفحة الرفّ وإطار الموقع"), Anchor(id: "الخطوة-7-أضف-نموذجا-لاقتراح-كتاب", label: "الخطوة 7: أضف نموذجًا لاقتراح كتاب"), Anchor(id: "الخطوة-8-امنح-الموقع-سمة", label: "الخطوة 8: امنح الموقع سمة"), Anchor(id: "الخطوة-9-اختبر-بطاقة-الكتاب", label: "الخطوة 9: اختبر بطاقة الكتاب"), Anchor(id: "الخطوة-10-ابن-الموقع-وتحقق-منه", label: "الخطوة 10: ابنِ الموقع وتحقّق منه"), Anchor(id: "الخطوة-11-انشر-على-github-pages", label: "الخطوة 11: انشر على GitHub Pages"), Anchor(id: "البرنامج-كاملا", label: "البرنامج كاملًا"), Anchor(id: "ما-بنيته", label: "ما بنيته"), Anchor(id: "أخطاء-شائعة", label: "أخطاء شائعة"), Anchor(id: "التالي", label: "التالي")], learned: ["اقرأ ملف JSON وقت البناء بيانات ذات أنواع، بـ `type` و`data`", "احفظ ما يختاره القارئ عبر الزيارات في `store` مع `persist`", "اكتب مكوّنًا وضعه داخل `for … by` ذي مفاتيح", "اعرض صفحة لكل عنصر بمسار `:slug` و`paths:`", "تحقّق من نموذج، وأضف سمة، واختبر بالنقرات، وانشر الموقع"], book: GUIDE_AR, other: "/learn/02-tutorial-shelf", lang: "ar", prevTo: "/ar/learn/01-getting-started", prevLabel: t("ch.01"), nextTo: "/ar/learn/03-tutorial-todos", nextLabel: t("ch.03"))) {
    Stack(gap: .lg) {
        Markdown("يبني هذا الدرس **Shelf**، موقعًا صغيرًا يسرد كتبًا تستحق القراءة، ويتيح للقارئ أن يحتفظ بما يريد منها. كل خطوة تضيف قطعة واحدة، وتنتهي بما يجب أن تراه.")

        Heading("ما ستبنيه", id: "ما-ستبنيه").h2

        Markdown("في Shelf صفحة رئيسية تسرد الكتب مع مربع بحث، وصفحة لكل كتاب، وصفحة **Your shelf** فيها الكتب التي حفظها القارئ، ونموذج لاقتراح كتاب، وسمة بوضع داكن، واختبار ينقر، ونشر على GitHub Pages.\n\nفي الطريق تستخدم معظم ما يحتاجه موقع حقيقي: بيانات ذات أنواع تُقرأ وقت البناء، ومكوّنًا يُعاد استخدامه، وصفحة لكل كتاب، ومخزنًا (store) يحفظ اختيارات القارئ، ونموذجًا يُتحقَّق منه، وسمة، واختبارًا، ونشرًا. كل خطوة تربط الفصل الذي يشرح فكرتها بالتفصيل.\n\nيستغرق نحو نصف ساعة، إضافة إلى النشر.")

        Heading("قبل أن تبدأ", id: "قبل-أن-تبدأ").h2

        Markdown("تحتاج إلى:\n\n- `wf` مثبّتًا وموجودًا في `PATH` ([البدء](/ar/learn/01-getting-started)). على Windows، اكتب `webfluent` حيث يكتب هذا الدرس `wf`.\n- Chrome أو Chromium على الجهاز، للاختبار الذي ينقر ([الخطوة 9](#الخطوة-9-اختبر-بطاقة-الكتاب)) ولـ `wf verify` ([الخطوة 10](#الخطوة-10-ابن-الموقع-وتحقق-منه)). إن كان مثبّتًا في مكان غير معتاد، فاجعل متغير البيئة `WF_CHROME` يشير إليه.\n- للنشر: حساب على GitHub ومستودع اسمه `shelf`.\n\nلا تحتاج إلى معرفة WebFluent بعد.")

        Heading("الخطوة 1: أنشئ المشروع", id: "الخطوة-1-أنشئ-المشروع").h2

        Markdown("ابدأ من القالب `static`، الذي يُصيِّر كل صفحة مسبقًا إلى HTML — وهذا مناسب لموقع يصل إليه الناس عبر البحث:")

        Terminal(lines: [
                Line(command: "wf init shelf -t static"),
                Line(command: "cd shelf")
            ])

        Markdown("ستكتب كل ملف بنفسك، لذا احذف ما وضعه القالب في `src/` واختباراته في `tests/` (فهي تختبر صفحات القالب). ثم استبدل `webfluent.app.json` بما يلي:")

        CodeBlock(#"{
  "name": "shelf",
  "build": { "ssg": true, "csp": true },
  "meta": {
    "title": "Shelf",
    "description": "Books worth reading, and the ones you want to.",
    "lang": "en"
  }
}"#, title: "json")

        Markdown("يُصيِّر `ssg` كل صفحة مسبقًا. ويُرفق `csp` سياسة Content-Security-Policy، ويجعل البناء يفحص مخرجاته بها. يسرد [الإعدادات](/reference/config) كل مفتاح.\n\n**تحقّق:** شغّل `wf check`. يطبع `IO Error: No .wf files found in src/` — وهذا صحيح، لأن `src/` فارغ حتى الخطوة التالية.")

        Heading("الخطوة 2: صِف الكتب", id: "الخطوة-2-صف-الكتب").h2

        Markdown("الكتب بيانات، لا شيفرة. ضعها في `src/books.json`:")

        CodeBlock(#"[
  { "slug": "notes-on-the-analytical-engine", "title": "Notes on the Analytical Engine",
    "author": "Ada Lovelace", "year": 1843, "pages": 66,
    "summary": "The first published algorithm, and a view of what a machine might do beyond arithmetic.",
    "tags": ["computing", "history"] },
  { "slug": "the-design-of-everyday-things", "title": "The Design of Everyday Things",
    "author": "Don Norman", "year": 1988, "pages": 368,
    "summary": "Why doors confuse us, and what that says about everything else we make.",
    "tags": ["design"] },
  { "slug": "a-pattern-language", "title": "A Pattern Language",
    "author": "Christopher Alexander", "year": 1977, "pages": 1171,
    "summary": "Two hundred and fifty-three patterns for towns, buildings and rooms people want to live in.",
    "tags": ["design", "architecture"] }
]"#, title: "json")

        Markdown("ثم صِف شكل البيانات واقرأ الملف، في `src/types.wf`:")

        CodeBlock("/// One book on the list.\ntype Book \{\n    slug: String\n    title: String\n    author: String\n    year: Number\n    pages: Number\n    summary: String\n    tags: [String] = []\n\}\n\ndata books: [Book] = \"books.json\"", title: "wf")

        Markdown("`type Book` سجلّ يُلزم مدقق الأنواع كل استخدام له: كتابة `book.titel` خطأ في الموضع الذي تكتبه فيه. يقرأ `data books` الملف **وقت البناء** ويجعله ثابتًا تقرؤه كل صفحة، فلا يُجلب شيء عند تحميل الصفحة. ([الأنواع](/learn/12-types)، [جلب البيانات](/learn/15-data#read-a-file-at-build-time-with-data).)\n\n**تحقّق:** شغّل `wf check`. يطبع `No problems in shelf.`")

        Heading("الخطوة 3: احفظ رفّ القارئ في مخزن", id: "الخطوة-3-احفظ-رف-القارئ-في-مخزن").h2

        Markdown("ما يحتفظ به القارئ يجب أن يبقى بعد إعادة التحميل وأن يكون هو نفسه في كل صفحة، لذا يوضع في مخزن، وتحفظ `persist` قيمته. أنشئ `src/stores/Shelf.wf`:")

        CodeBlock(#"/// The books the reader wants to read, kept across visits.
store Shelf {
    persist saved: [String] = []
    derived count = saved.length

    action toggle(slug: String) {
        if saved.includes(slug) {
            saved = saved.filter(s => s != slug)
        } else {
            saved = [...saved, slug]
        }
    }
}"#, title: "wf")

        Markdown("`persist` حالة (`state`) تُحفظ في تخزين المتصفح وتُقرأ من جديد في الزيارة التالية؛ والتغيير الذي يحدث في تبويب آخر يصل إلى هنا أيضًا. ويُعاد حساب `derived count` كلما تغيّر `saved`. ([المخازن](/learn/11-stores).)")

        Callout("**قادم من React؟** الحالة المشتركة ليست مزوّد سياق (context provider) يلتفّ حول التطبيق، وحفظها ليس `useEffect` يكتب في `localStorage`. يُقرأ الـ `store` باسمه حيثما استُخدم، و `persist` تتولّى الحفظ. انظر [قادم من React](/coming-from/react).", kind: .note)

        Markdown("**تحقّق:** شغّل `wf check`. يطبع تحذيرَي `U04`: `` `Shelf.count` is declared but never read `` ومثله لـ `Shelf.toggle`. لا شيء يستخدم المخزن بعد؛ الخطوات التالية تستخدمه، فيزول التحذيران.")

        Heading("الخطوة 4: اعرض كتابًا بمكوّن", id: "الخطوة-4-اعرض-كتابا-بمكون").h2

        Markdown("كل كتاب يُعرض بالطريقة نفسها، لذا هو مكوّن. أنشئ `src/components/BookCard.wf`:")

        CodeBlock(#"// … reads what the other steps declare
/// A book at a glance, with the button that puts it on the shelf.
component BookCard(_ book: Book) {
    use Shelf
    Card.outlined {
        Stack(gap: .sm) {
            Link(book.title, to: "/books/{book.slug}")
            Text("{book.author} · {book.year}").muted.sm
            Text(book.summary)
            Row(gap: .xs) {
                for tag in book.tags { Tag(tag) }
            }
            Button(if Shelf.saved.includes(book.slug) { "On your shelf" } else { "Want to read" }).sm {
                on click { Shelf.toggle(book.slug) }
            }
        }
    }
}"#, title: "wf")

        Markdown("- `_ book: Book` هي الخاصية الوحيدة التي يمرّرها المستدعي دون اسمها: `BookCard(book)`.\n- `Card.outlined` و`Stack(gap: .sm)` و`Text(…).muted.sm` عناصر مدمجة بعلامات. يعرف المترجم خصائص كل منها، ويرفض علامة لا يقبلها.\n- يقرأ `use Shelf` المخزن من الخطوة 3. نص الزر تعبير `if` مستخدم قيمةً، وهو يتبع المخزن: حين ينقر القارئ، يتغيّر النص ولا يُعاد رسم شيء آخر.\n\n([المكوّنات](/learn/10-components)، [العناصر](/learn/06-elements).)\n\n**تحقّق:** شغّل `wf check`. يُبلغ عن خطأ واحد: `` error[R01]: `/books/\{…\}` is not a route ``. تربط البطاقة بصفحة الكتاب، ولا صفحة تجيب عن هذا العنوان بعد. يفحص المترجم كل رابط مقابل الصفحات التي تعلنها؛ والخطوة التالية تضيف الصفحة.")

        Heading("الخطوة 5: أضف الصفحة الرئيسية وصفحة لكل كتاب", id: "الخطوة-5-أضف-الصفحة-الرئيسية-وصفحة-لكل-كتاب").h2

        Markdown("تسرد الصفحة الرئيسية الكتب مع مربع بحث. أنشئ `src/pages/Home.wf`:")

        CodeBlock(#"// … reads what the other steps declare
page Home(path: "/", title: "Shelf", description: "Books worth reading, and the ones you want to.") {
    state q = ""
    derived needle = q.trim().toLowerCase()
    derived found = books.filter(b => b.title.toLowerCase().includes(needle) || b.author.toLowerCase().includes(needle))

    Container {
        Stack(gap: .lg) {
            Heading("Books worth reading").h1
            Input(bind: q, label: "Search by title or author").search
            Text("{found.length} of {books.length} books").muted.sm
            Grid(columns: { base: 1, md: 2 }, gap: .md) {
                for book in found by book.slug { BookCard(book) }
            }
            if found.length == 0 { Text("Nothing matches “{q}”.").muted }
        }
    }
}"#, title: "wf")

        Markdown("- يُبقي `bind: q` الحقل والحالة متطابقين، في الاتجاهين.\n- `found` مشتقة من `q`، فالكتابة تضيّق القائمة وأنت تكتب.\n- `for … by book.slug` حلقة ذات مفاتيح: البطاقة التي تبقى في القائمة تحتفظ بعنصرها بدل أن يُعاد بناؤه.\n- `Grid(columns: \{ base: 1, md: 2 \})` عمود واحد على الهاتف وعمودان ابتداءً من نقطة التوقف `md`. يحمل HTML المُصيَّر مسبقًا هذا التخطيط أصلًا، فلا حاجة إلى سكربت.")

        Callout("**قادم من React؟** الحقل المتحكَّم فيه لا يحتاج إلى `value` ولا إلى `onChange` ينسخ `e.target.value` عائدًا: `bind: q` يفعل الأمرين. انظر [قادم من React](/coming-from/react).", kind: .note)

        Markdown("ثم أضف صفحة لكل كتاب، `src/pages/BookPage.wf`:")

        CodeBlock(#"// … reads what the other steps declare
page BookPage(path: "/books/:slug", slug: String, title: "Book", description: "One book on the shelf.", type: "article", paths: books.map(b => b.slug)) {
    derived book = books.find(b => b.slug == slug)
    head {
        meta(property: "og:title", content: book?.title ?? "Book")
    }
    Container {
        if let b = book {
            Breadcrumb {
                Breadcrumb.Item(to: "/") { Text("Books") }
                Breadcrumb.Item { Text(b.title) }
            }
            Heading(b.title).h1
            Text("{b.author}, {b.year} · {b.pages} pages").muted
            Paragraph(b.summary)
        } else {
            Heading("No such book").h1
            Link("Back to the list", to: "/")
        }
    }
}"#, title: "wf")

        Markdown("- `:slug` في المسار معامل ذو نوع للصفحة.\n- يخبر `paths:` البناءَ الثابت بالقيم التي يُصيِّرها: ملف HTML لكل كتاب، `books/a-pattern-language/index.html` وهكذا.\n- قد لا يجد `books.find(…)` شيئًا، لذا `book` من النوع `Book?` (إما `Book` أو `null`). يربطه `if let b = book` فقط حين يكون موجودًا. وقراءة `book.title` دون هذا الفحص خطأ ترجمة (`T04`).\n- يضيف `head \{ … \}` وسومًا إلى `<head>` هذه الصفحة — هنا، العنوان الذي تظهر به معاينة الرابط حين يُشارَك.\n\n([الصفحات والتوجيه](/learn/05-pages-and-routing).)\n\n**تحقّق:** شغّل `wf serve` وافتح `http://localhost:3000`. ترى **Books worth reading** و`3 of 3 books` وثلاث بطاقات. اكتب `norman` في مربع البحث: تبقى بطاقة واحدة، ويصير العدد `1 of 3 books`. انقر **Want to read** على بطاقة فيتغيّر نصها إلى **On your shelf**. انقر عنوان كتاب فتُفتح صفحته، مع مسار تنقّل (breadcrumb) يعود إلى القائمة. لا يُبلغ `wf check` الآن إلا عن تحذير `U04` الخاص بـ `Shelf.count`؛ والخطوة 6 تستخدمه.")

        Heading("الخطوة 6: أضف صفحة الرفّ وإطار الموقع", id: "الخطوة-6-أضف-صفحة-الرف-وإطار-الموقع").h2

        Markdown("تعرض صفحة الرفّ الكتب التي حفظها القارئ. أنشئ `src/pages/ShelfPage.wf`:")

        CodeBlock(#"// … reads what the other steps declare
page ShelfPage(path: "/shelf", title: "Your shelf", description: "The books you want to read.") {
    use Shelf
    derived mine = books.filter(b => Shelf.saved.includes(b.slug))
    Container {
        Stack(gap: .lg) {
            Heading("Your shelf").h1
            if mine.length == 0 {
                Text("Nothing yet. Pick something from the list.").muted
                Link("Browse the books", to: "/")
            } else {
                for book in mine by book.slug { BookCard(book) }
            }
        }
    }
}"#, title: "wf")

        Markdown("أضف صفحة للعناوين التي لا تطالب بها صفحة أخرى، `src/pages/NotFound.wf`. يطابق `path: \"*\"` أي شيء، ويكتبها البناء الثابت باسم `404.html`:")

        CodeBlock(#"page NotFound(path: "*", title: "Not found", description: "Nothing lives at this address.", noindex: true) {
    Container {
        Heading("Nothing lives here").h1
        Link("Back to the books", to: "/")
    }
}"#, title: "wf")

        Markdown("أخيرًا، الإطار الذي تتشاركه كل الصفحات، `src/App.wf`. `Router` هو حيث تُرسم الصفحة الحالية:")

        CodeBlock(#"// … reads what the other steps declare
app {
    Navbar {
        Navbar.Brand { Link("Shelf", to: "/") }
        Navbar.Links {
            Link("Books", to: "/")
            Link("Your shelf ({Shelf.count})", to: "/shelf")
        }
    }
    Router
    Footer { Text("Built with WebFluent").muted.sm }
}"#, title: "wf")

        Markdown("**تحقّق:** يطبع `wf check` الرسالة `No problems in shelf.` صار لكل صفحة الآن شريط تنقّل. ضع كتابين على رفّك: يصير الرابط **Your shelf (2)**. افتحه، ثم أعد تحميل الصفحة — لا يزال الكتابان هناك. افتح `http://localhost:3000/nowhere` فترى **Nothing lives here**.")

        Heading("الخطوة 7: أضف نموذجًا لاقتراح كتاب", id: "الخطوة-7-أضف-نموذجا-لاقتراح-كتاب").h2

        Markdown("يستطيع القرّاء اقتراح كتب. أنشئ `src/pages/Suggest.wf`:")

        CodeBlock(#"page Suggest(path: "/suggest", title: "Suggest a book", description: "Tell us what belongs on the shelf.") {
    state title = ""
    state author = ""
    state why = ""
    state sent = false

    validate title { required "Which book?" }
    validate author { required "Who wrote it?" }
    validate why { maxLength(280) "Keep it under 280 characters" }

    Container {
        Stack(gap: .lg) {
            Heading("Suggest a book").h1
            if sent { Alert("Thank you — we will take a look.").success }
            Form(bind: form) {
                on submit {
                    sent = true
                    form.reset()
                }
                Input(bind: title, label: "Title")
                Input(bind: author, label: "Author")
                Textarea(bind: why, label: "Why it belongs here", rows: 4, maxLength: 280)
                Button("Send the suggestion", type: .submit).primary
            }
        }
    }
}"#, title: "wf")

        Markdown("تقع كتلة `validate` بجانب الحالة التي تحرسها، ويعرض عنصر التحكم المربوط بتلك الحالة رسائلها بطريقة يسهل الوصول إليها: يأخذ الحقل `aria-invalid`، و تُعلَن الرسالة. والإرسال الذي يفشل ينقل التركيز إلى أول حقل فيه مشكلة ولا يشغّل `on submit`. ([النماذج](/learn/14-forms).)\n\nثم اربط الصفحة من الإطار. أضف الرابط الثالث إلى `src/App.wf`:")

        CodeBlock(#"// … reads what the other steps declare
app {
    Navbar {
        Navbar.Brand { Link("Shelf", to: "/") }
        Navbar.Links {
            Link("Books", to: "/")
            Link("Your shelf ({Shelf.count})", to: "/shelf")
            Link("Suggest a book", to: "/suggest")
        }
    }
    Router
    Footer { Text("Built with WebFluent").muted.sm }
}"#, title: "wf")

        Markdown("**تحقّق:** انقر **Suggest a book**، ثم **Send the suggestion** والنموذج فارغ. لا يُرسَل النموذج: تظهر **Which book?** تحت **Title**، و**Who wrote it?** تحت **Author**. املأ الحقلين وأرسل مرة أخرى. ترى **Thank you — we will take a look.**، ويصير النموذج فارغًا.\n\nالموقع الحقيقي يرسل الاقتراح إلى مكان ما. لا تحتاج إلى خادم خلفي في هذا الدرس، لذا هذا الجزء لما بعد: صِف الخدمة مرة واحدة، في ملف خاص بها،")

        CodeBlock(#"// … in src/api.wf, beside the pages
api Suggestions(base: env.PUBLIC_API ?? "/api") {
    post suggest(body: Map)
}"#, title: "wf")

        Markdown("واستدعها من معالج النموذج:")

        CodeBlock(#"// … in src/pages/Suggest.wf; the rest of the page is as above
on submit {
    await Suggestions.suggest(body: { title: title, author: author, why: why })
    sent = true
    form.reset()
}"#, title: "wf")

        Markdown("([البيانات وواجهات API](/learn/15-data)، [البيئات](/recipes).)")

        Heading("الخطوة 8: امنح الموقع سمة", id: "الخطوة-8-امنح-الموقع-سمة").h2

        Markdown("تغيّر السمة رموز التصميم (design tokens) التي يُرسم بها كل عنصر مدمج. أنشئ `src/theme.wf`:")

        CodeBlock(#"theme Paper {
    color-primary: #6D28D9
    font-family: Charter, Georgia, serif
    radius-md: 10px
}

theme Ink {
    color-background: #111014
    color-surface: #1A1820
    color-text: #ECEAF2
    color-text-muted: #A8A3B5
    color-border: #2B2833
}"#, title: "wf")

        Markdown("ثم سمِّ السمتين في `webfluent.app.json` — `Paper` سمةً و `Ink` سمةً داكنة:")

        CodeBlock(#"{
  "name": "shelf",
  "build": { "ssg": true, "csp": true },
  "theme": { "name": "Paper", "dark": "Ink" },
  "meta": {
    "title": "Shelf",
    "description": "Books worth reading, and the ones you want to.",
    "lang": "en"
  }
}"#, title: "json")

        Markdown("القارئ الذي ضُبط نظامه على الوضع الداكن يحصل على `Ink`، قبل الرسم الأول ودون وميض للسمة الفاتحة. والرمز الذي لا تسمّيه يحتفظ بقيمته الأساسية. ([التنسيق](/learn/13-styling).)\n\n**تحقّق:** الروابط وزر **Send the suggestion** بنفسجية، والنص بخط ذي زوائد (serif). حوّل نظامك إلى الوضع الداكن فتصير الصفحة داكنة. إن توقّف البناء برسالة ``No `theme Paper` is declared in this project``، فالإعدادات تسمّي سمة لا يعلنها `src/theme.wf`: تحقّق من اسم الملف ومن التهجئة.")

        Heading("الخطوة 9: اختبر بطاقة الكتاب", id: "الخطوة-9-اختبر-بطاقة-الكتاب").h2

        Markdown("تعيش الاختبارات في `tests/`. أنشئ `tests/BookCard.wf`:")

        CodeBlock(#"// … reads what the other steps declare
test "a card shows who wrote the book, and when" {
    BookCard(Book(slug: "x", title: "X", author: "Ada Lovelace", year: 1843, pages: 66, summary: "Notes."))
    expect "Ada Lovelace · 1843"
    expect "Want to read"
}

test "a book goes on the shelf, and comes off again" {
    BookCard(Book(slug: "x", title: "X", author: "Ada Lovelace", year: 1843, pages: 66, summary: "Notes."))
    click "Want to read"
    expect "On your shelf"
    click "On your shelf"
    expect "Want to read"
}"#, title: "wf")

        Markdown("شغّلها:")

        Terminal(lines: [
                Line(command: "wf test")
            ])

        Markdown("يُصيِّر الاختبار الأول البطاقة ويقرأ ما تعرضه. ويكتب أيضًا لقطة (snapshot) تقارن بها المرة التالية. أما الاختبار الثاني **فينقر**، لذا يعمل في Chrome بلا واجهة (headless)، بالمترجم ووقت التشغيل نفسيهما اللذين يحصل عليهما القارئ. تُوجد الأزرار بنصها، كما يجدها القارئ. ([الاختبار](/learn/16-testing).)\n\n**تحقّق:** ينتهي التشغيل الأول بما يلي:")

        CodeBlock(#"  new   tests/BookCard.wf — a card shows who wrote the book, and when (snapshot written)
  ok    tests/BookCard.wf — a book goes on the shelf, and comes off again (in a browser)
2 passed, 0 failed, 1 snapshot(s) written"#, title: "text")

        Markdown("شغّل `wf test` مرة أخرى فيصير السطر الأول `ok`: يطابق التصيير لقطته.\n\nإن قال الاختبار الثاني إنه لا يوجد متصفح، فثبّت Chrome أو Chromium، أو اضبط `WF_CHROME` على مساره.")

        Heading("الخطوة 10: ابنِ الموقع وتحقّق منه", id: "الخطوة-10-ابن-الموقع-وتحقق-منه").h2

        Markdown("أوقف خادم التطوير، ثم ابنِ الموقع وحمّل كل صفحة في متصفح حقيقي:")

        Terminal(lines: [
                Line(command: "wf build"),
                Line(command: "wf verify")
            ])

        Markdown("يكتب `wf build` المجلد `build/`، وهو مجلد HTML وCSS وJavaScript يستطيع أي مضيف ثابت تقديمه، ويطبع كل تحذير، مثل `alt` مفقود، أو صفحة بلا وصف، أو حالة لا يقرؤها شيء. ويحمّل `wf verify` كل صفحة في متصفح حقيقي ويفشل عند خطأ سكربت، أو طلب فاشل، أو صفحة فارغة.\n\n**تحقّق:** ينتهي `wf build` بـ `Build complete.`، ويحوي `build/` `index.html` و`shelf/index.html` و`suggest/index.html` و`404.html` وملف `books/<slug>/index.html` لكل كتاب. يسرد `wf verify` ستة مسارات، كلٌّ منها `ok`، وينتهي بـ `6 page(s), 0 problem(s)`.")

        Heading("الخطوة 11: انشر على GitHub Pages", id: "الخطوة-11-انشر-على-github-pages").h2

        Markdown("أي مضيف ثابت يقدّم `build/`. على GitHub Pages، يعيش موقع المشروع تحت `https://<you>.github.io/shelf/`، لذا أخبر البناء بمساره الفرعي وعنوانه. أضف هذه المفاتيح إلى `webfluent.app.json`، مع إبقاء البقية:")

        CodeBlock(#"{
  "build": { "ssg": true, "csp": true, "base_path": "/shelf" },
  "meta": { "site_url": "https://you.github.io/shelf" }
}"#, title: "json")

        Markdown("يضيف `base_path` بادئة إلى كل رابط وملف. ويفعّل `site_url` الروابط القانونية (canonical)، وخريطة الموقع، وعناوين Open Graph المطلقة.\n\nثم أضف سير عمل (workflow) يبني الموقع وينشره مع كل دفع (push) إلى `main`، `.github/workflows/pages.yml`:")

        CodeBlock(#"name: Deploy
on:
  push:
    branches: [main]
permissions:
  contents: read
  pages: write
  id-token: write
jobs:
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/checkout@v4
      - run: curl -sSL https://raw.githubusercontent.com/monzeromer-lab/WebFluent/master/install.sh | bash
      - run: ~/.webfluent/bin/wf build
      - uses: actions/upload-pages-artifact@v3
        with:
          path: build
      - id: deployment
        uses: actions/deploy-pages@v4"#, title: "yaml")

        Markdown("ادفع المشروع إلى مستودع `shelf`. في **Settings → Pages** الخاصة بالمستودع، اختر **GitHub Actions** مصدرًا.\n\n**تحقّق:** يُظهر تبويب **Actions** سير العمل **Deploy** ناجحًا، و يعرض `https://<you>.github.io/shelf/` العنوان **Books worth reading**. يغطي [النشر](/recipes) Netlify وVercel وCloudflare Pages وnginx ومضيفين آخرين.")

        Heading("البرنامج كاملًا", id: "البرنامج-كاملا").h2

        Markdown("كل ملف `.wf` مما سبق، في قائمة واحدة. هذا هو البرنامج الذي بنته الخطوات، مع أول الاختبارين:")

        CodeBlock(#"type Book {
    slug: String
    title: String
    author: String
    year: Number
    pages: Number
    summary: String
    tags: [String] = []
}

data books: [Book] = "books.json"

store Shelf {
    persist saved: [String] = []
    derived count = saved.length

    action toggle(slug: String) {
        if saved.includes(slug) {
            saved = saved.filter(s => s != slug)
        } else {
            saved = [...saved, slug]
        }
    }
}

component BookCard(_ book: Book) {
    use Shelf
    Card.outlined {
        Stack(gap: .sm) {
            Link(book.title, to: "/books/{book.slug}")
            Text("{book.author} · {book.year}").muted.sm
            Text(book.summary)
            Row(gap: .xs) {
                for tag in book.tags { Tag(tag) }
            }
            Button(if Shelf.saved.includes(book.slug) { "On your shelf" } else { "Want to read" }).sm {
                on click { Shelf.toggle(book.slug) }
            }
        }
    }
}

app {
    Navbar {
        Navbar.Brand { Link("Shelf", to: "/") }
        Navbar.Links {
            Link("Books", to: "/")
            Link("Your shelf ({Shelf.count})", to: "/shelf")
            Link("Suggest a book", to: "/suggest")
        }
    }
    Router
    Footer { Text("Built with WebFluent").muted.sm }
}

page Home(path: "/", title: "Shelf", description: "Books worth reading, and the ones you want to.") {
    state q = ""
    derived needle = q.trim().toLowerCase()
    derived found = books.filter(b => b.title.toLowerCase().includes(needle) || b.author.toLowerCase().includes(needle))

    Container {
        Stack(gap: .lg) {
            Heading("Books worth reading").h1
            Input(bind: q, label: "Search by title or author").search
            Text("{found.length} of {books.length} books").muted.sm
            Grid(columns: { base: 1, md: 2 }, gap: .md) {
                for book in found by book.slug { BookCard(book) }
            }
            if found.length == 0 { Text("Nothing matches “{q}”.").muted }
        }
    }
}

page BookPage(path: "/books/:slug", slug: String, title: "Book", description: "One book on the shelf.", type: "article", paths: books.map(b => b.slug)) {
    derived book = books.find(b => b.slug == slug)
    head {
        meta(property: "og:title", content: book?.title ?? "Book")
    }
    Container {
        if let b = book {
            Breadcrumb {
                Breadcrumb.Item(to: "/") { Text("Books") }
                Breadcrumb.Item { Text(b.title) }
            }
            Heading(b.title).h1
            Text("{b.author}, {b.year} · {b.pages} pages").muted
            Paragraph(b.summary)
        } else {
            Heading("No such book").h1
            Link("Back to the list", to: "/")
        }
    }
}

page ShelfPage(path: "/shelf", title: "Your shelf", description: "The books you want to read.") {
    use Shelf
    derived mine = books.filter(b => Shelf.saved.includes(b.slug))
    Container {
        Stack(gap: .lg) {
            Heading("Your shelf").h1
            if mine.length == 0 {
                Text("Nothing yet. Pick something from the list.").muted
                Link("Browse the books", to: "/")
            } else {
                for book in mine by book.slug { BookCard(book) }
            }
        }
    }
}

page Suggest(path: "/suggest", title: "Suggest a book", description: "Tell us what belongs on the shelf.") {
    state title = ""
    state author = ""
    state why = ""
    state sent = false

    validate title { required "Which book?" }
    validate author { required "Who wrote it?" }
    validate why { maxLength(280) "Keep it under 280 characters" }

    Container {
        Stack(gap: .lg) {
            Heading("Suggest a book").h1
            if sent { Alert("Thank you — we will take a look.").success }
            Form(bind: form) {
                on submit {
                    sent = true
                    form.reset()
                }
                Input(bind: title, label: "Title")
                Input(bind: author, label: "Author")
                Textarea(bind: why, label: "Why it belongs here", rows: 4, maxLength: 280)
                Button("Send the suggestion", type: .submit).primary
            }
        }
    }
}

page NotFound(path: "*", title: "Not found", description: "Nothing lives at this address.", noindex: true) {
    Container {
        Heading("Nothing lives here").h1
        Link("Back to the books", to: "/")
    }
}

theme Paper {
    color-primary: #6D28D9
    font-family: Charter, Georgia, serif
    radius-md: 10px
}

theme Ink {
    color-background: #111014
    color-surface: #1A1820
    color-text: #ECEAF2
    color-text-muted: #A8A3B5
    color-border: #2B2833
}

test "a card shows who wrote the book, and when" {
    BookCard(Book(slug: "x", title: "X", author: "Ada Lovelace", year: 1843, pages: 66, summary: "Notes."))
    expect "Ada Lovelace · 1843"
    expect "Want to read"
}"#, title: "wf")

