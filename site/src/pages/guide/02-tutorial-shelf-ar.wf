        Markdown("لتذهب أبعد:\n\n- اقرأ اللغة كما ينبغي، بدءًا من [أساسيات اللغة](/learn/04-language-basics).\n- تحدّث مع خادم حقيقي: [البيانات وواجهات API](/learn/15-data).\n- اجعل الموقع يعمل دون اتصال: [العمل دون اتصال](/recipes).\n- ترجمه: [التدويل](/recipes).\n- ابنِ مشروعًا أكبر: [الدروس](/ar/learn/03-tutorial-todos).")

        Heading("أخطاء شائعة", id: "أخطاء-شائعة").h2

        Markdown("قراءة قيمة قد تكون مفقودة. لا يجد `books.find(…)` شيئًا حين لا يحمل أي كتاب هذا الـ slug، لذا `book` من النوع `Book?`:")

        CodeBlock(#"type Book { slug: String, title: String }

const books: [Book] = [Book(slug: "a-pattern-language", title: "A Pattern Language")]

page BookPage(path: "/books/:slug", slug: String, title: "Book", description: "One book.") {
    derived book = books.find(b => b.slug == slug)
    Heading(book.title).h1
}"#, title: "wf · draws T04")

        Markdown("اربطه بـ `if let b = book \{ Heading(b.title).h1 \}`، كما تفعل الخطوة 5، أو اقرأه بـ `book?.title ?? \"Book\"` ([T04](/errors/T04)).\n\nحقل لا يملكه النوع. يسمّي `type Book` كل حقل، فالخطأ المطبعي خطأ في الموضع الذي يُكتب فيه:")

        CodeBlock(#"type Book { slug: String, title: String }

const books: [Book] = [Book(slug: "a-pattern-language", title: "A Pattern Language")]

page Home(path: "/", title: "Shelf", description: "Books worth reading.") {
    Heading("Books").h1
    for book in books by book.slug {
        Text(book.titel)
    }
}"#, title: "wf · draws T05")

        Markdown("استخدم الاسم الذي تقترحه الرسالة، `book.title` ([T05](/errors/T05)).\n\nعضو مخزن لا يعلنه المخزن. لدى `Shelf` الأعضاء `saved` و`count` و`toggle`، ولا شيء غيرها:")

        CodeBlock(#"store Shelf {
    persist saved: [String] = []
    action toggle(slug: String) {
        saved = if saved.includes(slug) { saved.filter(s => s != slug) } else { [...saved, slug] }
    }
}

page Home(path: "/", title: "Shelf", description: "Books worth reading.") {
    use Shelf
    Heading("Books").h1
    Text("{Shelf.total} saved")
    Button("Keep it") { on click { Shelf.toggle("a-pattern-language") } }
}"#, title: "wf · draws T06")

        Markdown("اقرأ عضوًا يعلنه المخزن، أو أعلن العضو الذي تحتاجه: `derived count = saved.length` ([T06](/errors/T06)).")

        Heading("التالي", id: "التالي").h2

        Markdown("[قادم من React أو Vue أو Svelte](/coming-from/react).")
    }
}
