                    Table.Cell("It gives you").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("**Tutorial**") }
                    Table.Cell("are learning, and want to build something")
                    Table.Cell("a lesson with a guaranteed working result")
                }
                Table.Row {
                    Table.Cell { Markdown("**How-to guide**") }
                    Table.Cell("have a goal, such as validating a form")
                    Table.Cell("the steps to that one result")
                }
                Table.Row {
