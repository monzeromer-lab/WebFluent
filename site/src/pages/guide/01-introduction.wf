                    Table.Cell("a complete, exact description")
                }
                Table.Row {
                    Table.Cell { Markdown("**Explanation**") }
                    Table.Cell("want to understand how something works and why")
                    Table.Cell("the ideas, the reasons and the trade-offs")
                }
            }
        }

        Markdown("The guide is organised by what you are here to do, in eleven sections:")

        Table(caption: "How this guide is organised") {
            Table.Head {
