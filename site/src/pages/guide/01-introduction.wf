                    Table.Cell { Markdown("[Project structure](/reference/project), [static or single-page](/docs/guide/static-and-spa), [deploying](/docs/guide/deploying), [environments](/docs/guide/environments) and [desktop apps](/docs/guide/desktop)") }
                }
                Table.Row {
