/// Chapter 18 of the guide, written from md-docs/18-realtime.md by
/// scripts/site-from-guide.py; edit the guide, not this file.
page RealtimeGuide(path: "/docs/guide/realtime", title: "Real-time", description: "WebSockets, server-sent events, broadcast channels and WebRTC peers: opening, matching, sending, options, reconnection and typed messages.", layout: DocsShell("Real-time", chapter: t("guide.chapter", { n: "18" }), blurb: "Sockets, server-sent events, a channel every tab hears, a direct line to another reader's page — and the network itself as a value.", source: "md-docs/18-realtime.md", sections: [Anchor(id: "four-kinds-of-connection", label: "Four kinds of connection"), Anchor(id: "a-peer", label: "A peer"), Anchor(id: "options", label: "Options"), Anchor(id: "a-message-that-must-arrive-beacon", label: "A message that must arrive: beacon"), Anchor(id: "the-network-as-a-value", label: "The network as a value")], prevTo: "/docs/guide/data", prevLabel: "17. {t("ch.17")}", nextTo: "/docs/guide/offline", nextLabel: "19. {t("ch.19")}")) {
    Stack(gap: .lg) {
        Markdown("A page can hold a connection open: a **socket** to a server, a **stream** of server-sent events, a **channel** every tab of the site hears, or a **peer** — a WebRTC data channel straight to another reader's page. Each is declared like a `resource`, matched on its state, and closed when the page that opened it leaves, so a route change can never leak one.")

        Heading("Four kinds of connection", id: "four-kinds-of-connection").h2

        Markdown("A socket, a stream of server-sent events, a channel every tab of the origin hears, or a peer — a line straight to another reader's page. Each is closed when the page that opened it leaves.")

        CodeBlock(#"page Chat(path: "/chat", title: "Chat", description: "Talk.") {
    state draft = ""
    socket chat = ws("wss://example.com/chat", heartbeat: 20.seconds) {
        on message(m) { log(m) }
    }

    Heading("Chat").h1
    match chat {
        connecting { Spinner.sm }
        open       { for m in chat.messages by m.id { Text(m.text) } }
        closed(c)  { Alert("Disconnected ({c.code})").warning }
        error(e)   { Alert(e.message).danger }
    }
    Input(bind: draft, label: "Message").text
    Button("Send").primary { on click { chat.send({ text: draft })  draft = "" } }
}"#, title: "wf")

        Markdown("A socket reconnects with backoff, keeps itself alive with a heartbeat, and holds what was sent while it was down.")

        CodeBlock(#"stream ticks = sse("/events", events: ["price"])
channel cart = broadcast("cart") { on message(m) { Cart.merge(m) } }
beacon("/analytics", { event: "checkout" })     // survives the page unloading"#, title: "wf")

        Markdown("`ticks` and `cart` are handles too — a `match` reads the state, and an `effect` reads what arrived:")

        CodeBlock(#"effect { if let p = ticks.last("price") { price = p } }
Button("Sync") { on click { cart.post({ items: Cart.count }) } }"#, title: "wf")

        Markdown("What each handle holds:")

        Table(caption: "Four kinds of connection") {
            Table.Head {
                Table.Row {
                    Table.Cell("").header
                    Table.Cell.header { Markdown("`socket`") }
                    Table.Cell.header { Markdown("`stream`") }
                    Table.Cell.header { Markdown("`channel`") }
                    Table.Cell.header { Markdown("`peer`") }
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`.state`") }
                    Table.Cell { Markdown("`connecting` `open` `closed` `error` — the arms of a `match`") }
                    Table.Cell("the same")
                    Table.Cell { Markdown("`open` or `closed`") }
                    Table.Cell("the same as a socket")
                }
                Table.Row {
                    Table.Cell { Markdown("`.messages`") }
                    Table.Cell("every message, in order")
                    Table.Cell("every message, in order")
                    Table.Cell("—")
                    Table.Cell("every message, in order")
                }
                Table.Row {
                    Table.Cell { Markdown("`.last(kind)`") }
                    Table.Cell("the last message, or the last of a kind")
                    Table.Cell("the last under an event's name")
                    Table.Cell("the last posted")
                    Table.Cell("as a socket")
                }
                Table.Row {
                    Table.Cell { Markdown("`.error`") }
                    Table.Cell { Markdown("the failure, which the `error(e)` arm is handed") }
                    Table.Cell("the same")
                    Table.Cell("—")
                    Table.Cell("the same")
                }
                Table.Row {
                    Table.Cell { Markdown("`.closure`") }
                    Table.Cell { Markdown("the close, which `closed(c)` is handed: `.code`, `.reason`") }
                    Table.Cell("—")
                    Table.Cell("—")
                    Table.Cell("the same")
                }
                Table.Row {
                    Table.Cell("Sending")
                    Table.Cell { Markdown("`.send(value)` — queued while the line is down") }
                    Table.Cell("—")
                    Table.Cell { Markdown("`.post(value)`") }
                    Table.Cell { Markdown("`.send(value)` — queued until it opens") }
                }
                Table.Row {
                    Table.Cell { Markdown("`.close()`") }
                    Table.Cell("closes it early")
                    Table.Cell("the same")
                    Table.Cell("the same")
                    Table.Cell("the same")
                }
                Table.Row {
                    Table.Cell { Markdown("`.signal(m)`") }
                    Table.Cell("—")
                    Table.Cell("—")
                    Table.Cell("—")
                    Table.Cell("hands it what the other side signalled")
                }
            }
        }

        Markdown("A `match` over one takes `connecting`, `open`, `closed(c)` and `error(e)`, and an `else` for the rest. The page closing closes the connection, so a route change cannot leak one.")

        Heading("A peer", id: "a-peer").h2

        Markdown("`peer` is a WebRTC data channel to another page. The language supplies the channel, not a server: what the two sides must tell each other to connect — an offer, an answer, the routes each can be reached by — goes out through `signal:`, over whatever the app already has, and what the other side sent is handed back to `link.signal(m)`. One side is the `initiator`.")

        CodeBlock(#"page Room(path: "/room", title: "Room", description: "Two readers, one line.") {
    state heard = ""
    channel lobby = broadcast("room") { on message(m) { link.signal(m) } }
    peer link = rtc(signal: m => lobby.post(m), initiator: query.host == "1") {
        on message(m) { heard = m.text }
    }

    Heading("Room").h1
    match link {
        connecting { Text("Waiting for the other side…").muted }
        open       { Button("Wave") { on click { link.send({ text: "hello" }) } } }
        closed(c)  { Text("They left.") }
        error(e)   { Alert(e.message).danger }
    }
    Text(heard)
}"#, title: "wf")

        Markdown("A `broadcast` channel signals between two tabs of one browser, as here; between two readers the signal rides the app's own socket or `api`.")

        Table(caption: "A peer") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`signal:`") }
                    Table.Cell("Required: a function handed each message the other side must receive.")
                }
                Table.Row {
                    Table.Cell { Markdown("`initiator:`") }
                    Table.Cell("Whether this side offers. Exactly one side does.")
                }
                Table.Row {
                    Table.Cell { Markdown("`ice:`") }
                    Table.Cell { Markdown("The servers that help two readers on different networks find each other — `[\{ urls: \"stun:…\" \}]`. None by default, which connects readers on the same network only.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`ordered:`") }
                    Table.Cell { Markdown("`false` for a channel that may deliver out of order.") }
                }
            }
        }

        Markdown("A page that leaves closes its peer, and the other side reads `closed` at once rather than when the connection times out.")

        Heading("Options", id: "options").h2

        Markdown("A socket takes, after its address:")

        Table(caption: "Options") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Does").header
                    Table.Cell("Default").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`protocols:`") }
                    Table.Cell { Markdown("Subprotocols to ask for: `[\"v2\"]`") }
                    Table.Cell("none")
                }
                Table.Row {
                    Table.Cell { Markdown("`heartbeat:`") }
                    Table.Cell { Markdown("Sends a ping this often and reconnects when no pong comes back: `20.seconds`") }
                    Table.Cell("off")
                }
                Table.Row {
                    Table.Cell { Markdown("`ping:`, `pong:`") }
                    Table.Cell("The heartbeat's messages")
                    Table.Cell { Markdown("`\"ping\"`, `\"pong\"`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`reconnect:`") }
                    Table.Cell { Markdown("`false` to stay closed after the server closes") }
                    Table.Cell { Markdown("`true`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`delay:`, `max:`") }
                    Table.Cell("The first wait before reconnecting, in ms, and the longest; it doubles each time")
                    Table.Cell { Markdown("`500`, `30000`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`queue:`") }
                    Table.Cell { Markdown("`false` to drop, rather than hold, what is sent while the socket is down") }
                    Table.Cell { Markdown("`true`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`binaryType:`") }
                    Table.Cell { Markdown("`\"blob\"` or `\"arraybuffer\"`") }
                    Table.Cell { Markdown("`\"blob\"`") }
                }
            }
        }

        Markdown("A stream takes `events:` — the event names to listen for, each kept apart so `ticks.last(\"price\")` is the last price — and `credentials: true` to send cookies. A stream reconnects on its own and resumes from the last event id the server sent.\n\nInside the block, `on message(m) \{ \}` handles what arrives and `on open \{ \}` runs when the line opens. A socket may also say what it sends and receives:")

        CodeBlock(#"type Incoming { id: String, text: String }
type Outgoing { text: String }

page Room(path: "/room", title: "Room", description: "A typed conversation.") {
    state draft = ""
    socket chat = ws("wss://example.com/chat", heartbeat: 20.seconds) {
        send    Outgoing
        receive Incoming
    }
    Heading("Room").h1
    for m in chat.messages by m.id { Text(m.text) }
    Input(bind: draft, label: "Message")
    Button("Send") { on click { chat.send(Outgoing(text: draft))  draft = "" } }
}"#, title: "wf")

        Markdown("With `send` and `receive` declared, `chat.send(…)` is checked against `Outgoing` and each message is an `Incoming`.")

        Heading("A message that must arrive: beacon", id: "a-message-that-must-arrive-beacon").h2

        CodeBlock(#"beacon("/analytics", { event: "checkout", value: 42 })"#, title: "wf")

        Markdown("`beacon(url, data)` posts a small body with `navigator.sendBeacon`, which the browser delivers even as the page unloads — for analytics and \"the reader left\" signals, where a `fetch` would be cancelled.")

        Heading("The network as a value", id: "the-network-as-a-value").h2

        CodeBlock(#"if !network.online { Alert("You are offline — changes are queued.").warning }"#, title: "wf")

        Markdown("`network.online`, `.effectiveType` (`4g`, `3g`, …), `.saveData`, `.downlink` — live, so a page can say what it does on a slow line or none at all — and `.queued`, the writes waiting for the connection when the site works offline.")
    }
}
