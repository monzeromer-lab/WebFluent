                Table.Row {
                    Table.Cell { Markdown("`color-background`") }
                    Table.Cell { Markdown("`#FFFFFF`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`color-border`") }
                    Table.Cell { Markdown("`#E2E8F0`") }
                }
