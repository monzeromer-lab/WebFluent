        Heading("Short names", id: "short-names").h2

        Markdown("In a style block, a short name is resolved by the property it is given to:")

        Table(caption: "Short names") {
            Table.Head {
                Table.Row {
                    Table.Cell("Property").header
                    Table.Cell("Group").header
                    Table.Cell.header { Markdown("So `$…` means") }
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`padding`, `margin` and their sides, `gap`, `row-gap`, `column-gap`, `width`, `height`, `min-`/`max-` sizes, `top`/`right`/`bottom`/`left`, `inset`") }
                    Table.Cell("spacing")
                    Table.Cell { Markdown("`$lg` is `spacing-lg` (`xs` … `3xl`)") }
                }
                Table.Row {
                    Table.Cell { Markdown("`color`, `background`, `background-color`, `border-color`, `fill`, `stroke`") }
                    Table.Cell("colour")
                    Table.Cell { Markdown("`$primary` is `color-primary` (`primary`, `secondary`, `success`, `danger`, `warning`, `info`, `background`, `surface`, `text`, `border`)") }
                }
                Table.Row {
                    Table.Cell { Markdown("`font-size`") }
                    Table.Cell("font size")
                    Table.Cell { Markdown("`$xl` is `font-size-xl` (`xs`, `sm`, `base`, `lg`, `xl`, `2xl`, `3xl`)") }
                }
