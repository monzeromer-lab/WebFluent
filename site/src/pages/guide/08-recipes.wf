/// Chapter 8 of the guide, written from md-docs/08-recipes.md by
/// scripts/site-from-guide.py; edit the guide, not this file.
page RecipesGuide(path: "/docs/guide/recipes", title: "Recipes", description: "WebFluent recipes: debounced search, pagination, optimistic updates, confirm dialogs, sessions, load more, dark mode, clipboard and charts.", layout: DocsShell("Recipes", chapter: t("nav.group.tutorials"), blurb: "Small, complete pages for the jobs most projects meet: debounced search, paging, optimistic updates, a confirm dialog, dark mode and more.", source: "md-docs/08-recipes.md", sections: [Anchor(id: "debounce-a-search", label: "Debounce a search"), Anchor(id: "page-through-results", label: "Page through results"), Anchor(id: "update-at-once-and-roll-back-on-failure", label: "Update at once, and roll back on failure"), Anchor(id: "build-a-confirm-dialog-component", label: "Build a confirm dialog component"), Anchor(id: "make-navigation-responsive", label: "Make navigation responsive"), Anchor(id: "show-validation-messages-on-a-form", label: "Show validation messages on a form"), Anchor(id: "keep-the-active-tab-in-the-address", label: "Keep the active tab in the address"), Anchor(id: "pass-a-store-s-value-to-a-component-as-a-prop", label: "Pass a store's value to a component as a prop"), Anchor(id: "count-down", label: "Count down"), Anchor(id: "sign-in-with-a-session-cookie", label: "Sign in with a session cookie"), Anchor(id: "load-more", label: "Load more"), Anchor(id: "keep-filters-in-the-address", label: "Keep filters in the address"), Anchor(id: "add-a-dark-mode-switch", label: "Add a dark-mode switch"), Anchor(id: "copy-to-the-clipboard", label: "Copy to the clipboard"), Anchor(id: "draw-a-chart-from-a-library", label: "Draw a chart from a library"), Anchor(id: "where-to-go-next", label: "Where to go next")], prevTo: "/docs/tutorials/pocket", prevLabel: t("ch.07"), nextTo: "/docs/guide/language-basics", nextLabel: t("ch.09"))) {
    Stack(gap: .lg) {
        Markdown("These are smaller pieces that most projects need. Each is a whole page you can build and adapt.")

        Heading("Debounce a search", id: "debounce-a-search").h2

        Markdown("To wait until the reader stops typing before you search, keep what they typed apart from what you search for:")

        CodeBlock(#"page Search(path: "/", title: "Search", description: "Search as you type, without a request per key.") {
    state typed = ""
    state q = ""
    action commit(value: String) { if value == typed { q = value } }
    effect {
        let pending = typed
        setTimeout(() => commit(pending), 300)
    }
    resource hits = fetch("/api/search?q={q}")
    Heading("Search").h1
    Input(bind: typed, placeholder: "Search", aria-label: "Search")
    match hits {
        loading { Spinner.sm }
        error(e) { Text(e.message).danger }
        ready(list) { Text("{list.length} results for {q}") }
    }
}"#, title: "wf")

        Markdown("The effect runs again on every keystroke, and each run schedules a check. Only the check whose value is still current writes `q`, and the resource follows `q`. The timer is the browser's `setTimeout`, because `after(ms)` is a declaration with a body, not a statement an effect can hold.")

        Heading("Page through results", id: "page-through-results").h2

        Markdown("To show a long list a page at a time, keep the page number in state and splice it into the address:")

        CodeBlock(#"page Rows(path: "/", title: "Rows", description: "Every row, twenty at a time.") {
    state page = 1
    state perPage = 20
    resource rows = fetch("/api/rows?page={page}&per={perPage}")
    Heading("Rows").h1
    match rows {
        loading { Spinner }
        error(e) { Text(e.message).danger }
        ready(r) {
            for row in r.items by row.id { Text(row.name) }
            Row(gap: .sm, align: .center) {
                Button("Previous", disabled: page == 1) { on click { page = page - 1 } }
                Text("Page {page} of {r.pages}")
                Button("Next", disabled: page >= r.pages) { on click { page = page + 1 } }
            }
        }
    }
}"#, title: "wf")

        Markdown("A change of `page` changes the address, so the resource asks again.")

        Heading("Update at once, and roll back on failure", id: "update-at-once-and-roll-back-on-failure").h2

        Markdown("To show a change before the server agrees, keep the old value and put it back if the request fails:")

        CodeBlock(#"type Item { id: String, liked: Bool }

page Likes(path: "/", title: "Likes", description: "A like that shows at once.") {
    state items: [Item] = [Item(id: "a", liked: false)]
    state error = ""
    action like(id: String) {
        let before = items
        items = items.map(i => if i.id == id { Item(id: i.id, liked: !i.liked) } else { i })
        try {
            await fetch("/api/like/{id}", { method: "POST" })
        } catch e {
            items = before
            error = "Could not save. Try again."
        }
    }
    Heading("Likes").h1
    for i in items by i.id {
        Button(if i.liked { "♥" } else { "♡" }, aria-label: "Like").sm { on click { like(i.id) } }
    }
    if error != "" { Toast(error).danger }
}"#, title: "wf")

        Markdown("`optimistic(holder, change)` does the same with less code inside an action; see [Fetching data](/docs/guide/data#show-a-change-before-the-server-agrees).")

        Heading("Build a confirm dialog component", id: "build-a-confirm-dialog-component").h2

        Markdown("To ask before a destructive action, wrap a `Dialog` in a component that fires `confirm` or `cancel`:")

        CodeBlock(#"component Confirm(_ title: String, visible: Bool, danger: Bool = false) {
    event confirm()
    event cancel()
    slot
    Dialog(visible: visible, title: title) {
        children
        Row(gap: .sm, justify: .end) {
            Button("Cancel") { on click { emit cancel() } }
            Button("Confirm", tone: if danger { .danger } else { .primary }) { on click { emit confirm() } }
        }
    }
}

page Account(path: "/", title: "Account", description: "Close your account.") {
    state asking = false
    state gone = false
    Heading("Account").h1
    Button("Delete account").danger { on click { asking = true } }
    Confirm("Delete your account?", visible: asking, danger: true) {
        on confirm { gone = true  asking = false }
        on cancel { asking = false }
        Text("Everything goes. This cannot be undone.")
    }
    if gone { Alert("Account deleted.").info }
}"#, title: "wf")

        Markdown("The caller's block fills the default slot, so the question's detail is the caller's to write.")

        Heading("Make navigation responsive", id: "make-navigation-responsive").h2

        Markdown("To show links on a wide screen and a menu button on a narrow one, branch on `viewport`:")

        CodeBlock(#"page Nav(path: "/", title: "Home", description: "Navigation that fits the screen.") {
    state open = false
    Heading("Home").h1
    if viewport.md {
        Row(gap: .md) {
            Link("Home", to: "/")
            Link("Docs", to: "/docs")
            Link("Pricing", to: "/pricing")
        }
    } else {
        IconButton(icon: "menu", label: "Open navigation") { on click { open = !open } }
        show open {
            Stack(gap: .sm, animate: .slideDown) {
                Link("Home", to: "/")
                Link("Docs", to: "/docs")
                Link("Pricing", to: "/pricing")
            }
        }
    }
}"#, title: "wf")

        Heading("Show validation messages on a form", id: "show-validation-messages-on-a-form").h2

        Markdown("To check a form as the reader fills it in, put a `validate` block beside each state:")

        CodeBlock(#"page Signup(path: "/", title: "Sign up", description: "Make an account.") {
    state email = ""
    state password = ""
    state confirm = ""
    state sent = false
    validate email { required  email "Enter a valid email" }
    validate password { required  minLength(8) "At least 8 characters" }
    validate confirm { matches(password) "The passwords differ" }
    Heading("Sign up").h1
    Form(bind: form) {
        on submit { sent = true  form.reset() }
        Input(bind: email, name: "email", label: "Email").email
        Input(bind: password, name: "password", label: "Password").password
        Input(bind: confirm, name: "confirm", label: "Confirm password").password
        Button("Create account", type: .submit, disabled: !form.valid).primary
    }
    if sent { Alert("Welcome aboard.").success }
}"#, title: "wf")

        Markdown("Each control shows its own message when the reader leaves it, and a submit that fails moves focus to the first problem. [Forms](/docs/guide/forms) lists every rule.")

        Heading("Keep the active tab in the address", id: "keep-the-active-tab-in-the-address").h2

        Markdown("To make a tab survive a reload, read it from `hash`:")

        CodeBlock(#"page Account(path: "/account", title: "Account", description: "Your profile and billing.") {
    derived tab = if hash != "" { hash } else { "profile" }
    Heading("Account").h1
    Row(gap: .sm) {
        Link("Profile", to: "/account#profile")
        Link("Billing", to: "/account#billing")
    }
    if tab == "profile" { Text("Profile settings") }
    if tab == "billing" { Text("Billing settings") }
}"#, title: "wf")

        Heading("Pass a store's value to a component as a prop", id: "pass-a-store-s-value-to-a-component-as-a-prop").h2

        Markdown("A component that needs only one value from a store can take it as a prop instead of using the store. That keeps the component reusable outside that store:")

        CodeBlock(#"store Cart { state count = 0 }

component CartBadge(count: Number) {
    if count > 0 { Badge("{count}").primary }
}

page Shop(path: "/", title: "Shop", description: "Everything we sell.") {
    use Cart
    Heading("Shop").h1
    CartBadge(count: Cart.count)
}"#, title: "wf")

        Heading("Count down", id: "count-down").h2

        Markdown("To count down once a second, change a state in an `every` timer:")

        CodeBlock(#"page Countdown(path: "/", title: "Countdown", description: "Ten seconds, counted down.") {
    state left = 10
    every(1000) { if left > 0 { left = left - 1 } }
    Heading("Countdown").h1
    Progress(value: 10 - left, max: 10)
    Text(if left == 0 { "Done" } else { "{left}s" })
}"#, title: "wf")

        Markdown("The timer stops when the page leaves.")

        Heading("Sign in with a session cookie", id: "sign-in-with-a-session-cookie").h2

        Markdown("To sign a reader in without holding a token in the page, describe the service with `credentials: .sameOrigin` and keep the user in a store:")

        CodeBlock(#"type User { id: String, name: String }

api Auth(base: "/api") {
    credentials: .sameOrigin
    get me() -> User
    post signIn(body: Map) -> User
        errors { 401 -> Map }
    post signOut()
}

store Session {
    state user: User? = null
    state checked = false
    derived signedIn = user != null
    action load() {
        try { user = await Auth.me() } catch e { user = null }
        checked = true
    }
    action signIn(email: String, password: String) {
        user = await Auth.signIn(body: { email: email, password: password })
        navigate("/account")
    }
    action signOut() {
        await Auth.signOut()
        user = null
        navigate("/")
    }
}

page SignIn(path: "/sign-in", title: "Sign in", description: "Sign in to your account.", noindex: true) {
    state email = ""
    state password = ""
    state problem = ""
    validate email { required  email }
    validate password { required }
    action send() {
        problem = ""
        try { await Session.signIn(email, password) } catch e { problem = "That email and password do not match." }
    }
    Heading("Sign in").h1
    if problem != "" { Alert(problem).danger }
    Form(bind: form) {
        on submit { send() }
        Input(bind: email, label: "Email").email
        Input(bind: password, label: "Password").password
        Button("Sign in", type: .submit, disabled: send.pending).primary
    }
}

page Account(path: "/account", title: "Your account", description: "Your account.", guard: Session.signedIn, redirect: "/sign-in") {
    use Session
    Heading("Your account").h1
    if let u = Session.user { Text("Signed in as {u.name}") }
    Button("Sign out") { on click { Session.signOut() } }
}"#, title: "wf")

        Markdown("The session is an httpOnly cookie the server sets, so the page never holds a token. `guard:` hides the page from a reader who is signed out, and the server still checks every request ([Security](/docs/guide/security#keep-the-session-in-a-cookie)). Call `Session.load()` from the app's set-up, so a returning reader is signed in.")

        Heading("Load more", id: "load-more").h2

        Markdown("To add the next page of results below the ones shown, call an endpoint with `paginate: .page`:")

        CodeBlock(#"type Item { id: String, name: String }

api Catalog(base: "/api") {
    get items(page: Number = 1) -> [Item]
}

page Items(path: "/items", title: "Items", description: "Everything, a page at a time.") {
    state page = 1
    resource list = Catalog.items(page: page, paginate: .page)
    Heading("Items").h1
    for item in list.items by item.id { Text(item.name) }
    if list.hasMore {
        Button("Load more", disabled: list.state == "loading") { on click { list.loadMore() } }
    }
}"#, title: "wf")

        Markdown("`list.items` is every item loaded so far, and `list.loadMore()` asks for the next page.")

        Heading("Keep filters in the address", id: "keep-filters-in-the-address").h2

        Markdown("To make a filter survive a reload, a shared link and the back button, read it from `query` instead of holding it in a `state`:")

        CodeBlock(#"page Products(path: "/products", title: "Products", description: "Everything we sell.") {
    derived sort = query.sort ?? "name"
    Heading("Products").h1
    Row(gap: .sm) {
        Link("By name", to: "/products?sort=name")
        Link("By price", to: "/products?sort=price")
    }
    Text("Sorted by {sort}")
}"#, title: "wf")

        Heading("Add a dark-mode switch", id: "add-a-dark-mode-switch").h2

        Markdown("To let the reader pick light, dark or the system's choice, call `setTheme` and read `theme`:")

        CodeBlock(#"page Settings(path: "/settings", title: "Settings", description: "How the site looks.") {
    Heading("Settings").h1
    Row(gap: .sm) {
        Button("Light", outlined: theme != "light") { on click { setTheme("light") } }
        Button("Dark", outlined: theme != "dark") { on click { setTheme("dark") } }
        Button("Match the system", outlined: theme != "system") { on click { setTheme("system") } }
    }
}"#, title: "wf")

        Markdown("The switch needs a dark theme named in the config ([Styling](/docs/guide/styling#dark-mode)).")

        Heading("Copy to the clipboard", id: "copy-to-the-clipboard").h2

        Markdown("To copy text, call the browser's clipboard from an action:")

        CodeBlock(#"page Share(path: "/share", title: "Share", description: "Copy the link.") {
    state copied = false
    action copy(text: String) {
        await navigator.clipboard.writeText(text)
        copied = true
    }
    Heading("Share").h1
    Button("Copy the link") { on click { copy(location.href) } }
    if copied { Toast("Copied").success }
}"#, title: "wf")

        Heading("Draw a chart from a library", id: "draw-a-chart-from-a-library").h2

        Markdown("To use a charting library, list its URL in `meta.scripts`, call it from a script of your own, and hand it a canvas with `Host`. The full example is in [JavaScript interop](/docs/guide/interop#load-a-library-from-a-cdn).")

        Heading("Where to go next", id: "where-to-go-next").h2

        Markdown("- The [components reference](/docs/reference), for every prop and flag.\n- `examples/` in the repository: the tutorials, reference PDFs and slide decks, and the `tests/fixtures/` projects — a gallery, a dashboard, a docs site, an offline site — each complete.\n- `wf docs` in your own project, for what *your* components take.")
    }
}
