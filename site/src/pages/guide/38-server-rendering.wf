/// Chapter 38 of the guide, written from md-docs/recipes/server-rendering.md by
/// scripts/docsite/guide.py; edit the guide, not this file.
page ServerRenderingGuide(path: "/docs/guide/server-rendering", title: "Server rendering", description: "Use WebFluent as a template engine: wf render, the Rust API and the Node binding, with HTML, fragment and PDF output, pages, themes and data.", layout: DocsShell("Server rendering", kind: .howto, chapter: t("nav.group.outputs"), blurb: "Render a .wf template with JSON on a server — an email, an invoice, a report, an HTML fragment — from the CLI, Rust or Node.", source: "md-docs/recipes/server-rendering.md", sections: [Anchor(id: "before-you-start", label: "Before you start"), Anchor(id: "write-a-template-and-its-data", label: "Write a template and its data"), Anchor(id: "render-from-the-command-line", label: "Render from the command line"), Anchor(id: "render-from-rust", label: "Render from Rust"), Anchor(id: "render-from-node", label: "Render from Node"), Anchor(id: "what-a-template-may-use", label: "What a template may use"), Anchor(id: "pick-an-output-for-the-job", label: "Pick an output for the job"), Anchor(id: "troubleshooting", label: "Troubleshooting")], prevTo: "/docs/guide/pdf-and-slides", prevLabel: t("ch.37"), nextTo: "/docs/guide/interop", nextLabel: t("ch.39"))) {
    Stack(gap: .lg) {
        Markdown("This chapter shows you how to render a `.wf` template with JSON data on a server — an email, an invoice PDF per order, a fragment for an existing page — from the command line, from Rust or from Node.\n\nA WebFluent site is static files, and most projects need nothing more. When HTML or a PDF has to be made on a server for each request or each record, the same language works as a *template engine*: you hand it a template and data, and it hands back HTML or PDF bytes. Nothing runs in a browser afterwards.")

        Heading("Before you start", id: "before-you-start").h2

        Markdown("You need the `wf` command installed ([Getting started](/docs/guide/getting-started#install)). For the Rust API you need a Rust project; for the Node binding, Node.js and npm.")

        Heading("Write a template and its data", id: "write-a-template-and-its-data").h2

        Markdown("A template is a `.wf` file with a `page`. The data's top-level keys are in scope by name, so the template reads `number`, `customer` and `items` without declaring them. This invoice template shows a table of items and a badge for whether it is paid:")

        CodeBlock(#"page Invoice(path: "/", title: "Invoice", description: "An invoice.") {
    Heading("Invoice #{number}").h1
    Text("Bill to: {customer.name}")
    Table {
        Table.Head { Table.Row { Table.Cell("Item")  Table.Cell("Qty")  Table.Cell("Amount") } }
        Table.Body {
            for item in items {
                Table.Row {
                    Table.Cell(item.name)
                    Table.Cell("{item.qty}")
                    Table.Cell(format(item.price * item.qty, .currency))
                }
            }
        }
    }
    if paid { Badge("Paid").success } else { Badge("Due").warning }
    Text("Total: {format(total, .currency)}").bold.lg
}"#, title: "wf")

        Markdown("The data is a JSON object, saved here as `invoice.json`:")

        CodeBlock(#"{
  "number": "INV-001",
  "customer": { "name": "Acme Corp" },
  "items": [{ "name": "Widget", "qty": 5, "price": 9.99 }],
  "total": 49.95,
  "paid": false,
  "locale": "en"
}"#, title: "json")

        Markdown("Rendered, the page reads `Invoice #INV-001`, `Bill to: Acme Corp`, one table row (`Widget`, `5`, `$49.95`), the badge `Due` and `Total: $49.95`.\n\nA template uses the static subset of the language: no handlers, stores, `resource` or motion (see [What a template may use](#what-a-template-may-use)).")

        Heading("Render from the command line", id: "render-from-the-command-line").h2

        Markdown("To render a template, run `wf render` with the template and its data:")

        Terminal(lines: [
                Line(command: "wf render invoice.wf --data invoice.json --format html-fragment")
            ])

        Markdown("The command prints the markup to standard output. Its options:")

        Table(caption: "Render from the command line") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("What it does").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`--data FILE`") }
                    Table.Cell("The JSON data. When it is omitted, the data is read from standard input")
                }
                Table.Row {
                    Table.Cell { Markdown("`--format`, `-f`") }
                    Table.Cell { Markdown("`html` (a whole document with its CSS; the default), `html-fragment` (the body only), `pdf` or `slides`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`-o FILE`, `--output`") }
                    Table.Cell("Writes to a file instead of printing")
                }
                Table.Row {
                    Table.Cell { Markdown("`--theme Name`") }
                    Table.Cell { Markdown("Picks one of several `theme` declarations") }
                }
                Table.Row {
                    Table.Cell { Markdown("`--token NAME=VALUE`") }
                    Table.Cell("Sets a design token over the theme's; repeat it for more")
                }
                Table.Row {
                    Table.Cell { Markdown("`--lang ar`") }
                    Table.Cell { Markdown("Sets the document's language, `<html lang>` (default: the page's `lang:`, else `en`)") }
                }
                Table.Row {
                    Table.Cell { Markdown("`--page Name`") }
                    Table.Cell("Chooses the page to render when the template has several")
                }
            }
        }

        Markdown("The template may also be a directory. Every `.wf` and `.wfx` file under it renders as one template, with components shared, and `--page Name` chooses the page. This command renders the `Invoice` page of `templates/` to a PDF, in Arabic:")

        Terminal(lines: [
                Line(command: "wf render templates/ --page Invoice --lang ar --data invoice.json --format pdf -o invoice.pdf")
            ])

        Markdown("A template that names a component nothing declares, or a flag a component does not take, is refused, as a build would refuse it.")

        Heading("Render from Rust", id: "render-from-rust").h2

        Markdown("The template engine is the `webfluent` crate. To use it without the `wf` command's own dependencies (its argument parser and dev server), turn off the default features:")

        CodeBlock(#"[dependencies]
webfluent = { version = "6", default-features = false }
serde = { version = "1", features = ["derive"] }"#, title: "toml")

        Markdown("Load the templates once, at start-up, and render on every request. This code loads a directory of templates and renders its `Invoice` page three ways:")

        CodeBlock(#"use serde::Serialize;
use webfluent::{PdfConfig, Template};

#[derive(Serialize)]
struct Customer { name: String }

#[derive(Serialize)]
struct Item { name: String, qty: u32, price: f64 }

#[derive(Serialize)]
struct Invoice { number: u32, customer: Customer, items: Vec<Item>, total: f64, paid: bool }

// Every .wf and .wfx under the directory, as one template: components,
// themes, types and constants shared; each `page` a document.
let templates = Template::from_dir("templates")?;
let invoice: Invoice = load_invoice();

let html = templates.page("Invoice")?.render_html(&invoice)?;          // a whole document
let body = templates.page("Invoice")?.render_html_fragment(&invoice)?; // the markup alone
let pdf: Vec<u8> = templates
    .page("Invoice")?
    .with_pdf(PdfConfig { page_size: "Letter".into(), ..PdfConfig::default() })
    .render_pdf(&invoice)?;"#, title: "rust")

        Markdown("To try it, run `cargo run --example invoice` in the WebFluent repository. The example renders a directory of templates to HTML, a fragment and a PDF.")

        Heading("Load templates", id: "load-templates").h3

        Markdown("Each loader parses and checks the template once. An error names the file and the line.")

        Table(caption: "Load templates") {
            Table.Head {
                Table.Row {
                    Table.Cell("Loader").header
                    Table.Cell("Reads").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`Template::from_str(source)`") }
                    Table.Cell("One template from a string")
                }
                Table.Row {
                    Table.Cell { Markdown("`Template::from_file(path)`") }
                    Table.Cell { Markdown("One file; a `.wfx` file is read in its indented layout") }
                }
                Table.Row {
                    Table.Cell { Markdown("`Template::from_files(&[..])`") }
                    Table.Cell("Several files, as one template")
                }
                Table.Row {
                    Table.Cell { Markdown("`Template::from_dir(dir)`") }
                    Table.Cell { Markdown("Every `.wf` and `.wfx` under a directory, as one template") }
                }
                Table.Row {
                    Table.Cell { Markdown("`Template::from_sources(&[(name, source), ..])`") }
                    Table.Cell { Markdown("Templates embedded in the binary with `include_str!`") }
                }
            }
        }

        Markdown("`pages()` lists the template's pages, and `page(name)` picks one. Without `page(name)`, every page of the template renders. A name the template does not have is an error that lists the pages it does have:")

        CodeBlock(#"no page called `Receipt`; the template has `Invoice`"#, title: "text")

        Heading("Pass data", id: "pass-data").h3

        Markdown("The data is anything `serde` serializes: your own `#[derive(Serialize)]` structs, or a `serde_json::Value`. Its top-level fields are the names the template reads. A `const` and a `data` file are in scope too.")

        Heading("Choose the output", id: "choose-the-output").h3

        Table(caption: "Choose the output") {
            Table.Head {
                Table.Row {
                    Table.Cell("Method").header
                    Table.Cell("Returns").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`render_html`") }
                    Table.Cell { Markdown("A whole document: `<html lang>`, a `<title>` from the page's (its `\{…\}` filled from the data), and the CSS in a `<style>` block") }
                }
                Table.Row {
                    Table.Cell { Markdown("`render_html_parts`") }
                    Table.Cell("The CSS and the markup separately, for a server that links its stylesheet and keeps a strict Content-Security-Policy")
                }
                Table.Row {
                    Table.Cell { Markdown("`render_html_fragment`") }
                    Table.Cell("The markup alone")
                }
                Table.Row {
                    Table.Cell { Markdown("`render_pdf`, `render_slides`") }
                    Table.Cell { Markdown("PDF bytes, laid out by the paged engine of [PDF and slides](/docs/guide/pdf-and-slides)") }
                }
                Table.Row {
                    Table.Cell { Markdown("`render_pdf_report`, `render_slides_report`") }
                    Table.Cell { Markdown("A `PdfReport`: the bytes, the page count, each page's text in reading order, and the notes (a font taken from the machine, a character no font had)") }
                }
            }
        }

        Markdown("A `PdfReport`'s page text lets a test hold a document to what it says. A template loaded from files reads its fonts from `fonts/` beside it, and its pictures from there too.")

        Heading("Configure a render", id: "configure-a-render").h3

        Markdown("Each setting returns the `Template`, so you can chain them before a render:\n\n- `with_theme(name)` picks a theme;\n- `with_tokens(&[(name, value)])` sets design tokens over the theme's;\n- `with_lang(\"ar\")` sets the language (a right-to-left language also sets `dir=\"rtl\"`); without it, the page's own `lang:` is used, else `en`;\n- `with_pdf(PdfConfig \{ .. \})` sets page size, margins and fonts;\n- `with_slides(SlidesConfig \{ .. \})` sets a deck's options.")

        Heading("Use it in a server", id: "use-it-in-a-server").h3

        Markdown("A `Template` is `Send + Sync` and cheap to clone, because the parsed program is shared. Keep it in your framework's state — an `Arc`, or a clone per handler — and render from any thread. A render takes tens of microseconds.")

        Callout("Every value the data supplies is escaped as text. A URL from the data that a browser would run — `javascript:`, `data:` — is dropped from `href` and `src`, as the browser build drops it. An `Image`'s `src` keeps a picture carried in its address (`data:image/png;base64,…`), as the browser build keeps it.\n\nA value the data puts in a `style \{ \}` block is one value, as the live page sets one property at a time: a piece with a `;`, a brace or a backslash, or one that fetches something (`url(…)`, `image-set(…)`), leaves its declaration out. What the template writes around a splice — `background: url(\{img\})` — is the template's own. A `class:` from the data is escaped inside its attribute.", kind: .note)

        Heading("Limits of one render", id: "limits-of-one-render").h3

        Markdown("A render is bounded, so one request cannot take a server with it:")

        Table(caption: "Limits of one render") {
            Table.Head {
                Table.Row {
                    Table.Cell("Limit").header
                    Table.Cell("What is past it").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell("100 levels of nesting — elements, and the components they place, counted together")
                    Table.Cell { Markdown("`E120`") }
                }
                Table.Row {
                    Table.Cell("10,000,000 steps — elements drawn, loop items, units of working a value out")
                    Table.Cell { Markdown("`E121`") }
                }
                Table.Row {
                    Table.Cell("256 MB of markup")
                    Table.Cell { Markdown("`E121`") }
                }
                Table.Row {
                    Table.Cell("About 500,000 list items or 32 MB of text made by one expression")
                    Table.Cell { Markdown("`E121`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`>` quotes in `Markdown` nested 32 deep") }
                    Table.Cell { Markdown("The deeper `>` is shown as text") }
                }
                Table.Row {
                    Table.Cell { Markdown("A precision past 100 digits (`toFixed`, `format(…, .decimal, n)`)") }
                    Table.Cell { Markdown("`toFixed` shows nothing, as the browser throws; `format` writes 100") }
                }
            }
        }

        Markdown("Each error is a `WebFluentError::Diagnostics` naming the code and the element where the render stopped.")

        Heading("Render from Node", id: "render-from-node").h2

        Markdown("The Node binding is a small wrapper around `wf render`. Install it with npm:")

        Terminal(lines: [
                Line(command: "npm install webfluent")
            ])

        Markdown("The binding needs `wf` itself installed. It looks for it at `WF_BIN`, then on `PATH`, then in `~/.webfluent/bin` and `~/.cargo/bin` (and, outside Windows, `/usr/local/bin` and `/usr/bin`). Its version is the compiler's.\n\nThis Express app renders an invoice as HTML and as a PDF:")

        CodeBlock(#"const { Template } = require("webfluent");

const templates = Template.fromDir("templates");          // or fromFile, fromString
const invoice = templates.page("Invoice");

app.get("/invoices/:id", async (req, res) => {
  const data = await loadInvoice(req.params.id);
  res.send(await invoice.renderHtmlAsync(data));
});
app.get("/invoices/:id.pdf", async (req, res) => {
  res.type("application/pdf").send(await invoice.renderPdfAsync(await loadInvoice(req.params.id)));
});"#, title: "js")

        Markdown("Every render has a synchronous form (`renderHtml`, `renderHtmlFragment`, `renderPdf`, `renderSlides`) and an `…Async` form that does not block the event loop. Use the `…Async` forms in a server. `withTheme`, `withTokens` and `withLang` set what the Rust API sets.\n\nA render runs `wf` once and takes a few milliseconds. The data goes over standard input, so nothing is written to disk.")

        Heading("What a template may use", id: "what-a-template-may-use").h2

        Markdown("A template uses the static subset of the language, because there is no browser to run the rest:")

        Table(caption: "What a template may use") {
            Table.Head {
                Table.Row {
                    Table.Cell("Supported").header
                    Table.Cell("Not supported").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell("Every layout, typography and data-display element")
                    Table.Cell { Markdown("`effect`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`for` loops, `if`/`else`, string interpolation") }
                    Table.Cell { Markdown("Handlers (`on click`)") }
                }
                Table.Row {
                    Table.Cell { Markdown("`format` and `ago`") }
                    Table.Cell("Navigation")
                }
                Table.Row {
                    Table.Cell { Markdown("`style \{ \}` blocks, flags, themes") }
                    Table.Cell("Stores")
                }
                Table.Row {
                    Table.Cell { Markdown("`type`s, `const`s, `data` files and components") }
                    Table.Cell("Animations")
                }
                Table.Row {
                    Table.Cell { Markdown("`state` and `derived` values (see below)") }
                    Table.Cell { Markdown("`resource`") }
                }
            }
        }

        Markdown("A `state` is its first value, and a `derived` value is what that works out to. So a page may work out its totals once, in order, and show them anywhere. A value the data hands over wins over either.\n\nA template may declare `type`s and a `theme` like any file. `data` files are read relative to the template. `format` and `ago` speak the data's `locale` key when it has one, and English otherwise.\n\nA template may read private `env` names ([Environments](/docs/guide/environments)): it runs on your server, where a secret stays secret.")

        Heading("Pick an output for the job", id: "pick-an-output-for-the-job").h2

        Table(caption: "Pick an output for the job") {
            Table.Head {
                Table.Row {
                    Table.Cell("Job").header
                    Table.Cell("Output").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell("An email")
                    Table.Cell { Markdown("`--format html`; inline the styles with your mailer if it needs them") }
                }
                Table.Row {
                    Table.Cell("Invoices and reports")
                    Table.Cell { Markdown("`--format pdf`, one per record, from a job queue") }
                }
                Table.Row {
                    Table.Cell("A piece of an existing page — an HTMX response, a CMS block")
                    Table.Cell { Markdown("`--format html-fragment`") }
                }
            }
        }

        Heading("Troubleshooting", id: "troubleshooting").h2

        Table(caption: "Troubleshooting") {
            Table.Head {
                Table.Row {
                    Table.Cell("What you see").header
                    Table.Cell("What to do").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell("The render fails with \"no page called …\"")
                    Table.Cell { Markdown("Pass one of the page names the message lists to `page(name)` or `--page`") }
                }
                Table.Row {
                    Table.Cell("A render refuses a component or a flag")
                    Table.Cell { Markdown("Declare the component in the template's files, or use a flag the component takes — the same checks as `wf build`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`WebFluent CLI (wf) not found` from Node") }
                    Table.Cell { Markdown("Install `wf`, or set `WF_BIN` to the binary's path") }
                }
                Table.Row {
                    Table.Cell { Markdown("A `\{name\}` renders empty") }
                    Table.Cell { Markdown("The data has no top-level key `name`; check the JSON's spelling and nesting") }
                }
                Table.Row {
                    Table.Cell { Markdown("`format` writes the wrong language") }
                    Table.Cell { Markdown("Add a `locale` key to the data") }
                }
                Table.Row {
                    Table.Cell { Markdown("The render fails with `E120` or `E121`") }
                    Table.Cell { Markdown("The template nests too deeply, or the render does too much; see [Limits of one render](#limits-of-one-render)") }
                }
            }
        }
    }
}
