/// Chapter 3 of the guide, written from md-docs/03-pages-and-routing.md by
/// scripts/site-from-guide.py; edit the guide, not this file.
page PagesAndRouting(path: "/docs/guide/pages-and-routing", title: "Pages and routing", description: "Page attributes, routes and parameters, layouts, the app shell, per-page head tags and the 404 page.", layout: DocsShell("Pages and routing", chapter: "Chapter 3", blurb: "A page is a route and what it shows. Pages own their paths; the app shell frames them; a layout wraps them.", sections: [Anchor(id: "declaring-a-page", label: "Declaring a page"), Anchor(id: "the-app-shell", label: "The app shell"), Anchor(id: "links-and-navigation", label: "Links and navigation"), Anchor(id: "route-parameters", label: "Route parameters"), Anchor(id: "layouts", label: "Layouts"), Anchor(id: "guards", label: "Guards"), Anchor(id: "per-page-head-tags", label: "Per-page head tags"), Anchor(id: "the-catch-all-page", label: "The catch-all page"), Anchor(id: "where-the-code-runs", label: "Where the code runs")], prevTo: "/docs/guide/language-basics", prevLabel: "2. Language basics", nextTo: "/docs/guide/elements", nextLabel: "4. Elements")) {
    Stack(gap: .lg) {
        Markdown("A page is a route and what it shows. Pages own their paths: there is no route table to keep in step with them.")

        Heading("Declaring a page", id: "declaring-a-page").h2

        CodeBlock("page About(path: \"/about\", title: \"About us\", description: \"Who we are and why we build this.\") \{\n    Container \{\n        Heading(\"About us\").h1\n        Paragraph(\"We are three people and a dog.\")\n    \}\n\}", title: "wf")

        Markdown("The header takes these attributes:")

        Table(caption: "Declaring a page") {
            Table.Head {
                Table.Row {
                    Table.Cell("Attribute").header
                    Table.Cell("Required").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`path:`") }
                    Table.Cell("yes")
                    Table.Cell { Markdown("The route: `\"/\"`, `\"/about\"`, `\"/posts/:slug\"`, or `\"*\"` for the catch-all") }
                }
                Table.Row {
                    Table.Cell { Markdown("`title:`") }
                    Table.Cell("strongly")
                    Table.Cell { Markdown("The `<title>`, the history entry, what a screen reader announces on arrival") }
                }
                Table.Row {
                    Table.Cell { Markdown("`description:`") }
                    Table.Cell("strongly")
                    Table.Cell("The meta description and the snippet a search result and a link preview show (~150 characters)")
                }
                Table.Row {
                    Table.Cell { Markdown("`image:`") }
                    Table.Cell("")
                    Table.Cell("The image a shared link previews with, site-relative or absolute")
                }
                Table.Row {
                    Table.Cell { Markdown("`type:`") }
                    Table.Cell("")
                    Table.Cell { Markdown("`og:type` — `website` (default) or `article`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`noindex:`") }
                    Table.Cell("")
                    Table.Cell { Markdown("`true` keeps the page out of search results and the sitemap") }
                }
                Table.Row {
                    Table.Cell { Markdown("`layout:`") }
                    Table.Cell("")
                    Table.Cell("The component that frames the page (below)")
                }
                Table.Row {
                    Table.Cell { Markdown("`guard:`") }
                    Table.Cell("")
                    Table.Cell("An expression that must hold for the route to render")
                }
                Table.Row {
                    Table.Cell { Markdown("`redirect:`") }
                    Table.Cell("")
                    Table.Cell { Markdown("Where the reader goes when the guard fails (default `/`)") }
                }
                Table.Row {
                    Table.Cell { Markdown("`paths:`") }
                    Table.Cell("")
                    Table.Cell { Markdown("The values a static build renders a `:param` page for (chapter 14)") }
                }
                Table.Row {
                    Table.Cell { Markdown("`name: Type`") }
                    Table.Cell("")
                    Table.Cell("A route parameter, typed (below)")
                }
            }
        }

        Markdown("A page without a `title` or `description` builds with a warning (`S01`, `S02`); the compiler cannot write those for you, and a page without them ships unshareable.")

        Heading("The app shell", id: "the-app-shell").h2

        Markdown("`app` declares what every page renders inside — a navbar, a footer, the `Router` where the current page goes:")

        CodeBlock("app \{\n    Navbar \{\n        Navbar.Brand \{ Link(\"Acme\", to: \"/\") \}\n        Navbar.Links \{\n            Link(\"Docs\", to: \"/docs\").prefix\n            Link(\"Pricing\", to: \"/pricing\")\n        \}\n        Navbar.Actions \{ Button(\"Sign in\").sm \{ on click \{ navigate(\"/login\") \} \} \}\n    \}\n    Router\n    Footer \{ Text(\"© Acme\").muted.sm \}\n\}", title: "wf")

        Markdown("`Router` is bare — it takes no children — and the table is built from every page's `path`, ordered by specificity (static segments before `:params`, `*` last), so declaration order can never shadow a route. A project with no `app` declaration gets a bare router.\n\n`Router(transition: .fade, duration: \"200ms\")` animates page changes (chapter 13).")

        Heading("Links and navigation", id: "links-and-navigation").h2

        CodeBlock("page Nav(path: \"/nav\") \{\n    Link(\"Home\", to: \"/\")                       // an <a>; the router handles the click\n    Link(\"Guide\", to: \"/docs\").prefix           // also active on /docs/anything\n    Button(\"Go\") \{ on click \{ navigate(\"/about\") \} \}\n\}", title: "wf")

        Markdown("The link whose `to:` matches the current route carries the class `.active` and `aria-current=\"page\"`; `.prefix` makes a section link active for the routes beneath it. `navigate(path)` moves in code. In a static build, links are real page loads and `navigate` is too; in a single-page app they swap pages without a reload, move focus to the new page's heading, reset the scroll and announce the title.")

        Heading("Route parameters", id: "route-parameters").h2

        Markdown("A `:name` segment is declared as a typed parameter of the page and read as a plain name, or as `params.name`:")

        CodeBlock("type Post \{ slug: String, title: String, body: String \}\n\nstore Posts \{\n    state all: [Post] = [\n        Post(slug: \"hello\", title: \"Hello\", body: \"First post.\"),\n        Post(slug: \"again\", title: \"Again\", body: \"Second post.\")\n    ]\n\}\n\npage PostPage(path: \"/posts/:slug\", title: \"Post\", description: \"One post.\", slug: String) \{\n    use Posts\n    derived post = Posts.all.find(p => p.slug == slug)\n    if let p = post \{\n        Heading(p.title).h1\n        Paragraph(p.body)\n    \} else \{\n        Heading(\"No such post\").h1\n        Text(\"Nothing lives at /posts/\{params.slug\}.\")\n    \}\n\}", title: "wf")

        Markdown("A parameter is a `String` unless you say otherwise (`id: Number`). A static build renders a `:param` page once per value named in `paths:` — see [Data](/docs/guide/data#static-paths).")

        Heading("Layouts", id: "layouts").h2

        Markdown("A `layout:` is a component with a default slot; the page renders in it. Use it for a section's own chrome — a docs sidebar, an app rail — where the `app` shell is the site's.")

        CodeBlock("component DocsShell(_ crumb: String) \{\n    slot\n    Row(gap: .lg) \{\n        Sidebar \{\n            Sidebar.Item(to: \"/docs\") \{ Text(\"Guide\") \}\n            Sidebar.Item(to: \"/docs/reference\") \{ Text(\"Reference\") \}\n        \}\n        Stack \{\n            Breadcrumb \{\n                Breadcrumb.Item(to: \"/docs\") \{ Text(\"Docs\") \}\n                Breadcrumb.Item \{ Text(crumb) \}\n            \}\n            children\n        \}\n    \}\n\}\n\npage Guide(path: \"/docs\", title: \"Guide\", description: \"The guide.\", layout: DocsShell(\"Guide\")) \{\n    Heading(\"Guide\").h1\n\}\n\npage Reference(path: \"/docs/reference\", title: \"Reference\", description: \"The reference.\", layout: DocsShell(\"Reference\")) \{\n    Heading(\"Reference\").h1\n\}", title: "wf")

        Markdown("The layout's arguments are checked like any component call. The layout component is required to declare a `slot` (its default slot); a layout without one is an error, since the page would have nowhere to go.")

        Heading("Guards", id: "guards").h2

        Markdown("`guard:` names an expression — usually a store's derived value — that must be true for the route to render; otherwise the reader is sent to `redirect:`.")

        CodeBlock("store Auth \{\n    state user = null\n    derived loggedIn = user != null\n    action login() \{ user = \{ name: \"Sam\" \} \}\n    action logout() \{ user = null \}\n\}\n\npage Account(path: \"/account\", title: \"Your account\", description: \"Your account.\", guard: Auth.loggedIn, redirect: \"/login\") \{\n    use Auth\n    Heading(\"Welcome back\").h1\n    Button(\"Sign out\") \{ on click \{ Auth.logout() \} \}\n\}\n\npage Login(path: \"/login\", title: \"Sign in\", description: \"Sign in.\") \{\n    use Auth\n    Button(\"Sign in\").primary \{ on click \{ Auth.login()  navigate(\"/account\") \} \}\n\}", title: "wf")

        Markdown("The guard is evaluated on every navigation, in the browser. A static build still pre-renders the page's HTML (the guard is a client-side gate, not a secret), so keep anything private behind an API the page fetches.")

        Heading("Per-page head tags", id: "per-page-head-tags").h2

        Markdown("A page may add tags of its own to the document's `<head>`; they are painted at build time where the value is known, kept current on the live page, and gone when the page is:")

        CodeBlock("page Share(path: \"/share\", title: \"Share\", description: \"A page with its own tags.\") \{\n    state image = \"/og-share.png\"\n    head \{\n        meta(property: \"og:image\", content: image)\n        link(rel: \"canonical\", href: \"https://example.com/share\")\n        script(src: \"/analytics.js\", defer: true)\n    \}\n    Heading(\"Share\").h1\n\}", title: "wf")

        Markdown("`title` and `description` are page attributes, not head tags; the compiler writes the standard tags (charset, viewport, description, canonical, Open Graph, Twitter card, JSON-LD) from them and the config.")

        Heading("The catch-all page", id: "the-catch-all-page").h2

        Markdown("`path: \"*\"` is the page a static host serves as `404.html` and the router shows for a route no page claims:")

        CodeBlock("page NotFound(path: \"*\", title: \"Not found\", description: \"Nothing lives here.\", noindex: true) \{\n    Container \{\n        Heading(\"Nothing here\").h1\n        Link(\"Back home\", to: \"/\")\n    \}\n\}", title: "wf")

        Heading("Where the code runs", id: "where-the-code-runs").h2

        Markdown("A page's body is a render block: it declares state, derived values and actions, and lists what to show. Everything at the top of the body runs once when the page renders; a call at the top — `Store.load(id)` — is set-up code.")

        CodeBlock("store Deploys \{\n    state rows = []\n    action load(id: String) \{ rows = [\{ id: id, ok: true \}] \}\n\}\n\npage Deploy(path: \"/deploys/:id\", title: \"Deploy\", description: \"One deploy.\", id: String) \{\n    use Deploys\n    Deploys.load(id)\n    for row in Deploys.rows by row.id \{\n        Text(\"\{row.id\}: \{row.ok\}\")\n    \}\n\}", title: "wf")
    }
}
