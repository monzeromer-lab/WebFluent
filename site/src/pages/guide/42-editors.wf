/// Chapter 42 of the guide, written from md-docs/reference/editors.md by
/// scripts/docsite/guide.py; edit the guide, not this file.
page EditorsGuide(path: "/reference/editors", title: "Editors", description: "Editor support for WebFluent: what wf-lsp answers, what the VS Code and Zed extensions and the Tree-sitter grammars support, and how to install each.", layout: DocsShell("Editors", kind: .reference, chapter: t("nav.group.reference"), blurb: "The language server, wf-lsp, and what the VS Code and Zed extensions and the Tree-sitter grammars each support.", source: "md-docs/reference/editors.md", sections: [Anchor(id: "the-language-server-wf-lsp", label: "The language server: wf-lsp"), Anchor(id: "vs-code", label: "VS Code"), Anchor(id: "zed", label: "Zed"), Anchor(id: "tree-sitter-grammars", label: "Tree-sitter grammars"), Anchor(id: "other-editors", label: "Other editors")], prevTo: "/reference/library", prevLabel: t("ch.41"))) {
    Stack(gap: .lg) {
        Markdown("This page is the reference for WebFluent's editor support: the language server, `wf-lsp`, and the three repositories built around it. It lists what each one supports and how to install it.")

        Table(caption: "Editors") {
            Table.Head {
                Table.Row {
                    Table.Cell("").header
                    Table.Cell("Repository").header
                    Table.Cell("Highlighting").header
                    Table.Cell("Language server").header
                    Table.Cell("Snippets").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell("VS Code")
                    Table.Cell { Markdown("[webfluent-vscode](https://github.com/monzeromer-lab/webfluent-vscode)") }
                    Table.Cell { Markdown("TextMate grammar, `.wf` and `.wfx`") }
                    Table.Cell { Markdown("runs `wf-lsp`, downloaded and checked if it is not installed") }
                    Table.Cell("no")
                }
                Table.Row {
                    Table.Cell("Zed")
                    Table.Cell { Markdown("[webfluent-zed](https://github.com/monzeromer-lab/webfluent-zed)") }
                    Table.Cell { Markdown("Tree-sitter, `.wf` and `.wfx`") }
                    Table.Cell { Markdown("runs `wf-lsp`, downloaded and checked if it is not installed") }
                    Table.Cell("yes")
                }
                Table.Row {
                    Table.Cell("Any editor with Tree-sitter")
                    Table.Cell { Markdown("[tree-sitter-webfluent](https://github.com/monzeromer-lab/tree-sitter-webfluent)") }
                    Table.Cell("the two grammars")
                    Table.Cell("—")
                    Table.Cell("—")
                }
                Table.Row {
                    Table.Cell("Any editor with LSP")
                    Table.Cell { Markdown("[`crates/wf-lsp`](https://github.com/monzeromer-lab/WebFluent/tree/master/crates/wf-lsp)") }
                    Table.Cell("semantic tokens from the server")
                    Table.Cell { Markdown("`wf-lsp` over standard input and output") }
                    Table.Cell("—")
                }
            }
        }

        Markdown("Every finding, completion and quick fix comes from `wf-lsp`, which is the compiler itself: an editor reports what `wf check` reports.")

        Heading("The language server: wf-lsp", id: "the-language-server-wf-lsp").h2

        Markdown("`wf-lsp` runs the compiler's checks as you type and answers the editor's questions about the code. Keep it at the version of your `wf`; `wf-lsp --version` prints it.\n\nTo install it, download `wf-lsp-<version>-<arch>-<os>` from a [release](https://github.com/monzeromer-lab/WebFluent/releases) and put it on your `PATH`, or build it from a clone of the repository:")

        Terminal(lines: [
                Line(command: "cargo install --path crates/wf-lsp")
            ])

        Markdown("Releases are built for x86_64 Linux, macOS (Apple Silicon and Intel) and x86_64 Windows. Both extensions download the server themselves when it is not on your `PATH`.")

        Heading("What it answers", id: "what-it-answers").h3

        Table(caption: "What it answers") {
            Table.Head {
                Table.Row {
                    Table.Cell("Request").header
                    Table.Cell("What you get").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell("Diagnostics")
                    Table.Cell { Markdown("Every check `wf build` runs, for `.wf`, `.wfx` and Markdown pages, with the code, the place and the fixes. They run again when a file they depend on changes: a translation, a `.env`, a script, a stylesheet, the config or a file in `public/`") }
                }
                Table.Row {
                    Table.Cell("Completion")
                    Table.Cell { Markdown("Components and their props, flags and parts, enum cases, events, `$` tokens, `match` arms, slots, record fields and the methods of each type, a service's endpoints, the keywords each place allows, translation keys and lint codes. In a PDF or slides project it offers only what paper can draw") }
                }
                Table.Row {
                    Table.Cell("Hover")
                    Table.Cell("A component's documentation and signature, a name's inferred type, a field, an endpoint, a case, a keyword or a built-in function")
                }
                Table.Row {
                    Table.Cell("Signature help")
                    Table.Cell("What a call takes, and which argument the cursor is on")
                }
                Table.Row {
                    Table.Cell("Go to definition, references, highlights")
                    Table.Cell { Markdown("For every declaration — a component, a store, a type, a case, a field, a `const`, a `data` file, an animation, an endpoint — and inside a string's `\{…\}` splices") }
                }
                Table.Row {
                    Table.Cell("Rename")
                    Table.Cell("Across the project, after the editor asks whether the name can be renamed")
                }
                Table.Row {
                    Table.Cell("Formatting")
                    Table.Cell { Markdown("`wf fmt`, for the file or a range") }
                }
                Table.Row {
                    Table.Cell("Folding, inlay hints")
                    Table.Cell { Markdown("Blocks fold; an inlay hint shows the type of a `state` or `derived` value written without one") }
                }
                Table.Row {
                    Table.Cell("Semantic tokens")
                    Table.Cell("A name is coloured by what it resolves to: a component, a type, a store, a prop or a state")
                }
                Table.Row {
                    Table.Cell("Document and workspace symbols")
                    Table.Cell("The outline, and a search over the project's declarations")
                }
                Table.Row {
                    Table.Cell("Code actions")
                    Table.Cell { Markdown("The fixes the compiler attaches to a finding (quick fix), all of a file's fixes at once (fix all), and **Extract component**") }
                }
            }
        }

        Markdown("The [command line reference](/reference/cli#wf-lsp) lists each of these in full.")

        Heading("How it finds the project", id: "how-it-finds-the-project").h3

        Markdown("The project root is the nearest folder above the open file that holds `webfluent.app.json`. The server keeps the analysed project between requests and analyses it again only after a change, so a hover answers in about a tenth of a millisecond. It asks the editor to tell it when a `.wf`, `.wfx`, `.md`, `.js`, `.css` or `.json` file, a `.env` or a file in `public/` changes on disk.")

        Heading("VS Code", id: "vs-code").h2

        Markdown("The extension highlights `.wf` and `.wfx` files with a TextMate grammar and runs `wf-lsp` for everything else. It needs VS Code 1.82 or later.\n\nTo install it, download `webfluent-vscode-<version>.vsix` from the extension's [latest release](https://github.com/monzeromer-lab/webfluent-vscode/releases/latest), then run **Extensions: Install from VSIX** and pick the file. It is not on the Marketplace yet.\n\nThe extension looks for the server in this order:\n\n1. the `webfluent.server.path` setting;\n2. `wf-lsp` in an absolute directory on your `PATH`;\n3. `target/release` or `target/debug` in the workspace, only when `webfluent.server.useWorkspaceBuild` is on in your user settings and the workspace is trusted;\n4. the `wf-lsp` of the WebFluent release this version of the extension pins, downloaded for your platform and checked against that release's `SHA256SUMS`. A download that does not match is refused.")

        Table(caption: "VS Code") {
            Table.Head {
                Table.Row {
                    Table.Cell("Setting").header
                    Table.Cell("Default").header
                    Table.Cell("What it does").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`webfluent.server.path`") }
                    Table.Cell { Markdown("`\"\"`") }
                    Table.Cell { Markdown("The `wf-lsp` to run. A workspace's value counts only once you trust the workspace") }
                }
                Table.Row {
                    Table.Cell { Markdown("`webfluent.server.useWorkspaceBuild`") }
                    Table.Cell { Markdown("`false`") }
                    Table.Cell { Markdown("Runs a `wf-lsp` built in the workspace's `target/`, for work on the compiler. Read from user settings only") }
                }
                Table.Row {
                    Table.Cell { Markdown("`webfluent.server.download`") }
                    Table.Cell { Markdown("`true`") }
                    Table.Cell { Markdown("Downloads the pinned release's `wf-lsp` when none is found. Off: highlighting only") }
                }
            }
        }

        Markdown("This user setting runs a server you installed yourself:")

        CodeBlock(#"{
  "webfluent.server.path": "/home/me/.cargo/bin/wf-lsp"
}"#, title: "json")

        Heading("Zed", id: "zed").h2

        Markdown("The extension highlights `.wf` and `.wfx` files with the Tree-sitter grammars and runs `wf-lsp`. From the grammars it also has bracket matching, auto-indent, folding, the outline panel and breadcrumbs, Vim text objects, and highlighting of ` ```wf ` fences in Markdown. Its snippets cover pages, components, stores, state, actions, control flow, resources, style rules, the common built-ins, `persist`, `validate`, `on key`, `api` and `test`.\n\nIt is not in Zed's extension registry yet. To install it, clone [webfluent-zed](https://github.com/monzeromer-lab/webfluent-zed), run **zed: install dev extension** and pick the clone. Zed compiles the extension and the grammars the first time, which takes about a minute.\n\nThe extension looks for the server in this order:\n\n1. `lsp.wf-lsp.binary.path` in your **user** `settings.json`;\n2. `wf-lsp` on your `PATH`;\n3. the WebFluent release this version of the extension pins, downloaded on first use and checked against the release's `SHA256SUMS`;\n4. a copy it downloaded and checked before, when the release cannot be reached.\n\nThis user setting runs a server you installed yourself:")

        CodeBlock(#"{
  "lsp": {
    "wf-lsp": {
      "binary": { "path": "/home/me/.cargo/bin/wf-lsp", "arguments": [] }
    }
  }
}"#, title: "json")

        Markdown("A project's own `.zed/settings.json` cannot choose the program: when it says anything about `lsp.wf-lsp.binary`, every `binary` setting is ignored for that project, and a `binary.path` must be absolute and outside the project. A project may still set `lsp.wf-lsp.settings`.")

        Heading("Tree-sitter grammars", id: "tree-sitter-grammars").h2

        Markdown("[tree-sitter-webfluent](https://github.com/monzeromer-lab/tree-sitter-webfluent) holds two grammars, generated from one source:")

        Table(caption: "Tree-sitter grammars") {
            Table.Head {
                Table.Row {
                    Table.Cell("Grammar").header
                    Table.Cell("Files").header
                    Table.Cell("Folder").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`webfluent`") }
                    Table.Cell { Markdown("`.wf`, blocks in braces") }
                    Table.Cell { Markdown("`webfluent/`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`webfluentx`") }
                    Table.Cell { Markdown("`.wfx`, blocks by indentation") }
                    Table.Cell { Markdown("`webfluentx/`") }
                }
            }
        }

        Markdown("The generated `src/parser.c` files are committed, so an editor builds the parser without the Tree-sitter command. The Zed extension pins a commit of the repository, and the grammars are tested against every sample in this guide.")

        Heading("Other editors", id: "other-editors").h2

        Markdown("Any editor with LSP support runs `wf-lsp` over standard input and output for the `webfluent` file type (`*.wf`, `*.wfx`), with `webfluent.app.json` as the root marker. The command line reference has the configuration for [Neovim](/reference/cli#neovim), [Helix](/reference/cli#helix) and [Emacs](/reference/cli#emacs). For highlighting in an editor that reads Tree-sitter, use the grammars above.\n\n[WebFluent Studio](/learn/01-getting-started#webfluent-studio) is an editor of its own, with the language server, a live preview and a designer in one window.")
    }
}
