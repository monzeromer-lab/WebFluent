/// `/about`, written from the front matter of md-docs/about/ by
/// scripts/docsite/guide.py; edit the pages, not this file.
page AboutIndex(path: "/about", title: "About WebFluent", description: "Why WebFluent works as it does: essays on its design.") {
    SiteHeader(section: "/about")
    Stack(gap: .lg, role: "main", id: "bp-main", tabindex: "-1", class: "bp-main bp-wrap") {
        style { gap: 28px; padding-top: 40px; padding-bottom: 72px; @md { padding-top: 56px } }
        Stack(gap: .sm) {
            style { gap: 14px; max-width: 760px }
            Row(class: "bp-labels") { KindLabel(.explanation) }
            Heading(t("nav.about")).h1 { style { margin: 0; font-size: clamp(30px, 5vw, 44px); line-height: 1.08; font-weight: 650; letter-spacing: -0.025em } }
            Text("Essays on why WebFluent works as it does: read once, for the argument, not looked up.", class: "bp-lede")
        }
        Stack(gap: .md) {
            style { gap: 14px }
            Heading(t("nav.group.about"), id: "about").h2 { style { margin: 0; font-size: 22px; font-weight: 650 } }
            Grid(columns: { base: 1, md: 2 }, gap: .md) {
                Link(to: "/about/why", class: "bp-card") {
                    Text("Introduction") { style { font-weight: 650 } }
                    Text("What WebFluent is, what it does for you, where it fits and where it does not, and how to find your way around this guide.", class: "bp-small")
                }
                Link(to: "/about/accessibility", class: "bp-card") {
                    Text("Accessibility") { style { font-weight: 650 } }
                    Text("Build pages that work with a keyboard, a screen reader or voice control: what the built-ins do, what the compiler checks, and what is still yours to do.", class: "bp-small")
                }
                Link(to: "/about/security", class: "bp-card") {
                    Text("Security") { style { font-weight: 650 } }
                    Text("What the compiler guarantees, what it cannot, and the decisions left to you: markup, secrets, storage, headers and a deployment checklist.", class: "bp-small")
                }
                Link(to: "/about/what-a-build-ships", class: "bp-card") {
                    Text("Performance") { style { font-weight: 650 } }
                    Text("Learn what a build already does to be fast, see what it weighs, set budgets that warn, time pages in a browser, and avoid what makes a site slow.", class: "bp-small")
                }
                Link(to: "/about/static-or-single-page", class: "bp-card") {
                    Text("Static or single-page") { style { font-weight: 650 } }
                    Text("The same source builds as pre-rendered pages or as one app shell. What each gives you, what the pre-rendered page holds, and how dynamic routes are rendered.", class: "bp-small")
                }
                Link(to: "/about/upgrading", class: "bp-card") {
                    Text("Upgrading") { style { font-weight: 650 } }
                    Text("What changed in each release, what to do when you upgrade, and how wf migrate carries an older project forward.", class: "bp-small")
                }
                Link(to: "/about/contributing", class: "bp-card") {
                    Text("Contributing") { style { font-weight: 650 } }
                    Text("How the compiler is put together, how to build and test it, and how to change the language, a built-in or this guide.", class: "bp-small")
                }
            }
        }
    }
}
