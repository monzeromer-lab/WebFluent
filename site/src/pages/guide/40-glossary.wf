/// Chapter 40 of the guide, written from md-docs/reference/glossary.md by
/// scripts/docsite/guide.py; edit the guide, not this file.
page GlossaryGuide(path: "/reference/glossary", title: "Glossary", description: "The terms this guide uses — state, signal, pre-rendered page, hydration, flag, part, slot, registry, scope and more — each in a sentence, with a link.", layout: DocsShell("Glossary", kind: .reference, chapter: t("nav.group.reference"), blurb: "The words this guide uses, each in a sentence, with where to read more.", source: "md-docs/reference/glossary.md", sections: [Anchor(id: "a", label: "A"), Anchor(id: "b", label: "B"), Anchor(id: "c", label: "C"), Anchor(id: "d", label: "D"), Anchor(id: "e", label: "E"), Anchor(id: "f", label: "F"), Anchor(id: "h", label: "H"), Anchor(id: "i", label: "I"), Anchor(id: "l", label: "L"), Anchor(id: "p", label: "P"), Anchor(id: "r", label: "R"), Anchor(id: "s", label: "S"), Anchor(id: "t", label: "T"), Anchor(id: "v", label: "V"), Anchor(id: "w", label: "W")], prevTo: "/reference/browser-support", prevLabel: t("ch.39"), nextTo: "/reference/library", nextLabel: t("ch.41"))) {
    Stack(gap: .lg) {
        Markdown("This glossary defines the words this guide uses, in alphabetical order. Each entry is one sentence, with a link to the chapter that explains the idea. The guide uses each term in the same sense every time.")

        Heading("A", id: "a").h2

        Heading("Action", id: "action").h3

        Markdown("A named function of a page, component or store whose body changes state or does other work: `action add() \{ … \}` ([State and reactivity](/learn/07-state-and-reactivity#actions-and-locals)).")

        Heading("App shell", id: "app-shell").h3

        Markdown("The `app \{ \}` declaration: what every page is drawn inside, with a `Router` where the current page goes ([Pages and routing](/learn/05-pages-and-routing#the-app-shell)).")

        Heading("B", id: "b").h2

        Heading("Block", id: "block").h3

        Markdown("The `\{ … \}` after an element, holding its style, transitions, handlers, slot fills and children, in that order ([Elements](/learn/06-elements#the-call-shape)).")

        Heading("Built-in", id: "built-in").h3

        Markdown("An element the language provides, such as `Button` or `Card`, which the compiler knows through the registry ([Components reference](/reference)).")

        Heading("C", id: "c").h2

        Heading("Case", id: "case").h3

        Markdown("One value of an `enum`, written with a dot: `.primary`, `.failed(\"x\")` ([Types](/learn/12-types#enums)).")

        Heading("Chunk", id: "chunk").h3

        Markdown("A page's own script and stylesheet, written to their own files and loaded the first time the page's route shows, when `build.split` is on ([Configuration](/reference/config#build)).")

        Heading("Component", id: "component").h3

        Markdown("An element you declare, with typed props, events, slots and parts: `component UserCard(…) \{ … \}` ([Components](/learn/10-components)).")

        Heading("D", id: "d").h2

        Heading("Declaration", id: "declaration").h3

        Markdown("A top-level statement of a file: `page`, `component`, `store`, `theme`, `app`, `type`, `enum`, `api`, `const`, `data`, `image`, `animation` or `test` ([Language basics](/learn/04-language-basics#declarations)).")

        Heading("Derived value", id: "derived-value").h3

        Markdown("A value worked out from state and worked out again when what it reads changes: `derived total = …` ([State and reactivity](/learn/07-state-and-reactivity#derived)).")

        Heading("Design token", id: "design-token").h3

        Markdown("A named value that a theme sets and every built-in reads, written `$name` in a style block and `var(--name)` in a stylesheet ([Design tokens](/reference/tokens)).")

        Heading("Diagnostic", id: "diagnostic").h3

        Markdown("A finding the compiler reports, with a code such as `T05`, a severity, a place and, where it is known, a fix; also called a *finding* ([Diagnostics](/errors)).")

        Heading("E", id: "e").h2

        Heading("Effect", id: "effect").h3

        Markdown("Code that runs when its page shows and again when a state it read changes, with a `cleanup \{ \}` for what it set up ([State and reactivity](/learn/07-state-and-reactivity#effect)).")

        Heading("Element", id: "element").h3

        Markdown("Anything a page draws by a capitalised name — a built-in such as `Button`, or a component of your own ([Elements](/learn/06-elements)).")

        Heading("Enum", id: "enum").h3

        Markdown("A type with a fixed set of cases, declared `enum Tone \{ calm, loud \}` ([Types](/learn/12-types#enums)).")

        Heading("Event", id: "event").h3

        Markdown("Something that happens — a click, a key, or an event a component declares and fires with `emit` — that a handler answers ([Events](/learn/08-events)).")

        Heading("F", id: "f").h2

        Heading("Flag", id: "flag").h3

        Markdown("A word after a dot that sets a `Bool` prop or picks an enum case: `Button(\"Save\").primary.lg` ([Elements](/learn/06-elements#props-cases-and-flags)).")

        Heading("H", id: "h").h2

        Heading("Handler", id: "handler").h3

        Markdown("Code run when an event happens, written `on click \{ … \}` ([Events](/learn/08-events#handlers)).")

        Heading("Hydration", id: "hydration").h3

        Markdown("The script taking over a pre-rendered page in place, without drawing it again ([Static sites and SPAs](/about/static-or-single-page#hydration)).")

        Heading("I", id: "i").h2

        Heading("Imperative block", id: "imperative-block").h3

        Markdown("The body of an action, handler or effect, made of statements that do things; the opposite of a render block ([Language basics](/learn/04-language-basics#bodies)).")

        Heading("L", id: "l").h2

        Heading("Layout", id: "layout").h3

        Markdown("A component a page names with `layout:` to frame it, which draws the page in its default slot ([Pages and routing](/learn/05-pages-and-routing#layouts)).")

        Heading("Lint", id: "lint").h3

        Markdown("A rule the compiler checks beyond whether the program can work, such as an accessibility rule or an unused-value rule; the `lints` setting changes what any finding counts as ([Configuration](/reference/config#lints)).")

        Heading("P", id: "p").h2

        Heading("Page", id: "page").h3

        Markdown("A declaration with a `path:` that the router draws when the address matches it: `page Home(path: \"/\") \{ … \}` ([Pages and routing](/learn/05-pages-and-routing#declaring-a-page)).")

        Heading("Part", id: "part").h3

        Markdown("A sub-element called under its owner's name: `Card.Header`, `Panel.Footer` ([Components](/learn/10-components#parts)).")

        Heading("Persist", id: "persist").h3

        Markdown("A state kept in the browser's storage across visits: `persist scheme = \"light\"` ([Stores](/learn/11-stores#keeping-a-value-across-visits)).")

        Heading("Positional argument", id: "positional-argument").h3

        Markdown("The one value an element takes without a name, such as a button's label or a heading's text ([Elements](/learn/06-elements#the-call-shape)).")

        Heading("Pre-rendered page", id: "pre-rendered-page").h3

        Markdown("The HTML the build writes for a page from everything it can know at build time, shown before any script runs; also called the *static paint* ([Static sites and SPAs](/about/static-or-single-page#what-the-static-paint-knows)).")

        Heading("Project script", id: "project-script").h3

        Markdown("A `.js` file under `src/`: a plain browser script, linked on every page as written, whose top-level names `.wf` code calls directly ([JavaScript interop](/recipes/call-your-own-script)).")

        Heading("Prop", id: "prop").h3

        Markdown("A value a component or built-in takes, passed by name — or, for the one marked `_`, by position ([Components](/learn/10-components#props)).")

        Heading("R", id: "r").h2

        Heading("Registry", id: "registry").h3

        Markdown("The compiler's table of every built-in's props, cases, flags, events, slots and parts, which the checker, the linters, the editor and the reference all read; `wf registry --json` prints it ([Command line](/reference/cli)).")

        Heading("Render block", id: "render-block").h3

        Markdown("The body of a page, component or element, which describes what to show and the state behind it ([Language basics](/learn/04-language-basics#bodies)).")

        Heading("Resource", id: "resource").h3

        Markdown("A request a page makes, whose loading, error and ready states a `match` shows: `resource rows = fetch(…)` ([Fetching data](/learn/15-data#show-a-request-with-resource)).")

        Heading("Route parameter", id: "route-parameter").h3

        Markdown("A `:name` segment of a page's path, which the page declares as a typed parameter: `page User(path: \"/user/:id\", id: String)` ([Pages and routing](/learn/05-pages-and-routing#route-parameters)).")

        Heading("Runtime", id: "runtime").h3

        Markdown("The JavaScript at the head of `app.js` that the compiled pages call, reachable as `window.WF` ([Runtime API](/reference/runtime)).")

        Heading("S", id: "s").h2

        Heading("Scope", id: "scope").h3

        Markdown("What owns the effects, timers and connections created inside it — a page, a branch, a list item — and disposes of them when it leaves ([State and reactivity](/learn/07-state-and-reactivity#automatic-clean-up)).")

        Heading("Signal", id: "signal").h3

        Markdown("A reactive value, which is what a `state` is underneath: whatever reads it updates when it changes ([Runtime API](/reference/runtime#state)).")

        Heading("Single-page app (SPA)", id: "single-page-app-spa").h3

        Markdown("A build with one HTML shell, whose pages the script swaps without a reload ([Static sites and SPAs](/about/static-or-single-page#two-shapes-of-build)).")

        Heading("Slot", id: "slot").h3

        Markdown("A place in a component that its caller fills: the default slot (`children`), a named slot, or a scoped slot that hands values to its fill ([Components](/learn/10-components#slots)).")

        Heading("Snapshot", id: "snapshot").h3

        Markdown("The HTML a test drew, kept under `tests/__snapshots__/` and compared on every later run ([Testing](/learn/16-testing#snapshots)).")

        Heading("State", id: "state").h3

        Markdown("A value of a page, component or store that the page shows and that changes: `state count = 0` ([State and reactivity](/learn/07-state-and-reactivity#state)).")

        Heading("Static build", id: "static-build").h3

        Markdown("A build with `build.ssg: true`, which writes a pre-rendered HTML file for every page ([Static sites and SPAs](/about/static-or-single-page#two-shapes-of-build)).")

        Heading("Static paint", id: "static-paint").h3

        Markdown("Another name for the pre-rendered page: the HTML the build writes for a page before any script runs ([Static sites and SPAs](/about/static-or-single-page#what-the-static-paint-knows)).")

        Heading("Store", id: "store").h3

        Markdown("Shared state with actions, built the first time something reads it ([Stores](/learn/11-stores)).")

        Heading("T", id: "t").h2

        Heading("Template engine", id: "template-engine").h3

        Markdown("WebFluent used from a server, through `wf render`, Rust or Node, to render a `.wf` template with JSON data to HTML or PDF ([Render a template](/recipes/render-a-template)).")

        Heading("Theme", id: "theme").h3

        Markdown("A `theme` declaration: the design tokens it changes from the baseline ([Styling](/learn/13-styling)).")

        Heading("Type", id: "type").h3

        Markdown("A record declared with `type`, or any of the types a value can have, which the checker holds every use to ([Types](/learn/12-types)).")

        Heading("V", id: "v").h2

        Heading("Validate block", id: "validate-block").h3

        Markdown("A `validate x \{ … \}` block beside a state, whose rules the control bound to that state shows ([Forms](/learn/14-forms#validate-a-field)).")

        Heading("W", id: "w").h2

        Heading(".wfx", id: "wfx").h3

        Markdown("A source file whose blocks are written by indentation instead of braces ([Language basics](/learn/04-language-basics#two-layouts-wf-and-wfx)).")
    }
}
