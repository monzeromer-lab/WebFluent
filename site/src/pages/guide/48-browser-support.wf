/// Chapter 48 of the guide, written from md-docs/reference/browser-support.md by
/// scripts/docsite/guide.py; edit the guide, not this file.
page BrowserSupportGuide(path: "/reference/browser-support", title: "Browser support", description: "The browsers a WebFluent site targets, and the fallback for each newer platform feature it uses where a browser lacks it.", layout: DocsShell("Browser support", chapter: t("nav.group.reference"), blurb: "Which browsers a WebFluent site targets, and what each newer platform feature falls back to where a browser lacks it.", source: "md-docs/reference/browser-support.md", sections: [Anchor(id: "supported-browsers", label: "Supported browsers"), Anchor(id: "features-with-a-fallback", label: "Features with a fallback"), Anchor(id: "dialogs-and-forms", label: "Dialogs and forms")], prevTo: "/reference/grammar", prevLabel: t("ch.47"), nextTo: "/reference/glossary", nextLabel: t("ch.49"))) {
    Stack(gap: .lg) {
        Markdown("This page lists the browsers a WebFluent site targets, and what each newer platform feature the runtime uses falls back to where a browser lacks it.")

        Heading("Supported browsers", id: "supported-browsers").h2

        Markdown("A WebFluent site targets the current versions of **Chrome, Edge, Firefox and Safari**, on desktop and mobile — the browsers that update themselves.\n\n- **The output** is plain HTML, CSS and modern JavaScript (ES2021). There is no polyfill and no legacy build.\n- **Without JavaScript**, a static build's pages are readable: the HTML the build pre-renders for each page carries its text ([Static sites and SPAs](/docs/guide/static-and-spa)). Everything interactive needs JavaScript.")

        Callout("`wf verify` loads every page of a build in a headless Chrome and reports uncaught errors, failed requests and pages that drew no text ([CLI](/reference/cli)).", kind: .tip)

        Heading("Features with a fallback", id: "features-with-a-fallback").h2

        Markdown("Where a browser lacks one of these features, the site still works; the last column says what changes.")

        Table(caption: "Features with a fallback") {
            Table.Head {
                Table.Row {
                    Table.Cell("Feature").header
                    Table.Cell("Used for").header
                    Table.Cell("Where it is missing").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell("View Transitions API")
                    Table.Cell { Markdown("`Router(transition: …)`, `shared:` elements") }
                    Table.Cell { Markdown("The class-based transition plays instead; `shared:` does nothing") }
                }
                Table.Row {
                    Table.Cell { Markdown("`linear()` easing") }
                    Table.Cell { Markdown("`easing: .spring`, `.bouncy`") }
                    Table.Cell("The browser ignores it and uses its default easing")
                }
                Table.Row {
                    Table.Cell("Web Animations API")
                    Table.Cell { Markdown("enter, exit, list moves, `count:`") }
                    Table.Cell("Present in every current browser; without it, elements appear and leave without motion")
                }
                Table.Row {
                    Table.Cell { Markdown("`IntersectionObserver`") }
                    Table.Cell { Markdown("`on: .enterView`") }
                    Table.Cell("The animation plays at once")
                }
                Table.Row {
                    Table.Cell("Background Sync")
                    Table.Cell("writes kept offline, sent after the tab closes")
                    Table.Cell("The page sends them the next time it is open and online")
                }
                Table.Row {
                    Table.Cell("Service workers")
                    Table.Cell { Markdown("`offline`") }
                    Table.Cell("The site works online as usual")
                }
                Table.Row {
                    Table.Cell("WebRTC")
                    Table.Cell { Markdown("`peer`") }
                    Table.Cell { Markdown("The peer reads `error`: \"WebRTC is not available in this browser\"") }
                }
                Table.Row {
                    Table.Cell { Markdown("`BroadcastChannel`") }
                    Table.Cell { Markdown("`channel`") }
                    Table.Cell { Markdown("The channel reads `closed`") }
                }
                Table.Row {
                    Table.Cell("Network Information API")
                    Table.Cell { Markdown("`network.effectiveType`, `.saveData`, `.downlink`") }
                    Table.Cell { Markdown("They read as a fast line: `\"4g\"`, `false` and `10`. `network.online` works everywhere") }
                }
                Table.Row {
                    Table.Cell { Markdown("`Intl`") }
                    Table.Cell { Markdown("`format`, `ago`, plural forms") }
                    Table.Cell("The build's own table for the common locales")
                }
                Table.Row {
                    Table.Cell("Container queries")
                    Table.Cell { Markdown("`@container` in a style block") }
                    Table.Cell("Passed through as written; the rule does not apply")
                }
                Table.Row {
                    Table.Cell { Markdown("`:focus-visible`") }
                    Table.Cell("focus rings")
                    Table.Cell("Focus rings on every focus")
                }
            }
        }

        Heading("Dialogs and forms", id: "dialogs-and-forms").h2

        Markdown("`Modal` and `Dialog` use the `<dialog>` element and `showModal()`, which every current browser has. Form validation uses the browser's constraint validation alongside the language's own rules ([Forms](/docs/guide/forms)).")
    }
}
