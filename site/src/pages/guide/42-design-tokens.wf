        Heading("Short names", id: "short-names").h2

        Markdown("In a `style \{ \}` block, a short name is resolved through the group of the property it is given to: `$lg` on `padding` is `spacing-lg`, and on `border-radius` it is `radius-lg`.")

        Table(caption: "Short names") {
            Table.Head {
                Table.Row {
                    Table.Cell("Property").header
                    Table.Cell("Group").header
                    Table.Cell("Short names").header
                    Table.Cell("Example").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`padding`, `margin` and every `padding-*` and `margin-*` property (physical and logical), `gap`, `row-gap`, `column-gap`, `width`, `height`, `min-width`, `max-width`, `min-height`, `max-height`, `top`, `right`, `bottom`, `left`, `inset` and `inset-*`") }
                    Table.Cell("spacing")
                    Table.Cell { Markdown("`xs`, `sm`, `md`, `lg`, `xl`, `2xl`, `3xl`") }
                    Table.Cell { Markdown("`$lg` is `spacing-lg`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`color`, `background`, `background-color`, `border-color`, `fill`, `stroke`, `outline`, `outline-color`, `text-decoration-color`, `caret-color`, `accent-color`, and the `border` shorthands (`border`, `border-top` … `border-inline-end`)") }
                    Table.Cell("colour")
                    Table.Cell { Markdown("`primary`, `secondary`, `success`, `danger`, `warning`, `info`, `background`, `surface`, `text`, `text-muted`, `border`") }
                    Table.Cell { Markdown("`$primary` is `color-primary`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`font-size`") }
                    Table.Cell("font size")
                    Table.Cell { Markdown("`xs`, `sm`, `base`, `lg`, `xl`, `2xl`, `3xl`") }
                    Table.Cell { Markdown("`$xl` is `font-size-xl`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`line-height`") }
                    Table.Cell("line height")
                    Table.Cell { Markdown("`tight`, `normal`, `loose`") }
                    Table.Cell { Markdown("`$tight` is `line-height-tight`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`border-radius`") }
                    Table.Cell("radius")
                    Table.Cell { Markdown("`none`, `sm`, `md`, `lg`, `xl`, `full`") }
                    Table.Cell { Markdown("`$lg` is `radius-lg`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`box-shadow`") }
                    Table.Cell("shadow")
                    Table.Cell { Markdown("`none`, `sm`, `md`, `lg`, `xl`") }
                    Table.Cell { Markdown("`$md` is `shadow-md`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`transition`") }
                    Table.Cell("transition")
                    Table.Cell { Markdown("`fast`, `normal`, `slow`") }
                    Table.Cell { Markdown("`$fast` is `transition-fast`") }
                }
            }
        }

        Markdown("A short name your theme declares as a token of its own means that token, not the group's: with `md: 20px` in the theme, `$md` is `md` everywhere.\n\nA full name — `$color-text-muted`, `$spacing-lg`, a token of your own — works in any property.")
    }
}
