/// Chapter 11 of the guide, written from md-docs/11-expressions.md by
/// scripts/site-from-guide.py; edit the guide, not this file.
page Expressions(path: "/docs/guide/expressions", title: "Expressions", description: "Literals, interpolation, operators, if and match as values, lambdas, methods, format and ago, regexes, tokens, await, const and env.", layout: DocsShell("Expressions", chapter: "Chapter 11", blurb: "The full expression language: literals, interpolation, operators, values that choose, calls, formatting and await.", sections: [Anchor(id: "literals", label: "Literals"), Anchor(id: "interpolation", label: "Interpolation"), Anchor(id: "operators", label: "Operators"), Anchor(id: "choosing-a-value", label: "Choosing a value"), Anchor(id: "fields-calls-and-methods", label: "Fields, calls and methods"), Anchor(id: "format-and-ago", label: "format and ago"), Anchor(id: "regular-expressions", label: "Regular expressions"), Anchor(id: "tokens-as-values", label: "Tokens as values"), Anchor(id: "await", label: "await"), Anchor(id: "constants-and-environment", label: "Constants and environment"), Anchor(id: "built-in-functions", label: "Built-in functions")], prevTo: "/docs/guide/types", prevLabel: "10. Types", nextTo: "/docs/guide/styling", nextLabel: "12. Styling")) {
    Stack(gap: .lg) {
        Markdown("An expression is a value: a prop's value, a condition, the right side of a `state` or `derived`, the inside of `\{…\}` in a string. This chapter is the full expression language.")

        Heading("Literals", id: "literals").h2

        CodeBlock("page Literals(path: \"/\") \{\n    state s = \"text\"                        // String\n    state n = 42                            // Number\n    state f = 3.14                          // Number\n    state b = true                          // Bool\n    state nothing: String? = null           // null\n    state list = [1, 2, 3]                  // [Number]\n    state map = \{ name: \"Sam\", age: 30 \}    // a shape with those fields\n    state re = /^[a-z]+$/i                  // a regex\n    state color = $primary                  // a design token\n    Text(\"\{s\} \{n\} \{f\} \{b\} \{list.length\} \{map.name\}\")\n\}", title: "wf")

        Markdown("Strings are double-quoted; `\\\"`, `\\\\`, `\\n` and `\\t` escape. Lists and map literals may span lines and take a trailing comma.")

        Heading("Interpolation", id: "interpolation").h2

        Markdown("`\"\{expr\}\"` puts a value into a string; anything that shows text accepts one:")

        CodeBlock("page Interp(path: \"/\") \{\n    state name = \"Sam\"\n    state n = 3\n    derived items = if n == 1 \{ \"item\" \} else \{ \"items\" \}\n    Text(\"Hello, \{name\}: \{n\} \{items\}\")\n    Text(\"Total: \{format(n * 9.99, .currency)\}\")\n    Text(\"Next: \{n + 1\}\")\n\}", title: "wf")

        Markdown("Anything that is an expression goes inside `\{…\}` — a call, a method chain, an `if`, even a string of its own: `\"\{n ?? \"none\"\}\"` and `\"\{if ok \{ \"yes\" \} else \{ \"no\" \}\}\"` both work, as long as the group closes on the same line. A brace group that is not an expression (`\"\{key: value\}\"` in prose, a fragment of code) stays text. For anything long, a `derived` reads better, as `items` above.")

        Heading("Operators", id: "operators").h2

        Table(caption: "Operators") {
            Table.Head {
                Table.Row {
                    Table.Cell("Kind").header
                    Table.Cell("Operators").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell("Arithmetic")
                    Table.Cell { Markdown("`+ - * / %`, unary `-`") }
                }
                Table.Row {
                    Table.Cell("Comparison")
                    Table.Cell { Markdown("`== != < <= > >=`") }
                }
                Table.Row {
                    Table.Cell("Logic")
                    Table.Cell { Markdown("`&& \\") }
                    Table.Cell("\\")
                    Table.Cell { Markdown("!`") }
                }
                Table.Row {
                    Table.Cell("Null")
                    Table.Cell { Markdown("`??` fallback, `?.` optional chain") }
                }
                Table.Row {
                    Table.Cell("Range")
                    Table.Cell { Markdown("`a..b` (exclusive), `a..=b` (inclusive)") }
                }
                Table.Row {
                    Table.Cell("Spread")
                    Table.Cell { Markdown("`[...a, x]`, `\{ ...m, key: v \}`") }
                }
                Table.Row {
                    Table.Cell("Grouping")
                    Table.Cell { Markdown("`( )`") }
                }
            }
        }

        Markdown("`+` joins strings when either side is a `String`, and adds numbers otherwise. `==` compares values; two records with the same fields are not `==` unless they are the same object, so compare ids. Precedence is the usual: `!` and unary `-`, then `* / %`, `+ -`, comparisons, `&&`, `||`, `??`.")

        CodeBlock("page Ops(path: \"/\") \{\n    state a = 7\n    state b = 2\n    state user: Map? = null\n    Text(\"\{a + b\} \{a - b\} \{a * b\} \{a / b\} \{a % b\}\")\n    Text(if a > b && b != 0 \{ \"a wins\" \} else \{ \"b wins\" \})\n    Text(user?.name ?? \"guest\")\n    for n in 1..=3 \{ Badge(\"\{n\}\") \}\n\}", title: "wf")

        Heading("Choosing a value", id: "choosing-a-value").h2

        Markdown("`if` and `match` are expressions when they stand where a value is expected; each arm's block is its value:")

        CodeBlock("enum Level \{ low, mid, high \}\n\npage Choose(path: \"/\") \{\n    state score = 72\n    state level: Level = .mid\n    derived grade = if score >= 90 \{ \"A\" \} else if score >= 70 \{ \"B\" \} else \{ \"C\" \}\n    derived tone = match level \{ .low \{ \"calm\" \} .mid \{ \"steady\" \} else \{ \"loud\" \} \}\n    Text(\"\{grade\} \{tone\}\")\n    Badge(grade, tone: if score >= 70 \{ .success \} else \{ .danger \})\n\}", title: "wf")

        Markdown("A `match` expression always ends with an `else` arm, so it has a value whatever comes; a `match` statement may list only the arms it shows.")

        Heading("Fields, calls and methods", id: "fields-calls-and-methods").h2

        CodeBlock("type Todo \{ id: String, title: String, done: Bool = false \}\n\npage Calls(path: \"/\") \{\n    state todos: [Todo] = [Todo(id: \"1\", title: \"milk\"), Todo(id: \"2\", title: \"eggs\", done: true)]\n    state q = \"M\"\n    derived open = todos.filter(t => !t.done)\n    derived titles = todos.map(t => t.title.capitalize())\n    derived hits = todos.filter(t => t.title.toLowerCase().includes(q.toLowerCase()))\n    derived first = todos.first()\n    derived count = todos.length\n    derived summary = titles.join(\", \")\n    Text(\"\{count\} todos, \{open.length\} open, \{hits.length\} match: \{summary\}\")\n    if let f = first \{ Text(\"First: \{f.title\}\") \}\n\}", title: "wf")

        Markdown("Lambdas are `x => expr`, `(a, b) => expr` or `() => expr` — an expression body, which may call an action when it needs to do more; a parameter's type comes from what the method expects.")

        Heading("String methods", id: "string-methods").h3

        Markdown("`length`, `trim()`, `toLowerCase()`, `toUpperCase()`, `capitalize()`, `truncate(n)`, `includes(s)`, `startsWith(s)`, `endsWith(s)`, `indexOf(s)`, `slice(a, b)`, `substring(a, b)`, `charAt(i)`, `replace(a, b)`, `split(sep)`, `padStart(n, c)`, `padEnd(n, c)`, `repeat(n)`, `match(re)`.")

        Heading("List methods", id: "list-methods").h3

        Markdown("`length`, `map(f)`, `filter(f)`, `find(f)`, `findIndex(f)`, `some(f)`, `every(f)`, `includes(x)`, `indexOf(x)`, `reduce(f, init)`, `join(sep)`, `slice(a, b)`, `concat(other)`, `reverse()`, `sort(f)`, `sortBy(f)`, `groupBy(f)`, `unique()`, `take(n)`, `first()`, `last()`, `sum()`, `flatMap(f)`, and, in an imperative block, `push(x)`.\n\n`sortBy`, `groupBy`, `unique`, `take`, `first`, `last`, `sum`, `capitalize` and `truncate` are WebFluent's own; the rest are the browser's.")

        Heading("Number methods", id: "number-methods").h3

        Markdown("`toFixed(n)`, `toString()`. `Number(\"12\")` converts a string; `\"\{n\}\"` or `String(n)` converts a number. `Math.round`, `Math.max` and friends are available as `Math.*`.")

        Heading("format and ago", id: "format-and-ago").h2

        Markdown("`format(value, style, option)` formats numbers and dates in the reader's locale (the `locale` of the app, or the browser's):")

        CodeBlock("page Format(path: \"/\") \{\n    state price = 1234.5\n    state ratio = 0.256\n    state big = 1200000\n    state when = \"2026-03-14T09:30:00\"\n    Text(format(price, .currency))                 // $1,234.50\n    Text(format(price, .currency, \"EUR\"))          // €1,234.50\n    Text(format(ratio, .percent))                  // 26%\n    Text(format(ratio, .percent, 1))               // 25.6%\n    Text(format(price, .decimal, 1))               // 1,234.5\n    Text(format(big, .integer))                    // 1,200,000\n    Text(format(big, .compact))                    // 1.2M\n    Text(format(when, .date))                      // Mar 14, 2026\n    Text(format(when, .date, \"long\"))              // March 14, 2026\n    Text(format(when, .time))                      // 9:30 AM\n    Text(format(when, .datetime))                  // Mar 14, 2026, 9:30 AM\n    Text(format(when, \"EEEE d MMMM yyyy, HH:mm\"))  // Saturday 14 March 2026, 09:30\n    Text(ago(when))                                // 3 days ago\n    Text(format(when, .relative))                  // the same\n\}", title: "wf")

        Markdown("Styles: `.integer`, `.decimal(places)`, `.currency(code)`, `.percent(places)`, `.compact`, `.date(short|medium|long|full)`, `.time`, `.datetime`, `.relative`, or a pattern string of `yyyy yy MMMM MMM MM M dd d EEEE EEE HH H hh h mm ss a`. `ago(date)` gives \"just now\", \"5 minutes ago\", \"in 2 days\". The static paint formats with a built-in table for the common locales and currencies; the live page uses `Intl` and corrects any difference.")

        Heading("Regular expressions", id: "regular-expressions").h2

        CodeBlock("page Regex(path: \"/\") \{\n    state email = \"\"\n    derived valid = /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)\n    derived domain = email.split(\"@\").last() ?? \"\"\n    Input(bind: email, label: \"Email\")\n    if email != \"\" && !valid \{ Text(\"That does not look like an email.\").danger.sm \}\n    Text(\"Domain: \{domain\}\")\n\}", title: "wf")

        Markdown("`/…/flags` is a regex; `re.test(s)` is a `Bool`, `s.match(re)` and `re.exec(s)` a `[String]?`, `s.replace(re, \"x\")` a `String`.")

        Heading("Tokens as values", id: "tokens-as-values").h2

        Markdown("`$name` names a design token from the theme ([chapter 12](/docs/guide/styling)). In a style it becomes the CSS variable; as a value it is the variable reference, so a prop that takes a color takes a token:")

        CodeBlock("page Tokens(path: \"/\") \{\n    state accent = $primary\n    Card \{\n        style \{ border-left: 4px solid \{accent\} \}\n        Text(\"Accent from a token\")\n    \}\n\}", title: "wf")

        Heading("await", id: "await").h2

        Markdown("`await` waits for a promise in an action or handler, and makes the action asynchronous:")

        CodeBlock("page Await(path: \"/\") \{\n    state rows: [Map] = []\n    state note = \"\"\n    action load() \{\n        let r = await fetch(\"/api/rows\")\n        rows = r.rows\n        let text = await fetch(\"/api/note\", \{ method: \"GET\" \})\n        note = text.note\n    \}\n    Button(\"Load\", disabled: load.pending) \{ on click \{ load() \} \}\n    Text(\"\{rows.length\} rows, note: \{note\}\")\n\}", title: "wf")

        Markdown("`fetch(url, options)` returns the parsed JSON body (or throws on a failed response); `options` is a map with `method`, `headers`, `body` (a map is sent as JSON). [Chapter 14](/docs/guide/data) has `resource`, the declarative form.")

        Heading("Constants and environment", id: "constants-and-environment").h2

        CodeBlock("const MAX_ROWS = 50\nconst API = env.API_URL ?? \"/api\"\n\npage Consts(path: \"/\") \{\n    Text(\"Up to \{MAX_ROWS\} rows from \{API\}\")\n\}", title: "wf")

        Markdown("`const` declares a project-wide value; `env.NAME` reads a variable from the build environment (and `.env` in the project root). Both are inlined.")

        Heading("Built-in functions", id: "built-in-functions").h2

        Table(caption: "Built-in functions") {
            Table.Head {
                Table.Row {
                    Table.Cell("Name").header
                    Table.Cell("Does").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`log(x, …)`") }
                    Table.Cell("Prints to the console")
                }
                Table.Row {
                    Table.Cell { Markdown("`navigate(path)`") }
                    Table.Cell { Markdown("Changes the route ([chapter 3](/docs/guide/pages-and-routing#navigating))") }
                }
                Table.Row {
                    Table.Cell { Markdown("`format`, `ago`") }
                    Table.Cell("Above")
                }
                Table.Row {
                    Table.Cell { Markdown("`t(\"key\", args)`") }
                    Table.Cell { Markdown("Translates ([chapter 15](/docs/guide/i18n))") }
                }
                Table.Row {
                    Table.Cell { Markdown("`setTheme(\"dark\")`") }
                    Table.Cell { Markdown("Switches the theme ([chapter 12](/docs/guide/styling#dark-mode))") }
                }
                Table.Row {
                    Table.Cell { Markdown("`Number(x)`, `String(x)`") }
                    Table.Cell("Convert")
                }
                Table.Row {
                    Table.Cell { Markdown("`every(ms) \{ \}`, `after(ms) \{ \}`") }
                    Table.Cell { Markdown("Timers ([chapter 5](/docs/guide/state#timers))") }
                }
            }
        }
    }
}
