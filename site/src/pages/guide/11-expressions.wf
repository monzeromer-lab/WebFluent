/// Chapter 11 of the guide, written from md-docs/11-expressions.md by
/// scripts/site-from-guide.py; edit the guide, not this file.
page Expressions(path: "/docs/guide/expressions", title: "Expressions", description: "Literals, interpolation, operators, if and match as values, lambdas, methods, format and ago, regexes, tokens, await, const and env.", layout: DocsShell("Expressions", chapter: "Chapter 11", blurb: "The full expression language: literals, interpolation, operators, values that choose, calls, formatting and await.", sections: [Anchor(id: "literals", label: "Literals"), Anchor(id: "interpolation", label: "Interpolation"), Anchor(id: "operators", label: "Operators"), Anchor(id: "choosing-a-value", label: "Choosing a value"), Anchor(id: "fields-calls-and-methods", label: "Fields, calls and methods"), Anchor(id: "format-and-ago", label: "format and ago"), Anchor(id: "regular-expressions", label: "Regular expressions"), Anchor(id: "tokens-as-values", label: "Tokens as values"), Anchor(id: "await", label: "await"), Anchor(id: "constants-and-environment", label: "Constants and environment"), Anchor(id: "built-in-functions", label: "Built-in functions")], prevTo: "/docs/guide/types", prevLabel: "10. Types", nextTo: "/docs/guide/styling", nextLabel: "12. Styling")) {
    Stack(gap: .lg) {
        Markdown("An expression is a value: a prop's value, a condition, the right side of a `state` or `derived`, the inside of `\{…\}` in a string. This chapter is the full expression language.")

        Heading("Literals", id: "literals").h2

        CodeBlock(#"page Literals(path: "/") {
    state s = "text"                        // String
    state n = 42                            // Number
    state f = 3.14                          // Number
    state b = true                          // Bool
    state nothing: String? = null           // null
    state list = [1, 2, 3]                  // [Number]
    state map = { name: "Sam", age: 30 }    // a shape with those fields
    state re = /^[a-z]+$/i                  // a regex
    state color = $primary                  // a design token
    Text("{s} {n} {f} {b} {list.length} {map.name}")
}"#, title: "wf")

        Markdown("Strings are double-quoted; `\\\"`, `\\\\`, `\\n` and `\\t` escape. Lists and map literals may span lines and take a trailing comma.")

        Heading("Interpolation", id: "interpolation").h2

        Markdown("`\"\{expr\}\"` puts a value into a string; anything that shows text accepts one:")

        CodeBlock(#"page Interp(path: "/") {
    state name = "Sam"
    state n = 3
    derived items = if n == 1 { "item" } else { "items" }
    Text("Hello, {name}: {n} {items}")
    Text("Total: {format(n * 9.99, .currency)}")
    Text("Next: {n + 1}")
}"#, title: "wf")

        Markdown("Anything that is an expression goes inside `\{…\}` — a call, a method chain, an `if`, even a string of its own: `\"\{n ?? \"none\"\}\"` and `\"\{if ok \{ \"yes\" \} else \{ \"no\" \}\}\"` both work, as long as the group closes on the same line. A brace group that is not an expression (`\"\{key: value\}\"` in prose, a fragment of code) stays text. For anything long, a `derived` reads better, as `items` above.")

        Heading("Showing a value a particular way", id: "showing-a-value-a-particular-way").h3

        Markdown("A splice may say how to show its value: `\{value:.style\}`, or `\{value:.style(option)\}`, which is `format(value, .style, option)` written where it is read.")

        CodeBlock(#"page Receipt(path: "/") {
    state total = 1234.5
    state count = 1235
    state when = "2026-03-05T10:00:00Z"
    Text("Total: {total:.currency}")            // Total: $1,234.50
    Text("{count:.integer} items")              // 1,235 items
    Text("Shipped {when:.date(long)}")          // Shipped March 5, 2026
    Text("Down {0.256:.percent(1)}")            // — see below
}"#, title: "wf")

        Markdown("The styles and their options are `format`'s, listed under [`format` and `ago`](#format-and-ago). The value is an expression like any other, so `\{order.total:.currency\}` and `\{sum(rows):.compact\}` both work — but a splice has to open with a name, a `(` or a `[`, so a bare number takes a name first (`derived ratio = 0.256`, then `\{ratio:.percent(1)\}`).")

        Heading("Operators", id: "operators").h2

        Table(caption: "Operators") {
            Table.Head {
                Table.Row {
                    Table.Cell("Kind").header
                    Table.Cell("Operators").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell("Arithmetic")
                    Table.Cell { Markdown("`+ - * / %`, unary `-`") }
                }
                Table.Row {
                    Table.Cell("Comparison")
                    Table.Cell { Markdown("`== != < <= > >=`") }
                }
                Table.Row {
                    Table.Cell("Logic")
                    Table.Cell { Markdown("`&& || !`") }
                }
                Table.Row {
                    Table.Cell("Null")
                    Table.Cell { Markdown("`??` fallback, `?.` optional chain") }
                }
                Table.Row {
                    Table.Cell("Range")
                    Table.Cell { Markdown("`a..b` (exclusive), `a..=b` (inclusive)") }
                }
                Table.Row {
                    Table.Cell("Spread")
                    Table.Cell { Markdown("`[...a, x]`, `\{ ...m, key: v \}`") }
                }
                Table.Row {
                    Table.Cell("Grouping")
                    Table.Cell { Markdown("`( )`") }
                }
            }
        }

        Markdown("`+` joins strings when either side is a `String`, and adds numbers otherwise. `==` compares values; two records with the same fields are not `==` unless they are the same object, so compare ids. Precedence is the usual: `!` and unary `-`, then `* / %`, `+ -`, comparisons, `&&`, `||`, `??`.")

        CodeBlock(#"page Ops(path: "/") {
    state a = 7
    state b = 2
    state user: Map? = null
    Text("{a + b} {a - b} {a * b} {a / b} {a % b}")
    Text(if a > b && b != 0 { "a wins" } else { "b wins" })
    Text(user?.name ?? "guest")
    for n in 1..=3 { Badge("{n}") }
}"#, title: "wf")

        Heading("Choosing a value", id: "choosing-a-value").h2

        Markdown("`if` and `match` are expressions when they stand where a value is expected; each arm's block is its value:")

        CodeBlock(#"enum Level { low, mid, high }

page Choose(path: "/") {
    state score = 72
    state level: Level = .mid
    derived grade = if score >= 90 { "A" } else if score >= 70 { "B" } else { "C" }
    derived tone = match level { .low { "calm" } .mid { "steady" } else { "loud" } }
    Text("{grade} {tone}")
    Badge(grade, tone: if score >= 70 { .success } else { .danger })
}"#, title: "wf")

        Markdown("A `match` expression always ends with an `else` arm, so it has a value whatever comes; a `match` statement may list only the arms it shows.")

        Heading("Fields, calls and methods", id: "fields-calls-and-methods").h2

        CodeBlock(#"type Todo { id: String, title: String, done: Bool = false }

page Calls(path: "/") {
    state todos: [Todo] = [Todo(id: "1", title: "milk"), Todo(id: "2", title: "eggs", done: true)]
    state q = "M"
    derived open = todos.filter(t => !t.done)
    derived titles = todos.map(t => t.title.capitalize())
    derived hits = todos.filter(t => t.title.toLowerCase().includes(q.toLowerCase()))
    derived first = todos.first()
    derived count = todos.length
    derived summary = titles.join(", ")
    Text("{count} todos, {open.length} open, {hits.length} match: {summary}")
    if let f = first { Text("First: {f.title}") }
}"#, title: "wf")

        Markdown("Lambdas are `x => expr`, `(a, b) => expr` or `() => expr` — an expression body, which may call an action when it needs to do more; a parameter's type comes from what the method expects.")

        Heading("String methods", id: "string-methods").h3

        Markdown("`length`, `trim()`, `trimStart()`, `trimEnd()`, `toLowerCase()`, `toUpperCase()`, `capitalize()`, `truncate(n)`, `dedent()`, `lines()`, `words()`, `includes(s)`, `startsWith(s)`, `endsWith(s)`, `indexOf(s)`, `lastIndexOf(s)`, `slice(a, b)`, `substring(a, b)`, `charAt(i)`, `at(i)`, `replace(a, b)`, `replaceAll(a, b)`, `split(sep)`, `padStart(n, c)`, `padEnd(n, c)`, `repeat(n)`, `normalize()`, `localeCompare(other)`, `match(re)`, `search(re)`.\n\n`dedent()` takes the common indentation off a block of text — what a string carried in from a file or an API keeps and a reader does not want. `lines()` and `words()` split it: by line ending, and by runs of whitespace.")

        Heading("List methods", id: "list-methods").h3

        Markdown("`length`, `map(f)`, `filter(f)`, `find(f)`, `findIndex(f)`, `some(f)`, `every(f)`, `includes(x)`, `indexOf(x)`, `reduce(f, init)`, `join(sep)`, `slice(a, b)`, `concat(other)`, `reverse()`, `sort(f)`, `sortBy(f)`, `groupBy(f)`, `unique()`, `take(n)`, `first()`, `last()`, `sum()`, `flatMap(f)`, and, in an imperative block, `push(x)`.\n\n`sortBy`, `groupBy`, `unique`, `take`, `first`, `last`, `sum`, `capitalize`, `truncate`, `dedent`, `lines` and `words` are WebFluent's own; the rest are the browser's.")

        Heading("Number methods", id: "number-methods").h3

        Markdown("`toFixed(n)`, `toString()`. `Number(\"12\")` converts a string; `\"\{n\}\"` or `String(n)` converts a number. `Math.round`, `Math.max` and friends are available as `Math.*`.")

        Heading("format and ago", id: "format-and-ago").h2

        Markdown("`format(value, style, option)` formats numbers and dates in the reader's locale (the `locale` of the app, or the browser's):")

        CodeBlock(#"page Format(path: "/") {
    state price = 1234.5
    state ratio = 0.256
    state big = 1200000
    state when = "2026-03-14T09:30:00"
    Text(format(price, .currency))                 // $1,234.50
    Text(format(price, .currency, "EUR"))          // €1,234.50
    Text(format(ratio, .percent))                  // 26%
    Text(format(ratio, .percent, 1))               // 25.6%
    Text(format(price, .decimal, 1))               // 1,234.5
    Text(format(big, .integer))                    // 1,200,000
    Text(format(big, .compact))                    // 1.2M
    Text(format(when, .date))                      // Mar 14, 2026
    Text(format(when, .date, "long"))              // March 14, 2026
    Text(format(when, .time))                      // 9:30 AM
    Text(format(when, .datetime))                  // Mar 14, 2026, 9:30 AM
    Text(format(when, "EEEE d MMMM yyyy, HH:mm"))  // Saturday 14 March 2026, 09:30
    Text(ago(when))                                // 3 days ago
    Text(format(when, .relative))                  // the same
}"#, title: "wf")

        Markdown("Styles: `.integer`, `.decimal(places)`, `.currency(code)`, `.percent(places)`, `.compact`, `.date(short|medium|long|full)`, `.time`, `.datetime`, `.relative`, or a pattern string of `yyyy yy MMMM MMM MM M dd d EEEE EEE HH H hh h mm ss a`. `ago(date)` gives \"just now\", \"5 minutes ago\", \"in 2 days\". The static paint formats with a built-in table for the common locales and currencies; the live page uses `Intl` and corrects any difference.")

        Heading("Regular expressions", id: "regular-expressions").h2

        CodeBlock(#"page Regex(path: "/") {
    state email = ""
    derived valid = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)
    derived domain = email.split("@").last() ?? ""
    Input(bind: email, label: "Email")
    if email != "" && !valid { Text("That does not look like an email.").danger.sm }
    Text("Domain: {domain}")
}"#, title: "wf")

        Markdown("`/…/flags` is a regex; `re.test(s)` is a `Bool`, `s.match(re)` and `re.exec(s)` a `[String]?`, `s.replace(re, \"x\")` a `String`.")

        Heading("Tokens as values", id: "tokens-as-values").h2

        Markdown("`$name` names a design token from the theme ([chapter 12](/docs/guide/styling)). In a style it becomes the CSS variable; as a value it is the variable reference, so a prop that takes a color takes a token:")

        CodeBlock(#"page Tokens(path: "/") {
    state accent = $primary
    Card {
        style { border-left: 4px solid {accent} }
        Text("Accent from a token")
    }
}"#, title: "wf")

        Heading("await", id: "await").h2

        Markdown("`await` waits for a promise in an action or handler, and makes the action asynchronous:")

        CodeBlock(#"page Await(path: "/") {
    state rows: [Map] = []
    state note = ""
    action load() {
        let r = await fetch("/api/rows")
        rows = r.rows
        let text = await fetch("/api/note", { method: "GET" })
        note = text.note
    }
    Button("Load", disabled: load.pending) { on click { load() } }
    Text("{rows.length} rows, note: {note}")
}"#, title: "wf")

        Markdown("`fetch(url, options)` returns the parsed JSON body (or throws on a failed response); `options` is a map with `method`, `headers`, `body` (a map is sent as JSON). [Chapter 14](/docs/guide/data) has `resource`, the declarative form.")

        Heading("Constants and environment", id: "constants-and-environment").h2

        CodeBlock(#"const MAX_ROWS = 50
const API = env.PUBLIC_API_URL ?? "/api"

page Consts(path: "/") {
    Text("Up to {MAX_ROWS} rows from {API}")
}"#, title: "wf")

        Markdown("`const` declares a project-wide value; `env.NAME` reads a variable from the build environment (and `.env` in the project root). Both are inlined.")

        Heading("Built-in functions", id: "built-in-functions").h2

        Markdown("These are the whole of what the language adds to what the browser already has. Everything else with parentheses after it is a method, an action, a component or one of the browser's own globals.")

        Table(caption: "Built-in functions") {
            Table.Head {
                Table.Row {
                    Table.Cell("Name").header
                    Table.Cell("Does").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`log(x, …)`") }
                    Table.Cell("Prints to the console")
                }
                Table.Row {
                    Table.Cell { Markdown("`navigate(path)`") }
                    Table.Cell { Markdown("Changes the route ([chapter 3](/docs/guide/pages-and-routing#links-and-navigation))") }
                }
                Table.Row {
                    Table.Cell { Markdown("`format(v, .style, opt)`, `ago(d)`") }
                    Table.Cell { Markdown("[Above](#format-and-ago)") }
                }
                Table.Row {
                    Table.Cell { Markdown("`t(\"key\", args)`, `setLocale(\"ar\")`") }
                    Table.Cell { Markdown("Translates, and switches locale ([chapter 15](/docs/guide/i18n))") }
                }
                Table.Row {
                    Table.Cell { Markdown("`setTheme(\"dark\")`") }
                    Table.Cell { Markdown("`\"dark\"`, `\"light\"` or `\"system\"`, kept across visits ([chapter 12](/docs/guide/styling#dark-mode))") }
                }
                Table.Row {
                    Table.Cell { Markdown("`every(ms) \{ \}`, `after(ms) \{ \}`") }
                    Table.Cell { Markdown("Timers ([chapter 5](/docs/guide/state#timers))") }
                }
                Table.Row {
                    Table.Cell { Markdown("`animate(el, name, ms)`, `replayAnimation(el, name)`") }
                    Table.Cell { Markdown("Plays one by hand ([chapter 13](/docs/guide/motion#driving-one-yourself))") }
                }
                Table.Row {
                    Table.Cell { Markdown("`optimistic(holder, change)`") }
                    Table.Cell { Markdown("Shows a change before the server agrees ([chapter 14](/docs/guide/data#showing-a-change-before-the-server-agrees))") }
                }
                Table.Row {
                    Table.Cell { Markdown("`beacon(url, data)`") }
                    Table.Cell { Markdown("A send that outlives the page ([chapter 14](/docs/guide/data#a-connection-the-page-holds-open))") }
                }
                Table.Row {
                    Table.Cell { Markdown("`sanitize(html)`") }
                    Table.Cell { Markdown("Markup, through an allow-list ([chapter 19](/docs/guide/security#markup-you-did-not-write))") }
                }
                Table.Row {
                    Table.Cell { Markdown("`uuid()`") }
                    Table.Cell { Markdown("A fresh `Uuid` ([chapter 10](/docs/guide/types#the-types-the-language-brings-with-it))") }
                }
            }
        }

        Markdown("The browser's own globals need no prefix and compile to themselves: `window`, `document`, `console`, `localStorage`, `sessionStorage`, `JSON`, `Math`, `Date`, `setTimeout`, `setInterval`, `clearTimeout`, `clearInterval`, `parseInt`, `parseFloat`, `Array`, `Object`, `String`, `Number`, `Boolean`, `Promise`, `Error`, `Map`, `Set`, `RegExp`, `Infinity`, `NaN`, `undefined`, `encodeURIComponent`, `decodeURIComponent`, `encodeURI`, `decodeURI`, `atob`, `btoa`, `fetch`, `alert`, `confirm`, `prompt`, `requestAnimationFrame` and `cancelAnimationFrame`.")
    }
}
