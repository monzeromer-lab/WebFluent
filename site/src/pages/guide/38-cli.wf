/// Chapter 38 of the guide, written from md-docs/38-cli.md by
/// scripts/site-from-guide.py; edit the guide, not this file.
page CliGuide(path: "/docs/guide/cli", title: "Command line and editors", description: "The wf command line: init, build, check, explain, serve, test, verify, fmt, generate, render, migrate, audit, docs, registry, types — and editor setup.", layout: DocsShell("Command line and editors", chapter: t("guide.chapter", { n: "38" }), blurb: "Every wf command and flag, the dev server, and the language server in each editor.", source: "md-docs/38-cli.md", sections: [Anchor(id: "the-commands", label: "The commands"), Anchor(id: "creating-and-building", label: "Creating and building"), Anchor(id: "checking", label: "Checking"), Anchor(id: "formatting", label: "Formatting"), Anchor(id: "rendering", label: "Rendering"), Anchor(id: "upgrading", label: "Upgrading"), Anchor(id: "describing", label: "Describing"), Anchor(id: "environment-variables", label: "Environment variables"), Anchor(id: "editors", label: "Editors"), Anchor(id: "building-a-tool-on-the-compiler", label: "Building a tool on the compiler")], prevTo: "/docs/reference", prevLabel: "37. {t("ch.37")}", nextTo: "/docs/guide/config", nextLabel: "39. {t("ch.39")}")) {
    Stack(gap: .lg) {
        Markdown("One binary, `wf`, scaffolds, builds, serves, formats, tests, renders and describes a project. A second, `wf-lsp`, brings the same checks into your editor. `wf --help` lists the commands and `wf <command> --help` each one's flags; `wf --version` prints the version.\n\nEvery command that takes a project runs in the current directory unless told otherwise, and exits non-zero on failure, so each is a CI step as it is.")

        Heading("The commands", id: "the-commands").h2

        Table(caption: "The commands") {
            Table.Head {
                Table.Row {
                    Table.Cell("Command").header
                    Table.Cell("Does").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`wf init NAME [-t, --template spa|static|pdf|slides] [-l, --locales LIST]`") }
                    Table.Cell { Markdown("Creates a project from a template, translated into `LIST` when given") }
                }
                Table.Row {
                    Table.Cell { Markdown("`wf build [-d, --dir DIR] [--stats] [--format FORMAT] [--deny-warnings] [--cache] [--studio]`") }
                    Table.Cell("Compiles the project; fails on errors, prints warnings")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf check [-d, --dir DIR] [--format FORMAT] [--deny-warnings]`") }
                    Table.Cell("Every finding a build would report, with nothing written")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf fix [-d, --dir DIR] [--code CODE] [--dry-run]`") }
                    Table.Cell("Fixes every finding that has a fix, or every one of a code")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf config schema [--json]`, `wf config get|set|unset PATH [VALUE] [-d, --dir DIR]`") }
                    Table.Cell { Markdown("Every setting, and an edit of `webfluent.app.json` that keeps its shape") }
                }
                Table.Row {
                    Table.Cell { Markdown("`wf explain [CODE]`") }
                    Table.Cell("What a diagnostic code means, a program that draws it, and the fix")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf serve [-d, --dir DIR]`") }
                    Table.Cell { Markdown("Builds, serves on `dev.port`, rebuilds and reloads on every save") }
                }
                Table.Row {
                    Table.Cell { Markdown("`wf test [PATH] [--update]`") }
                    Table.Cell { Markdown("Runs the project's `test` declarations") }
                }
                Table.Row {
                    Table.Cell { Markdown("`wf verify [PATH] [--json] [--budget MS] [--returning-visitor]`") }
                    Table.Cell("Loads every built page in headless Chrome")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf fmt [PATH] [--check] [--stdout] [--to wf|wfx]`") }
                    Table.Cell("Formats sources, or switches their layout")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf generate page|component|store NAME [-d, --dir DIR]`") }
                    Table.Cell("Writes a starter file")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf render FILE|DIR [--data JSON] [-f, --format FORMAT] [-o, --output OUT] [--page NAME] [--lang LANG] [--theme NAME] [--token NAME=VALUE]`") }
                    Table.Cell("Renders a template with data")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf migrate [PATH] [--check] [--stdout] [--wfx]`") }
                    Table.Cell("Carries a WebFluent 2, 3 or 4.1 project forward")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf audit [PATH] [--json]`") }
                    Table.Cell("Lists what the project trusts")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf docs [-d, --dir DIR] [-o, --out OUT]`") }
                    Table.Cell("Writes a gallery of every component")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf registry [--json]`") }
                    Table.Cell("Describes every built-in")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf theme [-d, --dir DIR] [--json]`") }
                    Table.Cell("The theme the build uses: every token, declared or inherited, where each is used, and its contrast")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf context [-d, --dir DIR] [--open FILE[:START-END]] [--guide index|full] [--json]`") }
                    Table.Cell { Markdown("What an agent is given: the files, the problems, the components, the theme, the config with only its public `env`, the guide, and what was withheld") }
                }
                Table.Row {
                    Table.Cell { Markdown("`wf translations [-d, --dir DIR] [--missing LOCALE] [--unused] [--plurals] [--json]`") }
                    Table.Cell("The translations as a table: each locale's plural forms and what it lacks, each key's messages and uses")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf scope FILE:LINE[:COL] [-d, --dir DIR] [--data JSON] [--json]`") }
                    Table.Cell("What can be read at a place: the names in scope, each with its type and where it comes from")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf rules [-d, --dir DIR] [--json]`") }
                    Table.Cell { Markdown("The rules a `validate` block may hold, the named patterns, when a form shows its messages, and every state the project holds to a rule") }
                }
                Table.Row {
                    Table.Cell { Markdown("`wf motion [-d, --dir DIR] [--json]`") }
                    Table.Cell("The animations an element can play, the eases and speeds, the route transitions and the project's default")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf components [-d, --dir DIR] [--json]`") }
                    Table.Cell("Every component a call can name — the built-ins and the project's — with what each takes")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf commands [--json]`") }
                    Table.Cell("Describes every command: its options, what it writes, and how to see it first")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf assets [-d, --dir DIR] [--unused] [--plan PATH] [--json]`") }
                    Table.Cell { Markdown("Lists `public/` and where each file is used, or what the image pipeline will make of one") }
                }
                Table.Row {
                    Table.Cell { Markdown("`wf types [PATH] [--json]`") }
                    Table.Cell("Describes what the project declares")
                }
            }
        }

        Heading("Creating and building", id: "creating-and-building").h2

        Heading("wf init", id: "wf-init").h3

        Terminal(lines: [
                Line(command: "wf init my-site -t static")
            ])

        Markdown("Makes a directory `NAME` with a config, a `.gitignore` and a small working application for the template: `spa` (the default — an interactive app), `static` (a marketing site, pre-rendered), `pdf` (a document) or `slides` (a deck). It refuses a directory that already exists.")

        Terminal(lines: [
                Line(command: "wf init my-app --locales en,ar")
            ])

        Markdown("`--locales` starts it translated, in the languages listed — the first the default. Every visible string of the starter goes through `t(\"…\")`, the config's `i18n` names the locales (and `meta.lang` the default), the language switch has one entry for each, and `src/translations/` holds a file per locale: the default's is the starter's English, the text its pages and tests are written in; another is the starter's own translation where it has one (Arabic) and the same English otherwise, for you to translate. A locale is a language tag — `en`, `ar`, `pt-BR`, `zh-Hant`, written in any case and kept in the usual one; a tag named twice, an empty list, or a code that is not a tag (`pt_BR`) is refused with what to write instead. `spa` and `static` take locales; a `pdf` or a `slides` deck is made in one language and refuses them. [Internationalisation](/docs/guide/i18n) is the rest.\n\nIt also writes `AGENTS.md`: the language reference, the file a coding agent reads before it changes a project — so an assistant asked to add a page writes the WebFluent of the `wf` that made it, flags and all, rather than guessing. Its first line names the version it describes; a newer `wf` brings a newer one, and an older project can take it from the [repository](https://github.com/monzeromer-lab/WebFluent/blob/master/AGENTS.md).")

        Heading("wf build", id: "wf-build").h3

        Markdown("Runs the whole pipeline — parse, semantic checks, type checks, linters, code generation — and writes `build.output` (`./build`). Errors stop the build with the file, line, column, message and a hint; warnings print and the build goes on. `-d DIR` builds another directory.\n\n`--format` says how the findings are written: `human` (the default, on standard error), `json` (one document on standard output — every finding with its code, place, hint, related places and fixes, and the counts), `sarif` (SARIF 2.1.0, for GitHub code scanning and every other SARIF reader) or `github` (`::error file=…` annotations on standard output, which a workflow shows on the pull request, with the rendering kept on standard error). With `json` or `sarif` the build's progress goes to standard error, so standard output is the document alone. `--deny-warnings` stops the build on a warning, as on an error — the switch for CI.\n\n`--cache` reuses what earlier builds pre-rendered, kept in `.wf-cache/build/`: a page whose inputs are what they were — its own text, every component it reaches, and what every page reads (the shell, the stores, constants and data, every page's title and route, the config, the translations, the compiler) — is taken from the cache, and only the pages an edit changed are rendered again. What it writes is what a build without it writes, byte for byte. A build with nothing to reuse fills the cache; each keeps only what it used.\n\n`--studio` builds for an editor's preview: every element's root carries `data-wf-node`, its node id — the same in the pre-rendered page and the live one — and an instance of one of the project's components carries `data-wf-call`, the calls that made it, innermost first. `nodes.json` beside the site maps each id to where it is written (file, bytes, line), what it calls, its parent, the loops and branches it is inside and what its arguments read. A build without `--studio` stamps nothing and removes a `nodes.json` it finds there.\n\n`--stats` prints what the build weighs: every text file with its gzipped size and how it moved since the last build, the runtime modules it kept and what reached each, and the design tokens it left out. [Performance](/docs/guide/performance) reads it.")

        Heading("wf serve", id: "wf-serve").h3

        Markdown("The development loop. It builds once, serves the output on `dev.port` (3000), watches `src/`, `public/` and the config, rebuilds on a change and reloads every open tab. Each rebuild is `wf build --cache`: only the pages the change reached are rendered again. A build that fails leaves the last good page up and draws the error over it — file, line, message and hint — until the next save fixes it. The overlay is served at `/__wf/dev.js`, the build's state at `/__wf/status` (JSON).\n\nEvery page it serves also carries a **stores** button: what each store holds, a log of every action with the state on each side of it, and a click to put a store back ([Stores](/docs/guide/stores#looking-at-one-while-it-runs)). An offline site's service worker is removed under `wf serve`, so an edit is never hidden behind its cache.\n\nA request that is not a page — a `fetch`, a script, an image — for a file the build did not write gets a `404`, as a host would send, and a line in the terminal saying which; only a navigation gets the single-page shell. A missing API used to be answered with the shell's HTML, which then failed to parse somewhere far from the cause.\n\nA build under `wf serve` is a development build, and the page knows it:\n\n- a response a type is declared for — `resource users: [User] = …`, an `api` endpoint's `-> User` — is held to that type as it arrives, and one that does not match takes the `error` arm as a `.parse` error naming the place: `$[1].name is missing`;\n- a route no page answers (and no `path: \"*\"` page catches) shows a `404` box saying so, where a deployed page shows nothing;\n- an item of a `for` that throws shows where it is, with what it threw, and the rest of the list draws — on a deployed page it leaves a gap and the console says why;\n- an effect that changes what it reads every time it runs is stopped after a hundred runs, with a warning, instead of overflowing the stack (it is stopped on a deployed page too, silently).")

        Heading("wf generate", id: "wf-generate").h3

        Terminal(lines: [
                Line(command: "wf generate page Pricing"),
                Line(command: "wf generate component PriceCard"),
                Line(command: "wf generate store Cart")
            ])

        Markdown("Writes a starter declaration in `src/pages/`, `src/components/` or `src/stores/` — in `.wfx` when the project is written that way — and never overwrites a file. A page gets a path from its name (`/pricing`), a title, a description and an `h1`.")

        Heading("Checking", id: "checking").h2

        Heading("wf check", id: "wf-check").h3

        Terminal(lines: [
                Line(command: "wf check"),
                Line(command: "wf check --format sarif > wf.sarif"),
                Line(command: "wf check --deny-warnings")
            ])

        Markdown("Runs every check a build runs — the parser, the structure, the types, the lints, the config — and writes nothing, so it is fast enough for a pre-commit hook. It takes `--format` and `--deny-warnings` as `wf build` does, exits `1` on a finding that stops a build and `0` otherwise, and says `No problems in NAME.` when there are none. What only the output can show — the security policy read back over the written pages — is the build's.")

        Heading("wf fix", id: "wf-fix").h3

        Terminal(lines: [
                Line(command: "wf fix"),
                Line(command: "wf fix --code V07"),
                Line(command: "wf fix --dry-run")
            ])

        Markdown("Fixes every finding that has a fix, by the fix an editor offers first — or, with `--code`, every finding of one code — and writes the files. A fix that would overlap another is taken on a second look, as is one that the first fixes make way for, until nothing more changes. It then says what is left: findings with no certain fix, which a person decides (`wf check` lists them). `--dry-run` writes nothing and names the files that would change.")

        Heading("wf config", id: "wf-config").h3

        Terminal(lines: [
                Line(command: "wf config schema"),
                Line(command: "wf config schema --json"),
                Line(command: "wf config get build.base_path"),
                Line(command: "wf config set build.ssg true"),
                Line(command: "wf config set meta.lang ar"),
                Line(command: "wf config unset build.ssg")
            ])

        Markdown("`schema` is every setting of `webfluent.app.json`: its type, the values it takes, its default and one sentence ([Configuration](/docs/guide/config)); `--json` writes it for a tool. `get` says what the project sets at a dotted path, or the default. `set` writes a value — JSON (`true`, `3`, `[\"en\", \"ar\"]`), or a word as a string — held to the setting's type first, and `unset` removes one so its default applies; both keep the file as it was written apart from that value. Under a map, the rest of the path is one key: `build.budget.app.js`.")

        Heading("wf explain", id: "wf-explain").h3

        Terminal(lines: [
                Line(command: "wf explain T05"),
                Line(command: "wf explain")
            ])

        Markdown("A code's entry in [Diagnostics](/docs/guide/diagnostics), in the terminal: what it means, a program that draws it, what the compiler says, the fix and the link. With no code, every code with its severity and title.")

        Heading("wf test", id: "wf-test").h3

        Terminal(lines: [
                Line(command: "wf test"),
                Line(command: "wf test tests/cart.wf"),
                Line(command: "wf test --update")
            ])

        Markdown("Runs every `test \"…\" \{ \}` under `tests/` (and in `src/`), or those in one file; `--update` rewrites the snapshots. A test that clicks or types runs in headless Chrome, on a page that links the project's scripts. [Testing](/docs/guide/testing) covers writing them.")

        Heading("wf verify", id: "wf-verify").h3

        Markdown("A build says what the compiler wrote. This says what a browser does with it.")

        Terminal(lines: [
                Line(command: "wf build && wf verify")
            ])

        Markdown("It starts a headless Chrome, serves the output, and opens every route the project has — a `:param` route at each value its `paths:` names, or at a placeholder (`/user/1`) when it names none. A route fails on an uncaught exception, a `console.error`, a file that did not arrive (a `fetch` the build has no file for is a `404`, not the page shell), an image that failed to load, a router that drew nothing into `<main>`, or a page that rendered no text — the things a compiler cannot see and a reader always can.")

        CodeBlock(#"  16 route(s) in http://127.0.0.1:39785
    ok   /                                    236ms     613 nodes    447.0 kB   11 req
    ok   /app/deployments                      68ms     657 nodes    360.6 kB   10 req

  16 page(s), 0 problem(s)"#, title: "")

        Markdown("The numbers are the first contentful paint, the elements in the document once it settled, the bytes the page fetched and the requests it made. `--budget 400` fails a route that takes longer than that to paint. `--json` is the same report for a pipeline. `--returning-visitor` visits every route a second time as a reader who was here before: their storage holds what the previous build's pages kept — each `persist` value's starting value as the build before this one wrote it, which a build saves in `.wf-cache/` when they change — so a shape that changed without a `version:` shows as the broken page it would be.\n\nIt also says **which built-ins no page drew**. A component can be in the registry, in the tests and in the documentation and still be broken in a page; the classes the pages carried are the list of what actually ran, so the difference is what nothing has exercised. One project is not expected to draw them all — it is a fact about coverage, not a failure.\n\nIt needs a Chrome or Chromium on the machine, or `WF_CHROME` pointing at one, and says so plainly when there is none.")

        Heading("wf audit", id: "wf-audit").h3

        Terminal(lines: [
                Line(command: "wf audit"),
                Line(command: "wf audit --json")
            ])

        Markdown("Prints what a security review asks for: every `Unsafe.*` and whether it is sanitised, the project's own scripts and what each declares, every other origin the pages load from, everything kept on the reader's machine, every `env` name and whether it is public, the policy the build ships, and what the compiler depends on. It reports and never fails. [Security](/docs/guide/security#wf-audit).")

        Heading("Formatting", id: "formatting").h2

        Heading("wf fmt", id: "wf-fmt").h3

        Terminal(lines: [
                Line(command: "wf fmt"),
                Line(command: "wf fmt --check"),
                Line(command: "wf fmt src/pages/Home.wf --stdout"),
                Line(command: "wf fmt --to wfx")
            ])

        Markdown("Formats every `.wf` and `.wfx` under a path, or one file, in place: four spaces a level, a line that closes a block one level out, trailing spaces gone, tabs made spaces, runs of blank lines folded to one, a brace one space from what it opens (`Row\{` → `Row \{`, `\}else` → `\} else`). A line carried on by a trailing comma is left as written, and comments stay where they are. The result is held to the file's own tokens, so formatting never changes what a file says.\n\n- `--check` writes nothing and fails when a file would change — for CI.\n- `--stdout` prints one file instead of writing it.\n- `--to wfx` rewrites a project's `.wf` files in the indented layout, and `--to wf` the other way. It is a change of layout and nothing else; it refuses a file whose indentation does not already follow its braces.")

        Heading("Rendering", id: "rendering").h2

        Heading("wf render", id: "wf-render").h3

        Terminal(lines: [
                Line(command: "wf render invoice.wf --data invoice.json -f pdf -o invoice.pdf"),
                Line(command: "echo '\{\"name\":\"Ada\"\}' | wf render greeting.wf"),
                Line(command: "wf render templates/ --page Receipt --lang ar --data receipt.json")
            ])

        Markdown("Renders one template with JSON data: `-f` / `--format` is `html` (a whole document, the default), `html-fragment` (the body only), `pdf` or `slides`; `-o` writes a file instead of printing; `--theme` picks one of several themes the template declares; `--token color-primary=#8B5CF6` sets a design token over the theme's, as often as it is given; `--lang` sets the document's `<html lang>`; without `--data` the JSON is read from stdin. The template may be a directory — every `.wf` and `.wfx` under it as one, components shared — and `--page` names the page to render when there are several. The template is held to what a build is — a component nothing declares or a flag it does not take stops the render — except that the names it reads are its data's. [Server rendering](/docs/guide/server-rendering).")

        Heading("Upgrading", id: "upgrading").h2

        Heading("wf migrate", id: "wf-migrate").h3

        Markdown("Three things, in one command.\n\n**4.1 → 4.2** runs first, because 4.2 refuses `external`: a remote module becomes a `meta.scripts` entry, a local one a plain script under `src/` with its signatures as JSDoc (`X.f(…)` becomes `f(…)`), and an `external element` call `Element(\"tag\", …)`. It lists every `.js` already under `src/`, since each now ships on every page.\n\n**2 → 3** rewrites every `.wf` under `src/` in place, with a note for anything that needed a decision. It is a change of spelling: the migrated project builds to what it built before.\n\n**3 → 4** is a change of what the compiler allows, so it runs over the project rather than the files. It adds every `env` name your pages already read to `public_env` — preserving what the project did, and printing the list, because *public* means anyone who opens the site may read the value. Then it names, with file and line, everything 4 refuses that 3 allowed: an `on*` attribute, a `javascript:` or `data:` URL. Those have no automatic rewrite; the old value was a string of JavaScript or a link that ran one. Finally it states the changes that need no edit: a store is built on first read rather than at boot, a `persist` value follows the site's other tabs, and `WF.store`/`WF.host` were renamed.\n\n`--check` writes nothing and tells you what it would do.")

        Heading("Describing", id: "describing").h2

        Heading("wf commands", id: "wf-commands").h3

        Terminal(lines: [
                Line(command: "wf commands"),
                Line(command: "wf commands --json")
            ])

        Markdown("Every command as data: what it does, each option — its flag, what it takes (`nothing` for a flag, a `word` from the values it lists, a `number`, a `path`, `text`), its default — what the command writes, and the flag that shows it first and writes nothing (`fmt --check`, `migrate --check`, `fix --dry-run`). A tool page, a palette or a script is built from it rather than from a copy of this page; the library has the same, as `webfluent::commands`.")

        Heading("wf assets", id: "wf-assets").h3

        Terminal(lines: [
                Line(command: "wf assets"),
                Line(command: "wf assets --unused"),
                Line(command: "wf assets --plan /hero.png"),
                Line(command: "wf assets --json")
            ])

        Markdown("Every file of `public/`: its kind (image, font, video, audio, document, code, data), its size, a picture's dimensions, and every place the project names it — a prop the registry types as a file (`Image`'s `src`, `Video`'s `poster` and `captions`), a page's `image:`, a `const`, an `image` declaration, a `data` file's strings, a value of `webfluent.app.json`, a stylesheet's `url(…)`, a project script, a manifest. A file a browser or a host asks for by name — `favicon.ico`, `robots.txt`, `.well-known/…` — is used by convention; anything else nothing names is counted unused, and `--unused` lists only those.\n\n`--plan PATH` is what the image pipeline will make of one picture with the project's `build.media`: each width it writes, in each format, the file's name and its size — *3 widths × 1 format · 3 files · about 84 kB*. A size is exact once `wf build` has written the file (it is read from `.wf-cache/media/`) or when the picture is small enough to encode there and then; otherwise it is estimated from strips of it encoded at that width, and says `about`. A format the build cannot write is named, with why, and so is a width it would not write because the file would be no smaller than the original. `--json` carries the same sentences as `said`.\n\nThe library has the same as `webfluent::assets::\{list, plan\}`, reading through a `Vfs`, so an editor's unsaved buffers count.")

        Heading("wf theme", id: "wf-theme").h3

        Terminal(lines: [
                Line(command: "wf theme"),
                Line(command: "wf theme --json")
            ])

        Markdown("The theme the build uses, as an editor shows it: every token by its group (colour, spacing, font size, line height, radius, shadow, transition, font, motion, and those the theme invents), its value, the baseline's, whether the theme declares it or inherits it, the dark theme's value when `theme.dark` names one, the properties that draw from it and every place the project names it; then the colour pairings the stylesheet composes, with their contrast and what WCAG AA asks of each — a pairing that falls short is the `A13` the build reports — and the tokens one theme of the dark pair declares and the other does not.")

        Heading("wf motion", id: "wf-motion").h3

        Terminal(lines: [
                Line(command: "wf motion"),
                Line(command: "wf motion --json")
            ])

        Markdown("What a Motion section offers: every animation `animate:` and `exit:` take — the engine's, each with the keyframes and the rule its stylesheet plays it by, whether it is one an element leaves with and whether it repeats, then the project's own `animation` declarations — the named eases with the timing function each stands for, the three speeds and their lengths, the Router's transitions, the project's default length and pacing (`motion` in the config, or the engine's), and the attribute an editor sets on the page's root, `data-wf-motion=\"reduce\"`, to show the page as a reader who asked for less motion sees it. The library has it as `webfluent::motion::catalogue`.")

        Heading("wf context", id: "wf-context").h3

        Terminal(lines: [
                Line(command: "wf context"),
                Line(command: "wf context --open src/pages/Home.wf:120-180"),
                Line(command: "wf context --guide full --json")
            ])

        Markdown("What an agent working on the project is given, named so nothing it is told is a mystery: every file of the project (not the build's output, `.git/`, dependencies or a `.env` file), the file open and its selection, the problems the build reports, every component a call can name with its props, cases, events and slots, the theme's tokens, `webfluent.app.json` with each `env` value `public_env` does not list withheld, and the guide — each chapter's title, blurb and sections to cite (`16 Forms and validation › What a value must be: validate`), or with `--guide full` the chapters whole — then what was withheld, and why. Without `--json` it is one Markdown document. The library has it as `webfluent::agent::context`, and an agent's edits as `webfluent::agent::changeset::ChangeSet`: a layer over the editor's buffers the compiler builds before anyone reads it, which refuses paths outside the project, `.git/`, the build's output and `.env` files, reads the config with its private values withheld and keeps them through a write, and is accepted whole, by file or by hunk.")

        Heading("wf translations", id: "wf-translations").h3

        Terminal(lines: [
                Line(command: "wf translations"),
                Line(command: "wf translations --missing ar"),
                Line(command: "wf translations --unused"),
                Line(command: "wf translations --json"),
                Line(command: "wf translations --plurals")
            ])

        Markdown("The translations as an editor's table: each locale with its file, whether it is the default and right to left, the plural forms CLDR's rules give it, and how many keys it has no message for, how many lack a form it needs, and how many messages have placeholders the default locale's do not; `--missing LOCALE` lists the keys that locale lacks and `--unused` the keys nothing names — no `t()`, no key built at run time that may be it, no `validate` rule that shows it. `--json` is the whole table: every key, plural ones with each form, each message in each locale with its placeholders and its line, and every place a `t()` names the key; and the calls that name a key no locale has (`I01`). `--plurals` prints CLDR's rules instead — each locale's forms, and with `--json` the form each of a run of counts takes. The library has it as `webfluent::i18n::table`, which writes one message back with `set_message`, every other byte of the file as it was.")

        Heading("wf scope", id: "wf-scope").h3

        Terminal(lines: [
                Line(command: "wf scope src/pages/Deploys.wf:24"),
                Line(command: "wf scope src/pages/Deploys.wf:24:9 --json"),
                Line(command: "wf scope src/templates/invoice.wf:3 --data data/invoice.json")
            ])

        Markdown("What a condition, a loop, a binding or a prop that takes anything may read at that place, in the order a path picker lists it: the page or component's own `state` and `derived` values (and the form it binds), its props and a page's route parameters, what the statements around the place bind — a loop's item and index, an `if let`, a `match` arm, a slot's fill, an action's parameters and the `let`s before the place — innermost first, then the members of every store it `use`s; with `--data`, a template's data after them. Each row has its type as the checker infers it, its shape (`bool`, `number`, `text`, `moment`, `list`, `record`, `enum` …), whether it may be `null`, where it comes from (`for d in live`, `member of Deploys`), and the fields of a record to go on into (`d.region.code`). It is the scope the editor's completion offers; the library has it as `webfluent::scope`.")

        Heading("wf rules", id: "wf-rules").h3

        Terminal(lines: [
                Line(command: "wf rules"),
                Line(command: "wf rules --json")
            ])

        Markdown("What a form's Must be section offers: every rule a `validate` block may hold — what it takes between its parentheses, when it holds, the message it shows when none is written and the translation key (`form.minLength`) that replaces that message in a project with translations, whether an empty value passes it and whether it is asked last — and the bounds a refined type implies (`below`, `after`, `before`); the handful of patterns people write, by name, each with the expression and a message; `Form(show:)`'s cases in the reader's terms; the attribute a preview sets on the page's root, `data-wf-validation=\"shown\"`, to show every message now; then every state in the project held to a rule, with its rules in order, the ones its type implies first, and whether the page checks them as the reader types. The library has it as `webfluent::validation`.")

        Heading("wf components", id: "wf-components").h3

        Terminal(lines: [
                Line(command: "wf components"),
                Line(command: "wf components --json")
            ])

        Markdown("Every component a call can name, the built-ins and then the project's own, in one vocabulary: each prop with the kind of value it takes (`text`, `number`, `enum` and its cases, `file` and what kind, `state`, `path`, a declared `record`, a `list`, `date`, `color`, `money` …), whether it is the positional one, its default as written, a range where its type declares one (`Number(0..=100)`), and whether `.name` alone sets it; then the component's events, its slots and what each hands its fill, its parts and their owner, the attribute families its root takes, and whether it takes children. It is the table the checker reads a call against — an inspector draws a control per prop from it, and an Insert panel knows what may go where. The library has it as `webfluent::registry::schema::of_project_via`.")

        Heading("wf docs, wf registry, wf types", id: "wf-docs-wf-registry-wf-types").h3

        Markdown("`wf docs` writes `docs/index.html` (or `-o OUT`): a self-contained gallery of every built-in — props, cases, flags, events, slots, parts — and of every component, enum, type, store and page the project declares, with their `///` docs.\n\n`wf registry` describes every built-in, and `wf types` what a project declares — the names its scripts under `src/` declare included, each with the parameters and return its JSDoc gives them; with `--json` each prints the data a tool reads:")

        Terminal(lines: [
                Line(command: "wf registry --json | jq '.components[] | select(.name == \"Button\") | .props[].name'")
            ])

        Markdown("The registry is the compiler's own table: what it prints is exactly what the checker accepts.")

        Heading("Environment variables", id: "environment-variables").h2

        Table(caption: "Environment variables") {
            Table.Head {
                Table.Row {
                    Table.Cell("Variable").header
                    Table.Cell("Read by").header
                    Table.Cell("Does").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`WF_INSTALL_DIR`") }
                    Table.Cell { Markdown("`install.sh`, `install.ps1`") }
                    Table.Cell { Markdown("Where the binary is installed (default `~/.webfluent/bin`)") }
                }
                Table.Row {
                    Table.Cell { Markdown("`WF_VERSION`") }
                    Table.Cell { Markdown("`install.sh`, `install.ps1`") }
                    Table.Cell { Markdown("The release to install, `v4.0.1`, instead of the latest") }
                }
                Table.Row {
                    Table.Cell { Markdown("`WF_CHROME`") }
                    Table.Cell { Markdown("`wf test`, `wf verify`") }
                    Table.Cell("The Chrome or Chromium to drive, when it is not found on its own")
                }
                Table.Row {
                    Table.Cell { Markdown("`WF_BIN`") }
                    Table.Cell("the Node binding")
                    Table.Cell { Markdown("The `wf` binary to call") }
                }
                Table.Row {
                    Table.Cell { Markdown("any `PUBLIC_…` name") }
                    Table.Cell { Markdown("`wf build`") }
                    Table.Cell { Markdown("A value for `env.NAME` ([Environments](/docs/guide/environments))") }
                }
            }
        }

        Heading("Editors", id: "editors").h2

        Markdown("`wf-lsp` is the language server. Get the binary from a [release](https://github.com/monzeromer-lab/WebFluent/releases) (`wf-lsp-<version>-<arch>-<os>.tar.gz`) and put it on your `PATH`, or build it from a clone with `cargo install --path crates/wf-lsp`. Keep it at the version of your `wf` — `wf-lsp --version` says which it is. It gives:\n\n- Diagnostics as you type — every check `wf build` runs, for `.wf`, `.wfx` and Markdown pages, again whenever a file one depends on changes (a translation, a `.env`, a script, a `public/` asset).\n- It knows what the project writes. In a project whose `build.output_type` is `pdf` or `slides`, completion offers only what paper draws — no `Button`, no `on click`, no `resource` — a `Presentation` is offered slides (and the project's slide components) and a slide everything else; hover says when an element is not drawn in this output, and why; `page` and `pages` are names inside a `Header`, `Footer` or `Background`. On a web project the paper-only elements are offered last.\n- Completion, from the compiler's own tables: components and their props after `(`, flags and parts after `.`, enum cases after `:`, events after `on `, `$` tokens, `match` arms, slot names; the fields of a record and the methods of each built-in type (`due.` offers `plus`, `isBefore`, …); a service's endpoints; the keywords each place allows (a store's, an action's, a test's steps); type names after `:`; duration units after a number; `validate` rules, `persist` settings, `format` styles, responsive steps, `Host` tags, key names in `on key(\"…\")`, translation keys in `t(\"…\")`, public `env.` names and lint codes in `// wf-allow(`.\n- Hover: what every name is — a component's doc and signature, the props every element takes, a name's inferred type, a field or an endpoint, a case, a keyword, a function the language gives, an `image`'s size.\n- Signature help inside a call: what it takes and which argument the cursor is on — an element, a component, an endpoint, an action, a project script's function or a built-in one.\n- Go to definition, find references, highlight the uses in a file, and rename across the project — for every declaration (a type, an enum, a case, a field, a `const`, a `data` file, an animation, an endpoint) and inside a string's `\{…\}` splices.\n- Formatting — `wf fmt`, on the open file.\n- Folding, inlay hints for the type of a `state` or `derived` value written without one, and semantic highlighting: a name coloured by what it resolves to, a component, a type, a store, a prop or a state.\n- Document symbols and the outline.\n- Quick fixes, from the compiler's own findings: the nearest name for a misspelt field, member, method, variable, component or flag; `?.` for a value that may be null; the props a call leaves out; the arms a `match` misses; a bare word written as its flag; `alt: \"\"` for an image; an `_` before a name nothing reads. And `Extract component` on a selection.\n\n**Zed**: the extension is in `editors/zed`; install it with `zed: install dev extension` pointing at that folder (it is not in Zed's extension registry yet). It brings Tree-sitter highlighting, outline, brackets, indentation, snippets and the language server (found on `PATH` or downloaded from the latest release), for `.wf` and `.wfx`.\n\n**VS Code**: `editors/vscode` — TextMate highlighting and the language server. Until it is on the Marketplace, run `npm ci && npm run package` in that folder and install the `.vsix` with *Extensions: Install from VSIX*.\n\n**Neovim** (0.11 or later):")

        CodeBlock(#"vim.filetype.add({ extension = { wf = "webfluent", wfx = "webfluent" } })
vim.lsp.config("wf_lsp", {
  cmd = { "wf-lsp" },
  filetypes = { "webfluent" },
  root_markers = { "webfluent.app.json" },
})
vim.lsp.enable("wf_lsp")"#, title: "lua")

        Markdown("**Helix** — in `languages.toml`:")

        CodeBlock("[[language]]\nname = \"webfluent\"\nscope = \"source.webfluent\"\nfile-types = [\"wf\", \"wfx\"]\nroots = [\"webfluent.app.json\"]\ncomment-token = \"//\"\nindent = \{ tab-width = 4, unit = \"    \" \}\nlanguage-servers = [\"wf-lsp\"]\n\n[language-server.wf-lsp]\ncommand = \"wf-lsp\"", title: "toml")

        Markdown("**Emacs** (with Eglot):")

        CodeBlock(#"(define-derived-mode webfluent-mode prog-mode "WebFluent")
(add-to-list 'auto-mode-alist '("\\.wfx?\\'" . webfluent-mode))
(with-eval-after-load 'eglot
  (add-to-list 'eglot-server-programs '(webfluent-mode . ("wf-lsp"))))"#, title: "elisp")

        Markdown("Any other editor with LSP support runs `wf-lsp` over stdio; the project root is the folder holding `webfluent.app.json`. The Tree-sitter grammars in `editors/tree-sitter-webfluent` (braces) and `editors/tree-sitter-webfluentx` (indentation) give highlighting to an editor that reads Tree-sitter.")

        Heading("Building a tool on the compiler", id: "building-a-tool-on-the-compiler").h2

        Markdown("Every command above is a call in the `webfluent` crate, and an editor, a builder or an agent calls them in process rather than running `wf`. Each reads the project through a `webfluent::vfs::Vfs`: `FsVfs` is the disk, and `OverlayVfs::over_disk()` lays the editor's unsaved buffers over it, so what a tool reports is the project as it is being edited.")

        Table(caption: "Building a tool on the compiler") {
            Table.Head {
                Table.Row {
                    Table.Cell("").header
                    Table.Cell("").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`build::\{build, check\}` with `BuildOptions`") }
                    Table.Cell { Markdown("`wf build` and `wf check`, returning every line and every finding as a `Diagnostic` with its fixes; `BuildOptions::studio` is `--studio`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`diagnostics::fixes::fix_all`") }
                    Table.Cell { Markdown("`wf fix`'s fix-all for one family in one file") }
                }
                Table.Row {
                    Table.Cell { Markdown("`print`, `reprint`, `edit::\{rewrite_element, rewrite_statement, rewrite_body, rewrite_declaration, rewrite_program\}`") }
                    Table.Cell("an element, a statement or a declaration changed in the tree and written back as the smallest edit, every other byte as it was, refused when it would not read back the same")
                }
                Table.Row {
                    Table.Cell { Markdown("`codegen::node_id::\{build_node_map_with, layers\}`") }
                    Table.Cell("every element's id, file, place, parent and what it is inside; the node at a caret; the Layers tree")
                }
                Table.Row {
                    Table.Cell { Markdown("`registry::schema::of_project_via`") }
                    Table.Cell { Markdown("`wf components`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`style_value`") }
                    Table.Cell { Markdown("each style property's shape, a value read into parts (`read_box`) and the narrowest declaration written back (`edit_box`)") }
                }
                Table.Row {
                    Table.Cell { Markdown("`themes::view::\{view_via, set_token, reset_token\}`") }
                    Table.Cell { Markdown("`wf theme`, and one token written in its place") }
                }
                Table.Row {
                    Table.Cell { Markdown("`motion::catalogue`") }
                    Table.Cell { Markdown("`wf motion`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`validation::\{must_be_via, set_rule, remove_rule, move_rule\}`") }
                    Table.Cell { Markdown("`wf rules`, and a state's `validate` block written back a rule at a time") }
                }
                Table.Row {
                    Table.Cell { Markdown("`scope::paths::at_via`") }
                    Table.Cell { Markdown("`wf scope`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`i18n::\{plurals, table\}`") }
                    Table.Cell { Markdown("`wf translations`: CLDR's plural rules, the table, and `set_message`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`assets`, `media::plan`") }
                    Table.Cell { Markdown("`wf assets`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`config::\{schema, json_edit\}`") }
                    Table.Cell { Markdown("`wf config`, and a setting written keeping the file's shape") }
                }
                Table.Row {
                    Table.Cell { Markdown("`commands`") }
                    Table.Cell { Markdown("`wf commands`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`agent::\{changeset, context, diff\}`") }
                    Table.Cell { Markdown("`wf context`, and a change set an agent writes to instead of the working tree, built before anyone reads it") }
                }
            }
        }
    }
}
