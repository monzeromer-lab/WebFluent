/// Chapter 38 of the guide, written from md-docs/38-cli.md by
/// scripts/site-from-guide.py; edit the guide, not this file.
page CliGuide(path: "/docs/guide/cli", title: "Command line and editors", description: "The wf command line — every command and flag, from init, build and serve to render, migrate and verify — and how to set up the language server in your editor.", layout: DocsShell("Command line and editors", chapter: t("guide.chapter", { n: "38" }), blurb: "Every wf command and flag, the dev server, and the language server in each editor.", source: "md-docs/38-cli.md", sections: [Anchor(id: "command-summary", label: "Command summary"), Anchor(id: "conventions", label: "Conventions"), Anchor(id: "scaffolding-and-building", label: "Scaffolding and building"), Anchor(id: "checking-and-testing", label: "Checking and testing"), Anchor(id: "formatting", label: "Formatting"), Anchor(id: "rendering", label: "Rendering"), Anchor(id: "upgrading", label: "Upgrading"), Anchor(id: "describing-the-project", label: "Describing the project"), Anchor(id: "environment-variables", label: "Environment variables"), Anchor(id: "editors", label: "Editors"), Anchor(id: "building-a-tool-on-the-compiler", label: "Building a tool on the compiler")], prevTo: "/docs/reference", prevLabel: "37. {t("ch.37")}", nextTo: "/docs/guide/config", nextLabel: "39. {t("ch.39")}")) {
    Stack(gap: .lg) {
        Markdown("This chapter is the reference for `wf`, the one binary that creates, builds, serves, checks, formats, tests, renders and describes a WebFluent project, and for `wf-lsp`, the language server that brings the same checks into your editor. Look up a command here when you need its exact flags, defaults and behaviour.\n\n`wf --help` lists the commands, `wf <command> --help` lists one command's flags, and `wf --version` prints the version (`wf 5.11.0`).")

        Terminal(lines: [
                Line(command: "wf init my-site -t static"),
                Line(command: "cd my-site"),
                Line(command: "wf serve")
            ])

        Heading("Command summary", id: "command-summary").h2

        Table(caption: "Command summary") {
            Table.Head {
                Table.Row {
                    Table.Cell("Command").header
                    Table.Cell("What it does").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`wf init NAME [-t, --template spa|static|pdf|slides] [-l, --locales LIST]`") }
                    Table.Cell { Markdown("Creates a project from a template, translated into `LIST` when given") }
                }
                Table.Row {
                    Table.Cell { Markdown("`wf build [-d, --dir DIR] [--stats] [--format FORMAT] [--deny-warnings] [--cache] [--studio]`") }
                    Table.Cell("Compiles the project; fails on errors, prints warnings")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf serve [-d, --dir DIR]`") }
                    Table.Cell { Markdown("Builds, serves on `dev.port`, and rebuilds and reloads on every save") }
                }
                Table.Row {
                    Table.Cell { Markdown("`wf generate page|component|store NAME [-d, --dir DIR]`") }
                    Table.Cell("Writes a starter file")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf check [-d, --dir DIR] [--format FORMAT] [--deny-warnings]`") }
                    Table.Cell("Reports every finding a build would report, and writes nothing")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf fix [-d, --dir DIR] [--code CODE] [--dry-run]`") }
                    Table.Cell("Applies every finding's fix, or the fixes for one code")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf config schema [--json]`, `wf config get|set|unset PATH [VALUE] [-d, --dir DIR]`") }
                    Table.Cell { Markdown("Lists every setting, and edits `webfluent.app.json` without changing its shape") }
                }
                Table.Row {
                    Table.Cell { Markdown("`wf explain [CODE]`") }
                    Table.Cell("Prints what a diagnostic code means, a program that draws it, and the fix")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf test [PATH] [--update]`") }
                    Table.Cell { Markdown("Runs the project's `test` declarations") }
                }
                Table.Row {
                    Table.Cell { Markdown("`wf verify [PATH] [--json] [--budget MS] [--returning-visitor]`") }
                    Table.Cell("Loads every built page in headless Chrome")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf audit [PATH] [--json]`") }
                    Table.Cell("Lists what the project trusts")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf fmt [PATH] [--check] [--stdout] [--to wf|wfx]`") }
                    Table.Cell("Formats sources, or switches their layout")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf render TEMPLATE [--data JSON] [-f, --format FORMAT] [-o, --output OUT] [--page NAME] [--lang LANG] [--theme NAME] [--token NAME=VALUE]`") }
                    Table.Cell("Renders a template with data")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf migrate [PATH] [--check] [--stdout] [--wfx]`") }
                    Table.Cell("Carries a WebFluent 2, 3 or 4.1 project forward")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf commands [--json]`") }
                    Table.Cell("Describes every command: its options, what it writes, and how to preview it")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf assets [-d, --dir DIR] [--unused] [--plan PATH] [--json]`") }
                    Table.Cell { Markdown("Lists `public/` and where each file is used, or what the image pipeline makes of one picture") }
                }
                Table.Row {
                    Table.Cell { Markdown("`wf theme [-d, --dir DIR] [--json]`") }
                    Table.Cell("Shows the theme the build uses: every token, declared or inherited, where each is used, and its contrast")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf motion [-d, --dir DIR] [--json]`") }
                    Table.Cell("Lists the animations, eases, speeds, route transitions and the project's default")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf context [-d, --dir DIR] [--open FILE[:START-END]] [--guide index|full] [--json]`") }
                    Table.Cell { Markdown("Prints what a coding agent is given: the files, the problems, the components, the theme, the config with only its public `env`, the guide, and what was withheld") }
                }
                Table.Row {
                    Table.Cell { Markdown("`wf translations [-d, --dir DIR] [--missing LOCALE] [--unused] [--plurals] [--json]`") }
                    Table.Cell("Shows the translations as a table: each locale's plural forms and what it lacks, each key's messages and uses")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf scope FILE:LINE[:COL] [-d, --dir DIR] [--data JSON] [--json]`") }
                    Table.Cell("Lists the names that can be read at a place, each with its type and where it comes from")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf rules [-d, --dir DIR] [--json]`") }
                    Table.Cell { Markdown("Lists the `validate` rules, the named patterns, when a form shows its messages, and every state held to a rule") }
                }
                Table.Row {
                    Table.Cell { Markdown("`wf components [-d, --dir DIR] [--json]`") }
                    Table.Cell("Lists every component a call can name — the built-ins and the project's — with what each takes")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf docs [-d, --dir DIR] [-o, --out OUT]`") }
                    Table.Cell("Writes a gallery of every component")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf registry [--json]`") }
                    Table.Cell("Describes every built-in")
                }
                Table.Row {
                    Table.Cell { Markdown("`wf types [PATH] [--json]`") }
                    Table.Cell("Describes what the project declares")
                }
            }
        }

        Heading("Conventions", id: "conventions").h2

        Markdown("These rules hold for every command unless its entry says otherwise:\n\n- **The project directory.** A command that works on a project uses the current directory. `-d DIR` (or `--dir DIR`) names another one; a command that takes a `PATH` argument instead takes the directory, or sometimes one file, as that argument.\n- **Exit status.** A command exits `0` when it succeeds and non-zero when it fails, so each command works as a CI step without a wrapper. A build that stops on its findings exits `1`; a build that cannot run at all — a file it cannot read, a config it cannot load — exits `2`.\n- **`--json`.** A describing command prints a human-readable report by default and, with `--json`, the same information as JSON for a tool.\n- **Previews.** Every command that writes files has a flag that shows what it would do and writes nothing: `wf fmt --check`, `wf migrate --check`, `wf fix --dry-run`. `wf commands` names that flag for each command.")

        Heading("Scaffolding and building", id: "scaffolding-and-building").h2

        Heading("wf init", id: "wf-init").h3

        Markdown("Creates a new project directory with a config, a `.gitignore`, an `AGENTS.md` and a small working application.\n\n**Usage:** `wf init [OPTIONS] NAME`")

        Table(caption: "wf init") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`NAME`") }
                    Table.Cell("a directory name")
                    Table.Cell("required")
                    Table.Cell { Markdown("The project's directory and name. `wf init` refuses a directory that already exists.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`-t`, `--template`") }
                    Table.Cell { Markdown("`spa`, `static`, `pdf`, `slides`") }
                    Table.Cell { Markdown("`spa`") }
                    Table.Cell { Markdown("The starter: `spa` is an interactive app, `static` a pre-rendered marketing site, `pdf` a document and `slides` a deck.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`-l`, `--locales`") }
                    Table.Cell("comma-separated language tags")
                    Table.Cell("none")
                    Table.Cell { Markdown("Starts the project translated, in the languages listed; the first is the default. `spa` and `static` only.") }
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf init my-site -t static"),
                Line(command: "wf init my-app --locales en,ar")
            ])

        Markdown("With `--locales`, every visible string of the starter goes through `t(\"…\")`, the config's `i18n` names the locales (and `meta.lang` the default), the language switch has one entry for each locale, and `src/translations/` holds a file per locale:\n\n- the default locale's file holds the starter's English, the text its pages and tests are written in;\n- another locale's file holds the starter's own translation where it has one (Arabic), and the same English otherwise, for you to translate.\n\nA locale is a language tag — `en`, `ar`, `pt-BR`, `zh-Hant` — written in any case and stored in the usual one. A tag named twice, an empty list, or a code that is not a tag (`pt_BR`) is refused with what to write instead. A `pdf` document or a `slides` deck is made in one language and refuses `--locales`.\n\n`AGENTS.md` is the language reference — the file a coding agent reads before it changes a project. With it, an assistant asked to add a page writes the WebFluent of the `wf` that made the project, flags and all, instead of guessing. Its first line names the version it describes. A newer `wf` writes a newer one, and an older project can take the current one from the [repository](https://github.com/monzeromer-lab/WebFluent/blob/master/AGENTS.md).\n\n`wf init` writes a shorter config than the full set of defaults, and turns `build.csp` on.\n\nSee also: [Internationalisation](/docs/guide/i18n), [Configuration](/docs/guide/config).")

        Heading("wf build", id: "wf-build").h3

        Markdown("Runs the whole compiler — parse, semantic checks, type checks, linters and code generation — and writes the site to `build.output` (`./build`).\n\n**Usage:** `wf build [OPTIONS]`")

        Table(caption: "wf build") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`-d`, `--dir`") }
                    Table.Cell("a directory")
                    Table.Cell { Markdown("`.`") }
                    Table.Cell("The project to build.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--format`") }
                    Table.Cell { Markdown("`human`, `json`, `sarif`, `github`") }
                    Table.Cell { Markdown("`human`") }
                    Table.Cell("How findings are written (below).")
                }
                Table.Row {
                    Table.Cell { Markdown("`--deny-warnings`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Stops the build on a warning, as on an error. Use it in CI.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--cache`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Reuses what earlier builds pre-rendered, and renders again only the pages an edit changed.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--studio`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell { Markdown("Builds for an editor's preview: node ids on every element, and `nodes.json`.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`--stats`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Prints what the build weighs.")
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf build"),
                Line(command: "wf build --format github --deny-warnings")
            ])

        Markdown("An error stops the build and prints the file, line, column, message and a hint. A warning prints and the build goes on.\n\n`--format` takes four values:")

        Table(caption: "wf build") {
            Table.Head {
                Table.Row {
                    Table.Cell("Value").header
                    Table.Cell("Output").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`human`") }
                    Table.Cell("Rendered findings on standard error.")
                }
                Table.Row {
                    Table.Cell { Markdown("`json`") }
                    Table.Cell("One document on standard output: every finding with its code, place, hint, related places and fixes, and the counts.")
                }
                Table.Row {
                    Table.Cell { Markdown("`sarif`") }
                    Table.Cell("SARIF 2.1.0, for GitHub code scanning and every other SARIF reader.")
                }
                Table.Row {
                    Table.Cell { Markdown("`github`") }
                    Table.Cell { Markdown("`::error file=…` annotations on standard output, which a workflow shows on the pull request; the rendered findings stay on standard error.") }
                }
            }
        }

        Markdown("With `json` or `sarif`, the build's progress goes to standard error, so standard output holds the document alone.\n\n`--cache` keeps what it renders in `.wf-cache/build/`. A page is taken from the cache when its inputs are unchanged: its own text, every component it reaches, and what every page reads — the shell, the stores, constants and data, every page's title and route, the config, the translations and the compiler. The output is byte for byte what a build without `--cache` writes. A build with nothing to reuse fills the cache, and each build keeps only the entries it used.\n\n`--studio` stamps every element's root with `data-wf-node`, its node id, which is the same in the pre-rendered page and the live one. An instance of one of the project's components also carries `data-wf-call`: the calls that made it, innermost first. `nodes.json`, written beside the site, maps each id to where it is written (file, bytes, line), what it calls, its parent, the loops and branches it is inside, and what its arguments read. A build without `--studio` stamps nothing and removes any `nodes.json` it finds.\n\n`--stats` prints every text file with its gzipped size and how much it changed since the last build, the runtime modules the build kept and what reached each one, and the design tokens it left out.\n\nSee also: [Diagnostics](/docs/guide/diagnostics), [Performance](/docs/guide/performance).")

        Heading("wf serve", id: "wf-serve").h3

        Markdown("Runs the development server: it builds once, serves the output, and rebuilds and reloads on every save.\n\n**Usage:** `wf serve [OPTIONS]`")

        Table(caption: "wf serve") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`-d`, `--dir`") }
                    Table.Cell("a directory")
                    Table.Cell { Markdown("`.`") }
                    Table.Cell("The project to serve.")
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf serve")
            ])

        Markdown("The server listens on `dev.port` (3000). It watches `src/`, `public/` and the config, rebuilds on a change, and reloads every open tab. Each rebuild is a `wf build --cache`, so only the pages the change reached are rendered again.\n\nWhen a build fails, the last good page stays up and the error is drawn over it — file, line, message and hint — until a save fixes it. The overlay is served at `/__wf/dev.js`, and the build's state, as JSON, at `/__wf/status`.\n\nEvery page the server sends also carries a **stores** button. It shows what each store holds, a log of every action with the state on each side of it, and lets you put a store back to before an action ran ([Stores](/docs/guide/stores#looking-at-one-while-it-runs)). The service worker of an offline site is removed under `wf serve`, so an edit is never hidden behind its cache.\n\nA request that is not a navigation — a `fetch`, a script, an image — for a file the build did not write gets a `404`, as a host would send, and a line in the terminal naming the file. Only a navigation gets the single-page shell. (Answering a missing API with the shell's HTML makes the page fail to parse it, far from the cause.)\n\nA build under `wf serve` is a *development build*, and it adds these checks to the running page:\n\n- A response with a declared type — `resource users: [User] = …`, an `api` endpoint's `-> User` — is held to that type as it arrives. One that does not match takes the `error` arm as a `.parse` error naming the place: `$[1].name is missing`.\n- A route no page answers (and no `path: \"*\"` page catches) shows a `404` box saying so. A deployed page shows nothing.\n- An item of a `for` that throws shows where it is and what it threw, and the rest of the list draws. On a deployed page the item leaves a gap and the console says why.\n- An effect that changes what it reads every time it runs is stopped after a hundred runs, with a warning, instead of overflowing the stack. A deployed page stops it too, silently.\n\nSee also: [`dev` in Configuration](/docs/guide/config#dev).")

        Heading("wf generate", id: "wf-generate").h3

        Markdown("Writes a starter page, component or store.\n\n**Usage:** `wf generate [OPTIONS] KIND NAME`")

        Table(caption: "wf generate") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`KIND`") }
                    Table.Cell { Markdown("`page`, `component`, `store`") }
                    Table.Cell("required")
                    Table.Cell { Markdown("What to write, in `src/pages/`, `src/components/` or `src/stores/`.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`NAME`") }
                    Table.Cell("a name")
                    Table.Cell("required")
                    Table.Cell("The declaration's name.")
                }
                Table.Row {
                    Table.Cell { Markdown("`-d`, `--dir`") }
                    Table.Cell("a directory")
                    Table.Cell { Markdown("`.`") }
                    Table.Cell("The project to write into.")
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf generate page Pricing"),
                Line(command: "wf generate component PriceCard"),
                Line(command: "wf generate store Cart")
            ])

        Markdown("A page gets a path from its name (`/pricing`), a title, a description and an `h1`. The file is `.wfx` when the project is written in that layout. `wf generate` never overwrites a file: when one exists, it says so and writes nothing.")

        Heading("Checking and testing", id: "checking-and-testing").h2

        Heading("wf check", id: "wf-check").h3

        Markdown("Runs every check a build runs — the parser, the structure, the types, the lints and the config — and writes nothing.\n\n**Usage:** `wf check [OPTIONS]`")

        Table(caption: "wf check") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`-d`, `--dir`") }
                    Table.Cell("a directory")
                    Table.Cell { Markdown("`.`") }
                    Table.Cell("The project to check.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--format`") }
                    Table.Cell { Markdown("`human`, `json`, `sarif`, `github`") }
                    Table.Cell { Markdown("`human`") }
                    Table.Cell { Markdown("How findings are written, as for [`wf build`](#wf-build).") }
                }
                Table.Row {
                    Table.Cell { Markdown("`--deny-warnings`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Fails on a warning too.")
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf check"),
                Line(command: "wf check --format sarif > wf.sarif"),
                Line(command: "wf check --deny-warnings")
            ])

        Markdown("`wf check` is fast enough for a pre-commit hook. It exits `1` on a finding that would stop a build and `0` otherwise, and prints `No problems in NAME.` when there are none. A check that needs the written output — the security policy read back over the pages — runs only in `wf build`.\n\nSee also: [Diagnostics](/docs/guide/diagnostics).")

        Heading("wf fix", id: "wf-fix").h3

        Markdown("Applies every fix the compiler is certain of — the fix the editor offers first — and writes the files.\n\n**Usage:** `wf fix [OPTIONS]`")

        Table(caption: "wf fix") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`-d`, `--dir`") }
                    Table.Cell("a directory")
                    Table.Cell { Markdown("`.`") }
                    Table.Cell("The project to fix.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--code`") }
                    Table.Cell { Markdown("a code, such as `V07`") }
                    Table.Cell("every code")
                    Table.Cell("Fixes only that code's findings.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--dry-run`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Writes nothing, and names the files that would change.")
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf fix"),
                Line(command: "wf fix --code V07"),
                Line(command: "wf fix --dry-run")
            ])

        Markdown("A fix that overlaps another, or that the first fixes make way for, is taken on a second pass, and passes repeat until nothing more changes. `wf fix` then lists what is left: findings with no certain fix, which a person decides. `wf check` lists them too.\n\nSee also: [Diagnostics](/docs/guide/diagnostics).")

        Heading("wf config", id: "wf-config").h3

        Markdown("Reads and changes `webfluent.app.json`, and lists every setting it can hold.\n\n**Usage:** `wf config schema [--json]`, `wf config get PATH`, `wf config set PATH VALUE`, `wf config unset PATH`")

        Table(caption: "wf config") {
            Table.Head {
                Table.Row {
                    Table.Cell("Subcommand or option").header
                    Table.Cell("Value").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`schema`") }
                    Table.Cell("—")
                    Table.Cell("Every setting: its type, the values it takes, its default and one sentence.")
                }
                Table.Row {
                    Table.Cell { Markdown("`schema --json`") }
                    Table.Cell("—")
                    Table.Cell("The same, as JSON for a tool (an editor's settings window is built from it).")
                }
                Table.Row {
                    Table.Cell { Markdown("`get PATH`") }
                    Table.Cell("a dotted path")
                    Table.Cell { Markdown("What the project sets at `PATH`, or the default.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`set PATH VALUE`") }
                    Table.Cell("a dotted path and a value")
                    Table.Cell { Markdown("Writes `VALUE`: JSON (`true`, `3`, `[\"en\", \"ar\"]`), or a word as a string.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`unset PATH`") }
                    Table.Cell("a dotted path")
                    Table.Cell("Removes the setting, so its default applies.")
                }
                Table.Row {
                    Table.Cell { Markdown("`-d`, `--dir`") }
                    Table.Cell { Markdown("a directory (default `.`)") }
                    Table.Cell { Markdown("The project, for `get`, `set` and `unset`.") }
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf config schema"),
                Line(command: "wf config schema --json"),
                Line(command: "wf config get build.base_path"),
                Line(command: "wf config set build.ssg true"),
                Line(command: "wf config set meta.lang ar"),
                Line(command: "wf config unset build.ssg")
            ])

        Markdown("`set` checks the value against the setting's type before it writes anything. `set` and `unset` keep the rest of the file as it was written. Under a map, the rest of the path is one key: `build.budget.app.js` sets the `app.js` entry of `build.budget`.\n\nSee also: [Configuration](/docs/guide/config).")

        Heading("wf explain", id: "wf-explain").h3

        Markdown("Prints a diagnostic code's entry from [Diagnostics](/docs/guide/diagnostics) in the terminal.\n\n**Usage:** `wf explain [CODE]`")

        Table(caption: "wf explain") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`CODE`") }
                    Table.Cell { Markdown("a code, such as `T05`") }
                    Table.Cell("none")
                    Table.Cell { Markdown("The code to explain. Without one, `wf explain` lists every code with its severity and title.") }
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf explain T05"),
                Line(command: "wf explain")
            ])

        Markdown("An entry says what the code means, shows a program that draws it, what the compiler prints, the fix, and the link to the guide.")

        Heading("wf test", id: "wf-test").h3

        Markdown("Runs the project's `test \"…\" \{ \}` declarations.\n\n**Usage:** `wf test [OPTIONS] [PATH]`")

        Table(caption: "wf test") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`PATH`") }
                    Table.Cell("a directory, or one test file")
                    Table.Cell { Markdown("`.`") }
                    Table.Cell("The project, or one file of its tests.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--update`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Rewrites every snapshot with the current render.")
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf test"),
                Line(command: "wf test tests/cart.wf"),
                Line(command: "wf test --update")
            ])

        Markdown("`wf test` runs every test under `tests/` (and in `src/`), or the tests in one file. A test that clicks or types runs in headless Chrome, on a page that links the project's scripts.\n\nSee also: [Testing](/docs/guide/testing).")

        Heading("wf verify", id: "wf-verify").h3

        Markdown("Loads every page of a built project in a real browser and reports what went wrong there.\n\n**Usage:** `wf verify [OPTIONS] [PATH]`")

        Table(caption: "wf verify") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`PATH`") }
                    Table.Cell("a directory")
                    Table.Cell { Markdown("`.`") }
                    Table.Cell("The project whose build to load.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--json`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("The same report, as JSON for a pipeline.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--budget`") }
                    Table.Cell("milliseconds")
                    Table.Cell("none")
                    Table.Cell("Fails a route whose first paint is slower than this.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--returning-visitor`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Visits every route again as a returning reader (below).")
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf build && wf verify")
            ])

        Markdown("`wf build` reports what the compiler wrote; `wf verify` reports what a browser does with it. It builds nothing: it starts a headless Chrome, serves what `wf build` wrote, and opens every route the project has — a `:param` route at each value its `paths:` names, or at a placeholder (`/user/1`) when it names none.\n\nA route fails on any of these:\n\n- an uncaught exception or a `console.error`;\n- a file that did not arrive (a `fetch` the build has no file for is a `404`, not the page shell);\n- an image that failed to load;\n- a router that drew nothing into `<main>`;\n- a page that rendered no text.\n\nThe report prints one line per route:")

        CodeBlock(#"  16 route(s) in http://127.0.0.1:39785
    ok   /                                    236ms     613 nodes    447.0 kB   11 req
    ok   /app/deployments                      68ms     657 nodes    360.6 kB   10 req

  16 page(s), 0 problem(s)"#, title: "text")

        Markdown("The columns are the first contentful paint, the number of elements in the document once it settled, the bytes the page fetched, and the requests it made. `--budget 400` fails a route that takes longer than 400 ms to paint.\n\n`--returning-visitor` visits every route a second time as a reader who was here before. Their storage holds what the previous build's pages kept: each `persist` value's starting value as the build before this one wrote it, which a build saves in `.wf-cache/` when it changes. A persisted shape that changed without a `version:` then shows as the broken page it would be.\n\nThe report also names **the built-ins no page drew**. A component can be in the registry, the tests and the documentation and still be broken on a page. The classes the pages carried list what actually ran, so the difference is what nothing has exercised. One project is not expected to draw them all: the list is a fact about coverage, not a failure.\n\n`wf verify` needs Chrome or Chromium on the machine, or `WF_CHROME` pointing at one, and says so when there is none.\n\nSee also: [Testing](/docs/guide/testing).")

        Heading("wf audit", id: "wf-audit").h3

        Markdown("Prints what a security review asks about the project. It reports and never fails.\n\n**Usage:** `wf audit [OPTIONS] [PATH]`")

        Table(caption: "wf audit") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`PATH`") }
                    Table.Cell("a directory")
                    Table.Cell { Markdown("`.`") }
                    Table.Cell("The project to audit.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--json`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("The same report, as JSON.")
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf audit"),
                Line(command: "wf audit --json")
            ])

        Markdown("The report lists:\n\n- every `Unsafe.*` and whether its input is sanitised;\n- the project's own scripts and what each declares;\n- every other origin the pages load from;\n- everything kept on the reader's machine;\n- every `env` name and whether it is public;\n- the policy the build ships;\n- what the compiler depends on.\n\nSee also: [Security](/docs/guide/security#audit-the-project).")

        Heading("Formatting", id: "formatting").h2

        Heading("wf fmt", id: "wf-fmt").h3

        Markdown("Formats every `.wf` and `.wfx` file under a path, or one file, in place.\n\n**Usage:** `wf fmt [OPTIONS] [PATH]`")

        Table(caption: "wf fmt") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`PATH`") }
                    Table.Cell("a directory, or one file")
                    Table.Cell { Markdown("`.`") }
                    Table.Cell("What to format.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--check`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Writes nothing, and fails when a file would change. Use it in CI.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--stdout`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Prints the formatted text instead of writing it.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--to`") }
                    Table.Cell { Markdown("`wfx`, `wf`") }
                    Table.Cell("none")
                    Table.Cell("Changes the layout instead of formatting (below).")
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf fmt"),
                Line(command: "wf fmt --check"),
                Line(command: "wf fmt src/pages/Home.wf --stdout"),
                Line(command: "wf fmt --to wfx")
            ])

        Markdown("The formatter applies these rules:\n\n- four spaces for each level, and a line that closes a block one level out;\n- trailing spaces removed, and tabs turned into spaces;\n- runs of blank lines folded to one;\n- a brace one space from what it opens (`Row\{` → `Row \{`, `\}else` → `\} else`).\n\nA line carried on by a trailing comma stays as written, and comments stay where they are. The result is checked against the file's own tokens, so formatting never changes what a file says.\n\n`--to wfx` rewrites the project's `.wf` files in the indented layout, and `--to wf` goes the other way. It changes the layout and nothing else, and refuses a file whose indentation does not already follow its braces.\n\nSee also: [Two layouts: `.wf` and `.wfx`](/docs/guide/language-basics#two-layouts-wf-and-wfx).")

        Heading("Rendering", id: "rendering").h2

        Heading("wf render", id: "wf-render").h3

        Markdown("Renders one template with JSON data, to HTML, a PDF or a slide deck.\n\n**Usage:** `wf render [OPTIONS] TEMPLATE`")

        Table(caption: "wf render") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`TEMPLATE`") }
                    Table.Cell { Markdown("a `.wf` or `.wfx` file, or a directory") }
                    Table.Cell("required")
                    Table.Cell("The template. A directory is every template under it as one, with components shared.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--data`") }
                    Table.Cell("a JSON file")
                    Table.Cell("standard input")
                    Table.Cell("The data the template reads.")
                }
                Table.Row {
                    Table.Cell { Markdown("`-f`, `--format`") }
                    Table.Cell { Markdown("`html`, `html-fragment`, `pdf`, `slides`") }
                    Table.Cell { Markdown("`html`") }
                    Table.Cell("A whole HTML document, the body only, a PDF, or a slide deck.")
                }
                Table.Row {
                    Table.Cell { Markdown("`-o`, `--output`") }
                    Table.Cell("a file")
                    Table.Cell("standard output")
                    Table.Cell("Where to write the result.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--page`") }
                    Table.Cell("a page name")
                    Table.Cell("none")
                    Table.Cell("The page to render, when the template has several.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--theme`") }
                    Table.Cell("a theme name")
                    Table.Cell("none")
                    Table.Cell { Markdown("Which of several `theme` declarations to use.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`--token`") }
                    Table.Cell { Markdown("`NAME=VALUE`") }
                    Table.Cell("none")
                    Table.Cell { Markdown("A design token over the theme's, such as `color-primary=#8B5CF6`. Repeat it for more tokens.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`--lang`") }
                    Table.Cell("a language tag")
                    Table.Cell { Markdown("`en`") }
                    Table.Cell { Markdown("The document's `<html lang>`.") }
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf render invoice.wf --data invoice.json -f pdf -o invoice.pdf"),
                Line(command: "echo '\{\"name\":\"Ada\"\}' | wf render greeting.wf"),
                Line(command: "wf render templates/ --page Receipt --lang ar --data receipt.json")
            ])

        Markdown("A template is held to the same checks as a build: a component nothing declares, or a flag a component does not take, stops the render. The one difference is that the names a template reads come from its data.\n\nSee also: [Server rendering](/docs/guide/server-rendering).")

        Heading("Upgrading", id: "upgrading").h2

        Heading("wf migrate", id: "wf-migrate").h3

        Markdown("Carries a project written for an older WebFluent forward.\n\n**Usage:** `wf migrate [OPTIONS] [PATH]`")

        Table(caption: "wf migrate") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`PATH`") }
                    Table.Cell { Markdown("a directory, or one `.wf` file") }
                    Table.Cell { Markdown("`.`") }
                    Table.Cell("What to migrate.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--check`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Writes nothing, and reports what would change.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--stdout`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Prints the migrated text of one file instead of writing it.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--wfx`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell { Markdown("Writes the migrated files in the indented layout, as `.wfx`.") }
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf migrate --check"),
                Line(command: "wf migrate"),
                Line(command: "wf migrate --wfx")
            ])

        Markdown("`wf migrate` makes three passes, in this order:\n\n1. **4.1 → 4.2**, first, because 4.2 refuses `external`. A remote module becomes a `meta.scripts` entry. A local one becomes a plain script under `src/`, with its signatures as JSDoc, and `X.f(…)` becomes `f(…)`. An `external element` call becomes `Element(\"tag\", …)`. The pass lists every `.js` already under `src/`, since each now ships on every page.\n2. **2 → 3** rewrites every `.wf` under `src/` in place, with a note for anything that needed a decision. It changes spelling only: the migrated project builds to what it built before.\n3. **3 → 4** changes what the compiler allows, so it runs over the project rather than the files. It adds every `env` name your pages already read to `public_env`, which preserves what the project did, and prints the list, because *public* means anyone who opens the site may read the value. It then names, with file and line, everything 4 refuses that 3 allowed: an `on*` attribute, a `javascript:` or `data:` URL. Those have no automatic rewrite, because the old value was a string of JavaScript or a link that ran one. Finally it lists the changes that need no edit: a store is built on first read rather than at boot, a `persist` value follows the site's other tabs, and `WF.store`/`WF.host` were renamed.\n\nSee also: [Upgrading](/docs/guide/upgrading).")

        Heading("Describing the project", id: "describing-the-project").h2

        Markdown("These commands print what the project and the compiler hold. Each one is also a function in the `webfluent` crate, named in its entry and in [Building a tool on the compiler](#building-a-tool-on-the-compiler).")

        Heading("wf commands", id: "wf-commands").h3

        Markdown("Describes every `wf` command as data.\n\n**Usage:** `wf commands [--json]`")

        Table(caption: "wf commands") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`--json`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Prints JSON, for a tool.")
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf commands"),
                Line(command: "wf commands --json")
            ])

        Markdown("For each command it gives what the command does, each option — its flag, what it takes (`nothing` for a flag, a `word` from the values it lists, a `number`, a `path`, `text`) and its default — what the command writes, and the flag that shows it first and writes nothing (`fmt --check`, `migrate --check`, `fix --dry-run`). Build a tool page, a command palette or a script from this output instead of from a copy of this chapter. The library has the same as `webfluent::commands`.")

        Heading("wf assets", id: "wf-assets").h3

        Markdown("Lists every file of `public/` and where the project uses it, or what the image pipeline makes of one picture.\n\n**Usage:** `wf assets [OPTIONS]`")

        Table(caption: "wf assets") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`-d`, `--dir`") }
                    Table.Cell("a directory")
                    Table.Cell { Markdown("`.`") }
                    Table.Cell("The project.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--unused`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Lists only the files nothing names.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--plan`") }
                    Table.Cell { Markdown("a path in `public/`, such as `/hero.png`") }
                    Table.Cell("none")
                    Table.Cell("Shows what the image pipeline writes for that picture.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--json`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Prints JSON, for a tool.")
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf assets"),
                Line(command: "wf assets --unused"),
                Line(command: "wf assets --plan /hero.png"),
                Line(command: "wf assets --json")
            ])

        Markdown("For each file it prints its kind (image, font, video, audio, document, code, data), its size, a picture's dimensions, and every place the project names it: a prop the registry types as a file (`Image`'s `src`, `Video`'s `poster` and `captions`), a page's `image:`, a `const`, an `image` declaration, a `data` file's strings, a value in `webfluent.app.json`, a stylesheet's `url(…)`, a project script, or a manifest. A file a browser or a host asks for by name — `favicon.ico`, `robots.txt`, `.well-known/…` — counts as used. Anything else nothing names counts as unused.\n\n`--plan PATH` applies the project's `build.media` to one picture: each width it writes, in each format, with the file's name and size — for example *3 widths × 1 format · 3 files · about 84 kB*. A size is exact once `wf build` has written the file (it is read from `.wf-cache/media/`), or when the picture is small enough to encode on the spot. Otherwise it is estimated from strips of the picture encoded at that width, and says `about`. The plan names a format the build cannot write, with the reason, and a width it skips because the file would be no smaller than the original. With `--json`, the same sentences are in the `said` field.\n\nThe library has the same as `webfluent::assets::\{list, plan\}`. It reads through a `Vfs`, so an editor's unsaved buffers count.\n\nSee also: [Media](/docs/guide/media).")

        Heading("wf theme", id: "wf-theme").h3

        Markdown("Shows the theme the build uses, as an editor's theme panel shows it.\n\n**Usage:** `wf theme [OPTIONS]`")

        Table(caption: "wf theme") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`-d`, `--dir`") }
                    Table.Cell("a directory")
                    Table.Cell { Markdown("`.`") }
                    Table.Cell("The project.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--json`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Prints JSON, for a tool.")
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf theme"),
                Line(command: "wf theme --json")
            ])

        Markdown("It lists every token by group (colour, spacing, font size, line height, radius, shadow, transition, font, motion, and the tokens the theme adds) with its value, the baseline's value, whether the theme declares or inherits it, the dark theme's value when `theme.dark` names one, the properties that draw from it, and every place the project names it. It then lists the colour pairings the stylesheet composes, with their contrast and what WCAG AA asks of each — a pairing that falls short is the `A13` the build reports — and the tokens one theme of the dark pair declares and the other does not.\n\nSee also: [Design tokens](/docs/guide/tokens).")

        Heading("wf motion", id: "wf-motion").h3

        Markdown("Lists what an element's motion props can name.\n\n**Usage:** `wf motion [OPTIONS]`")

        Table(caption: "wf motion") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`-d`, `--dir`") }
                    Table.Cell("a directory")
                    Table.Cell { Markdown("`.`") }
                    Table.Cell("The project.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--json`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Prints JSON, for a tool.")
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf motion"),
                Line(command: "wf motion --json")
            ])

        Markdown("It lists:\n\n- every animation `animate:` and `exit:` take: the engine's, each with its keyframes, the rule its stylesheet plays it by, whether an element leaves with it and whether it repeats; then the project's own `animation` declarations;\n- the named eases, with the timing function each stands for;\n- the three speeds and their lengths;\n- the `Router`'s transitions;\n- the project's default length and pacing (`motion` in the config, or the engine's);\n- `data-wf-motion=\"reduce\"`, the attribute an editor sets on the page's root to show the page as a reader who asked for less motion sees it.\n\nThe library has it as `webfluent::motion::catalogue`.\n\nSee also: [Motion](/docs/guide/motion).")

        Heading("wf context", id: "wf-context").h3

        Markdown("Prints what a coding agent working on the project is given, so nothing it is told is hidden from you.\n\n**Usage:** `wf context [OPTIONS]`")

        Table(caption: "wf context") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`-d`, `--dir`") }
                    Table.Cell("a directory")
                    Table.Cell { Markdown("`.`") }
                    Table.Cell("The project.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--open`") }
                    Table.Cell { Markdown("`FILE` or `FILE:START-END`") }
                    Table.Cell("none")
                    Table.Cell { Markdown("The file open in the editor, and its selection as byte offsets: `src/pages/Home.wf:120-180`.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`--guide`") }
                    Table.Cell { Markdown("`index`, `full`") }
                    Table.Cell { Markdown("`index`") }
                    Table.Cell("The guide as each chapter's sections, or every chapter whole.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--json`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Prints JSON; otherwise one Markdown document.")
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf context"),
                Line(command: "wf context --open src/pages/Home.wf:120-180"),
                Line(command: "wf context --guide full --json")
            ])

        Markdown("It includes:\n\n- every file of the project — not the build's output, `.git/`, dependencies or a `.env` file;\n- the open file and its selection;\n- the problems the build reports;\n- every component a call can name, with its props, cases, events and slots;\n- the theme's tokens;\n- `webfluent.app.json`, with every `env` value that `public_env` does not list withheld;\n- the guide: each chapter's title, blurb and sections to cite (`16 Forms and validation › What a value must be: validate`), or with `--guide full` the chapters whole;\n- what was withheld, and why.\n\nThe library has it as `webfluent::agent::context`. An agent's edits go through `webfluent::agent::changeset::ChangeSet`: a layer over the editor's buffers that the compiler builds before anyone reads it. It refuses paths outside the project, in `.git/`, in the build's output and `.env` files; reads the config with its private values withheld and keeps them through a write; and is accepted whole, by file or by hunk.")

        Heading("wf translations", id: "wf-translations").h3

        Markdown("Shows the project's translations as a table.\n\n**Usage:** `wf translations [OPTIONS]`")

        Table(caption: "wf translations") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`-d`, `--dir`") }
                    Table.Cell("a directory")
                    Table.Cell { Markdown("`.`") }
                    Table.Cell("The project.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--missing`") }
                    Table.Cell("a locale")
                    Table.Cell("none")
                    Table.Cell("Lists only the keys that locale has no message for.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--unused`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Lists only the keys nothing names.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--plurals`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Prints CLDR's plural rules instead.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--json`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Prints JSON, for a tool.")
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf translations"),
                Line(command: "wf translations --missing ar"),
                Line(command: "wf translations --unused"),
                Line(command: "wf translations --json"),
                Line(command: "wf translations --plurals")
            ])

        Markdown("For each locale it prints its file, whether it is the default and whether it is right to left, the plural forms CLDR's rules give it, how many keys have no message in it, how many lack a form it needs, and how many messages have placeholders the default locale's do not.\n\nA key is unused when nothing names it: no `t()`, no key built at run time that may be it, and no `validate` rule that shows it.\n\n`--json` prints the whole table: every key, plural keys with each form, each message in each locale with its placeholders and line, every place a `t()` names the key, and the calls that name a key no locale has (`I01`).\n\n`--plurals` prints each locale's forms; with `--json`, also the form each of a run of counts takes.\n\nThe library has it as `webfluent::i18n::table`, whose `set_message` writes one message back and keeps every other byte of the file.\n\nSee also: [Internationalisation](/docs/guide/i18n).")

        Heading("wf scope", id: "wf-scope").h3

        Markdown("Lists the names that can be read at one place in a source file — what an editor's path picker and completion offer there.\n\n**Usage:** `wf scope [OPTIONS] PLACE`")

        Table(caption: "wf scope") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`PLACE`") }
                    Table.Cell { Markdown("`FILE:LINE` or `FILE:LINE:COL`") }
                    Table.Cell("required")
                    Table.Cell { Markdown("The place: `src/pages/Signup.wf:24` or `src/pages/Signup.wf:24:9`.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`-d`, `--dir`") }
                    Table.Cell("a directory")
                    Table.Cell { Markdown("`.`") }
                    Table.Cell("The project.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--data`") }
                    Table.Cell("a JSON file")
                    Table.Cell("none")
                    Table.Cell("A template's data, listed after the scope.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--json`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Prints JSON, for a tool.")
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf scope src/pages/Deploys.wf:24"),
                Line(command: "wf scope src/pages/Deploys.wf:24:9 --json"),
                Line(command: "wf scope src/templates/invoice.wf:3 --data data/invoice.json")
            ])

        Markdown("The names come in the order a path picker lists them:\n\n1. the page's or component's own `state` and `derived` values, and the form it binds;\n2. its props, and a page's route parameters;\n3. what the statements around the place bind — a loop's item and index, an `if let`, a `match` arm, a slot's fill, an action's parameters and the `let`s before the place — innermost first;\n4. the members of every store it `use`s;\n5. with `--data`, the template's data.\n\nEach row has its type as the checker infers it, its shape (`bool`, `number`, `text`, `moment`, `list`, `record`, `enum` …), whether it may be `null`, where it comes from (`for d in live`, `member of Deploys`), and a record's fields to go on into (`d.region.code`). The library has it as `webfluent::scope`.")

        Heading("wf rules", id: "wf-rules").h3

        Markdown("Lists what a `validate` block can hold, and every state the project holds to a rule.\n\n**Usage:** `wf rules [OPTIONS]`")

        Table(caption: "wf rules") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`-d`, `--dir`") }
                    Table.Cell("a directory")
                    Table.Cell { Markdown("`.`") }
                    Table.Cell("The project.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--json`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Prints JSON, for a tool.")
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf rules"),
                Line(command: "wf rules --json")
            ])

        Markdown("It lists:\n\n- every rule: what it takes between its parentheses, when it holds, the message it shows when none is written, the translation key (`form.minLength`) that replaces that message in a translated project, whether an empty value passes it, and whether it is checked last;\n- the bounds a refined type implies (`below`, `after`, `before`);\n- the patterns people often write, by name, each with its expression and a message;\n- `Form(show:)`'s cases, in the reader's terms;\n- `data-wf-validation=\"shown\"`, the attribute a preview sets on the page's root to show every message at once;\n- every state the project holds to a rule, with its rules in order (those its type implies first) and whether the page checks them as the reader types.\n\nThe library has it as `webfluent::validation`.\n\nSee also: [Forms](/docs/guide/forms).")

        Heading("wf components", id: "wf-components").h3

        Markdown("Lists every component a call can name — the built-ins first, then the project's own — in one vocabulary.\n\n**Usage:** `wf components [OPTIONS]`")

        Table(caption: "wf components") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`-d`, `--dir`") }
                    Table.Cell("a directory")
                    Table.Cell { Markdown("`.`") }
                    Table.Cell("The project.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--json`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Prints JSON, for a tool.")
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf components"),
                Line(command: "wf components --json")
            ])

        Markdown("For each prop it gives the kind of value it takes (`text`, `number`, `enum` and its cases, `file` and what kind, `state`, `path`, a declared `record`, a `list`, `date`, `color`, `money` …), whether it is the positional one, its default as written, a range where its type declares one (`Number(0..=100)`), and whether `.name` alone sets it. Then it gives the component's events, its slots and what each hands its fill, its parts and their owner, the attribute families its root takes, and whether it takes children.\n\nThis is the table the checker reads a call against. An inspector draws a control per prop from it, and an Insert panel knows what may go where. The library has it as `webfluent::registry::schema::of_project_via`.")

        Heading("wf docs", id: "wf-docs").h3

        Markdown("Writes a self-contained component gallery.\n\n**Usage:** `wf docs [OPTIONS]`")

        Table(caption: "wf docs") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`-d`, `--dir`") }
                    Table.Cell("a directory")
                    Table.Cell { Markdown("`.`") }
                    Table.Cell("The project.")
                }
                Table.Row {
                    Table.Cell { Markdown("`-o`, `--out`") }
                    Table.Cell("a directory")
                    Table.Cell { Markdown("`docs`") }
                    Table.Cell { Markdown("Where to write `index.html`.") }
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf docs"),
                Line(command: "wf docs -o gallery")
            ])

        Markdown("The gallery shows every built-in — props, cases, flags, events, slots, parts — and every component, enum, type, store and page the project declares, with their `///` documentation.")

        Heading("wf registry", id: "wf-registry").h3

        Markdown("Describes every built-in component: props, cases, flags, events, slots and parts.\n\n**Usage:** `wf registry [--json]`")

        Table(caption: "wf registry") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`--json`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Prints JSON, for a tool.")
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf registry --json | jq '.components[] | select(.name == \"Button\") | .props[].name'")
            ])

        Markdown("The registry is the compiler's own table: what it prints is exactly what the checker accepts.\n\nSee also: [Built-in components](/docs/reference).")

        Heading("wf types", id: "wf-types").h3

        Markdown("Describes what a project declares: enums, types, components, stores and pages.\n\n**Usage:** `wf types [OPTIONS] [PATH]`")

        Table(caption: "wf types") {
            Table.Head {
                Table.Row {
                    Table.Cell("Option").header
                    Table.Cell("Value").header
                    Table.Cell("Default").header
                    Table.Cell("Meaning").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`PATH`") }
                    Table.Cell("a directory")
                    Table.Cell { Markdown("`.`") }
                    Table.Cell("The project.")
                }
                Table.Row {
                    Table.Cell { Markdown("`--json`") }
                    Table.Cell("—")
                    Table.Cell("off")
                    Table.Cell("Prints JSON, for a tool.")
                }
            }
        }

        Terminal(lines: [
                Line(command: "wf types"),
                Line(command: "wf types --json")
            ])

        Markdown("It includes the names the project's scripts under `src/` declare, each with the parameters and return type its JSDoc gives it.")

        Heading("Environment variables", id: "environment-variables").h2

        Table(caption: "Environment variables") {
            Table.Head {
                Table.Row {
                    Table.Cell("Variable").header
                    Table.Cell("Read by").header
                    Table.Cell("What it does").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`WF_INSTALL_DIR`") }
                    Table.Cell { Markdown("`install.sh`, `install.ps1`") }
                    Table.Cell { Markdown("Where the binary is installed (default `~/.webfluent/bin`).") }
                }
                Table.Row {
                    Table.Cell { Markdown("`WF_VERSION`") }
                    Table.Cell { Markdown("`install.sh`, `install.ps1`") }
                    Table.Cell { Markdown("The release to install, such as `v5.11.0`, instead of the latest.") }
                }
                Table.Row {
                    Table.Cell { Markdown("`WF_CHROME`") }
                    Table.Cell { Markdown("`wf test`, `wf verify`") }
                    Table.Cell("The Chrome or Chromium to drive, when it is not found on its own.")
                }
                Table.Row {
                    Table.Cell { Markdown("`WF_BIN`") }
                    Table.Cell("the Node binding")
                    Table.Cell { Markdown("The `wf` binary to call.") }
                }
                Table.Row {
                    Table.Cell { Markdown("any `PUBLIC_…` name") }
                    Table.Cell { Markdown("`wf build`") }
                    Table.Cell { Markdown("A value for `env.NAME` ([Environments](/docs/guide/environments)).") }
                }
            }
        }

        Heading("Editors", id: "editors").h2

        Markdown("`wf-lsp` is the language server: it runs the compiler's checks as you type and answers your editor's questions about the code.")

        Heading("wf-lsp", id: "wf-lsp").h3

        Markdown("To install it, download the binary from a [release](https://github.com/monzeromer-lab/WebFluent/releases) (`wf-lsp-<version>-<arch>-<os>.tar.gz`) and put it on your `PATH`, or build it from a clone with `cargo install --path crates/wf-lsp`. Keep it at the version of your `wf`; `wf-lsp --version` prints its version.\n\nIt provides:\n\n- **Diagnostics as you type** — every check `wf build` runs, for `.wf`, `.wfx` and Markdown pages, rerun whenever a file they depend on changes (a translation, a `.env`, a script, a `public/` asset).\n- **Output awareness.** In a project whose `build.output_type` is `pdf` or `slides`, completion offers only what paper can draw — no `Button`, no `on click`, no `resource`. Inside a `Presentation` it offers slides (and the project's slide components), and inside a slide everything else. Hover says when an element is not drawn in this output, and why. `page` and `pages` are names inside a `Header`, `Footer` or `Background`. In a web project the paper-only elements are offered last.\n- **Completion**, from the compiler's own tables: components and their props after `(`, flags and parts after `.`, enum cases after `:`, events after `on `, `$` tokens, `match` arms and slot names; the fields of a record and the methods of each built-in type (`due.` offers `plus`, `isBefore`, …); a service's endpoints; the keywords each place allows (a store's, an action's, a test's steps); type names after `:`; duration units after a number; `validate` rules, `persist` settings, `format` styles, responsive steps, `Host` tags, key names in `on key(\"…\")`, translation keys in `t(\"…\")`, public `env.` names, and lint codes in `// wf-allow(`.\n- **Hover** — what every name is: a component's documentation and signature, the props every element takes, a name's inferred type, a field or an endpoint, a case, a keyword, a function the language provides, an `image`'s size.\n- **Signature help** inside a call: what it takes and which argument the cursor is on — for an element, a component, an endpoint, an action, a project script's function or a built-in one.\n- **Navigation** — go to definition, find references, highlight the uses in a file, and rename across the project, for every declaration (a type, an enum, a case, a field, a `const`, a `data` file, an animation, an endpoint) and inside a string's `\{…\}` splices.\n- **Formatting** — `wf fmt`, on the open file.\n- **Folding, inlay hints and semantic highlighting** — an inlay hint shows the type of a `state` or `derived` value written without one, and a name is coloured by what it resolves to: a component, a type, a store, a prop or a state.\n- **Document symbols** and the outline.\n- **Quick fixes**, from the compiler's own findings: the nearest name for a misspelt field, member, method, variable, component or flag; `?.` for a value that may be null; the props a call leaves out; the arms a `match` misses; a bare word written as its flag; `alt: \"\"` for an image; an `_` before a name nothing reads. **Extract component** turns a selection into a component.")

        Heading("Zed", id: "zed").h3

        Markdown("The extension is in `editors/zed`. It is not in Zed's extension registry yet, so install it with `zed: install dev extension`, pointing at that folder. It provides Tree-sitter highlighting, the outline, brackets, indentation, snippets and the language server (found on `PATH`, or downloaded from the latest release), for `.wf` and `.wfx`.")

        Heading("VS Code", id: "vs-code").h3

        Markdown("The extension is in `editors/vscode`: TextMate highlighting and the language server. Until it is on the Marketplace, run `npm ci && npm run package` in that folder, then install the `.vsix` with **Extensions: Install from VSIX**.")

        Heading("Neovim", id: "neovim").h3

        Markdown("Neovim 0.11 or later configures the server with `vim.lsp.config`:")

        CodeBlock(#"vim.filetype.add({ extension = { wf = "webfluent", wfx = "webfluent" } })
vim.lsp.config("wf_lsp", {
  cmd = { "wf-lsp" },
  filetypes = { "webfluent" },
  root_markers = { "webfluent.app.json" },
})
vim.lsp.enable("wf_lsp")"#, title: "lua")

        Heading("Helix", id: "helix").h3

        Markdown("Add the language and its server to `languages.toml`:")

        CodeBlock("[[language]]\nname = \"webfluent\"\nscope = \"source.webfluent\"\nfile-types = [\"wf\", \"wfx\"]\nroots = [\"webfluent.app.json\"]\ncomment-token = \"//\"\nindent = \{ tab-width = 4, unit = \"    \" \}\nlanguage-servers = [\"wf-lsp\"]\n\n[language-server.wf-lsp]\ncommand = \"wf-lsp\"", title: "toml")

        Heading("Emacs", id: "emacs").h3

        Markdown("With Eglot, define a mode and register the server:")

        CodeBlock(#"(define-derived-mode webfluent-mode prog-mode "WebFluent")
(add-to-list 'auto-mode-alist '("\\.wfx?\\'" . webfluent-mode))
(with-eval-after-load 'eglot
  (add-to-list 'eglot-server-programs '(webfluent-mode . ("wf-lsp"))))"#, title: "elisp")

        Heading("Other editors", id: "other-editors").h3

        Markdown("Any editor with LSP support can run `wf-lsp` over standard input and output; the project root is the folder that holds `webfluent.app.json`. For highlighting in an editor that reads Tree-sitter, use the grammars in `editors/tree-sitter-webfluent` (braces) and `editors/tree-sitter-webfluentx` (indentation).")

        Heading("Building a tool on the compiler", id: "building-a-tool-on-the-compiler").h2

        Markdown("Every command above is a function in the `webfluent` crate, so an editor, a site builder or an agent can call it in process instead of running `wf`. Each one reads the project through a `webfluent::vfs::Vfs`: `FsVfs` reads the disk, and `OverlayVfs::over_disk()` lays the editor's unsaved buffers over it, so a tool reports the project as it is being edited.")

        Table(caption: "Building a tool on the compiler") {
            Table.Head {
                Table.Row {
                    Table.Cell("Function").header
                    Table.Cell("What it is").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`build::\{build, check\}` with `BuildOptions`") }
                    Table.Cell { Markdown("`wf build` and `wf check`, returning every line and every finding as a `Diagnostic` with its fixes; `BuildOptions::studio` is `--studio`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`diagnostics::fixes::fix_all`") }
                    Table.Cell { Markdown("`wf fix`'s fix-all, for one family in one file") }
                }
                Table.Row {
                    Table.Cell { Markdown("`print`, `reprint`, `edit::\{rewrite_element, rewrite_statement, rewrite_body, rewrite_declaration, rewrite_program\}`") }
                    Table.Cell("An element, a statement or a declaration changed in the tree and written back as the smallest edit, every other byte as it was; refused when it would not read back the same")
                }
                Table.Row {
                    Table.Cell { Markdown("`codegen::node_id::\{build_node_map_with, layers\}`") }
                    Table.Cell("Every element's id, file, place, parent and what it is inside; the node at a caret; the Layers tree")
                }
                Table.Row {
                    Table.Cell { Markdown("`registry::schema::of_project_via`") }
                    Table.Cell { Markdown("`wf components`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`style_value`") }
                    Table.Cell { Markdown("Each style property's shape, a value read into parts (`read_box`), and the narrowest declaration written back (`edit_box`)") }
                }
                Table.Row {
                    Table.Cell { Markdown("`themes::view::\{view_via, set_token, reset_token\}`") }
                    Table.Cell { Markdown("`wf theme`, and one token written in its place") }
                }
                Table.Row {
                    Table.Cell { Markdown("`motion::catalogue`") }
                    Table.Cell { Markdown("`wf motion`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`validation::\{must_be_via, set_rule, remove_rule, move_rule\}`") }
                    Table.Cell { Markdown("`wf rules`, and a state's `validate` block written back one rule at a time") }
                }
                Table.Row {
                    Table.Cell { Markdown("`scope::paths::at_via`") }
                    Table.Cell { Markdown("`wf scope`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`i18n::\{plurals, table\}`") }
                    Table.Cell { Markdown("`wf translations`: CLDR's plural rules, the table, and `set_message`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`assets`, `media::plan`") }
                    Table.Cell { Markdown("`wf assets`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`config::\{schema, json_edit\}`") }
                    Table.Cell { Markdown("`wf config`, and a setting written keeping the file's shape") }
                }
                Table.Row {
                    Table.Cell { Markdown("`commands`") }
                    Table.Cell { Markdown("`wf commands`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`agent::\{changeset, context, diff\}`") }
                    Table.Cell { Markdown("`wf context`, and a change set an agent writes to instead of the working tree, built before anyone reads it") }
                }
            }
        }
    }
}
