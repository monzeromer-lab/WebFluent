/// Chapter 53 of the guide, written from md-docs/reference/library.md by
/// scripts/docsite/guide.py; edit the guide, not this file.
page LibraryGuide(path: "/reference/library", title: "Library", description: "The compiler as a library: the webfluent crate (Template, build, memory, vfs, diagnostics, config, errors, semver), the Node package and wf.js.", layout: DocsShell("Library", kind: .reference, chapter: t("nav.group.reference"), blurb: "The compiler as a library: the Rust crate's documented API, the Node package, and wf.js in a browser.", source: "md-docs/reference/library.md", sections: [Anchor(id: "rust-the-webfluent-crate", label: "Rust: the webfluent crate"), Anchor(id: "node-the-webfluent-package", label: "Node: the webfluent package"), Anchor(id: "browser-wf-js", label: "Browser: wf.js")], prevTo: "/docs/guide/contributing", prevLabel: t("ch.52"), nextTo: "/reference/editors", nextLabel: t("ch.54"))) {
    Stack(gap: .lg) {
        Markdown("This page is the reference for the compiler used as a library: the `webfluent` crate in a Rust program, the `webfluent` package in Node, and `wf.js` in a browser. Each one compiles the same language as `wf`, with the same findings.")

        Table(caption: "Library") {
            Table.Head {
                Table.Row {
                    Table.Cell("").header
                    Table.Cell("What it is").header
                    Table.Cell("Use it to").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("[Rust](#rust-the-webfluent-crate)") }
                    Table.Cell { Markdown("the compiler itself, `webfluent` on crates.io") }
                    Table.Cell("render templates in a server, build a site from a program, write an editor or a tool")
                }
                Table.Row {
                    Table.Cell { Markdown("[Node](#node-the-webfluent-package)") }
                    Table.Cell { Markdown("a wrapper that runs `wf render`") }
                    Table.Cell("render templates from a Node server")
                }
                Table.Row {
                    Table.Cell { Markdown("[Browser](#browser-wf-js)") }
                    Table.Cell("the compiler built for WebAssembly")
                    Table.Cell("compile and preview a project in a page, with no server")
                }
            }
        }

        Markdown("This Rust program renders a template to HTML:")

        CodeBlock(##"// Cargo.toml: webfluent = { version = "6", default-features = false }
//             serde_json = "1"
use webfluent::Template;

fn main() -> webfluent::Result<()> {
    let tpl = Template::from_str(
        r#"page Hello(path: "/", title: "Hello") { Heading("Hello, {name}!").h1 }"#,
    )?;
    let html = tpl.render_html(&serde_json::json!({ "name": "Ada" }))?;
    println!("{html}");
    Ok(())
}"##, title: "rust")

        Heading("Rust: the webfluent crate", id: "rust-the-webfluent-crate").h2

        Markdown("The crate is the compiler: `wf`, the language server and the WebAssembly build are all made from it. Item-level documentation — every type, field and method — is on [docs.rs/webfluent](https://docs.rs/webfluent); this section says which parts exist, what each is for, and what semver covers.")

        Heading("Add it", id: "add-it").h3

        CodeBlock(#"[dependencies]
webfluent = { version = "6", default-features = false }"#, title: "toml")

        Markdown("`default-features = false` leaves out the `wf` command's own dependencies (its argument parser and the development server). A program that only renders templates or builds projects needs neither.")

        Table(caption: "Add it") {
            Table.Head {
                Table.Row {
                    Table.Cell("Feature").header
                    Table.Cell("Default").header
                    Table.Cell("What it adds").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`cli`") }
                    Table.Cell("on")
                    Table.Cell { Markdown("the `wf` command's dependencies: `clap`, `tiny_http`, `mimalloc`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`webp`, `pdf`, `bundled-fonts`") }
                    Table.Cell("off")
                    Table.Cell("for a WebAssembly build only: lossy WebP, the PDF engine, the Liberation faces. A native build has all three whatever the features say")
                }
                Table.Row {
                    Table.Cell { Markdown("`internals`") }
                    Table.Cell("off")
                    Table.Cell { Markdown("the compiler's own modules, outside semver (see [What semver covers](#what-semver-covers))") }
                }
            }
        }

        Markdown("The crate's minimum Rust version is the workspace's `rust-version`, and `webfluent::VERSION` is the compiler's version as `wf --version` prints it.")

        Heading("The documented API", id: "the-documented-api").h3

        Table(caption: "The documented API") {
            Table.Head {
                Table.Row {
                    Table.Cell("Module or item").header
                    Table.Cell("What it is for").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("[`Template`](https://docs.rs/webfluent/latest/webfluent/struct.Template.html), `template`") }
                    Table.Cell { Markdown("Render `.wf` templates with JSON data to HTML, an HTML fragment, a PDF or a slide deck") }
                }
                Table.Row {
                    Table.Cell { Markdown("`build`") }
                    Table.Cell { Markdown("`wf build` and `wf check` as function calls") }
                }
                Table.Row {
                    Table.Cell { Markdown("`memory`") }
                    Table.Cell("Build a project held in memory: no disk read, none written")
                }
                Table.Row {
                    Table.Cell { Markdown("`vfs`, `outfs`") }
                    Table.Cell("Where a build reads a project from, and where it writes")
                }
                Table.Row {
                    Table.Cell { Markdown("`diagnostics`, [`Diagnostic`](https://docs.rs/webfluent/latest/webfluent/diagnostics/struct.Diagnostic.html)") }
                    Table.Cell("Findings, their codes, and the JSON, SARIF and GitHub formats")
                }
                Table.Row {
                    Table.Cell { Markdown("`config`") }
                    Table.Cell { Markdown("`webfluent.app.json`, loaded and typed") }
                }
                Table.Row {
                    Table.Cell { Markdown("`syntax`, `parse_source`") }
                    Table.Cell { Markdown("The parser, the tree (`syntax::parser::ast`), the formatter (`syntax::fmt`) and the `.wfx` layout (`syntax::layout`)") }
                }
                Table.Row {
                    Table.Cell { Markdown("`init`") }
                    Table.Cell { Markdown("`wf init`: a new project from a starter") }
                }
                Table.Row {
                    Table.Cell { Markdown("`studio`, `compile_studio`") }
                    Table.Cell("The compile an editor's live preview runs")
                }
                Table.Row {
                    Table.Cell { Markdown("[`WebFluentError`](https://docs.rs/webfluent/latest/webfluent/enum.WebFluentError.html), `Result`") }
                    Table.Cell("The error every fallible call returns")
                }
            }
        }

        Heading("Templates", id: "templates").h3

        Markdown("`Template` parses and checks once, is `Send + Sync`, and is cheap to clone, so a server loads its templates at start-up and renders from any thread. Data is any `serde::Serialize` value. This program renders one page of a directory of templates to PDF:")

        CodeBlock(#"use serde::Serialize;
use webfluent::Template;

#[derive(Serialize)]
struct Receipt {
    number: u32,
    total: f64,
}

fn main() -> webfluent::Result<()> {
    let templates = Template::from_dir("templates")?;
    let pdf = templates
        .page("Receipt")?
        .with_lang("en")
        .render_pdf(&Receipt { number: 7, total: 12.5 })?;
    std::fs::write("receipt.pdf", pdf)?;
    Ok(())
}"#, title: "rust")

        Table(caption: "Templates") {
            Table.Head {
                Table.Row {
                    Table.Cell("Load").header
                    Table.Cell("Configure").header
                    Table.Cell("Render").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`from_str`, `from_file`, `from_files`, `from_dir`, `from_sources`") }
                    Table.Cell { Markdown("`page`, `with_theme`, `with_tokens`, `with_lang`, `with_pdf`, `with_slides`") }
                    Table.Cell { Markdown("`render_html`, `render_html_fragment`, `render_html_parts` (CSS and body apart), `render_pdf`, `render_slides`, and `render_pdf_report` with the engine's notes") }
                }
            }
        }

        Markdown("A template is the static part of the language. [Server rendering](/recipes) shows what one may use, and how to render from a web server.")

        Heading("Builds", id: "builds").h3

        Markdown("`build::build` is `wf build`, and `build::check` is `wf check`. Both read the project through a `Vfs` and return a `BuildReport`: every line the command prints, every finding as a `Diagnostic`, every page's route, and where the site was written. A build that stops returns a `BuildFailure` holding the report so far and the error:")

        CodeBlock(#"use std::path::Path;
use webfluent::build::{BuildOptions, build};
use webfluent::vfs::FsVfs;

fn main() {
    let options = BuildOptions {
        deny_warnings: true,
        ..BuildOptions::new(Path::new("my-site"), &FsVfs)
    };
    match build(&options) {
        Ok(report) => println!("{} pages in {}", report.pages, report.output_dir.display()),
        Err(failure) => {
            for d in failure.report.errors() {
                eprintln!("{}:{}:{}: {} [{}]", d.file, d.line, d.column, d.message, d.code);
            }
            eprintln!("{}", failure.error);
            std::process::exit(1);
        }
    }
}"#, title: "rust")

        Markdown("Each field of `BuildOptions` is one of `wf build`'s flags: `output_dir`, `allow_output_outside`, `stats`, `format`, `deny_warnings`, `dev` (a `wf serve` build), `cache` (`--cache`), `studio` (`--studio`) and `on_line`, a callback for each line as the build prints it.")

        Heading("Read a project through a Vfs", id: "read-a-project-through-a-vfs").h3

        Markdown("Everything that reads a project reads it through `vfs::Vfs`:\n\n- `FsVfs` is the disk, and what every command uses.\n- `OverlayVfs::over_disk()` is the disk with an editor's unsaved buffers over it. `set` lays text over a path, `set_bytes` a picture or a font, and `delete` hides a file as though it were gone.\n\nThis function checks a project as an editor holds it, before the file is saved:")

        CodeBlock(#"use std::path::Path;
use webfluent::build::{BuildOptions, check};
use webfluent::vfs::OverlayVfs;

fn findings_while_editing(dir: &Path, unsaved: &str) -> usize {
    let mut vfs = OverlayVfs::over_disk();
    vfs.set(dir.join("src/pages/Home.wf"), unsaved);
    match check(&BuildOptions::new(dir, &vfs)) {
        Ok(report) => report.diagnostics.len(),
        Err(failure) => failure.report.diagnostics.len(),
    }
}

fn main() {
    let n = findings_while_editing(Path::new("my-site"), "page Home(path: \"/\") { }");
    println!("{n} findings");
}"#, title: "rust")

        Markdown("What a build writes goes to `outfs`: the disk, or memory inside `outfs::capture`. An overlay changes what the project says, not where its output lands.")

        Heading("Build from memory", id: "build-from-memory").h3

        Markdown("`memory::compile_files` builds a project given as a map of path to contents and returns what it wrote as a map, with every finding. It reads no disk and writes none, which is how the browser build works, and it runs natively too:")

        CodeBlock(##"use webfluent::memory::{Contents, Options, compile_files};

fn main() {
    let files = [(
        "src/pages/Home.wf".to_string(),
        Contents::Text(
            r#"page Home(path: "/", title: "Home", description: "The front page.") { Heading("Hello").h1 }"#.into(),
        ),
    )];
    let out = compile_files(files, None, &Options::default());
    for d in &out.diagnostics {
        println!("{} {}", d.code, d.message);
    }
    if out.ok {
        println!("{} bytes of HTML", out.files["index.html"].len());
    }
}"##, title: "rust")

        Markdown("`files` holds text files, and `binary` the pictures and PDFs. `None` as the config uses the one in the map, or a default. `Options \{ check_only: true, .. \}` is `wf check`; `memory::compile` takes text only; `memory::explain` is `wf explain`.")

        Heading("Findings", id: "findings").h3

        Markdown("A `Diagnostic` is one finding: its `code`, `severity`, `message`, `file`, `line` and `column` (1-based, counted in characters), `hint`, the other places it concerns (`related`) and the edits that fix it (`fixes`). It is the same value `wf check --format json` prints, and the language server sends. `diagnostics::format::\{json, sarif, github\}` write a list as those formats; `diagnostics::codes` is the registry of every code, and `docs_url()` its page.")

        Heading("Configuration", id: "configuration").h3

        Markdown("`config::ProjectConfig::load(dir)` reads `webfluent.app.json` with every default filled in, and `load_via(vfs, dir)` reads it through a `Vfs`. Its fields are the file's keys ([Configuration](/reference/config)).")

        Heading("Errors", id: "errors").h3

        Markdown("Every fallible call returns `webfluent::Result<T>`, whose error is `WebFluentError`:")

        Table(caption: "Errors") {
            Table.Head {
                Table.Row {
                    Table.Cell("Case").header
                    Table.Cell("When").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`LexerError`, `ParseError`") }
                    Table.Cell("the source cannot be read; holds the finding")
                }
                Table.Row {
                    Table.Cell { Markdown("`Diagnostics`") }
                    Table.Cell("the checks found errors; holds every finding")
                }
                Table.Row {
                    Table.Cell { Markdown("`ConfigError`") }
                    Table.Cell("the config is missing, is not JSON, or sends the output out of the project")
                }
                Table.Row {
                    Table.Cell { Markdown("`IoError`") }
                    Table.Cell("a file cannot be read or written")
                }
                Table.Row {
                    Table.Cell { Markdown("`NotFound`") }
                    Table.Cell("what was asked for is not there: a file, a page, the text an edit names")
                }
                Table.Row {
                    Table.Cell { Markdown("`CodegenError`, `EditError`") }
                    Table.Cell("code generation failed, or a structured edit cannot apply")
                }
            }
        }

        Markdown("`IoError`, `ConfigError`, `CodegenError`, `EditError` and `NotFound` each hold a message and, where there is one, the error beneath it, which `std::error::Error::source` returns. `WebFluentError::io(message)` and `io_with(message, cause)` make one. The enum is `#[non_exhaustive]`, so a `match` on it needs a `_` arm:")

        CodeBlock(#"use webfluent::{Template, WebFluentError};

fn main() {
    match Template::from_file("templates/missing.wf") {
        Ok(_) => println!("loaded"),
        Err(WebFluentError::IoError(e)) => eprintln!("cannot read it: {}", e.message()),
        Err(WebFluentError::Diagnostics(found)) => eprintln!("{} findings", found.len()),
        Err(other) => eprintln!("{other}"),
    }
}"#, title: "rust")

        Heading("What semver covers", id: "what-semver-covers").h3

        Markdown("The modules and items in [The documented API](#the-documented-api) are covered: a change that breaks them waits for a major version. A minor version may add a case to a `#[non_exhaustive]` enum (`WebFluentError`, the tree's `Declaration`, `Expr` and `StatementKind`, `OutputType`, `memory::Contents`, …), which is why a `match` on one needs a `_` arm.\n\nThe rest of the compiler — the checker, the code generator, the runtime, the PDF engine, the registry and the tools behind the other commands — is the crate's own. The `internals` feature makes it public again for a tool that needs it, hidden from the docs and outside semver: anything there may change in any release. A crate that turns it on pins an exact version:")

        CodeBlock(#"[dependencies]
webfluent = { version = "=6.0.0", default-features = false, features = ["internals"] }"#, title: "toml")

        Heading("Node: the webfluent package", id: "node-the-webfluent-package").h2

        Markdown("The package renders templates from Node.js. It is a wrapper around `wf render`: each render runs `wf` once and sends the data on standard input, so `wf` must be installed too. Its source is [`bindings/node/`](https://github.com/monzeromer-lab/WebFluent/tree/master/bindings/node), and its version is the compiler's it was released with.")

        Terminal(lines: [
                Line(command: "npm install webfluent")
            ])

        Markdown("If npm does not find it, install it from a clone of the repository:")

        Terminal(lines: [
                Line(command: "npm install ./WebFluent/bindings/node")
            ])

        Markdown("This script renders one page of a directory of templates in a request handler, without blocking the event loop:")

        CodeBlock(#"const http = require("node:http");
const { Template } = require("webfluent");

const receipt = Template.fromDir("templates").page("Receipt").withLang("en");

http.createServer(async (req, res) => {
  const html = await receipt.renderHtmlAsync({ number: 7, total: 12.5 });
  res.writeHead(200, { "Content-Type": "text/html; charset=utf-8" });
  res.end(html);
}).listen(8080);"#, title: "js")

        Table(caption: "Node: the webfluent package") {
            Table.Head {
                Table.Row {
                    Table.Cell("Method").header
                    Table.Cell("What it does").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`Template.fromString(source)`, `fromFile(path)`, `fromDir(path)`") }
                    Table.Cell("Load a template; a directory shares its components")
                }
                Table.Row {
                    Table.Cell { Markdown("`page(name)`, `withLang(lang)`, `withTheme(name)`, `withTokens(\{ … \})`") }
                    Table.Cell("Choose the page, the language, the theme and design tokens over it")
                }
                Table.Row {
                    Table.Cell { Markdown("`renderHtml(data)`, `renderHtmlFragment(data)`") }
                    Table.Cell("A whole document, or the body only, as a string")
                }
                Table.Row {
                    Table.Cell { Markdown("`renderPdf(data)`, `renderSlides(data)`") }
                    Table.Cell { Markdown("A PDF, or a slide deck, as a `Buffer`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`renderHtmlAsync`, `renderHtmlFragmentAsync`, `renderPdfAsync`, `renderSlidesAsync`") }
                    Table.Cell { Markdown("The same, as a `Promise`: use these in a server") }
                }
            }
        }

        Markdown("The package finds `wf` in `WF_BIN`, then in the absolute directories on `PATH` (never the current directory), then in `~/.webfluent/bin` and `~/.cargo/bin`. It needs Node 18 or later, and ships its TypeScript types (`index.d.ts`).")

        Heading("Browser: wf.js", id: "browser-wf-js").h2

        Markdown("The compiler also builds for WebAssembly ([`crates/wf-wasm`](https://github.com/monzeromer-lab/WebFluent/tree/master/crates/wf-wasm)). A page imports `wf.js` and compiles a project with nothing sent to a server: sites and apps, every check `wf check` makes, pictures sized to WebP, PDFs and slide decks. This module compiles a page and shows it in a frame:")

        CodeBlock(#"import { compile, preview, previewConfig } from "./wf.js";

const home = `page Home(path: "/", title: "Home", description: "The front page.") {
    Heading("Hello").h1
}`;

const out = await compile(
  { "src/pages/Home.wf": home },
  previewConfig({ name: "Playground" }),
);
for (const d of out.diagnostics) console.log(d.code, d.message);
if (out.ok) document.querySelector("iframe").src = await preview(out);"#, title: "js")

        Table(caption: "Browser: wf.js") {
            Table.Head {
                Table.Row {
                    Table.Cell("Export").header
                    Table.Cell("What it does").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`compile(files, config)`") }
                    Table.Cell { Markdown("Builds `files` (path → text, or a `Uint8Array` for a picture or a font) with `config`, the text or object of `webfluent.app.json`. Resolves to `\{ ok, files, binary, diagnostics, error, lines \}`; `diagnostics` is what `wf check --format json` lists") }
                }
                Table.Row {
                    Table.Cell { Markdown("`check(files, config)`") }
                    Table.Cell("Every finding, with nothing built")
                }
                Table.Row {
                    Table.Cell { Markdown("`explain(code)`") }
                    Table.Cell { Markdown("`\{ code, severity, title, summary, docs \}`, or `null`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`version()`") }
                    Table.Cell("The compiler's version")
                }
                Table.Row {
                    Table.Cell { Markdown("`preview(out, route?)`") }
                    Table.Cell { Markdown("Hands a build to a service worker (`preview-sw.js`) that serves it under `preview/`, as a host would, and resolves to the address for an `<iframe>`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`previewConfig(config)`") }
                    Table.Cell { Markdown("`config` with `build.base_path` set to where `preview` serves, so the pages ask for their files there") }
                }
                Table.Row {
                    Table.Cell { Markdown("`registerFont(bytes)`") }
                    Table.Cell("A face a document may be set in or fall back to (TTF or OTF, as it is, zlib or gzip); resolves to its family")
                }
                Table.Row {
                    Table.Cell { Markdown("`preload(\{ document \})`") }
                    Table.Cell { Markdown("Starts loading before the first call; `document: true` loads the PDF build too") }
                }
            }
        }

        Markdown("The `<iframe>` needs `sandbox=\"allow-scripts allow-same-origin\"` for the service worker to answer it. Give the preview an origin of its own when the page around it holds anything worth protecting.")

        Heading("The two builds", id: "the-two-builds").h3

        Markdown("`crates/wf-wasm/build.sh` writes two builds, and `wf.js` loads each only when a project needs it. Sizes are of the 6.0 build, compressed with `gzip -9`:")

        Table(caption: "The two builds") {
            Table.Head {
                Table.Row {
                    Table.Cell("File").header
                    Table.Cell("Raw").header
                    Table.Cell("Gzipped").header
                    Table.Cell("Loaded").header
                }
            }
            Table.Body {
                Table.Row {
                    Table.Cell { Markdown("`pkg/wf_wasm_bg.wasm`, the compiler with WebP") }
                    Table.Cell("4.8 MB")
                    Table.Cell("1.6 MB")
                    Table.Cell { Markdown("on the first `compile`, `check` or `preload`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`pkg-pdf/wf_wasm_pdf_bg.wasm`, the same with the PDF engine") }
                    Table.Cell("8.4 MB")
                    Table.Cell("2.7 MB")
                    Table.Cell { Markdown("the first time a config's `output_type` is `\"pdf\"` or `\"slides\"`") }
                }
                Table.Row {
                    Table.Cell { Markdown("`pkg-pdf/fonts/*.ttf.z`, the twelve Liberation faces") }
                    Table.Cell("2.4 MB")
                    Table.Cell("already compressed")
                    Table.Cell("with the PDF build")
                }
                Table.Row {
                    Table.Cell { Markdown("`pkg-pdf/fonts/NotoSansArabic.ttf.gz`") }
                    Table.Cell("455 kB")
                    Table.Cell("already compressed")
                    Table.Cell("the first time a document's text has Arabic in it")
                }
            }
        }

        Markdown("A browser has no machine fonts to fall back on: a document in a script the Liberation faces and the Arabic face lack needs a face given to `registerFont`. `wf test`, `wf verify`, `wf serve` and `wf fmt` are not in the browser build.\n\nTo build both, install `wasm-bindgen-cli` 0.2.130, the `wasm32-unknown-unknown` target and a clang that targets wasm32 (libwebp is C), then run:")

        Terminal(lines: [
                Line(command: "crates/wf-wasm/build.sh")
            ])
    }
}
