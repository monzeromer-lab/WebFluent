        }
    }
}

page ErrorV09(path: "/errors/V09", title: "V09 — An event the element does not fire", description: "A handler names neither a DOM event nor one the element declares, so it never runs; often a misspelling (`on clik`).") {
    ErrorShell("V09", title: "An event the element does not fire", severity: "warning", family: "Vocabulary", summary: "A handler names neither a DOM event nor one the element declares, so it never runs; often a misspelling (`on clik`).", printed: #"warning[V09]: `clik` is not an event Button fires
 --> src/App.wf:3:22
  |
3 |     Button("Save") { on clik { log("saved") } }
  |                      ^^
  = help: A handler names a DOM event (`click`, `input`, `change`, `submit`, `keydown`, `pointerdown`, `scroll`, …) or an event the element declares
  = docs: https://webfluent.monzeromer.dev/errors/V09"#, quickfix: "Change to `click`", lowerable: true, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/V09.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Save").h1
    Button("Save") { on clik { log("saved") } }
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Save").h1
    Button("Save") { on click { log("saved") } }
}"#, title: "wf") }
        note {
            Markdown("Name a DOM event (`click`, `input`, `change`, `submit`, `keydown`,\n…) or one the component declares.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorV12(path: "/errors/V12", title: "V12 — A long list that is not windowed", description: "A `VirtualList` draws only the rows in view of one keyed `for` — `for row in rows by row.id \{ … \}` — that is the whole of its body; with anything…") {
    ErrorShell("V12", title: "A long list that is not windowed", severity: "warning", family: "Vocabulary", summary: "A `VirtualList` draws only the rows in view of one keyed `for` — `for row in rows by row.id \{ … \}` — that is the whole of its body; with anything else in it, or a `for` with no `by`, it draws everything, as a plain scrolling box does.", printed: #"warning[V12]: This `VirtualList` draws every row: its body is not one keyed `for`
 --> src/App.wf:4:5
  |
4 |     VirtualList(rowHeight: 32) {
  |     ^^^^^^^^^^^
  = help: Make its body one `for` with a `by`: `VirtualList(rowHeight: 32) { for row in rows by row.id { … } }`
  = docs: https://webfluent.monzeromer.dev/errors/V12"#, quickfix: "", lowerable: true, why: true, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/V12.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state rows = ["a", "b"]
    Heading("Files").h1
    VirtualList(rowHeight: 32) {
        for r in rows { Text(r) }
    }
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state rows = ["a", "b"]
    Heading("Files").h1
    VirtualList(rowHeight: 32) {
        for r in rows by r { Text(r) }
    }
}"#, title: "wf") }
        note {
            Markdown("Give the `for` a `by`, and move anything else — a heading, a\ncount — outside the `VirtualList`.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
        Markdown("A `VirtualList` draws only the rows in view of the one keyed `for` that is\nthe whole of its body. With anything else beside the `for`, or a `for` with\nno `by` — which has no way to keep a row's nodes as it scrolls — it draws\nevery row, as a plain scrolling box does, and the length of the list is\nwhat the page pays for.")
    }
}

page ErrorV10(path: "/errors/V10", title: "V10 — A Host tag it does not make", description: "A `Host` is made of one of a few elements — `div`, `span`, `canvas`, `svg`, `section`, `figure`, `pre`, `p`, `ul`, `table`; any other tag is a `div`.") {
    ErrorShell("V10", title: "A Host tag it does not make", severity: "warning", family: "Vocabulary", summary: "A `Host` is made of one of a few elements — `div`, `span`, `canvas`, `svg`, `section`, `figure`, `pre`, `p`, `ul`, `table`; any other tag is a `div`.", printed: #"warning[V10]: `Host` makes no `video`, so it is a `div`
 --> src/App.wf:3:10
  |
3 |     Host(tag: "video", mount: (n) => n)
  |          ^^^
  = help: It makes `div`, `span`, `canvas`, `svg`, `section`, `figure`, `pre`, `p`, `ul`, `table`
  = docs: https://webfluent.monzeromer.dev/errors/V10"#, quickfix: "", lowerable: true, why: true, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/V10.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Chart").h1
    Host(tag: "video", mount: (n) => n)
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Chart").h1
    Host(tag: "canvas", mount: (n) => n)
}"#, title: "wf") }
        note {
            Markdown("Make it one of the tags `Host` makes, or use the element the\nbuilt-ins offer for it (`Video`, `Audio`, `Image`).")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
        Markdown("A `Host` is made of one of a few elements: `div`, `span`, `canvas`, `svg`,\n`section`, `figure`, `pre`, `p`, `ul` or `table` — the tag is written into\nthe document, so it is an allow-list rather than whatever the string says.\nAny other tag is a `div`.")
    }
}

page ErrorV11(path: "/errors/V11", title: "V11 — A component named like a built-in", description: "A component the project declares takes the place of a built-in of its name, so the built-in cannot be placed in that project.") {
    ErrorShell("V11", title: "A component named like a built-in", severity: "info", family: "Vocabulary", summary: "A component the project declares takes the place of a built-in of its name: every call of the name draws the project's own, so the built-in cannot be placed in that project. A new built-in never changes what an existing project draws.", printed: #"info[V11]: `Chart` is this project's component, so a call of that name draws it rather than the built-in `Chart`
 --> src/App.wf:1:1
  |
1 | component Chart(_ title: String) {
  | ^^^^^^^^^
  = help: To place the built-in too, rename this one — `MyChart`, `ReportChart` — and its call sites
  = docs: https://webfluent.monzeromer.dev/errors/V11"#, quickfix: "", lowerable: true, why: true, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/V11.md") {
        broken { CodeBlock(#"component Chart(_ title: String) {
    Text(title)
}

page P(path: "/", title: "T", description: "D") {
    Heading("Sales").h1
    Chart("Sales by month")
}"#, title: "wf") }
        fixed { CodeBlock(#"component SalesTitle(_ title: String) {
    Text(title)
}

page P(path: "/", title: "T", description: "D") {
    Heading("Sales").h1
    SalesTitle("Sales by month")
    Chart(kind: .bar, data: [3, 5, 2])
}"#, title: "wf") }
        note {
            Markdown("Nothing needs fixing. To place the built-in too, rename the\ncomponent and its call sites; to stop the note, set `\"lints\": \{ \"V11\": \"off\" \}`.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
        Markdown("A component the project declares takes the place of a built-in of the same\nname: every call of the name draws the project's own component. This is\ninformation (`info`), not a warning. Nothing is wrong, and a new built-in in a later\nWebFluent never changes what an existing project draws. The one thing to\nknow is that the built-in of that name cannot be placed in this project.\n\nTo use the built-in as well, rename the component and its call sites:")
    }
}
