page ErrorA13(path: "/errors/A13", title: "A13 — Colours without enough contrast", description: "A theme's colour pairing falls below the WCAG AA contrast ratio.") {
    ErrorShell("A13", title: "Colours without enough contrast", severity: "warning", family: "Accessibility", summary: "A theme's colour pairing falls below the WCAG AA contrast ratio.", printed: #"warning[A13]: text on a card or surface has a contrast ratio of 1.83:1, below the 4.5:1 WCAG AA minimum
 --> src/App.wf:2:1
  |
2 |     color-text: #BBBBBB
  | ^
  = help: Darken --color-text or lighten --color-surface until they clear 4.5:1
  = docs: https://webfluent.monzeromer.dev/errors/A13"#, quickfix: "", lowerable: true, why: true, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/A13.md") {
        broken { CodeBlock(#"theme Faint {
