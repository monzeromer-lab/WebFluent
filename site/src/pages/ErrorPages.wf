page ErrorA16(path: "/errors/A16", title: "A16 — One id on several elements", description: "A literal `id:` inside a `for`, or in a component placed more than once, gives several elements one id; a label's `for` and `aria-*` find only the first.") {
    ErrorShell("A16", title: "One id on several elements", severity: "warning", family: "Accessibility", summary: "A literal `id:` inside a `for`, or in a component placed more than once, gives several elements one id; a label's `for` and `aria-*` find only the first.", printed: #"warning[A16]: `id: "row"` is inside a `for`, so the page has several elements with one id
 --> src/App.wf:4:26
  |
4 |     for r in rows by r { Text(r, id: "row") }
  |                          ^^^^
  = help: Make it unique — `id: "row-{item.id}"` — or drop it; a label's `for` and `aria-*` find one element by id
  = docs: https://webfluent.monzeromer.dev/errors/A16"#, quickfix: "", lowerable: true, why: true, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/A16.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state rows = ["a", "b"]
    Heading("Rows").h1
    for r in rows by r { Text(r, id: "row") }
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state rows = ["a", "b"]
    Heading("Rows").h1
    for r in rows by r { Text(r, id: "row-{r}") }
}"#, title: "wf") }
        note {
            Markdown("Make it unique — `id: \"row-\{r\}\"` — or drop it.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
        Markdown("Warning.")
    }
}

page ErrorA17(path: "/errors/A17", title: "A17 — A frame with no title", description: "A `Frame` with no `title:`, which is its accessible name: a screen reader announces a frame by its title, and a frame without one as only a frame.") {
