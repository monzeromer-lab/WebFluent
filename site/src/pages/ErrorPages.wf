    Navbar { Navbar.Brand { Text("Ledger") } }
}
page Home(path: "/", title: "T", description: "D") {
    Heading("Home").h1
}"#, title: "wf") }
        fixed { CodeBlock(#"app {
    Navbar { Navbar.Brand { Text("Ledger") } }
