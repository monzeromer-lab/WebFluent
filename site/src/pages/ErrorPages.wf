        }
    }
}

page ErrorT15(path: "/errors/T15", title: "T15 — A match that misses a case, or has one twice", description: "A `match` with no `else` must give every case of the enum an arm — a value with a case it misses would match nothing. A case with two arms reaches…") {
    ErrorShell("T15", title: "A match that misses a case, or has one twice", severity: "error", family: "Types", summary: "A `match` with no `else` must give every case of the enum an arm — a value with a case it misses would match nothing. A case with two arms reaches only the first. A `match` expression that covers every case needs no `else`.", printed: #"error[T15]: this `match` on `status` has no arm for `.review`, and no `else`
 --> src/App.wf:5:5
  |
5 |     match status {
  |     ^^^^^
  = help: Add an arm for each, or `else { … }` for the rest
  = docs: https://webfluent.monzeromer.dev/errors/T15"#, quickfix: "Add an arm for `.review`", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/T15.md") {
        broken { CodeBlock(#"enum Status { draft, review, live }
page P(path: "/", title: "T", description: "D") {
    state status: Status = .draft
    Heading("Status").h1
    match status {
        .draft { Text("Draft") }
        .live { Text("Live") }
    }
}"#, title: "wf") }
        fixed { CodeBlock(#"enum Status { draft, review, live }
page P(path: "/", title: "T", description: "D") {
    state status: Status = .draft
    Heading("Status").h1
    match status {
        .draft { Text("Draft") }
        .review { Text("In review") }
        .live { Text("Live") }
    }
}"#, title: "wf") }
        note {
            Markdown("Give every case its arm, or add `else \{ … \}` for the rest. A\n`match` expression that covers every case needs no `else`:\n`derived label = match status \{ .draft \{ \"Draft\" \} .review \{ \"In review\" \} .live \{ \"Live\" \} \}`.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorT22(path: "/errors/T22", title: "T22 — A handler that names more values than its event sends", description: "A handler names the values its event sends, in order: `on menu(key, x, y)` for a component's `event menu(key: String, x: Number, y: Number)`. A DOM…") {
    ErrorShell("T22", title: "A handler that names more values than its event sends", severity: "error", family: "Types", summary: "A handler names the values its event sends, in order: `on menu(key, x, y)` for a component's `event menu(key: String, x: Number, y: Number)`. A DOM event sends one value, the event itself. A name past the last value sent is never anything but `undefined`.", printed: #"error[T22]: `on menu` names 4 values, but `event menu(key: String, x: Number, y: Number)` sends 3 values
 --> src/App.wf:9:44
  |
9 |     Entry("notes.wf") { on menu(key, x, y, z) { at = "{key} at {x}, {y}" } }
  |                                            ^
  = help: Name at most 3, in order: `on menu(key, x, y)`
  = docs: https://webfluent.monzeromer.dev/errors/T22"#, quickfix: "", lowerable: false, why: true, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/T22.md") {
        broken { CodeBlock(#"component Entry(_ key: String) {
    event menu(key: String, x: Number, y: Number)
    Button(key) { on contextmenu(e) { e.preventDefault()  emit menu(key, e.clientX, e.clientY) } }
}

page P(path: "/", title: "T", description: "D") {
    state at = ""
    Heading("Files").h1
    Entry("notes.wf") { on menu(key, x, y, z) { at = "{key} at {x}, {y}" } }
    Text(at)
}"#, title: "wf") }
        fixed { CodeBlock(#"component Entry(_ key: String) {
    event menu(key: String, x: Number, y: Number)
    Button(key) { on contextmenu(e) { e.preventDefault()  emit menu(key, e.clientX, e.clientY) } }
}

page P(path: "/", title: "T", description: "D") {
    state at = ""
    Heading("Files").h1
    Entry("notes.wf") { on menu(key, x, y) { at = "{key} at {x}, {y}" } }
    Text(at)
}"#, title: "wf") }
        note {
            Markdown("Drop the extra names. For a DOM event, name the event alone and\nread what it carries from it: `on click(e) \{ … e.clientX … \}`.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
        Markdown("Error.\n\nA handler names the values its event sends, in the order the event\ndeclares them; it may name fewer, never more. A DOM event — `click`,\n`input`, `keydown` — sends one value, the event itself, so `on click(e, x)`\nis this error too.")
    }
}

page ErrorT21(path: "/errors/T21", title: "T21 — A resource match with no error arm", description: "When the request fails, a `match` with no `error` arm and no `else` shows nothing at all, and the reader is not told.") {
    ErrorShell("T21", title: "A resource match with no error arm", severity: "warning", family: "Types", summary: "When the request fails, a `match` with no `error` arm and no `else` shows nothing at all, and the reader is not told.", printed: #"warning[T21]: this `match` on `users` has no `error` arm, so a failed request shows nothing
 --> src/App.wf:4:5
  |
4 |     match users {
  |     ^^^^^
  = help: Add `error(e) { Alert(e.message).danger }`, or `else { … }`
  = docs: https://webfluent.monzeromer.dev/errors/T21"#, quickfix: "Add an `error` arm", lowerable: true, why: true, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/T21.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    resource users = fetch("/api/users")
    Heading("Users").h1
    match users {
        loading { Spinner }
        ready(list) { Text("{list.length} users") }
    }
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    resource users = fetch("/api/users")
    Heading("Users").h1
    match users {
        loading { Spinner }
        error(e) { Alert(e.message).danger }
        ready(list) { Text("{list.length} users") }
    }
}"#, title: "wf") }
        note {
            Markdown("`error(e) \{ Alert(e.message).danger \}`, or an `else`.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
        Markdown("Warning.")
    }
}

page ErrorC01(path: "/errors/C01", title: "C01 — A required prop or field left out", description: "A component's prop, or a record's field, that has no default is not given. The value would be `undefined` where the declaration promises one.") {
    ErrorShell("C01", title: "A required prop or field left out", severity: "error", family: "Components", summary: "A component's prop, or a record's field, that has no default is not given. The value would be `undefined` where the declaration promises one.", printed: #"error[C01]: `Todo(…)` leaves out `id` of `Todo`, which has no default
 --> src/App.wf:3:18
  |
3 |     state todo = Todo(title: "Write the docs")
  |                  ^^^^
  = help: Give it, or declare a default in the type: `field: Type = value`
  = docs: https://webfluent.monzeromer.dev/errors/C01"#, quickfix: "", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/C01.md") {
        broken { CodeBlock(#"type Todo { id: String, title: String, done: Bool = false }
page P(path: "/", title: "T", description: "D") {
    state todo = Todo(title: "Write the docs")
    Heading(todo.title).h1
}"#, title: "wf") }
        fixed { CodeBlock(#"type Todo { id: String, title: String, done: Bool = false }
page P(path: "/", title: "T", description: "D") {
    state todo = Todo(id: "1", title: "Write the docs")
    Heading(todo.title).h1
}"#, title: "wf") }
        note {
            Markdown("Give it, or declare a default in the type (`id: String = \"\"`) or\non the prop.\n\nA built-in that cannot be placed without a prop is held to it the same way:\na `Portal` with no `into:` would draw nowhere, and the fix passes\n`into: null` for you to name the node.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorC02(path: "/errors/C02", title: "C02 — A prop the component does not declare", description: "Your own component is called with a prop it does not declare. Nothing in it reads the value, so the call does not do what it says; often a misspelling.") {
    ErrorShell("C02", title: "A prop the component does not declare", severity: "error", family: "Components", summary: "Your own component is called with a prop it does not declare. Nothing in it reads the value, so the call does not do what it says; often a misspelling.", printed: #"error[C02]: `Badge2` declares no prop `colour`
 --> src/App.wf:4:19
  |
4 |     Badge2("New", colour: "red")
  |                   ^^^^^^
  = help: It is passed anyway, but nothing in the component reads it
  = docs: https://webfluent.monzeromer.dev/errors/C02"#, quickfix: "", lowerable: true, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/C02.md") {
        broken { CodeBlock(#"component Badge2(_ label: String) { Text(label) }
page P(path: "/", title: "T", description: "D") {
    Heading("Badges").h1
    Badge2("New", colour: "red")
}"#, title: "wf") }
        fixed { CodeBlock(#"component Badge2(_ label: String, colour: String = "") { Text(label) }
page P(path: "/", title: "T", description: "D") {
    Heading("Badges").h1
    Badge2("New", colour: "red")
}"#, title: "wf") }
        note {
            Markdown("Correct the spelling, or declare the prop on the component.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorC03(path: "/errors/C03", title: "C03 — A part outside the component it belongs to", description: "`Select.Option`, `Table.Row`, `Card.Header` — a part is placed inside its owner. Outside it, it draws a stray element with nothing around it.") {
    ErrorShell("C03", title: "A part outside the component it belongs to", severity: "error", family: "Components", summary: "`Select.Option`, `Table.Row`, `Card.Header` — a part is placed inside its owner. Outside it, it draws a stray element with nothing around it.", printed: #"error[C03]: `Select.Option` is a part of `Select`, and it is not inside one
 --> src/App.wf:3:5
  |
3 |     Select.Option("Pro", value: "pro")
  |     ^^^^^^^^^^^^^
  = help: Place it in a `Select { … }`
  = docs: https://webfluent.monzeromer.dev/errors/C03"#, quickfix: "", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/C03.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Plans").h1
    Select.Option("Pro", value: "pro")
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state plan = "pro"
    Heading("Plans").h1
    Select(bind: plan, label: "Plan") { Select.Option("Pro", value: "pro") }
}"#, title: "wf") }
        note {
            Markdown("Place the part inside its owner: `Select(bind: plan) \{\nSelect.Option(…) \}`.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorC04(path: "/errors/C04", title: "C04 — An attribute a built-in does not declare", description: "A named argument a built-in has no prop for is written to its element as an HTML attribute. `aria-*`, `data-*` and the global attributes are…") {
    ErrorShell("C04", title: "An attribute a built-in does not declare", severity: "warning", family: "Components", summary: "A named argument a built-in has no prop for is written to its element as an HTML attribute. `aria-*`, `data-*` and the global attributes are expected; anything else is usually a misspelling.", printed: #"warning[C04]: Button has no prop `colour`; it is written to the element as an attribute
 --> src/App.wf:3:20
  |
3 |     Button("Save", colour: "red")
  |                    ^^^^^^
  = help: A typo here does nothing on screen; check the component's props
  = docs: https://webfluent.monzeromer.dev/errors/C04"#, quickfix: "", lowerable: true, why: true, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/C04.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Save").h1
    Button("Save", colour: "red")
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Save").h1
    Button("Save").danger
}"#, title: "wf") }
        note {
            Markdown("Check the prop's spelling — `wf registry` lists what the built-in\ntakes. `aria-*`, `data-*` and the global attributes (`id`, `role`,\n`title`, …) are expected and draw nothing.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
        Markdown("Warning.")
    }
}

