page ErrorU07(path: "/errors/U07", title: "U07 — An allow that allows nothing", description: "A `// wf-allow(CODE)` comment covers the next line of code (or its own, at the end of one); when nothing it names is reported there, or it names an…") {
    ErrorShell("U07", title: "An allow that allows nothing", severity: "warning", family: "Declared and never read", summary: "A `// wf-allow(CODE)` comment covers the next line of code (or its own, at the end of one); when nothing it names is reported there, or it names an error no allow may silence, it is reported itself — so allows cannot outlive what they were written for.", printed: #"warning[U07]: `wf-allow(U01)` allows nothing: no `U01` is reported on the line it covers
 --> src/App.wf:2:5
  |
2 |     // wf-allow(U01)
  |     ^^^^^^^^^^^^^^^^
  = help: Remove it — what it was written for is gone
  = docs: https://webfluent.monzeromer.dev/errors/U07"#, quickfix: "Remove the allow", lowerable: true, why: true, example: true, families: ERROR_INDEX, related: [RelatedLink(kind: "U01", title: "A state nothing reads", to: "/errors/U01")], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/U07.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    // wf-allow(U01)
    state shown = 0
    Heading("Count {shown}").h1
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state shown = 0
    Heading("Count {shown}").h1
}"#, title: "wf") }
        note {
            Markdown("Remove the allow — what it was written for is gone.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
        Markdown("A `// wf-allow(CODE)` comment accepts one finding on purpose: on a line of\nits own it covers the next line of code, and at the end of a line it covers\nthat line. It names codes (`U01`) or families (`U`), comma-separated, and\nonly what `lints` could lower — a warning, or an error that ships no broken\npage. An allow that covers nothing it names is reported, so allows cannot\noutlive what they were written for.")
    }
}

