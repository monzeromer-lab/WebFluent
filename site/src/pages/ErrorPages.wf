page ErrorE001(path: "/errors/E001", title: "E001 — Text the compiler cannot read", description: "A character that begins nothing the language has, or a string, comment or splice that never closes. The file is not read past it.") {
    ErrorShell("E001", title: "Text the compiler cannot read", severity: "error", family: "Syntax and structure", summary: "A character that begins nothing the language has, or a string, comment or splice that never closes. The file is not read past it.", printed: #"error[E001]: Unterminated string literal
 --> src/App.wf:2:13
  |
2 |     Heading("Hello).h1
  |             ^
  = docs: https://webfluent.monzeromer.dev/errors/E001"#, quickfix: "", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/E001.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Hello).h1
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Hello").h1
}"#, title: "wf") }
        note {
            Markdown("Close the string, comment or splice the message names. A\ncharacter that begins nothing (`|` alone, a stray `@`) is usually a typo\nfor the one beside it on the keyboard.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorE002(path: "/errors/E002", title: "E002 — A syntax error", description: "The text reads, but not as the language: a missing brace, a stray word, an argument list that does not close. The message names what was expected and…") {
    ErrorShell("E002", title: "A syntax error", severity: "error", family: "Syntax and structure", summary: "The text reads, but not as the language: a missing brace, a stray word, an argument list that does not close. The message names what was expected and what was found.", printed: #"error[E002]: Expected `,` between arguments, got `Text`
 --> src/App.wf:3:14
  |
3 |     Text("a" Text("b")
  |              ^^^^
  = docs: https://webfluent.monzeromer.dev/errors/E002"#, quickfix: "", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/E002.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Hello").h1
    Text("a" Text("b")
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Hello").h1
    Text("a") Text("b")
}"#, title: "wf") }
        note {
            Markdown("The message names what was expected and what was found, at the\nplace the parser stopped. One file can report several: after an error the\nparser picks up again at the next declaration.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorE003(path: "/errors/E003", title: "E003 — Indentation that lines up with no block", description: "In a `.wfx` file a line opens a block by being followed by a deeper one, and closes blocks by coming back out. A line that comes back to an…") {
    ErrorShell("E003", title: "Indentation that lines up with no block", severity: "error", family: "Syntax and structure", summary: "In a `.wfx` file a line opens a block by being followed by a deeper one, and closes blocks by coming back out. A line that comes back to an indentation no enclosing block has is ambiguous.", printed: #"error[E003]: This line's indentation matches no block around it
 --> src/App.wfx:4:7
  |
4 |       Text("b")
  |       ^^^^
  = help: Indent it to the block it belongs to, with the same spaces or tabs as the lines around it
  = docs: https://webfluent.monzeromer.dev/errors/E003"#, quickfix: "", lowerable: false, why: true, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/E003.md") {
        broken { CodeBlock(#"page Home(path: "/")
    Row
        Text("a")
      Text("b")"#, title: "wfx") }
        fixed { CodeBlock(#"page Home(path: "/", title: "Home", description: "Two words in a row.")
    Heading("Home").h1
    Row
        Text("a")
        Text("b")"#, title: "wfx") }
        note {
            Markdown("Line the line up with the block it belongs to.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
        Markdown("In a `.wfx` file, a line that comes back out to an indentation no enclosing\nblock has. Saved as `src/App.wfx`, this draws `E003`:")
    }
}

page ErrorE004(path: "/errors/E004", title: "E004 — A file in the WebFluent 2 grammar", description: "WebFluent 3 reads one grammar. `wf migrate` rewrites a WebFluent 2 project in place.") {
    ErrorShell("E004", title: "A file in the WebFluent 2 grammar", severity: "error", family: "Syntax and structure", summary: "WebFluent 3 reads one grammar. `wf migrate` rewrites a WebFluent 2 project in place.", printed: #"error[E004]: `Page` is a WebFluent 2 declaration; this is WebFluent 3
 --> src/App.wf:1:1
  |
1 | Page Home (path: "/") {
  | ^^^^
  = help: Run `wf migrate` to convert the project to the current grammar
  = docs: https://webfluent.monzeromer.dev/errors/E004"#, quickfix: "", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/E004.md") {
        broken { CodeBlock(#"Page Home (path: "/") {
    Text("Hi")
}"#, title: "wf") }
        fixed { CodeBlock(#"page Home(path: "/", title: "T", description: "D") {
    Heading("Hi").h1
}"#, title: "wf") }
        note {
            Markdown("Run `wf migrate` once; it rewrites the project in place.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorE005(path: "/errors/E005", title: "E005 — A file the formatter will not change", description: "`wf fmt` holds its result to the file's tokens; when formatting would change what a file says, it leaves the file alone and says so.") {
    ErrorShell("E005", title: "A file the formatter will not change", severity: "error", family: "Syntax and structure", summary: "`wf fmt` holds its result to the file's tokens; when formatting would change what a file says, it leaves the file alone and says so.", printed: #""#, quickfix: "", lowerable: false, why: true, example: false, families: ERROR_INDEX, related: [], sections: [Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/E005.md") {
        fixed {
            Stack(gap: .sm) {
                Markdown("format the lines it\nnames by hand; please report the file, since it is a bug in `wf fmt`.")
            }
        }
        Markdown("`wf fmt` checks that its result has the same tokens as the file. When it\nwould not — something only the formatter's reading of the file would\nchange — the file is left as it is and named.")
    }
}

page ErrorE101(path: "/errors/E101", title: "E101 — A component nothing declares", description: "An element, a `layout:` or a part names a component that no `component` declares and no built-in has. Often a misspelling.") {
    ErrorShell("E101", title: "A component nothing declares", severity: "error", family: "Syntax and structure", summary: "An element, a `layout:` or a part names a component that no `component` declares and no built-in has. Often a misspelling.", printed: #"error[E101]: unknown component `Buton`: no `component Buton` is declared
 --> src/App.wf:3:5
  |
3 |     Buton("Save")
  |     ^^^^^
  = help: did you mean `Button`? Or declare `component Buton { … }`
  = docs: https://webfluent.monzeromer.dev/errors/E101"#, quickfix: "Change to `Button`", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/E101.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Save").h1
    Buton("Save")
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Save").h1
    Button("Save")
}"#, title: "wf") }
        note {
            Markdown("Check the spelling, or declare it with `component Buton \{ … \}`.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorE102(path: "/errors/E102", title: "E102 — A name declared twice", description: "Two declarations with one name in one scope: two stores, two constants, a state and a derived of one name. It compiled to a script the browser…") {
    ErrorShell("E102", title: "A name declared twice", severity: "error", family: "Syntax and structure", summary: "Two declarations with one name in one scope: two stores, two constants, a state and a derived of one name. It compiled to a script the browser refused, or let the second quietly replace the first.", printed: #"error[E102]: `count` is declared twice: as a state at line 2, and as a `derived` here
 --> src/App.wf:3:5
  |
3 |     derived count = 1
  |     ^^^^^^^
  = help: A name means one thing — rename one of the two `count`s
  = note: `count` is first declared here at src/App.wf:2:5
  = docs: https://webfluent.monzeromer.dev/errors/E102"#, quickfix: "", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/E102.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state count = 0
    derived count = 1
    Heading("Count {count}").h1
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state count = 0
    derived doubled = count * 2
    Heading("Count {count}, doubled {doubled}").h1
}"#, title: "wf") }
        note {
            Markdown("Rename one of the two. The finding points at the second and names\nwhere the first is.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorE103(path: "/errors/E103", title: "E103 — A flag, case, part, event or slot the component does not have", description: "What a component takes comes from one registry for the built-ins and from the declaration for your own; a word that resolves to nothing there does…") {
    ErrorShell("E103", title: "A flag, case, part, event or slot the component does not have", severity: "error", family: "Syntax and structure", summary: "What a component takes comes from one registry for the built-ins and from the declaration for your own; a word that resolves to nothing there does nothing on screen, so it is refused.", printed: #"error[E103]: Button has no flag or enum case `huge`
 --> src/App.wf:3:19
  |
3 |     Button("Save").huge
  |                   ^^^^^
  = help: Its flags are .bounce, .button, .collapse, .danger, .disabled, .dropInside, .expand, .fadeIn, .fadeOut, .fast, .full, .info, .lg, .loading, .md, .normal, .outlined, .pill, .primary, .pulse, .reset, .rounded, .scaleIn, .scaleOut, .secondary, .shake, .slideDown, .slideLeft, .slideRight, .slideUp, .slow, .sm, .spin, .submit, .success, .trapFocus, .warning
  = docs: https://webfluent.monzeromer.dev/errors/E103"#, quickfix: "", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/E103.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Save").h1
    Button("Save").huge
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Save").h1
    Button("Save").lg
}"#, title: "wf") }
        note {
            Markdown("Use one the message lists — it names every flag, case, event or\nslot the component takes.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorE104(path: "/errors/E104", title: "E104 — A layout with nowhere to put the page", description: "A page's `layout:` is a component the page is placed in, at its default slot. A component that declares no `slot` has nowhere to put it.") {
    ErrorShell("E104", title: "A layout with nowhere to put the page", severity: "error", family: "Syntax and structure", summary: "A page's `layout:` is a component the page is placed in, at its default slot. A component that declares no `slot` has nowhere to put it.", printed: #"error[E104]: `Shell` declares no default slot, so the page has nowhere to go
 --> src/App.wf:2:57
  |
2 | page P(path: "/", title: "T", description: "D", layout: Shell) {
  |                                                         ^^^^^
  = help: Add `slot` to the component and place `children` where the page belongs
  = docs: https://webfluent.monzeromer.dev/errors/E104"#, quickfix: "", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/E104.md") {
        broken { CodeBlock(#"component Shell { Text("frame") }
page P(path: "/", title: "T", description: "D", layout: Shell) {
    Heading("Home").h1
}"#, title: "wf") }
        fixed { CodeBlock(#"component Shell {
    slot
    Text("frame")
    children
}
page P(path: "/", title: "T", description: "D", layout: Shell) {
    Heading("Home").h1
}"#, title: "wf") }
        note {
            Markdown("Add `slot` to the component and place `children` where the page\nbelongs.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorE105(path: "/errors/E105", title: "E105 — A statement a render block cannot hold", description: "A page's or component's body draws; an assignment or a call that does something belongs in a handler, an `action` or an `effect`.") {
    ErrorShell("E105", title: "A statement a render block cannot hold", severity: "error", family: "Syntax and structure", summary: "A page's or component's body draws; an assignment or a call that does something belongs in a handler, an `action` or an `effect`.", printed: #"error[E105]: `n` is not an element or a statement a render block can hold
 --> src/App.wf:4:5
  |
4 |     n = n + 1
  |     ^
  = help: Code that does something goes in `on click { … }`, an `action` or an `effect`; an element's name is capitalised
  = docs: https://webfluent.monzeromer.dev/errors/E105"#, quickfix: "", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/E105.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state n = 0
    Heading("Count").h1
    n = n + 1
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state n = 0
    Heading("Count {n}").h1
    Button("+1") { on click { n = n + 1 } }
}"#, title: "wf") }
        note {
            Markdown("Put it in `on click \{ \}`, an `action` or an `effect`.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorE106(path: "/errors/E106", title: "E106 — Script or a whole style in an attribute", description: "`onclick:` and the other `on*` attributes are script in a string, which the content security policy refuses and nothing checks. A handler is `on…") {
    ErrorShell("E106", title: "Script or a whole style in an attribute", severity: "error", family: "Syntax and structure", summary: "`onclick:` and the other `on*` attributes are script in a string, which the content security policy refuses and nothing checks. A handler is `on click \{ … \}`. `style:` is a value written as the element's whole inline style; a style is a `style \{ \}` block, one property at a time.", printed: #"error[E106]: `onclick` on Button would put script in an attribute
 --> src/App.wf:3:20
  |
3 |     Button("Save", onclick: "save()")
  |                    ^^^^^^^
  = help: Write the handler instead: `Button(…) { on click { … } }`
  = docs: https://webfluent.monzeromer.dev/errors/E106"#, quickfix: "", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/E106.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Save").h1
    Button("Save", onclick: "save()")
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state saves = 0
    action save() { saves = saves + 1 }
    Heading("Saved {saves} times").h1
    Button("Save") { on click { save() } }
}"#, title: "wf") }
        note {
            Markdown("`Button(\"Save\") \{ on click \{ save() \} \}`.\n\n`style:` is refused the same way: it would write a value as the\nelement's whole `style=` attribute, which a value from data can turn\ninto a box over the whole page or a request to anywhere. A style is a\n`style \{ \}` block, one property at a time, where a value that reads\nstate sets that one property and nothing else.\n\n```wf expect=E106\npage P(path: \"/\", title: \"T\", description: \"D\") \{\n    state look = \"color: red\"\n    Heading(\"Note\").h1\n    Text(\"Hi\", style: look)\n\}\n```\n\n```text\nerror[E106]: `style:` on Text would write a value as the element's whole inline style\n --> src/App.wf:4:16\n  |\n4 |     Text(\"Hi\", style: look)\n  |                ^^^^^\n  = help: Write a style block instead: `Text(…) \{ style \{ color: \{tone\} \} \}`, one property at a time\n  = docs: https://webfluent.monzeromer.dev/errors/E106\n```\n\n**Fix:** `Text(\"Hi\") \{ style \{ color: \{tone\} \} \}`.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorE107(path: "/errors/E107", title: "E107 — A URL a browser would run", description: "`javascript:`, `data:`, `vbscript:`, `blob:` and `file:` URLs run or load something the page did not write. A link takes `http`, `https`, `mailto`,…") {
    ErrorShell("E107", title: "A URL a browser would run", severity: "error", family: "Syntax and structure", summary: "`javascript:`, `data:`, `vbscript:`, `blob:` and `file:` URLs run or load something the page did not write. A link takes `http`, `https`, `mailto`, `tel`, `sms`, `ftp` or a relative URL. In `head \{ \}`, a `script(src:)` or a refresh whose address a value chooses is refused the same way.", printed: #"error[E107]: `to` on Link names the `javascript` scheme, which a browser runs
 --> src/App.wf:3:16
  |
3 |     Link("Go", to: "javascript:alert(1)")
  |                ^^
  = help: A URL here may be relative, or name http, https, mailto, tel, sms or ftp
  = docs: https://webfluent.monzeromer.dev/errors/E107"#, quickfix: "", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/E107.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Go").h1
    Link("Go", to: "javascript:alert(1)")
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Go").h1
    Link("Go", to: "https://example.com/")
}"#, title: "wf") }
        note {
            Markdown("A relative URL, or `http`, `https`, `mailto`, `tel`, `sms`,\n`ftp`.\n\nA page's `head \{ \}` is held to the same rule, and more: a\n`script(src:)` must be written out, since whoever controls a value it\nreads would choose the script the page runs; a `meta(http-equiv:\n\"refresh\")` whose address comes from a value is an open redirect, and\nan `http-equiv` a value chooses could become one.\n\n```wf expect=E107\npage P(path: \"/\", title: \"T\", description: \"D\") \{\n    head \{ script(src: query.lib) \}\n    Heading(\"Home\").h1\n\}\n```\n\n```text\nerror[E107]: `head \{ script(src: …) \}` loads a script a value chooses: whoever controls the value runs code as this site\n --> src/App.wf:2:12\n  |\n2 |     head \{ script(src: query.lib) \}\n  |            ^^^^^^\n  = help: Write the address out — `script(src: \"/analytics.js\")` — and keep what varies in the script's own data\n  = docs: https://webfluent.monzeromer.dev/errors/E107\n```\n\n**Fix:** `head \{ script(src: \"/analytics.js\") \}`; send a reader on with\n`navigate(…)`, which keeps to the site's routes.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorE108(path: "/errors/E108", title: "E108 — An env name that is not public", description: "Whatever a page reads from `env` is in the bundle, where anyone can read it. A name a page reads must begin `PUBLIC_` or be listed in `public_env`.") {
    ErrorShell("E108", title: "An env name that is not public", severity: "error", family: "Syntax and structure", summary: "Whatever a page reads from `env` is in the bundle, where anyone can read it. A name a page reads must begin `PUBLIC_` or be listed in `public_env`.", printed: #""#, quickfix: "", lowerable: false, why: true, example: false, families: ERROR_INDEX, related: [], sections: [Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/E108.md") {
        fixed {
            Stack(gap: .sm) {
                Markdown("rename it `PUBLIC_…` (`env.PUBLIC_APP_NAME`) or list it in\n`public_env` — only if anyone may read it. A value the page must not read\nbelongs behind a request ([Environments and\nsecrets](/recipes/environments-and-secrets)).")
            }
        }
        Markdown("A page that reads `env.STRIPE_SECRET` draws ``env.STRIPE_SECRET is not\npublic, and a page reads what is in the bundle`` (the example is not\ncompiled here: what it draws depends on the config's `public_env`):\n\n```wf no-check\npage P(path: \"/\", title: \"T\", description: \"D\") \{\n    Heading(env.STRIPE_SECRET).h1\n\}\n```")
    }
}

page ErrorE109(path: "/errors/E109", title: "E109 — An element this output cannot draw", description: "A PDF or a slide deck has no buttons, inputs, handlers or routes; an interactive element in one would be drawn as nothing.") {
    ErrorShell("E109", title: "An element this output cannot draw", severity: "error", family: "Syntax and structure", summary: "A PDF or a slide deck has no buttons, inputs, handlers or routes; an interactive element in one would be drawn as nothing.", printed: #""#, quickfix: "", lowerable: false, why: true, example: false, families: ERROR_INDEX, related: [], sections: [Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/E109.md") {
        fixed {
            Stack(gap: .sm) {
                Markdown("draw it as text, or build the\npage as a site.")
            }
        }
        Markdown("A `Button`, an `Input`, a handler or a `Router` in a project whose\n`output_type` is `pdf` or `slides`. With `\"build\": \{ \"output_type\": \"pdf\" \}`\nin `webfluent.app.json` (the example is not compiled here: what it draws\ndepends on the config):\n\n```wf no-check\npage Report(path: \"/\", title: \"Report\", description: \"The quarter.\") \{\n    Document(title: \"Q1 report\") \{\n        Heading(\"Q1 report\").h1\n        Button(\"Print\")\n    \}\n\}\n```\n\nPaper has no controls (`Button`,\n`Input`, `Select`, `Checkbox`, `Radio`, `Switch`, `Slider`, `DatePicker`,\n`FileUpload`, `Textarea`, `Form`, `IconButton`, `ButtonGroup`, `Dropdown`), no navigation\n(`Router`, `Navbar`, `Sidebar`, `Tabs`, `Menu`), no overlays (`Modal`,\n`Dialog`, `Popover`, `Toast`, `Tooltip`), no media that plays (`Video`,\n`Audio`, `Carousel`), no other page inside it (`Frame`) and nothing a\nscript draws (`Host`, `Element`, `Portal`).")
    }
}

page ErrorE110(path: "/errors/E110", title: "E110 — A project script that cannot be a plain script", description: "A `.js` file under `src/` is linked as a plain browser script: one with `import` or `export`, one a file in `public/` would replace, or one whose…") {
    ErrorShell("E110", title: "A project script that cannot be a plain script", severity: "error", family: "Syntax and structure", summary: "A `.js` file under `src/` is linked as a plain browser script: one with `import` or `export`, one a file in `public/` would replace, or one whose names clash with the program's, cannot be.", printed: #""#, quickfix: "", lowerable: false, why: true, example: false, families: ERROR_INDEX, related: [], sections: [Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/E110.md") {
        fixed {
            Stack(gap: .sm) {
                Markdown("take off the\n`import`/`export` (a top-level `function` is global as it is), keep one of\nthe two files, or rename the clashing name.")
            }
        }
        Markdown("A `.js` file under `src/` with an `import` or `export`, one a file in\n`public/` at the same address would replace, or one declaring a name the\nprogram, the language or the browser already has.")
    }
}

page ErrorE111(path: "/errors/E111", title: "E111 — A setting that cannot work", description: "A value in `webfluent.app.json` that names something that does not exist or asks for something the build cannot do.") {
    ErrorShell("E111", title: "A setting that cannot work", severity: "error", family: "Syntax and structure", summary: "A value in `webfluent.app.json` that names something that does not exist or asks for something the build cannot do.", printed: #""#, quickfix: "", lowerable: false, why: true, example: false, families: ERROR_INDEX, related: [], sections: [Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/E111.md") {
        fixed {
            Stack(gap: .sm) {
                Markdown("what the message says; it names the setting.")
            }
        }
        Markdown("A `meta.scripts` module with no `as`, a `build.elements` naming a component\nthat does not exist, an `offline.fallback` no page has, an `openapi.json`\nthat is not there.")
    }
}

page ErrorE112(path: "/errors/E112", title: "E112 — A setting nothing reads", description: "A key in `webfluent.app.json` that is not a setting. Usually a misspelling, so the setting it meant keeps its default.") {
    ErrorShell("E112", title: "A setting nothing reads", severity: "warning", family: "Syntax and structure", summary: "A key in `webfluent.app.json` that is not a setting. Usually a misspelling, so the setting it meant keeps its default.", printed: #""#, quickfix: "", lowerable: true, why: true, example: false, families: ERROR_INDEX, related: [], sections: [Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/E112.md") {
        fixed {
            Stack(gap: .sm) {
                Markdown("correct the key.")
            }
        }
        Markdown("Warning. A key in `webfluent.app.json` that is not a setting, with the\nnearest one that is: `` `build.minfy` is not a setting, and nothing reads it\n— did you mean `minify`? ``")
    }
}

