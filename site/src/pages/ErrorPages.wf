}

page ErrorR05(path: "/errors/R05", title: "R05 — A translation of no page, or two in one language", description: "`translates:` names the page this one is a translation of, and the pages it joins list each other as `hreflang` alternates, each in its own `lang:`.…") {
    ErrorShell("R05", title: "A translation of no page, or two in one language", severity: "error", family: "Routes", summary: "`translates:` names the page this one is a translation of, and the pages it joins list each other as `hreflang` alternates, each in its own `lang:`. A name no page has joins nothing, and two pages in one language would be two alternates for one `hreflang`.", printed: #"error[R05]: `HomeEn` translates `Hom`, and no page is named `Hom`
 --> src/App.wf:5:1
  |
5 | page HomeEn(path: "/en", title: "Home", description: "D", lang: "en", translates: Hom) {
  | ^^^^
  = help: Did you mean `Home`?
  = docs: https://webfluent.monzeromer.dev/errors/R05"#, quickfix: "", lowerable: false, why: true, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/R05.md") {
        broken { CodeBlock(#"page Home(path: "/", title: "Home", description: "D") {
    Heading("Home").h1
}

page HomeEn(path: "/en", title: "Home", description: "D", lang: "en", translates: Hom) {
    Heading("Home").h1
}"#, title: "wf") }
        fixed { CodeBlock(#"page Home(path: "/", title: "Home", description: "D") {
    Heading("Home").h1
}

page HomeEn(path: "/en", title: "Home", description: "D", lang: "en", translates: Home) {
    Heading("Home").h1
}"#, title: "wf") }
        note {
            Markdown("name a page the program declares, and give each translation the `lang:` it\nis written in.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
        Markdown("Error.\n\n`translates:` names the page this one is a translation of, and the pages\nit joins list each other as `hreflang` alternates, each in its own `lang:`.\nTwo pages of one group in the same language — or both with no `lang:`, so\nboth in the site's — would be two alternates for one language.")
    }
}

page ErrorX01(path: "/errors/X01", title: "X01 — An assignment to something that cannot change", description: "A `const`, a `derived` value, a prop, a route parameter, a loop variable or an action is assigned to. At run time the write throws, or changes a copy…") {
    ErrorShell("X01", title: "An assignment to something that cannot change", severity: "error", family: "State and reactivity", summary: "A `const`, a `derived` value, a prop, a route parameter, a loop variable or an action is assigned to. At run time the write throws, or changes a copy nothing reads.", printed: #"error[X01]: `LIMIT` is a `const`, and nothing may assign to it
 --> src/App.wf:4:33
  |
4 |     Button("More") { on click { LIMIT = 4 } }
  |                                 ^^^^^
  = help: Declare it `state` if it changes; a constant is the same on every page
  = docs: https://webfluent.monzeromer.dev/errors/X01"#, quickfix: "", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/X01.md") {
        broken { CodeBlock(#"const LIMIT = 3
page P(path: "/", title: "T", description: "D") {
    Heading("Limit {LIMIT}").h1
    Button("More") { on click { LIMIT = 4 } }
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state limit = 3
    Heading("Limit {limit}").h1
    Button("More") { on click { limit = 4 } }
}"#, title: "wf") }
        note {
            Markdown("Hold what changes in a `state`. A `derived` value changes when\nwhat it reads does; a prop is its caller's (`emit` an event so the caller\nchanges it); a route parameter is the address's (`navigate`); a loop\nvariable is one pass's copy (change the item through its list).")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorX02(path: "/errors/X02", title: "X02 — An effect that feeds itself", description: "An effect re-runs when what it reads changes. One that writes, every run, something it reads starts the next run itself: the page never settles, and…") {
    ErrorShell("X02", title: "An effect that feeds itself", severity: "error", family: "State and reactivity", summary: "An effect re-runs when what it reads changes. One that writes, every run, something it reads starts the next run itself: the page never settles, and the browser overflows its stack.", printed: #"error[X02]: this effect writes `visits`, which it also reads, so each run starts the next and the page never settles
 --> src/App.wf:3:5
  |
3 |     effect { visits = visits + 1 }
  |     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  = help: Work the value out with `derived` instead, or write it from the action that changes what it reads
  = docs: https://webfluent.monzeromer.dev/errors/X02"#, quickfix: "", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/X02.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state visits = 0
    effect { visits = visits + 1 }
    Heading("Visits {visits}").h1
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state visits = 0
    Heading("Visits {visits}").h1
    Button("Visit") { on click { visits = visits + 1 } }
}"#, title: "wf") }
        note {
            Markdown("Work a value out with `derived`; change state from the action or\nhandler that changes what it depends on.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorX04(path: "/errors/X04", title: "X04 — A derived value that changes something", description: "A `derived` value is worked out whenever what it reads changes, as often as the page needs it; one that calls an action that assigns changes state…") {
    ErrorShell("X04", title: "A derived value that changes something", severity: "error", family: "State and reactivity", summary: "A `derived` value is worked out whenever what it reads changes, as often as the page needs it; one that calls an action that assigns changes state each time it is read.", printed: #"error[X04]: `ticket` is worked out by calling `next(…)`, which assigns `count`
 --> src/App.wf:7:5
  |
7 |     derived ticket = next()
  |     ^^^^^^^^^^^^^^^^^^^^^^^
  = help: A derived value only reads; call the action from a handler, and derive from what it sets
  = docs: https://webfluent.monzeromer.dev/errors/X04"#, quickfix: "", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/X04.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state count = 0
    action next() {
        count = count + 1
        return count
    }
    derived ticket = next()
    Heading("Ticket {ticket}").h1
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state count = 0
    action next() {
        count = count + 1
        return count
    }
    derived ticket = count
    Heading("Ticket {ticket}").h1
    Button("Next") { on click { next() } }
}"#, title: "wf") }
        note {
            Markdown("Call the action from a handler; derive from the state it sets.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorX05(path: "/errors/X05", title: "X05 — use of a store nothing declares", description: "`use` names a store the page depends on; one that is not declared is a misspelling, and every read of it is nothing.") {
    ErrorShell("X05", title: "use of a store nothing declares", severity: "error", family: "State and reactivity", summary: "`use` names a store the page depends on; one that is not declared is a misspelling, and every read of it is nothing.", printed: #"error[X05]: `use Carts` names a store nothing declares
 --> src/App.wf:3:5
  |
3 |     use Carts
  |     ^^^
  = help: The stores are `Cart`
  = docs: https://webfluent.monzeromer.dev/errors/X05"#, quickfix: "Change to `Cart`", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/X05.md") {
        broken { CodeBlock(#"store Cart { state items = [] }
page P(path: "/", title: "T", description: "D") {
    use Carts
    Heading("Cart").h1
}"#, title: "wf") }
        fixed { CodeBlock(#"store Cart { state items = [] }
page P(path: "/", title: "T", description: "D") {
    use Cart
    Heading("Cart: {Cart.items.length}").h1
}"#, title: "wf") }
        note {
            Markdown("Name a store that exists — here `Cart`.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorX06(path: "/errors/X06", title: "X06 — A state that copies a live value once", description: "`now`, `viewport`, `query`, `hash`, `theme`, `network` and `update` keep themselves current, but a `state` takes its initial value once: `state clock…") {
    ErrorShell("X06", title: "A state that copies a live value once", severity: "warning", family: "State and reactivity", summary: "`now`, `viewport`, `query`, `hash`, `theme`, `network` and `update` keep themselves current, but a `state` takes its initial value once: `state clock = now(every: 1.seconds)` holds the moment the page opened, and everything worked out from it stays there. A `derived` value follows what it reads. A state the program goes on to assign or bind starts from the live value on purpose, and draws nothing.", printed: #"warning[X06]: `clock` copies `now` once, when the page opens, and never follows it
 --> src/App.wf:3:5
  |
3 |     state clock = now(every: 1.seconds)
  |     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  = help: Nothing assigns `clock`: declare it `derived`, which is worked out again whenever `now` changes
  = docs: https://webfluent.monzeromer.dev/errors/X06"#, quickfix: "Change to `derived clock`", lowerable: true, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/X06.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state posted = @2026-03-14T09:30:00Z
    state clock = now(every: 1.seconds)
    derived age = posted.until(clock)
    Heading("Posted {age.minutes()} minutes ago").h1
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state posted = @2026-03-14T09:30:00Z
    derived clock = now(every: 1.seconds)
    derived age = posted.until(clock)
    Heading("Posted {age.minutes()} minutes ago").h1
}"#, title: "wf") }
        note {
            Markdown("Declare it `derived` — the quick fix does. `derived clock =\nnow(every: 1.seconds)` is worked out again on every tick, and so is\neverything that reads it. `now`, `viewport`, `query`, `hash`, `theme`,\n`network` and `update` all keep themselves current; a `state` only takes\nthe value it starts with. A state the program assigns, binds or\nchanges in place is a starting value on purpose — `state tab = query.tab\n?? \"all\"` that a click then changes — and draws nothing. Neither does a\nlive value read inside a lambda, which reads it each time it is called.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorF01(path: "/errors/F01", title: "F01 — A bind: to something that cannot be written", description: "`bind:` writes what the control holds back to what it names: a state, a store's state, or a field of a loop's item. A constant, a derived value, a…") {
    ErrorShell("F01", title: "A bind: to something that cannot be written", severity: "error", family: "Forms and bindings", summary: "`bind:` writes what the control holds back to what it names: a state, a store's state, or a field of a loop's item. A constant, a derived value, a prop or a value worked out on the spot cannot take it.", printed: #"error[F01]: `bind:` on `Input` writes back to what it names, and `name` is a `derived` value
 --> src/App.wf:5:11
  |
5 |     Input(bind: name, label: "Name")
  |           ^^^^^^^^^^
  = help: Bind a `state` (or a store's state, or a field of a loop's item); show a value with `value:`
  = docs: https://webfluent.monzeromer.dev/errors/F01"#, quickfix: "", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/F01.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state first = "Ada"
    derived name = first.toUpperCase()
    Heading("Name").h1
    Input(bind: name, label: "Name")
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state first = "Ada"
    derived name = first.toUpperCase()
    Heading(name).h1
    Input(bind: first, label: "Name")
}"#, title: "wf") }
        note {
            Markdown("Bind the state the reader edits (`bind: first`); show a value\nthat is worked out with `value:`.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorF02(path: "/errors/F02", title: "F02 — A bind: to a state the control cannot hold", description: "A text field holds text, a number field (`.number`) a number, a checkbox a `Bool`. Bound to a state of another type, it writes the wrong kind of…") {
    ErrorShell("F02", title: "A bind: to a state the control cannot hold", severity: "error", family: "Forms and bindings", summary: "A text field holds text, a number field (`.number`) a number, a checkbox a `Bool`. Bound to a state of another type, it writes the wrong kind of value into it.", printed: #"error[F02]: `bind:` on `Input` holds a `String`, but `qty` is `Number`
 --> src/App.wf:4:11
  |
4 |     Input(bind: qty, label: "Quantity")
  |           ^^^^^^^^^
  = help: A number field is `Input(…).number`, which holds a number
  = docs: https://webfluent.monzeromer.dev/errors/F02"#, quickfix: "", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/F02.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state qty = 1
    Heading("Order").h1
    Input(bind: qty, label: "Quantity")
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state qty = 1
    Heading("Order").h1
    Input(bind: qty, label: "Quantity").number
}"#, title: "wf") }
        note {
            Markdown("A number field is `Input(…).number`; a text field holds a\n`String`.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorF03(path: "/errors/F03", title: "F03 — A validate block no control can satisfy", description: "The rules of a `validate` block are shown on the control bound to the state, and a form is valid when they pass. On a state no control binds, or a…") {
    ErrorShell("F03", title: "A validate block no control can satisfy", severity: "error", family: "Forms and bindings", summary: "The rules of a `validate` block are shown on the control bound to the state, and a form is valid when they pass. On a state no control binds, or a derived value, they can never pass, and the submit stays disabled.", printed: #"error[F03]: `validate email` guards a state no control binds, so its rules can never be met
 --> src/App.wf:3:5
  |
3 |     validate email { required  email }
  |     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
  = help: Bind it to the control the reader fills in: `Input(bind: email, …)`
  = docs: https://webfluent.monzeromer.dev/errors/F03"#, quickfix: "", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/F03.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state email = ""
    validate email { required  email }
    Heading("Join").h1
    Form { Button("Join", type: .submit) }
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state email = ""
    validate email { required  email }
    Heading("Join").h1
    Form {
        Input(bind: email, label: "Email").email
        Button("Join", type: .submit)
    }
}"#, title: "wf") }
        note {
            Markdown("Bind the state to the control the reader fills in:\n`Input(bind: email, label: \"Email\").email`.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorF04(path: "/errors/F04", title: "F04 — A checkbox that shows a state and never changes it", description: "`Checkbox(checked: x)` with no `bind:` and no `on change` draws `x`, and a click toggles the box while `x` stays as it was.") {
    ErrorShell("F04", title: "A checkbox that shows a state and never changes it", severity: "warning", family: "Forms and bindings", summary: "`Checkbox(checked: x)` with no `bind:` and no `on change` draws `x`, and a click toggles the box while `x` stays as it was.", printed: #"warning[F04]: this `Checkbox` shows `checked:` but nothing changes it, so a click toggles the box and not the state
 --> src/App.wf:4:5
  |
4 |     Checkbox(checked: agree, label: "I agree")
  |     ^^^^^^^^
  = help: Write `bind:` to keep the box and the state together, or handle `on change`
  = docs: https://webfluent.monzeromer.dev/errors/F04"#, quickfix: "Change to `bind:`", lowerable: true, why: true, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/F04.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state agree = false
    Heading("Terms").h1
    Checkbox(checked: agree, label: "I agree")
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state agree = false
    Heading("Terms").h1
    Checkbox(bind: agree, label: "I agree")
}"#, title: "wf") }
        note {
            Markdown("`Checkbox(bind: agree, label: \"I agree\")`.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
        Markdown("Warning.")
    }
}

page ErrorF05(path: "/errors/F05", title: "F05 — A select whose value is none of its options", description: "The bound state starts as a value no option has, so the select shows its first option while the state holds something else.") {
    ErrorShell("F05", title: "A select whose value is none of its options", severity: "warning", family: "Forms and bindings", summary: "The bound state starts as a value no option has, so the select shows its first option while the state holds something else.", printed: #"warning[F05]: `plan` starts as `basic`, which is none of this select's options
 --> src/App.wf:4:5
  |
4 |     Select(bind: plan, label: "Plan") {
  |     ^^^^^^
  = help: Start it as one of them (`free`, `pro`), so what is shown is what is held
  = docs: https://webfluent.monzeromer.dev/errors/F05"#, quickfix: "", lowerable: true, why: true, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/F05.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state plan = "basic"
    Heading("Plan").h1
    Select(bind: plan, label: "Plan") {
        Select.Option("Free", value: "free")
        Select.Option("Pro", value: "pro")
    }
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state plan = "free"
    Heading("Plan").h1
    Select(bind: plan, label: "Plan") {
        Select.Option("Free", value: "free")
        Select.Option("Pro", value: "pro")
    }
}"#, title: "wf") }
        note {
            Markdown("Start the state as one of the options' values.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
        Markdown("Warning.")
    }
}

page ErrorD01(path: "/errors/D01", title: "D01 — A file the project does not have", description: "A site-relative `src:`, `poster:`, `captions:` or `transcript:` names a file that is not in `public/`; the page asks for it and gets nothing.") {
    ErrorShell("D01", title: "A file the project does not have", severity: "warning", family: "Data and assets", summary: "A site-relative `src:`, `poster:`, `captions:` or `transcript:` names a file that is not in `public/`; the page asks for it and gets nothing.", printed: #""#, quickfix: "", lowerable: true, why: true, example: false, families: ERROR_INDEX, related: [], sections: [Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/D01.md") {
        fixed {
            Stack(gap: .sm) {
                Markdown("put the file in `public/`, or correct\nthe path.")
            }
        }
        Markdown("Warning. In a project whose `public/` has no `img/hero.png` (the example\nis not compiled here: what it draws depends on the project's files):\n\n```wf no-check\npage P(path: \"/\", title: \"T\", description: \"D\") \{\n    Heading(\"Team\").h1\n    Image(src: \"/img/hero.png\", alt: \"The team at the launch\")\n\}\n```\n\nThe same goes for a `Video`'s `poster:` and `captions:`, an `Audio`'s\n`transcript:`, and a worker's `spawn(\"/workers/css.js\")`: the page asks\nfor the file and gets a 404.")
    }
}

page ErrorD02(path: "/errors/D02", title: "D02 — A persisted value storage cannot keep", description: "`persist` writes its value to the browser's storage as JSON; a function, a file or a promise does not survive it.") {
    ErrorShell("D02", title: "A persisted value storage cannot keep", severity: "error", family: "Data and assets", summary: "`persist` writes its value to the browser's storage as JSON; a function, a file or a promise does not survive it.", printed: #"error[D02]: `persist pick` keeps a function, which cannot be written to the browser's storage
 --> src/App.wf:2:5
  |
2 |     persist pick = (x) => x + 1
  |     ^^^^^^^^^^^^^^^^^^^^^^^^^^^
  = help: Keep what it is made from — a name, an id, the data — and build it again when it is read
  = docs: https://webfluent.monzeromer.dev/errors/D02"#, quickfix: "", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/D02.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    persist pick = (x) => x + 1
    Heading("Pick").h1
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    persist step = 1
    Heading("Pick {step}").h1
}"#, title: "wf") }
        note {
            Markdown("Keep what it is made from — a name, an id, the data — and build\nthe rest when it is read.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorD03(path: "/errors/D03", title: "D03 — A persisted value every instance shares", description: "A `persist` in a component placed more than once, or in a loop, is one stored value for all of them. `key:` gives each its own.") {
    ErrorShell("D03", title: "A persisted value every instance shares", severity: "warning", family: "Data and assets", summary: "A `persist` in a component placed more than once, or in a loop, is one stored value for all of them. `key:` gives each its own.", printed: #"warning[D03]: `persist open` is in `Panel`, which is placed more than once, so every one of them reads and writes one stored value
 --> src/App.wf:2:5
  |
2 |     persist open = false
  |     ^^^^^^^
  = help: Give each its own: `persist open = false { key: id }`, with `id` a prop that tells them apart
  = docs: https://webfluent.monzeromer.dev/errors/D03"#, quickfix: "", lowerable: true, why: true, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/D03.md") {
        broken { CodeBlock(#"component Panel(_ title: String) {
    persist open = false
    Card { Text(title) }
}
page P(path: "/", title: "T", description: "D") {
    Heading("Panels").h1
    Panel("One")
    Panel("Two")
}"#, title: "wf") }
        fixed { CodeBlock(#"component Panel(_ title: String) {
    persist open = false { key: title }
    Card { Text(title)  if open { Text("Open") } }
}
page P(path: "/", title: "T", description: "D") {
    Heading("Panels").h1
    Panel("One")
    Panel("Two")
}"#, title: "wf") }
        note {
            Markdown("Give each instance its own key: `persist open = false \{ key: title\n\}`, with a prop that tells them apart.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
        Markdown("Warning.")
    }
}

page ErrorD04(path: "/errors/D04", title: "D04 — A persisted shape changed with no new version", description: "What a returning reader's browser holds is the old shape; the page reads it as the new one. Raising `version:`, with a `migrate` step, brings it forward.") {
    ErrorShell("D04", title: "A persisted shape changed with no new version", severity: "warning", family: "Data and assets", summary: "What a returning reader's browser holds is the old shape; the page reads it as the new one. Raising `version:`, with a `migrate` step, brings it forward.", printed: #""#, quickfix: "", lowerable: true, why: true, example: false, families: ERROR_INDEX, related: [], sections: [Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/D04.md") {
        fixed {
            Stack(gap: .sm) {
                Markdown("raise `version:` and add `migrate 1 -> 2 \{ … \}` to bring the\nold value forward.")
            }
        }
        Markdown("Warning. The build remembers what each `persist` held (in\n`.wf-cache/persist.json`); when that changes — `persist items = []` becomes\n`persist items = \{ open: [], done: [] \}` — and `version:` does not, a\nreturning reader's browser hands the old shape to code written for the new\none.")
    }
}

page ErrorD05(path: "/errors/D05", title: "D05 — An asset from another origin with no integrity hash", description: "A stylesheet, font or script loaded from another origin is code that origin can change after you read it. A `meta.integrity` hash is how the browser…") {
    ErrorShell("D05", title: "An asset from another origin with no integrity hash", severity: "warning", family: "Data and assets", summary: "A stylesheet, font or script loaded from another origin is code that origin can change after you read it. A `meta.integrity` hash is how the browser checks it has not.", printed: #""#, quickfix: "", lowerable: true, why: true, example: false, families: ERROR_INDEX, related: [], sections: [Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/D05.md") {
        fixed {
            Stack(gap: .sm) {
                Markdown("add its `sha384-…` hash to `meta.integrity` (the CDN usually\npublishes it). Google Fonts is exempt: its stylesheet differs per browser.")
            }
        }
        Markdown("Warning. A font, stylesheet or script in `meta.fonts`, `meta.stylesheets`\nor `meta.scripts` from another origin, with no hash in `meta.integrity`.")
    }
}

page ErrorI01(path: "/errors/I01", title: "I01 — A message no translation has", description: "`t(\"key\")` names a key no locale's file holds, so the page shows the key itself.") {
    ErrorShell("I01", title: "A message no translation has", severity: "error", family: "Translations", summary: "`t(\"key\")` names a key no locale's file holds, so the page shows the key itself.", printed: #""#, quickfix: "", lowerable: true, why: true, example: false, families: ERROR_INDEX, related: [], sections: [Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/I01.md") {
        fixed {
            Stack(gap: .sm) {
                Markdown("the key the message suggests, or add it to the files.")
            }
        }
        Markdown("`t(\"nav.blgo\")` when no locale's file holds `nav.blgo`: the page shows\n`nav.blgo`.")
    }
}

page ErrorI02(path: "/errors/I02", title: "I02 — A message and its call that disagree", description: "The call passes a value the message does not use, or the message shows a placeholder the call does not pass, which then shows as written.") {
    ErrorShell("I02", title: "A message and its call that disagree", severity: "error", family: "Translations", summary: "The call passes a value the message does not use, or the message shows a placeholder the call does not pass, which then shows as written.", printed: #""#, quickfix: "", lowerable: true, why: true, example: false, families: ERROR_INDEX, related: [], sections: [Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/I02.md") {
        fixed {
            Stack(gap: .sm) {
                Markdown("pass what the\nmessage shows, by the name it shows it.")
            }
        }
        Markdown("`t(\"greeting\", \{ nme: user.name \})` against `\"greeting\": \"Hello, \{name\}!\"`:\n`nme` is not used, and `\{name\}` shows as written.")
    }
}

page ErrorI03(path: "/errors/I03", title: "I03 — A message one locale has and another does not", description: "A reader in the locale that lacks it sees the default locale's words instead of their own — or, where the default locale is the one that lacks it, the key.") {
    ErrorShell("I03", title: "A message one locale has and another does not", severity: "warning", family: "Translations", summary: "A reader in the locale that lacks it sees the default locale's words instead of their own — or, where the default locale is the one that lacks it, the key.", printed: #""#, quickfix: "", lowerable: true, why: true, example: false, families: ERROR_INDEX, related: [], sections: [Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/I03.md") {
        fixed {
            Stack(gap: .sm) {
                Markdown("translate it, or\nremove it from the others.")
            }
        }
        Markdown("Warning. `nav.blog` in `en.json` and not in `ar.json`: a reader in Arabic\nsees the English message, since a key the reader's locale lacks falls back to\nthe default locale's. Where the default locale is the one that lacks it, the\nreader sees the key itself. A locale with no file at all reads every message\nfrom the default locale's.\n\nUnder `i18n.literals`, the default locale's words are their own keys, so its\ntable lacking one is no fault and is not reported.")
    }
}

page ErrorI04(path: "/errors/I04", title: "I04 — A locale the project does not have", description: "`setLocale(\"xx\")` names a locale `i18n.locales` does not list.") {
    ErrorShell("I04", title: "A locale the project does not have", severity: "error", family: "Translations", summary: "`setLocale(\"xx\")` names a locale `i18n.locales` does not list.", printed: #""#, quickfix: "", lowerable: true, why: true, example: false, families: ERROR_INDEX, related: [], sections: [Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/I04.md") {
        fixed {
            Stack(gap: .sm) {
                Markdown("add the\nlocale and its file, or name one that exists.")
            }
        }
        Markdown("`setLocale(\"fr\")` when `i18n.locales` is `[\"en\", \"ar\"]`.")
    }
}

page ErrorI05(path: "/errors/I05", title: "I05 — Words a reader sees that are not translated", description: "Under `i18n.literals`, text that splices more than a name, or a value shown by a name that does not say it is words, is never looked up: every reader…") {
    ErrorShell("I05", title: "Words a reader sees that are not translated", severity: "warning", family: "Translations", summary: "Under `i18n.literals`, text that splices more than a name, or a value shown by a name that does not say it is words, is never looked up: every reader sees it as written.", printed: #""#, quickfix: "", lowerable: true, why: true, example: false, families: ERROR_INDEX, related: [], sections: [Anchor(id: "fix", label: t("error.fix")), Anchor(id: "why", label: t("error.why"))], source: "md-docs/errors/I05.md") {
        fixed {
            Stack(gap: .sm) {
                Markdown("splice names, `derived filesText = \"\{n\} files\"`\nthen `Text(\"\{filesText\} found\")`, and name what is words as words.")
            }
        }
        Markdown("Warning, under `\"literals\": true`. `Text(\"\{plural(n, \"file\")\} found\")`\nsplices a call, so no table can key it; `derived said = \"\{n\} errors\"`\nshown as `Text(said)` is not looked up, because only a value whose name\nsays it is words (`saidText`, `errorsLabel`) is. A reader in Arabic sees\nboth in English.")
    }
}

page ErrorA01(path: "/errors/A01", title: "A01 — An image with no alt text", description: "An `Image` with no `alt`. A screen reader reads the file name; a decorative image takes `alt: \"\"`.") {
    ErrorShell("A01", title: "An image with no alt text", severity: "warning", family: "Accessibility", summary: "An `Image` with no `alt`. A screen reader reads the file name; a decorative image takes `alt: \"\"`.", printed: #"warning[A01]: Image missing "alt" attribute
 --> src/App.wf:3:5
  |
3 |     Image(src: "/team.jpg")
  |     ^^^^^
  = help: Add alt text: Image(src: "...", alt: "Description of image")
  = docs: https://webfluent.monzeromer.dev/errors/A01"#, quickfix: "Add `alt: \"\"` — then describe the image, or leave it empty if it is decorative", lowerable: true, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/A01.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Photo").h1
    Image(src: "/team.jpg")
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Photo").h1
    Image(src: "/team.jpg", alt: "The team at the launch")
}"#, title: "wf") }
        note {
            Markdown("`Image(src: \"/team.jpg\", alt: \"The team at the launch\")`. A purely decorative image takes `alt: \"\"`.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

