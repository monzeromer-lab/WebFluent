  = docs: https://webfluent.monzeromer.dev/errors/V08"#, quickfix: "Change to `lock`", lowerable: true, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/V08.md") {
