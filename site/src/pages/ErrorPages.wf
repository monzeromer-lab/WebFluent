page ErrorA10(path: "/errors/A10", title: "A10 — A table with no header row", description: "A `Table` with no `Table.Head`.") {
    ErrorShell("A10", title: "A table with no header row", severity: "warning", family: "Accessibility", summary: "A `Table` with no `Table.Head`.", printed: #"warning[A10]: Table has no header row (`Table.Head`)
 --> src/App.wf:3:5
  |
3 |     Table(caption: "Prices") { Table.Body { Table.Row { Table.Cell("Pen")  Table.Cell("2") } } }
  |     ^^^^^
  = help: Add one: `Table { Table.Head { Table.Row { Table.Cell("Name") } } … }`
  = docs: https://webfluent.monzeromer.dev/errors/A10"#, quickfix: "", lowerable: true, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/A10.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Table").h1
    Table(caption: "Prices") { Table.Body { Table.Row { Table.Cell("Pen")  Table.Cell("2") } } }
}"#, title: "wf") }
        fixed { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    Heading("Table").h1
    Table(caption: "Prices") {
        Table.Head { Table.Row { Table.Cell("Item")  Table.Cell("Price") } }
        Table.Body { Table.Row { Table.Cell("Pen")  Table.Cell("2") } }
    }
}"#, title: "wf") }
        note {
            Markdown("Put the first row in `Table.Head`, so its cells are `<th scope=\"col\">`.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorA11(path: "/errors/A11", title: "A11 — A skipped heading level", description: "A heading level skipped — `h2` straight to `h4`.") {
    ErrorShell("A11", title: "A skipped heading level", severity: "warning", family: "Accessibility", summary: "A heading level skipped — `h2` straight to `h4`.", printed: #"warning[A11]: Heading level skips from h1 to h4
 --> src/App.wf:3:5
  |
3 |     Heading("Deep").h4
  |     ^^^^^^^
  = help: Use h2 instead, or add the missing intermediate headings
  = docs: https://webfluent.monzeromer.dev/errors/A11"#, quickfix: "Change to `.h2`", lowerable: true, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/A11.md") {
