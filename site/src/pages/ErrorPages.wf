        }
    }
}

page ErrorT14(path: "/errors/T14", title: "T14 — A comparison that is always the same", description: "`==` or `!=` between values that can never be equal — a string and a number, a record and a string, an enum and a case it does not have — so the…") {
    ErrorShell("T14", title: "A comparison that is always the same", severity: "error", family: "Types", summary: "`==` or `!=` between values that can never be equal — a string and a number, a record and a string, an enum and a case it does not have — so the answer never changes.", printed: #"error[T14]: `count` is `Number` and `"0"` is `String`, which are never equal, so this is always false
 --> src/App.wf:4:8
  |
4 |     if count == "0" { Text("Nothing yet") }
  |        ^^^^^
  = help: Convert one side: `Number(text) == n`, or `"{n}" == text`
  = docs: https://webfluent.monzeromer.dev/errors/T14"#, quickfix: "", lowerable: false, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/T14.md") {
        broken { CodeBlock(#"page P(path: "/", title: "T", description: "D") {
    state count = 0
    Heading("Count").h1
