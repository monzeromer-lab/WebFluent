page ErrorP01(path: "/errors/P01", title: "P01 — A persisted value with no way forward", description: "A `persist` at `version: n` with nothing to bring an older version forward, so what a returning reader had is discarded.") {
    ErrorShell("P01", title: "A persisted value with no way forward", severity: "warning", family: "What is kept in the browser", summary: "A `persist` at `version: n` with nothing to bring an older version forward, so what a returning reader had is discarded.", printed: #"warning[P01]: `items` is at version 2, and nothing brings version 1 forward
 --> src/App.wf:2:5
  |
2 |     persist items: [String] = [] {
  |     ^^^^^^^
  = help: A reader who last visited then loses what they had. Add `migrate 1 -> 2`
  = docs: https://webfluent.monzeromer.dev/errors/P01"#, quickfix: "Add `migrate 1 -> 2`", lowerable: true, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/P01.md") {
        broken { CodeBlock(#"store Cart {
    persist items: [String] = [] {
        version: 2
    }
}"#, title: "wf") }
        fixed { CodeBlock(#"store Cart {
    persist items: [String] = [] {
        version: 2
        migrate 1 -> 2 { old }
    }
}
page P(path: "/", title: "T", description: "D") {
    use Cart
    Heading("{Cart.items.length} items").h1
}"#, title: "wf") }
        note {
            Markdown("Add a step for each older version: `migrate 1 -> 2 \{ old.map(…) \}`.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorP02(path: "/errors/P02", title: "P02 — A migration that never runs", description: "A `migrate` step above the declared `version:`.") {
    ErrorShell("P02", title: "A migration that never runs", severity: "warning", family: "What is kept in the browser", summary: "A `migrate` step above the declared `version:`.", printed: #"warning[P02]: `migrate 1 -> 2` on `items` is past the declared version
 --> src/App.wf:2:5
  |
2 |     persist items: [String] = [] {
  |     ^^^^^^^
  = help: A step above `version:` never runs; raise the version or drop the step
  = docs: https://webfluent.monzeromer.dev/errors/P02"#, quickfix: "", lowerable: true, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/P02.md") {
        broken { CodeBlock(#"store Cart {
    persist items: [String] = [] {
        version: 1
        migrate 1 -> 2 { old }
    }
}"#, title: "wf") }
        fixed { CodeBlock(#"store Cart {
    persist items: [String] = [] {
        version: 2
        migrate 1 -> 2 { old }
    }
}
page P(path: "/", title: "T", description: "D") {
    use Cart
    Heading("{Cart.items.length} items").h1
}"#, title: "wf") }
        note {
            Markdown("Raise `version:` to the step's target, or drop the step.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

page ErrorP03(path: "/errors/P03", title: "P03 — A persisted value in a route-scoped store", description: "The route change drops the store, and the next read builds it again from storage, so the value comes straight back.") {
    ErrorShell("P03", title: "A persisted value in a route-scoped store", severity: "warning", family: "What is kept in the browser", summary: "The route change drops the store, and the next read builds it again from storage, so the value comes straight back.", printed: #"warning[P03]: `search` is persisted in a store scoped to the route
 --> src/App.wf:2:5
  |
2 |     persist search = ""
  |     ^^^^^^^
  = help: The route change drops the store and the next read builds it again from storage, so the value comes straight back. Use `state` for what the route owns, or widen the scope for what outlives it
  = docs: https://webfluent.monzeromer.dev/errors/P03"#, quickfix: "", lowerable: true, why: false, example: true, families: ERROR_INDEX, related: [], sections: [Anchor(id: "printed", label: t("error.printed")), Anchor(id: "fix", label: t("error.fix"))], source: "md-docs/errors/P03.md") {
        broken { CodeBlock(#"store Filters(scope: .route) {
    persist search = ""
}"#, title: "wf") }
        fixed { CodeBlock(#"store Filters(scope: .route) {
    state search = ""
}
page P(path: "/", title: "T", description: "D") {
    use Filters
    Heading("Search").h1
    Input(bind: Filters.search, label: "Search")
}"#, title: "wf") }
        note {
            Markdown("Keep route-scoped data in `state`, or move the value to a store with a wider scope.")
            Markdown("Each example is a whole program: it is all of `src/App.wf` in a project with no other `.wf` file ([trying an example](/errors#trying-an-example)).") { style { font-size: 14px; color: $muted } }
        }
    }
}

