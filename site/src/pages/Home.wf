/// The front page. In the order a visitor's questions come: what is it and
/// how do I start (the hero, with the install line); does it work (three
/// commands to a running site); why this and not what I have (a real
/// mistake and the message the compiler really prints for it); how does it
/// think (five ideas); what does it do for me (batteries, outputs); and
/// where do I go next (the documentation's doors, then one call to action).
page Home(path: "/", title: "WebFluent — websites, PDFs and slide decks from one language", description: "A typed language and one binary that build a static site, a single-page app, a PDF or a slide deck. No Node, no bundler, no config.") {
    state copied = false
    action copyInstall() {
        copied = true
        try { navigator.clipboard.writeText(INSTALL) } catch e { log(e) }
        setTimeout(() => uncopy(), 1600)
    }
    action uncopy() { copied = false }

    SiteHeader

    // ------------------------------------------------------------------ hero
    Row(gap: .xl, align: .start, id: "top", class: "landing-section") {
        style {
            flex-direction: column
            gap: 32px
            flex-wrap: nowrap
            max-width: 1280px
            margin: 0 auto
            padding: 40px 16px 32px
            border-bottom: 1px solid $color-border
            @md { padding: 64px 24px 56px }
            @media (min-width: 960px) { flex-direction: row; gap: 48px; padding: 96px 40px 80px }
        }

        Stack(gap: .lg) {
            style { gap: 24px; width: 100%; max-width: 100%; flex-shrink: 0; @media (min-width: 960px) { width: 560px } }

            Text(t("hero.eyebrow"), class: "overline accent")
            Heading(t("hero.title")).h1 {
                style { margin: 0; font-size: 40px; line-height: 44px; font-weight: 800; letter-spacing: -0.02em; @md { font-size: 56px; line-height: 58px; letter-spacing: -0.022em } }
            }
            Text(t("hero.sub")) { style { margin: 0; max-width: 520px; font-size: 17px; line-height: 26px; color: $color-text-muted } }

            Row(align: .center, gap: .sm, class: "install-line", dir: "ltr") {
                style {
                    gap: 12px
                    flex-wrap: nowrap
                    height: 44px
                    padding: 0 12px
                    max-width: 520px
                    background: $term-bg
                    border: 1px solid $color-border
                    border-radius: 6px
                    & p { margin: 0 }
                    @md { height: 46px; padding: 0 14px }
                }
                Text("$") { style { font-family: $font-family-mono; font-size: 13px; line-height: 20px; color: $term-dim } }
                Text(INSTALL) { style { flex-grow: 1; min-width: 0; font-family: $font-family-mono; font-size: 13px; line-height: 20px; color: $term-ink; white-space: nowrap; overflow: hidden; text-overflow: ellipsis } }
                Button(if copied { t("code.copied") } else { t("code.copy") }, aria-label: t("hero.copy"), data-track: "copy_install", data-track-method: "curl") {
                    style {
                        height: 28px
                        padding: 0 10px
                        background: transparent
                        border: 1px solid $term-dim
                        border-radius: 4px
                        color: $term-ink
                        font-family: inherit
                        font-size: 12px
                        line-height: 18px
                        font-weight: 400
                        &:hover { background: transparent; border-color: $term-ink }
                    }
                    on click { copyInstall() }
                }
            }

            Row(align: .center, gap: .sm) {
                style { flex-direction: column; align-items: stretch; gap: 8px; flex-wrap: wrap; @sm { flex-direction: row; align-items: center } }
                Link(t("hero.cta"), to: "/docs/guide/getting-started", class: "site-button site-button-primary", data-track: "select_content", data-track-content-type: "cta", data-track-item-id: "start_guide")
                Link(t("hero.docs"), to: "/docs", class: "site-button site-button-outlined")
            }

            Row(align: .center, gap: .md) {
                style { display: none; gap: 12px; padding-top: 8px; flex-wrap: nowrap; & p { margin: 0; font-size: 13px; line-height: 20px; color: $ink-subtle } @media (min-width: 400px) { display: flex } @md { gap: 20px } }
                Text(t("hero.platforms"))
                Divider { style { width: 1px; height: 14px; margin: 0; border: 0; background: $color-border } }
                Text(t("hero.nodeps"))
            }
        }

        // A whole page that builds clean as shown: a type, state, a keyed
        // list, a bound field and a handler.
        Stack(class: "hero-editor", dir: "ltr") {
            style {
                gap: 0
                flex: none
                min-width: 0
                width: 100%
                border: 1px solid $color-border
                border-radius: 10px
                overflow: hidden
                background: $term-bg
                box-shadow: $shadow-md
                @media (min-width: 960px) { flex: 1 1 0 }
            }
            Row(align: .center, justify: .between) {
                style { flex-wrap: nowrap; height: 36px; padding: 0 12px; background: $color-surface; border-bottom: 1px solid $color-border; & p { margin: 0 } }
                Text("src/pages/Home.wf") { style { font-family: $font-family-mono; font-size: 12px; line-height: 18px; color: $color-text } }
                Text(t("hero.serve")) { style { display: none; font-size: 12px; line-height: 18px; color: $ink-subtle; @media (min-width: 480px) { display: block } } }
            }
            Code(#"type Book { title: String, author: String }

page Home(path: "/", title: "Reading list", description: "Books worth reading.") {
    state books = [Book(title: "Kindred", author: "Octavia E. Butler")]
    state draft = ""

    Heading("Reading list").h1
    for book in books by book.title {
        Text("{book.title} — {book.author}")
    }
    Input(bind: draft, label: "Add a title")
    Button("Add").primary {
        on click { books = books.concat([Book(title: draft, author: "Unknown")])  draft = "" }
    }
}"#, language: "wf").block {
                style { margin: 0; padding: 14px; background: $term-bg; color: $syntax-punct; font-size: 12px; line-height: 20px; white-space: pre; overflow-x: auto; border-radius: 0; @md { font-size: 13px; line-height: 22px; padding: 20px } }
            }
            Stack(gap: .xs) {
                style { gap: 6px; padding: 14px 20px; border-top: 1px solid $color-border; background: $term-bg; & p { margin: 0; font-family: $font-family-mono; font-size: 12px; line-height: 18px } }
                Text(t("hero.build")) { style { color: $syntax-string } }
                Text(t("hero.watch")) { style { color: $term-dim } }
            }
        }
    }

    // ------------------------------------------------------------ quick start
    Row(gap: .xl, align: .start, id: "start", class: "landing-section") {
        style { flex-direction: column; gap: 24px; flex-wrap: nowrap; max-width: 1280px; margin: 0 auto; padding: 32px 16px; border-bottom: 1px solid $color-border; @md { padding: 64px 24px } @media (min-width: 960px) { flex-direction: row; gap: 48px } @lg { padding: 80px 40px } }
        Stack(gap: .md) {
            style { gap: 16px; width: 100%; max-width: 100%; flex-shrink: 0; @media (min-width: 960px) { width: 440px } }
            Text(t("start.eyebrow"), class: "overline")
            Heading(t("start.title")).h2 { style { margin: 0; font-size: 26px; line-height: 32px; font-weight: 700; letter-spacing: -0.016em; @md { font-size: 34px; line-height: 38px } } }
            Markdown(t("start.body")) { style { & p { margin: 0; font-size: 15px; line-height: 23px; color: $color-text-muted } } }
            Link("{t("start.link")} →", to: "/docs/guide/getting-started") {
                style { align-self: flex-start; font-size: 14px; line-height: 20px; font-weight: 600; color: $brand-ink; text-decoration: none; &:hover { text-decoration: underline } }
            }
        }
        Stack(gap: .sm) {
            style { flex: none; min-width: 0; width: 100%; gap: 12px; @media (min-width: 960px) { flex: 1 1 0 } }
            Terminal(lines: [
                Line(command: "wf init hello -t static"),
                Line(command: "cd hello"),
                Line(command: "wf serve", output: "Starting dev server at http://localhost:3000/")
            ])
            Markdown(t("start.steps")) { style { & ol { margin: 0; padding-inline-start: 1.3em } & li { font-size: 14px; line-height: 22px; color: $color-text-muted } & li + li { margin-top: 6px } } }
        }
    }

    // ------------------------------------------------------------ the checker
    // Shown rather than told: a real mistake, and the message `wf check`
    // really prints for it.
    Row(gap: .xl, align: .start, id: "checked", class: "landing-section") {
        style { flex-direction: column; gap: 24px; flex-wrap: nowrap; max-width: 1280px; margin: 0 auto; padding: 32px 16px; border-bottom: 1px solid $color-border; @md { padding: 64px 24px } @media (min-width: 960px) { flex-direction: row; gap: 48px } @lg { padding: 80px 40px } }
        Stack(gap: .md) {
            style { gap: 16px; width: 100%; max-width: 100%; flex-shrink: 0; @media (min-width: 960px) { width: 440px } }
            Text(t("check.eyebrow"), class: "overline")
            Heading(t("check.title")).h2 { style { margin: 0; font-size: 26px; line-height: 32px; font-weight: 700; letter-spacing: -0.016em; @md { font-size: 34px; line-height: 38px } } }
            Markdown(t("check.body")) { style { & p { margin: 0; font-size: 15px; line-height: 23px; color: $color-text-muted } } }
            Stack(gap: .xs) {
                style { gap: 10px; padding-top: 4px; & .wf-row { flex-wrap: nowrap; gap: 10px } & .dot { width: 6px; height: 6px; margin: 0; border: 0; border-radius: 50%; background: $color-success; flex-shrink: 0 } & p { margin: 0; font-size: 13px; line-height: 20px; color: $color-text-muted } }
                Row(align: .center) { Divider(class: "dot")  Text(t("check.point1")) }
                Row(align: .center) { Divider(class: "dot")  Text(t("check.point2")) }
                Row(align: .center) { Divider(class: "dot")  Text(t("check.point3")) }
            }
            Link("{t("check.link")} →", to: "/errors") {
                style { align-self: flex-start; font-size: 14px; line-height: 20px; font-weight: 600; color: $brand-ink; text-decoration: none; &:hover { text-decoration: underline } }
            }
        }
        Stack(gap: .sm) {
            style { flex: none; min-width: 0; width: 100%; gap: 12px; @media (min-width: 960px) { flex: 1 1 0 } }
            CodeBlock(#"    for book in books { Text(book.titel) }"#, title: "wf", note: t("check.typo"))
            CodeBlock(#"error[T05]: `Book` has no field `titel`
 --> src/App.wf:6:35
  |
6 |     for book in books { Text(book.titel) }
  |                                   ^^^^^
  = help: Did you mean `title`? Its fields are `title`, `author`
  = docs: https://webfluent.monzeromer.dev/errors/T05

error: the build stopped: 1 error"#, title: "wf check")
        }
    }

    // ---------------------------------------------------------------- studio
    // The app made for writing WebFluent, shown as it looks.
    Row(gap: .xl, align: .start, id: "studio", class: "landing-section") {
        style { flex-direction: column; gap: 24px; flex-wrap: nowrap; max-width: 1280px; margin: 0 auto; padding: 32px 16px; border-bottom: 1px solid $color-border; @md { padding: 64px 24px } @media (min-width: 960px) { flex-direction: row; gap: 48px } @lg { padding: 80px 40px } }
        Stack(gap: .md) {
            style { gap: 16px; width: 100%; max-width: 100%; flex-shrink: 0; @media (min-width: 960px) { width: 440px } }
            Text(t("studio.eyebrow"), class: "overline")
            Heading(t("studio.title")).h2 { style { margin: 0; font-size: 26px; line-height: 32px; font-weight: 700; letter-spacing: -0.016em; @md { font-size: 34px; line-height: 38px } } }
            Markdown(t("studio.body")) { style { & p { margin: 0; font-size: 15px; line-height: 23px; color: $color-text-muted } } }
            Stack(gap: .xs) {
                style { gap: 10px; padding-top: 4px; & .wf-row { flex-wrap: nowrap; gap: 10px } & .dot { width: 6px; height: 6px; margin: 0; border: 0; border-radius: 50%; background: $color-success; flex-shrink: 0 } & p { margin: 0; font-size: 13px; line-height: 20px; color: $color-text-muted } }
                Row(align: .center) { Divider(class: "dot")  Markdown(t("studio.point1")) }
                Row(align: .center) { Divider(class: "dot")  Markdown(t("studio.point2")) }
                Row(align: .center) { Divider(class: "dot")  Markdown(t("studio.point3")) }
            }
            Markdown(t("studio.note")) { style { & p { margin: 0; font-size: 13px; line-height: 20px; color: $ink-subtle } } }
            Link("{t("studio.link")} →", href: STUDIO) {
                style { align-self: flex-start; font-size: 14px; line-height: 20px; font-weight: 600; color: $brand-ink; text-decoration: none; &:hover { text-decoration: underline } }
            }
        }
        Stack(gap: .sm) {
            style { flex: none; min-width: 0; width: 100%; @media (min-width: 960px) { flex: 1 1 0 } }
            Image(src: "/studio/design.png", alt: t("studio.alt"), width: 1440, height: 900) {
                style { display: block; width: 100%; height: auto; border: 1px solid $color-border; border-radius: 10px; box-shadow: $shadow-md }
            }
        }
    }

    // ------------------------------------------------------------ five ideas
    Stack(gap: .lg, id: "how", class: "landing-section") {
        style { gap: 16px; max-width: 1280px; margin: 0 auto; padding: 32px 16px; border-bottom: 1px solid $color-border; @md { padding: 64px 24px; gap: 24px } @lg { padding: 80px 40px; gap: 32px } }
        Stack(gap: .xs) {
            style { gap: 10px }
            Text(t("ideas.eyebrow"), class: "overline")
            Heading(t("ideas.title")).h2 { style { margin: 0; font-size: 26px; line-height: 32px; font-weight: 700; letter-spacing: -0.016em; @md { font-size: 34px; line-height: 38px } } }
        }
        Grid(columns: { base: 1, sm: 2, lg: 3 }, gap: .lg, class: "ideas-grid") {
            style { gap: 16px; @md { gap: 24px } }
            IdeaCard(t("idea.1.title"), number: "01", body: t("idea.1.body"), link: t("idea.more"), linkTo: "/docs/guide/language-basics")
            IdeaCard(t("idea.2.title"), number: "02", body: t("idea.2.body"), code: #"Button("Save").primary.lg { on click { save() } }"#, link: t("idea.more"), linkTo: "/docs/guide/elements")
            IdeaCard(t("idea.3.title"), number: "03", body: t("idea.3.body"), link: t("idea.more"), linkTo: "/docs/guide/state")
            IdeaCard(t("idea.4.title"), number: "04", body: t("idea.4.body"), link: t("idea.more"), linkTo: "/docs/guide/styling")
            IdeaCard(t("idea.5.title"), number: "05", body: t("idea.5.body"), link: t("idea.more"), linkTo: "/docs/guide/static-and-spa")
            IdeaCard(t("ideas.react.title"), body: t("ideas.react.body"), link: t("ideas.react.link"), linkTo: "/docs/guide/coming-from", highlight: true)
        }
    }

    // ------------------------------------------------------------ batteries
    Stack(gap: .lg, class: "landing-section") {
        style { gap: 16px; max-width: 1280px; margin: 0 auto; padding: 32px 16px; border-bottom: 1px solid $color-border; @md { padding: 64px 24px; gap: 24px } @lg { padding: 80px 40px; gap: 32px } }
        Stack(gap: .xs) {
            style { gap: 10px }
            Text(t("batteries.eyebrow"), class: "overline")
            Heading(t("batteries.title")).h2 { style { margin: 0; font-size: 26px; line-height: 32px; font-weight: 700; letter-spacing: -0.016em; @md { font-size: 34px; line-height: 38px } } }
        }
        Grid(columns: { base: 1, sm: 2, lg: 4 }, gap: .lg, class: "ideas-grid") {
            style { gap: 16px; @md { gap: 24px } }
            IdeaCard(t("bat.api.title"), body: t("bat.api.body"), link: t("bat.more"), linkTo: "/docs/guide/data")
            IdeaCard(t("bat.forms.title"), body: t("bat.forms.body"), link: t("bat.more"), linkTo: "/docs/guide/forms")
            IdeaCard(t("bat.realtime.title"), body: t("bat.realtime.body"), link: t("bat.more"), linkTo: "/docs/guide/realtime")
            IdeaCard(t("bat.offline.title"), body: t("bat.offline.body"), link: t("bat.more"), linkTo: "/docs/guide/offline")
            IdeaCard(t("bat.i18n.title"), body: t("bat.i18n.body"), link: t("bat.more"), linkTo: "/docs/guide/i18n")
            IdeaCard(t("bat.tests.title"), body: t("bat.tests.body"), link: t("bat.more"), linkTo: "/docs/guide/testing")
            IdeaCard(t("bat.security.title"), body: t("bat.security.body"), link: t("bat.more"), linkTo: "/docs/guide/security")
            IdeaCard(t("bat.js.title"), body: t("bat.js.body"), link: t("bat.more"), linkTo: "/docs/guide/interop")
        }
    }

    // --------------------------------------------------------------- outputs
    Stack(gap: .lg, id: "outputs", class: "landing-section") {
        style { gap: 16px; max-width: 1280px; margin: 0 auto; padding: 32px 16px; border-bottom: 1px solid $color-border; @md { padding: 64px 24px; gap: 24px } @lg { padding: 80px 40px; gap: 28px } }
        Row(align: .end, justify: .between, gap: .lg) {
            style { gap: 24px; flex-wrap: wrap }
            Stack(gap: .xs) {
                style { gap: 10px }
                Text(t("outputs.eyebrow"), class: "overline")
                Heading(t("outputs.title")).h2 { style { margin: 0; font-size: 26px; line-height: 32px; font-weight: 700; letter-spacing: -0.016em; @md { font-size: 34px; line-height: 38px } } }
            }
            Markdown(t("outputs.lede")) { style { max-width: 420px; & p { margin: 0; font-size: 15px; line-height: 23px; color: $color-text-muted } } }
        }
        Grid(columns: { base: 1, sm: 2, lg: 4 }, gap: .lg, class: "outputs-grid") {
            style { gap: 12px; @md { gap: 24px } }
            OutputCard(t("output.static.title"), value: "\"static\"", body: t("output.static.body"))
            OutputCard(t("output.spa.title"), value: "\"spa\"", body: t("output.spa.body"))
            OutputCard(t("output.pdf.title"), value: "\"pdf\"", body: t("output.pdf.body"))
            OutputCard(t("output.slides.title"), value: "\"slides\"", body: t("output.slides.body"))
        }
        Link("{t("outputs.see")} →", to: "/showcase") {
            style { align-self: flex-start; display: inline-flex; align-items: center; min-height: 32px; font-size: 14px; line-height: 20px; font-weight: 600; color: $brand-ink; text-decoration: none; &:hover { text-decoration: underline } }
        }
    }

    // ----------------------------------------------------------------- video
    Stack(gap: .lg, id: "video", class: "landing-section") {
        style { gap: 16px; max-width: 1280px; margin: 0 auto; padding: 32px 16px; border-bottom: 1px solid $color-border; @md { padding: 64px 24px; gap: 24px } @lg { padding: 80px 40px; gap: 32px } }
        Stack(gap: .xs) {
            style { gap: 10px }
            Text(t("video.eyebrow"), class: "overline")
            Heading(t("video.title")).h2 { style { margin: 0; font-size: 26px; line-height: 32px; font-weight: 700; letter-spacing: -0.016em; @md { font-size: 34px; line-height: 38px } } }
        }
        Host(tag: "div", mount: (n) => embedYouTube(n, "C98BsTefhws", t("video.frame"))) {
            style { width: 100%; max-width: 960px; aspect-ratio: 16 / 9; border: 1px solid $color-border; border-radius: 10px; overflow: hidden; background: $term-bg; box-shadow: $shadow-md; & iframe { display: block; width: 100%; height: 100%; border: 0 } }
        }
    }

    // ------------------------------------------------------- the four doors
    Stack(gap: .lg, id: "docs", class: "landing-section") {
        style { gap: 16px; max-width: 1280px; margin: 0 auto; padding: 32px 16px; border-bottom: 1px solid $color-border; @md { padding: 64px 24px; gap: 24px } @lg { padding: 80px 40px; gap: 32px } }
        Stack(gap: .xs) {
            style { gap: 10px }
            Text(t("paths.eyebrow"), class: "overline")
            Heading(t("paths.title")).h2 { style { margin: 0; font-size: 26px; line-height: 32px; font-weight: 700; letter-spacing: -0.016em; @md { font-size: 34px; line-height: 38px } } }
        }
        Grid(columns: { base: 1, sm: 2, lg: 4 }, gap: .lg, class: "ideas-grid") {
            style { gap: 16px; @md { gap: 24px } }
            IdeaCard(t("paths.learn.title"), body: t("paths.learn.body"), link: t("paths.learn.link"), linkTo: "/docs/guide/tutorial")
            IdeaCard(t("paths.concepts.title"), body: t("paths.concepts.body"), link: t("paths.concepts.link"), linkTo: "/docs/guide/language-basics")
            IdeaCard(t("paths.guides.title"), body: t("paths.guides.body"), link: t("paths.guides.link"), linkTo: "/docs")
            IdeaCard(t("paths.reference.title"), body: t("paths.reference.body"), link: t("paths.reference.link"), linkTo: "/docs/reference")
        }
    }

    // ---------------------------------------------------------- call to action
    Stack(id: "install", class: "landing-cta") {
        style { background: $color-surface; border-bottom: 1px solid $color-border }
        Row(align: .center, justify: .between, gap: .xl) {
            style { gap: 16px; flex-wrap: wrap; max-width: 1280px; margin: 0 auto; padding: 32px 16px; @md { padding: 48px 24px; gap: 32px } @lg { padding: 64px 40px; gap: 48px } }
            Stack(gap: .xs) {
                style { gap: 10px; max-width: 560px; min-width: 0 }
                Heading(t("cta.title")).h2 { style { margin: 0; font-size: 22px; line-height: 28px; font-weight: 700; letter-spacing: -0.016em; @md { font-size: 34px; line-height: 38px } } }
                Markdown(t("cta.body")) { style { & p { margin: 0; font-size: 15px; line-height: 23px; color: $color-text-muted } } }
            }
            Row(align: .center, gap: .sm) {
                style { flex-direction: column; align-items: stretch; gap: 8px; @sm { flex-direction: row; align-items: center } }
                Link(t("cta.primary"), to: "/docs/guide/tutorial", class: "site-button site-button-primary", data-track: "select_content", data-track-content-type: "cta", data-track-item-id: "tutorial")
                Link(t("hero.docs"), to: "/docs", class: "site-button site-button-outlined")
            }
        }
    }
}
