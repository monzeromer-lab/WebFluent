/// One entry of a page's "on this page" rail: the id of a heading, and its label.
type Anchor {
    id: String,
    label: String
}

/// One command of a shell transcript: the line typed, and what came back.
type Line {
    command: String,
    output: String = ""
}

/// One row of the guide's search index: a chapter, or a section of one.
type SearchRow {
    chapter: String,
    title: String,
    section: String,
    route: String,
    kind: String = "",
    also: String = "",
    words: String = ""
}

/// Where the source lives. Used by the nav, the footer and every "edit this page" link.
const REPO = "https://github.com/monzeromer-lab/WebFluent"
/// WebFluent Studio, the app made for writing WebFluent: on the home page and in the footer.
const STUDIO = "https://github.com/monzeromer-lab/webfluent-studio"

/// The release the site documents, on the header's pill.
const VERSION = "7.0"

/// The release the compiler in the page is: `scripts/site-wasm.sh` ships it
/// under `/wasm/<release>/`, and the live examples load it from there.
const WF_RELEASE = "7.0.1"

/// Where that compiler lives.
const WASM = "/wasm/" + WF_RELEASE + "/"

/// The one-line install, shown in the hero and on chapter 1.
const INSTALL = "curl -sSL https://raw.githubusercontent.com/monzeromer-lab/WebFluent/master/install.sh | bash"

/// Every chapter, section, component and diagnostic of the guide, for the
/// header's search: `public/search-index.json`, fetched the first time the
/// search box is used rather than carried by every page.
const SEARCH_INDEX = "/search-index.json"

/// One example in the gallery: what `wf build` wrote from a folder under
/// `examples/`, with its first two pages as pictures. Written by
/// scripts/showcase.py.
type Example {
    slug: String,
    title: String,
    description: String = "",
    kind: String,
    lang: String = "en",
    pages: Number,
    bytes: Number,
    size: String,
    file: String,
    previews: [String],
    width: Number,
    height: Number,
    source: String
}

/// The gallery's examples, rendered on each release by scripts/showcase.py:
/// the files sit in `public/showcase/`, this list says what each one is.
data showcase: [Example] = "showcase.json"

/// One row of a props table: a name, its type or cases, and one line of meaning.
type PropsRow {
    name: String,
    type: String,
    meaning: String,
    default: String = ""
}

/// One control of a Stage: a prop's name, its kind (`enum`, `bool`), the
/// cases an enum offers, the value it shows, and the prop a press sets.
type StageControlSpec {
    name: String,
    kind: String,
    options: [String] = [],
    value: String = "",
    sink: String = ""
}

/// One test of the Playground's project, and whether it passed.
type TestOutcome {
    name: String,
    passed: Bool
}
