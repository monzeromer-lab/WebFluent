/// One entry of a page's "on this page" rail: the id of a heading, and its label.
type Anchor {
    id: String,
    label: String
}

/// One command of a shell transcript: the line typed, and what came back.
type Line {
    command: String,
    output: String = ""
}

/// One row of the guide's search index: a chapter, or a section of one.
type SearchRow {
    chapter: String,
    title: String,
    section: String,
    route: String,
    kind: String = "",
    also: String = "",
    words: String = ""
}

/// Where the source lives. Used by the nav, the footer and every "edit this page" link.
const REPO = "https://github.com/monzeromer-lab/WebFluent"
/// WebFluent Studio, the app made for writing WebFluent: on the home page and in the footer.
const STUDIO = "https://github.com/monzeromer-lab/webfluent-studio"

/// The release the site documents, on the header's pill.
const VERSION = "8.0"

/// The release the compiler in the page is: `scripts/site-wasm.sh` ships it
/// under `/wasm/<release>/`, and the live examples load it from there.
const WF_RELEASE = "8.0.0"

/// Where that compiler lives.
const WASM = "/wasm/" + WF_RELEASE + "/"

/// The one-line install, shown in the hero and on chapter 1.
const INSTALL = "curl -sSL https://raw.githubusercontent.com/monzeromer-lab/WebFluent/master/install.sh | bash"

/// Every chapter, section, component and diagnostic of the guide, for the
/// header's search: `public/search-index.json`, fetched the first time the
/// search box is used rather than carried by every page.
const SEARCH_INDEX = "/search-index.json"

/// One example in the gallery: what `wf build` wrote from a folder under
/// `examples/`, with its first two pages as pictures. Written by
/// scripts/showcase.py.
type Example {
    slug: String,
    title: String,
    description: String = "",
    kind: String,
    lang: String = "en",
    pages: Number,
    bytes: Number,
    size: String,
    file: String,
    previews: [String],
    width: Number,
    height: Number,
    source: String
}

/// The gallery's examples, rendered on each release by scripts/showcase.py:
/// the files sit in `public/showcase/`, this list says what each one is.
data showcase: [Example] = "showcase.json"

/// One row of a props table: a name, its type or cases, and one line of meaning.
type PropsRow {
    name: String,
    type: String,
    meaning: String,
    default: String = ""
}

/// One control of a Stage: a prop's name, its kind (`enum`, `bool`), the
/// cases an enum offers, the value it shows, and the prop a press sets.
type StageControlSpec {
    name: String,
    kind: String,
    options: [String] = [],
    value: String = "",
    sink: String = ""
}

/// One test of the Playground's project, and whether it passed.
type TestOutcome {
    name: String,
    passed: Bool
}

/// One measure of a benchmark: a translation key that names it, then a cell
/// for each column, and which cells win the row.
type BenchRow {
    key: String,
    cells: [String],
    best: [Bool] = []
}

/// One benchmark's table: the tools across the top, WebFluent's column at
/// `ours`, a row a measure. Every number is formatted by bench/report.mjs.
type BenchTable {
    columns: [String],
    ours: Number = 0,
    rows: [BenchRow]
}

/// One bar of the agents chart: a framework, its share of the longest bar
/// (in percent) and the tokens it took, as shown.
type BenchBar {
    label: String,
    share: Number,
    shown: String,
    ours: Bool = false
}

/// One framework's agent runs, the median of each measure, as shown.
type BenchAgent {
    label: String,
    ours: Bool = false,
    tokens: String,
    cost: String,
    wall: String,
    turns: String,
    loc: String,
    passed: String
}

/// How one framework provides one item, by its own docs: `default` (with
/// nothing done), `setting` (one setting), `api` (a built-in feature written
/// on each page), `official` (an official package) or `manual` (by hand, or a
/// third-party package); what the developer does, and the page that says so.
type BenchCap {
    level: String,
    how: String,
    source: String
}

/// One item of the capability table: a translation key, a cell a framework.
type BenchCapRow {
    key: String,
    cells: [BenchCap]
}

/// What each framework provides with no third-party package.
type BenchCapabilities {
    columns: [String],
    ours: Number = 0,
    rows: [BenchCapRow],
    counts: [Number],
    checked: String
}

/// The figures the summaries quote.
type BenchHeadline {
    lighthouse: String,
    defaults: String,
    defaultsUntouched: String,
    defaultsBest: String,
    build: String,
    buildOthers: String,
    nodeModulesOthers: String,
    runtime: String,
    pdf: String,
    agentTokens: String,
    agentTokensOthers: String
}

type BenchDefaultsMeta { measuredAt: String, runs: Number, chrome: String }
type BenchToolchainMeta { measuredAt: String, runs: Number, machine: String, versions: String, binary: String }
type BenchAgentsMeta { model: String, effort: String, claudeCode: String, runs: Number, lawsonRuns: Number, ratio: String }

/// Every benchmark, as bench/report.mjs gathered it from the raw results.
type Benchmarks {
    generatedAt: String,
    headline: BenchHeadline,
    capabilities: BenchCapabilities,
    lighthouse: BenchTable,
    defaultsMeta: BenchDefaultsMeta,
    toolchain: BenchTable,
    toolchainMeta: BenchToolchainMeta,
    runtime: BenchTable,
    pdf: BenchTable,
    agents: [BenchBar],
    agentsTable: [BenchAgent],
    agentsMeta: BenchAgentsMeta
}

/// The benchmarks page's numbers: `node bench/report.mjs` writes the file.
data benchmarks: Benchmarks = "benchmarks.json"

/// Where each benchmark's harness and raw results live.
const BENCH_SOURCE = REPO + "/tree/master/bench"
