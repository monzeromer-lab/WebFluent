/// One entry of a page's "on this page" rail: the id of a heading, and its label.
type Anchor {
    id: String,
    label: String
}

/// One command of a shell transcript: the line typed, and what came back.
type Line {
    command: String,
    output: String = ""
}

/// One row of the guide's search index: a chapter, or a section of one.
type SearchRow {
    chapter: String,
    title: String,
    section: String,
    route: String,
    words: String = ""
}

/// Where the source lives. Used by the nav, the footer and every "edit this page" link.
const REPO = "https://github.com/monzeromer-lab/WebFluent"

/// The release the site documents, on the header's pill.
const VERSION = "5.3"

/// The one-line install, shown in the hero and on chapter 1.
const INSTALL = "curl -sSL https://raw.githubusercontent.com/monzeromer-lab/WebFluent/master/install.sh | bash"

/// The components reference, written from `wf registry --json` by
/// scripts/site-data.py: the groups, every built-in with its props, flags,
/// parts and events, and what every element takes.
data registry: Map = "registry.json"

/// Every chapter, section, component and diagnostic of the guide, for the
/// header's search: `public/search-index.json`, fetched the first time the
/// search box is used rather than carried by every page.
const SEARCH_INDEX = "/search-index.json"

/// One example in the gallery: what `wf build` wrote from a folder under
/// `examples/`, with its first two pages as pictures. Written by
/// scripts/showcase.py.
type Example {
    slug: String,
    title: String,
    description: String = "",
    kind: String,
    lang: String = "en",
    pages: Number,
    bytes: Number,
    size: String,
    file: String,
    previews: [String],
    width: Number,
    height: Number,
    source: String
}

/// The gallery's examples, rendered on each release by scripts/showcase.py:
/// the files sit in `public/showcase/`, this list says what each one is.
data showcase: [Example] = "showcase.json"
