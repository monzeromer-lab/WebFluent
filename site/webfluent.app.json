{
  "name": "WebFluent",
  "version": "4.0.0",
  "author": "Monzer Omer",
  "theme": {
    "name": "Day",
    "dark": "Night",
    "builtin": "full"
  },
  "build": {
    "output": "../docs",
    "ssg": true,
    "split": true,
    "minify": true,
    "compress": true,
    "csp": true,
    "base_path": "/WebFluent",
    "output_type": "spa"
  },
  "dev": {
    "port": 4000,
    "hot_reload": true
  },
  "meta": {
    "title": "WebFluent — a language for websites",
    "description": "A file describes what a page shows — its elements, the state behind them, what happens when the reader acts. The compiler turns it into a static site, a single-page app, a PDF or a slide deck.",
    "lang": "en",
    "site_url": "https://monzeromer-lab.github.io/WebFluent",
    "site_name": "WebFluent",
    "sitemap": true,
    "fonts": [
      "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    ]
  },
  "i18n": {
    "default_locale": "en",
    "locales": [
      "en",
      "ar"
    ],
    "dir": "src/translations"
  }
}
