{
  "name": "WebFluent",
  "version": "5.3.5",
  "author": "Monzer Omer",
  "theme": {
    "name": "Day",
    "dark": "Night",
    "builtin": "full"
  },
  "build": {
    "output": "../docs",
    "ssg": true,
    "split": true,
    "minify": true,
    "compress": true,
    "csp": true,
    "base_path": "",
    "clean_urls": "file",
    "output_type": "spa"
  },
  "dev": {
    "port": 4000,
    "hot_reload": true
  },
  "meta": {
    "title": "WebFluent — websites, PDFs and slides from one language",
    "description": "One language, one binary: a static site, a single-page app, a PDF or a slide deck from the same file. No Node, and no browser for your PDFs.",
    "lang": "en",
    "favicon": "/favicon.svg",
    "touch_icon": "/apple-touch-icon.png",
    "image": "/og.png",
    "site_url": "https://webfluent.monzeromer.dev",
    "site_name": "WebFluent",
    "sitemap": true,
    "preload": [
      "/fonts/inter-latin.woff2",
      "/fonts/jetbrains-mono-latin.woff2"
    ],
    "scripts": [
      {
        "src": "https://www.googletagmanager.com/gtag/js?id=G-HPDHSJ9S4G",
        "load": "after"
      }
    ],
    "connect": [
      "https://*.google-analytics.com",
      "https://*.analytics.google.com",
      "https://www.googletagmanager.com"
    ],
    "img": [
      "https://*.google-analytics.com",
      "https://www.googletagmanager.com"
    ],
    "frame": [
      "https://www.youtube-nocookie.com"
    ]
  },
  "i18n": {
    "default_locale": "en",
    "locales": [
      "en",
      "ar"
    ],
    "dir": "src/translations"
  },
  "lints": {
    "D05": "off"
  }
}
