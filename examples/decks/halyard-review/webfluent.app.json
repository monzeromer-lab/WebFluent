{
  "name": "halyard-review",
  "version": "1.0.0",
  "theme": { "name": "FluantInk", "builtin": "structural" },
  "build": {
    "output": "./build",
    "output_type": "slides",
    "slides": {
      "size": "16:9",
      "margin": 0,
      "default_font": "Manrope",
      "default_font_size": 16,
      "output_filename": "halyard-q3-review.pdf",
      "fonts": ["../../documents/fonts"],
      "system_fonts": false
    }
  },
  "meta": { "lang": "en" }
}
