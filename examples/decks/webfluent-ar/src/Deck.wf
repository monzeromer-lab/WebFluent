        }

        // 12 · المخرجات
        Slide {
            Head("اختر المُخرَج بسطر إعداد واحد.", over: "build.output_type")
            Grid(class: "outputs") {
                Stack(class: "card output") {
                    Stack(class: "output__icon") { Icon("home") }
                    Heading("موقع ثابت").h3
                    Text("كل صفحة مُصيَّرة مسبقاً ثم تُحيا. خريطة موقع ورابط قانوني و Open Graph.")
                    Text("\"ssg\": true", class: "chip")
                }
                Stack(class: "card output") {
                    Stack(class: "output__icon") { Icon("arrow-left") }
                    Heading("تطبيق صفحة واحدة").h3
                    Text("جزء لكل صفحة يُحمَّل حين يظهر مساره، وعامل خدمة عند الطلب.")
                    Text("\"spa\"", class: "chip")
                }
                Stack(class: "card output paper") {
                    Stack(class: "output__icon") { Icon("download") }
                    Heading("PDF").h3
                    Text("أنماط الصفحة نفسها مرصوفة على الورق: ترويسات متكررة وفهرس ورسوم بيانية.")
                    Text("\"pdf\"", class: "chip")
                }
                Stack(class: "card output paper") {
                    Stack(class: "output__icon") { Icon("eye") }
                    Heading("عرض شرائح").h3
                    Text("شريحة لكل صفحة، من المكوّنات والبيانات — مثل هذا العرض.")
                    Text("\"slides\"", class: "chip")
                }
                Stack(class: "card output") {
                    Stack(class: "output__icon") { Icon("link") }
                    Heading("عناصر مخصّصة").h3
                    Text("المكوّنات وسوماً تضعها في React أو Vue أو Rails أو صفحة عادية.")
                    Text("\"elements\"", class: "chip")
                }
            }
            Row(class: "config-strip") {
                Console(CONFIG, title: "webfluent.app.json", small: true)
                Text("البرنامج لا يتغير. ما لا يقدر عليه إلا المتصفح — زر أو معالج حدث أو مسار — يُرفض في الـ PDF حيث كُتب، ولا يقترح المحرّر إلا ما يرسمه المُخرَج.", class: "config-strip__note")
            }
            Chrome("ما بعد الشاشة", n: 12)
        }

        // 13 · الورق
        Slide {
            Head("الورق، دون تشغيل أي متصفح.", over: "PDF", lede: "محرّك الصفحات الخاص بالمُترجِم يرصف HTML الصفحة و CSS الخاص بها — التتالي، و flex و grid، والعربية المتصلة، والجداول التي تكرّر ترويستها. لا شيء لتثبيته، ولا شيء لتشغيله.")
            Row(class: "paper-row") {
                Stack(class: "sheet") {
                    Image(src: "/report-1.png", alt: "غلاف تقرير منصة Halyard")
                    Text("غلاف تقرير — توهّج شعاعي وبطاقات أرقام", class: "sheet__cap")
                }
                Stack(class: "sheet") {
                    Image(src: "/report-3.png", alt: "رسوم بيانية وجدول للمناطق")
                    Text("رسوم بيانية متجاورة، وجدول بقدر محتواه", class: "sheet__cap")
                }
                Stack(class: "sheet") {
                    Image(src: "/report-5.png", alt: "جدول عمليات نشر يمتد على عدة صفحات")
                    Text("64 صفاً، والترويسة في كل صفحة", class: "sheet__cap")
                }
                Stack(class: "sheet") {
                    Image(src: "/invoice-1.png", alt: "فاتورة عليها علامة مائية")
                    Text("فاتورة: شريط وعلامة مائية ومجاميع لا تنقسم", class: "sheet__cap")
                }
                Stack(class: "sheet") {
                    Image(src: "/resume-1.png", alt: "سيرة ذاتية عربية من اليمين إلى اليسار")
                    Text("العربية من اليمين إلى اليسار، بالمحرّك نفسه", class: "sheet__cap")
                }
            }
            Chrome("ما بعد الشاشة", n: 13)
        }

        // 14 · هذا العرض
        Slide {
            Head("هذا العرض ملف WebFluent.", over: "الشرائح")
            Row(class: "meta") {
                Stack(class: "meta__code") {
                    Console(SOURCE, title: "examples/decks/webfluent-ar/src/Deck.wf", small: true)
                }
                Stack(class: "meta__side") {
                    Text("كل شريحة هنا مكوّن — افتتاحية، وعنوان، وإطار طرفية — يُكتب مرة ويوضع ست عشرة مرة. وحلقة for تصنع صفاً، أو شريحة، من كل عنصر في قائمة.", class: "muted")
                    Text("وهو العرض الإنجليزي نفسه بالتصميم نفسه، من اليمين إلى اليسار. الخطوط ملفات بجانبه، و wf build يكتب الـ PDF، ولا شيء غيره يعمل.", class: "muted")
                    QrCode("https://github.com/monzeromer-lab/WebFluent/tree/master/examples/decks", color: "#17191C", class: "qr")
                    Text("مصدر كل العروض", class: "overline")
                }
            }
            Chrome("ما بعد الشاشة", n: 14)
        }

        // 15 · التحدي
        Slide {
            Head("جرّبه على صفحة بنيتها من قبل.", over: "التحدي", lede: "أعد بناءها بـ WebFluent، ثم قِس الفرق بنفسك — كل رقم في هذه الشرائح على بُعد أمر واحد.")
            Stack(class: "grammar") {
                Row(class: "grammar__row head") {
                    Text("شغّل", class: "grammar__form")
                    Text("ما ستراه", class: "grammar__means")
                }
                for c in CHALLENGE {
                    Row(class: "grammar__row") {
                        Text(c.form, class: "grammar__form")
                        Markdown(c.means, class: "grammar__means")
                    }
                }
            }
            Chrome("دورك", n: 15)
        }

        // 16 · ابدأ
        Slide(class: "closing") {
            Stack {
                Text("دورك", class: "overline")
                Heading("ابنِ تخطيطاً.", class: "closing__title").h1
                Text("وانظر كم يصبح أنظف.", class: "closing__title closing__accent")
            }
            Row(class: "closing__row") {
                Stack(class: "closing__steps") {
                    Row(class: "closing__cmd") { Text("$")  Text("curl -sSL …/install.sh | bash") }
                    Row(class: "closing__cmd") { Text("$")  Text("wf init my-site --template static") }
                    Row(class: "closing__cmd") { Text("$")  Text("wf serve") }
                }
                Stack {
                    QrCode(SITE, color: "#17191C", class: "qr")
                    Text("monzeromer-lab.github.io/WebFluent", class: "closing__link")
                }
            }
        }
    }
}
