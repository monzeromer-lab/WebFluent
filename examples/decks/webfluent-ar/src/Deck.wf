// ── الفصل الثالث · ما بعد الشاشة ─────────────────────────────

const THREE = #"component Point(_ title: String, body: String) {
    Card { Heading(title).h3  Text(body) }
}
page Site(path: "/", title: "Talk") {
    Container { for p in POINTS { Point(p.title, body: p.body) } }
}
page Handout(path: "/handout", title: "Handout") {
    Document(size: "A4") {
        Footer { Text("Page {page} of {pages}") }
        for p in POINTS { Point(p.title, body: p.body) }
    }
}
page Talk(path: "/talk", title: "Talk") {
    Presentation {
        for p in POINTS { Slide { Point(p.title, body: p.body) } }
    }
}"#

const CONFIG = #"{ "build": { "output_type": "slides",
             "slides": { "size": "16:9" } } }"#

const SOURCE = #"component Opener(_ title: String, num: String, line: String) {
    Slide(class: "section") {
        Text(num, class: "section__num")
        Text(title, class: "section__title")
        Text(line, class: "section__line")
    }
}

page Deck(path: "/", title: "إعادة التفكير في تخطيط الويب") {
    Presentation {
        Opener("طريقة جديدة", num: "01",
               line: "اكتبه مرة، ثم ترجمه.")
        Slide {
            Head("سبعة أشكال.", over: "صياغة موحّدة")
            for g in GRAMMAR { Row { Text(g.form)  Markdown(g.means) } }
        }
    }
}"#

// ── الفصل الرابع · الدعوة ────────────────────────────────────

const CHALLENGE = [
    { form: "wf init try-it -t static", means: "**ابدأ** — أمر واحد ومجلد واحد، ولا شيء لتثبيته بعد الملف التنفيذي" },
    { form: "src/pages/Home.wf", means: "**أعد بناء صفحة لديك** — التخطيط والحالة والأنماط في ملف واحد" },
    { form: "wf serve", means: "**راقبه** — الحفظ يعيد البناء والتحميل، والخطأ يُرسم فوق الصفحة" },
    { form: "wf check", means: "**عُدّ ما التقطه** — كل ملاحظة برمزها ومكانها وإصلاحها" },
    { form: "wf build --stats", means: "**زِنه** — كل ملف مضغوطاً، وكل وحدة تشغيل شُحنت" },
    { form: "wf verify", means: "**وقّته** — كل مسار يُحمَّل في متصفح حقيقي: الأخطاء والرسم والبايتات" },
]

page Deck(path: "/", title: "إعادة التفكير في تخطيط الويب", description: "لماذا يجب أن يُكتب مشروعك القادم بلغة مُترجَمة — WebFluent في ست عشرة شريحة، مكتوبة بـ WebFluent.") {
    Presentation {

        // 1 · الغلاف
        Slide(class: "cover") {
            Row(class: "cover__grid") {
                Stack(class: "cover__copy") {
                    Row(class: "cover__brand") {
                        Image(src: "/mark.svg", alt: "")
                        Text("WebFluent")
                    }
                    Text("محاضرة لكل من يبني للويب", class: "overline")
                    Heading("إعادة التفكير في تخطيط الويب.", class: "cover__title").h1
                    Text("لماذا يجب أن يُكتب مشروعك القادم بلغة مُترجَمة: صياغة واحدة للنصوص والصناديق والوسائط والحالة والأنماط — ومُترجِم يتولّى العمل الثقيل قبل أن تصل الصفحة إلى أي متصفح.", class: "cover__lede")
                }
                Stack(class: "cover__side") {
                    Stack(class: "console") {
                        Row(class: "console__bar") {
                            Row(class: "console__dots") { Text("")  Text("")  Text("") }
                            Text("terminal", class: "console__title")
                        }
                        Stack(class: "term-body") {
                            Text("$ wf init hello --template static", class: "term-line")
                            Text("  Created hello/ with AGENTS.md", class: "term-line dim")
                            Text("$ wf build", class: "term-line")
                            Text("  3 pages, 0 errors, 0 warnings", class: "term-line ok")
                            Text("$ wf build -d report", class: "term-line")
                            Text("  PDF: 9 page(s)", class: "term-line kw")
                            Text("$ wf build -d deck", class: "term-line")
                            Text("  Slides: 16 slide(s)", class: "term-line kw")
                        }
                    }
                    Row(class: "chips") {
                        Text("صياغة واحدة", class: "chip brand")
                        Text("أداة واحدة", class: "chip brand")
                        Text("الويب", class: "chip")
                        Text("PDF", class: "chip accent")
                        Text("شرائح", class: "chip accent")
                    }
