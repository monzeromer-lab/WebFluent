    { job: "تقليم", what: "ورقة أنماط واحدة: المكوّنات والرموز التي يستخدمها الموقع فقط" },
    { job: "اقتطاع", what: "من 37 وحدة في بيئة التشغيل، لا يُشحن إلا ما يصل إليه البرنامج" },
    { job: "تحجيم", what: "كل صورة بكل عرض، مع أبعادها، فلا يتزحزح شيء أثناء التحميل" },
    { job: "تدقيق", what: "الأنواع والخصائص والمسارات والترجمات وإمكانية الوصول — في كل بناء" },
    { job: "تأمين", what: "سياسة أمان محتوى (CSP) يُلزم البناء مخرجاته بها" },
    { job: "فهرسة", what: "خريطة الموقع والروابط القانونية و Open Graph و JSON-LD لكل صفحة" },
    { job: "ضغط", what: "ملف `.gz` بجانب كل ملف نصي، جاهز ليقدّمه المضيف" },
]

