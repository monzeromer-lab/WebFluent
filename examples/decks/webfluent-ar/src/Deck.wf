const COUNTER = #"page Home(path: "/", title: "الرئيسية") {
    state count = 0
    derived doubled = count * 2

    Container {
        Heading("أهلاً").h1
        Text("العدد: {count} · ضعفه {doubled}")
        Button("+1").primary {
            on click { count = count + 1 }
        }
    }
}"#

const GRAMMAR = [
    { form: "page · component · store", means: "**تصريح** — كلمة مفتاحية بأحرف صغيرة تسمّي ما يُصنع" },
    { form: "Row · Card · Image", means: "**عنصر** — نص أو صندوق أو وسائط، يبدأ بحرف كبير، من سجل واحد" },
    { form: ".primary  .lg  .h1", means: "**علَم** — خاصية منطقية، أو حالة واحدة من خاصية تعدادية" },
    { form: "gap: .md", means: "**خاصية** — تُمرَّر بالاسم، وقد تتقدّمها قيمة موضعية واحدة" },
    { form: "Card { … }", means: "**كتلة** — أبناء العنصر: التخطيط هو التداخل" },
    { form: "on click { … }", means: "**معالج حدث** — ما يحدث حين يتفاعل القارئ" },
    { form: "style { padding: $md }", means: "**CSS خام** — مع رموز التصميم وقيم حيّة `\{values\}`" },
]

