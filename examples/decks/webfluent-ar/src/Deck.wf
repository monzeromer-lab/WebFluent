            Head("ستة ملفات قبل أول صندوق.", over: "العقبة")
            Row(class: "panes") {
                Stack(class: "pane") {
                    style { flex: 1.2 1 0 }
                    Stack(class: "console big") {
                        Row(class: "console__bar") {
                            Row(class: "console__dots") { Text("")  Text("")  Text("") }
                            Text("مشروع جديد، اليوم", class: "console__title")
                        }
                        Stack(class: "term-body") {
                            for s in SETUP {
                                Text(s.line, class: ["term-line", if s.kind != "" { s.kind }])
                            }
                        }
                    }
                }
                Stack(class: "pane facts") {
                    Fact("01", claim: "الإعداد قبل المحتوى", note: "مُجمِّع، وخط لمعالجة الـ CSS، ومدقّق أنواع، ومدقّق شيفرة — كلٌّ يريد ملفه قبل أن يُرسم أي شيء.")
                    Fact("02", claim: "اعتماديات لم يخترها أحد", note: "تثبيت واحد يجلب شجرة من الحزم عليك أن تدقّقها وتحدّثها وتحميها من الانكسار.")
                    Fact("03", claim: "أدوات لا يرى بعضها بعضاً", note: "مدقّق الأنواع لا يقرأ الـ CSS، ومدقّق الشيفرة لا يقرأ المسارات — فيكتشف المتصفح الأخطاء.")
