                Stack(class: "number") {
                    Text("0.24 s", class: "number__n")
                    Text("هذا العرض: ست عشرة شريحة وخمس صور ورمزا QR", class: "number__what")
                }
            }
            Grid(class: "numbers small") {
                Stack(class: "number") {
                    Text("1", class: "number__n")
                    Text("ملف تنفيذي: مُترجِم وخادم ومنسّق واختبارات", class: "number__what")
                }
                Stack(class: "number") {
                    Text("0", class: "number__n")
                    Text("مجلد node_modules أو إعدادات مُجمِّع أو إضافات", class: "number__what")
                }
                Stack(class: "number") {
                    Text("3.7 kB", class: "number__n")
                    Text("حجم app.js مضغوطاً لصفحة نص ثابت", class: "number__what")
                }
                Stack(class: "number") {
                    Text("0", class: "number__n")
                    Text("متصفح بلا واجهة يُشغَّل لصنع ملف PDF", class: "number__what")
                }
            }
            Chrome("الطريقة", n: 8)
        }

        // 9 · التشخيص
        Slide {
            Head("الخطأ يتوقف عند المُترجِم، لا في بيئة الإنتاج.", over: "مُدقَّق")
            Row(class: "panes") {
                Stack(class: "pane") {
                    style { flex: 1.4 1 0 }
                    Stack(class: "console big") {
                        Row(class: "console__bar") {
                            Row(class: "console__dots") { Text("")  Text("")  Text("") }
                            Text("wf check", class: "console__title")
                        }
                        Code(ERROR).block { style { color: #E6E9EC } }
                    }
                }
                Stack(class: "pane facts") {
                    Fact("116", claim: "رمز تشخيص في سجل واحد", note: "البناء والمحرّر و wf explain والدليل كلها تقرأ القائمة نفسها.")
                    Fact("fix", claim: "إصلاح حيث يُعرف الإصلاح", note: "أقرب اسم صحيح، أو الخصائص الناقصة — ويطبّقه المحرّر.")
                    Fact("1×", claim: "كل خطأ، مرة واحدة", note: "يُقرأ كل ملف حتى لو تعذّر تحليل ملف آخر.")
                }
            }
            Chrome("الطريقة", n: 9)
