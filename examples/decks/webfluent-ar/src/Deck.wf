        // 10 · لحظة الإدراك
        Opener("ما بعد الشاشة", num: "02", line: "التخطيط نفسه يُترجَم إلى مستند PDF وعرض شرائح — يرصفه المُترجِم بنفسه، دون تشغيل متصفح بلا واجهة.")

        // 11 · مكوّن واحد، ثلاثة أسطح
        Slide {
            Head("مكوّن واحد. ثلاثة أسطح.", over: "منطق التخطيط نفسه")
