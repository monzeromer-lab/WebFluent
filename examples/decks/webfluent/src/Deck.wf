// WebFluent, in sixteen slides — written in WebFluent, in the docs site's
// design system. `wf build` here writes build/webfluent-5.2.pdf.

const TOTAL = 16
const SITE = "https://monzeromer-lab.github.io/WebFluent/"

/// What every content slide carries along its foot.
component Chrome(_ section: String, n: Number) {
    Row(class: "chrome") {
        Row(class: "chrome__brand") {
            Image(src: "/mark.svg", alt: "")
            Text("WebFluent")
            Text("· {section}", class: "muted")
        }
        Text("{n} / {TOTAL}", class: "chrome__page")
    }
}

/// A slide's heading: the overline that says where we are, then the claim.
component Head(_ title: String, over: String, lede: String = "") {
    Text(over, class: "overline accent")
    Heading(title, class: "title").h2
    if lede != "" {
        Text(lede, class: "lede")
    }
}

/// A console frame around a block of code, as the guide draws one.
component Console(_ code: String, title: String = "wf", small: Bool = false) {
    Stack(class: ["console", if small { "small" }]) {
        Row(class: "console__bar") {
            Row(class: "console__dots") { Text("")  Text("")  Text("") }
            Text(title, class: "console__title")
        }
        Code(code, language: "wf").block
    }
}

/// A section opener: the brand fill, a numeral and the line under it.
component Opener(_ title: String, num: String, line: String) {
    Slide(class: "section") {
        Text(num, class: "section__num")
        Text(title, class: "section__title")
        Text(line, class: "section__line")
        Stack(class: "section__rule") { }
    }
}

const COUNTER = #"page Home(path: "/", title: "Home") {
    state count = 0
    derived doubled = count * 2

    Container {
        Heading("Welcome").h1
        Text("Count: {count} · doubled {doubled}")
        Button("+1").primary {
            on click { count = count + 1 }
        }
    }
}"#

const GRAMMAR = [
    { form: "page · component · store", means: "**A declaration** — a lowercase keyword names what is being made" },
    { form: "Button · Card · Table", means: "**An element** — capitalised, drawn from one registry" },
    { form: ".primary  .lg  .h1", means: "**A flag** — a boolean prop, or one case of an enum prop" },
    { form: "label: \"Name\"", means: "**A prop** — passed by name; one positional may lead" },
    { form: "Card { … }", means: "**A block** — the element's children" },
    { form: "on click { … }", means: "**A handler** — what happens when the reader acts" },
    { form: "style { padding: $md }", means: "**Raw CSS** — with design tokens and live `\{values\}`" },
]

const TYPES = [
    { name: "Date", lit: "@2026-03-14", can: ".plus(days: 3)" },
    { name: "Time", lit: "@09:30", can: ".plus(minutes: 30)" },
    { name: "DateTime", lit: "@2026-03-14T09:30Z", can: ".inZone(\"Europe/Berlin\")" },
    { name: "Duration", lit: "90.minutes", can: ".hours()" },
    { name: "Money", lit: "€12.99", can: ".convert(rate, \"USD\")" },
    { name: "Url", lit: "\"https://…\"", can: ".with(query: …)" },
    { name: "Email", lit: "\"ada@example.com\"", can: ".domain()" },
    { name: "Color", lit: "#0F766E", can: ".mix(other, 0.2)" },
    { name: "Uuid", lit: "uuid()", can: "a string's methods" },
    { name: "File", lit: "FileUpload", can: ".preview()" },
    { name: "Number(1..=30)", lit: "state nights = 12", can: "a condition, checked" },
]

const ERROR = #"error[T05]: `User` has no field `nmae`
 --> src/pages/Profile.wf:3:18
  |
3 |     Heading(user.nmae).h1
  |                  ^^^^
  = help: Its fields are `id`, `name`
  = fix:  nmae → name"#

// gzipped app.js, measured: the runtime only holds what a program reaches.
const WEIGHT = [
    { step: "Static text", kb: 4.6 },
    { step: "+ a keyed list", kb: 8.4 },
    { step: "+ two routes", kb: 10.4 },
    { step: "+ a typed fetch", kb: 15.2 },
]

const CONFIG = #"{ "build": { "output_type": "slides",
             "slides": { "size": "16:9" } } }"#

const TOOLS = [
    { cmd: "wf check", what: "Every finding, with a code, a place and a fix; nothing written" },
    { cmd: "wf test", what: "`test \"…\" { }` blocks — snapshots, and clicks in a real Chrome" },
    { cmd: "wf verify", what: "Every route loaded in a headless browser: errors, paint, bytes" },
    { cmd: "wf audit", what: "What the project trusts: markup, origins, storage, env" },
    { cmd: "wf fmt", what: "One layout for every file — `.wf` braces or `.wfx` indents" },
    { cmd: "wf docs", what: "A gallery of every built-in and the project's own components" },
    { cmd: "wf serve", what: "Rebuild on save; a failed build drawn over the page" },
    { cmd: "wf-lsp", what: "Completion, hover, rename, quick fixes — for this output" },
]

const SOURCE = #"component Opener(_ title: String, num: String, line: String) {
    Slide(class: "section") {
        Text(num, class: "section__num")
        Text(title, class: "section__title")
        Text(line, class: "section__line")
    }
}

page Deck(path: "/", title: "WebFluent") {
    Presentation {
        Opener("The language", num: "01",
               line: "One lexeme, one meaning.")
        for t in TOPICS { Topic(t) }
    }
}"#

page Deck(path: "/", title: "WebFluent — a language for websites", description: "WebFluent 5.2 in sixteen slides, written in WebFluent.") {
    Presentation {

        // 1 · The cover
        Slide(class: "cover") {
            Row(class: "cover__grid") {
                Stack(class: "cover__copy") {
                    Row(class: "cover__brand") {
                        Image(src: "/mark.svg", alt: "")
                        Text("WebFluent")
                    }
                    Text("Version 5.2 · October 2026", class: "overline")
                    Heading("A language for websites — and the paper they print on.", class: "cover__title").h1
                    Text("A file describes what a page shows: its elements, the state behind them, what happens when the reader acts. The compiler turns it into a static site, an app, a PDF or a deck.", class: "cover__lede")
                }
                Stack(class: "cover__side") {
                    Stack(class: "console") {
                        Row(class: "console__bar") {
                            Row(class: "console__dots") { Text("")  Text("")  Text("") }
                            Text("terminal", class: "console__title")
                        }
                        Stack(class: "term-body") {
                            Text("$ wf init hello --template spa", class: "term-line")
                            Text("  Created hello/ with AGENTS.md", class: "term-line dim")
                            Text("$ wf build", class: "term-line")
                            Text("  Building hello…", class: "term-line dim")
                            Text("  app.js     4.6 kB gzipped", class: "term-line dim")
                            Text("  0 errors, 0 warnings", class: "term-line ok")
                            Text("$ wf build -d deck", class: "term-line")
                            Text("  Slides: 16 slide(s)", class: "term-line kw")
                        }
                    }
                    Row(class: "chips") {
                        Text("static site", class: "chip brand")
                        Text("SPA", class: "chip brand")
                        Text("PDF", class: "chip accent")
                        Text("slides", class: "chip accent")
                        Text("custom elements", class: "chip")
                    }
                }
            }
            Row(class: "cover__foot") {
                Text("monzeromer-lab.github.io/WebFluent")
                Text("This deck is a .wf file", class: "mono")
            }
        }

        // 2 · What you write, what the reader gets
        Slide {
            Head("One file is the page.", over: "The idea")
            Row(class: "panes") {
                Stack(class: "pane") {
                    Row(class: "pane__label") {
                        Text("What you write", class: "overline")
                        Text("Home.wf", class: "pill")
                    }
                    Console(COUNTER, title: "src/pages/Home.wf")
                }
                Stack(class: "pane") {
                    Row(class: "pane__label") {
                        Text("What the reader gets", class: "overline")
                        Text("index.html · app.js", class: "pill")
                    }
                    Stack(class: "browser") {
                        Row(class: "browser__bar") {
                            Row(class: "console__dots") { Text("")  Text("")  Text("") }
                            Text("localhost:3000/", class: "browser__url")
                        }
                        Stack(class: "browser__page") {
                            Heading("Welcome").h2
                            Text("Count: 3 · doubled 6", class: "muted")
                            Row(class: "counter") {
                                Text("3", class: "counter__n")
                                Text("+1", class: "button")
                            }
                            Text("The text repaints when the state changes — no virtual DOM, no hooks, no build config.", class: "muted")
                        }
                    }
                }
            }
            Chrome("The idea", n: 2)
        }

        // 3 · The language
        Opener("The language", num: "01", line: "Declarations are lowercase, elements capitalised, and anything that resolves to nothing is an error — never a silent no-op.")

        // 4 · One lexeme, one meaning
        Slide {
            Head("One lexeme, one meaning.", over: "Grammar", lede: "Seven shapes cover everything a page says. The compiler, the linters and the editor read one registry of what each element takes.")
            Stack(class: "grammar") {
                Row(class: "grammar__row head") {
                    Text("Written", class: "grammar__form")
                    Text("What it is", class: "grammar__means")
                }
                for g in GRAMMAR {
                    Row(class: "grammar__row") {
                        Text(g.form, class: "grammar__form")
                        Markdown(g.means, class: "grammar__means")
                    }
                }
            }
            Chrome("The language", n: 4)
        }

        // 5 · Reactivity
        Slide {
            Head("State is the only thing that moves.", over: "Reactivity", lede: "What reads a state repaints when it changes. A derived value follows the values it reads; an effect runs when they do.")
            Row(class: "flow") {
                Stack(class: "card flow__node") {
                    Text("state", class: "node__kind")
                    Text("count = 3", class: "node__code")
                    Text("A signal. Assigning it is the only way anything changes.", class: "node__note")
                }
                Text("→", class: "flow__arrow")
                Stack(class: "card flow__node") {
                    Text("derived", class: "node__kind")
                    Text("doubled = count * 2", class: "node__code")
                    Text("Recomputed when count changes, and never otherwise.", class: "node__note")
                }
                Text("→", class: "flow__arrow")
                Stack(class: "card flow__node") {
                    Text("element", class: "node__kind")
                    Text("Text(\"\{doubled\}\")", class: "node__code")
                    Text("One text node, updated in place. Nothing else is touched.", class: "node__note")
                }
            }
            Row(class: "chips") {
                style { margin-top: 32px }
                Text("persist theme = \"light\"", class: "chip")
                Text("every(1000) { … }", class: "chip")
                Text("resource users: [User] = fetch(…)", class: "chip")
                Text("socket chat = ws(…)", class: "chip")
            }
            Chrome("The language", n: 5)
        }

        // 6 · Types
        Slide {
            Head("The types a page needs, built in.", over: "Types", lede: "Each is a plain JSON value at run time, so it crosses a fetch, storage and the static paint unchanged.")
            Grid(class: "types") {
                for t in TYPES {
                    Stack(class: "type") {
                        Text(t.name, class: "type__name")
                        Text(t.lit, class: "type__lit")
                        Text(t.can, class: "type__can")
                    }
                }
                Stack(class: "type secret") {
                    Text("Secret", class: "type__name")
                    Text("T12 if it escapes", class: "type__lit")
                    Text("never shown, logged or kept", class: "type__can")
                }
            }
            Chrome("The language", n: 6)
        }

        // 7 · Diagnostics
        Slide {
            Head("A mistake is found where it is written.", over: "Diagnostics")
            Row(class: "panes") {
                Stack(class: "pane") {
                    style { flex: 1.4 1 0 }
                    Stack(class: "console big") {
                        Row(class: "console__bar") {
                            Row(class: "console__dots") { Text("")  Text("")  Text("") }
                            Text("wf check", class: "console__title")
                        }
                        Code(ERROR).block { style { color: #E6E9EC } }
                    }
                }
                Stack(class: "pane facts") {
                    Row(class: "fact") {
                        Text("116", class: "fact__dot") { style { width: 44px } }
                        Stack(class: "fact__text") {
                            Text("codes, one registry")
                            Text("The build, the editor, wf explain and the guide read the same list.")
                        }
                    }
                    Row(class: "fact") {
                        Text("fix", class: "fact__dot") { style { width: 44px } }
                        Stack(class: "fact__text") {
                            Text("A fix where one is known")
                            Text("The nearest name, a ?., the missing props — applied by the editor.")
                        }
                    }
                    Row(class: "fact") {
                        Text("1×", class: "fact__dot") { style { width: 44px } }
                        Stack(class: "fact__text") {
                            Text("Every mistake, once")
                            Text("Every file is read even when another does not parse.")
                        }
                    }
                }
            }
            Chrome("The language", n: 7)
        }

        // 8 · What it builds
        Opener("What it builds", num: "02", line: "One program; five outputs. The same elements are a page in a browser and a page on paper.")

        // 9 · Outputs
        Slide {
            Head("Pick the output in one line of config.", over: "build.output_type")
            Grid(class: "outputs") {
                Stack(class: "card output") {
                    Stack(class: "output__icon") { Icon("home") }
                    Heading("Static site").h3
                    Text("Every page pre-rendered, then hydrated. Sitemap, canonical, Open Graph.")
                    Text("\"ssg\": true", class: "chip")
                }
                Stack(class: "card output") {
                    Stack(class: "output__icon") { Icon("arrow-right") }
                    Heading("Single-page app").h3
                    Text("A page per chunk, loaded when its route shows; a service worker on request.")
                    Text("\"spa\"", class: "chip")
                }
                Stack(class: "card output paper") {
                    Stack(class: "output__icon") { Icon("download") }
                    Heading("PDF").h3
                    Text("The page's own CSS, laid out on paper: running headers, contents, charts.")
                    Text("\"pdf\"", class: "chip")
                }
                Stack(class: "card output paper") {
                    Stack(class: "output__icon") { Icon("eye") }
                    Heading("Slide deck").h3
                    Text("A slide to a page, from components and data — like this one.")
                    Text("\"slides\"", class: "chip")
                }
                Stack(class: "card output") {
                    Stack(class: "output__icon") { Icon("link") }
                    Heading("Custom elements").h3
                    Text("Components as tags for React, Vue, Rails or a plain page.")
                    Text("\"elements\"", class: "chip")
                }
            }
            Row(class: "config-strip") {
                Console(CONFIG, title: "webfluent.app.json", small: true)
                Text("The program does not change. A PDF is refused what only a browser can do — a button, a handler, a route — where it is written, and the editor offers only what the output draws.", class: "config-strip__note")
            }
            Chrome("What it builds", n: 9)
        }

        // 10 · What it weighs
        Slide {
            Head("The runtime holds only what a program reaches.", over: "What it weighs")
            Row(class: "weigh") {
                Stack(class: "weigh__chart card") {
                    Text("app.js, gzipped (kB)", class: "overline")
                    Chart(kind: .bar, data: WEIGHT, x: "step", y: "kb", colors: ["#2B5178"], labels: true, grid: "#E2E5E8", ink: "#5A5F64", width: 560, height: 300)
                }
                Stack(class: "weigh__side") {
                    for w in WEIGHT {
                        Row(class: "step") {
                            Text(w.step, class: "step__what")
                            Text("{w.kb} kB", class: "step__kb")
                        }
                    }
                    Text("Measured on four programs built with wf build. A for brings the keyed-list module, a second page the router, a resource the network engine.", class: "muted") {
                        style { font-size: 14px; line-height: 21px; margin-top: 6px }
                    }
                }
            }
            Chrome("What it builds", n: 10)
        }

        // 11 · Paper
        Slide {
            Head("The same CSS, on paper.", over: "PDF", lede: "No browser, no external tool: the compiler lays out the page's HTML and CSS itself — the cascade, flex and grid, shaped Arabic, tables that repeat their header.")
            Row(class: "paper-row") {
                Stack(class: "sheet") {
                    Image(src: "/report-1.png", alt: "The cover of the Halyard platform report")
                    Text("Report cover — a radial glow and stat tiles", class: "sheet__cap")
                }
                Stack(class: "sheet") {
                    Image(src: "/report-3.png", alt: "Charts and a region table")
                    Text("Charts side by side, a table by content", class: "sheet__cap")
                }
                Stack(class: "sheet") {
                    Image(src: "/report-5.png", alt: "A deployments table continued across pages")
                    Text("64 rows, the header on every page", class: "sheet__cap")
                }
                Stack(class: "sheet") {
                    Image(src: "/invoice-1.png", alt: "An invoice with a watermark")
                    Text("An invoice: band, watermark, totals kept whole", class: "sheet__cap")
                }
                Stack(class: "sheet") {
                    Image(src: "/resume-1.png", alt: "An Arabic résumé laid out right to left")
                    Text("Arabic, right to left, from the same engine", class: "sheet__cap")
                }
            }
            Chrome("What it builds", n: 11)
        }

        // 12 · Tooling
        Opener("The tools", num: "03", line: "One binary: a compiler, a formatter, a test runner, a browser check, an audit — and a language server that knows what you are building.")

        // 13 · The commands
        Slide {
            Head("Everything a project needs is a subcommand.", over: "Tooling")
            Grid(class: "tools") {
                for t in TOOLS {
                    Row(class: "tool") {
                        Text(t.cmd, class: "tool__cmd")
                        Markdown(t.what, class: "tool__what")
                    }
                }
            }
            Chrome("The tools", n: 13)
        }

        // 14 · In numbers
        Slide {
            Head("In numbers.", over: "WebFluent 5.2")
            Grid(class: "numbers") {
                Stack(class: "number") {
                    Text("79", class: "number__n")
                    Text("built-in elements, from Button to TableOfContents", class: "number__what")
                }
                Stack(class: "number") {
                    Text("116", class: "number__n")
                    Text("diagnostic codes, each with a page in the guide", class: "number__what")
                }
                Stack(class: "number") {
                    Text("37", class: "number__n")
                    Text("runtime modules, shipped only when reached", class: "number__what")
                }
                Stack(class: "number") {
                    Text("48", class: "number__n")
                    Text("chapters of the guide, every example built by the tests", class: "number__what")
                }
            }
            Grid(class: "numbers small") {
                Stack(class: "number") {
                    Text("5", class: "number__n")
                    Text("outputs from one program", class: "number__what")
                }
                Stack(class: "number") {
                    Text("11", class: "number__n")
                    Text("types the language brings: Date to Secret", class: "number__what")
                }
                Stack(class: "number") {
                    Text("32", class: "number__n")
                    Text("icons, drawn inline, on screen and paper", class: "number__what")
                }
                Stack(class: "number") {
                    Text("1", class: "number__n")
                    Text("binary: compiler, formatter, tests, server", class: "number__what")
                }
            }
            Chrome("The tools", n: 14)
        }

        // 15 · This deck
        Slide {
            Head("This deck is a .wf file.", over: "Meta")
            Row(class: "meta") {
                Stack(class: "meta__code") {
                    Console(SOURCE, title: "examples/decks/webfluent/src/Deck.wf", small: true)
                }
                Stack(class: "meta__side") {
                    Text("Slides are components: an opener, a heading, a console frame — written once, placed sixteen times. A for makes a slide from each item of a list.", class: "muted")
                    Text("The fonts are files beside it; the colours are the docs site's tokens; wf build writes the PDF.", class: "muted")
                    QrCode("https://github.com/monzeromer-lab/WebFluent/tree/master/examples/decks", color: "#17191C", class: "qr")
                    Text("The source of every deck", class: "overline")
                }
            }
            Chrome("The tools", n: 15)
        }

        // 16 · Start
        Slide(class: "closing") {
            Stack {
                Text("Get started", class: "overline")
                Heading("Write the page.", class: "closing__title").h1
                Text("Let the compiler do the rest.", class: "closing__title closing__accent")
            }
            Row(class: "closing__row") {
                Stack(class: "closing__steps") {
                    Row(class: "closing__cmd") { Text("$")  Text("curl -sSL …/install.sh | bash") }
                    Row(class: "closing__cmd") { Text("$")  Text("wf init my-site --template static") }
                    Row(class: "closing__cmd") { Text("$")  Text("wf serve") }
                }
                Stack {
                    QrCode(SITE, color: "#17191C", class: "qr")
                    Text("monzeromer-lab.github.io/WebFluent", class: "closing__link")
                }
            }
        }
    }
}
