// Rethinking the web layout — a sixteen-slide talk on why the next project
// should be compiled, written in WebFluent, in the docs site's design
// system. `wf build` here writes build/rethinking-the-web-layout.pdf.

const TOTAL = 16
const SITE = "https://monzeromer-lab.github.io/WebFluent/"

/// What every content slide carries along its foot.
component Chrome(_ section: String, n: Number) {
    Row(class: "chrome") {
        Row(class: "chrome__brand") {
            Image(src: "/mark.svg", alt: "")
            Text("WebFluent")
            Text("· {section}", class: "muted")
        }
        Text("{n} / {TOTAL}", class: "chrome__page")
    }
}

/// A slide's heading: the overline that says where we are, then the claim.
component Head(_ title: String, over: String, lede: String = "") {
    Text(over, class: "overline accent")
    Heading(title, class: "title").h2
    if lede != "" {
        Text(lede, class: "lede")
    }
}

/// A console frame around a block of code, as the guide draws one.
component Console(_ code: String, title: String = "wf", small: Bool = false) {
    Stack(class: ["console", if small { "small" }]) {
        Row(class: "console__bar") {
            Row(class: "console__dots") { Text("")  Text("")  Text("") }
            Text(title, class: "console__title")
        }
        Code(code, language: "wf").block
    }
}

/// A section opener: the brand fill, a numeral and the line under it.
component Opener(_ title: String, num: String, line: String) {
    Slide(class: "section") {
        Text(num, class: "section__num")
        Text(title, class: "section__title")
        Text(line, class: "section__line")
        Stack(class: "section__rule") { }
    }
}

/// One point beside a console: a short mark, a claim, and what it means.
component Fact(_ mark: String, claim: String, note: String) {
    Row(class: "fact") {
        Text(mark, class: "fact__dot") { style { width: 44px } }
        Stack(class: "fact__text") {
            Text(claim)
            Text(note)
        }
    }
}

// ── Act 1 · the friction ─────────────────────────────────────

const SETUP = [
    { line: "$ ls -a my-site", kind: "" },
    { line: "  package.json        package-lock.json", kind: "dim" },
    { line: "  tsconfig.json       vite.config.ts", kind: "dim" },
    { line: "  postcss.config.js   tailwind.config.js", kind: "dim" },
    { line: "  eslint.config.js    .prettierrc", kind: "dim" },
    { line: "  node_modules/       … hundreds of packages", kind: "dim" },
    { line: "$ ls src/", kind: "" },
    { line: "  six configs in, not one line of layout", kind: "err" },
]

// ── Act 2 · the method ───────────────────────────────────────

const COUNTER = #"page Home(path: "/", title: "Home") {
    state count = 0
    derived doubled = count * 2

    Container {
        Heading("Welcome").h1
        Text("Count: {count} · doubled {doubled}")
        Button("+1").primary {
            on click { count = count + 1 }
        }
    }
}"#

const GRAMMAR = [
    { form: "page · component · store", means: "**A declaration** — a lowercase keyword names what is being made" },
    { form: "Row · Card · Image", means: "**An element** — text, boxes and media, capitalised, from one registry" },
    { form: ".primary  .lg  .h1", means: "**A flag** — a boolean prop, or one case of an enum prop" },
    { form: "gap: .md", means: "**A prop** — passed by name; one positional may lead" },
    { form: "Card { … }", means: "**A block** — the element's children: the layout is the nesting" },
    { form: "on click { … }", means: "**A handler** — what happens when the reader acts" },
    { form: "style { padding: $md }", means: "**Raw CSS** — with design tokens and live `\{values\}`" },
]

const BUILD = [
    { job: "Pre-render", what: "Every page written as HTML, so the first paint needs no script" },
    { job: "Prune", what: "One stylesheet: only the components and tokens the site uses" },
    { job: "Cut", what: "Of 37 runtime modules, only those the program reaches ship" },
    { job: "Resize", what: "Every image at each width, with its size, so nothing shifts" },
    { job: "Check", what: "Types, props, routes, translations and accessibility — every build" },
    { job: "Secure", what: "A Content-Security-Policy the build holds its own output to" },
    { job: "Index", what: "Sitemap, canonical links, Open Graph and JSON-LD for every page" },
    { job: "Compress", what: "A `.gz` beside every text file, ready for the host to serve" },
]

const ERROR = #"error[T05]: `User` has no field `nmae`
 --> src/pages/Profile.wf:3:18
  |
3 |     Heading(user.nmae).h1
  |                  ^^^^
  = help: Its fields are `id`, `name`
  = fix:  nmae → name"#

// ── Act 3 · beyond the screen ────────────────────────────────

const THREE = #"component Point(_ title: String, body: String) {
    Card { Heading(title).h3  Text(body) }
}
page Site(path: "/", title: "Talk") {
    Container { for p in POINTS { Point(p.title, body: p.body) } }
}
page Handout(path: "/handout", title: "Handout") {
    Document(size: "A4") {
        Footer { Text("Page {page} of {pages}") }
        for p in POINTS { Point(p.title, body: p.body) }
    }
}
page Talk(path: "/talk", title: "Talk") {
    Presentation {
        for p in POINTS { Slide { Point(p.title, body: p.body) } }
    }
}"#

const CONFIG = #"{ "build": { "output_type": "slides",
             "slides": { "size": "16:9" } } }"#

const SOURCE = #"component Opener(_ title: String, num: String, line: String) {
    Slide(class: "section") {
        Text(num, class: "section__num")
        Text(title, class: "section__title")
        Text(line, class: "section__line")
    }
}

page Deck(path: "/", title: "Rethinking the web layout") {
    Presentation {
        Opener("A new method", num: "01",
               line: "Write it once. Compile it.")
        Slide {
            Head("Seven shapes.", over: "One unified syntax")
            for g in GRAMMAR { Row { Text(g.form)  Markdown(g.means) } }
        }
    }
}"#

// ── Act 4 · the invitation ───────────────────────────────────

const CHALLENGE = [
    { form: "wf init try-it -t static", means: "**Start** — one command, one folder, nothing to install after the binary" },
    { form: "src/pages/Home.wf", means: "**Rebuild one page you have** — layout, state and style in a single file" },
    { form: "wf serve", means: "**Watch it** — a save rebuilds and reloads; a mistake is drawn over the page" },
    { form: "wf check", means: "**Count what it caught** — every finding with a code, a place and a fix" },
    { form: "wf build --stats", means: "**Weigh it** — every file gzipped, and each runtime module that shipped" },
    { form: "wf verify", means: "**Time it** — every route loaded in a real browser: errors, paint, bytes" },
]

page Deck(path: "/", title: "Rethinking the web layout", description: "Why your next project should use a compiled language — WebFluent in sixteen slides, written in WebFluent.") {
    Presentation {

        // 1 · The cover
        Slide(class: "cover") {
            Row(class: "cover__grid") {
                Stack(class: "cover__copy") {
                    Row(class: "cover__brand") {
                        Image(src: "/mark.svg", alt: "")
                        Text("WebFluent")
                    }
                    Text("A talk for people who build for the web", class: "overline")
                    Heading("Rethinking the web layout.", class: "cover__title").h1
                    Text("Why your next project should use a compiled language: one syntax for text, boxes, media, state and style — and a compiler that does the heavy lifting before the page ever reaches a browser.", class: "cover__lede")
                }
                Stack(class: "cover__side") {
                    Stack(class: "console") {
                        Row(class: "console__bar") {
                            Row(class: "console__dots") { Text("")  Text("")  Text("") }
                            Text("terminal", class: "console__title")
                        }
                        Stack(class: "term-body") {
                            Text("$ wf init hello --template static", class: "term-line")
                            Text("  Created hello/ with AGENTS.md", class: "term-line dim")
                            Text("$ wf build", class: "term-line")
                            Text("  3 pages, 0 errors, 0 warnings", class: "term-line ok")
                            Text("$ wf build -d report", class: "term-line")
                            Text("  PDF: 9 page(s)", class: "term-line kw")
                            Text("$ wf build -d deck", class: "term-line")
                            Text("  Slides: 16 slide(s)", class: "term-line kw")
                        }
                    }
                    Row(class: "chips") {
                        Text("one syntax", class: "chip brand")
                        Text("one binary", class: "chip brand")
                        Text("web", class: "chip")
                        Text("PDF", class: "chip accent")
                        Text("slides", class: "chip accent")
                    }
                }
            }
            Row(class: "cover__foot") {
                Text("monzeromer-lab.github.io/WebFluent")
                Text("This deck is a .wf file", class: "mono")
            }
        }

        // 2 · The hook: what a new project costs before its first box
        Slide {
            Head("Six files before the first box.", over: "The friction")
            Row(class: "panes") {
                Stack(class: "pane") {
                    style { flex: 1.2 1 0 }
                    Stack(class: "console big") {
                        Row(class: "console__bar") {
                            Row(class: "console__dots") { Text("")  Text("")  Text("") }
                            Text("a new project, today", class: "console__title")
                        }
                        Stack(class: "term-body") {
                            for s in SETUP {
                                Text(s.line, class: ["term-line", if s.kind != "" { s.kind }])
                            }
                        }
                    }
                }
                Stack(class: "pane facts") {
                    Fact("01", claim: "Configuration before content", note: "A bundler, a CSS pipeline, a type checker and a linter each want a file before anything is laid out.")
                    Fact("02", claim: "Dependencies nobody chose", note: "One install brings a tree of packages to audit, update and keep from breaking.")
                    Fact("03", claim: "Tools that cannot see each other", note: "The type checker cannot read the CSS, the linter cannot read the routes — so the browser finds the mistakes.")
                }
            }
            Chrome("The friction", n: 2)
        }

        // 3 · The hook: where the work lands
        Slide {
            Head("And the reader's browser finishes the job.", over: "The friction", lede: "A typical stack ships a framework with the page, and the layout is assembled on the reader's device — on every visit, on every phone.")
            Row(class: "flow") {
                Stack(class: "card flow__node") {
                    Text("download", class: "node__kind")
                    Text("framework + app bundle", class: "node__code")
                    Text("The runtime has to arrive before the content can show.", class: "node__note")
                }
                Text("→", class: "flow__arrow")
                Stack(class: "card flow__node") {
                    Text("execute", class: "node__kind")
                    Text("render(<App />)", class: "node__code")
                    Text("The text, the boxes and the media are built in the browser, from scratch.", class: "node__note")
                }
                Text("→", class: "flow__arrow")
                Stack(class: "card flow__node") {
                    Text("hydrate", class: "node__kind")
                    Text("attach every listener", class: "node__code")
                    Text("HTML that was already sent is walked again to make it interactive.", class: "node__note")
                }
            }
            Row(class: "chips") {
                style { margin-top: 32px }
                Text("configure", class: "chip")
                Text("transpile", class: "chip")
                Text("bundle", class: "chip")
                Text("polyfill", class: "chip")
                Text("ship a runtime", class: "chip")
                Text("re-render", class: "chip")
            }
            Chrome("The friction", n: 3)
        }

        // 4 · The paradigm shift
        Opener("A new method", num: "01", line: "Describe the layout in one language a compiler understands, and do the heavy lifting once, at build time — not on every reader's device.")

        // 5 · One file
        Slide {
            Head("One syntax for layout, state and behaviour.", over: "The method")
            Row(class: "panes") {
                Stack(class: "pane") {
                    Row(class: "pane__label") {
                        Text("What you write", class: "overline")
                        Text("Home.wf", class: "pill")
                    }
                    Console(COUNTER, title: "src/pages/Home.wf")
                }
                Stack(class: "pane") {
                    Row(class: "pane__label") {
                        Text("What the reader gets", class: "overline")
                        Text("index.html · app.js", class: "pill")
                    }
                    Stack(class: "browser") {
                        Row(class: "browser__bar") {
                            Row(class: "console__dots") { Text("")  Text("")  Text("") }
                            Text("localhost:3000/", class: "browser__url")
                        }
                        Stack(class: "browser__page") {
                            Heading("Welcome").h2
                            Text("Count: 3 · doubled 6", class: "muted")
                            Row(class: "counter") {
                                Text("3", class: "counter__n")
                                Text("+1", class: "button")
                            }
                            Text("No config file, no package to install, no virtual DOM: the one text node that reads count repaints when it changes.", class: "muted")
                        }
                    }
                }
            }
            Chrome("The method", n: 5)
        }

        // 6 · The grammar
        Slide {
            Head("Seven shapes. That is the whole grammar.", over: "One unified syntax", lede: "Text, boxes and media are written the same way as state and style. The compiler, the linters and the editor read one registry of what each element takes.")
            Stack(class: "grammar") {
                Row(class: "grammar__row head") {
                    Text("Written", class: "grammar__form")
                    Text("What it is", class: "grammar__means")
                }
                for g in GRAMMAR {
                    Row(class: "grammar__row") {
                        Text(g.form, class: "grammar__form")
                        Markdown(g.means, class: "grammar__means")
                    }
                }
            }
            Chrome("The method", n: 6)
        }

        // 7 · What moves to the compiler
        Slide {
            Head("The heavy lifting happens before anyone visits.", over: "Build time, not run time")
            Grid(class: "tools") {
                for b in BUILD {
                    Row(class: "tool") {
                        Text(b.job, class: "tool__cmd")
                        Markdown(b.what, class: "tool__what")
                    }
                }
            }
            Chrome("The method", n: 7)
        }

        // 8 · Measured
        Slide {
            Head("And the compile step is fast.", over: "Measured", lede: "wf is one native binary. Wall-clock time of wf build on the projects in the repository's examples and tests.")
            Grid(class: "numbers") {
                Stack(class: "number") {
                    Text("17 ms", class: "number__n")
                    Text("a three-page marketing site, start to finish", class: "number__what")
                }
                Stack(class: "number") {
                    Text("19 ms", class: "number__n")
                    Text("a three-page dashboard with a store and a keyed table", class: "number__what")
                }
                Stack(class: "number") {
                    Text("0.21 s", class: "number__n")
                    Text("a nine-page PDF report: charts, tables, fonts embedded", class: "number__what")
                }
                Stack(class: "number") {
                    Text("0.16 s", class: "number__n")
                    Text("this deck: sixteen slides, five pictures, two QR codes", class: "number__what")
                }
            }
            Grid(class: "numbers small") {
                Stack(class: "number") {
                    Text("1", class: "number__n")
                    Text("binary: compiler, server, formatter, tests", class: "number__what")
                }
                Stack(class: "number") {
                    Text("0", class: "number__n")
                    Text("node_modules, bundler configs or plugins", class: "number__what")
                }
                Stack(class: "number") {
                    Text("3.7 kB", class: "number__n")
                    Text("gzipped app.js for a page of static text", class: "number__what")
                }
                Stack(class: "number") {
                    Text("0", class: "number__n")
                    Text("headless browsers launched to make a PDF", class: "number__what")
                }
            }
            Chrome("The method", n: 8)
        }

        // 9 · Diagnostics
        Slide {
            Head("A mistake stops at the compiler, not in production.", over: "Checked")
            Row(class: "panes") {
                Stack(class: "pane") {
                    style { flex: 1.4 1 0 }
                    Stack(class: "console big") {
                        Row(class: "console__bar") {
                            Row(class: "console__dots") { Text("")  Text("")  Text("") }
                            Text("wf check", class: "console__title")
                        }
                        Code(ERROR).block { style { color: #E6E9EC } }
                    }
                }
                Stack(class: "pane facts") {
                    Fact("116", claim: "codes, one registry", note: "The build, the editor, wf explain and the guide read the same list.")
                    Fact("fix", claim: "A fix where one is known", note: "The nearest name, a ?., the missing props — applied by the editor.")
                    Fact("1×", claim: "Every mistake, once", note: "Every file is read even when another does not parse.")
                }
            }
            Chrome("The method", n: 9)
        }

        // 10 · The 'aha'
        Opener("Beyond the screen", num: "02", line: "The same layout compiles to a PDF document and a slide deck — laid out by the compiler itself. No headless browser to spin up.")

        // 11 · One component, three surfaces
        Slide {
            Head("One component. Three surfaces.", over: "The same layout logic")
            Row(class: "meta") {
                Stack(class: "meta__code") {
                    Console(THREE, title: "src/Talk.wf", small: true)
                }
                Stack(class: "pane facts") {
                    Fact("web", claim: "On screen", note: "wf build: the HTML, the CSS, and a runtime cut to what the page reaches.")
                    Fact("pdf", claim: "On paper", note: "-f pdf: A4 pages with a numbered footer, each Card in its own CSS.")
                    Fact("deck", claim: "On stage", note: "-f slides: a 16:9 slide for every point, from the same loop.")
                }
            }
            Chrome("Beyond the screen", n: 11)
        }

        // 12 · Outputs
        Slide {
            Head("Pick the output in one line of config.", over: "build.output_type")
            Grid(class: "outputs") {
                Stack(class: "card output") {
                    Stack(class: "output__icon") { Icon("home") }
                    Heading("Static site").h3
                    Text("Every page pre-rendered, then hydrated. Sitemap, canonical, Open Graph.")
                    Text("\"ssg\": true", class: "chip")
                }
                Stack(class: "card output") {
                    Stack(class: "output__icon") { Icon("arrow-right") }
                    Heading("Single-page app").h3
                    Text("A page per chunk, loaded when its route shows; a service worker on request.")
                    Text("\"spa\"", class: "chip")
                }
                Stack(class: "card output paper") {
                    Stack(class: "output__icon") { Icon("download") }
                    Heading("PDF").h3
                    Text("The page's own CSS, laid out on paper: running headers, contents, charts.")
                    Text("\"pdf\"", class: "chip")
                }
                Stack(class: "card output paper") {
                    Stack(class: "output__icon") { Icon("eye") }
                    Heading("Slide deck").h3
                    Text("A slide to a page, from components and data — like this one.")
                    Text("\"slides\"", class: "chip")
                }
                Stack(class: "card output") {
                    Stack(class: "output__icon") { Icon("link") }
                    Heading("Custom elements").h3
                    Text("Components as tags for React, Vue, Rails or a plain page.")
                    Text("\"elements\"", class: "chip")
                }
            }
            Row(class: "config-strip") {
                Console(CONFIG, title: "webfluent.app.json", small: true)
                Text("The program does not change. A PDF is refused what only a browser can do — a button, a handler, a route — where it is written, and the editor offers only what the output draws.", class: "config-strip__note")
            }
            Chrome("Beyond the screen", n: 12)
        }

        // 13 · Paper
        Slide {
            Head("Paper, without a headless browser.", over: "PDF", lede: "The compiler's own paged engine lays out the page's HTML and CSS — the cascade, flex and grid, shaped Arabic, tables that repeat their header. Nothing to install, nothing to launch.")
            Row(class: "paper-row") {
                Stack(class: "sheet") {
                    Image(src: "/report-1.png", alt: "The cover of the Halyard platform report")
                    Text("Report cover — a radial glow and stat tiles", class: "sheet__cap")
                }
                Stack(class: "sheet") {
                    Image(src: "/report-3.png", alt: "Charts and a region table")
                    Text("Charts side by side, a table by content", class: "sheet__cap")
                }
                Stack(class: "sheet") {
                    Image(src: "/report-5.png", alt: "A deployments table continued across pages")
                    Text("64 rows, the header on every page", class: "sheet__cap")
                }
                Stack(class: "sheet") {
                    Image(src: "/invoice-1.png", alt: "An invoice with a watermark")
                    Text("An invoice: band, watermark, totals kept whole", class: "sheet__cap")
                }
                Stack(class: "sheet") {
                    Image(src: "/resume-1.png", alt: "An Arabic résumé laid out right to left")
                    Text("Arabic, right to left, from the same engine", class: "sheet__cap")
                }
            }
            Chrome("Beyond the screen", n: 13)
        }

        // 14 · This deck
        Slide {
            Head("You are looking at a .wf file.", over: "Slides")
            Row(class: "meta") {
                Stack(class: "meta__code") {
                    Console(SOURCE, title: "examples/decks/webfluent/src/Deck.wf", small: true)
                }
                Stack(class: "meta__side") {
                    Text("Every slide here is a component — an opener, a heading, a console frame — written once and placed sixteen times. A for makes a row, or a slide, from each item of a list.", class: "muted")
                    Text("The fonts are files beside it, the colours the docs site's tokens; wf build writes the PDF, and nothing else runs.", class: "muted")
                    QrCode("https://github.com/monzeromer-lab/WebFluent/tree/master/examples/decks", color: "#17191C", class: "qr")
                    Text("The source of every deck", class: "overline")
                }
            }
            Chrome("Beyond the screen", n: 14)
        }

        // 15 · The challenge
        Slide {
            Head("Try it on one page you already have.", over: "The challenge", lede: "Rebuild it in WebFluent, then measure the difference yourself — every number on these slides is one command away.")
            Stack(class: "grammar") {
                Row(class: "grammar__row head") {
                    Text("Run", class: "grammar__form")
                    Text("What you will see", class: "grammar__means")
                }
                for c in CHALLENGE {
                    Row(class: "grammar__row") {
                        Text(c.form, class: "grammar__form")
                        Markdown(c.means, class: "grammar__means")
                    }
                }
            }
            Chrome("Your move", n: 15)
        }

        // 16 · Start
        Slide(class: "closing") {
            Stack {
                Text("Your move", class: "overline")
                Heading("Spin up a layout.", class: "closing__title").h1
                Text("See how much cleaner it gets.", class: "closing__title closing__accent")
            }
            Row(class: "closing__row") {
                Stack(class: "closing__steps") {
                    Row(class: "closing__cmd") { Text("$")  Text("curl -sSL …/install.sh | bash") }
                    Row(class: "closing__cmd") { Text("$")  Text("wf init my-site --template static") }
                    Row(class: "closing__cmd") { Text("$")  Text("wf serve") }
                }
                Stack {
                    QrCode(SITE, color: "#17191C", class: "qr")
                    Text("monzeromer-lab.github.io/WebFluent", class: "closing__link")
                }
            }
        }
    }
}
