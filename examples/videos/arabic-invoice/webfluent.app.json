{
  "name": "arabic-invoice",
  "version": "1.0.0",
  "theme": { "name": "Ledger" },
  "build": {
    "output": "./build",
    "output_type": "pdf",
    "pdf": {
      "page_size": "A4",
      "margins": { "top": 54, "bottom": 64, "left": 54, "right": 54 },
      "default_font": "Noto Sans Arabic",
      "default_font_size": 9,
      "output_filename": "invoice-ar.pdf",
      "fonts": ["../../documents/fonts"],
      "system_fonts": false
    }
  },
  "meta": { "lang": "ar" }
}
