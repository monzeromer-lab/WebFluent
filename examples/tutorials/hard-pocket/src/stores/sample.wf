// The ledger a first visit opens on, so the dashboard has something to
// show. Every date is "so many days ago", worked out when the page loads,
// so the sample stays recent however long after today it is opened.

/// One sample entry, before it has a date.
type Seed {
    id: Uuid
    ago: Number
    amount: Money
    kind: Kind
    category: String
    note: String
}

