/// Which way a figure leans, which decides its colour.
enum Lean { neutral, good, bad }

/// One figure on the dashboard: what it is, how much, and a line of
/// context — the built-in `Stat` on a card, the card's edge coloured by the
/// way the figure leans.
component KpiCard(_ label: String, value: Money, note: String = "", lean: Lean = .neutral) {
    Card(class: "kpi", data-lean: lean) {
        Stat(label, value: format(value)) {
            if note != "" { Text(note).muted.sm }
        }
    }
}
