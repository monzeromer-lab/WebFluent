+  // A WebFluent app's compiler is not an npm package: record the one that built it.
+  const wf = spawnSync('wf', ['--version'], { encoding: 'utf8' });
+  if (wf.status === 0) installed.wf = wf.stdout.trim().replace(/^wf /, '');
   return { sourceLines: lines, installed };
