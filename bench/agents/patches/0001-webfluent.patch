diff --git a/bench/container/Containerfile.base b/bench/container/Containerfile.base
index 86dae61..ffab52f 100644
--- a/bench/container/Containerfile.base
+++ b/bench/container/Containerfile.base
@@ -23,6 +23,19 @@ RUN test -n "$NODE_VERSION" || { echo "NODE_VERSION build arg is required" >&2;
  && rm "${TARBALL}" \
  && node --version && npm --version
 
+# The WebFluent compiler, for the webfluent agent and for testing and measuring its app.
+# Pinned by run.mjs (--wf-version); checked against the release's SHA256SUMS.
+ARG WF_VERSION=7.0.1
+RUN TARBALL="wf-v${WF_VERSION}-x86_64-linux.tar.gz" \
+ && BASE="https://github.com/monzeromer-lab/WebFluent/releases/download/v${WF_VERSION}" \
+ && cd /tmp \
+ && curl -fsSLO "${BASE}/${TARBALL}" \
+ && curl -fsSL "${BASE}/SHA256SUMS" | grep " ${TARBALL}\$" | sha256sum -c - \
+ && tar -xzf "${TARBALL}" \
+ && install -m 0755 "$(find /tmp -name wf -type f -perm -u+x | head -n 1)" /usr/local/bin/wf \
+ && rm -rf /tmp/* \
+ && wf --version
+
 RUN apt-get update \
  && npx -y playwright@${PLAYWRIGHT_VERSION} install-deps chromium \
  && rm -rf /var/lib/apt/lists/*
diff --git a/bench/container/setup-tooling.sh b/bench/container/setup-tooling.sh
index a381177..4f2aaef 100755
--- a/bench/container/setup-tooling.sh
+++ b/bench/container/setup-tooling.sh
@@ -92,6 +92,13 @@ case "$FRAMEWORK" in
     # up front because agents don't always use create-react-router. Docs ship in node_modules.
     skill remix-run/react-router --skill react-router
     ;;
+  webfluent)
+    # https://github.com/monzeromer-lab/WebFluent/tree/master/skills (the skill `wf init` also
+    # writes into a new project), installed up front because agents don't always use `wf init`.
+    # The compiler itself is in the base image (Containerfile.base), so the tests can build.
+    record "$(jq -nc --arg v "$(wf --version)" '{kind: "compiler", name: "wf", version: $v}')"
+    skill monzeromer-lab/WebFluent --skill writing-webfluent
+    ;;
   tanstack-start | solidstart | qwik | gracile | vanilla)
     # No official agent tooling (TanStack removed its MCP server in favour of its CLI).
     ;;
