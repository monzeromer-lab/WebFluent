{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "WebFluent",
  "scopeName": "source.webfluent",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#routing"
    },
    {
      "include": "#state-keywords"
    },
    {
      "include": "#control-flow"
    },
    {
      "include": "#style-block"
    },
    {
      "include": "#style-animation-keywords"
    },
    {
      "include": "#fetch-block"
    },
    {
      "include": "#fetch-callbacks"
    },
    {
      "include": "#boolean-null"
    },
    {
      "include": "#types"
    },
    {
      "include": "#events"
    },
    {
      "include": "#sub-components"
    },
    {
      "include": "#built-in-components"
    },
    {
      "include": "#modifiers"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#named-args"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.webfluent",
          "match": "//.*$"
        },
        {
          "name": "comment.block.webfluent",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.webfluent"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.webfluent",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.webfluent"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.webfluent"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.webfluent",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.webfluent",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.webfluent"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.webfluent"
                }
              },
              "contentName": "meta.embedded.expression.webfluent",
              "patterns": [
                {
                  "include": "#operators"
                },
                {
                  "include": "#numbers"
                },
                {
                  "include": "#boolean-null"
                },
                {
                  "include": "#function-calls"
                },
                {
                  "name": "variable.other.readwrite.webfluent",
                  "match": "[a-zA-Z_][a-zA-Z0-9_.]*"
                }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.webfluent",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.webfluent",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(page|component|store|theme|type|enum)\\b\\s+([A-Z][a-zA-Z0-9]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.webfluent"
            },
            "2": {
              "name": "entity.name.type.webfluent"
            }
          }
        },
        {
          "match": "\\b(app)\\b(?=\\s*\\{)",
          "name": "keyword.declaration.webfluent"
        }
      ]
    },
    "routing": {
      "patterns": [
        {
          "name": "keyword.control.routing.webfluent",
          "match": "\\b(Router|Route)\\b"
        }
      ]
    },
    "state-keywords": {
      "patterns": [
        {
          "match": "\\b(state|derived|resource|let)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.state.webfluent"
            },
            "2": {
              "name": "variable.other.state.webfluent"
            }
          }
        },
        {
          "match": "\\b(action|event)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.action.webfluent"
            },
            "2": {
              "name": "entity.name.function.action.webfluent"
            }
          }
        },
        {
          "match": "\\b(emit)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.other.emit.webfluent"
            },
            "2": {
              "name": "entity.name.function.event.webfluent"
            }
          }
        },
        {
          "match": "\\b(slot)\\b(\\s+([a-z_][a-zA-Z0-9_]*))?",
          "captures": {
            "1": {
              "name": "keyword.other.slot.webfluent"
            },
            "3": {
              "name": "entity.name.tag.slot.webfluent"
            }
          }
        },
        {
          "name": "keyword.other.webfluent",
          "match": "\\b(use|effect|return|children|await|navigate|log)\\b"
        }
      ]
    },
    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.webfluent",
          "match": "\\b(if|else|for|in|by|show|match|let)\\b"
        }
      ]
    },
    "style-block": {
      "begin": "\\b(style|transition)\\s*\\{",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.style.webfluent"
        }
      },
      "end": "\\}",
      "name": "meta.style-block.webfluent",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "begin": "^\\s*([&@.:\\[>*+~][^{\\n]*)\\{",
          "beginCaptures": {
            "1": {
              "name": "entity.name.tag.selector.webfluent"
            }
          },
          "end": "\\}",
          "name": "meta.nested-rule.webfluent",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#style-declaration"
            }
          ]
        },
        {
          "include": "#style-declaration"
        }
      ]
    },
    "style-animation-keywords": {
      "patterns": [
        {
          "name": "keyword.other.style.webfluent",
          "match": "\\b(style|transition)\\b(?=\\s*\\{)"
        }
      ]
    },
    "fetch-block": {
      "patterns": []
    },
    "fetch-callbacks": {
      "patterns": [
        {
          "name": "keyword.control.match-arm.webfluent",
          "match": "\\b(loading|error|ready)(?=\\s*[\\({])"
        }
      ]
    },
    "boolean-null": {
      "patterns": [
        {
          "name": "constant.language.boolean.true.webfluent",
          "match": "\\btrue\\b"
        },
        {
          "name": "constant.language.boolean.false.webfluent",
          "match": "\\bfalse\\b"
        },
        {
          "name": "constant.language.null.webfluent",
          "match": "\\bnull\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.webfluent",
          "match": "\\b(String|Number|Bool|Map|Any)\\b"
        }
      ]
    },
    "events": {
      "patterns": [
        {
          "match": "\\b(on)\\s+([a-z_][a-zA-Z0-9_]*)(?=\\s*[\\({])",
          "captures": {
            "1": {
              "name": "keyword.other.event.webfluent"
            },
            "2": {
              "name": "entity.name.event.webfluent"
            }
          }
        }
      ]
    },
    "sub-components": {
      "patterns": [
        {
          "match": "\\b(Card|Navbar|Sidebar|Menu|Dropdown|Breadcrumb|Carousel|Modal|Table|Select|Tabs)(\\.)(Header|Body|Footer|Brand|Links|Actions|Item|Divider|Slide|Head|Row|Cell|Option|Page)\\b",
          "captures": {
            "1": {
              "name": "support.class.component.webfluent"
            },
            "2": {
              "name": "punctuation.accessor.dot.webfluent"
            },
            "3": {
              "name": "support.class.sub-component.webfluent"
            }
          }
        }
      ]
    },
    "built-in-components": {
      "patterns": [
        {
          "name": "support.class.component.webfluent",
          "match": "\\b(Container|Row|Column|Grid|Stack|Spacer|Divider|Navbar|Sidebar|Link|Tabs|TabPage|Breadcrumb|Menu|Card|Table|Thead|Tbody|Trow|Tcell|List|Badge|Avatar|Tooltip|Tag|Input|Select|Option|Checkbox|Radio|Switch|Slider|DatePicker|FileUpload|Form|Alert|Toast|Modal|Dialog|Spinner|Progress|Skeleton|Button|IconButton|ButtonGroup|Dropdown|Image|Video|Icon|Carousel|Text|Heading|Code|Blockquote|Document|Section|Paragraph|Header|Footer|PageBreak)\\b"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "match": "(?<=[)A-Za-z0-9_])(\\.)([a-z_][a-zA-Z0-9_]*)\\b(?!\\s*\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.flag.webfluent"
            },
            "2": {
              "name": "support.constant.flag.webfluent"
            }
          }
        },
        {
          "match": "(?<=[:(,{\\s])(\\.)([a-z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "punctuation.accessor.case.webfluent"
            },
            "2": {
              "name": "constant.other.enum-case.webfluent"
            }
          }
        },
        {
          "name": "variable.other.constant.design-token.webfluent",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_-]*"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b(t|setLocale|navigate|replayAnimation|log)\\s*(\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.webfluent"
            },
            "2": {
              "name": "punctuation.definition.arguments.begin.webfluent"
            }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.webfluent"
            },
            "2": {
              "name": "punctuation.definition.arguments.begin.webfluent"
            }
          }
        }
      ]
    },
    "named-args": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_-]*)\\s*(:)(?!:)",
          "captures": {
            "1": {
              "name": "variable.parameter.named.webfluent"
            },
            "2": {
              "name": "punctuation.separator.key-value.webfluent"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.webfluent",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.webfluent",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.webfluent",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.webfluent",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.arrow.webfluent",
          "match": "=>"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.begin.webfluent",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.webfluent",
          "match": "\\}"
        },
        {
          "name": "punctuation.definition.arguments.begin.webfluent",
          "match": "\\("
        },
        {
          "name": "punctuation.definition.arguments.end.webfluent",
          "match": "\\)"
        },
        {
          "name": "punctuation.separator.comma.webfluent",
          "match": ","
        },
        {
          "name": "punctuation.terminator.dot.webfluent",
          "match": "\\."
        }
      ]
    },
    "style-declaration": {
      "patterns": [
        {
          "begin": "(--?[a-zA-Z][a-zA-Z0-9-]*)\\s*(:)",
          "beginCaptures": {
            "1": {
              "name": "support.type.property-name.css.webfluent"
            },
            "2": {
              "name": "punctuation.separator.key-value.webfluent"
            }
          },
          "end": "(?=[;}\\n])|(;)",
          "endCaptures": {
            "1": {
              "name": "punctuation.terminator.webfluent"
            }
          },
          "name": "meta.style-value.webfluent",
          "patterns": [
            {
              "name": "variable.other.constant.design-token.webfluent",
              "match": "\\$[a-zA-Z_][a-zA-Z0-9_-]*"
            },
            {
              "begin": "\\{",
              "end": "\\}",
              "name": "meta.interpolation.webfluent",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.webfluent"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.webfluent"
                }
              },
              "patterns": [
                {
                  "include": "#strings"
                },
                {
                  "include": "#numbers"
                },
                {
                  "include": "#operators"
                }
              ]
            },
            {
              "include": "#strings"
            },
            {
              "name": "string.unquoted.css-value.webfluent",
              "match": "[^;}{$\\n]+"
            }
          ]
        }
      ]
    }
  }
}
