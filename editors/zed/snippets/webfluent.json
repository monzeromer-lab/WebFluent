{
  "page": {
    "prefix": "page",
    "description": "A routed page",
    "body": [
      "page ${1:Name}(path: \"${2:/}\", title: \"${3:$1}\") {",
      "    $0",
      "}"
    ]
  },
  "component": {
    "prefix": "component",
    "description": "A reusable component with props",
    "body": [
      "component ${1:Name}(_ ${2:label}: ${3:String}) {",
      "    $0",
      "}"
    ]
  },
  "store": {
    "prefix": "store",
    "description": "A shared state store",
    "body": [
      "store ${1:Name}Store {",
      "    state ${2:items} = ${3:[]}",
      "",
      "    action ${4:add}(${5:item}: ${6:Map}) {",
      "        $0",
      "    }",
      "}"
    ]
  },
  "theme": {
    "prefix": "theme",
    "description": "A theme overriding design tokens",
    "body": [
      "theme ${1:Brand} {",
      "    color-primary: ${2:#3B82F6}",
      "    $0",
      "}"
    ]
  },
  "app": {
    "prefix": "app",
    "description": "The root of the site, with the router",
    "body": [
      "app {",
      "    $0",
      "    Router",
      "}"
    ]
  },
  "type": {
    "prefix": "type",
    "description": "A record type",
    "body": [
      "type ${1:Name} {",
      "    ${2:id}: ${3:String}",
      "}"
    ]
  },
  "enum": {
    "prefix": "enum",
    "description": "A set of cases",
    "body": "enum ${1:Name} { ${2:a}, ${3:b} }"
  },
  "state": {
    "prefix": "state",
    "description": "A reactive state variable",
    "body": "state ${1:name} = ${2:0}"
  },
  "derived": {
    "prefix": "derived",
    "description": "A value computed from state",
    "body": "derived ${1:name} = ${2:expression}"
  },
  "effect": {
    "prefix": "effect",
    "description": "Runs when the state it reads changes",
    "body": [
      "effect {",
      "    $0",
      "}"
    ]
  },
  "action": {
    "prefix": "action",
    "description": "An action that changes state",
    "body": [
      "action ${1:name}(${2}) {",
      "    $0",
      "}"
    ]
  },
  "event": {
    "prefix": "event",
    "description": "An event the component fires with emit",
    "body": "event ${1:name}(${2:id}: ${3:String})"
  },
  "slot": {
    "prefix": "slot",
    "description": "A named slot the caller fills",
    "body": "slot ${1:name}"
  },
  "if / else": {
    "prefix": "ifelse",
    "description": "Conditional rendering",
    "body": [
      "if ${1:condition} {",
      "    $2",
      "} else {",
      "    $0",
      "}"
    ]
  },
  "if let": {
    "prefix": "iflet",
    "description": "Render when a value is not null",
    "body": [
      "if let ${1:name} = ${2:value} {",
      "    $0",
      "}"
    ]
  },
  "for": {
    "prefix": "for",
    "description": "Render each item, keyed",
    "body": [
      "for ${1:item} in ${2:items} by $1.${3:id} {",
      "    $0",
      "}"
    ]
  },
  "for with index": {
    "prefix": "fori",
    "description": "Render each item with its index",
    "body": [
      "for ${1:item}, ${2:i} in ${3:items} {",
      "    $0",
      "}"
    ]
  },
  "show": {
    "prefix": "show",
    "description": "Show or hide without unmounting",
    "body": [
      "show ${1:visible} {",
      "    $0",
      "}"
    ]
  },
  "resource": {
    "prefix": "resource",
    "description": "Fetch data and render its states",
    "body": [
      "resource ${1:data} = fetch(\"${2:/api/}\")",
      "match $1 {",
      "    loading { Spinner }",
      "    error(e) { Alert(e.message).danger }",
      "    ready(${3:value}) {",
      "        $0",
      "    }",
      "}"
    ]
  },
  "match": {
    "prefix": "match",
    "description": "Render one arm by a value",
    "body": [
      "match ${1:value} {",
      "    .${2:case} { $3 }",
      "    else { $0 }",
      "}"
    ]
  },
  "on click": {
    "prefix": "onclick",
    "description": "A click handler",
    "body": [
      "on click {",
      "    $0",
      "}"
    ]
  },
  "on submit": {
    "prefix": "onsubmit",
    "description": "A submit handler that reads the event",
    "body": [
      "on submit(event) {",
      "    $0",
      "}"
    ]
  },
  "emit": {
    "prefix": "emit",
    "description": "Fire a declared event",
    "body": "emit ${1:name}($0)"
  },
  "style": {
    "prefix": "style",
    "description": "A style block",
    "body": [
      "style {",
      "    ${1:padding}: ${2:1rem}",
      "    $0",
      "}"
    ]
  },
  "hover": {
    "prefix": "hover",
    "description": "A hover rule inside a style block",
    "body": [
      "&:hover {",
      "    ${1:background}: ${2:\\$surface-hover}",
      "}"
    ]
  },
  "media": {
    "prefix": "media",
    "description": "A responsive rule inside a style block",
    "body": [
      "@media (max-width: ${1:768px}) {",
      "    ${2:padding}: ${3:\\$sm}",
      "}"
    ]
  },
  "transition": {
    "prefix": "transition",
    "description": "A transition block",
    "body": [
      "transition {",
      "    ${1:background}: ${2:200ms} ${3:ease}",
      "}"
    ]
  },
  "card": {
    "prefix": "card",
    "description": "A card with a heading and text",
    "body": [
      "Card.elevated {",
      "    Heading(\"${1:Title}\").h3",
      "    Text(\"${2:Body}\")",
      "    $0",
      "}"
    ]
  },
  "button": {
    "prefix": "button",
    "description": "A primary button with a click handler",
    "body": [
      "Button(\"${1:Label}\").primary {",
      "    on click { $0 }",
      "}"
    ]
  },
  "input": {
    "prefix": "input",
    "description": "A labelled, bound input",
    "body": "Input(bind: ${1:value}, label: \"${2:Label}\", placeholder: \"${3:}\").${4:text}"
  },
  "table": {
    "prefix": "table",
    "description": "A table with a header row and a keyed body",
    "body": [
      "Table {",
      "    Table.Head {",
      "        Table.Row { Table.Cell(\"${1:Name}\") }",
      "    }",
      "    Table.Body {",
      "        for ${2:row} in ${3:rows} by $2.${4:id} {",
      "            Table.Row { Table.Cell($2.${5:name}) }",
      "        }",
      "    }",
      "}"
    ]
  },
  "modal": {
    "prefix": "modal",
    "description": "A modal bound to a state flag",
    "body": [
      "Modal(title: \"${1:Title}\", visible: ${2:open}) {",
      "    $0",
      "    Modal.Footer {",
      "        Button(\"Close\") { on click { $2 = false } }",
      "    }",
      "}"
    ]
  },
  "presentation": {
    "prefix": "presentation",
    "description": "A slide deck",
    "body": [
      "Presentation {",
      "    TitleSlide(\"${1:Title}\", subtitle: \"${2:Subtitle}\")",
      "    Slide {",
      "        Heading(\"${3:First}\").h2",
      "        $0",
      "    }",
      "}"
    ]
  },
  "document": {
    "prefix": "document",
    "description": "A PDF document",
    "body": [
      "Document(page_size: \"A4\") {",
      "    Header { Text(\"${1:Report}\").muted.sm.right }",
      "    Heading(\"${2:Title}\").h1",
      "    $0",
      "}"
    ]
  }
}
